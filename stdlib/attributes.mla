// MLang built-in attributes
// This module is documentation-only and is used by editor tooling.
// It is not meant to be imported at runtime.

// @builtin_attribute derive
// Enables compiler-synthesized struct helpers such as debug formatting and
// JSON serde.
// Usage:
// #[derive(Debug)]
// struct Point { var x: i32; var y: i32; };
//
// #[derive(Json)]
// struct Packet { var id: i32; var name: str8; };
// Packet gains:
// - packet.to_json() -> str8
// - Packet::from_json(text) -> result<Packet, str8>

// @builtin_attribute test
// Marks a function as a test callable by `mlang test`.
// Usage:
// #[test]
// fn test_add() -> i32 { return 0; }

// @builtin_attribute x86-64
// Includes the following function only on x86-64 builds/hosts.
// Usage:
// #[x86-64]
// fn arch_add(a: i64, b: i64) -> i64 { ... }

// @builtin_attribute aarch64
// Includes the following function only on AArch64 builds/hosts.
// Usage:
// #[aarch64]
// fn arch_add(a: i64, b: i64) -> i64 { ... }

// @builtin_region windows
// Includes the enclosed source only on Windows.
// Usage:
// [windows]
// fn platform_name() -> str8 { return "windows"; }
// [/windows]

// @builtin_region posix
// Includes the enclosed source only on POSIX systems.
// Usage:
// [posix]
// fn platform_name() -> str8 { return "posix"; }
// [/posix]

// @builtin_region linux
// Includes the enclosed source only on Linux.

// @builtin_region macos
// Includes the enclosed source only on macOS.

// @builtin_region x86-64
// Includes the enclosed source only on x86-64 targets.

// @builtin_region aarch64
// Includes the enclosed source only on AArch64 targets.
