// MLang built-in macros
// This module is documentation-only and is used by editor tooling.
// It is not meant to be imported at runtime.

// @builtin_macro println
// Prints to stdout with a newline.
// Usage: println!("format {}", value)

// @builtin_macro print
// Prints to stdout without a newline.
// Usage: print!("format {}", value)

// @builtin_macro eprintln
// Prints to stderr with a newline.
// Usage: eprintln!("format {}", value)

// @builtin_macro eprint
// Prints to stderr without a newline.
// Usage: eprint!("format {}", value)

// @builtin_macro debug
// Debug-only print to stderr. Printed only when --debug is enabled.
// Usage: debug!("value: {}", value)

// @builtin_macro debug_json
// Debug-only JSON-style print to stderr. Printed only when --debug is enabled.
// Works best with `#[derive(Debug)]` structs.
// Usage: debug_json!(value)

// @builtin_macro format
// Returns a formatted string.
// Usage: let s: str8 = format!("{}", value);

// @builtin_macro assert_eq
// Asserts that two values are equal. Debug-only by default.
// Usage: assert_eq!(left, right);

// @builtin_macro windows
// Returns compile-time `true` on Windows targets/hosts, else `false`.
// Usage: if windows!() { ... }

// @builtin_macro posix
// Returns compile-time `true` on POSIX-style targets/hosts, else `false`.
// Usage: static_assert!(windows!() || posix!());

// @builtin_macro linux
// Returns compile-time `true` on Linux targets/hosts, else `false`.
// Usage: if linux!() { ... }

// @builtin_macro macos
// Returns compile-time `true` on macOS targets/hosts, else `false`.
// Usage: if macos!() { ... }

// @builtin_macro x64
// Returns compile-time `true` on x86-64 targets/hosts, else `false`.
// Usage: if x64!() { ... }

// @builtin_macro aarch64
// Returns compile-time `true` on AArch64 targets/hosts, else `false`.
// Usage: if aarch64!() { ... }

// @builtin_macro vec
// Creates a Vec<T> (list<T>) from a literal or fill expression.
// Usage: vec![a, b, c]   -- list from elements
// Usage: vec![val; N]    -- N copies of val

// Built-in attributes (compiler-recognized)
// Usage: #[derive(Debug)] struct Foo { ... };
// Usage: #[test] fn test_name() -> i32 { return 0; }
