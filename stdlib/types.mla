/// \file types.mla
/// \brief Doxygen reference for MLang built-in types and keywords.
///
/// This file is documentation-only. It is used by editor tooling and to expose
/// a generated Doxygen page for the language's built-in types.
///
/// \page builtin_types Built-in Types
/// \brief Reference for primitive, generic, handle, and sum types built into MLang.
///
/// \section builtin_types_primitive Primitive Types
/// - `void`: no value; primarily used as a function return type.
/// - `bool`: boolean truth value (`true` or `false`).
/// - `bit`: one-bit logical domain (`0` or `1`), with normal ABI byte sizing.
/// - `i8`, `i16`, `i32`, `i64`: signed integer types.
/// - `u8`, `u16`, `u32`, `u64`: unsigned integer types.
/// - `f32`, `f64`: floating-point types.
///
/// \section builtin_types_string String Types
/// - `str8`: UTF-8 string type.
/// - `str16`: UTF-16 string type.
/// - `String` is the compiler-provided wrapper namespace for `str8` helpers and
///   is not a distinct runtime type.
///
/// \section builtin_types_generic Generic Built-ins
/// - `list<T>`: growable sequence container.
/// - `map<K, V>`: associative container.
/// - `tuple<T1, T2, ...>`: fixed-size heterogeneous product type.
/// - `ptr<T>`: pointer type.
/// - `Handle<T>`: opaque runtime handle wrapper.
/// - `sizeof(Type)` / `sizeof(expr)`: ABI size query returning `i64`.
///
/// \section builtin_types_runtime Runtime Marker Types
/// - `Thread`: opaque payload marker used with `Handle<Thread>`.
/// - `Mutex`: opaque payload marker used with `Handle<Mutex>`.
/// - `Atomic64`: opaque payload marker used with `Handle<Atomic64>`.
///
/// \section builtin_types_sum Sum Types
/// - `Result<T, E>` with constructors `Ok<T, E>(value)` and
///   `Err<T, E>(error)`.
/// - `Option<T>` with constructors `Some<T>(value)` and `None<T>()`.
///
/// \section builtin_types_inline_asm Inline Assembly Keywords
/// - `asm`
/// - `x86`
/// - `x64`
/// - `aarch64`
///
/// \section builtin_types_notes Notes
/// - This page documents language built-ins, not importable stdlib modules.
/// - The `?` operator propagates `Err` values and enriches
///   `Result<_, str8>` error stacks with call-site context.

// MLang built-in types
// This module is documentation-only and is used by editor tooling.
// It is not meant to be imported at runtime.

// @builtin void
// No value. Used as the return type for functions that do not return.

// @builtin bool
// Boolean value: true or false.

// @builtin bit
// Logical one-bit value with domain 0 or 1.
// Use `bit(expr)` to convert an integer/bool expression to `bit`.
// `sizeof(bit)` follows normal ABI byte sizing even though the value domain is
// a single logical bit.

// @builtin i8
// Signed 8-bit integer. Range: -128..127.

// @builtin i16
// Signed 16-bit integer. Range: -32768..32767.

// @builtin i32
// Signed 32-bit integer. Range: -2147483648..2147483647.

// @builtin i64
// Signed 64-bit integer. Range: -9223372036854775808..9223372036854775807.

// @builtin u8
// Unsigned 8-bit integer. Range: 0..255.

// @builtin u16
// Unsigned 16-bit integer. Range: 0..65535.

// @builtin u32
// Unsigned 32-bit integer. Range: 0..4294967295.

// @builtin u64
// Unsigned 64-bit integer. Range: 0..18446744073709551615.

// @builtin f32
// 32-bit floating point (single precision).

// @builtin f64
// 64-bit floating point.

// @builtin str8
// UTF-8 string type.
// `String` is the compiler-provided wrapper namespace for str8 intrinsics
// (e.g. `String::new`, `String::with_capacity`, `String::free`).
// It is not a separate runtime type.

// @builtin str16
// UTF-16 string type.

// @builtin list
// Generic list type: list<T>.
// `list<bool>` is a normal list container, not a packed bit-vector.
// For dense one-bit storage use `std::bitset::BitSet`.

// @builtin map
// Generic map type: map<K, V>.

// @builtin tuple
// Tuple type: tuple<T1, T2, ...>.

// @builtin sizeof
// Builtin size query: `sizeof(Type)` or `sizeof(expr)`.
// Returns the ABI size in bytes as `i64`.

// @builtin ptr
// Pointer type: ptr<T>.
// Take an address with &value and dereference with *ptr.

// @builtin Handle
// Generic runtime handle type: Handle<T>.
// Used by thread/sync intrinsics such as Handle<Thread>, Handle<Mutex>,
// and Handle<Atomic64>.

// @builtin Thread
// Opaque thread handle payload marker type used with Handle<Thread>.

// @builtin Mutex
// Opaque mutex handle payload marker type used with Handle<Mutex>.

// @builtin Atomic64
// Opaque 64-bit atomic handle payload marker type used with Handle<Atomic64>.

// @builtin Result
// Result<T, E> represents success (Ok) or failure (Err).
// Construct with Ok<T, E>(value) or Err<T, E>(error).
// Methods:
//   - is_ok() -> bool
//   - is_err() -> bool
//   - unwrap() -> T (warning: may panic on Err)
//   - unwrap_err() -> E
// Prefer match or is_ok/is_err checks before unwrap().
// The `?` operator propagates Err values and, for Result<_, str8>, appends
// call-site context (`function:line`) to build an error stack.

// @builtin Ok
// Result constructor: Ok<T, E>(value).

// @builtin Err
// Result constructor: Err<T, E>(error).

// @builtin Option
// Option<T> represents Some(value) or None.
// Construct with Some<T>(value) or None<T>().

// @builtin enum
// Enum declarations define named integral values, optionally with an explicit
// backing type such as `u8` or `i64`.
// Enum values print as `EnumName::Variant`.
// Enums are iterable in declaration order:
//   for value in Status { ... }
//   for (i, value) in Status.enumerate() { ... }
// The enumerate form exposes a zero-based `i64` index plus the enum value.

// @builtin Some
// Option constructor for present values: Some<T>(value).

// @builtin None
// Option constructor for absent values: None<T>().

// @builtin asm
/// Inline assembly expression keyword.
/// Use `asm(type, "...", operands...)` for non-volatile inline assembly and
/// `asm volatile(type, "...", operands...)` when side effects must be preserved.
/// Arch-qualified forms such as `asm aarch64(...)`, `asm x64(...)`, and
/// `asm x86(...)` require the matching `--target-arch` compilation target.

// @builtin x86
/// Inline assembly architecture qualifier for 32-bit x86 targets.
/// Use with `asm x86(...)` or `asm volatile x86(...)`.
/// Requires `--target-arch x86` at compile time.

// @builtin x64
/// Inline assembly architecture qualifier for 64-bit x86_64 targets.
/// Use with `asm x64(...)` or `asm volatile x64(...)`.
/// Requires `--target-arch x64` at compile time.

// @builtin aarch64
/// Inline assembly architecture qualifier for 64-bit Arm targets.
/// Use with `asm aarch64(...)` or `asm volatile aarch64(...)`.
/// Requires `--target-arch aarch64` at compile time.

// Language keyword reference:
// - `match` performs pattern matching for Result/Option and literal values.
// Example:
// let value: i32 = match maybe {
//     Some(x) => x,
//     None => 0,
// };
