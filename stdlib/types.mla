// MLang built-in types
// This module is documentation-only and is used by editor tooling.
// It is not meant to be imported at runtime.

// @builtin void
// No value. Used as the return type for functions that do not return.

// @builtin bool
// Boolean value: true or false.

// @builtin i8
// Signed 8-bit integer. Range: -128..127.

// @builtin i16
// Signed 16-bit integer. Range: -32768..32767.

// @builtin i32
// Signed 32-bit integer. Range: -2147483648..2147483647.

// @builtin i64
// Signed 64-bit integer. Range: -9223372036854775808..9223372036854775807.

// @builtin u8
// Unsigned 8-bit integer. Range: 0..255.

// @builtin u16
// Unsigned 16-bit integer. Range: 0..65535.

// @builtin u32
// Unsigned 32-bit integer. Range: 0..4294967295.

// @builtin u64
// Unsigned 64-bit integer. Range: 0..18446744073709551615.

// @builtin f32
// 32-bit floating point (single precision).

// @builtin f64
// 64-bit floating point.

// @builtin str8
// UTF-8 string type.
// `String` is the compiler-provided wrapper namespace for str8 intrinsics
// (e.g. `String::new`, `String::with_capacity`, `String::free`).
// It is not a separate runtime type.

// @builtin str16
// UTF-16 string type.

// @builtin list
// Generic list type: list<T>.

// @builtin map
// Generic map type: map<K, V>.

// @builtin tuple
// Tuple type: tuple<T1, T2, ...>.

// @builtin ptr
// Pointer type: ptr<T>.
// Take an address with &value and dereference with *ptr.

// @builtin Handle
// Generic runtime handle type: Handle<T>.
// Used by thread/sync intrinsics such as Handle<Thread>, Handle<Mutex>,
// and Handle<Atomic64>.

// @builtin Thread
// Opaque thread handle payload marker type used with Handle<Thread>.

// @builtin Mutex
// Opaque mutex handle payload marker type used with Handle<Mutex>.

// @builtin Atomic64
// Opaque 64-bit atomic handle payload marker type used with Handle<Atomic64>.

// @builtin Result
// Result<T, E> represents success (Ok) or failure (Err).
// Construct with Ok<T, E>(value) or Err<T, E>(error).
// Methods:
//   - is_ok() -> bool
//   - is_err() -> bool
//   - unwrap() -> T (warning: may panic on Err)
//   - unwrap_err() -> E
// Prefer match or is_ok/is_err checks before unwrap().
// The `?` operator propagates Err values and, for Result<_, str8>, appends
// call-site context (`function:line`) to build an error stack.

// @builtin Ok
// Result constructor: Ok<T, E>(value).

// @builtin Err
// Result constructor: Err<T, E>(error).

// @builtin Option
// Option<T> represents Some(value) or None.
// Construct with Some<T>(value) or None<T>().

// @builtin enum
// Enum declarations define named integral values, optionally with an explicit
// backing type such as `u8` or `i64`.
// Enum values print as `EnumName::Variant`.
// Enums are iterable in declaration order:
//   for value in Status { ... }
//   for (i, value) in Status.enumerate() { ... }
// The enumerate form exposes a zero-based `i64` index plus the enum value.

// @builtin Some
// Option constructor for present values: Some<T>(value).

// @builtin None
// Option constructor for absent values: None<T>().

// Language keyword reference:
// - `match` performs pattern matching for Result/Option and literal values.
// Example:
// let value: i32 = match maybe {
//     Some(x) => x,
//     None => 0,
// };
