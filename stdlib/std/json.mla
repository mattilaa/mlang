/**
 * \file json.mla
 * @brief JSON parse/stringify/navigation helpers for MLang (std::json).
 *
 * Backed by RapidJSON in libmlang_std.
 *
 * `#[derive(Json)]` on a struct synthesizes:
 * - `value.to_json() -> str8`
 * - a lowercase associated `from_json(text)` constructor on the derived struct,
 *   returning `result<your_struct, str8>`
 *
 * The emitted JSON includes inherited base fields directly in the object and,
 * for `@property(...)` members, a sibling `@property` metadata subtree.
 */
/// \cond INTERNAL_IMPORTS
mod std::json::detail;
use std::json::detail::*;
mod std::fs;
mod std::strbuf;

use std::fs::BufReader;
use std::fs::File;
use std::fs::free_lines;
use std::strbuf::concat;
/// \endcond



/// @brief Owned handle to a parsed JSON document tree.
pub struct JsonDoc {
    var handle: i64;
};

/// @brief Non-owning handle to a JSON value within a document.
pub struct JsonValue {
    var handle: i64;
};

/// @brief Index-based iterator over the elements of a JSON array value.
pub struct JsonArrayIter {
    var source: JsonValue;
    var index: i64;
    var len: i64;
};

/// @brief Index-based iterator over the members of a JSON object value.
pub struct JsonObjectIter {
    var source: JsonValue;
    var index: i64;
    var len: i64;
};

/// @brief Lowercase stdlib type alias for `JsonDoc`.
alias json_doc = JsonDoc;

/// @brief Lowercase stdlib type alias for `JsonValue`.
alias json_value = JsonValue;

/// @brief Lowercase stdlib type alias for `JsonArrayIter`.
alias json_array_iter = JsonArrayIter;

/// @brief Lowercase stdlib type alias for `JsonObjectIter`.
alias json_object_iter = JsonObjectIter;


/// @brief Kind tag returned for unusable/invalid values.
/// @return Integer kind discriminator.
pub fn kind_invalid() -> i32 { return 0; }
/// @brief Kind tag for JSON null.
/// @return Integer kind discriminator.
pub fn kind_null() -> i32 { return 1; }
/// @brief Kind tag for JSON booleans.
/// @return Integer kind discriminator.
pub fn kind_bool() -> i32 { return 2; }
/// @brief Kind tag for JSON numbers.
/// @return Integer kind discriminator.
pub fn kind_number() -> i32 { return 3; }
/// @brief Kind tag for JSON strings.
/// @return Integer kind discriminator.
pub fn kind_string() -> i32 { return 4; }
/// @brief Kind tag for JSON arrays.
/// @return Integer kind discriminator.
pub fn kind_array() -> i32 { return 5; }
/// @brief Kind tag for JSON objects.
/// @return Integer kind discriminator.
pub fn kind_object() -> i32 { return 6; }

/// @brief Return the last JSON error message from the native layer.
/// @return UTF-8 error description, or empty string if none.
pub fn last_error() -> str8 {
    return __mlang_std_json_last_error();
}

impl JsonDoc {
    /// Parse a JSON document into an owned handle.
    pub fn parse(text: str8) -> result<JsonDoc, str8> {
        let h: i64 = __mlang_std_json_parse(text);
        if h == 0 {
            return Err<JsonDoc, str8>(last_error());
        }
        return Ok<JsonDoc, str8>(JsonDoc { handle: h });
    }

    /// Parse JSON from a file using std::fs.
    pub fn from_file(path: str8) -> result<JsonDoc, str8> {
        let opened: result<File, str8> = File::open(path);
        if opened.is_err() {
            return Err<JsonDoc, str8>(opened.unwrap_err());
        }
        let file: File = opened.unwrap();
        let reader: BufReader = BufReader::new(file);
        let lines: list<str8> = reader.lines();

        var text: str8 = String::new();
        for line in lines {
            let t1: str8 = concat(text, line);
            String::free(text);
            text = t1;
            let t2: str8 = concat(text, "\n");
            String::free(text);
            text = t2;
        }

        free_lines(lines);

        let parsed: result<JsonDoc, str8> = JsonDoc::parse(text);
        String::free(text);
        return parsed;
    }

    /// Return root value of this document.
    pub fn root(self: JsonDoc) -> result<JsonValue, str8> {
        let h: i64 = __mlang_std_json_doc_root(self.handle);
        if h == 0 {
            return Err<JsonValue, str8>(last_error());
        }
        return Ok<JsonValue, str8>(JsonValue { handle: h });
    }

    /// Stringify JSON document without whitespace formatting.
    pub fn stringify(self: JsonDoc) -> result<str8, str8> {
        let s: str8 = __mlang_std_json_stringify(self.handle, 0);
        return Ok<str8, str8>(s);
    }

    /// Pretty stringify with indentation/newlines.
    pub fn stringify_pretty(self: JsonDoc) -> result<str8, str8> {
        let s: str8 = __mlang_std_json_stringify(self.handle, 1);
        return Ok<str8, str8>(s);
    }

    /// Explicitly free document handle.
    pub fn free(self: JsonDoc) -> void {
        if self.handle != 0 {
            __mlang_std_json_doc_free(self.handle);
        }
    }
}

impl JsonValue {
    /// Returns one of kind_*() constants.
    pub fn kind(self: JsonValue) -> i32 {
        return __mlang_std_json_value_kind(self.handle);
    }

    /// For arrays/objects: element/member count. Otherwise Err.
    pub fn size(self: JsonValue) -> result<i64, str8> {
        let n = __mlang_std_json_value_size(self.handle);
        if n < 0 {
            return Err<i64, str8>(last_error());
        }
        return Ok<i64, str8>(n);
    }

    /// Object field lookup by key.
    pub fn get(self: JsonValue, key: str8) -> result<JsonValue, str8> {
        let h: i64 = __mlang_std_json_object_get(self.handle, key);
        if h == 0 {
            return Err<JsonValue, str8>(last_error());
        }
        return Ok<JsonValue, str8>(JsonValue { handle: h });
    }

    /// Array element lookup by index.
    pub fn index(self: JsonValue, i: i64) -> result<JsonValue, str8> {
        let h: i64 = __mlang_std_json_array_get(self.handle, i);
        if h == 0 {
            return Err<JsonValue, str8>(last_error());
        }
        return Ok<JsonValue, str8>(JsonValue { handle: h });
    }

    /// @brief Decode the value as a boolean.
    /// @return `Ok(0|1)` when the value is a JSON bool, else `Err`.
    pub fn as_bool(self: JsonValue) -> result<i32, str8> {
        if self.kind() != kind_bool() {
            return Err<i32, str8>("std::json as_bool: value is not bool");
        }
        return Ok<i32, str8>(__mlang_std_json_value_as_bool(self.handle));
    }

    /// @brief Decode the value as a signed 64-bit integer.
    /// @return `Ok(i64)` when the value is numeric, else `Err`.
    pub fn as_i64(self: JsonValue) -> result<i64, str8> {
        if self.kind() != kind_number() {
            return Err<i64, str8>("std::json as_i64: value is not number");
        }
        return Ok<i64, str8>(__mlang_std_json_value_as_i64(self.handle));
    }

    /// @brief Decode the value as a 64-bit floating point number.
    /// @return `Ok(f64)` when the value is numeric, else `Err`.
    pub fn as_f64(self: JsonValue) -> result<f64, str8> {
        if self.kind() != kind_number() {
            return Err<f64, str8>("std::json as_f64: value is not number");
        }
        return Ok<f64, str8>(__mlang_std_json_value_as_f64(self.handle));
    }

    /// @brief Decode the value as an owned UTF-8 string.
    /// @return `Ok(str8)` when the value is a JSON string, else `Err`.
    pub fn as_string(self: JsonValue) -> result<str8, str8> {
        if self.kind() != kind_string() {
            return Err<str8, str8>("std::json as_string: value is not string");
        }
        let s: str8 = __mlang_std_json_value_as_string(self.handle);
        return Ok<str8, str8>(s);
    }

    /// Object key name at index, preserving object iteration order.
    pub fn key_at(self: JsonValue, i: i64) -> result<str8, str8> {
        let s: str8 = __mlang_std_json_object_key_at(self.handle, i);
        return Ok<str8, str8>(s);
    }

    /// Create an array iterator from this value.
    pub fn iter_array(self: JsonValue) -> result<JsonArrayIter, str8> {
        if self.kind() != kind_array() {
            return Err<JsonArrayIter, str8>("std::json iter_array: value is not array");
        }
        let n: result<i64, str8> = self.size();
        if n.is_err() {
            return Err<JsonArrayIter, str8>(n.unwrap_err());
        }
        return Ok<JsonArrayIter, str8>(JsonArrayIter {
            source: JsonValue { handle: self.handle },
            index: 0,
            len: n.unwrap()
        });
    }

    /// Create an object iterator from this value.
    pub fn iter_object(self: JsonValue) -> result<JsonObjectIter, str8> {
        if self.kind() != kind_object() {
            return Err<JsonObjectIter, str8>("std::json iter_object: value is not object");
        }
        let n: result<i64, str8> = self.size();
        if n.is_err() {
            return Err<JsonObjectIter, str8>(n.unwrap_err());
        }
        return Ok<JsonObjectIter, str8>(JsonObjectIter {
            source: JsonValue { handle: self.handle },
            index: 0,
            len: n.unwrap()
        });
    }

    /// Explicitly free value handle.
    pub fn free(self: JsonValue) -> void {
        if self.handle != 0 {
            __mlang_std_json_value_free(self.handle);
        }
    }
}

impl JsonArrayIter {
    pub fn has_next(self: JsonArrayIter) -> i32 {
        return self.index < self.len ? 1 : 0;
    }

    pub fn current(self: JsonArrayIter) -> result<JsonValue, str8> {
        if self.has_next() != 1 {
            return Err<JsonValue, str8>("std::json array iter: out of range");
        }
        return self.source.index(self.index);
    }

    pub fn advance(self: JsonArrayIter) -> JsonArrayIter {
        return JsonArrayIter {
            source: JsonValue { handle: self.source.handle },
            index: self.index + 1,
            len: self.len
        };
    }
}

impl JsonObjectIter {
    pub fn has_next(self: JsonObjectIter) -> i32 {
        return self.index < self.len ? 1 : 0;
    }

    pub fn current_key(self: JsonObjectIter) -> result<str8, str8> {
        if self.has_next() != 1 {
            return Err<str8, str8>("std::json object iter: out of range");
        }
        return self.source.key_at(self.index);
    }

    pub fn current_value(self: JsonObjectIter) -> result<JsonValue, str8> {
        if self.has_next() != 1 {
            return Err<JsonValue, str8>("std::json object iter: out of range");
        }
        let key_r: result<str8, str8> = self.current_key();
        if key_r.is_err() {
            return Err<JsonValue, str8>(key_r.unwrap_err());
        }
        let key: str8 = key_r.unwrap();
        let out: result<JsonValue, str8> = self.source.get(key);
        String::free(key);
        return out;
    }

    pub fn advance(self: JsonObjectIter) -> JsonObjectIter {
        return JsonObjectIter {
            source: JsonValue { handle: self.source.handle },
            index: self.index + 1,
            len: self.len
        };
    }
}
