extern fn __mlang_std_math_max_f32(a: float, b: float) -> float;
extern fn __mlang_std_math_max_f64(a: double, b: double) -> double;
extern fn __mlang_std_math_clamp_i32(x: int, low: int, high: int) -> int;
extern fn __mlang_std_math_clamp_f32(x: float, low: float, high: float) -> float;
