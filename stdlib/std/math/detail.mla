extern fn __mlang_std_math_multiply_f32(a: float, b: float) -> float;
extern fn __mlang_std_math_multiply_f64(a: double, b: double) -> double;
extern fn __mlang_std_math_square_i32(x: int) -> int;
extern fn __mlang_std_math_square_f32(x: float) -> float;
extern fn __mlang_std_math_square_f64(x: double) -> double;
extern fn __mlang_std_math_sum_range_i32(start: int, end: int) -> int;
extern fn __mlang_std_math_factorial_i32(n: int) -> int;
extern fn __mlang_std_math_abs_i32(x: int) -> int;
extern fn __mlang_std_math_abs_f32(x: float) -> float;
