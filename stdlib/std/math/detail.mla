/// \file math/detail.mla
/// \brief C ABI bindings for std::math (implementation detail).
///
/// These symbols are resolved by the linker against libmlang_std.
/// Do not call them directly -- use the public API in std::math instead.

extern fn __mlang_std_math_add_i32(a: i32, b: i32) -> i32;
extern fn __mlang_std_math_add_f32(a: f32, b: f32) -> f32;
extern fn __mlang_std_math_add_f64(a: f64, b: f64) -> f64;
extern fn __mlang_std_math_subtract_i32(a: i32, b: i32) -> i32;
extern fn __mlang_std_math_subtract_f32(a: f32, b: f32) -> f32;
extern fn __mlang_std_math_subtract_f64(a: f64, b: f64) -> f64;
extern fn __mlang_std_math_multiply_i32(a: i32, b: i32) -> i32;
extern fn __mlang_std_math_multiply_f32(a: f32, b: f32) -> f32;
extern fn __mlang_std_math_multiply_f64(a: f64, b: f64) -> f64;
extern fn __mlang_std_math_square_i32(x: i32) -> i32;
extern fn __mlang_std_math_square_f32(x: f32) -> f32;
extern fn __mlang_std_math_square_f64(x: f64) -> f64;
extern fn __mlang_std_math_sum_range_i32(start: i32, end: i32) -> i32;
extern fn __mlang_std_math_factorial_i32(n: i32) -> i32;
extern fn __mlang_std_math_abs_i32(x: i32) -> i32;
extern fn __mlang_std_math_abs_f32(x: f32) -> f32;
extern fn __mlang_std_math_abs_f64(x: f64) -> f64;
extern fn __mlang_std_math_min_i32(a: i32, b: i32) -> i32;
extern fn __mlang_std_math_min_f32(a: f32, b: f32) -> f32;
extern fn __mlang_std_math_min_f64(a: f64, b: f64) -> f64;
extern fn __mlang_std_math_max_i32(a: i32, b: i32) -> i32;
extern fn __mlang_std_math_max_f32(a: f32, b: f32) -> f32;
extern fn __mlang_std_math_max_f64(a: f64, b: f64) -> f64;
extern fn __mlang_std_math_clamp_i32(x: i32, low: i32, high: i32) -> i32;
extern fn __mlang_std_math_clamp_f32(x: f32, low: f32, high: f32) -> f32;
extern fn __mlang_std_math_clamp_f64(x: f64, low: f64, high: f64) -> f64;
extern fn __mlang_std_math_clamp_i64(x: i64, low: i64, high: i64) -> i64;
extern fn __mlang_std_math_pow_i32(a: i32, b: i32) -> i32;
extern fn __mlang_std_math_pow_f32(a: f32, b: f32) -> f32;
extern fn __mlang_std_math_pow_f64(a: f64, b: f64) -> f64;
extern fn __mlang_std_math_sqrt_i32(x: i32) -> i32;
extern fn __mlang_std_math_sqrt_f32(x: f32) -> f32;
extern fn __mlang_std_math_sqrt_f64(x: f64) -> f64;
extern fn __mlang_std_math_sin_i32(x: i32) -> i32;
extern fn __mlang_std_math_sin_f32(x: f32) -> f32;
extern fn __mlang_std_math_sin_f64(x: f64) -> f64;
