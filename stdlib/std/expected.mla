/// \file expected.mla
/// \brief Monadic transformations for the built-in result<T, E> type.
///
/// Mlang's `result<T, E>` is the native counterpart of C++23 `std::expected`.
/// Monadic transformations preserve the inactive alternative and invoke their
/// callback only for the active value. Fallback helpers extract the value
/// without changing the input result.

/// @brief Transform a successful result value while preserving its error.
/// The operation is not called for Err; its original error is propagated.
/// C++23 `std::expected::transform` equivalent.
/// @ingroup expected
generic<T, E, Output, Operation>
pub fn transform(input: result<T, E>, operation: Operation)
    -> result<Output, E> {
    if input.is_ok() {
        return Ok<Output, E>(operation(input.unwrap()));
    }
    return Err<Output, E>(input.unwrap_err());
}

/// @brief Transform an error while preserving a successful result value.
/// The operation is not called for Ok; its original value is propagated.
/// C++23 `std::expected::transform_error` equivalent.
/// @ingroup expected
generic<T, E, NewError, Operation>
pub fn transform_error(input: result<T, E>, operation: Operation)
    -> result<T, NewError> {
    if input.is_err() {
        return Err<T, NewError>(operation(input.unwrap_err()));
    }
    return Ok<T, NewError>(input.unwrap());
}

/// @brief Chain a result-producing operation on the successful value.
/// Errors bypass the operation and propagate unchanged.
/// C++23 `std::expected::and_then` equivalent.
/// @ingroup expected
generic<T, E, Output, Operation>
pub fn and_then(input: result<T, E>, operation: Operation)
    -> result<Output, E> {
    if input.is_ok() {
        return operation(input.unwrap());
    }
    return Err<Output, E>(input.unwrap_err());
}

/// @brief Chain a result-producing recovery operation on the error value.
/// Successful values bypass the operation and propagate unchanged.
/// C++23 `std::expected::or_else` equivalent.
/// @ingroup expected
generic<T, E, NewError, Recovery>
pub fn or_else(input: result<T, E>, recovery: Recovery)
    -> result<T, NewError> {
    if input.is_err() {
        return recovery(input.unwrap_err());
    }
    return Ok<T, NewError>(input.unwrap());
}

/// @brief Return the successful value or the supplied fallback value.
/// The fallback is evaluated by the caller before this function is entered,
/// matching C++23 `std::expected::value_or`.
/// @ingroup expected
generic<T, E>
pub fn value_or(input: result<T, E>, fallback: T) -> T {
    if input.is_ok() {
        return input.unwrap();
    }
    return fallback;
}

/// @brief Return the successful value or lazily compute a fallback.
/// The fallback closure is invoked only when the result is an error. This
/// complements C++23 `expected::value_or` when fallback evaluation is costly
/// or has side effects.
/// @ingroup expected
generic<T, E, Fallback>
pub fn value_or_else(input: result<T, E>, fallback: Fallback) -> T {
    if input.is_ok() {
        return input.unwrap();
    }
    return fallback();
}
