/// \file time.mla
/// \brief Time helpers for MLang (std::time).
///
/// Provides monotonic clocks, sleeping, and one-shot timers.
///
/// Local timestamp format helpers:
/// - `local_datetime()`     -> `MM/DD/YYYY:HH/MM/SS`
/// - `local_datetime_ms()`  -> `MM/DD/YYYY:HH/MM/SS.MS`
/// - `local_datetime_ns()`  -> `MM/DD/YYYY:HH/MM/SS.NS`

/// \cond INTERNAL_IMPORTS
mod std::date;
use std::date::DateTime;
use std::date::now;
/// \endcond

extern pub fn __mlang_std_time_now_ms() -> i64;
extern pub fn __mlang_std_time_now_ns() -> i64;
extern pub fn __mlang_std_time_sleep_ms(ms: i64) -> void;
extern pub fn __mlang_std_time_timer_new(timeout_ms: i64) -> i64;
extern pub fn __mlang_std_time_timer_reset(handle: i64, timeout_ms: i64) -> int;
extern pub fn __mlang_std_time_timer_elapsed(handle: i64) -> int;
extern pub fn __mlang_std_time_timer_remaining_ms(handle: i64) -> i64;
extern pub fn __mlang_std_time_timer_wait(handle: i64) -> int;
extern pub fn __mlang_std_time_timer_free(handle: i64) -> int;

/// @brief One-shot monotonic timer.
pub struct Timer {
    var handle: i64;
};

fn __pad2(v: i32) -> string {
    if v < 10 {
        return format!("0{}", v);
    }
    return format!("{}", v);
}

fn __pad3(v: i64) -> string {
    if v < 10 {
        return format!("00{}", v);
    }
    if v < 100 {
        return format!("0{}", v);
    }
    return format!("{}", v);
}

fn __pad9(v: i64) -> string {
    if v < 10 {
        return format!("00000000{}", v);
    }
    if v < 100 {
        return format!("0000000{}", v);
    }
    if v < 1000 {
        return format!("000000{}", v);
    }
    if v < 10000 {
        return format!("00000{}", v);
    }
    if v < 100000 {
        return format!("0000{}", v);
    }
    if v < 1000000 {
        return format!("000{}", v);
    }
    if v < 10000000 {
        return format!("00{}", v);
    }
    if v < 100000000 {
        return format!("0{}", v);
    }
    return format!("{}", v);
}

fn __dt_prefix(dt: DateTime) -> string {
    let mm: string = __pad2(dt.month);
    let dd: string = __pad2(dt.day);
    let hh: string = __pad2(dt.hour);
    let mi: string = __pad2(dt.minute);
    let ss: string = __pad2(dt.second);
    return format!("{}/{}/{}:{}/{}/{}", mm, dd, dt.year, hh, mi, ss);
}

/// @brief Monotonic milliseconds since unspecified epoch.
pub fn now_ms() -> i64 {
    return __mlang_std_time_now_ms();
}

/// @brief Monotonic nanoseconds since unspecified epoch.
pub fn now_ns() -> i64 {
    return __mlang_std_time_now_ns();
}

/// @brief Local wall-clock timestamp `MM/DD/YYYY:HH/MM/SS`.
pub fn local_datetime() -> string {
    let dt: DateTime = now();
    return __dt_prefix(dt);
}

/// @brief Local wall-clock timestamp `MM/DD/YYYY:HH/MM/SS.MS`.
pub fn local_datetime_ms() -> string {
    let dt: DateTime = now();
    let ms: i64 = now_ms() % 1000;
    return format!("{}.{}", __dt_prefix(dt), __pad3(ms));
}

/// @brief Local wall-clock timestamp `MM/DD/YYYY:HH/MM/SS.NS`.
pub fn local_datetime_ns() -> string {
    let dt: DateTime = now();
    let ns: i64 = now_ns() % 1000000000;
    return format!("{}.{}", __dt_prefix(dt), __pad9(ns));
}

/// @brief Sleep current thread for at least `ms` milliseconds.
pub fn sleep_ms(ms: i64) -> void {
    __mlang_std_time_sleep_ms(ms);
}

impl Timer {
    /// @brief Create timer that elapses after `timeout_ms`.
    pub fn after(timeout_ms: i64) -> Result<Timer, string> {
        let h: i64 = __mlang_std_time_timer_new(timeout_ms);
        if h == 0 {
            return Err<Timer, string>("std::time Timer::after failed");
        }
        return Ok<Timer, string>(Timer { handle: h });
    }

    /// @brief Reset timer deadline to now + `timeout_ms`.
    pub fn reset(self: Timer, timeout_ms: i64) -> i32 {
        return __mlang_std_time_timer_reset(self.handle, timeout_ms);
    }

    /// @brief Return `1` when timer deadline has passed.
    pub fn elapsed(self: Timer) -> int {
        return __mlang_std_time_timer_elapsed(self.handle);
    }

    /// @brief Return remaining time in ms (0 when elapsed).
    pub fn remaining_ms(self: Timer) -> i64 {
        return __mlang_std_time_timer_remaining_ms(self.handle);
    }

    /// @brief Block current thread until timer elapses.
    pub fn wait(self: Timer) -> i32 {
        return __mlang_std_time_timer_wait(self.handle);
    }

    /// @brief Free timer handle.
    pub fn close(self: Timer) -> i32 {
        return __mlang_std_time_timer_free(self.handle);
    }
}
