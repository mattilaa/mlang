/// \file utility.mla
/// \brief C++20/23-style utility operations for MLang.

/// @brief Convert an integer-backed enum to its declared underlying type.
///
/// MLang does not expose an associated-type expression for an enum's
/// underlying integer type, so the destination type is inferred from the
/// caller's expected result type. Use the enum's declared underlying type:
/// ```mla
/// let raw: u8 = to_underlying(MyByteEnum::Value);
/// ```
/// This is the Mlang counterpart to C++23 `std::to_underlying`.
/// @ingroup utility
generic<Enum, Underlying>
pub fn to_underlying(value: Enum) -> Underlying {
    return Underlying(value);
}

/// @brief Replace a mutable value and return its previous contents.
/// This is the value-level counterpart of C++ `std::exchange`. Both the
/// returned old value and replacement have the same type.
/// @ingroup utility
generic<T>
pub fn exchange(value: &mut T, replacement: T) -> T {
    let previous: T = value;
    value = replacement;
    return previous;
}

/// @brief Compare a signed integer and an unsigned integer without wraparound.
/// Mlang counterpart to C++20 `std::cmp_equal` for mixed-sign values.
generic<Signed, Unsigned>
pub fn cmp_equal_signed_unsigned(signed: Signed, unsigned: Unsigned) -> bool {
    let signed_wide: i64 = i64(signed);
    if signed_wide < 0 { return false; }
    return u64(signed_wide) == u64(unsigned);
}

/// @brief Mixed-sign equality with operands in unsigned/signed order.
generic<Unsigned, Signed>
pub fn cmp_equal_unsigned_signed(unsigned: Unsigned, signed: Signed) -> bool {
    return cmp_equal_signed_unsigned(signed, unsigned);
}

/// @brief Signed-before-unsigned mixed-sign comparison.
generic<Signed, Unsigned>
pub fn cmp_less_signed_unsigned(signed: Signed, unsigned: Unsigned) -> bool {
    let signed_wide: i64 = i64(signed);
    if signed_wide < 0 { return true; }
    return u64(signed_wide) < u64(unsigned);
}

/// @brief Unsigned-before-signed mixed-sign comparison.
generic<Unsigned, Signed>
pub fn cmp_less_unsigned_signed(unsigned: Unsigned, signed: Signed) -> bool {
    let signed_wide: i64 = i64(signed);
    if signed_wide < 0 { return false; }
    return u64(unsigned) < u64(signed_wide);
}

/// @brief Whether a signed operand is greater than an unsigned operand.
generic<Signed, Unsigned>
pub fn cmp_greater_signed_unsigned(signed: Signed, unsigned: Unsigned)
    -> bool {
    return cmp_less_unsigned_signed(unsigned, signed);
}

/// @brief Whether an unsigned operand is greater than a signed operand.
generic<Unsigned, Signed>
pub fn cmp_greater_unsigned_signed(unsigned: Unsigned, signed: Signed)
    -> bool {
    return cmp_less_signed_unsigned(signed, unsigned);
}

/// @brief Mixed-sign inequality for signed/unsigned operands.
generic<Signed, Unsigned>
pub fn cmp_not_equal_signed_unsigned(signed: Signed, unsigned: Unsigned)
    -> bool {
    return !cmp_equal_signed_unsigned(signed, unsigned);
}

/// @brief Mixed-sign inequality for unsigned/signed operands.
generic<Unsigned, Signed>
pub fn cmp_not_equal_unsigned_signed(unsigned: Unsigned, signed: Signed)
    -> bool {
    return !cmp_equal_unsigned_signed(unsigned, signed);
}

/// @brief Mixed-sign less-or-equal comparison for signed/unsigned operands.
generic<Signed, Unsigned>
pub fn cmp_less_equal_signed_unsigned(signed: Signed, unsigned: Unsigned)
    -> bool {
    return !cmp_greater_signed_unsigned(signed, unsigned);
}

/// @brief Mixed-sign less-or-equal comparison for unsigned/signed operands.
generic<Unsigned, Signed>
pub fn cmp_less_equal_unsigned_signed(unsigned: Unsigned, signed: Signed)
    -> bool {
    return !cmp_greater_unsigned_signed(unsigned, signed);
}

/// @brief Mixed-sign greater-or-equal comparison for signed/unsigned operands.
generic<Signed, Unsigned>
pub fn cmp_greater_equal_signed_unsigned(signed: Signed, unsigned: Unsigned)
    -> bool {
    return !cmp_less_signed_unsigned(signed, unsigned);
}

/// @brief Mixed-sign greater-or-equal comparison for unsigned/signed operands.
generic<Unsigned, Signed>
pub fn cmp_greater_equal_unsigned_signed(unsigned: Unsigned, signed: Signed)
    -> bool {
    return !cmp_less_unsigned_signed(unsigned, signed);
}

/// @brief Check conversion from `i64` to a narrower or unsigned integer type.
pub fn in_range_i64_from_i64(value: i64) -> bool { return true; }
pub fn in_range_i8_from_i64(value: i64) -> bool {
    return value >= -128 && value <= 127;
}
pub fn in_range_i16_from_i64(value: i64) -> bool {
    return value >= -32768 && value <= 32767;
}
pub fn in_range_i32_from_i64(value: i64) -> bool {
    return value >= -2147483648 && value <= 2147483647;
}
pub fn in_range_u8_from_i64(value: i64) -> bool {
    return value >= 0 && value <= 255;
}
pub fn in_range_u16_from_i64(value: i64) -> bool {
    return value >= 0 && value <= 65535;
}
pub fn in_range_u32_from_i64(value: i64) -> bool {
    return value >= 0 && value <= 4294967295;
}
pub fn in_range_u64_from_i64(value: i64) -> bool {
    return value >= 0;
}

/// @brief Check conversion from `u64` to a smaller integer type.
pub fn in_range_u64_from_u64(value: u64) -> bool { return true; }
pub fn in_range_i8_from_u64(value: u64) -> bool { return value <= 127; }
pub fn in_range_i16_from_u64(value: u64) -> bool { return value <= 32767; }
pub fn in_range_i32_from_u64(value: u64) -> bool {
    return value <= 2147483647;
}
pub fn in_range_i64_from_u64(value: u64) -> bool {
    return value <= 9223372036854775807;
}
pub fn in_range_u8_from_u64(value: u64) -> bool { return value <= 255; }
pub fn in_range_u16_from_u64(value: u64) -> bool { return value <= 65535; }
pub fn in_range_u32_from_u64(value: u64) -> bool {
    return value <= 4294967295;
}
