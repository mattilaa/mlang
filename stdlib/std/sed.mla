/// \file sed.mla
/// \brief Sed-like literal string substitution helpers for MLang (std::sed).
///
/// This module provides allocation-returning replacement helpers for `str8`.
/// Matching is literal and byte-based, not regex-based.

mod std::strbuf;

use std::strbuf::StringBuilder;
use std::strbuf::builder_append;
use std::strbuf::builder_free;
use std::strbuf::builder_new;
use std::strbuf::builder_take_string;
use std::strbuf::clone;
use std::strbuf::find;
use std::strbuf::free;
use std::strbuf::len;
use std::strbuf::sub;

fn append_slice(builder: StringBuilder, s: str8, start: i64, count: i64) -> i64 {
    let piece: str8 = sub(s, start, count);
    let wrote: i64 = builder_append(builder, piece);
    free(piece);
    return wrote;
}

/// @brief Replace the first literal occurrence of `needle` in `text`.
/// @return Newly allocated string. Caller frees it with `std::strbuf::free`.
/// @note Empty `needle` returns a clone of `text`.
pub fn replace_first(text: str8, needle: str8, replacement: str8) -> str8 {
    let needle_len: i64 = len(needle);
    if needle_len == 0 { return clone(text); }

    let pos: i64 = find(text, needle);
    if pos < 0 { return clone(text); }

    let out: StringBuilder = builder_new(len(text) - needle_len + len(replacement));
    append_slice(out, text, 0, pos);
    builder_append(out, replacement);
    append_slice(out, text, pos + needle_len, len(text) - pos - needle_len);

    let result: str8 = builder_take_string(out);
    builder_free(out);
    return result;
}

/// @brief Replace all literal occurrences of `needle` in `text`.
/// @return Newly allocated string. Caller frees it with `std::strbuf::free`.
/// @note Empty `needle` returns a clone of `text`.
pub fn replace_all(text: str8, needle: str8, replacement: str8) -> str8 {
    let needle_len: i64 = len(needle);
    if needle_len == 0 { return clone(text); }

    let text_len: i64 = len(text);
    let out: StringBuilder = builder_new(text_len);
    var cursor: i64 = 0;

    while cursor < text_len {
        let tail: str8 = sub(text, cursor, text_len - cursor);
        let rel: i64 = find(tail, needle);
        free(tail);

        if rel < 0 {
            append_slice(out, text, cursor, text_len - cursor);
            break;
        }

        let pos: i64 = cursor + rel;
        append_slice(out, text, cursor, pos - cursor);
        builder_append(out, replacement);
        cursor = pos + needle_len;
    }

    let result: str8 = builder_take_string(out);
    builder_free(out);
    return result;
}

/// @brief Sed-style substitution alias for `replace_all`.
/// @return Newly allocated string. Caller frees it with `std::strbuf::free`.
pub fn substitute(text: str8, needle: str8, replacement: str8) -> str8 {
    return replace_all(text, needle, replacement);
}
