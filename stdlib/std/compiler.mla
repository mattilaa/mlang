    /// @brief Return completion item count at 1-based line/column.
    pub fn completion_count(self: SessionRef, uri: str8, line: i32, column: i32) -> Result<i32, str8> {
        let count: i32 = __mlang_std_compiler_document_completion_count(self.handle, uri, line, column);
        if count < 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(count);
    }

    /// @brief Fetch completion item by index for 1-based line/column.
    pub fn completion_get(self: SessionRef, uri: str8, line: i32, column: i32, index: i32) -> Result<str8, str8> {
        let item: str8 = __mlang_std_compiler_document_completion_get(self.handle, uri, line, column, index);
        if last_status() != 0 {
            return Err<str8, str8>(last_error());
        }
        return Ok<str8, str8>(item);
    }

    /// @brief Return declared symbol count for a document.
    pub fn document_symbol_count(self: SessionRef, uri: str8) -> Result<i32, str8> {
        let count: i32 = __mlang_std_compiler_document_symbol_count(self.handle, uri);
        if count < 0 {
            return Err<i32, str8>(last_error());
