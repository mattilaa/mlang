/// \file compiler.mla
/// \brief Incremental parse/query APIs for MLang tooling (std::compiler).
///
/// This module exposes compiler session/document/query APIs to MLang code.
/// It wraps the compiler C ABI with MLang-friendly handles and Result values.

extern pub fn __mlang_std_compiler_last_error() -> str8;
extern pub fn __mlang_std_compiler_last_status() -> i32;
extern pub fn __mlang_std_compiler_status_name(status: i32) -> str8;
extern pub fn __mlang_std_compiler_version() -> str8;
extern pub fn __mlang_std_compiler_session_create() -> i64;
extern pub fn __mlang_std_compiler_session_destroy(handle: i64) -> i32;
extern pub fn __mlang_std_compiler_document_open(handle: i64, uri: str8, language_id: str8, text: str8, version: i32) -> i32;
extern pub fn __mlang_std_compiler_document_change(handle: i64, uri: str8, text: str8, version: i32) -> i32;
extern pub fn __mlang_std_compiler_document_close(handle: i64, uri: str8) -> i32;
extern pub fn __mlang_std_compiler_document_syntax_diagnostic_count(handle: i64, uri: str8) -> i32;
extern pub fn __mlang_std_compiler_document_syntax_diagnostic_line(handle: i64, uri: str8, index: i32) -> i32;
extern pub fn __mlang_std_compiler_document_syntax_diagnostic_column(handle: i64, uri: str8, index: i32) -> i32;
extern pub fn __mlang_std_compiler_document_syntax_diagnostic_message(handle: i64, uri: str8, index: i32) -> str8;
extern pub fn __mlang_std_compiler_document_hover(handle: i64, uri: str8, line: i32, column: i32) -> str8;
extern pub fn __mlang_std_compiler_document_completion_count(handle: i64, uri: str8, line: i32, column: i32) -> i32;
extern pub fn __mlang_std_compiler_document_completion_get(handle: i64, uri: str8, line: i32, column: i32, index: i32) -> str8;
extern pub fn __mlang_std_compiler_document_symbol_count(handle: i64, uri: str8) -> i32;
extern pub fn __mlang_std_compiler_document_symbol_name(handle: i64, uri: str8, index: i32) -> str8;
extern pub fn __mlang_std_compiler_document_symbol_kind(handle: i64, uri: str8, index: i32) -> i32;
extern pub fn __mlang_std_compiler_document_symbol_line(handle: i64, uri: str8, index: i32) -> i32;
extern pub fn __mlang_std_compiler_document_symbol_column(handle: i64, uri: str8, index: i32) -> i32;
extern pub fn __mlang_std_compiler_document_symbol_id(handle: i64, uri: str8, index: i32) -> str8;
extern pub fn __mlang_std_compiler_document_symbol_type(handle: i64, uri: str8, index: i32) -> str8;
extern pub fn __mlang_std_compiler_document_symbol_signature(handle: i64, uri: str8, index: i32) -> str8;
extern pub fn __mlang_std_compiler_document_definition_line(handle: i64, uri: str8, line: i32, column: i32) -> i32;
extern pub fn __mlang_std_compiler_document_definition_column(handle: i64, uri: str8, line: i32, column: i32) -> i32;
extern pub fn __mlang_std_compiler_document_definition_name(handle: i64, uri: str8, line: i32, column: i32) -> str8;
extern pub fn __mlang_std_compiler_document_definition_uri(handle: i64, uri: str8, line: i32, column: i32) -> str8;
extern pub fn __mlang_std_compiler_document_definition_id(handle: i64, uri: str8, line: i32, column: i32) -> str8;
extern pub fn __mlang_std_compiler_resolve_symbol_name(handle: i64, uri: str8, line: i32, column: i32) -> str8;
extern pub fn __mlang_std_compiler_resolve_symbol_kind(handle: i64, uri: str8, line: i32, column: i32) -> i32;
extern pub fn __mlang_std_compiler_resolve_symbol_line(handle: i64, uri: str8, line: i32, column: i32) -> i32;
extern pub fn __mlang_std_compiler_resolve_symbol_column(handle: i64, uri: str8, line: i32, column: i32) -> i32;
extern pub fn __mlang_std_compiler_resolve_symbol_uri(handle: i64, uri: str8, line: i32, column: i32) -> str8;
extern pub fn __mlang_std_compiler_resolve_symbol_id(handle: i64, uri: str8, line: i32, column: i32) -> str8;
extern pub fn __mlang_std_compiler_resolve_symbol_type(handle: i64, uri: str8, line: i32, column: i32) -> str8;
extern pub fn __mlang_std_compiler_resolve_symbol_signature(handle: i64, uri: str8, line: i32, column: i32) -> str8;
extern pub fn __mlang_std_compiler_resolve_symbol_overload_count(handle: i64, uri: str8, line: i32, column: i32) -> i32;
extern pub fn __mlang_std_compiler_resolve_symbol_from_current_document(handle: i64, uri: str8, line: i32, column: i32) -> i32;
extern pub fn __mlang_std_compiler_document_reference_count(handle: i64, uri: str8, line: i32, column: i32) -> i32;
extern pub fn __mlang_std_compiler_document_reference_uri(handle: i64, uri: str8, line: i32, column: i32, index: i32) -> str8;
extern pub fn __mlang_std_compiler_document_reference_line(handle: i64, uri: str8, line: i32, column: i32, index: i32) -> i32;
extern pub fn __mlang_std_compiler_document_reference_column(handle: i64, uri: str8, line: i32, column: i32, index: i32) -> i32;
extern pub fn __mlang_std_compiler_document_rename_is_safe(handle: i64, uri: str8, line: i32, column: i32, new_name: str8) -> i32;
extern pub fn __mlang_std_compiler_semantic_cache_warm(handle: i64, uri: str8) -> i32;
extern pub fn __mlang_std_compiler_semantic_cache_clear(handle: i64) -> i32;

/// @brief Opaque compiler session handle.
pub struct Session {
    var handle: i64;
};

/// @brief Non-owning compiler session view.
pub struct SessionRef {
    var handle: i64;
};

/// @brief Syntax diagnostic record for a document.
pub struct SyntaxDiagnostic {
    var line: i32;
    var column: i32;
    var message: str8;
};

/// @brief Declared symbol in a document.
pub struct DocumentSymbol {
    var id: str8;
    var name: str8;
    var type_info: str8;
    var signature: str8;
    var kind: i32;
    var line: i32;
    var column: i32;
};

/// @brief Definition location in the same document.
pub struct DefinitionLocation {
    var id: str8;
    var name: str8;
    var uri: str8;
    var line: i32;
    var column: i32;
};

/// @brief One reference location for a symbol.
pub struct ReferenceLocation {
    var uri: str8;
    var line: i32;
    var column: i32;
};

/// @brief Symbol resolution details at a query position.
pub struct ResolvedSymbol {
    var id: str8;
    var name: str8;
    var uri: str8;
    var type_info: str8;
    var signature: str8;
    var kind: i32;
    var line: i32;
    var column: i32;
    var overload_count: i32;
    var from_current_document: i32;
};

/// @brief Return last backend status code.
pub fn last_status() -> i32 {
    return __mlang_std_compiler_last_status();
}

/// @brief Return last backend status name.
pub fn status_name(status: i32) -> str8 {
    return __mlang_std_compiler_status_name(status);
}

/// @brief Return compiler/stdlib build version string.
pub fn version() -> str8 {
    return __mlang_std_compiler_version();
}

/// @brief Return last backend error/status text.
pub fn last_error() -> str8 {
    return __mlang_std_compiler_last_error();
}

/// @brief Create a new compiler session.
pub fn session_create() -> Result<Session, str8> {
    let h: i64 = __mlang_std_compiler_session_create();
    if h == 0 {
        return Err<Session, str8>(last_error());
    }
    return Ok<Session, str8>(Session { handle: h });
}

/// @brief Create a new compiler session and return the raw handle.
pub fn session_create_handle() -> Result<i64, str8> {
    let h: i64 = __mlang_std_compiler_session_create();
    if h == 0 {
        return Err<i64, str8>(last_error());
    }
    return Ok<i64, str8>(h);
}

/// @brief Create a non-owning session view from a raw handle.
pub fn session_ref(handle: i64) -> SessionRef {
    return SessionRef { handle: handle };
}

impl Session {
    /// @brief Destroy compiler session and release associated document state.
    pub fn destroy(self: Session) -> Result<i32, str8> {
        let st: i32 = __mlang_std_compiler_session_destroy(self.handle);
        if st != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Open or replace a document in this session.
    pub fn open_document(self: Session, uri: str8, language_id: str8, text: str8, version: i32) -> Result<i32, str8> {
        let st: i32 = __mlang_std_compiler_document_open(self.handle, uri, language_id, text, version);
        if st != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Replace full text for an already-open document, enforcing monotonic version.
    pub fn change_document(self: Session, uri: str8, text: str8, version: i32) -> Result<i32, str8> {
        let st: i32 = __mlang_std_compiler_document_change(self.handle, uri, text, version);
        if st != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Close and forget a document in this session.
    pub fn close_document(self: Session, uri: str8) -> Result<i32, str8> {
        let st: i32 = __mlang_std_compiler_document_close(self.handle, uri);
        if st != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Return number of syntax diagnostics for a document.
    pub fn syntax_diagnostic_count(self: Session, uri: str8) -> Result<i32, str8> {
        let count: i32 = __mlang_std_compiler_document_syntax_diagnostic_count(self.handle, uri);
        if count < 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(count);
    }

    /// @brief Fetch one syntax diagnostic by index.
    pub fn syntax_diagnostic_get(self: Session, uri: str8, index: i32) -> Result<SyntaxDiagnostic, str8> {
        let line: i32 = __mlang_std_compiler_document_syntax_diagnostic_line(self.handle, uri, index);
        if line < 0 {
            return Err<SyntaxDiagnostic, str8>(last_error());
        }
        let column: i32 = __mlang_std_compiler_document_syntax_diagnostic_column(self.handle, uri, index);
        if column < 0 {
            return Err<SyntaxDiagnostic, str8>(last_error());
        }
        let msg: str8 = __mlang_std_compiler_document_syntax_diagnostic_message(self.handle, uri, index);
        if last_status() != 0 {
            return Err<SyntaxDiagnostic, str8>(last_error());
        }
        return Ok<SyntaxDiagnostic, str8>(SyntaxDiagnostic {
            line: line,
            column: column,
            message: msg
        });
    }

    /// @brief Return hover text at 1-based line/column.
    pub fn hover(self: Session, uri: str8, line: i32, column: i32) -> Result<str8, str8> {
        let msg: str8 = __mlang_std_compiler_document_hover(self.handle, uri, line, column);
        if last_status() != 0 {
            return Err<str8, str8>(last_error());
        }
        return Ok<str8, str8>(msg);
    }

    /// @brief Return completion item count at 1-based line/column.
    pub fn completion_count(self: Session, uri: str8, line: i32, column: i32) -> Result<i32, str8> {
        let count: i32 = __mlang_std_compiler_document_completion_count(self.handle, uri, line, column);
        if count < 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(count);
    }

    /// @brief Fetch completion item by index for 1-based line/column.
    pub fn completion_get(self: Session, uri: str8, line: i32, column: i32, index: i32) -> Result<str8, str8> {
        let item: str8 = __mlang_std_compiler_document_completion_get(self.handle, uri, line, column, index);
        if last_status() != 0 {
            return Err<str8, str8>(last_error());
        }
        return Ok<str8, str8>(item);
    }

    /// @brief Return declared symbol count for a document.
    pub fn document_symbol_count(self: Session, uri: str8) -> Result<i32, str8> {
        let count: i32 = __mlang_std_compiler_document_symbol_count(self.handle, uri);
        if count < 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(count);
    }

    /// @brief Fetch one declared symbol by index.
    pub fn document_symbol_get(self: Session, uri: str8, index: i32) -> Result<DocumentSymbol, str8> {
        let line: i32 = __mlang_std_compiler_document_symbol_line(self.handle, uri, index);
        if line < 0 {
            return Err<DocumentSymbol, str8>(last_error());
        }
        let column: i32 = __mlang_std_compiler_document_symbol_column(self.handle, uri, index);
        if column < 0 {
            return Err<DocumentSymbol, str8>(last_error());
        }
        let kind: i32 = __mlang_std_compiler_document_symbol_kind(self.handle, uri, index);
        if kind < 0 {
            return Err<DocumentSymbol, str8>(last_error());
        }
        let id: str8 = __mlang_std_compiler_document_symbol_id(self.handle, uri, index);
        if last_status() != 0 {
            return Err<DocumentSymbol, str8>(last_error());
        }
        let name: str8 = __mlang_std_compiler_document_symbol_name(self.handle, uri, index);
        if last_status() != 0 {
            return Err<DocumentSymbol, str8>(last_error());
        }
        let type_info: str8 = __mlang_std_compiler_document_symbol_type(self.handle, uri, index);
        if last_status() != 0 {
            return Err<DocumentSymbol, str8>(last_error());
        }
        let signature: str8 = __mlang_std_compiler_document_symbol_signature(self.handle, uri, index);
        if last_status() != 0 {
            return Err<DocumentSymbol, str8>(last_error());
        }
        return Ok<DocumentSymbol, str8>(DocumentSymbol {
            id: id,
            name: name,
            type_info: type_info,
            signature: signature,
            kind: kind,
            line: line,
            column: column
        });
    }

    /// @brief Resolve definition for symbol under cursor (same document scope).
    pub fn definition(self: Session, uri: str8, line: i32, column: i32) -> Result<DefinitionLocation, str8> {
        let def_line: i32 = __mlang_std_compiler_document_definition_line(self.handle, uri, line, column);
        if def_line < 0 {
            return Err<DefinitionLocation, str8>(last_error());
        }
        let def_column: i32 = __mlang_std_compiler_document_definition_column(self.handle, uri, line, column);
        if def_column < 0 {
            return Err<DefinitionLocation, str8>(last_error());
        }
        let def_name: str8 = __mlang_std_compiler_document_definition_name(self.handle, uri, line, column);
        if last_status() != 0 {
            return Err<DefinitionLocation, str8>(last_error());
        }
        let def_uri: str8 = __mlang_std_compiler_document_definition_uri(self.handle, uri, line, column);
        if last_status() != 0 {
            return Err<DefinitionLocation, str8>(last_error());
        }
        let def_id: str8 = __mlang_std_compiler_document_definition_id(self.handle, uri, line, column);
        if last_status() != 0 {
            return Err<DefinitionLocation, str8>(last_error());
        }
        return Ok<DefinitionLocation, str8>(DefinitionLocation {
            id: def_id,
            name: def_name,
            uri: def_uri,
            line: def_line,
            column: def_column
        });
    }

    /// @brief Count references to symbol under cursor across loaded/workspace-resolved documents.
    pub fn references_count(self: Session, uri: str8, line: i32, column: i32) -> Result<i32, str8> {
        let count: i32 = __mlang_std_compiler_document_reference_count(self.handle, uri, line, column);
        if count < 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(count);
    }

    /// @brief Fetch one reference location by index.
    pub fn reference_get(self: Session, uri: str8, line: i32, column: i32, index: i32) -> Result<ReferenceLocation, str8> {
        let ref_line: i32 = __mlang_std_compiler_document_reference_line(self.handle, uri, line, column, index);
        if ref_line < 0 {
            return Err<ReferenceLocation, str8>(last_error());
        }
        let ref_col: i32 = __mlang_std_compiler_document_reference_column(self.handle, uri, line, column, index);
        if ref_col < 0 {
            return Err<ReferenceLocation, str8>(last_error());
        }
        let ref_uri: str8 = __mlang_std_compiler_document_reference_uri(self.handle, uri, line, column, index);
        if last_status() != 0 {
            return Err<ReferenceLocation, str8>(last_error());
        }
        return Ok<ReferenceLocation, str8>(ReferenceLocation {
            uri: ref_uri,
            line: ref_line,
            column: ref_col
        });
    }

    /// @brief Resolve symbol under cursor with typed metadata and overload count.
    pub fn resolve_symbol(self: Session, uri: str8, line: i32, column: i32) -> Result<ResolvedSymbol, str8> {
        let sym_line: i32 = __mlang_std_compiler_resolve_symbol_line(self.handle, uri, line, column);
        if sym_line < 0 {
            return Err<ResolvedSymbol, str8>(last_error());
        }
        let sym_col: i32 = __mlang_std_compiler_resolve_symbol_column(self.handle, uri, line, column);
        if sym_col < 0 {
            return Err<ResolvedSymbol, str8>(last_error());
        }
        let kind: i32 = __mlang_std_compiler_resolve_symbol_kind(self.handle, uri, line, column);
        if kind < 0 {
            return Err<ResolvedSymbol, str8>(last_error());
        }
        let overload_count: i32 = __mlang_std_compiler_resolve_symbol_overload_count(self.handle, uri, line, column);
        if overload_count < 0 {
            return Err<ResolvedSymbol, str8>(last_error());
        }
        let from_current_document: i32 = __mlang_std_compiler_resolve_symbol_from_current_document(self.handle, uri, line, column);
        if from_current_document < 0 {
            return Err<ResolvedSymbol, str8>(last_error());
        }
        let id: str8 = __mlang_std_compiler_resolve_symbol_id(self.handle, uri, line, column);
        if last_status() != 0 {
            return Err<ResolvedSymbol, str8>(last_error());
        }
        let name: str8 = __mlang_std_compiler_resolve_symbol_name(self.handle, uri, line, column);
        if last_status() != 0 {
            return Err<ResolvedSymbol, str8>(last_error());
        }
        let sym_uri: str8 = __mlang_std_compiler_resolve_symbol_uri(self.handle, uri, line, column);
        if last_status() != 0 {
            return Err<ResolvedSymbol, str8>(last_error());
        }
        let type_info: str8 = __mlang_std_compiler_resolve_symbol_type(self.handle, uri, line, column);
        if last_status() != 0 {
            return Err<ResolvedSymbol, str8>(last_error());
        }
        let signature: str8 = __mlang_std_compiler_resolve_symbol_signature(self.handle, uri, line, column);
        if last_status() != 0 {
            return Err<ResolvedSymbol, str8>(last_error());
        }
        return Ok<ResolvedSymbol, str8>(ResolvedSymbol {
            id: id,
            name: name,
            uri: sym_uri,
            type_info: type_info,
            signature: signature,
            kind: kind,
            line: sym_line,
            column: sym_col,
            overload_count: overload_count,
            from_current_document: from_current_document
        });
    }

    /// @brief Conservative rename safety check (1 safe, 0 unsafe).
    pub fn rename_is_safe(self: Session, uri: str8, line: i32, column: i32, new_name: str8) -> Result<i32, str8> {
        let safe: i32 = __mlang_std_compiler_document_rename_is_safe(self.handle, uri, line, column, new_name);
        if safe < 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(safe);
    }

    /// @brief Warm semantic cache for a document + workspace graph rooted from it.
    pub fn semantic_cache_warm(self: Session, uri: str8) -> Result<i32, str8> {
        let st: i32 = __mlang_std_compiler_semantic_cache_warm(self.handle, uri);
        if st != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Clear cached semantic snapshots for this session.
    pub fn semantic_cache_clear(self: Session) -> Result<i32, str8> {
        let st: i32 = __mlang_std_compiler_semantic_cache_clear(self.handle);
        if st != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }
}

