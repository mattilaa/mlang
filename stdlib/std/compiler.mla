    /// @brief Return hover text at 1-based line/column.
    pub fn hover(self: SessionRef, uri: str8, line: i32, column: i32) -> Result<str8, str8> {
        let msg: str8 = __mlang_std_compiler_document_hover(self.handle, uri, line, column);
