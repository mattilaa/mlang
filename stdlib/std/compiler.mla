    /// @brief Open or replace a document in this session.
    pub fn open_document(self: SessionRef, uri: str8, language_id: str8, text: str8, version: i32) -> Result<i32, str8> {
        let st: i32 = __mlang_std_compiler_document_open(self.handle, uri, language_id, text, version);
        if st != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

