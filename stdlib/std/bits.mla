/// \file bits.mla
/// \brief Helpers for the builtin `bit` type.
///
/// `bit` is a logical one-bit domain whose values are only `0` or `1`.
/// Standalone `bit` values still use normal ABI byte-sized storage rules for
/// `size_of(bit)`, but packed bit storage is provided by `std::bitset::BitSet`.

extern pub fn __mlang_std_bits_popcount_u64(value: u64) -> i64;
extern pub fn __mlang_std_bits_has_single_bit_u64(value: u64) -> i32;
extern pub fn __mlang_std_bits_bit_width_u64(value: u64) -> i64;
extern pub fn __mlang_std_bits_countl_zero_u64(value: u64) -> i64;
extern pub fn __mlang_std_bits_countr_zero_u64(value: u64) -> i64;
extern pub fn __mlang_std_bits_countl_one_u64(value: u64) -> i64;
extern pub fn __mlang_std_bits_countr_one_u64(value: u64) -> i64;
extern pub fn __mlang_std_bits_bit_floor_u64(value: u64) -> u64;
extern pub fn __mlang_std_bits_bit_ceil_u64(value: u64) -> u64;
extern pub fn __mlang_std_bits_rotl_u64(value: u64, shift: i64) -> u64;
extern pub fn __mlang_std_bits_rotr_u64(value: u64, shift: i64) -> u64;
extern pub fn __mlang_std_bits_popcount_u32(value: u32) -> i64;
extern pub fn __mlang_std_bits_has_single_bit_u32(value: u32) -> i32;
extern pub fn __mlang_std_bits_bit_width_u32(value: u32) -> i64;
extern pub fn __mlang_std_bits_countl_zero_u32(value: u32) -> i64;
extern pub fn __mlang_std_bits_countr_zero_u32(value: u32) -> i64;
extern pub fn __mlang_std_bits_countl_one_u32(value: u32) -> i64;
extern pub fn __mlang_std_bits_countr_one_u32(value: u32) -> i64;
extern pub fn __mlang_std_bits_bit_floor_u32(value: u32) -> u32;
extern pub fn __mlang_std_bits_bit_ceil_u32(value: u32) -> u32;
extern pub fn __mlang_std_bits_rotl_u32(value: u32, shift: i64) -> u32;
extern pub fn __mlang_std_bits_rotr_u32(value: u32, shift: i64) -> u32;
extern pub fn __mlang_std_bits_popcount_u16(value: u16) -> i64;
extern pub fn __mlang_std_bits_has_single_bit_u16(value: u16) -> i32;
extern pub fn __mlang_std_bits_bit_width_u16(value: u16) -> i64;
extern pub fn __mlang_std_bits_countl_zero_u16(value: u16) -> i64;
extern pub fn __mlang_std_bits_countr_zero_u16(value: u16) -> i64;
extern pub fn __mlang_std_bits_countl_one_u16(value: u16) -> i64;
extern pub fn __mlang_std_bits_countr_one_u16(value: u16) -> i64;
extern pub fn __mlang_std_bits_bit_floor_u16(value: u16) -> u16;
extern pub fn __mlang_std_bits_bit_ceil_u16(value: u16) -> u16;
extern pub fn __mlang_std_bits_rotl_u16(value: u16, shift: i64) -> u16;
extern pub fn __mlang_std_bits_rotr_u16(value: u16, shift: i64) -> u16;
extern pub fn __mlang_std_bits_popcount_u8(value: u8) -> i64;
extern pub fn __mlang_std_bits_has_single_bit_u8(value: u8) -> i32;
extern pub fn __mlang_std_bits_bit_width_u8(value: u8) -> i64;
extern pub fn __mlang_std_bits_countl_zero_u8(value: u8) -> i64;
extern pub fn __mlang_std_bits_countr_zero_u8(value: u8) -> i64;
extern pub fn __mlang_std_bits_countl_one_u8(value: u8) -> i64;
extern pub fn __mlang_std_bits_countr_one_u8(value: u8) -> i64;
extern pub fn __mlang_std_bits_bit_floor_u8(value: u8) -> u8;
extern pub fn __mlang_std_bits_bit_ceil_u8(value: u8) -> u8;
extern pub fn __mlang_std_bits_rotl_u8(value: u8, shift: i64) -> u8;
extern pub fn __mlang_std_bits_rotr_u8(value: u8, shift: i64) -> u8;
extern pub fn __mlang_std_bits_byteswap_u64(value: u64) -> u64;
extern pub fn __mlang_std_bits_byteswap_u32(value: u32) -> u32;
extern pub fn __mlang_std_bits_byteswap_u16(value: u16) -> u16;
extern pub fn __mlang_std_bits_byteswap_u8(value: u8) -> u8;
extern pub fn __mlang_std_bits_f32_to_u32(value: f32) -> u32;
extern pub fn __mlang_std_bits_u32_to_f32(value: u32) -> f32;
extern pub fn __mlang_std_bits_f64_to_u64(value: f64) -> u64;
extern pub fn __mlang_std_bits_u64_to_f64(value: u64) -> f64;
extern pub fn __mlang_std_bits_i32_to_u32(value: i32) -> u32;
extern pub fn __mlang_std_bits_u32_to_i32(bits: u32) -> i32;
extern pub fn __mlang_std_bits_i64_to_u64(value: i64) -> u64;
extern pub fn __mlang_std_bits_u64_to_i64(bits: u64) -> i64;
extern pub fn __mlang_std_bits_i8_to_u8(value: i8) -> u8;
extern pub fn __mlang_std_bits_u8_to_i8(bits: u8) -> i8;
extern pub fn __mlang_std_bits_i16_to_u16(value: i16) -> u16;
extern pub fn __mlang_std_bits_u16_to_i16(bits: u16) -> i16;

/// @brief Logical on value (`1`).
pub fn on() -> bit {
    return bit(1);
}

/// @brief Logical off value (`0`).
pub fn off() -> bit {
    return bit(0);
}

/// @brief Compatibility wrapper for `on()`.
pub fn ON() -> bit {
    return on();
}

/// @brief Compatibility wrapper for `off()`.
pub fn OFF() -> bit {
    return off();
}

/// @brief Count set bits in an unsigned 64-bit value.
/// C++20 equivalent of `std::popcount`.
pub fn popcount_u64(value: u64) -> i64 {
    return __mlang_std_bits_popcount_u64(value);
}

/// @brief Return whether a value is a nonzero power of two.
/// C++20 equivalent of `std::has_single_bit`.
pub fn has_single_bit_u64(value: u64) -> bool {
    return __mlang_std_bits_has_single_bit_u64(value) != 0;
}

/// @brief Return the number of bits needed to represent a value.
/// C++20 equivalent of `std::bit_width`.
pub fn bit_width_u64(value: u64) -> i64 {
    return __mlang_std_bits_bit_width_u64(value);
}

/// @brief Count the leading zero bits, returning 64 for zero.
pub fn countl_zero_u64(value: u64) -> i64 {
    return __mlang_std_bits_countl_zero_u64(value);
}

/// @brief Count the trailing zero bits, returning 64 for zero.
pub fn countr_zero_u64(value: u64) -> i64 {
    return __mlang_std_bits_countr_zero_u64(value);
}

/// @brief Count the leading one bits.
pub fn countl_one_u64(value: u64) -> i64 {
    return __mlang_std_bits_countl_one_u64(value);
}

/// @brief Count the trailing one bits.
pub fn countr_one_u64(value: u64) -> i64 {
    return __mlang_std_bits_countr_one_u64(value);
}

/// @brief Return the greatest power of two not greater than `value`.
/// Returns zero when `value` is zero; equivalent to `std::bit_floor`.
pub fn bit_floor_u64(value: u64) -> u64 {
    return __mlang_std_bits_bit_floor_u64(value);
}

/// @brief Return the least power of two not less than `value`.
/// Returns zero when the result cannot be represented in `u64`.
pub fn bit_ceil_u64(value: u64) -> u64 {
    return __mlang_std_bits_bit_ceil_u64(value);
}

/// @brief Rotate bits left; negative shifts rotate right.
pub fn rotl_u64(value: u64, shift: i64) -> u64 {
    return __mlang_std_bits_rotl_u64(value, shift);
}

/// @brief Rotate bits right; negative shifts rotate left.
pub fn rotr_u64(value: u64, shift: i64) -> u64 {
    return __mlang_std_bits_rotr_u64(value, shift);
}

/// @brief C++20 `<bit>` operations for a 32-bit unsigned integer.
pub fn popcount_u32(value: u32) -> i64 { return __mlang_std_bits_popcount_u32(value); }
pub fn has_single_bit_u32(value: u32) -> bool { return __mlang_std_bits_has_single_bit_u32(value) != 0; }
pub fn bit_width_u32(value: u32) -> i64 { return __mlang_std_bits_bit_width_u32(value); }
pub fn countl_zero_u32(value: u32) -> i64 { return __mlang_std_bits_countl_zero_u32(value); }
pub fn countr_zero_u32(value: u32) -> i64 { return __mlang_std_bits_countr_zero_u32(value); }
pub fn countl_one_u32(value: u32) -> i64 { return __mlang_std_bits_countl_one_u32(value); }
pub fn countr_one_u32(value: u32) -> i64 { return __mlang_std_bits_countr_one_u32(value); }
pub fn bit_floor_u32(value: u32) -> u32 { return __mlang_std_bits_bit_floor_u32(value); }
pub fn bit_ceil_u32(value: u32) -> u32 { return __mlang_std_bits_bit_ceil_u32(value); }
pub fn rotl_u32(value: u32, shift: i64) -> u32 { return __mlang_std_bits_rotl_u32(value, shift); }
pub fn rotr_u32(value: u32, shift: i64) -> u32 { return __mlang_std_bits_rotr_u32(value, shift); }

/// @brief C++20 `<bit>` operations for a 16-bit unsigned integer.
pub fn popcount_u16(value: u16) -> i64 { return __mlang_std_bits_popcount_u16(value); }
pub fn has_single_bit_u16(value: u16) -> bool { return __mlang_std_bits_has_single_bit_u16(value) != 0; }
pub fn bit_width_u16(value: u16) -> i64 { return __mlang_std_bits_bit_width_u16(value); }
pub fn countl_zero_u16(value: u16) -> i64 { return __mlang_std_bits_countl_zero_u16(value); }
pub fn countr_zero_u16(value: u16) -> i64 { return __mlang_std_bits_countr_zero_u16(value); }
pub fn countl_one_u16(value: u16) -> i64 { return __mlang_std_bits_countl_one_u16(value); }
pub fn countr_one_u16(value: u16) -> i64 { return __mlang_std_bits_countr_one_u16(value); }
pub fn bit_floor_u16(value: u16) -> u16 { return __mlang_std_bits_bit_floor_u16(value); }
pub fn bit_ceil_u16(value: u16) -> u16 { return __mlang_std_bits_bit_ceil_u16(value); }
pub fn rotl_u16(value: u16, shift: i64) -> u16 { return __mlang_std_bits_rotl_u16(value, shift); }
pub fn rotr_u16(value: u16, shift: i64) -> u16 { return __mlang_std_bits_rotr_u16(value, shift); }

/// @brief C++20 `<bit>` operations for an 8-bit unsigned integer.
pub fn popcount_u8(value: u8) -> i64 { return __mlang_std_bits_popcount_u8(value); }
pub fn has_single_bit_u8(value: u8) -> bool { return __mlang_std_bits_has_single_bit_u8(value) != 0; }
pub fn bit_width_u8(value: u8) -> i64 { return __mlang_std_bits_bit_width_u8(value); }
pub fn countl_zero_u8(value: u8) -> i64 { return __mlang_std_bits_countl_zero_u8(value); }
pub fn countr_zero_u8(value: u8) -> i64 { return __mlang_std_bits_countr_zero_u8(value); }
pub fn countl_one_u8(value: u8) -> i64 { return __mlang_std_bits_countl_one_u8(value); }
pub fn countr_one_u8(value: u8) -> i64 { return __mlang_std_bits_countr_one_u8(value); }
pub fn bit_floor_u8(value: u8) -> u8 { return __mlang_std_bits_bit_floor_u8(value); }
pub fn bit_ceil_u8(value: u8) -> u8 { return __mlang_std_bits_bit_ceil_u8(value); }
pub fn rotl_u8(value: u8, shift: i64) -> u8 { return __mlang_std_bits_rotl_u8(value, shift); }
pub fn rotr_u8(value: u8, shift: i64) -> u8 { return __mlang_std_bits_rotr_u8(value, shift); }

/// @brief Reverse the byte order of a 64-bit integer.
/// C++23 equivalent of `std::byteswap`.
pub fn byteswap_u64(value: u64) -> u64 {
    return __mlang_std_bits_byteswap_u64(value);
}

/// @brief Reverse the byte order of a 32-bit integer (C++23 `std::byteswap`).
pub fn byteswap_u32(value: u32) -> u32 {
    return __mlang_std_bits_byteswap_u32(value);
}

/// @brief Reverse the byte order of a 16-bit integer (C++23 `std::byteswap`).
pub fn byteswap_u16(value: u16) -> u16 {
    return __mlang_std_bits_byteswap_u16(value);
}

/// @brief Reverse the byte order of an 8-bit integer (no-op byte swap).
pub fn byteswap_u8(value: u8) -> u8 {
    return __mlang_std_bits_byteswap_u8(value);
}

/// @brief Reinterpret an IEEE-754 `f32` representation as `u32` bits.
/// C++20 `std::bit_cast` equivalent for this type pair.
pub fn bit_cast_u32_from_f32(value: f32) -> u32 {
    return __mlang_std_bits_f32_to_u32(value);
}

/// @brief Reinterpret `u32` bits as an IEEE-754 `f32` value.
pub fn bit_cast_f32_from_u32(bits: u32) -> f32 {
    return __mlang_std_bits_u32_to_f32(bits);
}

/// @brief Reinterpret an IEEE-754 `f64` representation as `u64` bits.
pub fn bit_cast_u64_from_f64(value: f64) -> u64 {
    return __mlang_std_bits_f64_to_u64(value);
}

/// @brief Reinterpret `u64` bits as an IEEE-754 `f64` value.
pub fn bit_cast_f64_from_u64(bits: u64) -> f64 {
    return __mlang_std_bits_u64_to_f64(bits);
}

/// @brief Reinterpret the two's-complement bits of an `i32` as `u32`.
/// C++20 `std::bit_cast` equivalent for this same-size type pair.
pub fn bit_cast_u32_from_i32(value: i32) -> u32 {
    return __mlang_std_bits_i32_to_u32(value);
}

/// @brief Reinterpret `u32` bits as an `i32` without numeric conversion.
pub fn bit_cast_i32_from_u32(bits: u32) -> i32 {
    return __mlang_std_bits_u32_to_i32(bits);
}

/// @brief Reinterpret the two's-complement bits of an `i64` as `u64`.
pub fn bit_cast_u64_from_i64(value: i64) -> u64 {
    return __mlang_std_bits_i64_to_u64(value);
}

/// @brief Reinterpret `u64` bits as an `i64` without numeric conversion.
pub fn bit_cast_i64_from_u64(bits: u64) -> i64 {
    return __mlang_std_bits_u64_to_i64(bits);
}

/// @brief Reinterpret the same-width bit pattern from `i8` to `u8`.
pub fn bit_cast_u8_from_i8(value: i8) -> u8 {
    return __mlang_std_bits_i8_to_u8(value);
}

/// @brief Reinterpret the same-width bit pattern from `u8` to `i8`.
pub fn bit_cast_i8_from_u8(bits: u8) -> i8 {
    return __mlang_std_bits_u8_to_i8(bits);
}

/// @brief Reinterpret the same-width bit pattern from `i16` to `u16`.
pub fn bit_cast_u16_from_i16(value: i16) -> u16 {
    return __mlang_std_bits_i16_to_u16(value);
}

/// @brief Reinterpret the same-width bit pattern from `u16` to `i16`.
pub fn bit_cast_i16_from_u16(bits: u16) -> i16 {
    return __mlang_std_bits_u16_to_i16(bits);
}
