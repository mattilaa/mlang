/// \file bits.mla
/// \brief Helpers for the builtin `bit` type.
///
/// `bit` is a logical one-bit domain whose values are only `0` or `1`.
/// Standalone `bit` values still use normal ABI byte-sized storage rules for
/// `size_of(bit)`, but packed bit storage is provided by `std::bitset::BitSet`.

extern pub fn __mlang_std_bits_popcount_u64(value: u64) -> i64;
extern pub fn __mlang_std_bits_has_single_bit_u64(value: u64) -> i32;
extern pub fn __mlang_std_bits_bit_width_u64(value: u64) -> i64;
extern pub fn __mlang_std_bits_countl_zero_u64(value: u64) -> i64;
extern pub fn __mlang_std_bits_countr_zero_u64(value: u64) -> i64;
extern pub fn __mlang_std_bits_countl_one_u64(value: u64) -> i64;
extern pub fn __mlang_std_bits_countr_one_u64(value: u64) -> i64;
extern pub fn __mlang_std_bits_bit_floor_u64(value: u64) -> u64;
extern pub fn __mlang_std_bits_bit_ceil_u64(value: u64) -> u64;
extern pub fn __mlang_std_bits_rotl_u64(value: u64, shift: i64) -> u64;
extern pub fn __mlang_std_bits_rotr_u64(value: u64, shift: i64) -> u64;
extern pub fn __mlang_std_bits_byteswap_u64(value: u64) -> u64;
extern pub fn __mlang_std_bits_f32_to_u32(value: f32) -> u32;
extern pub fn __mlang_std_bits_u32_to_f32(value: u32) -> f32;
extern pub fn __mlang_std_bits_f64_to_u64(value: f64) -> u64;
extern pub fn __mlang_std_bits_u64_to_f64(value: u64) -> f64;

/// @brief Logical on value (`1`).
pub fn on() -> bit {
    return bit(1);
}

/// @brief Logical off value (`0`).
pub fn off() -> bit {
    return bit(0);
}

/// @brief Compatibility wrapper for `on()`.
pub fn ON() -> bit {
    return on();
}

/// @brief Compatibility wrapper for `off()`.
pub fn OFF() -> bit {
    return off();
}

/// @brief Count set bits in an unsigned 64-bit value.
/// C++20 equivalent of `std::popcount`.
pub fn popcount_u64(value: u64) -> i64 {
    return __mlang_std_bits_popcount_u64(value);
}

/// @brief Return whether a value is a nonzero power of two.
/// C++20 equivalent of `std::has_single_bit`.
pub fn has_single_bit_u64(value: u64) -> bool {
    return __mlang_std_bits_has_single_bit_u64(value) != 0;
}

/// @brief Return the number of bits needed to represent a value.
/// C++20 equivalent of `std::bit_width`.
pub fn bit_width_u64(value: u64) -> i64 {
    return __mlang_std_bits_bit_width_u64(value);
}

/// @brief Count the leading zero bits, returning 64 for zero.
pub fn countl_zero_u64(value: u64) -> i64 {
    return __mlang_std_bits_countl_zero_u64(value);
}

/// @brief Count the trailing zero bits, returning 64 for zero.
pub fn countr_zero_u64(value: u64) -> i64 {
    return __mlang_std_bits_countr_zero_u64(value);
}

/// @brief Count the leading one bits.
pub fn countl_one_u64(value: u64) -> i64 {
    return __mlang_std_bits_countl_one_u64(value);
}

/// @brief Count the trailing one bits.
pub fn countr_one_u64(value: u64) -> i64 {
    return __mlang_std_bits_countr_one_u64(value);
}

/// @brief Return the greatest power of two not greater than `value`.
/// Returns zero when `value` is zero; equivalent to `std::bit_floor`.
pub fn bit_floor_u64(value: u64) -> u64 {
    return __mlang_std_bits_bit_floor_u64(value);
}

/// @brief Return the least power of two not less than `value`.
/// Returns zero when the result cannot be represented in `u64`.
pub fn bit_ceil_u64(value: u64) -> u64 {
    return __mlang_std_bits_bit_ceil_u64(value);
}

/// @brief Rotate bits left; negative shifts rotate right.
pub fn rotl_u64(value: u64, shift: i64) -> u64 {
    return __mlang_std_bits_rotl_u64(value, shift);
}

/// @brief Rotate bits right; negative shifts rotate left.
pub fn rotr_u64(value: u64, shift: i64) -> u64 {
    return __mlang_std_bits_rotr_u64(value, shift);
}

/// @brief Reverse the byte order of a 64-bit integer.
/// C++23 equivalent of `std::byteswap`.
pub fn byteswap_u64(value: u64) -> u64 {
    return __mlang_std_bits_byteswap_u64(value);
}

/// @brief Reinterpret an IEEE-754 `f32` representation as `u32` bits.
/// C++20 `std::bit_cast` equivalent for this type pair.
pub fn bit_cast_u32_from_f32(value: f32) -> u32 {
    return __mlang_std_bits_f32_to_u32(value);
}

/// @brief Reinterpret `u32` bits as an IEEE-754 `f32` value.
pub fn bit_cast_f32_from_u32(bits: u32) -> f32 {
    return __mlang_std_bits_u32_to_f32(bits);
}

/// @brief Reinterpret an IEEE-754 `f64` representation as `u64` bits.
pub fn bit_cast_u64_from_f64(value: f64) -> u64 {
    return __mlang_std_bits_f64_to_u64(value);
}

/// @brief Reinterpret `u64` bits as an IEEE-754 `f64` value.
pub fn bit_cast_f64_from_u64(bits: u64) -> f64 {
    return __mlang_std_bits_u64_to_f64(bits);
}
