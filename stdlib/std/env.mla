/// \file env.mla
/// \brief Environment helpers used by package-manager style tools (std::env).
///
/// This module exposes a small runtime-bound surface for argv/cwd/printing.
/// `cwd`/print helpers are commonly available. `args` helpers depend on host
/// runtime integration.

mod std::strbuf;

use std::strbuf::fit_right;
use std::strbuf::concat;
use std::strbuf::eq;
use std::strbuf::repeat;
use std::strbuf::sub;
extern pub fn __mlang_std_strbuf_len(s: str8) -> i64;

extern pub fn __env_args() -> list<str8>;
extern pub fn __env_len(values: list<str8>) -> i64;
extern pub fn __env_get(values: list<str8>, index: i64) -> str8;
extern pub fn __env_cwd() -> str8;
extern pub fn __env_println(msg: str8) -> void;
extern pub fn __env_stderrln(msg: str8) -> void;

/// @brief Return process argument vector from runtime.
pub fn args() -> list<str8> {
    return __env_args();
}

/// @brief Return list length helper used by runtime-bound env lists.
pub fn len(values: &list<str8>) -> i64 {
    return __env_len(values);
}

/// @brief Return list element at `index` from runtime-bound env lists.
pub fn get(values: &list<str8>, index: i64) -> str8 {
    return __env_get(values, index);
}

/// @brief Return current working directory from runtime.
pub fn cwd() -> str8 {
    return __env_cwd();
}

/// @brief Print line to stdout through runtime.
pub fn println(msg: str8) -> void {
    __env_println(msg);
}

/// @brief Print line to stderr through runtime.
pub fn eprintln(msg: str8) -> void {
    __env_stderrln(msg);
}

/// @brief Help option descriptor used by `render_help`.
pub struct HelpOption {
    var long_name: str8;
    var short_name: str8;
    var default_value: str8;
    var has_default: i32;
    var description: str8;
};

impl HelpOption {
    /// @brief Create a help option without default value.
    pub fn new(long_name: str8, short_name: str8, description: str8) -> HelpOption {
        return HelpOption {
            long_name: long_name,
            short_name: short_name,
            default_value: "",
            has_default: 0,
            description: description
        };
    }

    /// @brief Create a help option with default value shown as `[default=...]`.
    pub fn with_default(long_name: str8, short_name: str8, default_value: str8, description: str8) -> HelpOption {
        return HelpOption {
            long_name: long_name,
            short_name: short_name,
            default_value: default_value,
            has_default: 1,
            description: description
        };
    }
}

fn max_i64(a: i64, b: i64) -> i64 {
    if a >= b {
        return a;
    }
    return b;
}

fn str_len(s: str8) -> i64 {
    return __mlang_std_strbuf_len(s);
}

/// @brief Return the starting column index of the Description text in rendered help rows.
pub fn help_description_indent(options: list<HelpOption>) -> i64 {
    var lw: i64 = str_len("--help");
    var sw: i64 = str_len("-h");
    var dw: i64 = 0;
    while options.len() > 0 {
        let opt: HelpOption = options.pop();
        let long_name: str8 = opt.long_name;
        let short_name: str8 = opt.short_name;
        let default_value: str8 = opt.default_value;
        let has_default: i32 = opt.has_default;
        let lc: str8 = format!("--{}", long_name);
        var sc: str8 = "";
        if str_len(short_name) > 0 {
            sc = format!("-{}", short_name);
        }
        var dc: str8 = "";
        if has_default != 0 {
            dc = format!("[default={}]", default_value);
        }
        lw = max_i64(lw, str_len(lc));
        sw = max_i64(sw, str_len(sc));
        dw = max_i64(dw, str_len(dc));
    }
    return 2 + lw + 2 + sw + 2 + dw + 2;
}

fn wrap_words(text: str8, width: i64) -> list<str8> {
    var out: list<str8> = [];
    if width <= 0 {
        out.push(text);
        return out;
    }
    let n: i64 = str_len(text);
    var i: i64 = 0;
    var line: str8 = "";
    while i < n {
        while i < n && eq(sub(text, i, 1), " ") == 1 {
            i = i + 1;
        }
        if i >= n {
            break;
        }

        var j: i64 = i;
        while j < n && eq(sub(text, j, 1), " ") != 1 {
            j = j + 1;
        }
        let word: str8 = sub(text, i, j - i);
        if str_len(line) == 0 {
            line = word;
        } else {
            if str_len(line) + 1 + str_len(word) <= width {
                line = concat(concat(line, " "), word);
            } else {
                out.push(line);
                line = word;
            }
        }
        i = j + 1;
    }
    if str_len(line) > 0 {
        out.push(line);
    }
    if out.len() == 0 {
        out.push("");
    }
    return out;
}

/// @brief Render aligned CLI help text with wrapped description column.
///
/// Layout:
/// - Long option column (`--name`) aligned by max long-name width.
/// - Short option column (`-n`) aligned by max short-name width.
/// - Optional default column (`[default=x]`) aligned by max default width.
/// - Description column wraps to the next line at same description start column.
pub fn render_help(app: str8, overview: str8, options: list<HelpOption>, total_width: i64) -> str8 {
    var lw: i64 = str_len("--help");
    var sw: i64 = str_len("-h");
    var dw: i64 = 0;
    var long_cells: list<str8> = [];
    var short_cells: list<str8> = [];
    var default_cells: list<str8> = [];
    var descriptions: list<str8> = [];
    while options.len() > 0 {
        let opt: HelpOption = options.pop();
        let long_name: str8 = opt.long_name;
        let short_name: str8 = opt.short_name;
        let default_value: str8 = opt.default_value;
        let has_default: i32 = opt.has_default;
        let lc: str8 = format!("--{}", long_name);
        var sc: str8 = "";
        if str_len(short_name) > 0 {
            sc = format!("-{}", short_name);
        }
        var dc: str8 = "";
        if has_default != 0 {
            dc = format!("[default={}]", default_value);
        }
        lw = max_i64(lw, str_len(lc));
        sw = max_i64(sw, str_len(sc));
        dw = max_i64(dw, str_len(dc));
        long_cells.push(lc);
        short_cells.push(sc);
        default_cells.push(dc);
        descriptions.push(opt.description);
    }
    let desc_indent: i64 = 2 + lw + 2 + sw + 2 + dw + 2;

    var desc_width: i64 = total_width - desc_indent;
    if desc_width < 20 {
        desc_width = 20;
    }

    var out: str8 = "";
    out = format!("Usage: {} [options]\n", app);
    if str_len(overview) > 0 {
        out = concat(out, format!("{}\n", overview));
    }
    out = concat(out, "\nOptions:\n");

    var i: i64 = long_cells.len() - 1;
    while i >= 0 {
        let lc: str8 = fit_right(long_cells[i], lw, " ");
        let sc: str8 = fit_right(short_cells[i], sw, " ");
        let dc: str8 = fit_right(default_cells[i], dw, " ");
        let prefix: str8 = format!("  {}  {}  {}  ", lc, sc, dc);
        let wrapped: list<str8> = wrap_words(descriptions[i], desc_width);
        out = concat(out, format!("{}{}\n", prefix, wrapped[0]));
        for j in 1..wrapped.len() {
            out = concat(out, format!("{}{}\n", repeat(" ", desc_indent), wrapped[j]));
        }
        i = i - 1;
    }
    return out;
}

/// @brief Return true when `-h` or `--help` was present in args.
pub fn wants_help(values: list<str8>) -> i32 {
    for i in 0..values.len() {
        let v: str8 = values[i];
        if eq(v, "-h") == 1 || eq(v, "--help") == 1 {
            return 1;
        }
    }
    return 0;
}

/// @brief Safe argv accessor with fallback when `index` is out of bounds.
pub fn arg_or(values: list<str8>, index: i64, fallback: str8) -> str8 {
    if index < 0 || index >= values.len() {
        return fallback;
    }
    return values[index];
}

// Compatibility names used by imported mlangpkg prototype.
pub fn env_args() -> list<str8> { return args(); }
pub fn env_len(values: &list<str8>) -> i64 { return len(values); }
pub fn env_get(values: &list<str8>, index: i64) -> str8 { return get(values, index); }
pub fn env_cwd() -> str8 { return cwd(); }
pub fn env_println(msg: str8) -> void { println(msg); }
pub fn env_error(msg: str8) -> void { eprintln(msg); }
pub fn env_wants_help(values: list<str8>) -> i32 { return wants_help(values); }
