/// \file sync.mla
/// \brief Synchronization primitives for MLang (std::sync).
///
/// Provides:
/// - mutex
/// - Condvar
/// - Channel (string message queue)
/// - LockFreeQueue (string SPSC lock-free queue)
/// - SpscQueue<T> (preallocated, fixed-size event queue)


/// \cond INTERNAL_IMPORTS
mod std::sync::detail;
use std::sync::detail::*;
/// \endcond

/// @brief mutex handle.
pub struct mutex {
    var raw: i64;
};

/// @brief Condition variable handle.
pub struct Condvar {
    var handle: i64;
};

/// @brief String channel handle.
pub struct Channel {
    var handle: i64;
};

/// @brief Lock-free string queue handle (single-producer/single-consumer).
pub struct LockFreeQueue {
    var handle: i64;
};

/// @brief Lowercase stdlib type alias for `Condvar`.
alias condvar = Condvar;

/// @brief Lowercase stdlib type alias for `Channel`.
alias channel = Channel;

/// @brief Lowercase stdlib type alias for `LockFreeQueue`.
alias lock_free_queue = LockFreeQueue;

/// @brief Preallocated single-producer/single-consumer queue of byte-copied T values.
/// T must contain only self-contained, fixed-size values (numbers, enums,
/// and structs of those). No strings, lists, arrays, pointers, references,
/// managed resources, or types with copy/drop hooks.
/// This requirement is a caller contract, not a compiler-enforced constraint.
/// Exactly one thread may push and exactly one thread may pop. Copies of this
/// handle share storage. Call release exactly once after both threads stop.
pub struct SpscQueue<T> {
    var handle: i64;
};

/// @brief Ordering constraints for atomic operations (C++20 `memory_order`).
pub enum AtomicOrder : i32 {
    Relaxed = 0,
    Consume = 1,
    Acquire = 2,
    Release = 3,
    AcqRel = 4,
    SeqCst = 5
};

/// @brief Shared, sequentially consistent or explicitly ordered atomic i64.
/// Handle copies share the same atomic object. Call close exactly once after
/// all threads have stopped using it.
pub struct AtomicI64 {
    var handle: i64;
};

fn atomic_order_value(order: AtomicOrder) -> i32 {
    if order == AtomicOrder::Relaxed { return 0; }
    if order == AtomicOrder::Consume { return 1; }
    if order == AtomicOrder::Acquire { return 2; }
    if order == AtomicOrder::Release { return 3; }
    if order == AtomicOrder::AcqRel { return 4; }
    return 5;
}

impl AtomicI64 {
    /// @brief Create an atomic i64, or return the backend error.
    pub fn new(initial: i64) -> result<AtomicI64, str8> {
        let handle: i64 = __mlang_std_sync_atomic_i64_new(initial);
        if handle == 0 {
            return Err<AtomicI64, str8>(last_error());
        }
        return Ok<AtomicI64, str8>(AtomicI64 { handle: handle });
    }

    pub fn is_valid(self: AtomicI64) -> bool {
        return self.handle != 0;
    }

    /// @brief Load with sequentially consistent ordering.
    pub fn load(self: AtomicI64) -> result<i64, str8> {
        return self.load_with_order(AtomicOrder::SeqCst);
    }

    pub fn load_with_order(self: AtomicI64, order: AtomicOrder) -> result<i64, str8> {
        var output: i64 = 0;
        let rc: i32 = __mlang_std_sync_atomic_i64_load(self.handle, atomic_order_value(order), &output);
        if rc != 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(output);
    }

    /// @brief Store with sequentially consistent ordering.
    pub fn store(self: AtomicI64, value: i64) -> result<i32, str8> {
        return self.store_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn store_with_order(self: AtomicI64, value: i64, order: AtomicOrder) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_atomic_i64_store(self.handle, value, atomic_order_value(order));
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    /// @brief Replace the value; return the old value (seq_cst).
    pub fn exchange(self: AtomicI64, value: i64) -> result<i64, str8> {
        return self.exchange_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn exchange_with_order(self: AtomicI64, value: i64, order: AtomicOrder) -> result<i64, str8> {
        var output: i64 = 0;
        let rc: i32 = __mlang_std_sync_atomic_i64_exchange(self.handle, value, atomic_order_value(order), &output);
        if rc != 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(output);
    }

    /// @brief Atomically add and return the previous value (seq_cst).
    pub fn fetch_add(self: AtomicI64, value: i64) -> result<i64, str8> {
        return self.fetch_add_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn fetch_add_with_order(self: AtomicI64, value: i64, order: AtomicOrder) -> result<i64, str8> {
        var output: i64 = 0;
        let rc: i32 = __mlang_std_sync_atomic_i64_fetch_add(self.handle, value, atomic_order_value(order), &output);
        if rc != 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(output);
    }

    pub fn fetch_sub(self: AtomicI64, value: i64) -> result<i64, str8> {
        return self.fetch_sub_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn fetch_sub_with_order(self: AtomicI64, value: i64, order: AtomicOrder) -> result<i64, str8> {
        var output: i64 = 0;
        let rc: i32 = __mlang_std_sync_atomic_i64_fetch_sub(self.handle, value, atomic_order_value(order), &output);
        if rc != 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(output);
    }

    pub fn fetch_and(self: AtomicI64, value: i64) -> result<i64, str8> {
        return self.fetch_and_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn fetch_and_with_order(self: AtomicI64, value: i64, order: AtomicOrder) -> result<i64, str8> {
        var output: i64 = 0;
        let rc: i32 = __mlang_std_sync_atomic_i64_fetch_and(self.handle, value, atomic_order_value(order), &output);
        if rc != 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(output);
    }

    pub fn fetch_or(self: AtomicI64, value: i64) -> result<i64, str8> {
        return self.fetch_or_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn fetch_or_with_order(self: AtomicI64, value: i64, order: AtomicOrder) -> result<i64, str8> {
        var output: i64 = 0;
        let rc: i32 = __mlang_std_sync_atomic_i64_fetch_or(self.handle, value, atomic_order_value(order), &output);
        if rc != 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(output);
    }

    pub fn fetch_xor(self: AtomicI64, value: i64) -> result<i64, str8> {
        return self.fetch_xor_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn fetch_xor_with_order(self: AtomicI64, value: i64, order: AtomicOrder) -> result<i64, str8> {
        var output: i64 = 0;
        let rc: i32 = __mlang_std_sync_atomic_i64_fetch_xor(self.handle, value, atomic_order_value(order), &output);
        if rc != 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(output);
    }

    /// @brief Strong compare/exchange. On failure, `expected` is updated with
    /// the observed value. Failure ordering is derived from `order` as in the
    /// single-order C++ overload.
    pub fn compare_exchange(self: AtomicI64, expected: ptr<i64>, desired: i64,
                            order: AtomicOrder) -> result<bool, str8> {
        let rc: i32 = __mlang_std_sync_atomic_i64_compare_exchange(self.handle, expected, desired, atomic_order_value(order));
        if rc < 0 { return Err<bool, str8>(last_error()); }
        return Ok<bool, str8>(rc == 1);
    }

    /// @brief Free this shared atomic after all users have stopped.
    pub fn close(self: AtomicI64) -> i32 {
        return __mlang_std_sync_atomic_i64_free(self.handle);
    }
}

impl<T> SpscQueue {
    /// @brief Allocate capacity slots before starting audio processing.
    /// Returns an invalid queue (is_valid() == false) for nonpositive sizes,
    /// overflow, allocation failure, or targets without lock-free indices.
    /// last_error() describes construction failures.
    pub fn new(capacity: i64) -> SpscQueue<T> {
        let h: i64 = __mlang_std_sync_spsc_new(capacity, size_of(T));
        return SpscQueue<T> { handle: h };
    }

    pub fn is_valid(self: SpscQueue<T>) -> bool {
        return self.handle != 0;
    }

    /// @brief Copy an event into the queue. False means full; never waits.
    /// No allocation, deallocation, or mutex operations on this path.
    pub fn try_push(self: SpscQueue<T>, value: T) -> bool {
        return __mlang_std_sync_spsc_push(self.handle, &value) == 1;
    }

    /// @brief Copy the next event into existing storage. False means empty.
    /// Leaves output unchanged when empty. Never allocates, frees, or waits.
    pub fn try_pop_into(self: SpscQueue<T>, value: ptr<T>) -> bool {
        return __mlang_std_sync_spsc_pop(self.handle, value) == 1;
    }

    /// @brief Release storage after producer and consumer have stopped.
    pub fn release(self: SpscQueue<T>) -> void {
        __mlang_std_sync_spsc_free(self.handle);
    }
}


/// @brief Return last std::sync backend error string.
pub fn last_error() -> str8 {
    return __mlang_std_sync_last_error();
}

impl mutex {
    /// @brief Create a new mutex.
    pub fn new() -> result<mutex, str8> {
        let h: i64 = __mlang_std_sync_mutex_new();
        if h == 0 {
            return Err<mutex, str8>(last_error());
        }
        return Ok<mutex, str8>(mutex { raw: h });
    }

    /// @brief Lock mutex.
    pub fn lock(self: mutex) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_mutex_lock(self.raw);
        if rc != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Unlock mutex.
    pub fn unlock(self: mutex) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_mutex_unlock(self.raw);
        if rc != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Free mutex handle.
    pub fn close(self: mutex) -> i32 {
        return __mlang_std_sync_mutex_free(self.raw);
    }
}

impl Condvar {
    /// @brief Create a new condition variable.
    pub fn new() -> result<Condvar, str8> {
        let h: i64 = __mlang_std_sync_condvar_new();
        if h == 0 {
            return Err<Condvar, str8>(last_error());
        }
        return Ok<Condvar, str8>(Condvar { handle: h });
    }

    /// @brief Wait for notification. Caller must hold `mutex`.
    pub fn wait(self: Condvar, mutex: mutex) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_condvar_wait(self.handle, mutex.raw);
        if rc != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Wait with timeout (ms). Returns 0 when notified, 1 when timed out.
    pub fn wait_timeout_ms(self: Condvar, mutex: mutex, timeout_ms: i64) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_condvar_wait_timeout_ms(self.handle, mutex.raw, timeout_ms);
        if rc < 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(rc);
    }

    /// @brief Wake one waiting thread.
    pub fn notify_one(self: Condvar) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_condvar_notify_one(self.handle);
        if rc != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Wake all waiting threads.
    pub fn notify_all(self: Condvar) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_condvar_notify_all(self.handle);
        if rc != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Free condvar handle.
    pub fn close(self: Condvar) -> i32 {
        return __mlang_std_sync_condvar_free(self.handle);
    }
}

impl Channel {
    /// @brief Create string channel with bounded capacity (`<=0` => default).
    pub fn new(capacity: i64) -> result<Channel, str8> {
        let h: i64 = __mlang_std_sync_channel_new(capacity);
        if h == 0 {
            return Err<Channel, str8>(last_error());
        }
        return Ok<Channel, str8>(Channel { handle: h });
    }

    /// @brief Send message to channel (blocks when full).
    pub fn send(self: Channel, s: str8) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_channel_send(self.handle, s);
        if rc != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Post message to another thread.
    /// Alias for `send`.
    pub fn post(self: Channel, s: str8) -> result<i32, str8> {
        return self.send(s);
    }

    /// @brief Receive message into `buf`.
    /// Returns bytes copied. `0` means channel is closed and drained.
    pub fn recv(self: Channel, buf: str8, capacity: i64) -> result<i64, str8> {
        let n: i64 = __mlang_std_sync_channel_recv(self.handle, buf, capacity);
        if n < 0 {
            return Err<i64, str8>(last_error());
        }
        return Ok<i64, str8>(n);
    }

    /// @brief Non-blocking receive into `buf`.
    /// Returns bytes copied (>0), `0` when closed+drained, `-2` when empty.
    pub fn try_recv(self: Channel, buf: str8, capacity: i64) -> result<i64, str8> {
        let n: i64 = __mlang_std_sync_channel_try_recv(self.handle, buf, capacity);
        if n < -1 {
            return Ok<i64, str8>(n);
        }
        if n < 0 {
            return Err<i64, str8>(last_error());
        }
        return Ok<i64, str8>(n);
    }

    /// @brief Close channel. Wakes blocked senders/receivers.
    pub fn close(self: Channel) -> i32 {
        return __mlang_std_sync_channel_close(self.handle);
    }

    /// @brief Free channel handle.
    pub fn free(self: Channel) -> i32 {
        return __mlang_std_sync_channel_free(self.handle);
    }
}

impl LockFreeQueue {
    /// @brief Create lock-free SPSC queue (`capacity<=0` => default).
    pub fn new(capacity: i64) -> result<LockFreeQueue, str8> {
        let h: i64 = __mlang_std_sync_lfqueue_new(capacity);
        if h == 0 {
            return Err<LockFreeQueue, str8>(last_error());
        }
        return Ok<LockFreeQueue, str8>(LockFreeQueue { handle: h });
    }

    /// @brief Non-blocking post to queue.
    /// Returns `0` on success, `1` when full.
    pub fn try_send(self: LockFreeQueue, s: str8) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_lfqueue_send(self.handle, s);
        if rc == 0 || rc == 1 {
            return Ok<i32, str8>(rc);
        }
        return Err<i32, str8>(last_error());
    }

    /// @brief Non-blocking receive into `buf`.
    /// Returns bytes copied (>0), `0` when closed+drained, `-2` when empty.
    pub fn try_recv(self: LockFreeQueue, buf: str8, capacity: i64) -> result<i64, str8> {
        let n: i64 = __mlang_std_sync_lfqueue_try_recv(self.handle, buf, capacity);
        if n >= 0 || n == -2 {
            return Ok<i64, str8>(n);
        }
        return Err<i64, str8>(last_error());
    }

    /// @brief Close queue to new sends.
    pub fn close(self: LockFreeQueue) -> i32 {
        return __mlang_std_sync_lfqueue_close(self.handle);
    }

    /// @brief Free queue handle.
    pub fn free(self: LockFreeQueue) -> i32 {
        return __mlang_std_sync_lfqueue_free(self.handle);
    }
}
