            self.handle, value, atomic_order_value(order));
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    pub fn wait(self: AtomicU32, old_value: u32) -> result<i32, str8> {
