    }

    pub fn fetch_xor(self: AtomicU32, value: u32) -> result<u32, str8> {
        return self.fetch_xor_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn fetch_xor_with_order(self: AtomicU32, value: u32,
                                order: AtomicOrder) -> result<u32, str8> {
        var output: u32 = 0;
        let rc: i32 = __mlang_std_sync_atomic_u32_fetch_xor(
            self.handle, value, atomic_order_value(order), &output);
        if rc != 0 { return Err<u32, str8>(last_error()); }
        return Ok<u32, str8>(output);
    }

    /// @brief Strong CAS; returns `(exchanged, expected_after)`.
    pub fn compare_exchange(self: AtomicU32, expected: u32, desired: u32)
        -> result<tuple<bool, u32>, str8> {
        return self.compare_exchange_with_order(
            expected, desired, AtomicOrder::SeqCst);
    }

    pub fn compare_exchange_with_order(self: AtomicU32, expected: u32,
                                       desired: u32, order: AtomicOrder)
        -> result<tuple<bool, u32>, str8> {
        var expected_value: u32 = expected;
        let rc: i32 = __mlang_std_sync_atomic_u32_compare_exchange(
            self.handle, &expected_value, desired, atomic_order_value(order));
        if rc < 0 {
            return Err<tuple<bool, u32>, str8>(last_error());
        }
        return Ok<tuple<bool, u32>, str8>((rc == 1, expected_value));
    }

    pub fn close(self: AtomicU32) -> i32 {
        return __mlang_std_sync_atomic_u32_free(self.handle);
    }
