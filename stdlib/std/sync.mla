/// \file sync.mla
/// \brief Synchronization primitives for MLang (std::sync).
///
/// Provides:
/// - mutex
/// - Condvar
/// - Channel (string message queue)
/// - LockFreeQueue (string SPSC lock-free queue)
/// - SpscQueue<T> (preallocated, fixed-size event queue)
/// - AtomicI64, AtomicU64, AtomicU32, AtomicU16, AtomicU8, AtomicI32, AtomicI16, AtomicI8, AtomicF32, AtomicF64, AtomicBool, and AtomicFlag


/// \cond INTERNAL_IMPORTS
mod std::sync::detail;
mod std::bits;
use std::sync::detail::*;
use std::bits::bit_cast_u32_from_f32;
use std::bits::bit_cast_u64_from_f64;
use std::bits::bit_cast_f32_from_u32;
use std::bits::bit_cast_f64_from_u64;
/// \endcond

/// @brief mutex handle.
pub struct mutex {
    var raw: i64;
};

/// @brief Condition variable handle.
pub struct Condvar {
    var handle: i64;
};

/// @brief String channel handle.
pub struct Channel {
    var handle: i64;
};

/// @brief Lock-free string queue handle (single-producer/single-consumer).
pub struct LockFreeQueue {
    var handle: i64;
};

/// @brief Lowercase stdlib type alias for `Condvar`.
alias condvar = Condvar;

/// @brief Lowercase stdlib type alias for `Channel`.
alias channel = Channel;

/// @brief Lowercase stdlib type alias for `LockFreeQueue`.
alias lock_free_queue = LockFreeQueue;

/// @brief Preallocated single-producer/single-consumer queue of byte-copied T values.
/// T must contain only self-contained, fixed-size values (numbers, enums,
/// and structs of those). No strings, lists, arrays, pointers, references,
/// managed resources, or types with copy/drop hooks.
/// This requirement is a caller contract, not a compiler-enforced constraint.
/// Exactly one thread may push and exactly one thread may pop. Copies of this
/// handle share storage. Call release exactly once after both threads stop.
pub struct SpscQueue<T> {
    var handle: i64;
};

/// @brief Ordering constraints for atomic operations (C++20 `memory_order`).
pub enum AtomicOrder : i32 {
    Relaxed = 0,
    Consume = 1,
    Acquire = 2,
    Release = 3,
    AcqRel = 4,
    SeqCst = 5
};

/// @brief Shared, sequentially consistent or explicitly ordered atomic i64.
/// Handle copies share the same atomic object. Call close exactly once after
/// all threads have stopped using it.
pub struct AtomicI64 {
    var handle: i64;
};

/// @brief Shared, ordered atomic unsigned 64-bit integer.
/// Arithmetic read-modify-write operations wrap modulo 2^64.
pub struct AtomicU64 {
    var handle: i64;
};

/// @brief Shared native-width atomic unsigned 32-bit integer.
/// Arithmetic read-modify-write operations wrap modulo 2^32.
pub struct AtomicU32 {
    var handle: i64;
};

/// @brief Shared atomic unsigned 16-bit integer.
/// Arithmetic read-modify-write operations wrap modulo 2^16.
pub struct AtomicU16 {
    var handle: i64;
};

/// @brief Shared atomic unsigned 8-bit integer.
/// Arithmetic read-modify-write operations wrap modulo 2^8.
pub struct AtomicU8 {
    var handle: i64;
};

/// @brief Shared C++20-style atomic f32 value.
/// Floating fetch operations use a compare/exchange loop over the value bits.
pub struct AtomicF32 {
    var handle: i64;
};

/// @brief Shared C++20-style atomic f64 value.
/// Floating fetch operations use a compare/exchange loop over the value bits.
pub struct AtomicF64 {
    var handle: i64;
};

/// @brief Shared atomic signed 8-bit integer.
/// Signed read-modify-write operations wrap using the 8-bit representation.
pub struct AtomicI8 {
    var handle: i64;
};

/// @brief Shared atomic signed 16-bit integer.
/// Signed read-modify-write operations wrap using the 16-bit representation.
pub struct AtomicI16 {
    var handle: i64;
};

/// @brief Shared native-width atomic signed 32-bit integer.
/// Signed read-modify-write arithmetic wraps using the 32-bit representation.
pub struct AtomicI32 {
    var handle: i64;
};

/// @brief Shared C++20-style atomic boolean value.
/// Handle copies share the value; call close exactly once after all users stop.
pub struct AtomicBool {
    var handle: i64;
};

/// @brief Dynamically owned C++20-style atomic flag.
/// Its native `atomic_flag` representation is guaranteed lock-free.
pub struct AtomicFlag {
    var handle: i64;
};

/// @brief One-shot countdown latch for synchronizing a known number of arrivals.
/// Copies share the native latch. Close only after every arrival and waiter
/// has finished using it.
pub struct Latch {
    var handle: i64;
};

/// @brief Reusable fixed-participant phase barrier. Handle copies share phases.
/// Close only after all participants and waiters have stopped using it.
pub struct Barrier {
    var handle: i64;
};

/// @brief Bounded counting semaphore for coordinating permit ownership.
/// Copies share the native semaphore; close it after all users stop.
pub struct CountingSemaphore {
    var handle: i64;
};

fn atomic_order_value(order: AtomicOrder) -> i32 {
    if order == AtomicOrder::Relaxed { return 0; }
    if order == AtomicOrder::Consume { return 1; }
    if order == AtomicOrder::Acquire { return 2; }
    if order == AtomicOrder::Release { return 3; }
    if order == AtomicOrder::AcqRel { return 4; }
    return 5;
}

impl AtomicI64 {
    /// @brief Create an atomic i64, or return the backend error.
    pub fn new(initial: i64) -> result<AtomicI64, str8> {
        let handle: i64 = __mlang_std_sync_atomic_i64_new(initial);
        if handle == 0 {
            return Err<AtomicI64, str8>(last_error());
        }
        return Ok<AtomicI64, str8>(AtomicI64 { handle: handle });
    }

    pub fn is_valid(self: AtomicI64) -> bool {
        return self.handle != 0;
    }

    /// @brief Load with sequentially consistent ordering.
    pub fn load(self: AtomicI64) -> result<i64, str8> {
        return self.load_with_order(AtomicOrder::SeqCst);
    }

    pub fn load_with_order(self: AtomicI64, order: AtomicOrder) -> result<i64, str8> {
        var output: i64 = 0;
        let rc: i32 = __mlang_std_sync_atomic_i64_load(self.handle, atomic_order_value(order), &output);
        if rc != 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(output);
    }

    /// @brief Store with sequentially consistent ordering.
    pub fn store(self: AtomicI64, value: i64) -> result<i32, str8> {
        return self.store_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn store_with_order(self: AtomicI64, value: i64, order: AtomicOrder) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_atomic_i64_store(self.handle, value, atomic_order_value(order));
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    /// @brief Block while the value equals `old_value`, then recheck it.
    /// Notification alone does not satisfy the wait; the atomic value must
    /// change, and callers should always re-evaluate their own condition.
    pub fn wait(self: AtomicI64, old_value: i64) -> result<i32, str8> {
        return self.wait_with_order(old_value, AtomicOrder::SeqCst);
    }

    pub fn wait_with_order(self: AtomicI64, old_value: i64,
                           order: AtomicOrder) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_atomic_i64_wait(
            self.handle, old_value, atomic_order_value(order));
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    /// @brief Wake one thread waiting on this atomic.
    pub fn notify_one(self: AtomicI64) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_atomic_i64_notify_one(self.handle);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    /// @brief Wake all threads waiting on this atomic.
    pub fn notify_all(self: AtomicI64) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_atomic_i64_notify_all(self.handle);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    /// @brief Replace the value; return the old value (seq_cst).
    pub fn exchange(self: AtomicI64, value: i64) -> result<i64, str8> {
        return self.exchange_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn exchange_with_order(self: AtomicI64, value: i64, order: AtomicOrder) -> result<i64, str8> {
        var output: i64 = 0;
        let rc: i32 = __mlang_std_sync_atomic_i64_exchange(self.handle, value, atomic_order_value(order), &output);
        if rc != 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(output);
    }

    /// @brief Atomically add and return the previous value (seq_cst).
    pub fn fetch_add(self: AtomicI64, value: i64) -> result<i64, str8> {
        return self.fetch_add_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn fetch_add_with_order(self: AtomicI64, value: i64, order: AtomicOrder) -> result<i64, str8> {
        var output: i64 = 0;
        let rc: i32 = __mlang_std_sync_atomic_i64_fetch_add(self.handle, value, atomic_order_value(order), &output);
        if rc != 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(output);
    }

    pub fn fetch_sub(self: AtomicI64, value: i64) -> result<i64, str8> {
        return self.fetch_sub_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn fetch_sub_with_order(self: AtomicI64, value: i64, order: AtomicOrder) -> result<i64, str8> {
        var output: i64 = 0;
        let rc: i32 = __mlang_std_sync_atomic_i64_fetch_sub(self.handle, value, atomic_order_value(order), &output);
        if rc != 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(output);
    }

    pub fn fetch_and(self: AtomicI64, value: i64) -> result<i64, str8> {
        return self.fetch_and_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn fetch_and_with_order(self: AtomicI64, value: i64, order: AtomicOrder) -> result<i64, str8> {
        var output: i64 = 0;
        let rc: i32 = __mlang_std_sync_atomic_i64_fetch_and(self.handle, value, atomic_order_value(order), &output);
        if rc != 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(output);
    }

    pub fn fetch_or(self: AtomicI64, value: i64) -> result<i64, str8> {
        return self.fetch_or_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn fetch_or_with_order(self: AtomicI64, value: i64, order: AtomicOrder) -> result<i64, str8> {
        var output: i64 = 0;
        let rc: i32 = __mlang_std_sync_atomic_i64_fetch_or(self.handle, value, atomic_order_value(order), &output);
        if rc != 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(output);
    }

    pub fn fetch_xor(self: AtomicI64, value: i64) -> result<i64, str8> {
        return self.fetch_xor_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn fetch_xor_with_order(self: AtomicI64, value: i64, order: AtomicOrder) -> result<i64, str8> {
        var output: i64 = 0;
        let rc: i32 = __mlang_std_sync_atomic_i64_fetch_xor(self.handle, value, atomic_order_value(order), &output);
        if rc != 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(output);
    }

    /// @brief Strong compare/exchange. On failure, `expected` is updated with
    /// the observed value. Failure ordering is derived from `order` as in the
    /// single-order C++ overload.
    pub fn compare_exchange(self: AtomicI64, expected: ptr<i64>, desired: i64,
                            order: AtomicOrder) -> result<bool, str8> {
        let rc: i32 = __mlang_std_sync_atomic_i64_compare_exchange(self.handle, expected, desired, atomic_order_value(order));
        if rc < 0 { return Err<bool, str8>(last_error()); }
        return Ok<bool, str8>(rc == 1);
    }

    /// @brief Free this shared atomic after all users have stopped.
    pub fn close(self: AtomicI64) -> i32 {
        return __mlang_std_sync_atomic_i64_free(self.handle);
    }
}

impl AtomicU64 {
    /// @brief Create an atomic u64, or return the backend error.
    pub fn new(initial: u64) -> result<AtomicU64, str8> {
        let handle: i64 = __mlang_std_sync_atomic_i64_new(i64(initial));
        if handle == 0 { return Err<AtomicU64, str8>(last_error()); }
        return Ok<AtomicU64, str8>(AtomicU64 { handle: handle });
    }

    pub fn is_valid(self: AtomicU64) -> bool {
        return self.handle != 0;
    }

    pub fn load(self: AtomicU64) -> result<u64, str8> {
        return self.load_with_order(AtomicOrder::SeqCst);
    }

    pub fn load_with_order(self: AtomicU64, order: AtomicOrder)
        -> result<u64, str8> {
        var output: i64 = 0;
        let rc: i32 = __mlang_std_sync_atomic_i64_load(
            self.handle, atomic_order_value(order), &output);
        if rc != 0 { return Err<u64, str8>(last_error()); }
        return Ok<u64, str8>(u64(output));
    }

    pub fn store(self: AtomicU64, value: u64) -> result<i32, str8> {
        return self.store_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn store_with_order(self: AtomicU64, value: u64, order: AtomicOrder)
        -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_atomic_i64_store(
            self.handle, i64(value), atomic_order_value(order));
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    pub fn wait(self: AtomicU64, old_value: u64) -> result<i32, str8> {
        return self.wait_with_order(old_value, AtomicOrder::SeqCst);
    }

    pub fn wait_with_order(self: AtomicU64, old_value: u64,
                           order: AtomicOrder) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_atomic_i64_wait(
            self.handle, i64(old_value), atomic_order_value(order));
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    pub fn notify_one(self: AtomicU64) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_atomic_i64_notify_one(self.handle);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    pub fn notify_all(self: AtomicU64) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_atomic_i64_notify_all(self.handle);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    pub fn exchange(self: AtomicU64, value: u64) -> result<u64, str8> {
        return self.exchange_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn exchange_with_order(self: AtomicU64, value: u64,
                               order: AtomicOrder) -> result<u64, str8> {
        var output: i64 = 0;
        let rc: i32 = __mlang_std_sync_atomic_i64_exchange(
            self.handle, i64(value), atomic_order_value(order), &output);
        if rc != 0 { return Err<u64, str8>(last_error()); }
        return Ok<u64, str8>(u64(output));
    }

    pub fn fetch_add(self: AtomicU64, value: u64) -> result<u64, str8> {
        return self.fetch_add_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn fetch_add_with_order(self: AtomicU64, value: u64,
                                order: AtomicOrder) -> result<u64, str8> {
        var output: i64 = 0;
        let rc: i32 = __mlang_std_sync_atomic_i64_fetch_add(
            self.handle, i64(value), atomic_order_value(order), &output);
        if rc != 0 { return Err<u64, str8>(last_error()); }
        return Ok<u64, str8>(u64(output));
    }

    pub fn fetch_sub(self: AtomicU64, value: u64) -> result<u64, str8> {
        return self.fetch_sub_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn fetch_sub_with_order(self: AtomicU64, value: u64,
                                order: AtomicOrder) -> result<u64, str8> {
        var output: i64 = 0;
        let rc: i32 = __mlang_std_sync_atomic_i64_fetch_sub(
            self.handle, i64(value), atomic_order_value(order), &output);
        if rc != 0 { return Err<u64, str8>(last_error()); }
        return Ok<u64, str8>(u64(output));
    }

    pub fn fetch_and(self: AtomicU64, value: u64) -> result<u64, str8> {
        return self.fetch_and_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn fetch_and_with_order(self: AtomicU64, value: u64,
                                order: AtomicOrder) -> result<u64, str8> {
        var output: i64 = 0;
        let rc: i32 = __mlang_std_sync_atomic_i64_fetch_and(
            self.handle, i64(value), atomic_order_value(order), &output);
        if rc != 0 { return Err<u64, str8>(last_error()); }
        return Ok<u64, str8>(u64(output));
    }

    pub fn fetch_or(self: AtomicU64, value: u64) -> result<u64, str8> {
        return self.fetch_or_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn fetch_or_with_order(self: AtomicU64, value: u64,
                               order: AtomicOrder) -> result<u64, str8> {
        var output: i64 = 0;
        let rc: i32 = __mlang_std_sync_atomic_i64_fetch_or(
            self.handle, i64(value), atomic_order_value(order), &output);
        if rc != 0 { return Err<u64, str8>(last_error()); }
        return Ok<u64, str8>(u64(output));
    }

    pub fn fetch_xor(self: AtomicU64, value: u64) -> result<u64, str8> {
        return self.fetch_xor_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn fetch_xor_with_order(self: AtomicU64, value: u64,
                                order: AtomicOrder) -> result<u64, str8> {
        var output: i64 = 0;
        let rc: i32 = __mlang_std_sync_atomic_i64_fetch_xor(
            self.handle, i64(value), atomic_order_value(order), &output);
        if rc != 0 { return Err<u64, str8>(last_error()); }
        return Ok<u64, str8>(u64(output));
    }

    /// @brief Strong CAS; returns `(exchanged, expected_after)`.
    pub fn compare_exchange(self: AtomicU64, expected: u64, desired: u64)
        -> result<tuple<bool, u64>, str8> {
        return self.compare_exchange_with_order(
            expected, desired, AtomicOrder::SeqCst);
    }

    pub fn compare_exchange_with_order(self: AtomicU64, expected: u64,
                                       desired: u64, order: AtomicOrder)
        -> result<tuple<bool, u64>, str8> {
        var expected_value: i64 = i64(expected);
        let rc: i32 = __mlang_std_sync_atomic_i64_compare_exchange(
            self.handle, &expected_value, i64(desired),
            atomic_order_value(order));
        if rc < 0 {
            return Err<tuple<bool, u64>, str8>(last_error());
        }
        return Ok<tuple<bool, u64>, str8>((rc == 1, u64(expected_value)));
    }

    pub fn close(self: AtomicU64) -> i32 {
        return __mlang_std_sync_atomic_i64_free(self.handle);
    }
}

impl AtomicF64 {
    pub fn new(initial: f64) -> result<AtomicF64, str8> {
        let storage: result<AtomicU64, str8> =
            AtomicU64::new(bit_cast_u64_from_f64(initial));
        if storage.is_err() { return Err<AtomicF64, str8>(storage.unwrap_err()); }
        let created: AtomicU64 = storage.unwrap();
        return Ok<AtomicF64, str8>(AtomicF64 { handle: created.handle });
    }

    pub fn is_valid(self: AtomicF64) -> bool { return self.handle != 0; }

    pub fn load(self: AtomicF64) -> result<f64, str8> {
        return self.load_with_order(AtomicOrder::SeqCst);
    }

    pub fn load_with_order(self: AtomicF64, order: AtomicOrder)
        -> result<f64, str8> {
        let storage: AtomicU64 = AtomicU64 { handle: self.handle };
        let loaded: result<u64, str8> = storage.load_with_order(order);
        if loaded.is_err() { return Err<f64, str8>(loaded.unwrap_err()); }
        return Ok<f64, str8>(bit_cast_f64_from_u64(loaded.unwrap()));
    }

    pub fn store(self: AtomicF64, value: f64) -> result<i32, str8> {
        return self.store_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn store_with_order(self: AtomicF64, value: f64, order: AtomicOrder)
        -> result<i32, str8> {
        let storage: AtomicU64 = AtomicU64 { handle: self.handle };
        return storage.store_with_order(bit_cast_u64_from_f64(value), order);
    }

    pub fn exchange(self: AtomicF64, value: f64) -> result<f64, str8> {
        return self.exchange_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn exchange_with_order(self: AtomicF64, value: f64,
                               order: AtomicOrder) -> result<f64, str8> {
        let storage: AtomicU64 = AtomicU64 { handle: self.handle };
        let exchanged: result<u64, str8> = storage.exchange_with_order(
            bit_cast_u64_from_f64(value), order);
        if exchanged.is_err() { return Err<f64, str8>(exchanged.unwrap_err()); }
        return Ok<f64, str8>(bit_cast_f64_from_u64(exchanged.unwrap()));
    }

    pub fn fetch_add(self: AtomicF64, value: f64) -> result<f64, str8> {
        return self.fetch_add_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn fetch_add_with_order(self: AtomicF64, value: f64,
                                order: AtomicOrder) -> result<f64, str8> {
        let storage: AtomicU64 = AtomicU64 { handle: self.handle };
        let loaded: result<u64, str8> = storage.load_with_order(AtomicOrder::Relaxed);
        if loaded.is_err() { return Err<f64, str8>(loaded.unwrap_err()); }
        var expected: u64 = loaded.unwrap();
        while true {
            let previous: f64 = bit_cast_f64_from_u64(expected);
            let desired: u64 = bit_cast_u64_from_f64(previous + value);
            let exchanged: result<tuple<bool, u64>, str8> =
                storage.compare_exchange_with_order(expected, desired, order);
            if exchanged.is_err() { return Err<f64, str8>(exchanged.unwrap_err()); }
            let outcome: tuple<bool, u64> = exchanged.unwrap();
            if outcome.0 { return Ok<f64, str8>(previous); }
            expected = outcome.1;
        }
        return Err<f64, str8>("unreachable atomic f64 add");
    }

    pub fn fetch_sub(self: AtomicF64, value: f64) -> result<f64, str8> {
        return self.fetch_sub_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn fetch_sub_with_order(self: AtomicF64, value: f64,
                                order: AtomicOrder) -> result<f64, str8> {
        let storage: AtomicU64 = AtomicU64 { handle: self.handle };
        let loaded: result<u64, str8> = storage.load_with_order(AtomicOrder::Relaxed);
        if loaded.is_err() { return Err<f64, str8>(loaded.unwrap_err()); }
        var expected: u64 = loaded.unwrap();
        while true {
            let previous: f64 = bit_cast_f64_from_u64(expected);
            let desired: u64 = bit_cast_u64_from_f64(previous - value);
            let exchanged: result<tuple<bool, u64>, str8> =
                storage.compare_exchange_with_order(expected, desired, order);
            if exchanged.is_err() { return Err<f64, str8>(exchanged.unwrap_err()); }
            let outcome: tuple<bool, u64> = exchanged.unwrap();
            if outcome.0 { return Ok<f64, str8>(previous); }
            expected = outcome.1;
        }
        return Err<f64, str8>("unreachable atomic f64 sub");
    }

    pub fn compare_exchange(self: AtomicF64, expected: f64, desired: f64)
        -> result<tuple<bool, f64>, str8> {
        return self.compare_exchange_with_order(
            expected, desired, AtomicOrder::SeqCst);
    }

    pub fn compare_exchange_with_order(self: AtomicF64, expected: f64,
                                       desired: f64, order: AtomicOrder)
        -> result<tuple<bool, f64>, str8> {
        let storage: AtomicU64 = AtomicU64 { handle: self.handle };
        let exchanged: result<tuple<bool, u64>, str8> =
            storage.compare_exchange_with_order(
                bit_cast_u64_from_f64(expected),
                bit_cast_u64_from_f64(desired), order);
        if exchanged.is_err() {
            return Err<tuple<bool, f64>, str8>(exchanged.unwrap_err());
        }
        let outcome: tuple<bool, u64> = exchanged.unwrap();
        return Ok<tuple<bool, f64>, str8>(
            (outcome.0, bit_cast_f64_from_u64(outcome.1)));
    }

    pub fn wait(self: AtomicF64, old_value: f64) -> result<i32, str8> {
        return self.wait_with_order(old_value, AtomicOrder::SeqCst);
    }

    pub fn wait_with_order(self: AtomicF64, old_value: f64,
                           order: AtomicOrder) -> result<i32, str8> {
        let storage: AtomicU64 = AtomicU64 { handle: self.handle };
        return storage.wait_with_order(bit_cast_u64_from_f64(old_value), order);
    }

    pub fn notify_one(self: AtomicF64) -> result<i32, str8> {
        let storage: AtomicU64 = AtomicU64 { handle: self.handle };
        return storage.notify_one();
    }

    pub fn notify_all(self: AtomicF64) -> result<i32, str8> {
        let storage: AtomicU64 = AtomicU64 { handle: self.handle };
        return storage.notify_all();
    }

    pub fn close(self: AtomicF64) -> i32 {
        let storage: AtomicU64 = AtomicU64 { handle: self.handle };
        return storage.close();
    }
}

impl AtomicF32 {
    pub fn new(initial: f32) -> result<AtomicF32, str8> {
        let storage: result<AtomicU32, str8> =
            AtomicU32::new(bit_cast_u32_from_f32(initial));
        if storage.is_err() { return Err<AtomicF32, str8>(storage.unwrap_err()); }
        let created: AtomicU32 = storage.unwrap();
        return Ok<AtomicF32, str8>(AtomicF32 { handle: created.handle });
    }

    pub fn is_valid(self: AtomicF32) -> bool { return self.handle != 0; }

    pub fn load(self: AtomicF32) -> result<f32, str8> {
        return self.load_with_order(AtomicOrder::SeqCst);
    }

    pub fn load_with_order(self: AtomicF32, order: AtomicOrder)
        -> result<f32, str8> {
        let storage: AtomicU32 = AtomicU32 { handle: self.handle };
        let loaded: result<u32, str8> = storage.load_with_order(order);
        if loaded.is_err() { return Err<f32, str8>(loaded.unwrap_err()); }
        return Ok<f32, str8>(bit_cast_f32_from_u32(loaded.unwrap()));
    }

    pub fn store(self: AtomicF32, value: f32) -> result<i32, str8> {
        return self.store_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn store_with_order(self: AtomicF32, value: f32, order: AtomicOrder)
        -> result<i32, str8> {
        let storage: AtomicU32 = AtomicU32 { handle: self.handle };
        return storage.store_with_order(bit_cast_u32_from_f32(value), order);
    }

    pub fn exchange(self: AtomicF32, value: f32) -> result<f32, str8> {
        return self.exchange_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn exchange_with_order(self: AtomicF32, value: f32,
                               order: AtomicOrder) -> result<f32, str8> {
        let storage: AtomicU32 = AtomicU32 { handle: self.handle };
        let exchanged: result<u32, str8> = storage.exchange_with_order(
            bit_cast_u32_from_f32(value), order);
        if exchanged.is_err() { return Err<f32, str8>(exchanged.unwrap_err()); }
        return Ok<f32, str8>(bit_cast_f32_from_u32(exchanged.unwrap()));
    }

    pub fn fetch_add(self: AtomicF32, value: f32) -> result<f32, str8> {
        return self.fetch_add_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn fetch_add_with_order(self: AtomicF32, value: f32,
                                order: AtomicOrder) -> result<f32, str8> {
        let storage: AtomicU32 = AtomicU32 { handle: self.handle };
        let loaded: result<u32, str8> = storage.load_with_order(AtomicOrder::Relaxed);
        if loaded.is_err() { return Err<f32, str8>(loaded.unwrap_err()); }
        var expected: u32 = loaded.unwrap();
        while true {
            let previous: f32 = bit_cast_f32_from_u32(expected);
            let desired: u32 = bit_cast_u32_from_f32(previous + value);
            let exchanged: result<tuple<bool, u32>, str8> =
                storage.compare_exchange_with_order(expected, desired, order);
            if exchanged.is_err() { return Err<f32, str8>(exchanged.unwrap_err()); }
            let outcome: tuple<bool, u32> = exchanged.unwrap();
            if outcome.0 { return Ok<f32, str8>(previous); }
            expected = outcome.1;
        }
        return Err<f32, str8>("unreachable atomic f32 add");
    }

    pub fn fetch_sub(self: AtomicF32, value: f32) -> result<f32, str8> {
        return self.fetch_sub_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn fetch_sub_with_order(self: AtomicF32, value: f32,
                                order: AtomicOrder) -> result<f32, str8> {
        let storage: AtomicU32 = AtomicU32 { handle: self.handle };
        let loaded: result<u32, str8> = storage.load_with_order(AtomicOrder::Relaxed);
        if loaded.is_err() { return Err<f32, str8>(loaded.unwrap_err()); }
        var expected: u32 = loaded.unwrap();
        while true {
            let previous: f32 = bit_cast_f32_from_u32(expected);
            let desired: u32 = bit_cast_u32_from_f32(previous - value);
            let exchanged: result<tuple<bool, u32>, str8> =
                storage.compare_exchange_with_order(expected, desired, order);
            if exchanged.is_err() { return Err<f32, str8>(exchanged.unwrap_err()); }
            let outcome: tuple<bool, u32> = exchanged.unwrap();
            if outcome.0 { return Ok<f32, str8>(previous); }
            expected = outcome.1;
        }
        return Err<f32, str8>("unreachable atomic f32 sub");
    }

    pub fn compare_exchange(self: AtomicF32, expected: f32, desired: f32)
        -> result<tuple<bool, f32>, str8> {
        return self.compare_exchange_with_order(
            expected, desired, AtomicOrder::SeqCst);
    }

    pub fn compare_exchange_with_order(self: AtomicF32, expected: f32,
                                       desired: f32, order: AtomicOrder)
        -> result<tuple<bool, f32>, str8> {
        let storage: AtomicU32 = AtomicU32 { handle: self.handle };
        let exchanged: result<tuple<bool, u32>, str8> =
            storage.compare_exchange_with_order(
                bit_cast_u32_from_f32(expected),
                bit_cast_u32_from_f32(desired), order);
        if exchanged.is_err() {
            return Err<tuple<bool, f32>, str8>(exchanged.unwrap_err());
        }
        let outcome: tuple<bool, u32> = exchanged.unwrap();
        return Ok<tuple<bool, f32>, str8>(
            (outcome.0, bit_cast_f32_from_u32(outcome.1)));
    }

    pub fn wait(self: AtomicF32, old_value: f32) -> result<i32, str8> {
        return self.wait_with_order(old_value, AtomicOrder::SeqCst);
    }

    pub fn wait_with_order(self: AtomicF32, old_value: f32,
                           order: AtomicOrder) -> result<i32, str8> {
        let storage: AtomicU32 = AtomicU32 { handle: self.handle };
        return storage.wait_with_order(bit_cast_u32_from_f32(old_value), order);
    }

    pub fn notify_one(self: AtomicF32) -> result<i32, str8> {
        let storage: AtomicU32 = AtomicU32 { handle: self.handle };
        return storage.notify_one();
    }

    pub fn notify_all(self: AtomicF32) -> result<i32, str8> {
        let storage: AtomicU32 = AtomicU32 { handle: self.handle };
        return storage.notify_all();
    }

    pub fn close(self: AtomicF32) -> i32 {
        let storage: AtomicU32 = AtomicU32 { handle: self.handle };
        return storage.close();
    }
}

impl AtomicU32 {
    /// @brief Create an atomic u32, or return the backend error.
    pub fn new(initial: u32) -> result<AtomicU32, str8> {
        let handle: i64 = __mlang_std_sync_atomic_u32_new(initial);
        if handle == 0 { return Err<AtomicU32, str8>(last_error()); }
        return Ok<AtomicU32, str8>(AtomicU32 { handle: handle });
    }

    pub fn is_valid(self: AtomicU32) -> bool {
        return self.handle != 0;
    }

    pub fn load(self: AtomicU32) -> result<u32, str8> {
        return self.load_with_order(AtomicOrder::SeqCst);
    }

    pub fn load_with_order(self: AtomicU32, order: AtomicOrder)
        -> result<u32, str8> {
        var output: u32 = 0;
        let rc: i32 = __mlang_std_sync_atomic_u32_load(
            self.handle, atomic_order_value(order), &output);
        if rc != 0 { return Err<u32, str8>(last_error()); }
        return Ok<u32, str8>(output);
    }

    pub fn store(self: AtomicU32, value: u32) -> result<i32, str8> {
        return self.store_with_order(value, AtomicOrder::SeqCst);
