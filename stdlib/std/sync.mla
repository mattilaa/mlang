                                       desired: i32, order: AtomicOrder)
        -> result<tuple<bool, i32>, str8> {
        let storage: AtomicU32 = AtomicU32 { handle: self.handle };
        let exchanged: result<tuple<bool, u32>, str8> =
            storage.compare_exchange_with_order(u32(expected), u32(desired), order);
        if exchanged.is_err() {
            return Err<tuple<bool, i32>, str8>(exchanged.unwrap_err());
        }
        let outcome: tuple<bool, u32> = exchanged.unwrap();
        return Ok<tuple<bool, i32>, str8>((outcome.0, i32(outcome.1)));
    }

    pub fn close(self: AtomicI32) -> i32 {
        let storage: AtomicU32 = AtomicU32 { handle: self.handle };
        return storage.close();
    }
}

impl AtomicBool {
    /// @brief Create an atomic boolean, or return the backend error.
    pub fn new(initial: bool) -> result<AtomicBool, str8> {
        let initial_value: i64 = initial ? 1 : 0;
        let handle: i64 = __mlang_std_sync_atomic_i64_new(initial_value);
        if handle == 0 { return Err<AtomicBool, str8>(last_error()); }
        return Ok<AtomicBool, str8>(AtomicBool { handle: handle });
    }

    pub fn is_valid(self: AtomicBool) -> bool {
        return self.handle != 0;
    }

    /// @brief Load with sequentially consistent ordering.
    pub fn load(self: AtomicBool) -> result<bool, str8> {
        return self.load_with_order(AtomicOrder::SeqCst);
    }

    pub fn load_with_order(self: AtomicBool, order: AtomicOrder)
        -> result<bool, str8> {
        var output: i64 = 0;
        let rc: i32 = __mlang_std_sync_atomic_i64_load(
            self.handle, atomic_order_value(order), &output);
        if rc != 0 { return Err<bool, str8>(last_error()); }
        return Ok<bool, str8>(output != 0);
    }

    /// @brief Store with sequentially consistent ordering.
    pub fn store(self: AtomicBool, value: bool) -> result<i32, str8> {
        return self.store_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn store_with_order(self: AtomicBool, value: bool, order: AtomicOrder)
        -> result<i32, str8> {
        let raw_value: i64 = value ? 1 : 0;
        let rc: i32 = __mlang_std_sync_atomic_i64_store(
            self.handle, raw_value, atomic_order_value(order));
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    /// @brief Replace the value and return its previous boolean state.
    pub fn exchange(self: AtomicBool, value: bool) -> result<bool, str8> {
        return self.exchange_with_order(value, AtomicOrder::SeqCst);
    }

    pub fn exchange_with_order(self: AtomicBool, value: bool,
                               order: AtomicOrder) -> result<bool, str8> {
        var output: i64 = 0;
        let raw_value: i64 = value ? 1 : 0;
        let rc: i32 = __mlang_std_sync_atomic_i64_exchange(
            self.handle, raw_value, atomic_order_value(order), &output);
        if rc != 0 { return Err<bool, str8>(last_error()); }
        return Ok<bool, str8>(output != 0);
    }

    /// @brief Strong compare/exchange with sequentially consistent ordering.
    /// Returns `(exchanged, expected_after)`, where a failed operation updates
    /// `expected_after` to the observed value as C++ compare-exchange does.
    pub fn compare_exchange(self: AtomicBool, expected: bool, desired: bool)
        -> result<tuple<bool, bool>, str8> {
        return self.compare_exchange_with_order(
            expected, desired, AtomicOrder::SeqCst);
    }

    pub fn compare_exchange_with_order(self: AtomicBool, expected: bool,
                                      desired: bool, order: AtomicOrder)
        -> result<tuple<bool, bool>, str8> {
        var expected_value: i64 = expected ? 1 : 0;
        let desired_value: i64 = desired ? 1 : 0;
        let rc: i32 = __mlang_std_sync_atomic_i64_compare_exchange(
            self.handle, &expected_value, desired_value,
            atomic_order_value(order));
        if rc < 0 {
            return Err<tuple<bool, bool>, str8>(last_error());
        }
        return Ok<tuple<bool, bool>, str8>((rc == 1, expected_value != 0));
    }

    /// @brief Block while the value equals `old_value`, then recheck it.
    pub fn wait(self: AtomicBool, old_value: bool) -> result<i32, str8> {
        return self.wait_with_order(old_value, AtomicOrder::SeqCst);
    }

    pub fn wait_with_order(self: AtomicBool, old_value: bool,
                           order: AtomicOrder) -> result<i32, str8> {
        let raw_value: i64 = old_value ? 1 : 0;
        let rc: i32 = __mlang_std_sync_atomic_i64_wait(
            self.handle, raw_value, atomic_order_value(order));
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    pub fn notify_one(self: AtomicBool) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_atomic_i64_notify_one(self.handle);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    pub fn notify_all(self: AtomicBool) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_atomic_i64_notify_all(self.handle);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    /// @brief Free after all threads have stopped using this atomic.
    pub fn close(self: AtomicBool) -> i32 {
        return __mlang_std_sync_atomic_i64_free(self.handle);
    }
}

impl AtomicFlag {
    /// @brief Create a clear atomic flag.
    pub fn new() -> result<AtomicFlag, str8> {
        let handle: i64 = __mlang_std_sync_atomic_flag_new();
        if handle == 0 { return Err<AtomicFlag, str8>(last_error()); }
        return Ok<AtomicFlag, str8>(AtomicFlag { handle: handle });
    }

    /// @brief Atomically set the flag and return its previous state.
    pub fn test_and_set(self: AtomicFlag) -> result<bool, str8> {
        return self.test_and_set_with_order(AtomicOrder::SeqCst);
    }

    pub fn test_and_set_with_order(self: AtomicFlag, order: AtomicOrder)
        -> result<bool, str8> {
        let previous: i32 = __mlang_std_sync_atomic_flag_test_and_set(
            self.handle, atomic_order_value(order));
        if previous < 0 { return Err<bool, str8>(last_error()); }
        return Ok<bool, str8>(previous == 1);
    }

    /// @brief Clear the flag with sequentially consistent ordering.
    pub fn clear(self: AtomicFlag) -> result<i32, str8> {
        return self.clear_with_order(AtomicOrder::SeqCst);
    }

    pub fn clear_with_order(self: AtomicFlag, order: AtomicOrder)
        -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_atomic_flag_clear(
            self.handle, atomic_order_value(order));
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    /// @brief Release the native flag after all users have stopped accessing it.
    pub fn close(self: AtomicFlag) -> i32 {
        return __mlang_std_sync_atomic_flag_free(self.handle);
    }
}

impl Latch {
    /// @brief Create a latch. `expected` must be non-negative; zero is ready.
    pub fn new(expected: i64) -> result<Latch, str8> {
        let handle: i64 = __mlang_std_sync_latch_new(expected);
        if handle == 0 { return Err<Latch, str8>(last_error()); }
        return Ok<Latch, str8>(Latch { handle: handle });
    }

    pub fn is_valid(self: Latch) -> bool {
        return self.handle != 0;
    }

    /// @brief Record one arrival.
    pub fn count_down(self: Latch) -> result<i32, str8> {
        return self.count_down_by(1);
    }

    /// @brief Record `update` arrivals; errors if update is nonpositive or
    /// exceeds the remaining count. Reaching zero wakes all waiters.
    pub fn count_down_by(self: Latch, update: i64) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_latch_count_down(self.handle, update);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    /// @brief Return true when the latch has reached zero without blocking.
    pub fn try_wait(self: Latch) -> result<bool, str8> {
        let rc: i32 = __mlang_std_sync_latch_try_wait(self.handle);
        if rc < 0 { return Err<bool, str8>(last_error()); }
        return Ok<bool, str8>(rc == 1);
    }

    /// @brief Block until the latch reaches zero.
    pub fn wait(self: Latch) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_latch_wait(self.handle);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    /// @brief Record this thread's arrival and then wait for all arrivals.
    pub fn arrive_and_wait(self: Latch) -> result<i32, str8> {
        let arrived: result<i32, str8> = self.count_down();
        if arrived.is_err() { return Err<i32, str8>(arrived.unwrap_err()); }
        return self.wait();
    }

    /// @brief Destroy the latch after all threads have stopped using it.
    pub fn close(self: Latch) -> i32 {
        return __mlang_std_sync_latch_free(self.handle);
    }
}

impl Barrier {
    /// @brief Create a reusable barrier with a positive participant count.
    pub fn new(expected: i64) -> result<Barrier, str8> {
        let handle: i64 = __mlang_std_sync_barrier_new(expected);
        if handle == 0 { return Err<Barrier, str8>(last_error()); }
        return Ok<Barrier, str8>(Barrier { handle: handle });
    }

    pub fn is_valid(self: Barrier) -> bool {
        return self.handle != 0;
    }

    /// @brief Arrive for this phase and receive its phase token.
    /// The final arrival advances the phase and wakes its waiters.
    pub fn arrive(self: Barrier) -> result<i64, str8> {
        return self.arrive_by(1);
    }

    /// @brief Arrive for `update` participants and return the phase token.
    pub fn arrive_by(self: Barrier, update: i64) -> result<i64, str8> {
        let phase: i64 = __mlang_std_sync_barrier_arrive(self.handle, update);
        if phase < 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(phase);
    }

    /// @brief Block until the phase represented by `phase` has completed.
    pub fn wait(self: Barrier, phase: i64) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_barrier_wait(self.handle, phase);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    /// @brief Arrive at the current phase and wait for all participants.
    pub fn arrive_and_wait(self: Barrier) -> result<i32, str8> {
        let phase: i64 = __mlang_std_sync_barrier_arrive(self.handle, 1);
        if phase < 0 { return Err<i32, str8>(last_error()); }
        let rc: i32 = __mlang_std_sync_barrier_wait(self.handle, phase);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    /// @brief Arrive and permanently reduce the expected participants by one.
    pub fn arrive_and_drop(self: Barrier) -> result<i64, str8> {
        let phase: i64 = __mlang_std_sync_barrier_arrive_and_drop(self.handle);
        if phase < 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(phase);
    }

    /// @brief Destroy the barrier after all threads stop using it.
    pub fn close(self: Barrier) -> i32 {
        return __mlang_std_sync_barrier_free(self.handle);
    }
}

impl CountingSemaphore {
    /// @brief Create with `initial` available permits and a fixed maximum.
    pub fn new(initial: i64, maximum: i64) -> result<CountingSemaphore, str8> {
        let handle: i64 = __mlang_std_sync_semaphore_new(initial, maximum);
        if handle == 0 { return Err<CountingSemaphore, str8>(last_error()); }
        return Ok<CountingSemaphore, str8>(CountingSemaphore { handle: handle });
    }

    pub fn is_valid(self: CountingSemaphore) -> bool {
        return self.handle != 0;
    }

    /// @brief Block until a permit is available, then consume it.
    pub fn acquire(self: CountingSemaphore) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_semaphore_acquire(self.handle);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    /// @brief Consume one permit if available; false otherwise.
    pub fn try_acquire(self: CountingSemaphore) -> result<bool, str8> {
        let rc: i32 = __mlang_std_sync_semaphore_try_acquire(self.handle);
        if rc < 0 { return Err<bool, str8>(last_error()); }
        return Ok<bool, str8>(rc == 1);
    }

    /// @brief Release one permit.
    pub fn release(self: CountingSemaphore) -> result<i32, str8> {
        return self.release_by(1);
    }

    /// @brief Release `update` permits; reject nonpositive updates or exceeding
    /// the maximum count rather than allowing the count to overflow.
    pub fn release_by(self: CountingSemaphore, update: i64) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_semaphore_release(self.handle, update);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    /// @brief Destroy after all acquirers have stopped using the semaphore.
    pub fn close(self: CountingSemaphore) -> i32 {
        return __mlang_std_sync_semaphore_free(self.handle);
    }
}

impl<T> SpscQueue {
    /// @brief Allocate capacity slots before starting audio processing.
    /// Returns an invalid queue (is_valid() == false) for nonpositive sizes,
    /// overflow, allocation failure, or targets without lock-free indices.
    /// last_error() describes construction failures.
    pub fn new(capacity: i64) -> SpscQueue<T> {
        let h: i64 = __mlang_std_sync_spsc_new(capacity, size_of(T));
        return SpscQueue<T> { handle: h };
    }

    pub fn is_valid(self: SpscQueue<T>) -> bool {
        return self.handle != 0;
    }

    /// @brief Copy an event into the queue. False means full; never waits.
    /// No allocation, deallocation, or mutex operations on this path.
    pub fn try_push(self: SpscQueue<T>, value: T) -> bool {
        return __mlang_std_sync_spsc_push(self.handle, &value) == 1;
    }

    /// @brief Copy the next event into existing storage. False means empty.
    /// Leaves output unchanged when empty. Never allocates, frees, or waits.
    pub fn try_pop_into(self: SpscQueue<T>, value: ptr<T>) -> bool {
        return __mlang_std_sync_spsc_pop(self.handle, value) == 1;
    }

    /// @brief Release storage after producer and consumer have stopped.
    pub fn release(self: SpscQueue<T>) -> void {
        __mlang_std_sync_spsc_free(self.handle);
    }
}


/// @brief Return last std::sync backend error string.
pub fn last_error() -> str8 {
    return __mlang_std_sync_last_error();
}

impl mutex {
    /// @brief Create a new mutex.
    pub fn new() -> result<mutex, str8> {
        let h: i64 = __mlang_std_sync_mutex_new();
        if h == 0 {
            return Err<mutex, str8>(last_error());
        }
        return Ok<mutex, str8>(mutex { raw: h });
    }

    /// @brief Lock mutex.
    pub fn lock(self: mutex) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_mutex_lock(self.raw);
        if rc != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Unlock mutex.
    pub fn unlock(self: mutex) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_mutex_unlock(self.raw);
        if rc != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Free mutex handle.
    pub fn close(self: mutex) -> i32 {
        return __mlang_std_sync_mutex_free(self.raw);
    }
}

impl Condvar {
    /// @brief Create a new condition variable.
    pub fn new() -> result<Condvar, str8> {
        let h: i64 = __mlang_std_sync_condvar_new();
        if h == 0 {
            return Err<Condvar, str8>(last_error());
        }
        return Ok<Condvar, str8>(Condvar { handle: h });
    }

    /// @brief Wait for notification. Caller must hold `mutex`.
    pub fn wait(self: Condvar, mutex: mutex) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_condvar_wait(self.handle, mutex.raw);
        if rc != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Wait with timeout (ms). Returns 0 when notified, 1 when timed out.
    pub fn wait_timeout_ms(self: Condvar, mutex: mutex, timeout_ms: i64) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_condvar_wait_timeout_ms(self.handle, mutex.raw, timeout_ms);
        if rc < 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(rc);
    }

    /// @brief Wake one waiting thread.
    pub fn notify_one(self: Condvar) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_condvar_notify_one(self.handle);
        if rc != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Wake all waiting threads.
    pub fn notify_all(self: Condvar) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_condvar_notify_all(self.handle);
        if rc != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Free condvar handle.
    pub fn close(self: Condvar) -> i32 {
        return __mlang_std_sync_condvar_free(self.handle);
    }
}

impl Channel {
    /// @brief Create string channel with bounded capacity (`<=0` => default).
    pub fn new(capacity: i64) -> result<Channel, str8> {
        let h: i64 = __mlang_std_sync_channel_new(capacity);
        if h == 0 {
            return Err<Channel, str8>(last_error());
        }
        return Ok<Channel, str8>(Channel { handle: h });
    }

    /// @brief Send message to channel (blocks when full).
    pub fn send(self: Channel, s: str8) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_channel_send(self.handle, s);
        if rc != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Post message to another thread.
    /// Alias for `send`.
    pub fn post(self: Channel, s: str8) -> result<i32, str8> {
        return self.send(s);
    }

    /// @brief Receive message into `buf`.
    /// Returns bytes copied. `0` means channel is closed and drained.
    pub fn recv(self: Channel, buf: str8, capacity: i64) -> result<i64, str8> {
        let n: i64 = __mlang_std_sync_channel_recv(self.handle, buf, capacity);
        if n < 0 {
            return Err<i64, str8>(last_error());
        }
        return Ok<i64, str8>(n);
    }

    /// @brief Non-blocking receive into `buf`.
    /// Returns bytes copied (>0), `0` when closed+drained, `-2` when empty.
    pub fn try_recv(self: Channel, buf: str8, capacity: i64) -> result<i64, str8> {
        let n: i64 = __mlang_std_sync_channel_try_recv(self.handle, buf, capacity);
        if n < -1 {
            return Ok<i64, str8>(n);
        }
        if n < 0 {
            return Err<i64, str8>(last_error());
        }
        return Ok<i64, str8>(n);
    }

    /// @brief Close channel. Wakes blocked senders/receivers.
    pub fn close(self: Channel) -> i32 {
        return __mlang_std_sync_channel_close(self.handle);
    }

    /// @brief Free channel handle.
    pub fn free(self: Channel) -> i32 {
        return __mlang_std_sync_channel_free(self.handle);
    }
}

impl LockFreeQueue {
    /// @brief Create lock-free SPSC queue (`capacity<=0` => default).
    pub fn new(capacity: i64) -> result<LockFreeQueue, str8> {
        let h: i64 = __mlang_std_sync_lfqueue_new(capacity);
        if h == 0 {
            return Err<LockFreeQueue, str8>(last_error());
        }
        return Ok<LockFreeQueue, str8>(LockFreeQueue { handle: h });
    }

    /// @brief Non-blocking post to queue.
    /// Returns `0` on success, `1` when full.
    pub fn try_send(self: LockFreeQueue, s: str8) -> result<i32, str8> {
        let rc: i32 = __mlang_std_sync_lfqueue_send(self.handle, s);
        if rc == 0 || rc == 1 {
            return Ok<i32, str8>(rc);
        }
        return Err<i32, str8>(last_error());
    }

    /// @brief Non-blocking receive into `buf`.
    /// Returns bytes copied (>0), `0` when closed+drained, `-2` when empty.
    pub fn try_recv(self: LockFreeQueue, buf: str8, capacity: i64) -> result<i64, str8> {
        let n: i64 = __mlang_std_sync_lfqueue_try_recv(self.handle, buf, capacity);
        if n >= 0 || n == -2 {
            return Ok<i64, str8>(n);
        }
        return Err<i64, str8>(last_error());
    }

    /// @brief Close queue to new sends.
    pub fn close(self: LockFreeQueue) -> i32 {
        return __mlang_std_sync_lfqueue_close(self.handle);
    }

    /// @brief Free queue handle.
    pub fn free(self: LockFreeQueue) -> i32 {
        return __mlang_std_sync_lfqueue_free(self.handle);
    }
}
