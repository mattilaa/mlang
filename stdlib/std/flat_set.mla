/// \file flat_set.mla
/// \brief Sorted list-backed associative set inspired by C++23 std::flat_set.
///
/// Keys are stored once in ascending order in contiguous list storage. Reads
/// use binary search; updates rebuild the list, consistent with the eager
/// value-oriented design used by std::flat_map.

/// @brief Sorted associative set with unique keys.
pub struct FlatSet<T> {
    var keys: list<T>;
};

/// @brief Lowercase stdlib spelling for `FlatSet<T>`.
alias flat_set<T> = FlatSet<T>;

impl<T> FlatSet {
    /// @brief Construct an empty flat set.
    pub fn new() -> FlatSet<T> {
        return FlatSet<T> { keys: [] };
    }

    /// @brief Number of keys.
    pub fn len(self: &FlatSet<T>) -> i64 {
        return self.keys.len();
    }

    /// @brief Whether the set has no keys.
    pub fn is_empty(self: &FlatSet<T>) -> bool {
        return self.keys.len() == 0;
    }

    /// @brief Return the first index whose key is not less than `key`.
    /// Returns `len()` when all keys are less than the query.
    pub fn lower_bound(self: &FlatSet<T>, key: T) -> i64 {
        var first: i64 = 0;
        var count: i64 = self.keys.len();
        while count > 0 {
            let step: i64 = count / 2;
            let middle: i64 = first + step;
            if self.keys[middle] < key {
                first = middle + 1;
                count = count - step - 1;
            } else {
                count = step;
            }
        }
        return first;
    }

    /// @brief Return the first index whose key is greater than `key`.
    pub fn upper_bound(self: &FlatSet<T>, key: T) -> i64 {
        var first: i64 = 0;
        var count: i64 = self.keys.len();
        while count > 0 {
            let step: i64 = count / 2;
            let middle: i64 = first + step;
            if !(key < self.keys[middle]) {
                first = middle + 1;
                count = count - step - 1;
            } else {
                count = step;
            }
        }
        return first;
    }

    /// @brief Return the half-open index range for `key`.
    /// Ordering equivalence is defined as neither key being less than the other.
    pub fn equal_range(self: &FlatSet<T>, key: T) -> tuple<i64, i64> {
        return (self.lower_bound(key), self.upper_bound(key));
    }

    /// @brief Whether a key is present under ordering equivalence.
    pub fn contains(self: &FlatSet<T>, key: T) -> bool {
        let index: i64 = self.lower_bound(key);
        if index >= self.keys.len() { return false; }
        return !(self.keys[index] < key) && !(key < self.keys[index]);
    }

    /// @brief Insert `key`; return true only when it was not already present.
    pub fn insert(self: &mut FlatSet<T>, key: T) -> bool {
        let index: i64 = self.lower_bound(key);
        let count: i64 = self.keys.len();
        if index < count && !(self.keys[index] < key) &&
           !(key < self.keys[index]) {
            return false;
        }
        var updated: list<T> = [];
        for i in 0..index { updated.push(self.keys[i]); }
        updated.push(key);
        for i in index..count { updated.push(self.keys[i]); }
        self.keys = updated;
        return true;
    }

    /// @brief Insert each key from `range`, returning the number newly added.
    pub fn insert_range(self: &mut FlatSet<T>, range: &list<T>) -> i64 {
        var inserted: i64 = 0;
        for i in 0..range.len() {
            if self.insert(range[i]) { inserted = inserted + 1; }
        }
        return inserted;
    }

    /// @brief Replace the contents if `keys` are strictly increasing.
    /// Invalid input leaves the set unchanged.
    pub fn replace(self: &mut FlatSet<T>, keys: &list<T>) -> bool {
        let count: i64 = keys.len();
        for i in 1..count {
            if !(keys[i - 1] < keys[i]) { return false; }
        }
        var replacement: list<T> = [];
        for i in 0..count { replacement.push(keys[i]); }
        self.keys = replacement;
        return true;
    }

    /// @brief Erase a key under ordering equivalence.
    pub fn remove(self: &mut FlatSet<T>, key: T) -> bool {
        let index: i64 = self.lower_bound(key);
        let count: i64 = self.keys.len();
        if index >= count || self.keys[index] < key || key < self.keys[index] {
            return false;
        }
        var updated: list<T> = [];
        for i in 0..index { updated.push(self.keys[i]); }
        for i in (index + 1)..count { updated.push(self.keys[i]); }
        self.keys = updated;
        return true;
    }

    /// @brief Remove all keys.
    pub fn clear(self: &mut FlatSet<T>) -> void {
        self.keys = [];
    }

    /// @brief Return the key at sorted position `index`.
    pub fn key_at(self: &FlatSet<T>, index: i64) -> T {
        return self.keys[index];
    }
}

/// @brief Find the first stored key not ordered before a heterogeneous query.
generic<T, Query, LessKeyQuery>
pub fn lower_bound_by(container: &FlatSet<T>, query: Query,
                      less_key_query: LessKeyQuery) -> i64 {
    var first: i64 = 0;
    var count: i64 = container.keys.len();
    while count > 0 {
        let step: i64 = count / 2;
        let middle: i64 = first + step;
        if less_key_query(container.keys[middle], query) {
            first = middle + 1;
            count = count - step - 1;
        } else {
            count = step;
        }
    }
    return first;
}

/// @brief Find the first stored key ordered after a heterogeneous query.
generic<T, Query, LessQueryKey>
pub fn upper_bound_by(container: &FlatSet<T>, query: Query,
                      less_query_key: LessQueryKey) -> i64 {
    var first: i64 = 0;
    var count: i64 = container.keys.len();
    while count > 0 {
        let step: i64 = count / 2;
        let middle: i64 = first + step;
        if !less_query_key(query, container.keys[middle]) {
            first = middle + 1;
            count = count - step - 1;
        } else {
            count = step;
        }
    }
    return first;
}

/// @brief Return the half-open index range matching a heterogeneous query.
generic<T, Query, LessKeyQuery, LessQueryKey>
pub fn equal_range_by(container: &FlatSet<T>, query: Query,
                      less_key_query: LessKeyQuery,
                      less_query_key: LessQueryKey) -> tuple<i64, i64> {
    return (lower_bound_by(container, query, less_key_query),
            upper_bound_by(container, query, less_query_key));
}

/// @brief Whether a heterogeneous query matches a stored key by ordering.
generic<T, Query, LessKeyQuery, LessQueryKey>
pub fn contains_by(container: &FlatSet<T>, query: Query,
                   less_key_query: LessKeyQuery,
                   less_query_key: LessQueryKey) -> bool {
    let index: i64 = lower_bound_by(container, query, less_key_query);
    if index >= container.keys.len() { return false; }
    return !less_key_query(container.keys[index], query) &&
           !less_query_key(query, container.keys[index]);
}

/// @brief Erase the key equivalent to a heterogeneous query, if present.
generic<T, Query, LessKeyQuery, LessQueryKey>
pub fn remove_by(container: &mut FlatSet<T>, query: Query,
                 less_key_query: LessKeyQuery,
                 less_query_key: LessQueryKey) -> bool {
    let index: i64 = lower_bound_by(container, query, less_key_query);
    let count: i64 = container.keys.len();
    if index >= count || less_key_query(container.keys[index], query) ||
       less_query_key(query, container.keys[index]) {
        return false;
    }
    var updated: list<T> = [];
    for i in 0..index { updated.push(container.keys[i]); }
    for i in (index + 1)..count { updated.push(container.keys[i]); }
    container.keys = updated;
    return true;
}

/// @brief Erase keys accepted by `predicate` and return the removal count.
generic<T, Predicate>
pub fn erase_if(container: &mut FlatSet<T>, predicate: Predicate) -> i64 {
    var retained: list<T> = [];
    var removed: i64 = 0;
    for i in 0..container.keys.len() {
        let key: T = container.keys[i];
        if predicate(key) { removed = removed + 1; }
        else { retained.push(key); }
    }
    container.keys = retained;
    return removed;
}

/// @brief Transfer non-colliding keys from `source` into `destination`.
/// Equivalent source keys remain in the source; destination keys win.
/// Returns the number transferred.
generic<T>
pub fn merge(destination: &mut FlatSet<T>, source: &mut FlatSet<T>) -> i64 {
    var merged: list<T> = [];
    var retained_source: list<T> = [];
    let destination_len: i64 = destination.keys.len();
    let source_len: i64 = source.keys.len();
    var destination_index: i64 = 0;
    var source_index: i64 = 0;
    var transferred: i64 = 0;
    while destination_index < destination_len && source_index < source_len {
        let destination_key: T = destination.keys[destination_index];
        let source_key: T = source.keys[source_index];
        if destination_key < source_key {
            merged.push(destination_key);
            destination_index = destination_index + 1;
        } else if source_key < destination_key {
            merged.push(source_key);
            source_index = source_index + 1;
            transferred = transferred + 1;
        } else {
            merged.push(destination_key);
            retained_source.push(source_key);
            destination_index = destination_index + 1;
            source_index = source_index + 1;
        }
    }
    while destination_index < destination_len {
        merged.push(destination.keys[destination_index]);
        destination_index = destination_index + 1;
    }
    while source_index < source_len {
        merged.push(source.keys[source_index]);
        source_index = source_index + 1;
        transferred = transferred + 1;
    }
    destination.keys = merged;
    source.keys = retained_source;
    return transferred;
}
