/// \file thread.mla
/// \brief Thread/concurrency helpers for MLang (std::thread).
///
/// This module provides documented wrappers around runtime thread primitives.
///
/// ## Usage
///
/// Spawn a thread with a closure (preferred):
///   let handle = thread::spawn(|| {
///       println!("hello from thread!");
///   });
///   thread::join(handle);
///
/// Spawn a named function (legacy):
///   let handle = thread_spawn(my_fn);
///   thread::join(handle);
///
/// Note: `thread_spawn(...)` is a compiler intrinsic also reachable via the
/// `thread::spawn` qualified name when given a closure or function identifier.

/// \cond INTERNAL_IMPORTS
mod std::thread::detail;
use std::thread::detail::*;
/// \endcond

/// @brief Spawn a thread from a closure/function pointer.
///
/// Preferred entrypoint for user code so IDE/LSP "go to definition" resolves
/// to documented stdlib source.
///
/// Note: this is a compiler intrinsic declaration (not a C FFI binding).
extern pub fn spawn(fn_ptr: ptr<void>) -> Handle<Thread>;

/// @brief Join a spawned thread handle.
/// Returns thread exit status.
pub fn join(handle: Handle<Thread>) -> i32 {
    return thread_join(handle);
}

/// @brief Create a new mutex handle.
pub fn mutex_new() -> Handle<Mutex> {
    return mutex_create();
}

/// @brief Lock a mutex.
/// Returns `0` on success.
pub fn mutex_lock_handle(handle: Handle<Mutex>) -> i32 {
    return mutex_lock(handle);
}

/// @brief Unlock a mutex.
/// Returns `0` on success.
pub fn mutex_unlock_handle(handle: Handle<Mutex>) -> i32 {
    return mutex_unlock(handle);
}

/// @brief Destroy a mutex.
/// Returns `0` on success.
pub fn mutex_free(handle: Handle<Mutex>) -> i32 {
    return mutex_destroy(handle);
}

/// @brief Create a 64-bit atomic counter.
pub fn atomic_new(initial: i64) -> Handle<Atomic64> {
    return atomic_i64_new(initial);
}

/// @brief Load atomic value.
pub fn atomic_load_value(handle: Handle<Atomic64>) -> i64 {
    return atomic_i64_load(handle);
}

/// @brief Store atomic value and return stored value.
pub fn atomic_store_value(handle: Handle<Atomic64>, value: i64) -> i64 {
    return atomic_i64_store(handle, value);
}

/// @brief Add `delta` to atomic value.
/// Returns the previous value.
pub fn atomic_add_value(handle: Handle<Atomic64>, delta: i64) -> i64 {
    return atomic_i64_add(handle, delta);
}

/// @brief Free atomic handle.
pub fn atomic_free_handle(handle: Handle<Atomic64>) -> void {
    atomic_i64_free(handle);
}
