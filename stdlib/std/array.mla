/// \file array.mla
/// \brief Fixed-capacity array reference for MLang (std::array).
///
/// `array<T, N>` is a compiler-provided fixed-capacity sequence type. It is
/// list-compatible at the method level, so normal collection methods such as
/// `len`, `is_empty`, `push`, `pop`, and `clear` are available.
///
/// Literal and fill initializers are checked by the compiler:
///
/// ```mlang
/// let fixed: array<int, 6> = {1, 3, 4, 5, 6, 7};
/// var scratch: array<int, 6> = {};
/// scratch.push(10);
/// scratch.pop();
/// ```
///
/// `size_of(array<T, N>)` reports fixed storage bytes: `N * size_of(T)`.

// @builtin array
// Fixed-capacity sequence type: array<T, N>.
// Initializer element counts are checked at compile time.
// The value supports list-compatible collection methods.

// Documentation-only anchor for `mod std::array;`.
extern fn array() -> void;
