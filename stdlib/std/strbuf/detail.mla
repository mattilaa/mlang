/// \file strbuf/detail.mla
/// \brief C ABI bindings for std::strbuf (implementation detail).
///
/// These symbols are resolved by the linker against libmlang_std.
/// Do not call them directly -- use the public API in std::strbuf instead.

extern fn __mlang_std_strbuf_len(s: string) -> i64;
extern fn __mlang_std_strbuf_is_empty(s: string) -> i32;
extern fn __mlang_std_strbuf_clone(s: string) -> string;
extern fn __mlang_std_strbuf_eq(a: string, b: string) -> i32;
extern fn __mlang_std_strbuf_compare(a: string, b: string) -> i64;
extern fn __mlang_std_strbuf_starts_with(s: string, prefix: string) -> i32;
extern fn __mlang_std_strbuf_ends_with(s: string, suffix: string) -> i32;
extern fn __mlang_std_strbuf_contains(s: string, needle: string) -> i32;
extern fn __mlang_std_strbuf_find(s: string, needle: string) -> i64;
extern fn __mlang_std_strbuf_rfind(s: string, needle: string) -> i64;
extern fn __mlang_std_strbuf_sub(s: string, start: i64, count: i64) -> string;
extern fn __mlang_std_strbuf_concat(a: string, b: string) -> string;
extern fn __mlang_std_strbuf_repeat(s: string, count: i64) -> string;
extern fn __mlang_std_strbuf_trim(s: string) -> string;
extern fn __mlang_std_strbuf_ltrim(s: string) -> string;
extern fn __mlang_std_strbuf_rtrim(s: string) -> string;
extern fn __mlang_std_strbuf_utf8_to_utf16(s: string) -> str16;
extern fn __mlang_std_strbuf_utf16_to_utf8(s: str16) -> string;
extern fn __mlang_std_strbuf_free_str16(s: str16) -> void;
extern fn __mlang_std_strbuf_json_escape(s: string) -> string;
extern fn __mlang_std_strbuf_builder_rt_new(initial_capacity: i64, page_size: i64) -> i64;
extern fn __mlang_std_strbuf_builder_rt_free(handle: i64) -> i32;
extern fn __mlang_std_strbuf_builder_rt_len(handle: i64) -> i64;
extern fn __mlang_std_strbuf_builder_rt_capacity(handle: i64) -> i64;
extern fn __mlang_std_strbuf_builder_rt_set_page_size(handle: i64, page_size: i64) -> i32;
extern fn __mlang_std_strbuf_builder_rt_clear(handle: i64) -> i32;
extern fn __mlang_std_strbuf_builder_rt_reserve(handle: i64, min_capacity: i64) -> i32;
extern fn __mlang_std_strbuf_builder_rt_append(handle: i64, s: string) -> i64;
extern fn __mlang_std_strbuf_builder_rt_append_char(handle: i64, ch: i32) -> i64;
extern fn __mlang_std_strbuf_builder_rt_to_string(handle: i64) -> string;
extern fn __mlang_std_strbuf_builder_rt_take_string(handle: i64) -> string;
