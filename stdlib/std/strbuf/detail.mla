/// \file strbuf/detail.mla
/// \brief C ABI bindings for std::strbuf (implementation detail).
///
/// These symbols are resolved by the linker against libmlang_std.
/// Do not call them directly -- use the public API in std::strbuf instead.

extern fn __mlang_std_strbuf_len(s: str8) -> i64;
extern fn __mlang_std_strbuf_is_empty(s: str8) -> i32;
extern fn __mlang_std_strbuf_clone(s: str8) -> str8;
extern fn __mlang_std_strbuf_eq(a: str8, b: str8) -> i32;
extern fn __mlang_std_strbuf_compare(a: str8, b: str8) -> i64;
extern fn __mlang_std_strbuf_starts_with(s: str8, prefix: str8) -> i32;
extern fn __mlang_std_strbuf_ends_with(s: str8, suffix: str8) -> i32;
extern fn __mlang_std_strbuf_contains(s: str8, needle: str8) -> i32;
extern fn __mlang_std_strbuf_find(s: str8, needle: str8) -> i64;
extern fn __mlang_std_strbuf_rfind(s: str8, needle: str8) -> i64;
extern fn __mlang_std_strbuf_sub(s: str8, start: i64, count: i64) -> str8;
extern fn __mlang_std_strbuf_concat(a: str8, b: str8) -> str8;
extern fn __mlang_std_strbuf_repeat(s: str8, count: i64) -> str8;
extern fn __mlang_std_strbuf_trim(s: str8) -> str8;
extern fn __mlang_std_strbuf_ltrim(s: str8) -> str8;
extern fn __mlang_std_strbuf_rtrim(s: str8) -> str8;
extern fn __mlang_std_strbuf_utf8_to_utf16(s: str8) -> str16;
extern fn __mlang_std_strbuf_utf16_to_utf8(s: str16) -> str8;
extern fn __mlang_std_strbuf_free_str16(s: str16) -> void;
extern fn __mlang_std_strbuf_json_escape(s: str8) -> str8;
extern fn __mlang_std_strbuf_builder_rt_new(initial_capacity: i64, page_size: i64) -> i64;
extern fn __mlang_std_strbuf_builder_rt_free(handle: i64) -> i32;
extern fn __mlang_std_strbuf_builder_rt_len(handle: i64) -> i64;
extern fn __mlang_std_strbuf_builder_rt_capacity(handle: i64) -> i64;
extern fn __mlang_std_strbuf_builder_rt_set_page_size(handle: i64, page_size: i64) -> i32;
extern fn __mlang_std_strbuf_builder_rt_clear(handle: i64) -> i32;
extern fn __mlang_std_strbuf_builder_rt_reserve(handle: i64, min_capacity: i64) -> i32;
extern fn __mlang_std_strbuf_builder_rt_append(handle: i64, s: str8) -> i64;
extern fn __mlang_std_strbuf_builder_rt_append_char(handle: i64, ch: i32) -> i64;
extern fn __mlang_std_strbuf_builder_rt_to_string(handle: i64) -> str8;
extern fn __mlang_std_strbuf_builder_rt_take_string(handle: i64) -> str8;
