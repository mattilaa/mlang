/// \file fuzzy.mla
/// \brief Fuzzy/subsequence matching helpers for std::algorithm.
///
/// Matching is byte-based and order-preserving: every query byte must appear
/// in `text` in the same order (not necessarily contiguously).
///
/// @defgroup algorithm_fuzzy std::algorithm::fuzzy
/// @ingroup algorithm
/// @brief Fuzzy string matching helpers.
/// @{

/// \cond INTERNAL_IMPORTS
mod std::strbuf;

use std::strbuf::eq;
use std::strbuf::free;
use std::strbuf::len;
use std::strbuf::sub;
/// \endcond

fn boundary_bonus(text: string, idx: i64) -> i64 {
    if idx <= 0 {
        return 3;
    }
    let prev: string = sub(text, idx - 1, 1);
    let is_boundary: i32 =
        eq(prev, "_") == 1 ||
        eq(prev, "-") == 1 ||
        eq(prev, "/") == 1 ||
        eq(prev, " ") == 1 ||
        eq(prev, ".") == 1 ? 1 : 0;
    free(prev);
    return is_boundary == 1 ? 3 : 0;
}

/// @brief Return `1` when `query` is an ordered subsequence of `text`.
/// @ingroup algorithm_fuzzy
pub fn is_match(text: string, query: string) -> i32 {
    let qn: i64 = len(query);
    if qn == 0 {
        return 1;
    }
    let tn: i64 = len(text);
    var qi: i64 = 0;
    for ti in 0..tn {
        if qi >= qn {
            break;
        }
        let tc: string = sub(text, ti, 1);
        let qc: string = sub(query, qi, 1);
        if eq(tc, qc) == 1 {
            qi = qi + 1;
        }
        free(qc);
        free(tc);
    }
    return qi >= qn ? 1 : 0;
}

/// @brief Score how well `query` matches `text`.
/// Returns `-1` when not matched; otherwise non-negative score.
/// @ingroup algorithm_fuzzy
pub fn score(text: string, query: string) -> i64 {
    let qn: i64 = len(query);
    if qn == 0 {
        return 0;
    }
    let tn: i64 = len(text);
    var qi: i64 = 0;
    var s: i64 = 0;
    var last_ti: i64 = -2;

    for ti in 0..tn {
        if qi >= qn {
            break;
        }
        let tc: string = sub(text, ti, 1);
        let qc: string = sub(query, qi, 1);
        if eq(tc, qc) == 1 {
            s = s + 10;
            if last_ti + 1 == ti {
                s = s + 6;
            }
            s = s + boundary_bonus(text, ti);
            last_ti = ti;
            qi = qi + 1;
        } else if qi > 0 {
            s = s - 1;
            if s < 0 {
                s = 0;
            }
        }
        free(qc);
        free(tc);
    }

    if qi < qn {
        return -1;
    }
    s = s - (tn - qn);
    return s < 0 ? 0 : s;
}

/// @brief Return matching indices ranked by descending fuzzy score.
/// @ingroup algorithm_fuzzy
pub fn filter_indices(items: &list<string>, query: string) -> list<i64> {
    let n: i64 = items.len();
    if len(query) == 0 {
        var all: list<i64> = [];
        for i in 0..n {
            all.push(i);
        }
        return all;
    }

    var ranked_idx: list<i64> = [];
    var ranked_score: list<i64> = [];
    for i in 0..n {
        let sc: i64 = score(items[i], query);
        if sc < 0 {
            continue;
        }
        let m: i64 = ranked_idx.len();
        var pos: i64 = m;
        for j in 0..m {
            let sj: i64 = ranked_score[j];
            let ij: i64 = ranked_idx[j];
            if sc > sj || (sc == sj && i < ij) {
                pos = j;
                break;
            }
        }

        var next_idx: list<i64> = [];
        var next_score: list<i64> = [];
        for j in 0..pos {
            next_idx.push(ranked_idx[j]);
            next_score.push(ranked_score[j]);
        }
        next_idx.push(i);
        next_score.push(sc);
        for j in pos..m {
            next_idx.push(ranked_idx[j]);
            next_score.push(ranked_score[j]);
        }
        ranked_idx = next_idx;
        ranked_score = next_score;
    }
    return ranked_idx;
}

/// @brief Best matching index or `-1` when there is no match.
/// @ingroup algorithm_fuzzy
pub fn best_index(items: &list<string>, query: string) -> i64 {
    let ranked: list<i64> = filter_indices(items, query);
    if ranked.len() == 0 {
        return -1;
    }
    return ranked[0];
}

/// @}
