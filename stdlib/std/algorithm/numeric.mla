/// A half-way result rounds toward `first`, as in C++20 `std::midpoint`.
pub fn midpoint_i8(first: i8, second: i8) -> i8 {
    var middle: i8 = first / 2 + second / 2;
    let remainder: i8 = first % 2 + second % 2;
    if remainder == 2 { return middle + 1; }
    if remainder == -2 { return middle - 1; }
    if remainder == 1 && first > second { return middle + 1; }
    if remainder == -1 && first < second { return middle - 1; }
    return middle;
}

/// @brief Compute the signed 16-bit midpoint without overflow.
/// A half-way result rounds toward `first`, as in C++20 `std::midpoint`.
pub fn midpoint_i16(first: i16, second: i16) -> i16 {
    var middle: i16 = first / 2 + second / 2;
    let remainder: i16 = first % 2 + second % 2;
    if remainder == 2 { return middle + 1; }
    if remainder == -2 { return middle - 1; }
    if remainder == 1 && first > second { return middle + 1; }
    if remainder == -1 && first < second { return middle - 1; }
    return middle;
