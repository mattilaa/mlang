/// \file numeric.mla
/// \brief Numeric algorithms under std::algorithm.
///
/// C++-style `<numeric>` inspired helpers for Mlang lists.
///
/// @defgroup algorithm_numeric std::algorithm::numeric
/// @ingroup algorithm
/// @brief Numeric sequence algorithms.
/// @{

/// @brief Sum all elements with an initial value.
/// @ingroup algorithm_numeric
pub fn accumulate_i64(data: &list<i64>, init: i64) -> i64 {
    var acc: i64 = init;
    let n: i64 = data.len();
    for i in 0..n {
        acc = acc + data[i];
    }
    return acc;
}

/// @brief Fold a list into an accumulator, preserving the accumulator type.
/// @ingroup algorithm_numeric
generic<T, U>
pub fn accumulate(data: &list<T>, init: U) -> U {
    var acc: U = init;
    let n: i64 = data.len();
    for i in 0..n {
        acc = acc + data[i];
    }
    return acc;
}

/// @brief Fold a list from left to right with a caller-supplied operation.
/// `operation(accumulator, element)` returns the next accumulator.
/// C++23 `std::ranges::fold_left` equivalent.
/// @ingroup algorithm_numeric
generic<T, U, Operation>
pub fn fold_left(data: &list<T>, init: U, operation: Operation) -> U {
    var acc: U = init;
    let n: i64 = data.len();
    for i in 0..n {
        acc = operation(acc, data[i]);
    }
    return acc;
}

/// @brief Fold a list from right to left with a caller-supplied operation.
/// `operation(element, accumulator)` returns the next accumulator.
/// C++23 `std::ranges::fold_right` equivalent.
/// @ingroup algorithm_numeric
generic<T, U, Operation>
pub fn fold_right(data: &list<T>, init: U, operation: Operation) -> U {
    var acc: U = init;
    var i: i64 = data.len();
    while i > 0 {
        i = i - 1;
        acc = operation(data[i], acc);
    }
    return acc;
}

/// @brief Fold a non-empty list from left to right without an initial value.
/// Empty input returns None; non-empty input returns Some of the result.
/// C++23 `std::ranges::fold_left_first` equivalent.
/// @ingroup algorithm_numeric
generic<T, Operation>
pub fn fold_left_first(data: &list<T>, operation: Operation) -> option<T> {
    let n: i64 = data.len();
    if n == 0 {
        return None<T>();
    }
    var acc: T = data[0];
    for i in 1..n {
        acc = operation(acc, data[i]);
    }
    return Some<T>(acc);
}

/// @brief Fold a non-empty list from right to left without an initial value.
/// The operation receives `(element, accumulator)`; empty input returns None.
/// C++23 `std::ranges::fold_right_last` equivalent.
/// @ingroup algorithm_numeric
generic<T, Operation>
pub fn fold_right_last(data: &list<T>, operation: Operation) -> option<T> {
    let n: i64 = data.len();
    if n == 0 {
        return None<T>();
    }
    var i: i64 = n - 1;
    var acc: T = data[i];
    while i > 0 {
        i = i - 1;
        acc = operation(data[i], acc);
    }
    return Some<T>(acc);
}

/// @brief Project each element, then reduce it into the accumulator in one pass.
/// C++ `std::transform_reduce` unary-range form.
/// @ingroup algorithm_numeric
generic<T, U, Reduce, Project>
pub fn transform_reduce(data: &list<T>, init: U, reduce: Reduce,
                        project: Project) -> U {
    var acc: U = init;
    let n: i64 = data.len();
    for i in 0..n {
        acc = reduce(acc, project(data[i]));
    }
    return acc;
}

/// @brief Project corresponding elements from two lists, then reduce in one pass.
/// Stops at the end of the shorter range.
/// C++ `std::transform_reduce` binary-range form.
/// @ingroup algorithm_numeric
generic<T, V, U, Reduce, Project>
pub fn transform_reduce(left: &list<T>, right: &list<V>, init: U,
                        reduce: Reduce, project: Project) -> U {
    var acc: U = init;
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let n: i64 = left_len < right_len ? left_len : right_len;
    for i in 0..n {
        acc = reduce(acc, project(left[i], right[i]));
    }
    return acc;
}

/// @brief Generic inner product over the shared prefix of two lists.
/// @ingroup algorithm_numeric
generic<T, U>
pub fn inner_product(left: &list<T>, right: &list<T>, init: U) -> U {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let n: i64 = left_len < right_len ? left_len : right_len;
    var acc: U = init;
    for i in 0..n {
        acc = acc + (left[i] * right[i]);
    }
    return acc;
}

/// @brief Return all inclusive prefix accumulations using `operation`.
/// The first output is the first input element; empty input produces an empty list.
/// C++ `std::inclusive_scan` equivalent.
/// @ingroup algorithm_numeric
generic<T, Operation>
pub fn inclusive_scan(data: &list<T>, operation: Operation) -> list<T> {
    let n: i64 = data.len();
    if n == 0 {
        return [];
    }
    var out: list<T> = [];
    var acc: T = data[0];
    out.push(acc);
    for i in 1..n {
        acc = operation(acc, data[i]);
        out.push(acc);
    }
    return out;
}

/// @brief Return exclusive prefix accumulations using `init` and `operation`.
/// Each output is the accumulator before incorporating that position's element.
/// C++ `std::exclusive_scan` equivalent.
/// @ingroup algorithm_numeric
generic<T, U, Operation>
pub fn exclusive_scan(data: &list<T>, init: U, operation: Operation)
    -> list<U> {
    var out: list<U> = [];
    var acc: U = init;
    let n: i64 = data.len();
    for i in 0..n {
        out.push(acc);
        acc = operation(acc, data[i]);
    }
    return out;
}

/// @brief Project each input and return its inclusive accumulated prefixes.
/// The first projected value initializes the accumulator; empty input returns
/// an empty list. C++ `std::transform_inclusive_scan` without an initial value.
/// @ingroup algorithm_numeric
generic<T, U, Operation, Projection>
pub fn transform_inclusive_scan(data: &list<T>, operation: Operation,
                                project: Projection) -> list<U> {
    let n: i64 = data.len();
    if n == 0 {
        return [];
    }
    var out: list<U> = [];
    var acc: U = project(data[0]);
    out.push(acc);
    for i in 1..n {
        acc = operation(acc, project(data[i]));
        out.push(acc);
    }
    return out;
}

/// @brief Project inputs and return inclusive accumulated prefixes beginning
/// with `init`. Empty input returns an empty list.
/// C++ `std::transform_inclusive_scan` with an initial value.
/// @ingroup algorithm_numeric
generic<T, U, Operation, Projection>
pub fn transform_inclusive_scan(data: &list<T>, init: U,
                                operation: Operation, project: Projection)
    -> list<U> {
    var out: list<U> = [];
    var acc: U = init;
    let n: i64 = data.len();
    for i in 0..n {
        acc = operation(acc, project(data[i]));
        out.push(acc);
    }
    return out;
}

/// @brief Project each input after emitting the current accumulator.
/// C++ `std::transform_exclusive_scan` eager-list counterpart.
/// @ingroup algorithm_numeric
generic<T, U, Operation, Projection>
pub fn transform_exclusive_scan(data: &list<T>, init: U,
                                operation: Operation, project: Projection)
    -> list<U> {
    var out: list<U> = [];
    var acc: U = init;
    let n: i64 = data.len();
    for i in 0..n {
        out.push(acc);
        acc = operation(acc, project(data[i]));
    }
    return out;
}

/// @brief Generic prefix sums with an initial value.
/// Returns `[init + d0, init + d0 + d1, ...]`.
/// @ingroup algorithm_numeric
generic<T>
pub fn partial_sum(data: &list<T>, init: T) -> list<T> {
    var out: list<T> = [];
    var acc: T = init;
    let n: i64 = data.len();
    for i in 0..n {
        acc = acc + data[i];
        out.push(acc);
    }
    return out;
}

/// @brief Generic adjacent differences.
/// The first value is `data[0] - init`; later values are adjacent deltas.
/// @ingroup algorithm_numeric
generic<T>
pub fn adjacent_difference(data: &list<T>, init: T) -> list<T> {
    let n: i64 = data.len();
    if n == 0 {
        return [];
    }
    var out: list<T> = [];
    out.push(data[0] - init);
    for i in 1..n {
        out.push(data[i] - data[i - 1]);
    }
    return out;
}

/// @brief Prefix sums with an initial value.
/// Returns `[init + d0, init + d0 + d1, ...]`.
/// @ingroup algorithm_numeric
pub fn partial_sum_i64(data: &list<i64>, init: i64) -> list<i64> {
    var out: list<i64> = [];
    var acc: i64 = init;
    let n: i64 = data.len();
    for i in 0..n {
        acc = acc + data[i];
        out.push(acc);
    }
    return out;
}

/// @brief Adjacent differences.
/// Returns `[d0 - init, d1 - d0, d2 - d1, ...]`.
/// @ingroup algorithm_numeric
pub fn adjacent_difference_i64(data: &list<i64>, init: i64) -> list<i64> {
    let n: i64 = data.len();
    if n == 0 {
        return [];
    }
    var out: list<i64> = [];
    out.push(data[0] - init);
    for i in 1..n {
        out.push(data[i] - data[i - 1]);
    }
    return out;
}

/// @brief Inner product with initial value.
/// For min length of both lists: `init + sum(a[i] * b[i])`.
/// @ingroup algorithm_numeric
pub fn inner_product_i64(a: &list<i64>, b: &list<i64>, init: i64) -> i64 {
    let na: i64 = a.len();
    let nb: i64 = b.len();
    let n: i64 = na < nb ? na : nb;
    var acc: i64 = init;
    for i in 0..n {
        acc = acc + (a[i] * b[i]);
    }
    return acc;
}

/// @}
