/// \file numeric.mla
/// \brief Numeric algorithms under std::algorithm.
///
/// C++-style `<numeric>` inspired helpers for Mlang lists.
///
/// @defgroup algorithm_numeric std::algorithm::numeric
/// @ingroup algorithm
/// @brief Numeric sequence algorithms.
/// @{

/// @brief Compute the signed midpoint without overflowing.
/// A half-way result rounds toward `first`, as in C++20 `std::midpoint`.
pub fn midpoint_i64(first: i64, second: i64) -> i64 {
    var middle: i64 = first / 2 + second / 2;
    let remainder: i64 = first % 2 + second % 2;
    if remainder == 2 { return middle + 1; }
    if remainder == -2 { return middle - 1; }
    if remainder == 1 && first > second { return middle + 1; }
    if remainder == -1 && first < second { return middle - 1; }
    return middle;
}

/// @brief Compute the unsigned midpoint without overflowing.
/// A half-way result rounds toward `first`, as in C++20 `std::midpoint`.
pub fn midpoint_u64(first: u64, second: u64) -> u64 {
    var middle: u64 = first / 2 + second / 2;
    let remainder: u64 = first % 2 + second % 2;
    if remainder == 2 { return middle + 1; }
    if remainder == 1 && first > second { return middle + 1; }
    return middle;
}

extern pub fn __mlang_std_midpoint_f32(first: f32, second: f32) -> f32;
extern pub fn __mlang_std_midpoint_f64(first: f64, second: f64) -> f64;

/// @brief Compute the floating-point midpoint without overflowing.
/// Implements the C++20 `std::midpoint` floating overload for `f32`.
pub fn midpoint_f32(first: f32, second: f32) -> f32 {
    return __mlang_std_midpoint_f32(first, second);
}

/// @brief Compute the floating-point midpoint without overflowing.
/// Implements the C++20 `std::midpoint` floating overload for `f64`.
pub fn midpoint_f64(first: f64, second: f64) -> f64 {
    return __mlang_std_midpoint_f64(first, second);
}

