}

/// @brief Bounded projected eight-range zip-transform.
/// @ingroup algorithm_ranges
generic<T, U, V, W, X, Y, Z, A, Output, Operation, FirstProjection,
        SecondProjection, ThirdProjection, FourthProjection, FifthProjection,
        SixthProjection, SeventhProjection, EighthProjection>
pub fn zip_transform8_to_projected(
    first: &list<T>, second: &list<U>, third: &list<V>, fourth: &list<W>,
    fifth: &list<X>, sixth: &list<Y>, seventh: &list<Z>, eighth: &list<A>,
    destination: &mut list<Output>, operation: Operation,
    first_projection: FirstProjection, second_projection: SecondProjection,
    third_projection: ThirdProjection, fourth_projection: FourthProjection,
    fifth_projection: FifthProjection, sixth_projection: SixthProjection,
    seventh_projection: SeventhProjection,
    eighth_projection: EighthProjection) -> i64 {
    var count: i64 = first.len();
    if second.len() < count { count = second.len(); }
    if third.len() < count { count = third.len(); }
    if fourth.len() < count { count = fourth.len(); }
    if fifth.len() < count { count = fifth.len(); }
    if sixth.len() < count { count = sixth.len(); }
    if seventh.len() < count { count = seventh.len(); }
    if eighth.len() < count { count = eighth.len(); }
    if destination.len() < count { count = destination.len(); }
    for i in 0..count {
        destination[i] = operation(first_projection(first[i]),
            second_projection(second[i]), third_projection(third[i]),
            fourth_projection(fourth[i]), fifth_projection(fifth[i]),
            sixth_projection(sixth[i]), seventh_projection(seventh[i]),
            eighth_projection(eighth[i]));
    }
    return count;
}

