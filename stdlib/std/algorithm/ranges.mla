/// @brief Return whether every element is accepted by `predicate`.
/// Empty ranges return true, matching C++20 `std::ranges::all_of`.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn all_of(data: &list<T>, predicate: Predicate) -> bool {
    let n: i64 = data.len();
    for i in 0..n {
        if !predicate(data[i]) {
            return false;
        }
    }
    return true;
}

/// @brief Check whether every projected key satisfies `predicate`.
/// Empty ranges return true.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn all_of_projected(data: &list<T>, predicate: Predicate,
                        projection: Projection) -> bool {
    let n: i64 = data.len();
    for i in 0..n {
        if !predicate(projection(data[i])) { return false; }
    }
    return true;
}

/// @brief Return whether any element is accepted by `predicate`.
/// Empty ranges return false, matching C++20 `std::ranges::any_of`.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn any_of(data: &list<T>, predicate: Predicate) -> bool {
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(data[i]) {
            return true;
        }
    }
    return false;
}

/// @brief Check whether any projected key satisfies `predicate`.
/// Empty ranges return false.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn any_of_projected(data: &list<T>, predicate: Predicate,
                        projection: Projection) -> bool {
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(projection(data[i])) { return true; }
    }
    return false;
}

/// @brief Return whether no element is accepted by `predicate`.
/// Empty ranges return true, matching C++20 `std::ranges::none_of`.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn none_of(data: &list<T>, predicate: Predicate) -> bool {
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(data[i]) {
            return false;
        }
    }
    return true;
}

/// @brief Check whether no projected key satisfies `predicate`.
/// Empty ranges return true.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn none_of_projected(data: &list<T>, predicate: Predicate,
                         projection: Projection) -> bool {
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(projection(data[i])) { return false; }
    }
    return true;
}

/// @brief Check that matching elements precede all nonmatching elements.
/// C++20 `std::ranges::is_partitioned` semantics.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn is_partitioned(data: &list<T>, predicate: Predicate) -> bool {
    var saw_nonmatching: bool = false;
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(data[i]) {
            if saw_nonmatching {
                return false;
            }
        } else {
            saw_nonmatching = true;
        }
    }
    return true;
}

/// @brief Check projected keys for a true prefix followed by false values.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn is_partitioned_projected(data: &list<T>, predicate: Predicate,
                                projection: Projection) -> bool {
    var saw_nonmatching: bool = false;
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(projection(data[i])) {
            if saw_nonmatching { return false; }
        } else {
            saw_nonmatching = true;
        }
    }
    return true;
}

/// @brief Binary-search the first index not accepted by a partitioned predicate.
/// Returns `data.len()` if all elements match; requires partitioned input.
/// Performs O(log(data.len())) predicate calls.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn partition_point(data: &list<T>, predicate: Predicate) -> i64 {
    var first: i64 = 0;
    var last: i64 = data.len();
    while first < last {
        let middle: i64 = first + (last - first) / 2;
        if predicate(data[middle]) {
            first = middle + 1;
        } else {
            last = middle;
        }
    }
    return first;
}

/// @brief Find the boundary of a partitioned range using projected keys.
/// Requires the predicate to be true on a prefix and false afterwards.
/// Performs O(log(data.len())) predicate calls.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn partition_point_projected(data: &list<T>, predicate: Predicate,
                                 projection: Projection) -> i64 {
    var first: i64 = 0;
    var last: i64 = data.len();
    while first < last {
        let middle: i64 = first + (last - first) / 2;
        if predicate(projection(data[middle])) {
            first = middle + 1;
        } else {
            last = middle;
        }
    }
    return first;
}

/// @brief Return a stable copy with matching elements before the rest.
/// The input remains unchanged; each predicate result is evaluated once.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn stable_partition(data: &list<T>, predicate: Predicate) -> list<T> {
    var matches: list<i32> = [];
    var partitioned: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(data[i]) {
            matches.push(1);
        } else {
            matches.push(0);
        }
    }
    for i in 0..n {
        if matches[i] == 1 {
            partitioned.push(data[i]);
        }
    }
    for i in 0..n {
        if matches[i] == 0 {
            partitioned.push(data[i]);
        }
    }
    return partitioned;
}

/// @brief Return a stable copy partitioned by a predicate over projected keys.
/// Each projection and predicate is evaluated exactly once per element.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn stable_partition_projected(data: &list<T>, predicate: Predicate,
                                  projection: Projection) -> list<T> {
    var matches: list<i32> = [];
    var partitioned: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(projection(data[i])) { matches.push(1); }
        else { matches.push(0); }
    }
    for i in 0..n {
        if matches[i] == 1 { partitioned.push(data[i]); }
    }
    for i in 0..n {
        if matches[i] == 0 { partitioned.push(data[i]); }
    }
    return partitioned;
}

/// @brief Stable-partition a mutable list and return the first nonmatch index.
/// Matching and nonmatching elements retain their original order.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn stable_partition_in_place(data: &mut list<T>,
                                 predicate: Predicate) -> i64 {
    var matches: list<T> = [];
    var nonmatches: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let value: T = data[i];
        if predicate(value) { matches.push(value); }
        else { nonmatches.push(value); }
    }
    let boundary: i64 = matches.len();
    for i in 0..boundary { data[i] = matches[i]; }
    let nonmatch_count: i64 = nonmatches.len();
    for i in 0..nonmatch_count {
        data[boundary + i] = nonmatches[i];
    }
    return boundary;
}

/// @brief Stable-partition a mutable list using projected predicate keys.
/// Each element is projected and tested once; returns the first nonmatch index.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn stable_partition_in_place_projected(
    data: &mut list<T>, predicate: Predicate, projection: Projection) -> i64 {
    var matches: list<T> = [];
    var nonmatches: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let value: T = data[i];
        if predicate(projection(value)) { matches.push(value); }
        else { nonmatches.push(value); }
    }
    let boundary: i64 = matches.len();
    for i in 0..boundary { data[i] = matches[i]; }
    let nonmatch_count: i64 = nonmatches.len();
    for i in 0..nonmatch_count {
        data[boundary + i] = nonmatches[i];
    }
    return boundary;
}

/// @brief Return a partitioned copy and the boundary between both groups.
/// Matching elements precede nonmatching elements; the eager list is left
/// unchanged and each predicate result is evaluated exactly once. The copy
/// preserves order within each group. C++20 `std::ranges::partition` analogue.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn partition(data: &list<T>, predicate: Predicate)
    -> tuple<list<T>, i64> {
    var matching: list<T> = [];
    var nonmatching: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(data[i]) {
            matching.push(data[i]);
        } else {
            nonmatching.push(data[i]);
        }
    }
    let boundary: i64 = matching.len();
    var output: list<T> = [];
    for i in 0..matching.len() {
        output.push(matching[i]);
    }
    for i in 0..nonmatching.len() {
        output.push(nonmatching[i]);
    }
    return (output, boundary);
}

/// @brief Return a stable partitioned copy and boundary using projected keys.
/// Each projection and predicate is evaluated exactly once per element.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn partition_projected(data: &list<T>, predicate: Predicate,
                           projection: Projection) -> tuple<list<T>, i64> {
    var matching: list<T> = [];
    var nonmatching: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(projection(data[i])) { matching.push(data[i]); }
        else { nonmatching.push(data[i]); }
    }
    let boundary: i64 = matching.len();
    var output: list<T> = [];
    for i in 0..matching.len() { output.push(matching[i]); }
    for i in 0..nonmatching.len() { output.push(nonmatching[i]); }
    return (output, boundary);
}

generic<T, Predicate, Projection>
fn ranges_partition_in_place_core(data: &mut list<T>, predicate: Predicate,
                                  projection: Projection) -> i64 {
    var first: i64 = 0;
    var last: i64 = data.len();
    var first_known_nonmatching: bool = false;
    while first < last {
        if !first_known_nonmatching {
            if predicate(projection(data[first])) {
                first = first + 1;
                continue;
            }
            first_known_nonmatching = true;
        }
        let opposite: i64 = last - 1;
        if first == opposite {
            last = opposite;
        } else if predicate(projection(data[opposite])) {
            let temporary: T = data[first];
            data[first] = data[opposite];
            data[opposite] = temporary;
            first = first + 1;
            last = last - 1;
            first_known_nonmatching = false;
        } else {
            last = opposite;
        }
    }
    return first;
}

/// @brief Partition a mutable list in place and return the first nonmatch.
/// Matching values precede nonmatching values; order within either group is
/// unspecified. Each element is tested at most once.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn partition_in_place(data: &mut list<T>, predicate: Predicate) -> i64 {
    return ranges_partition_in_place_core(data, predicate, ranges_identity);
}

/// @brief Partition a mutable list by projected keys in place.
/// Returns the first nonmatch; order within each group is unspecified.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn partition_in_place_projected(data: &mut list<T>, predicate: Predicate,
                                    projection: Projection) -> i64 {
    return ranges_partition_in_place_core(data, predicate, projection);
}

/// @brief Copy matching and nonmatching elements into separate stable lists.
/// Each element's predicate is evaluated exactly once; the source is unchanged.
/// C++20 `std::ranges::partition_copy` equivalent.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn partition_copy(data: &list<T>, predicate: Predicate)
    -> tuple<list<T>, list<T>> {
    var matching: list<T> = [];
    var nonmatching: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(data[i]) {
            matching.push(data[i]);
        } else {
            nonmatching.push(data[i]);
        }
    }
    return (matching, nonmatching);
}

/// @brief Copy matching and nonmatching elements using projected keys.
/// Each projection and predicate is evaluated once; both outputs are stable.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn partition_copy_projected(data: &list<T>, predicate: Predicate,
                                projection: Projection)
    -> tuple<list<T>, list<T>> {
    var matching: list<T> = [];
    var nonmatching: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(projection(data[i])) { matching.push(data[i]); }
        else { nonmatching.push(data[i]); }
    }
    return (matching, nonmatching);
}

/// @brief Partition into two bounded destinations.
/// Stops at the source end or as soon as either destination fills, so each
/// predicate is evaluated exactly once per consumed element. Returns
/// `(consumed, matching_written, nonmatching_written)`; list lengths are
/// unchanged. This is the bounded-output adaptation of C++20
/// `std::ranges::partition_copy`.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn partition_copy_to(source: &list<T>, matching: &mut list<T>,
                         nonmatching: &mut list<T>, predicate: Predicate)
    -> tuple<i64, i64, i64> {
    let source_len: i64 = source.len();
    let matching_capacity: i64 = matching.len();
    let nonmatching_capacity: i64 = nonmatching.len();
    var consumed: i64 = 0;
    var matching_written: i64 = 0;
    var nonmatching_written: i64 = 0;
    while consumed < source_len && matching_written < matching_capacity &&
          nonmatching_written < nonmatching_capacity {
        let value: T = source[consumed];
        if predicate(value) {
            matching[matching_written] = value;
            matching_written = matching_written + 1;
        } else {
            nonmatching[nonmatching_written] = value;
            nonmatching_written = nonmatching_written + 1;
        }
        consumed = consumed + 1;
    }
    return (consumed, matching_written, nonmatching_written);
}

/// @brief Partition projected values into two bounded destinations.
/// Stops when either destination fills and returns
/// `(consumed, matching_written, nonmatching_written)`. The projection and
/// predicate are each evaluated once per consumed element.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn partition_copy_to_projected(
    source: &list<T>, matching: &mut list<T>, nonmatching: &mut list<T>,
    predicate: Predicate, projection: Projection) -> tuple<i64, i64, i64> {
    let source_len: i64 = source.len();
    let matching_capacity: i64 = matching.len();
    let nonmatching_capacity: i64 = nonmatching.len();
    var consumed: i64 = 0;
    var matching_written: i64 = 0;
    var nonmatching_written: i64 = 0;
    while consumed < source_len && matching_written < matching_capacity &&
          nonmatching_written < nonmatching_capacity {
        let value: T = source[consumed];
        if predicate(projection(value)) {
            matching[matching_written] = value;
            matching_written = matching_written + 1;
        } else {
            nonmatching[nonmatching_written] = value;
            nonmatching_written = nonmatching_written + 1;
        }
        consumed = consumed + 1;
    }
    return (consumed, matching_written, nonmatching_written);
}

/// @brief Partition into bounded destinations with independent element types.
/// Matching and nonmatching source values are converted to their respective
/// destination element types. Stops when either destination fills and returns
/// `(consumed, matching_written, nonmatching_written)`.
/// @ingroup algorithm_ranges
generic<T, Matching, Nonmatching, Predicate>
pub fn partition_copy_to_heterogeneous(
    source: &list<T>, matching: &mut list<Matching>,
    nonmatching: &mut list<Nonmatching>, predicate: Predicate)
    -> tuple<i64, i64, i64> {
    let source_len: i64 = source.len();
    let matching_capacity: i64 = matching.len();
    let nonmatching_capacity: i64 = nonmatching.len();
    var consumed: i64 = 0;
    var matching_written: i64 = 0;
    var nonmatching_written: i64 = 0;
    while consumed < source_len && matching_written < matching_capacity &&
          nonmatching_written < nonmatching_capacity {
        let value: T = source[consumed];
        if predicate(value) {
            matching[matching_written] = value;
            matching_written = matching_written + 1;
        } else {
            nonmatching[nonmatching_written] = value;
            nonmatching_written = nonmatching_written + 1;
        }
        consumed = consumed + 1;
    }
    return (consumed, matching_written, nonmatching_written);
}

/// @brief Projected bounded partition-copy with independently typed outputs.
/// The predicate receives the projected key; original source values are
/// converted to the corresponding destination element type. Stops when either
/// destination fills and returns `(consumed, matching_written,
/// nonmatching_written)`.
/// @ingroup algorithm_ranges
generic<T, Matching, Nonmatching, Predicate, Projection>
pub fn partition_copy_to_heterogeneous_projected(
    source: &list<T>, matching: &mut list<Matching>,
    nonmatching: &mut list<Nonmatching>, predicate: Predicate,
    projection: Projection) -> tuple<i64, i64, i64> {
    let source_len: i64 = source.len();
    let matching_capacity: i64 = matching.len();
    let nonmatching_capacity: i64 = nonmatching.len();
    var consumed: i64 = 0;
    var matching_written: i64 = 0;
    var nonmatching_written: i64 = 0;
    while consumed < source_len && matching_written < matching_capacity &&
          nonmatching_written < nonmatching_capacity {
        let value: T = source[consumed];
        if predicate(projection(value)) {
            matching[matching_written] = value;
            matching_written = matching_written + 1;
        } else {
            nonmatching[nonmatching_written] = value;
            nonmatching_written = nonmatching_written + 1;
        }
        consumed = consumed + 1;
    }
    return (consumed, matching_written, nonmatching_written);
}

/// @brief Return the first index rejected by `predicate`, or -1 if all match.
/// C++20 `std::ranges::find_if_not` semantics.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn find_if_not(data: &list<T>, predicate: Predicate) -> i64 {
    let n: i64 = data.len();
    for i in 0..n {
        if !predicate(data[i]) {
            return i;
        }
    }
    return -1;
}

/// @brief Find the first element rejected after projection, or -1.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn find_if_not_projected(data: &list<T>, predicate: Predicate,
                             projection: Projection) -> i64 {
    let n: i64 = data.len();
    for i in 0..n {
        if !predicate(projection(data[i])) { return i; }
    }
    return -1;
}

/// @brief Return the first predicate-rejected index as an option.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn find_if_not_option(data: &list<T>, predicate: Predicate)
    -> option<i64> {
    let index: i64 = find_if_not(data, predicate);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the first projected predicate-rejected index as an option.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn find_if_not_projected_option(data: &list<T>, predicate: Predicate,
                                    projection: Projection) -> option<i64> {
    let index: i64 = find_if_not_projected(data, predicate, projection);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the last index rejected by `predicate`, or -1.
/// C++23 `std::ranges::find_last_if_not` semantics.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn find_last_if_not(data: &list<T>, predicate: Predicate) -> i64 {
    var i: i64 = data.len();
    while i > 0 {
        i = i - 1;
        if !predicate(data[i]) {
            return i;
        }
    }
    return -1;
}

/// @brief Find the last element rejected after projection, or -1.
/// C++23 `std::ranges::find_last_if_not` projection form.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn find_last_if_not_projected(data: &list<T>, predicate: Predicate,
                                  projection: Projection) -> i64 {
    var i: i64 = data.len();
    while i > 0 {
        i = i - 1;
        if !predicate(projection(data[i])) { return i; }
    }
    return -1;
}

/// @brief Return a compacted copy without elements accepted by `predicate`.
/// This eager form leaves the input range unchanged.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn remove_if(data: &list<T>, predicate: Predicate) -> list<T> {
    var kept: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if !predicate(data[i]) {
            kept.push(data[i]);
        }
    }
    return kept;
}

/// @brief Copy elements rejected by a predicate over projected keys.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn remove_if_projected(data: &list<T>, predicate: Predicate,
                           projection: Projection) -> list<T> {
    var kept: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if !predicate(projection(data[i])) { kept.push(data[i]); }
    }
    return kept;
}

/// @brief Copy elements accepted by `predicate` into a new list.
/// C++20 `std::ranges::copy_if` counterpart for eager Mlang lists.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn copy_if(data: &list<T>, predicate: Predicate) -> list<T> {
    var copied: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(data[i]) {
            copied.push(data[i]);
        }
    }
    return copied;
}

/// @brief Copy elements rejected by a predicate over projected keys.
/// C++20 `std::ranges::remove_copy_if` projection form.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn remove_copy_if_projected(data: &list<T>, predicate: Predicate,
                                projection: Projection) -> list<T> {
    var copied: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if !predicate(projection(data[i])) { copied.push(data[i]); }
    }
    return copied;
}

/// @brief Sample up to `count` distinct elements in their original order.
/// `choose_index(upper_bound)` must return an index in
/// `[0, upper_bound)`. This eager C++20 `std::ranges::sample` counterpart lets
/// callers supply their own random engine and leaves the input unchanged.
/// @ingroup algorithm_ranges
generic<T, ChooseIndex>
pub fn sample(data: &list<T>, count: i64, choose_index: ChooseIndex) -> list<T> {
    var sampled: list<T> = [];
    let n: i64 = data.len();
    var sample_count: i64 = count;
    if sample_count < 0 {
        sample_count = 0;
    }
    if sample_count > n {
        sample_count = n;
    }

    // Sequential selection chooses each candidate with probability
    // remaining_needed / remaining_items, and stops drawing once all remaining
    // candidates must be selected. This samples uniformly without replacement.
    for i in 0..n {
        let needed: i64 = sample_count - sampled.len();
        let remaining_items: i64 = n - i;
        if needed >= remaining_items {
            sampled.push(data[i]);
        } else if needed > 0 {
            let requested_index: i64 = choose_index(remaining_items);
            let selected_index: i64 = requested_index < 0 ? 0 :
                (requested_index >= remaining_items ?
                    remaining_items - 1 : requested_index);
            if selected_index < needed {
                sampled.push(data[i]);
            }
        }
    }
    return sampled;
}

/// @brief Sample into a caller-provided bounded destination.
/// Selects at most `count` values, the destination capacity, and the source
/// length; returns the number written. The source and unwritten destination
/// suffix remain unchanged.
/// @ingroup algorithm_ranges
generic<T, ChooseIndex>
pub fn sample_to(source: &list<T>, destination: &mut list<T>, count: i64,
                 choose_index: ChooseIndex) -> i64 {
    let capacity: i64 = destination.len();
    let mut_count: i64 = count < capacity ? count : capacity;
    let sampled: list<T> = sample(source, mut_count, choose_index);
    let written: i64 = sampled.len();
    for i in 0..written { destination[i] = sampled[i]; }
    return written;
}

/// @brief Sample into a bounded destination with a distinct element type.
/// Selects at most `count`, destination capacity, and source length; original
/// values are converted when written. Returns the number written and preserves
/// both source and unwritten destination elements.
/// @ingroup algorithm_ranges
generic<T, Output, ChooseIndex>
pub fn sample_to_heterogeneous(source: &list<T>,
    destination: &mut list<Output>, count: i64,
    choose_index: ChooseIndex) -> i64 {
    let capacity: i64 = destination.len();
    let sample_count: i64 = count < capacity ? count : capacity;
    let sampled: list<T> = sample(source, sample_count, choose_index);
    let written: i64 = sampled.len();
    for i in 0..written { destination[i] = sampled[i]; }
    return written;
}

/// @brief Sample projected values directly into bounded output storage.
/// Selects distinct source elements in original order without materializing a
/// sampled or projected intermediate list.
/// @ingroup algorithm_ranges
generic<T, Output, ChooseIndex, Projection>
pub fn sample_to_projected(source: &list<T>,
    destination: &mut list<Output>, count: i64,
    choose_index: ChooseIndex, projection: Projection) -> i64 {
    let source_len: i64 = source.len();
    let capacity: i64 = destination.len();
    var target: i64 = count;
    if target < 0 { target = 0; }
    if target > capacity { target = capacity; }
    if target > source_len { target = source_len; }

    var written: i64 = 0;
    for i in 0..source_len {
        let needed: i64 = target - written;
        let remaining_items: i64 = source_len - i;
        if needed >= remaining_items {
            destination[written] = projection(source[i]);
            written = written + 1;
        } else if needed > 0 {
            let requested_index: i64 = choose_index(remaining_items);
            let selected_index: i64 = requested_index < 0 ? 0 :
                (requested_index >= remaining_items ?
                    remaining_items - 1 : requested_index);
            if selected_index < needed {
                destination[written] = projection(source[i]);
                written = written + 1;
            }
        }
    }
    return written;
}

/// @brief Sample projected values into a distinct bounded output type.
/// Selects distinct source elements in original order, projects each selected
/// value directly into caller-owned storage, and returns the number written.
/// @ingroup algorithm_ranges
generic<T, Output, ChooseIndex, Projection>
pub fn sample_to_heterogeneous_projected(
    source: &list<T>, destination: &mut list<Output>, count: i64,
    choose_index: ChooseIndex, projection: Projection) -> i64 {
    return sample_to_projected(source, destination, count, choose_index,
                               projection);
}

/// @brief Return a shuffled copy using a bounded random-index selector.
/// `choose_index(upper_bound)` must return an index in
/// `[0, upper_bound)`. The eager implementation leaves the source unchanged;
/// removing selected elements from the remaining list makes this O(N^2).
/// @ingroup algorithm_ranges
generic<T, ChooseIndex>
pub fn shuffle(data: &list<T>, choose_index: ChooseIndex) -> list<T> {
    var shuffled: list<T> = [];
    var remaining: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        remaining.push(data[i]);
    }

    while remaining.len() > 0 {
        let bound: i64 = remaining.len();
        var selected_index: i64 = choose_index(bound);
        if selected_index < 0 {
            selected_index = 0;
        }
        if selected_index >= bound {
            selected_index = bound - 1;
        }
        shuffled.push(remaining[selected_index]);

        var next_remaining: list<T> = [];
        for i in 0..bound {
            if i != selected_index {
                next_remaining.push(remaining[i]);
            }
        }
        remaining = next_remaining;
    }
    return shuffled;
}

/// @brief Shuffle a mutable list in place using Fisher-Yates.
/// `choose_index(upper_bound)` must return an index in `[0, upper_bound)`;
/// out-of-range results are clamped. Returns the number of swaps performed.
/// Lists shorter than two elements do not invoke the selector. This is the
/// eager-list counterpart to C++20 `std::ranges::shuffle`.
/// @ingroup algorithm_ranges
generic<T, ChooseIndex>
pub fn shuffle_in_place(data: &mut list<T>, choose_index: ChooseIndex) -> i64 {
    let n: i64 = data.len();
    var i: i64 = n - 1;
    var swaps: i64 = 0;
    while i > 0 {
        let bound: i64 = i + 1;
        var selected: i64 = choose_index(bound);
        if selected < 0 { selected = 0; }
        if selected >= bound { selected = bound - 1; }
        if selected != i {
            let temporary: T = data[i];
            data[i] = data[selected];
            data[selected] = temporary;
            swaps = swaps + 1;
        }
        i = i - 1;
    }
    return swaps;
}

/// @brief Copy elements unequal to `value` into a new list.
/// C++20 `std::ranges::remove_copy` counterpart; the input is unchanged.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn remove_copy(data: &list<T>, value: U) -> list<T> {
    var copied: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if data[i] != value {
            copied.push(data[i]);
        }
    }
    return copied;
}

/// @brief Copy elements not equivalent to `value` into a new list.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn remove_copy_by(data: &list<T>, value: U,
                      equivalent: Equivalent) -> list<T> {
    return remove_by(data, value, equivalent);
}

/// @brief Copy elements whose projected keys are not equivalent to `value`.
/// The predicate receives the projected element key followed by the lookup key.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, Projection>
pub fn remove_copy_by_projected(data: &list<T>, value: U,
                                equivalent: Equivalent,
                                projection: Projection) -> list<T> {
    return remove_by_projected(data, value, equivalent, projection);
}

/// @brief Copy elements whose projected key differs from `value`.
/// C++20 `std::ranges::remove_copy` projection form; the input is unchanged.
/// @ingroup algorithm_ranges
generic<T, U, Projection>
pub fn remove_copy_projected(data: &list<T>, value: U,
                             projection: Projection) -> list<T> {
    var copied: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if projection(data[i]) != value { copied.push(data[i]); }
    }
    return copied;
}

/// @brief Copy nonmatching elements into a bounded destination list.
/// Stops when the source ends or the destination fills, returning
/// `(consumed, written)` so bounded progress is explicit.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn remove_copy_to(source: &list<T>, destination: &mut list<T>,
                      value: U) -> tuple<i64, i64> {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var consumed: i64 = 0;
    var written: i64 = 0;
    while consumed < source_len && written < destination_len {
        let item: T = source[consumed];
        if item != value {
            destination[written] = item;
            written = written + 1;
        }
        consumed = consumed + 1;
    }
    return (consumed, written);
}

/// @brief Copy nonmatching values to a bounded, distinct-type destination.
/// Source values are converted to the destination element type. Returns
/// `(consumed, written)` and stops when the source ends or output fills.
/// @ingroup algorithm_ranges
generic<T, Output, U>
pub fn remove_copy_to_heterogeneous(source: &list<T>,
    destination: &mut list<Output>, value: U) -> tuple<i64, i64> {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var consumed: i64 = 0;
    var written: i64 = 0;
    while consumed < source_len && written < destination_len {
        let item: T = source[consumed];
        if item != value {
            destination[written] = item;
            written = written + 1;
        }
        consumed = consumed + 1;
    }
    return (consumed, written);
}

/// @brief Copy values not equivalent to `value` into distinct-type output.
/// The equivalence predicate operates on source values; retained values are
/// converted to the output type. Returns `(consumed, written)`.
/// @ingroup algorithm_ranges
generic<T, Output, U, Equivalent>
pub fn remove_copy_to_heterogeneous_by(source: &list<T>,
    destination: &mut list<Output>, value: U, equivalent: Equivalent)
    -> tuple<i64, i64> {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var consumed: i64 = 0;
    var written: i64 = 0;
    while consumed < source_len && written < destination_len {
        let item: T = source[consumed];
        if !equivalent(item, value) {
            destination[written] = item;
            written = written + 1;
        }
        consumed = consumed + 1;
    }
    return (consumed, written);
}

/// @brief Copy nonmatching elements using a custom equivalence predicate.
/// Returns `(consumed, written)` and stops when the destination fills.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn remove_copy_to_by(source: &list<T>, destination: &mut list<T>,
                         value: U, equivalent: Equivalent)
    -> tuple<i64, i64> {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var consumed: i64 = 0;
    var written: i64 = 0;
    while consumed < source_len && written < destination_len {
        let item: T = source[consumed];
        if !equivalent(item, value) {
            destination[written] = item;
            written = written + 1;
        }
        consumed = consumed + 1;
    }
    return (consumed, written);
}

/// @brief Copy nonmatching elements using equality on projected keys.
/// Returns `(consumed, written)` and stops when the destination fills.
/// @ingroup algorithm_ranges
generic<T, U, Projection>
pub fn remove_copy_to_projected(
    source: &list<T>, destination: &mut list<T>, value: U,
    projection: Projection) -> tuple<i64, i64> {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var consumed: i64 = 0;
    var written: i64 = 0;
    while consumed < source_len && written < destination_len {
        let item: T = source[consumed];
        if projection(item) != value {
            destination[written] = item;
            written = written + 1;
        }
        consumed = consumed + 1;
    }
    return (consumed, written);
}

/// @brief Filter by a projected key into a distinct-type bounded output.
/// Original nonmatching source values are converted to the output type.
/// Returns `(consumed, written)`.
/// @ingroup algorithm_ranges
generic<T, Output, U, Projection>
pub fn remove_copy_to_heterogeneous_projected(
    source: &list<T>, destination: &mut list<Output>, value: U,
    projection: Projection) -> tuple<i64, i64> {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var consumed: i64 = 0;
    var written: i64 = 0;
    while consumed < source_len && written < destination_len {
        let item: T = source[consumed];
        if projection(item) != value {
            destination[written] = item;
            written = written + 1;
        }
        consumed = consumed + 1;
    }
    return (consumed, written);
}

/// @brief Remove-copy with custom equivalence over projected keys.
/// Nonmatching original source values are converted to the distinct output
/// type; returns `(consumed, written)`.
/// @ingroup algorithm_ranges
generic<T, Output, U, Equivalent, Projection>
pub fn remove_copy_to_heterogeneous_by_projected(
    source: &list<T>, destination: &mut list<Output>, value: U,
    equivalent: Equivalent, projection: Projection) -> tuple<i64, i64> {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var consumed: i64 = 0;
    var written: i64 = 0;
    while consumed < source_len && written < destination_len {
        let item: T = source[consumed];
        if !equivalent(projection(item), value) {
            destination[written] = item;
            written = written + 1;
        }
        consumed = consumed + 1;
    }
    return (consumed, written);
}

/// @brief Copy nonmatches by a predicate over projected keys.
/// Returns `(consumed, written)` and stops when the destination fills.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, Projection>
pub fn remove_copy_to_by_projected(
    source: &list<T>, destination: &mut list<T>, value: U,
    equivalent: Equivalent, projection: Projection) -> tuple<i64, i64> {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var consumed: i64 = 0;
    var written: i64 = 0;
    while consumed < source_len && written < destination_len {
        let item: T = source[consumed];
        if !equivalent(projection(item), value) {
            destination[written] = item;
            written = written + 1;
        }
        consumed = consumed + 1;
    }
    return (consumed, written);
}

/// @brief Copy elements rejected by `predicate` into a new list.
/// C++20 `std::ranges::remove_copy_if` counterpart; the input is unchanged.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn remove_copy_if(data: &list<T>, predicate: Predicate) -> list<T> {
    var copied: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if !predicate(data[i]) {
            copied.push(data[i]);
        }
    }
    return copied;
}

/// @brief Copy predicate-rejected elements into bounded output storage.
/// Stops at the source end or when the destination fills and returns
/// `(consumed, written)`. The source and destination lengths are unchanged.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn remove_copy_if_to(source: &list<T>, destination: &mut list<T>,
                         predicate: Predicate) -> tuple<i64, i64> {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var consumed: i64 = 0;
    var written: i64 = 0;
    while consumed < source_len && written < destination_len {
        let item: T = source[consumed];
        if !predicate(item) {
            destination[written] = item;
            written = written + 1;
        }
        consumed = consumed + 1;
    }
    return (consumed, written);
}

