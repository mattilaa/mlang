/// @brief Copy a range while replacing each value equal to `old_value`.
/// C++20 `std::ranges::replace_copy` counterpart; the input is unchanged.
/// @ingroup algorithm_ranges
generic<T, U, V>
pub fn replace_copy(data: &list<T>, old_value: U, new_value: V) -> list<T> {
    var copied: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if data[i] == old_value {
            copied.push(new_value);
        } else {
            copied.push(data[i]);
        }
    }
    return copied;
}

/// @brief Replace values matching `old_value` under `equivalent` in a copy.
/// The input range is unchanged.
/// @ingroup algorithm_ranges
generic<T, U, V, Equivalent>
pub fn replace_copy_by(data: &list<T>, old_value: U, new_value: V,
                       equivalent: Equivalent) -> list<T> {
    var copied: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if equivalent(data[i], old_value) { copied.push(new_value); }
        else { copied.push(data[i]); }
    }
    return copied;
}

/// @brief Replace values whose projected key equals `old_value` in a copy.
/// C++20 `std::ranges::replace_copy` projection form; the input is unchanged.
/// @ingroup algorithm_ranges
generic<T, U, V, Projection>
pub fn replace_copy_projected(data: &list<T>, old_value: U, new_value: V,
                              projection: Projection) -> list<T> {
    var copied: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if projection(data[i]) == old_value {
            copied.push(new_value);
        } else {
            copied.push(data[i]);
        }
    }
    return copied;
}

/// @brief Replace values whose projected key matches under `equivalent`.
/// `old_key` is compared directly with each projected element key.
/// @ingroup algorithm_ranges
generic<T, U, V, Equivalent, Projection>
pub fn replace_copy_by_projected(data: &list<T>, old_key: U, new_value: V,
                                 equivalent: Equivalent,
                                 projection: Projection) -> list<T> {
    var copied: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if equivalent(projection(data[i]), old_key) { copied.push(new_value); }
        else { copied.push(data[i]); }
    }
    return copied;
}

/// @brief Replace matching source values into an existing destination list.
/// Stops at the shorter list, returns the number written, and preserves the
/// source and any unused destination tail.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn replace_copy_to(source: &list<T>, destination: &mut list<T>,
                       old_value: U, new_value: T) -> i64 {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var count: i64 = source_len;
    if destination_len < count { count = destination_len; }
    for i in 0..count {
        if source[i] == old_value { destination[i] = new_value; }
        else { destination[i] = source[i]; }
    }
    return count;
}

/// @brief Replace-copy to bounded storage with a different output type.
/// Both original values and `new_value` are converted to the destination type.
/// Returns the source/destination prefix length written.
/// @ingroup algorithm_ranges
generic<T, Output, U>
pub fn replace_copy_to_heterogeneous(source: &list<T>,
    destination: &mut list<Output>, old_value: U, new_value: Output) -> i64 {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    let count: i64 = source_len < destination_len ? source_len : destination_len;
    for i in 0..count {
        if source[i] == old_value { destination[i] = new_value; }
        else { destination[i] = source[i]; }
    }
    return count;
}

/// @brief Comparator form of heterogeneous bounded replace-copy.
/// @ingroup algorithm_ranges
generic<T, Output, U, Equivalent>
pub fn replace_copy_to_heterogeneous_by(source: &list<T>,
    destination: &mut list<Output>, old_value: U, new_value: Output,
    equivalent: Equivalent) -> i64 {
    let source_len: i64 = source.len();
