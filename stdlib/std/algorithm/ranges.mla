/// @brief Write adjacent pairs into preallocated tuple output.
/// Returns the number of complete windows written and preserves the unused
/// destination suffix.
/// @ingroup algorithm_ranges
generic<T>
pub fn pairwise_to(data: &list<T>,
                   destination: &mut list<tuple<T, T>>) -> i64 {
    let n: i64 = data.len();
    let capacity: i64 = destination.len();
    var count: i64 = n >= 2 ? n - 1 : 0;
    if capacity < count { count = capacity; }
    for i in 0..count { destination[i] = (data[i], data[i + 1]); }
    return count;
}

/// @brief Write adjacent triples into preallocated tuple output.
/// @ingroup algorithm_ranges
generic<T>
pub fn adjacent3_to(data: &list<T>,
                    destination: &mut list<tuple<T, T, T>>) -> i64 {
    let n: i64 = data.len();
