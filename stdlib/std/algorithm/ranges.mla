    for i in 0..count {
        if predicate(projection(source[i])) { destination[i] = new_value; }
        else { destination[i] = source[i]; }
    }
    return count;
}

/// @brief Projected predicate replacement into distinct-type bounded output.
/// Projection and predicate test original values; both selected replacements
/// and retained elements are converted to the destination type.
/// @ingroup algorithm_ranges
generic<T, Output, Predicate, Projection>
pub fn replace_copy_if_to_heterogeneous_projected(
    source: &list<T>, destination: &mut list<Output>, predicate: Predicate,
    new_value: Output, projection: Projection) -> i64 {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    let count: i64 = source_len < destination_len ? source_len : destination_len;
    for i in 0..count {
        if predicate(projection(source[i])) { destination[i] = new_value; }
        else { destination[i] = source[i]; }
    }
    return count;
}

/// @brief Replace each element accepted by `predicate` in a copied range.
/// The original range is unchanged.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn replace_if(data: &list<T>, predicate: Predicate, replacement: T) -> list<T> {
    var replaced: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(data[i]) {
            replaced.push(replacement);
        } else {
            replaced.push(data[i]);
        }
    }
    return replaced;
}

/// @brief Replace each value equivalent to `old_value` in a mutable list.
/// Returns the number of elements replaced.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn replace_in_place(data: &mut list<T>, old_value: U,
                        replacement: T) -> i64 {
    var replaced: i64 = 0;
    let n: i64 = data.len();
    for i in 0..n {
        if data[i] == old_value {
            data[i] = replacement;
            replaced = replaced + 1;
        }
    }
    return replaced;
}

/// @brief Replace predicate-matching values in a mutable list.
/// Returns the number of elements replaced.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn replace_if_in_place(data: &mut list<T>, predicate: Predicate,
                           replacement: T) -> i64 {
    var replaced: i64 = 0;
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(data[i]) {
            data[i] = replacement;
            replaced = replaced + 1;
        }
    }
    return replaced;
}

/// @brief Replace matching projected-key values in a copied list.
/// The original range is unchanged.
/// @ingroup algorithm_ranges
generic<T, Predicate, V, Projection>
pub fn replace_if_projected(data: &list<T>, predicate: Predicate,
                            replacement: V, projection: Projection)
    -> list<T> {
    var replaced: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(projection(data[i])) { replaced.push(replacement); }
        else { replaced.push(data[i]); }
    }
    return replaced;
}

/// @brief Remove adjacent elements equivalent under `equivalent`.
/// The first element in each adjacent run is preserved.
/// @ingroup algorithm_ranges
generic<T, Equivalent>
pub fn unique_by(data: &list<T>, equivalent: Equivalent) -> list<T> {
    let n: i64 = data.len();
    if n == 0 {
        return [];
    }
    var unique_values: list<T> = [];
    var previous: T = data[0];
    unique_values.push(previous);
    for i in 1..n {
        if !equivalent(previous, data[i]) {
            previous = data[i];
            unique_values.push(previous);
        }
    }
    return unique_values;
}

/// @brief Remove adjacent values whose projected keys are equal.
/// The first original value in each adjacent key run is preserved.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn unique_projected(data: &list<T>, projection: Projection) -> list<T> {
    let n: i64 = data.len();
    if n == 0 {
        return [];
    }
    var unique_values: list<T> = [];
    var previous_key = projection(data[0]);
    unique_values.push(data[0]);
    for i in 1..n {
        let current_key = projection(data[i]);
        if current_key != previous_key {
            unique_values.push(data[i]);
            previous_key = current_key;
        }
    }
    return unique_values;
}

/// @brief Remove adjacent values equivalent under projected keys.
/// The first original value in each adjacent equivalence run is preserved.
/// @ingroup algorithm_ranges
generic<T, Equivalent, Projection>
pub fn unique_by_projected(data: &list<T>, equivalent: Equivalent,
                           projection: Projection) -> list<T> {
    let n: i64 = data.len();
    if n == 0 { return []; }
    var unique_values: list<T> = [];
    var previous_key = projection(data[0]);
    unique_values.push(data[0]);
    for i in 1..n {
        let current_key = projection(data[i]);
        if !equivalent(previous_key, current_key) {
            unique_values.push(data[i]);
            previous_key = current_key;
        }
    }
    return unique_values;
}

/// @brief Compact adjacent duplicate values in a mutable list.
/// Returns the logical end; the suffix is unspecified and list length is
/// unchanged. Retained values remain in their original order.
/// @ingroup algorithm_ranges
generic<T>
pub fn unique_in_place(data: &mut list<T>) -> i64 {
    let n: i64 = data.len();
    if n == 0 { return 0; }
    var output: i64 = 1;
    var previous: T = data[0];
    for input in 1..n {
        let item: T = data[input];
        if item != previous {
            if output != input { data[output] = item; }
            output = output + 1;
            previous = item;
        }
    }
    return output;
}

/// @brief Compact adjacent equivalent values in a mutable list.
/// The first value in each run is retained; returns the logical end index.
/// @ingroup algorithm_ranges
generic<T, Equivalent>
pub fn unique_by_in_place(data: &mut list<T>, equivalent: Equivalent) -> i64 {
    let n: i64 = data.len();
    if n == 0 { return 0; }
    var output: i64 = 1;
    var previous: T = data[0];
    for input in 1..n {
        let item: T = data[input];
        if !equivalent(previous, item) {
            if output != input { data[output] = item; }
            output = output + 1;
            previous = item;
        }
    }
    return output;
}

/// @brief Compact adjacent runs with equal projected keys in place.
/// Returns the logical end index; list length is unchanged.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn unique_in_place_projected(data: &mut list<T>,
                                 projection: Projection) -> i64 {
    let n: i64 = data.len();
    if n == 0 { return 0; }
    var output: i64 = 1;
    var previous_key = projection(data[0]);
    for input in 1..n {
        let item: T = data[input];
        let current_key = projection(item);
        if current_key != previous_key {
            if output != input { data[output] = item; }
            output = output + 1;
            previous_key = current_key;
        }
    }
    return output;
}

/// @brief Compact adjacent equivalence classes of projected keys in place.
/// Returns the logical end index and retains the first value in each run.
/// @ingroup algorithm_ranges
generic<T, Equivalent, Projection>
pub fn unique_by_in_place_projected(data: &mut list<T>,
    equivalent: Equivalent, projection: Projection) -> i64 {
    let n: i64 = data.len();
    if n == 0 { return 0; }
    var output: i64 = 1;
    var previous_key = projection(data[0]);
    for input in 1..n {
        let item: T = data[input];
        let current_key = projection(item);
        if !equivalent(previous_key, current_key) {
            if output != input { data[output] = item; }
            output = output + 1;
            previous_key = current_key;
        }
    }
    return output;
}

/// @brief Copy one value from each adjacent equivalence class.
/// C++20 `std::ranges::unique_copy` counterpart; the source is unchanged.
/// @ingroup algorithm_ranges
generic<T, Equivalent>
pub fn unique_copy_by(data: &list<T>, equivalent: Equivalent) -> list<T> {
    return unique_by(data, equivalent);
}

/// @brief Copy one value from each adjacent projected-key run.
/// The first original value in each run is retained; the source is unchanged.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn unique_copy_projected(data: &list<T>, projection: Projection) -> list<T> {
    return unique_projected(data, projection);
}

/// @brief Copy one value from each adjacent projected equivalence class.
/// The first original value in each run is retained; the source is unchanged.
/// @ingroup algorithm_ranges
generic<T, Equivalent, Projection>
pub fn unique_copy_by_projected(data: &list<T>, equivalent: Equivalent,
                                projection: Projection) -> list<T> {
    return unique_by_projected(data, equivalent, projection);
}

generic<T>
fn ranges_default_equal(left: T, right: T) -> bool {
    return left == right;
}

generic<T, Equivalent, Projection>
fn ranges_unique_copy_to_core(source: &list<T>,
                              destination: &mut list<Output>,
                              equivalent: Equivalent,
                              projection: Projection)
    -> tuple<i64, i64> {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    if source_len == 0 || destination_len == 0 { return (0, 0); }
    var consumed: i64 = 1;
    var written: i64 = 1;
    destination[0] = source[0];
    var previous_key = projection(source[0]);
    while consumed < source_len && written < destination_len {
        let item: T = source[consumed];
        let current_key = projection(item);
        if !equivalent(previous_key, current_key) {
            destination[written] = item;
            written = written + 1;
            previous_key = current_key;
        }
        consumed = consumed + 1;
    }
    return (consumed, written);
}

/// @brief Copy one value per adjacent equal run into bounded storage.
/// Returns `(consumed, written)` and stops at the source end or when the
/// destination fills. The first value in each run is kept.
/// @ingroup algorithm_ranges
generic<T>
pub fn unique_copy_to(source: &list<T>, destination: &mut list<T>)
    -> tuple<i64, i64> {
    return ranges_unique_copy_to_core(source, destination,
                                      ranges_default_equal,
                                      ranges_identity);
}

/// @brief Copy one value per adjacent equivalence run into bounded storage.
/// @ingroup algorithm_ranges
generic<T, Equivalent>
pub fn unique_copy_to_by(source: &list<T>, destination: &mut list<T>,
                         equivalent: Equivalent) -> tuple<i64, i64> {
    return ranges_unique_copy_to_core(source, destination, equivalent,
                                      ranges_identity);
}

/// @brief Copy first values from projected-key runs into bounded storage.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn unique_copy_to_projected(source: &list<T>,
                                destination: &mut list<T>,
                                projection: Projection)
    -> tuple<i64, i64> {
    return ranges_unique_copy_to_core(source, destination,
                                      ranges_default_equal, projection);
}

/// @brief Copy first values from projected equivalence runs into bounded output.
/// @ingroup algorithm_ranges
generic<T, Equivalent, Projection>
pub fn unique_copy_to_by_projected(source: &list<T>,
                                   destination: &mut list<T>,
                                   equivalent: Equivalent,
                                   projection: Projection)
    -> tuple<i64, i64> {
    return ranges_unique_copy_to_core(source, destination,
                                      equivalent, projection);
}

/// @brief Copy unique adjacent values into a distinct-type bounded output.
/// Original source values are converted to the destination element type.
/// Returns `(consumed, written)`.
/// @ingroup algorithm_ranges
generic<T, Output>
pub fn unique_copy_to_heterogeneous(source: &list<T>,
    destination: &mut list<Output>) -> tuple<i64, i64> {
    return ranges_unique_copy_to_core(source, destination,
                                      ranges_default_equal,
                                      ranges_identity);
}

/// @brief Copy adjacent equivalence-class representatives to distinct output.
/// The caller comparator is evaluated on source values; retained representatives
/// are converted to the bounded destination type.
/// @ingroup algorithm_ranges
generic<T, Output, Equivalent>
pub fn unique_copy_to_heterogeneous_by(source: &list<T>,
    destination: &mut list<Output>, equivalent: Equivalent)
    -> tuple<i64, i64> {
    return ranges_unique_copy_to_core(source, destination, equivalent,
                                      ranges_identity);
}

/// @brief Copy first values from projected-key runs to distinct output type.
/// Projection compares source values, while selected original values are
/// converted to the destination element type.
/// @ingroup algorithm_ranges
generic<T, Output, Projection>
pub fn unique_copy_to_heterogeneous_projected(source: &list<T>,
    destination: &mut list<Output>, projection: Projection)
    -> tuple<i64, i64> {
    return ranges_unique_copy_to_core(source, destination,
                                      ranges_default_equal, projection);
}

/// @brief Copy projected equivalence-class representatives to distinct output.
/// @ingroup algorithm_ranges
generic<T, Output, Equivalent, Projection>
pub fn unique_copy_to_heterogeneous_by_projected(source: &list<T>,
    destination: &mut list<Output>, equivalent: Equivalent,
    projection: Projection) -> tuple<i64, i64> {
    return ranges_unique_copy_to_core(source, destination,
                                      equivalent, projection);
}


/// @brief Return whether two lists contain the same elements in order.
/// The ranges may have different, equality-comparable element types.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn equal(left: &list<T>, right: &list<U>) -> bool {
    let n: i64 = left.len();
    if n != right.len() {
        return false;
    }
    for i in 0..n {
        if left[i] != right[i] {
            return false;
        }
    }
    return true;
}

/// @brief Compare ranges for equality after applying a projection to each.
/// The two projections may return distinct equality-comparable types.
/// @ingroup algorithm_ranges
generic<T, U, LeftProjection, RightProjection>
pub fn equal_projected(left: &list<T>, right: &list<U>,
                       left_projection: LeftProjection,
                       right_projection: RightProjection) -> bool {
    let n: i64 = left.len();
    if n != right.len() {
        return false;
    }
    for i in 0..n {
        if left_projection(left[i]) != right_projection(right[i]) {
            return false;
        }
    }
    return true;
}

/// @brief Return indices of the first unequal elements in two ranges.
/// Comparison stops when either range ends; equal prefixes return the shared
/// prefix length for both indices, matching C++20 `std::ranges::mismatch`.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn mismatch(left: &list<T>, right: &list<U>) -> tuple<i64, i64> {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var n: i64 = left_len;
    if right_len < n {
        n = right_len;
    }
    for i in 0..n {
        if left[i] != right[i] {
            return (i, i);
        }
    }
    return (n, n);
}

/// @brief Find the first mismatch between ranges after projecting each value.
/// Stops at the shorter range; an equal prefix returns its shared length.
/// @ingroup algorithm_ranges
generic<T, U, LeftProjection, RightProjection>
pub fn mismatch_projected(left: &list<T>, right: &list<U>,
                          left_projection: LeftProjection,
                          right_projection: RightProjection)
    -> tuple<i64, i64> {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var n: i64 = left_len;
    if right_len < n { n = right_len; }
    for i in 0..n {
        if left_projection(left[i]) != right_projection(right[i]) {
            return (i, i);
        }
    }
    return (n, n);
}

/// @brief Find the first pair rejected by `equivalent`, stopping at either end.
/// Equal prefixes return their shared length for both indices.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn mismatch_by(left: &list<T>, right: &list<U>, equivalent: Equivalent)
    -> tuple<i64, i64> {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var n: i64 = left_len;
    if right_len < n {
        n = right_len;
    }
    for i in 0..n {
        if !equivalent(left[i], right[i]) {
            return (i, i);
        }
    }
    return (n, n);
}

/// @brief Find the first mismatch after projecting both ranges and comparing
/// projected values with `equivalent`. Stops at the shorter input.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, LeftProjection, RightProjection>
pub fn mismatch_by_projected(
    left: &list<T>, right: &list<U>, equivalent: Equivalent,
    left_projection: LeftProjection, right_projection: RightProjection)
    -> tuple<i64, i64> {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var n: i64 = left_len;
    if right_len < n { n = right_len; }
    for i in 0..n {
        if !equivalent(left_projection(left[i]),
                       right_projection(right[i])) {
            return (i, i);
        }
    }
    return (n, n);
}

/// @brief Compare corresponding elements with a caller-supplied equivalence.
/// The ranges are equal only when they have the same length and every pair
/// satisfies `equivalent(left[i], right[i])`.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn equal_by(left: &list<T>, right: &list<U>, equivalent: Equivalent)
    -> bool {
    let n: i64 = left.len();
    if n != right.len() {
        return false;
    }
    for i in 0..n {
        if !equivalent(left[i], right[i]) {
            return false;
        }
    }
    return true;
}

/// @brief Compare projected ranges elementwise with an equivalence predicate.
/// The ranges must have equal lengths.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, LeftProjection, RightProjection>
pub fn equal_by_projected(
    left: &list<T>, right: &list<U>, equivalent: Equivalent,
    left_projection: LeftProjection, right_projection: RightProjection)
    -> bool {
    let n: i64 = left.len();
    if n != right.len() { return false; }
    for i in 0..n {
        if !equivalent(left_projection(left[i]),
                       right_projection(right[i])) {
            return false;
        }
    }
    return true;
}

/// @brief Return whether two lists contain the same multiset of values.
/// Duplicate multiplicities matter; element order does not.
/// C++20 ranges-style permutation comparison.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn is_permutation(left: &list<T>, right: &list<U>) -> bool {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    if left_len != right_len {
        return false;
    }
    for i in 0..left_len {
        let value: T = left[i];
        var left_count: i64 = 0;
        var right_count: i64 = 0;
        for j in 0..left_len {
            if left[j] == value {
                left_count = left_count + 1;
            }
        }
        for j in 0..right_len {
            if right[j] == value {
                right_count = right_count + 1;
            }
        }
        if left_count != right_count {
            return false;
        }
    }
    return true;
}

/// @brief Compare two lists as multisets using `equivalent` for values.
/// Duplicate multiplicities matter; element order does not.
/// @ingroup algorithm_ranges
generic<T, Equivalent>
pub fn is_permutation_by(left: &list<T>, right: &list<T>,
                         equivalent: Equivalent) -> bool {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    if left_len != right_len {
        return false;
    }
    for i in 0..left_len {
        var left_count: i64 = 0;
        var right_count: i64 = 0;
        for j in 0..left_len {
            if equivalent(left[i], left[j]) {
                left_count = left_count + 1;
            }
        }
        for j in 0..right_len {
            if equivalent(left[i], right[j]) {
                right_count = right_count + 1;
            }
        }
        if left_count != right_count {
            return false;
        }
    }
    return true;
}

/// @brief Compare projected values as multisets, including duplicate counts.
/// The two projections may map different element types to a common comparable
/// key type.
/// @ingroup algorithm_ranges
generic<T, U, LeftProjection, RightProjection>
pub fn is_permutation_projected(left: &list<T>, right: &list<U>,
                                left_projection: LeftProjection,
                                right_projection: RightProjection) -> bool {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    if left_len != right_len { return false; }
    for i in 0..left_len {
        let key = left_projection(left[i]);
        var left_count: i64 = 0;
        var right_count: i64 = 0;
        for j in 0..left_len {
            if left_projection(left[j]) == key {
                left_count = left_count + 1;
            }
        }
        for j in 0..right_len {
            if right_projection(right[j]) == key {
                right_count = right_count + 1;
            }
        }
        if left_count != right_count { return false; }
    }
    return true;
}

/// @brief Compare projected multisets by a strict ordering's equivalence.
/// Duplicate multiplicities matter; the projections may accept different
/// element types but must produce keys accepted by the same comparator.
/// @ingroup algorithm_ranges
generic<T, U, Less, LeftProjection, RightProjection>
pub fn is_permutation_by_projected(
    left: &list<T>, right: &list<U>, less: Less,
    left_projection: LeftProjection, right_projection: RightProjection)
    -> bool {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    if left_len != right_len { return false; }
    for i in 0..left_len {
        let key = left_projection(left[i]);
        var left_count: i64 = 0;
        var right_count: i64 = 0;
        for j in 0..left_len {
            let candidate = left_projection(left[j]);
            if !less(key, candidate) && !less(candidate, key) {
                left_count = left_count + 1;
            }
        }
        for j in 0..right_len {
            let candidate = right_projection(right[j]);
            if !less(key, candidate) && !less(candidate, key) {
                right_count = right_count + 1;
            }
        }
        if left_count != right_count { return false; }
    }
    return true;
}

/// @brief Return whether `prefix` matches the beginning of `data`.
/// The two ranges may have different, equality-comparable element types.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn starts_with(data: &list<T>, prefix: &list<U>) -> bool {
    let prefix_len: i64 = prefix.len();
    if prefix_len > data.len() {
        return false;
    }
    for i in 0..prefix_len {
        if data[i] != prefix[i] {
            return false;
        }
    }
    return true;
}

/// @brief Check whether projected prefix keys match the range's initial keys.
/// @ingroup algorithm_ranges
generic<T, U, DataProjection, PrefixProjection>
pub fn starts_with_projected(data: &list<T>, prefix: &list<U>,
                             data_projection: DataProjection,
                             prefix_projection: PrefixProjection) -> bool {
    let prefix_len: i64 = prefix.len();
    if prefix_len > data.len() { return false; }
    for i in 0..prefix_len {
        if data_projection(data[i]) != prefix_projection(prefix[i]) {
            return false;
        }
    }
    return true;
}

/// @brief Return whether `prefix` matches the beginning of `data` using a
/// caller-provided binary predicate.
/// C++20 `std::ranges::starts_with` predicate overload.
/// @ingroup algorithm_ranges
generic<T, U, Predicate>
pub fn starts_with_by(data: &list<T>, prefix: &list<U>,
                      equivalent: Predicate) -> bool {
    let prefix_len: i64 = prefix.len();
    if prefix_len > data.len() {
        return false;
    }
    for i in 0..prefix_len {
        if !equivalent(data[i], prefix[i]) {
            return false;
        }
    }
    return true;
}

/// @brief Check a prefix using an equivalence predicate over projected values.
/// The two ranges may have different element types.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, DataProjection, PrefixProjection>
pub fn starts_with_by_projected(
    data: &list<T>, prefix: &list<U>, equivalent: Equivalent,
    data_projection: DataProjection, prefix_projection: PrefixProjection)
    -> bool {
    let prefix_len: i64 = prefix.len();
    if prefix_len > data.len() { return false; }
    for i in 0..prefix_len {
        if !equivalent(data_projection(data[i]),
                       prefix_projection(prefix[i])) {
            return false;
        }
    }
    return true;
}

/// @brief Find the first occurrence of a subsequence, returning its start index.
/// Returns 0 for an empty pattern and -1 when no match exists.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn search(data: &list<T>, pattern: &list<U>) -> i64 {
    let data_len: i64 = data.len();
    let pattern_len: i64 = pattern.len();
    if pattern_len == 0 {
        return 0;
    }
    if pattern_len > data_len {
        return -1;
    }
    let last_start: i64 = data_len - pattern_len;
    for start in 0..(last_start + 1) {
        var matched: bool = true;
        for offset in 0..pattern_len {
            if data[start + offset] != pattern[offset] {
                matched = false;
                break;
            }
        }
        if matched {
            return start;
        }
    }
    return -1;
}

/// @brief Find the first subrange matching after independent projections.
/// Returns 0 for an empty pattern and -1 when no match exists.
/// @ingroup algorithm_ranges
generic<T, U, DataProjection, PatternProjection>
pub fn search_projected(data: &list<T>, pattern: &list<U>,
                        data_projection: DataProjection,
                        pattern_projection: PatternProjection) -> i64 {
    let data_len: i64 = data.len();
    let pattern_len: i64 = pattern.len();
    if pattern_len == 0 { return 0; }
    if pattern_len > data_len { return -1; }
    let last_start: i64 = data_len - pattern_len;
    for start in 0..(last_start + 1) {
        var matched: bool = true;
        for offset in 0..pattern_len {
            if data_projection(data[start + offset]) !=
               pattern_projection(pattern[offset]) {
                matched = false;
                break;
            }
        }
        if matched { return start; }
    }
    return -1;
}

/// @brief Find the first subrange matching with a binary equivalence predicate.
/// Returns 0 for an empty pattern and -1 when no match exists.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn search_by(data: &list<T>, pattern: &list<U>,
                 equivalent: Equivalent) -> i64 {
    let data_len: i64 = data.len();
    let pattern_len: i64 = pattern.len();
    if pattern_len == 0 {
        return 0;
    }
    if pattern_len > data_len {
        return -1;
    }
    let last_start: i64 = data_len - pattern_len;
    for start in 0..(last_start + 1) {
        var matched: bool = true;
        for offset in 0..pattern_len {
            if !equivalent(data[start + offset], pattern[offset]) {
                matched = false;
                break;
            }
        }
        if matched {
            return start;
        }
    }
    return -1;
}

/// @brief Find the first projected subrange matching under `equivalent`.
/// The two ranges may have different element types; empty pattern returns 0.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, DataProjection, PatternProjection>
pub fn search_by_projected(
    data: &list<T>, pattern: &list<U>, equivalent: Equivalent,
    data_projection: DataProjection, pattern_projection: PatternProjection)
    -> i64 {
    let data_len: i64 = data.len();
    let pattern_len: i64 = pattern.len();
    if pattern_len == 0 { return 0; }
    if pattern_len > data_len { return -1; }
    let last_start: i64 = data_len - pattern_len;
    for start in 0..(last_start + 1) {
        var matched: bool = true;
        for offset in 0..pattern_len {
            if !equivalent(data_projection(data[start + offset]),
                           pattern_projection(pattern[offset])) {
                matched = false;
                break;
            }
        }
        if matched { return start; }
    }
    return -1;
}

/// @brief Find the first run of `count` consecutive values equal to `value`.
/// Returns 0 for a non-positive count and -1 when no run exists.
/// C++20 `std::ranges::search_n` equivalent.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn search_n(data: &list<T>, count: i64, value: U) -> i64 {
    if count <= 0 {
        return 0;
    }
    let n: i64 = data.len();
    if count > n {
        return -1;
    }
    let last_start: i64 = n - count;
    for start in 0..(last_start + 1) {
        var matches: bool = true;
        for offset in 0..count {
            if data[start + offset] != value {
                matches = false;
                break;
            }
        }
        if matches {
            return start;
        }
    }
    return -1;
}

/// @brief Find a run whose projected keys equal `value`.
/// Returns 0 for a non-positive count and -1 when no run exists.
/// C++20 `std::ranges::search_n` projection form.
/// @ingroup algorithm_ranges
generic<T, U, Projection>
pub fn search_n_projected(data: &list<T>, count: i64, value: U,
                          projection: Projection) -> i64 {
    if count <= 0 { return 0; }
    let n: i64 = data.len();
    if count > n { return -1; }
    let last_start: i64 = n - count;
    for start in 0..(last_start + 1) {
        var matches: bool = true;
        for offset in 0..count {
            if projection(data[start + offset]) != value {
                matches = false;
                break;
            }
        }
        if matches { return start; }
    }
    return -1;
}

/// @brief Find a run whose elements satisfy `equivalent(element, value)`.
/// Returns 0 for a non-positive count and -1 when no run exists.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn search_n_by(data: &list<T>, count: i64, value: U,
                   equivalent: Equivalent) -> i64 {
    if count <= 0 {
        return 0;
    }
    let n: i64 = data.len();
    if count > n {
        return -1;
    }
    let last_start: i64 = n - count;
    for start in 0..(last_start + 1) {
        var matches: bool = true;
        for offset in 0..count {
            if !equivalent(data[start + offset], value) {
                matches = false;
                break;
            }
        }
        if matches {
            return start;
        }
    }
    return -1;
}

/// @brief Find a projected run whose keys match `value` under `equivalent`.
/// Returns 0 for a non-positive count and -1 when no run exists.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, Projection>
pub fn search_n_by_projected(data: &list<T>, count: i64, value: U,
                             equivalent: Equivalent,
                             projection: Projection) -> i64 {
    if count <= 0 { return 0; }
    let n: i64 = data.len();
    if count > n { return -1; }
    let last_start: i64 = n - count;
    for start in 0..(last_start + 1) {
        var matches: bool = true;
        for offset in 0..count {
            if !equivalent(projection(data[start + offset]), value) {
                matches = false;
                break;
            }
        }
        if matches { return start; }
    }
    return -1;
}

/// @brief Return the first repeated-value run as an option index.
/// A non-positive count is a successful empty run at index zero.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn search_n_option(data: &list<T>, count: i64, value: U) -> option<i64> {
    let index: i64 = search_n(data, count, value);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the first projected repeated-value run as an option index.
/// @ingroup algorithm_ranges
generic<T, U, Projection>
pub fn search_n_projected_option(data: &list<T>, count: i64, value: U,
                                 projection: Projection) -> option<i64> {
    let index: i64 = search_n_projected(data, count, value, projection);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the first equivalent repeated-value run as an option index.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn search_n_by_option(data: &list<T>, count: i64, value: U,
                          equivalent: Equivalent) -> option<i64> {
    let index: i64 = search_n_by(data, count, value, equivalent);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the first projected equivalent run as an option index.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, Projection>
pub fn search_n_by_projected_option(data: &list<T>, count: i64, value: U,
                                    equivalent: Equivalent,
                                    projection: Projection) -> option<i64> {
    let index: i64 = search_n_by_projected(
        data, count, value, equivalent, projection);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the start index of the last matching subrange.
/// Returns the range length for an empty pattern and -1 when absent.
/// C++20 `std::ranges::find_end` equivalent.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn find_end(data: &list<T>, pattern: &list<U>) -> i64 {
    let n: i64 = data.len();
    let m: i64 = pattern.len();
    if m == 0 {
        return n;
    }
    if m > n {
        return -1;
    }
    let last_start: i64 = n - m;
    var found: i64 = -1;
    for start in 0..(last_start + 1) {
        var matches: bool = true;
        for offset in 0..m {
            if data[start + offset] != pattern[offset] {
                matches = false;
                break;
            }
        }
        if matches {
            found = start;
        }
    }
    return found;
}

/// @brief Find the last subrange matching after independent projections.
/// Returns `data.len()` for an empty pattern and -1 when absent.
/// @ingroup algorithm_ranges
generic<T, U, DataProjection, PatternProjection>
pub fn find_end_projected(data: &list<T>, pattern: &list<U>,
                          data_projection: DataProjection,
                          pattern_projection: PatternProjection) -> i64 {
    let n: i64 = data.len();
    let m: i64 = pattern.len();
    if m == 0 { return n; }
    if m > n { return -1; }
    let last_start: i64 = n - m;
    var found: i64 = -1;
    for start in 0..(last_start + 1) {
        var matches: bool = true;
        for offset in 0..m {
            if data_projection(data[start + offset]) !=
               pattern_projection(pattern[offset]) {
                matches = false;
                break;
            }
        }
        if matches { found = start; }
    }
    return found;
}

/// @brief Return the last matching subrange index using `equivalent`.
/// Returns `data.len()` for an empty pattern and -1 when absent.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn find_end_by(data: &list<T>, pattern: &list<U>,
                   equivalent: Equivalent) -> i64 {
    let n: i64 = data.len();
    let m: i64 = pattern.len();
    if m == 0 {
        return n;
    }
    if m > n {
        return -1;
    }
    let last_start: i64 = n - m;
    var found: i64 = -1;
    for start in 0..(last_start + 1) {
        var matches: bool = true;
        for offset in 0..m {
            if !equivalent(data[start + offset], pattern[offset]) {
                matches = false;
                break;
            }
        }
        if matches {
            found = start;
        }
    }
    return found;
}

/// @brief Find the last projected subrange matching under `equivalent`.
/// An empty pattern returns `data.len()`; absent patterns return -1.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, DataProjection, PatternProjection>
pub fn find_end_by_projected(
    data: &list<T>, pattern: &list<U>, equivalent: Equivalent,
    data_projection: DataProjection, pattern_projection: PatternProjection)
    -> i64 {
    let n: i64 = data.len();
    let m: i64 = pattern.len();
    if m == 0 { return n; }
    if m > n { return -1; }
    let last_start: i64 = n - m;
    var found: i64 = -1;
    for start in 0..(last_start + 1) {
        var matches: bool = true;
        for offset in 0..m {
            if !equivalent(data_projection(data[start + offset]),
                           pattern_projection(pattern[offset])) {
                matches = false;
                break;
            }
        }
        if matches { found = start; }
    }
    return found;
}

/// @brief Return the first subrange match as an option index.
/// Empty patterns match at index zero; absence is `None`.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn search_option(data: &list<T>, pattern: &list<U>) -> option<i64> {
    let index: i64 = search(data, pattern);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the first projected subrange match as an option index.
/// @ingroup algorithm_ranges
generic<T, U, DataProjection, PatternProjection>
pub fn search_projected_option(
    data: &list<T>, pattern: &list<U>, data_projection: DataProjection,
    pattern_projection: PatternProjection) -> option<i64> {
    let index: i64 = search_projected(data, pattern, data_projection,
                                      pattern_projection);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the first equivalent subrange match as an option index.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn search_by_option(data: &list<T>, pattern: &list<U>,
                        equivalent: Equivalent) -> option<i64> {
    let index: i64 = search_by(data, pattern, equivalent);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the first projected-equivalent subrange match as an option.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, DataProjection, PatternProjection>
pub fn search_by_projected_option(
    data: &list<T>, pattern: &list<U>, equivalent: Equivalent,
    data_projection: DataProjection, pattern_projection: PatternProjection)
    -> option<i64> {
    let index: i64 = search_by_projected(
        data, pattern, equivalent, data_projection, pattern_projection);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the last subrange match as an option index.
/// An empty pattern matches at `data.len()`; absence is `None`.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn find_end_option(data: &list<T>, pattern: &list<U>) -> option<i64> {
    let index: i64 = find_end(data, pattern);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the last projected subrange match as an option index.
/// @ingroup algorithm_ranges
generic<T, U, DataProjection, PatternProjection>
pub fn find_end_projected_option(
    data: &list<T>, pattern: &list<U>, data_projection: DataProjection,
    pattern_projection: PatternProjection) -> option<i64> {
    let index: i64 = find_end_projected(
        data, pattern, data_projection, pattern_projection);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the last equivalent subrange match as an option index.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn find_end_by_option(data: &list<T>, pattern: &list<U>,
                          equivalent: Equivalent) -> option<i64> {
    let index: i64 = find_end_by(data, pattern, equivalent);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the last projected-equivalent match as an option index.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, DataProjection, PatternProjection>
pub fn find_end_by_projected_option(
    data: &list<T>, pattern: &list<U>, equivalent: Equivalent,
    data_projection: DataProjection, pattern_projection: PatternProjection)
    -> option<i64> {
    let index: i64 = find_end_by_projected(
        data, pattern, equivalent, data_projection, pattern_projection);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return whether `pattern` occurs as a contiguous subsequence.
/// C++23 ranges-style subrange membership check.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn contains_subrange(data: &list<T>, pattern: &list<U>) -> bool {
    return search(data, pattern) >= 0;
}

/// @brief Test for a contiguous match after independent projections.
/// An empty pattern matches every range.
/// @ingroup algorithm_ranges
generic<T, U, DataProjection, PatternProjection>
pub fn contains_subrange_projected(
    data: &list<T>, pattern: &list<U>,
    data_projection: DataProjection,
    pattern_projection: PatternProjection) -> bool {
    return search_projected(data, pattern, data_projection,
                            pattern_projection) >= 0;
}

/// @brief Return whether `pattern` occurs contiguously under `equivalent`.
/// The ranges may have different element types. An empty pattern always
/// matches, including an empty input range.
/// C++23 `std::ranges::contains_subrange` predicate overload.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn contains_subrange_by(data: &list<T>, pattern: &list<U>,
                            equivalent: Equivalent) -> bool {
    return search_by(data, pattern, equivalent) >= 0;
}

/// @brief Test for a projected subrange match under `equivalent`.
/// Empty patterns match every range.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, DataProjection, PatternProjection>
pub fn contains_subrange_by_projected(
    data: &list<T>, pattern: &list<U>, equivalent: Equivalent,
    data_projection: DataProjection, pattern_projection: PatternProjection)
    -> bool {
    return search_by_projected(data, pattern, equivalent, data_projection,
                               pattern_projection) >= 0;
}

/// @brief Return whether `suffix` matches the end of `data`.
/// The two ranges may have different, equality-comparable element types.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn ends_with(data: &list<T>, suffix: &list<U>) -> bool {
    let suffix_len: i64 = suffix.len();
    let data_len: i64 = data.len();
    if suffix_len > data_len {
        return false;
    }
    let offset: i64 = data_len - suffix_len;
    for i in 0..suffix_len {
        if data[offset + i] != suffix[i] {
            return false;
        }
    }
    return true;
}

/// @brief Check whether projected suffix keys match the range's final keys.
/// @ingroup algorithm_ranges
generic<T, U, DataProjection, SuffixProjection>
pub fn ends_with_projected(data: &list<T>, suffix: &list<U>,
                           data_projection: DataProjection,
                           suffix_projection: SuffixProjection) -> bool {
    let suffix_len: i64 = suffix.len();
    let data_len: i64 = data.len();
    if suffix_len > data_len { return false; }
    let offset: i64 = data_len - suffix_len;
    for i in 0..suffix_len {
        if data_projection(data[offset + i]) != suffix_projection(suffix[i]) {
            return false;
        }
    }
    return true;
}

/// @brief Return whether `suffix` matches the end of `data` using a
/// caller-provided binary predicate.
/// C++20 `std::ranges::ends_with` predicate overload.
/// @ingroup algorithm_ranges
generic<T, U, Predicate>
pub fn ends_with_by(data: &list<T>, suffix: &list<U>,
                    equivalent: Predicate) -> bool {
    let suffix_len: i64 = suffix.len();
    let data_len: i64 = data.len();
    if suffix_len > data_len {
        return false;
    }
    let offset: i64 = data_len - suffix_len;
    for i in 0..suffix_len {
        if !equivalent(data[offset + i], suffix[i]) {
            return false;
        }
    }
    return true;
}

/// @brief Check a suffix using equivalence over independent projected values.
/// Empty suffixes match; ranges may have different element types.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, DataProjection, SuffixProjection>
pub fn ends_with_by_projected(
    data: &list<T>, suffix: &list<U>, equivalent: Equivalent,
    data_projection: DataProjection, suffix_projection: SuffixProjection)
    -> bool {
    let suffix_len: i64 = suffix.len();
    let data_len: i64 = data.len();
    if suffix_len > data_len { return false; }
    let offset: i64 = data_len - suffix_len;
    for i in 0..suffix_len {
        if !equivalent(data_projection(data[offset + i]),
                       suffix_projection(suffix[i])) {
            return false;
        }
    }
    return true;
}

/// @brief Three-way lexicographical comparison result.
/// @ingroup algorithm_ranges
pub enum LexicographicalOrder : i32 {
    Less = -1,
    Equivalent = 0,
    Greater = 1
};

/// @brief Return the full lexicographical ordering of two ranges.
/// This is the C++20 `lexicographical_compare_three_way` result expressed as
/// a named Mlang enum rather than a comparison-category type.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn lexicographical_compare_three_way(left: &list<T>, right: &list<U>)
    -> LexicographicalOrder {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let n: i64 = left_len < right_len ? left_len : right_len;
    for i in 0..n {
        if left[i] < right[i] { return LexicographicalOrder::Less; }
        if left[i] > right[i] { return LexicographicalOrder::Greater; }
    }
    if left_len < right_len { return LexicographicalOrder::Less; }
    if left_len > right_len { return LexicographicalOrder::Greater; }
    return LexicographicalOrder::Equivalent;
}

/// @brief Return lexicographical ordering using a strict comparator.
/// @ingroup algorithm_ranges
generic<T, U, Less>
pub fn lexicographical_compare_three_way_by(
    left: &list<T>, right: &list<U>, less: Less) -> LexicographicalOrder {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let n: i64 = left_len < right_len ? left_len : right_len;
    for i in 0..n {
        if less(left[i], right[i]) { return LexicographicalOrder::Less; }
        if less(right[i], left[i]) { return LexicographicalOrder::Greater; }
    }
    if left_len < right_len { return LexicographicalOrder::Less; }
    if left_len > right_len { return LexicographicalOrder::Greater; }
    return LexicographicalOrder::Equivalent;
}

/// @brief Return lexicographical ordering after independent projections.
/// @ingroup algorithm_ranges
generic<T, U, LeftProjection, RightProjection>
pub fn lexicographical_compare_three_way_projected(
    left: &list<T>, right: &list<U>,
    left_projection: LeftProjection, right_projection: RightProjection)
    -> LexicographicalOrder {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let n: i64 = left_len < right_len ? left_len : right_len;
    for i in 0..n {
        let left_key = left_projection(left[i]);
        let right_key = right_projection(right[i]);
        if left_key < right_key { return LexicographicalOrder::Less; }
        if left_key > right_key { return LexicographicalOrder::Greater; }
    }
    if left_len < right_len { return LexicographicalOrder::Less; }
    if left_len > right_len { return LexicographicalOrder::Greater; }
    return LexicographicalOrder::Equivalent;
}

/// @brief Return projected lexicographical ordering using a strict comparator.
/// @ingroup algorithm_ranges
generic<T, U, Less, LeftProjection, RightProjection>
pub fn lexicographical_compare_three_way_by_projected(
    left: &list<T>, right: &list<U>, less: Less,
    left_projection: LeftProjection, right_projection: RightProjection)
    -> LexicographicalOrder {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let n: i64 = left_len < right_len ? left_len : right_len;
    for i in 0..n {
        let left_key = left_projection(left[i]);
        let right_key = right_projection(right[i]);
        if less(left_key, right_key) { return LexicographicalOrder::Less; }
        if less(right_key, left_key) { return LexicographicalOrder::Greater; }
    }
    if left_len < right_len { return LexicographicalOrder::Less; }
    if left_len > right_len { return LexicographicalOrder::Greater; }
    return LexicographicalOrder::Equivalent;
}

/// @brief Compare two lists in lexicographical order.
/// The ranges may have different, mutually order-comparable element types.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn lexicographical_compare(left: &list<T>, right: &list<U>) -> bool {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let n: i64 = left_len < right_len ? left_len : right_len;
    for i in 0..n {
        if left[i] < right[i] {
            return true;
        }
        if left[i] > right[i] {
            return false;
        }
    }
    return left_len < right_len;
}

/// @brief Compare projected keys in lexicographical order.
/// Each range has an independent projection; projected key types must be
/// mutually order-comparable.
/// @ingroup algorithm_ranges
generic<T, U, LeftProjection, RightProjection>
pub fn lexicographical_compare_projected(
    left: &list<T>, right: &list<U>,
    left_projection: LeftProjection, right_projection: RightProjection) -> bool {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let n: i64 = left_len < right_len ? left_len : right_len;
    for i in 0..n {
        let left_key = left_projection(left[i]);
        let right_key = right_projection(right[i]);
        if left_key < right_key {
            return true;
        }
        if left_key > right_key {
            return false;
        }
    }
    return left_len < right_len;
}

/// @brief Compare ranges lexicographically using the strict ordering `less`.
/// @ingroup algorithm_ranges
generic<T, U, Less>
pub fn lexicographical_compare_by(left: &list<T>, right: &list<U>, less: Less)
    -> bool {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let n: i64 = left_len < right_len ? left_len : right_len;
    for i in 0..n {
        if less(left[i], right[i]) {
            return true;
        }
        if less(right[i], left[i]) {
            return false;
        }
    }
    return left_len < right_len;
}

/// @brief Compare ranges lexicographically by projected keys and `less`.
/// Each range has an independent projection; a matching prefix sorts first.
/// @ingroup algorithm_ranges
generic<T, U, Less, LeftProjection, RightProjection>
pub fn lexicographical_compare_by_projected(
    left: &list<T>, right: &list<U>, less: Less,
    left_projection: LeftProjection, right_projection: RightProjection)
    -> bool {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let n: i64 = left_len < right_len ? left_len : right_len;
    for i in 0..n {
        let left_key = left_projection(left[i]);
        let right_key = right_projection(right[i]);
        if less(left_key, right_key) { return true; }
        if less(right_key, left_key) { return false; }
    }
    return left_len < right_len;
}

/// @brief Return true when elements are in nondecreasing order.
/// @ingroup algorithm_ranges
generic<T>
pub fn is_sorted(data: &list<T>) -> bool {
    let n: i64 = data.len();
    if n < 2 {
        return true;
    }
    for i in 1..n {
        if data[i] < data[i - 1] {
            return false;
        }
    }
    return true;
}

/// @brief Return the first index violating sorted order, or the range length.
/// This is the index form of C++20 `std::ranges::is_sorted_until`.
/// @ingroup algorithm_ranges
generic<T>
pub fn is_sorted_until(data: &list<T>) -> i64 {
    let n: i64 = data.len();
    for i in 1..n {
        if data[i] < data[i - 1] {
            return i;
        }
    }
    return n;
}

/// @brief Find the first inversion after applying `projection`.
/// The result is the range length when projected values are sorted.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn is_sorted_until_projected(data: &list<T>, projection: Projection) -> i64 {
    let n: i64 = data.len();
    for i in 1..n {
        if projection(data[i]) < projection(data[i - 1]) {
            return i;
        }
    }
    return n;
}

/// @brief Check nondecreasing order after applying `projection`.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn is_sorted_projected(data: &list<T>, projection: Projection) -> bool {
    return is_sorted_until_projected(data, projection) == data.len();
}

/// @brief Return the first child index violating max-heap order, or range length.
/// C++20 `std::ranges::is_heap_until` equivalent.
/// @ingroup algorithm_ranges
generic<T>
pub fn is_heap_until(data: &list<T>) -> i64 {
    let n: i64 = data.len();
    for child in 1..n {
        let parent: i64 = (child - 1) / 2;
        if data[parent] < data[child] {
            return child;
        }
    }
    return n;
}

/// @brief Return whether a list satisfies max-heap order (C++20 ranges).
/// @ingroup algorithm_ranges
generic<T>
pub fn is_heap(data: &list<T>) -> bool {
    return is_heap_until(data) == data.len();
}

/// @brief Return the first child violating heap order defined by `less`.
/// A child violates the heap when its parent compares less than it.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn is_heap_until_by(data: &list<T>, less: Less) -> i64 {
    let n: i64 = data.len();
    for child in 1..n {
        let parent: i64 = (child - 1) / 2;
        if less(data[parent], data[child]) {
            return child;
        }
    }
    return n;
}

/// @brief Return whether a list satisfies heap order defined by `less`.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn is_heap_by(data: &list<T>, less: Less) -> bool {
    return is_heap_until_by(data, less) == data.len();
}

/// @brief Return the first child violating projected heap order defined by `less`.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn is_heap_until_by_projected(data: &list<T>, less: Less,
                                  projection: Projection) -> i64 {
    let n: i64 = data.len();
    for child in 1..n {
        let parent: i64 = (child - 1) / 2;
        if less(projection(data[parent]), projection(data[child])) {
            return child;
        }
    }
    return n;
}

/// @brief Check heap order defined by a comparator over projected keys.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn is_heap_by_projected(data: &list<T>, less: Less,
                            projection: Projection) -> bool {
    return is_heap_until_by_projected(data, less, projection) == data.len();
}

/// @brief Return the first child violating max-heap order after projection.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn is_heap_until_projected(data: &list<T>, projection: Projection) -> i64 {
    let n: i64 = data.len();
    for child in 1..n {
        let parent: i64 = (child - 1) / 2;
        if projection(data[parent]) < projection(data[child]) {
            return child;
        }
    }
    return n;
}

/// @brief Check max-heap order according to projected keys.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn is_heap_projected(data: &list<T>, projection: Projection) -> bool {
    return is_heap_until_projected(data, projection) == data.len();
}

generic<T>
fn heap_swap_at(data: &list<T>, first: i64, second: i64) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if i == first {
            out.push(data[second]);
        } else if i == second {
            out.push(data[first]);
        } else {
            out.push(data[i]);
        }
    }
    return out;
}

generic<T, Less>
fn heap_sift_down_by(data: &list<T>, heap_len: i64, root: i64,
                     less: Less) -> list<T> {
    var heap: list<T> = take(data, data.len());
    var parent: i64 = root;
    while parent < heap_len / 2 {
        let left: i64 = parent * 2 + 1;
        var larger: i64 = left;
        let right: i64 = left + 1;
        if right < heap_len && less(heap[left], heap[right]) {
            larger = right;
        }
        if !less(heap[parent], heap[larger]) {
            break;
        }
        heap = heap_swap_at(heap, parent, larger);
        parent = larger;
    }
    return heap;
}

generic<T, Projection>
fn heap_sift_down_projected(data: &list<T>, heap_len: i64, root: i64,
                            projection: Projection) -> list<T> {
    var heap: list<T> = take(data, data.len());
    var parent: i64 = root;
    while parent < heap_len / 2 {
        let left: i64 = parent * 2 + 1;
        var larger: i64 = left;
        let right: i64 = left + 1;
        if right < heap_len && projection(heap[left]) < projection(heap[right]) {
            larger = right;
        }
        if !(projection(heap[parent]) < projection(heap[larger])) {
            break;
        }
        heap = heap_swap_at(heap, parent, larger);
        parent = larger;
    }
    return heap;
}

generic<T, Less, Projection>
fn heap_sift_down_by_projected(data: &list<T>, heap_len: i64, root: i64,
                               less: Less, projection: Projection) -> list<T> {
    var heap: list<T> = take(data, data.len());
    var parent: i64 = root;
    while parent < heap_len / 2 {
        let left: i64 = parent * 2 + 1;
        var larger: i64 = left;
        let right: i64 = left + 1;
        if right < heap_len &&
           less(projection(heap[left]), projection(heap[right])) {
            larger = right;
        }
        if !less(projection(heap[parent]), projection(heap[larger])) {
            break;
        }
        heap = heap_swap_at(heap, parent, larger);
        parent = larger;
    }
    return heap;
}

/// @brief Return a max-heap copy of `data` (C++20 `ranges::make_heap`).
/// @ingroup algorithm_ranges
generic<T>
pub fn make_heap(data: &list<T>) -> list<T> {
    var heap: list<T> = take(data, data.len());
    var parent: i64 = heap.len() / 2;
    while parent > 0 {
        parent = parent - 1;
        var current: i64 = parent;
        while current < heap.len() / 2 {
            let left: i64 = current * 2 + 1;
            var larger: i64 = left;
            let right: i64 = left + 1;
            if right < heap.len() && heap[left] < heap[right] {
                larger = right;
            }
            if !(heap[current] < heap[larger]) {
                break;
            }
            heap = heap_swap_at(heap, current, larger);
            current = larger;
        }
    }
    return heap;
}

/// @brief Return a heap ordered by the strict comparison `less`.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn make_heap_by(data: &list<T>, less: Less) -> list<T> {
    var heap: list<T> = take(data, data.len());
    var parent: i64 = heap.len() / 2;
    while parent > 0 {
        parent = parent - 1;
        heap = heap_sift_down_by(heap, heap.len(), parent, less);
    }
    return heap;
}

/// @brief Build a max-heap according to projected keys.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn make_heap_projected(data: &list<T>, projection: Projection) -> list<T> {
    var heap: list<T> = take(data, data.len());
    var parent: i64 = heap.len() / 2;
    while parent > 0 {
        parent = parent - 1;
        heap = heap_sift_down_projected(heap, heap.len(), parent, projection);
    }
    return heap;
}

/// @brief Build a heap ordered by `less` over projected keys.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn make_heap_by_projected(data: &list<T>, less: Less,
                              projection: Projection) -> list<T> {
    var heap: list<T> = take(data, data.len());
    var parent: i64 = heap.len() / 2;
    while parent > 0 {
        parent = parent - 1;
        heap = heap_sift_down_by_projected(heap, heap.len(), parent,
                                           less, projection);
    }
    return heap;
}

/// @brief Restore heap order after appending one item to a max-heap copy.
/// The input must have a heap-ordered prefix; the last element is the new item.
/// @ingroup algorithm_ranges
generic<T>
pub fn push_heap(data: &list<T>) -> list<T> {
    var heap: list<T> = take(data, data.len());
    var child: i64 = heap.len() - 1;
    while child > 0 {
        let parent: i64 = (child - 1) / 2;
        if !(heap[parent] < heap[child]) {
            break;
        }
        heap = heap_swap_at(heap, parent, child);
        child = parent;
    }
    return heap;
}

/// @brief Restore heap order after append, using `less` for priority order.
/// The input must have a heap-ordered prefix; the last element is the new item.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn push_heap_by(data: &list<T>, less: Less) -> list<T> {
    var heap: list<T> = take(data, data.len());
    var child: i64 = heap.len() - 1;
    while child > 0 {
        let parent: i64 = (child - 1) / 2;
        if !less(heap[parent], heap[child]) {
            break;
        }
        heap = heap_swap_at(heap, parent, child);
        child = parent;
    }
    return heap;
}

/// @brief Restore projected max-heap order after appending one element.
/// The prefix before the last element must already be a projected max-heap.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn push_heap_projected(data: &list<T>, projection: Projection) -> list<T> {
    var heap: list<T> = take(data, data.len());
    var child: i64 = heap.len() - 1;
    while child > 0 {
        let parent: i64 = (child - 1) / 2;
        if !(projection(heap[parent]) < projection(heap[child])) {
            break;
        }
        heap = heap_swap_at(heap, parent, child);
        child = parent;
    }
    return heap;
}

/// @brief Restore heap order by `less` over projected keys after appending.
/// The prefix before the final element must already be a matching heap.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn push_heap_by_projected(data: &list<T>, less: Less,
                              projection: Projection) -> list<T> {
    var heap: list<T> = take(data, data.len());
    var child: i64 = heap.len() - 1;
    while child > 0 {
        let parent: i64 = (child - 1) / 2;
        if !less(projection(heap[parent]), projection(heap[child])) {
            break;
        }
        heap = heap_swap_at(heap, parent, child);
        child = parent;
    }
    return heap;
}

/// @brief Move the max element to the final slot and restore the prefix heap.
/// For an empty range this returns an empty copy; the input is unchanged.
/// @ingroup algorithm_ranges
generic<T>
pub fn pop_heap(data: &list<T>) -> list<T> {
    let n: i64 = data.len();
    var heap: list<T> = take(data, n);
    if n < 2 {
        return heap;
    }
    heap = heap_swap_at(heap, 0, n - 1);
    var parent: i64 = 0;
    let heap_len: i64 = n - 1;
    while parent < heap_len / 2 {
        let left: i64 = parent * 2 + 1;
        var larger: i64 = left;
        let right: i64 = left + 1;
        if right < heap_len && heap[left] < heap[right] {
            larger = right;
        }
        if !(heap[parent] < heap[larger]) {
            break;
        }
        heap = heap_swap_at(heap, parent, larger);
        parent = larger;
    }
    return heap;
}

/// @brief Pop from a heap ordered by `less`, placing its top at the end.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn pop_heap_by(data: &list<T>, less: Less) -> list<T> {
    let n: i64 = data.len();
    var heap: list<T> = take(data, n);
    if n < 2 {
        return heap;
    }
    heap = heap_swap_at(heap, 0, n - 1);
    return heap_sift_down_by(heap, n - 1, 0, less);
}

/// @brief Move the projected maximum to the last slot and restore the prefix.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn pop_heap_projected(data: &list<T>, projection: Projection) -> list<T> {
    let n: i64 = data.len();
    var heap: list<T> = take(data, n);
    if n < 2 {
        return heap;
    }
    heap = heap_swap_at(heap, 0, n - 1);
    return heap_sift_down_projected(heap, n - 1, 0, projection);
}

/// @brief Move the top value to the end and restore projected comparator order.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn pop_heap_by_projected(data: &list<T>, less: Less,
                             projection: Projection) -> list<T> {
    let n: i64 = data.len();
    var heap: list<T> = take(data, n);
    if n < 2 { return heap; }
    heap = heap_swap_at(heap, 0, n - 1);
    return heap_sift_down_by_projected(heap, n - 1, 0, less, projection);
}

/// @brief Return an ascending copy sorted from a max-heap.
/// The input must satisfy max-heap order; inputs are not modified.
/// @ingroup algorithm_ranges
generic<T>
pub fn sort_heap(data: &list<T>) -> list<T> {
    return sorted(data);
}

/// @brief Return a copy sorted by `less` from a heap using that ordering.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn sort_heap_by(data: &list<T>, less: Less) -> list<T> {
    return sorted_by(data, less);
}

/// @brief Return elements from a projected max-heap in ascending key order.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn sort_heap_projected(data: &list<T>, projection: Projection) -> list<T> {
    return sorted_projected(data, projection);
}

/// @brief Return heap values sorted by `less` over projected keys.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn sort_heap_by_projected(data: &list<T>, less: Less,
                              projection: Projection) -> list<T> {
    return sorted_by_projected(data, less, projection);
}

/// @brief Return the smallest `count` elements in ascending order.
/// The count is clamped to `[0, data.len()]`; the input is unchanged.
/// C++20 `std::ranges::partial_sort` eager-list counterpart.
/// @ingroup algorithm_ranges
generic<T>
pub fn partial_sort(data: &list<T>, count: i64) -> list<T> {
    var limit: i64 = count;
    let n: i64 = data.len();
    if limit < 0 { limit = 0; }
    if limit > n { limit = n; }
    if limit == 0 { return []; }

    var initial: list<T> = take(data, limit);
    var heap: list<T> = make_heap(initial);
    for i in limit..n {
        if data[i] < heap[0] {
            let popped: list<T> = pop_heap(heap);
            var prefix: list<T> = take(popped, limit - 1);
            prefix.push(data[i]);
            heap = push_heap(prefix);
        }
    }
    return sort_heap(heap);
}

/// @brief Return the first `count` values according to the ordering `less`.
/// The retained prefix is sorted; counts clamp to `[0, data.len()]` and the
/// input is unchanged. Equivalent values retain heap-algorithm ordering.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn partial_sort_by(data: &list<T>, count: i64, less: Less) -> list<T> {
    var limit: i64 = count;
    let n: i64 = data.len();
    if limit < 0 { limit = 0; }
    if limit > n { limit = n; }
    if limit == 0 { return []; }

    var initial: list<T> = take(data, limit);
    var heap: list<T> = make_heap_by(initial, less);
    for i in limit..n {
        if less(data[i], heap[0]) {
            let popped: list<T> = pop_heap_by(heap, less);
            var prefix: list<T> = take(popped, limit - 1);
            prefix.push(data[i]);
            heap = push_heap_by(prefix, less);
        }
    }
    return sort_heap_by(heap, less);
}

/// @brief Return the first `count` values ordered by their projected keys.
/// The selected prefix is sorted; count is clamped to the range bounds and
/// the input is unchanged. This mirrors C++20 ranges partial sorting with a
/// projection and preserves the bounded-heap behavior of `partial_sort_by`.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn partial_sort_projected(data: &list<T>, count: i64,
                              projection: Projection) -> list<T> {
    var limit: i64 = count;
    let n: i64 = data.len();
    if limit < 0 { limit = 0; }
    if limit > n { limit = n; }
    if limit == 0 { return []; }

    let initial: list<T> = take(data, limit);
    var heap: list<T> = make_heap_projected(initial, projection);
    for i in limit..n {
        if projection(data[i]) < projection(heap[0]) {
            let popped: list<T> = pop_heap_projected(heap, projection);
            var prefix: list<T> = take(popped, limit - 1);
            prefix.push(data[i]);
            heap = push_heap_projected(prefix, projection);
        }
    }
    return sort_heap_projected(heap, projection);
}

/// @brief Select and sort a prefix using a comparator over projected keys.
/// Counts clamp to `[0, data.len()]`; the input list remains unchanged.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn partial_sort_by_projected(data: &list<T>, count: i64, less: Less,
                                 projection: Projection) -> list<T> {
    var limit: i64 = count;
    let n: i64 = data.len();
    if limit < 0 { limit = 0; }
    if limit > n { limit = n; }
    if limit == 0 { return []; }

    let initial: list<T> = take(data, limit);
    var heap: list<T> = make_heap_by_projected(initial, less, projection);
    for i in limit..n {
        if less(projection(data[i]), projection(heap[0])) {
            let popped: list<T> = pop_heap_by_projected(heap, less,
                                                         projection);
            var prefix: list<T> = take(popped, limit - 1);
            prefix.push(data[i]);
            heap = push_heap_by_projected(prefix, less, projection);
        }
    }
    return sort_heap_by_projected(heap, less, projection);
}

/// @brief Sort up to `output_capacity` selected values into a new list.
/// This is the eager-list C++20 `std::ranges::partial_sort_copy` counterpart:
/// the capacity stands for the destination range length, and the source stays
/// unchanged.
/// @ingroup algorithm_ranges
generic<T>
pub fn partial_sort_copy(data: &list<T>, output_capacity: i64) -> list<T> {
    return partial_sort(data, output_capacity);
}

/// @brief Sort up to `output_capacity` values by projected keys.
/// The input is unchanged; capacity is clamped to the source length.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn partial_sort_copy_projected(data: &list<T>, output_capacity: i64,
                                   projection: Projection) -> list<T> {
    return partial_sort_projected(data, output_capacity, projection);
}

/// @brief Comparator form of `partial_sort_copy`.
/// Selects the first values according to `less` and returns them sorted.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn partial_sort_copy_by(data: &list<T>, output_capacity: i64,
                            less: Less) -> list<T> {
    return partial_sort_by(data, output_capacity, less);
}

/// @brief Comparator-and-projection form of `partial_sort_copy`.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn partial_sort_copy_by_projected(data: &list<T>, output_capacity: i64,
                                      less: Less,
                                      projection: Projection) -> list<T> {
    return partial_sort_by_projected(data, output_capacity, less, projection);
}

generic<T, Output, Less, Projection>
fn ranges_partial_sort_copy_to_heterogeneous_core(
    source: &list<T>, destination: &mut list<Output>, less: Less,
    projection: Projection) -> i64 {
    let selected: list<T> = partial_sort_copy_by_projected(
        source, destination.len(), less, projection);
    let count: i64 = selected.len();
    for i in 0..count { destination[i] = selected[i]; }
    return count;
}

/// @brief Partial-sort-copy into a destination with a compatible distinct type.
/// Selects up to destination capacity, returns the count written, and leaves
/// the source and unused destination suffix unchanged.
/// @ingroup algorithm_ranges
generic<T, Output>
pub fn partial_sort_copy_to_heterogeneous(
    source: &list<T>, destination: &mut list<Output>) -> i64 {
    return ranges_partial_sort_copy_to_heterogeneous_core(
        source, destination, ranges_default_less, ranges_identity);
}

/// @brief Heterogeneous-output partial-sort-copy ordered by projected keys.
/// @ingroup algorithm_ranges
generic<T, Output, Projection>
pub fn partial_sort_copy_to_heterogeneous_projected(
    source: &list<T>, destination: &mut list<Output>,
    projection: Projection) -> i64 {
    return ranges_partial_sort_copy_to_heterogeneous_core(
        source, destination, ranges_default_less, projection);
}

/// @brief Heterogeneous-output partial-sort-copy using a custom comparator.
/// @ingroup algorithm_ranges
generic<T, Output, Less>
pub fn partial_sort_copy_to_heterogeneous_by(
    source: &list<T>, destination: &mut list<Output>, less: Less) -> i64 {
    return ranges_partial_sort_copy_to_heterogeneous_core(
        source, destination, less, ranges_identity);
}

/// @brief Heterogeneous-output partial-sort-copy with comparator and projection.
/// @ingroup algorithm_ranges
generic<T, Output, Less, Projection>
pub fn partial_sort_copy_to_heterogeneous_by_projected(
    source: &list<T>, destination: &mut list<Output>, less: Less,
    projection: Projection) -> i64 {
    return ranges_partial_sort_copy_to_heterogeneous_core(
        source, destination, less, projection);
}

/// @brief Select and sort values into an existing destination list.
/// Writes up to the destination capacity and returns the number written;
/// the source remains unchanged and any unused destination suffix is kept.
/// @ingroup algorithm_ranges
generic<T>
pub fn partial_sort_copy_to(source: &list<T>, destination: &mut list<T>) -> i64 {
    let selected: list<T> = partial_sort_copy(source, destination.len());
    let count: i64 = selected.len();
    for i in 0..count { destination[i] = selected[i]; }
    return count;
}

/// @brief Partial-sort into an existing destination by projected keys.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn partial_sort_copy_to_projected(
    source: &list<T>, destination: &mut list<T>,
    projection: Projection) -> i64 {
    let selected: list<T> = partial_sort_copy_projected(
        source, destination.len(), projection);
    let count: i64 = selected.len();
    for i in 0..count { destination[i] = selected[i]; }
    return count;
}

/// @brief Comparator form of partial-sorting into an existing destination.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn partial_sort_copy_to_by(
    source: &list<T>, destination: &mut list<T>, less: Less) -> i64 {
    let selected: list<T> = partial_sort_copy_by(
        source, destination.len(), less);
    let count: i64 = selected.len();
    for i in 0..count { destination[i] = selected[i]; }
    return count;
}

/// @brief Comparator-and-projection form of partial-sorting to a destination.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn partial_sort_copy_to_by_projected(
    source: &list<T>, destination: &mut list<T>, less: Less,
    projection: Projection) -> i64 {
    let selected: list<T> = partial_sort_copy_by_projected(
        source, destination.len(), less, projection);
    let count: i64 = selected.len();
    for i in 0..count { destination[i] = selected[i]; }
    return count;
}

generic<T, Less>
fn nth_element_impl_by(data: &list<T>, nth: i64, less: Less) -> list<T> {
    let n: i64 = data.len();
    if nth < 0 || nth >= n { return []; }
    if n < 2 {
        return take(data, n);
    }

    let pivot: T = data[n / 2];
    var lower: list<T> = [];
    var equal: list<T> = [];
    var upper: list<T> = [];
    for i in 0..n {
        let value: T = data[i];
        if less(value, pivot) {
            lower.push(value);
        } else if less(pivot, value) {
            upper.push(value);
        } else {
            equal.push(value);
        }
    }

    let lower_len: i64 = lower.len();
    let equal_len: i64 = equal.len();
    var result: list<T> = [];
    if nth < lower_len {
        result = nth_element_impl_by(lower, nth, less);
        for i in 0..equal_len { result.push(equal[i]); }
        for i in 0..upper.len() { result.push(upper[i]); }
        return result;
    }
    if nth >= lower_len + equal_len {
        for i in 0..lower_len { result.push(lower[i]); }
        for i in 0..equal_len { result.push(equal[i]); }
        let selected_values: list<T> =
            nth_element_impl_by(upper, nth - lower_len - equal_len, less);
        for i in 0..selected_values.len() { result.push(selected_values[i]); }
        return result;
    }

    for i in 0..lower_len { result.push(lower[i]); }
    for i in 0..equal_len { result.push(equal[i]); }
    for i in 0..upper.len() { result.push(upper[i]); }
    return result;
}

generic<T>
fn nth_element_impl(data: &list<T>, nth: i64) -> list<T> {
    let n: i64 = data.len();
    if nth < 0 || nth >= n { return []; }
    if n < 2 { return take(data, n); }

    let pivot: T = data[n / 2];
    var lower: list<T> = [];
    var equal: list<T> = [];
    var upper: list<T> = [];
    for i in 0..n {
        let value: T = data[i];
        if value < pivot {
            lower.push(value);
        } else if pivot < value {
            upper.push(value);
        } else {
            equal.push(value);
        }
    }

    let lower_len: i64 = lower.len();
    let equal_len: i64 = equal.len();
    var result: list<T> = [];
    if nth < lower_len {
        result = nth_element_impl(lower, nth);
        for i in 0..equal_len { result.push(equal[i]); }
        for i in 0..upper.len() { result.push(upper[i]); }
        return result;
    }
    if nth >= lower_len + equal_len {
        for i in 0..lower_len { result.push(lower[i]); }
        for i in 0..equal_len { result.push(equal[i]); }
        let selected: list<T> = nth_element_impl(upper, nth - lower_len - equal_len);
        for i in 0..selected.len() { result.push(selected[i]); }
        return result;
    }
    for i in 0..lower_len { result.push(lower[i]); }
    for i in 0..equal_len { result.push(equal[i]); }
    for i in 0..upper.len() { result.push(upper[i]); }
    return result;
}

generic<T, Projection>
fn nth_element_impl_projected(data: &list<T>, nth: i64,
                              projection: Projection) -> list<T> {
    let n: i64 = data.len();
    if nth < 0 || nth >= n { return []; }
    if n < 2 { return take(data, n); }

    let pivot: T = data[n / 2];
    var lower: list<T> = [];
    var equal: list<T> = [];
    var upper: list<T> = [];
    for i in 0..n {
        let value: T = data[i];
        if projection(value) < projection(pivot) {
            lower.push(value);
        } else if projection(pivot) < projection(value) {
            upper.push(value);
        } else {
            equal.push(value);
        }
    }

    let lower_len: i64 = lower.len();
    let equal_len: i64 = equal.len();
    var result: list<T> = [];
    if nth < lower_len {
        result = nth_element_impl_projected(lower, nth, projection);
        for i in 0..equal_len { result.push(equal[i]); }
        for i in 0..upper.len() { result.push(upper[i]); }
        return result;
    }
    if nth >= lower_len + equal_len {
        for i in 0..lower_len { result.push(lower[i]); }
        for i in 0..equal_len { result.push(equal[i]); }
        let selected: list<T> = nth_element_impl_projected(
            upper, nth - lower_len - equal_len, projection);
        for i in 0..selected.len() { result.push(selected[i]); }
        return result;
    }
    for i in 0..lower_len { result.push(lower[i]); }
    for i in 0..equal_len { result.push(equal[i]); }
    for i in 0..upper.len() { result.push(upper[i]); }
    return result;
}

generic<T, Less, Projection>
fn nth_element_impl_by_projected(data: &list<T>, nth: i64, less: Less,
                                 projection: Projection) -> list<T> {
    let n: i64 = data.len();
    if nth < 0 || nth >= n { return []; }
    if n < 2 { return take(data, n); }

    let pivot: T = data[n / 2];
    var lower: list<T> = [];
    var equal: list<T> = [];
    var upper: list<T> = [];
    for i in 0..n {
        let value: T = data[i];
        let value_key = projection(value);
        let pivot_key = projection(pivot);
        if less(value_key, pivot_key) {
            lower.push(value);
        } else if less(pivot_key, value_key) {
            upper.push(value);
        } else {
            equal.push(value);
        }
    }

    let lower_len: i64 = lower.len();
    let equal_len: i64 = equal.len();
    var result: list<T> = [];
    if nth < lower_len {
        result = nth_element_impl_by_projected(lower, nth, less, projection);
        for i in 0..equal_len { result.push(equal[i]); }
        for i in 0..upper.len() { result.push(upper[i]); }
        return result;
    }
    if nth >= lower_len + equal_len {
        for i in 0..lower_len { result.push(lower[i]); }
        for i in 0..equal_len { result.push(equal[i]); }
        let selected: list<T> = nth_element_impl_by_projected(
            upper, nth - lower_len - equal_len, less, projection);
        for i in 0..selected.len() { result.push(selected[i]); }
        return result;
    }
    for i in 0..lower_len { result.push(lower[i]); }
    for i in 0..equal_len { result.push(equal[i]); }
    for i in 0..upper.len() { result.push(upper[i]); }
    return result;
}

/// @brief Reorder a copied range around its `nth` element.
/// Values before it are no greater and values after it are no smaller; neither
/// side is otherwise sorted. Invalid indices return an empty list. This
/// eager-list algorithm is the C++20 `std::ranges::nth_element` counterpart.
/// @ingroup algorithm_ranges
generic<T>
pub fn nth_element(data: &list<T>, nth: i64) -> list<T> {
    return nth_element_impl(data, nth);
}

/// @brief Partition a mutable list around the selected element using 3-way quickselect.
/// Returns `nth` when it is valid and -1 otherwise. Values on either side are
/// partitioned but not sorted; average work is linear in the input length.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
fn nth_element_in_place_impl(data: &mut list<T>, nth: i64, less: Less,
                             projection: Projection) -> i64 {
    let n: i64 = data.len();
    if nth < 0 || nth >= n { return -1; }
    var first: i64 = 0;
    var last: i64 = n - 1;
    while first <= last {
        let middle: i64 = first + (last - first) / 2;
        let pivot = projection(data[middle]);
        var less_end: i64 = first;
        var current: i64 = first;
        var greater_start: i64 = last;
        while current <= greater_start {
            if less(projection(data[current]), pivot) {
                let temporary: T = data[less_end];
                data[less_end] = data[current];
                data[current] = temporary;
                less_end = less_end + 1;
                current = current + 1;
            } else if less(pivot, projection(data[current])) {
                let temporary: T = data[current];
                data[current] = data[greater_start];
                data[greater_start] = temporary;
                greater_start = greater_start - 1;
            } else {
                current = current + 1;
            }
        }
        if nth < less_end {
            last = less_end - 1;
        } else if nth > greater_start {
            first = greater_start + 1;
        } else {
            return nth;
        }
    }
    return -1;
}

/// @brief Select the nth ascending element in a mutable list in place.
/// Returns `nth` when valid and -1 for an invalid index; neither side is sorted.
/// @ingroup algorithm_ranges
generic<T>
pub fn nth_element_in_place(data: &mut list<T>, nth: i64) -> i64 {
    let less = |left: T, right: T| { return left < right; };
    let identity = |value: T| { return value; };
    return nth_element_in_place_impl(&mut data, nth, less, identity);
}

/// @brief Select by a caller-provided ordering in a mutable list in place.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn nth_element_in_place_by(data: &mut list<T>, nth: i64,
                               less: Less) -> i64 {
    let identity = |value: T| { return value; };
    return nth_element_in_place_impl(&mut data, nth, less, identity);
}

/// @brief Select by projected key in a mutable list in place.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn nth_element_in_place_projected(
    data: &mut list<T>, nth: i64, projection: Projection) -> i64 {
    let less = |left: T, right: T| { return left < right; };
    return nth_element_in_place_impl(&mut data, nth, less, projection);
}

/// @brief Select by comparator and projection in a mutable list in place.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn nth_element_in_place_by_projected(
    data: &mut list<T>, nth: i64, less: Less, projection: Projection) -> i64 {
    return nth_element_in_place_impl(&mut data, nth, less, projection);
}

/// @brief Comparator-based `nth_element`; invalid indices return an empty list.
/// `less` defines the order and partitions the result around the selected value.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn nth_element_by(data: &list<T>, nth: i64, less: Less)
    -> list<T> {
    return nth_element_impl_by(data, nth, less);
}

/// @brief Partition a copied range around the `nth` projected key.
/// Items before it have no greater key and items after it have no smaller key;
/// neither side is otherwise sorted. Invalid indices return an empty list.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn nth_element_projected(data: &list<T>, nth: i64,
                             projection: Projection) -> list<T> {
    return nth_element_impl_projected(data, nth, projection);
}

/// @brief Partition a copied range using a comparator over projected keys.
/// Invalid indices return an empty list; neither side is otherwise sorted.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn nth_element_by_projected(data: &list<T>, nth: i64, less: Less,
                                projection: Projection) -> list<T> {
    return nth_element_impl_by_projected(data, nth, less, projection);
}

/// @brief First index where `value` can be inserted without breaking order.
/// Requires nondecreasing input; returns `data.len()` when value is too large.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn lower_bound(data: &list<T>, value: U) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = data.len();
    while lo < hi {
        let mid: i64 = lo + (hi - lo) / 2;
        if data[mid] < value {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

/// @brief Projected lower bound for a range sorted by projected values.
/// @ingroup algorithm_ranges
generic<T, U, Projection>
pub fn lower_bound_projected(data: &list<T>, value: U, projection: Projection) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = data.len();
    while lo < hi {
        let mid: i64 = lo + (hi - lo) / 2;
        if projection(data[mid]) < value {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

/// @brief First index where `value` would be inserted after equal elements.
/// Requires nondecreasing input; returns `data.len()` when value is too large.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn upper_bound(data: &list<T>, value: U) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = data.len();
    while lo < hi {
        let mid: i64 = lo + (hi - lo) / 2;
        if value < data[mid] {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    return lo;
}

/// @brief Projected upper bound for a range sorted by projected values.
/// @ingroup algorithm_ranges
generic<T, U, Projection>
pub fn upper_bound_projected(data: &list<T>, value: U, projection: Projection) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = data.len();
    while lo < hi {
        let mid: i64 = lo + (hi - lo) / 2;
        if value < projection(data[mid]) {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    return lo;
}

/// @brief Return the half-open index range containing equivalent values.
/// Requires nondecreasing input. The result is `(lower_bound, upper_bound)`.
/// C++20 `std::ranges::equal_range` equivalent.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn equal_range(data: &list<T>, value: U) -> tuple<i64, i64> {
    let first: i64 = lower_bound(data, value);
    let last: i64 = upper_bound(data, value);
    return (first, last);
}

/// @brief Return the projected half-open matching index range.
/// Requires projected values sorted in nondecreasing order.
/// @ingroup algorithm_ranges
generic<T, U, Projection>
pub fn equal_range_projected(data: &list<T>, value: U, projection: Projection)
    -> tuple<i64, i64> {
    let first: i64 = lower_bound_projected(data, value, projection);
    let last: i64 = upper_bound_projected(data, value, projection);
    return (first, last);
}

/// @brief Return whether a sorted list contains `value`.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn binary_search(data: &list<T>, value: U) -> bool {
    let position: i64 = lower_bound(data, value);
    if position >= data.len() {
        return false;
    }
    return data[position] == value;
}

/// @brief Check whether a projected value occurs in a sorted range.
/// @ingroup algorithm_ranges
generic<T, U, Projection>
pub fn binary_search_projected(data: &list<T>, value: U, projection: Projection)
    -> bool {
    let position: i64 = lower_bound_projected(data, value, projection);
    if position >= data.len() {
        return false;
    }
    let projected: U = projection(data[position]);
    return projected == value;
}

/// @brief Comparator-and-projection lower bound for an ordered range.
/// `less` receives projected element keys and the lookup value.
/// @ingroup algorithm_ranges
generic<T, U, Less, Projection>
pub fn lower_bound_by_projected(data: &list<T>, value: U, less: Less,
                                projection: Projection) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = data.len();
    while lo < hi {
        let mid: i64 = lo + (hi - lo) / 2;
        if less(projection(data[mid]), value) { lo = mid + 1; }
        else { hi = mid; }
    }
    return lo;
}

/// @brief Comparator-and-projection upper bound for an ordered range.
/// `less` receives the lookup value and projected element keys.
/// @ingroup algorithm_ranges
generic<T, U, Less, Projection>
pub fn upper_bound_by_projected(data: &list<T>, value: U, less: Less,
                                projection: Projection) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = data.len();
    while lo < hi {
        let mid: i64 = lo + (hi - lo) / 2;
        if less(value, projection(data[mid])) { hi = mid; }
        else { lo = mid + 1; }
    }
    return lo;
}

/// @brief Return the comparator-and-projection matching half-open range.
/// @ingroup algorithm_ranges
generic<T, U, Less, Projection>
pub fn equal_range_by_projected(data: &list<T>, value: U, less: Less,
                                projection: Projection) -> tuple<i64, i64> {
    let first: i64 = lower_bound_by_projected(data, value, less, projection);
    let last: i64 = upper_bound_by_projected(data, value, less, projection);
    return (first, last);
}

/// @brief Search for a value using comparator-and-projection ordering.
/// @ingroup algorithm_ranges
generic<T, U, Less, Projection>
pub fn binary_search_by_projected(data: &list<T>, value: U, less: Less,
                                  projection: Projection) -> bool {
    let position: i64 = lower_bound_by_projected(
        data, value, less, projection);
    if position >= data.len() { return false; }
    let key = projection(data[position]);
    return !less(key, value) && !less(value, key);
}

/// @brief Check sorted order using `less` as the strict ordering comparator.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn is_sorted_by(data: &list<T>, less: Less) -> bool {
    let n: i64 = data.len();
    for i in 1..n {
        if less(data[i], data[i - 1]) {
            return false;
        }
    }
    return true;
}

/// @brief Return the first index violating comparator order, or range length.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn is_sorted_until_by(data: &list<T>, less: Less) -> i64 {
    let n: i64 = data.len();
    for i in 1..n {
        if less(data[i], data[i - 1]) {
            return i;
        }
    }
    return n;
}

/// @brief Check comparator order on projected keys.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn is_sorted_by_projected(data: &list<T>, less: Less,
                              projection: Projection) -> bool {
    let n: i64 = data.len();
    for i in 1..n {
        if less(projection(data[i]), projection(data[i - 1])) {
            return false;
        }
    }
    return true;
}

/// @brief Return the first projected comparator-order violation, or length.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn is_sorted_until_by_projected(data: &list<T>, less: Less,
                                   projection: Projection) -> i64 {
    let n: i64 = data.len();
    for i in 1..n {
        if less(projection(data[i]), projection(data[i - 1])) { return i; }
    }
    return n;
}

/// @brief Comparator-based lower bound for a range sorted by `less`.
/// @ingroup algorithm_ranges
generic<T, U, Less>
pub fn lower_bound_by(data: &list<T>, value: U, less: Less) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = data.len();
    while lo < hi {
        let mid: i64 = lo + (hi - lo) / 2;
        if less(data[mid], value) {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

/// @brief Comparator-based upper bound for a range sorted by `less`.
/// @ingroup algorithm_ranges
generic<T, U, Less>
pub fn upper_bound_by(data: &list<T>, value: U, less: Less) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = data.len();
    while lo < hi {
        let mid: i64 = lo + (hi - lo) / 2;
        if less(value, data[mid]) {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    return lo;
}

/// @brief Return the equivalent-value index range under `less`.
/// Requires input sorted according to the same strict ordering.
/// @ingroup algorithm_ranges
generic<T, U, Less>
pub fn equal_range_by(data: &list<T>, value: U, less: Less) -> tuple<i64, i64> {
    let first: i64 = lower_bound_by(data, value, less);
    let last: i64 = upper_bound_by(data, value, less);
    return (first, last);
}

/// @brief Check whether a comparator-sorted range contains `value`.
/// @ingroup algorithm_ranges
generic<T, U, Less>
pub fn binary_search_by(data: &list<T>, value: U, less: Less) -> bool {
    var lo: i64 = 0;
    var hi: i64 = data.len();
    while lo < hi {
        let mid: i64 = lo + (hi - lo) / 2;
        if less(data[mid], value) {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo >= data.len() {
        return false;
    }
    return !less(data[lo], value) && !less(value, data[lo]);
}

/// @brief Return the index of the smallest element, or -1 for an empty list.
/// @ingroup algorithm_ranges
generic<T>
pub fn min_element_index(data: &list<T>) -> i64 {
    let n: i64 = data.len();
    if n == 0 {
        return -1;
    }
    var best: i64 = 0;
    for i in 1..n {
        if data[i] < data[best] {
            best = i;
        }
    }
    return best;
}

/// @brief Return the index of the largest element, or -1 for an empty list.
/// @ingroup algorithm_ranges
generic<T>
pub fn max_element_index(data: &list<T>) -> i64 {
    let n: i64 = data.len();
    if n == 0 {
        return -1;
    }
    var best: i64 = 0;
    for i in 1..n {
        if data[i] > data[best] {
            best = i;
        }
    }
    return best;
}

/// @brief Return the first minimum and last maximum indices in one pass.
/// Empty input returns `(-1, -1)`, matching C++20 `std::ranges::minmax_element`
/// with index sentinels instead of iterators.
/// @ingroup algorithm_ranges
generic<T>
pub fn minmax_element_index(data: &list<T>) -> tuple<i64, i64> {
    let n: i64 = data.len();
    if n == 0 {
        return (-1, -1);
    }
    var minimum: i64 = 0;
    var maximum: i64 = 0;
    for i in 1..n {
        if data[i] < data[minimum] {
            minimum = i;
        }
        if !(data[i] < data[maximum]) {
            maximum = i;
        }
    }
    return (minimum, maximum);
}

/// @brief Return the smallest element of a nonempty range.
/// Use `min_element_index` to handle an empty range without a precondition.
/// @ingroup algorithm_ranges
generic<T>
pub fn min_element_value(data: &list<T>) -> T {
    let n: i64 = data.len();
    var best: T = data[0];
    for i in 1..n {
        if data[i] < best {
            best = data[i];
        }
    }
    return best;
}

/// @brief Return the largest element of a nonempty range.
/// Use `max_element_index` to handle an empty range without a precondition.
/// @ingroup algorithm_ranges
generic<T>
pub fn max_element_value(data: &list<T>) -> T {
    let n: i64 = data.len();
    var best: T = data[0];
    for i in 1..n {
        if data[i] > best {
            best = data[i];
        }
    }
    return best;
}

/// @brief Return the smallest element, or `None` when the range is empty.
/// Safe value-returning counterpart to `min_element_index`.
/// @ingroup algorithm_ranges
generic<T>
pub fn min_element(data: &list<T>) -> option<T> {
    let n: i64 = data.len();
    if n == 0 { return None<T>(); }
    var best: T = data[0];
    for i in 1..n {
        if data[i] < best { best = data[i]; }
    }
    return Some<T>(best);
}

/// @brief Return the largest element, or `None` when the range is empty.
/// Safe value-returning counterpart to `max_element_index`.
/// @ingroup algorithm_ranges
generic<T>
pub fn max_element(data: &list<T>) -> option<T> {
    let n: i64 = data.len();
    if n == 0 { return None<T>(); }
    var best: T = data[0];
    for i in 1..n {
        if data[i] > best { best = data[i]; }
    }
    return Some<T>(best);
}

/// @brief Return minimum and maximum values together, or `None` if empty.
/// The minimum is the first equivalent value and maximum the last.
/// @ingroup algorithm_ranges
generic<T>
pub fn minmax_element(data: &list<T>) -> option<tuple<T, T>> {
    let n: i64 = data.len();
    if n == 0 { return None<tuple<T, T>>(); }
    var minimum: T = data[0];
    var maximum: T = data[0];
    for i in 1..n {
        let value: T = data[i];
        if value < minimum { minimum = value; }
        if !(value < maximum) { maximum = value; }
    }
    return Some<tuple<T, T>>((minimum, maximum));
}

/// @brief Comparator-based safe minimum; returns `None` for an empty range.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn min_element_by(data: &list<T>, less: Less) -> option<T> {
    let n: i64 = data.len();
    if n == 0 { return None<T>(); }
    var best: T = data[0];
    for i in 1..n {
        if less(data[i], best) { best = data[i]; }
    }
    return Some<T>(best);
}

/// @brief Comparator-based safe maximum; returns `None` for an empty range.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn max_element_by(data: &list<T>, less: Less) -> option<T> {
    let n: i64 = data.len();
    if n == 0 { return None<T>(); }
    var best: T = data[0];
    for i in 1..n {
        if less(best, data[i]) { best = data[i]; }
    }
    return Some<T>(best);
}

/// @brief Comparator-based safe min/max pair; returns `None` when empty.
/// Keeps the first minimum and last maximum among equivalent values.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn minmax_element_by(data: &list<T>, less: Less)
    -> option<tuple<T, T>> {
    let n: i64 = data.len();
    if n == 0 { return None<tuple<T, T>>(); }
    var minimum: T = data[0];
    var maximum: T = data[0];
    for i in 1..n {
        let value: T = data[i];
        if less(value, minimum) { minimum = value; }
        if !less(value, maximum) { maximum = value; }
    }
    return Some<tuple<T, T>>((minimum, maximum));
}

/// @brief Safe minimum selected by projected keys; returns the original value.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn min_element_projected(data: &list<T>, projection: Projection)
    -> option<T> {
    let n: i64 = data.len();
    if n == 0 { return None<T>(); }
    var best: T = data[0];
    var best_key = projection(best);
    for i in 1..n {
        let value: T = data[i];
        let key = projection(value);
        if key < best_key { best = value; best_key = key; }
    }
    return Some<T>(best);
}

/// @brief Safe maximum selected by projected keys; returns the original value.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn max_element_projected(data: &list<T>, projection: Projection)
    -> option<T> {
    let n: i64 = data.len();
    if n == 0 { return None<T>(); }
    var best: T = data[0];
    var best_key = projection(best);
    for i in 1..n {
        let value: T = data[i];
        let key = projection(value);
        if key > best_key { best = value; best_key = key; }
    }
    return Some<T>(best);
}

/// @brief Safe projected min/max pair; returns original values, or `None`.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn minmax_element_projected(data: &list<T>, projection: Projection)
    -> option<tuple<T, T>> {
    let n: i64 = data.len();
    if n == 0 { return None<tuple<T, T>>(); }
    var minimum: T = data[0];
    var maximum: T = data[0];
    var minimum_key = projection(minimum);
    var maximum_key = minimum_key;
    for i in 1..n {
        let value: T = data[i];
        let key = projection(value);
        if key < minimum_key { minimum = value; minimum_key = key; }
        if !(key < maximum_key) { maximum = value; maximum_key = key; }
    }
    return Some<tuple<T, T>>((minimum, maximum));
}

/// @brief Safe minimum selected by comparator and projection.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn min_element_by_projected(data: &list<T>, less: Less,
                                projection: Projection) -> option<T> {
    let n: i64 = data.len();
    if n == 0 { return None<T>(); }
    var best: T = data[0];
    var best_key = projection(best);
    for i in 1..n {
        let value: T = data[i];
        let key = projection(value);
        if less(key, best_key) { best = value; best_key = key; }
    }
    return Some<T>(best);
}

/// @brief Safe maximum selected by comparator and projection.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn max_element_by_projected(data: &list<T>, less: Less,
                                projection: Projection) -> option<T> {
    let n: i64 = data.len();
    if n == 0 { return None<T>(); }
    var best: T = data[0];
    var best_key = projection(best);
    for i in 1..n {
        let value: T = data[i];
        let key = projection(value);
        if less(best_key, key) { best = value; best_key = key; }
    }
    return Some<T>(best);
}

/// @brief Safe comparator/projection min/max pair; returns `None` if empty.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn minmax_element_by_projected(data: &list<T>, less: Less,
                                   projection: Projection)
    -> option<tuple<T, T>> {
    let n: i64 = data.len();
    if n == 0 { return None<tuple<T, T>>(); }
    var minimum: T = data[0];
    var maximum: T = data[0];
    var minimum_key = projection(minimum);
    var maximum_key = minimum_key;
    for i in 1..n {
        let value: T = data[i];
        let key = projection(value);
        if less(key, minimum_key) { minimum = value; minimum_key = key; }
        if !less(key, maximum_key) { maximum = value; maximum_key = key; }
    }
    return Some<tuple<T, T>>((minimum, maximum));
}

/// @brief Return the minimum and maximum values in one traversal.
/// Requires a nonempty input; use `minmax_element_index` to handle emptiness.
/// The minimum is the first equivalent value and maximum the last, matching
/// C++20 `std::ranges::minmax_element` tie behavior.
/// @ingroup algorithm_ranges
generic<T>
pub fn minmax_element_value(data: &list<T>) -> tuple<T, T> {
    var minimum: T = data[0];
    var maximum: T = data[0];
    let n: i64 = data.len();
    for i in 1..n {
        let value: T = data[i];
        if value < minimum {
            minimum = value;
        }
        if !(value < maximum) {
            maximum = value;
        }
    }
    return (minimum, maximum);
}

/// @brief Return the first minimum index under `less`, or -1 if empty.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn min_element_index_by(data: &list<T>, less: Less) -> i64 {
    let n: i64 = data.len();
    if n == 0 {
        return -1;
    }
    var best: i64 = 0;
    for i in 1..n {
        if less(data[i], data[best]) {
            best = i;
        }
    }
    return best;
}

/// @brief Return the first maximum index under `less`, or -1 if empty.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn max_element_index_by(data: &list<T>, less: Less) -> i64 {
    let n: i64 = data.len();
    if n == 0 {
        return -1;
    }
    var best: i64 = 0;
    for i in 1..n {
        if less(data[best], data[i]) {
            best = i;
        }
    }
    return best;
}

/// @brief Return the first minimum and last maximum indices under `less`.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn minmax_element_index_by(data: &list<T>, less: Less)
    -> tuple<i64, i64> {
    let n: i64 = data.len();
    if n == 0 {
        return (-1, -1);
    }
    var minimum: i64 = 0;
    var maximum: i64 = 0;
    for i in 1..n {
        if less(data[i], data[minimum]) {
            minimum = i;
        }
        if !less(data[i], data[maximum]) {
            maximum = i;
        }
    }
    return (minimum, maximum);
}

/// @brief Return the first minimum value under `less`; requires nonempty input.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn min_element_value_by(data: &list<T>, less: Less) -> T {
    var best: T = data[0];
    let n: i64 = data.len();
    for i in 1..n {
        if less(data[i], best) {
            best = data[i];
        }
    }
    return best;
}

/// @brief Return the first maximum value under `less`; requires nonempty input.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn max_element_value_by(data: &list<T>, less: Less) -> T {
    var best: T = data[0];
    let n: i64 = data.len();
    for i in 1..n {
        if less(best, data[i]) {
            best = data[i];
        }
    }
    return best;
}

/// @brief Return minimum and maximum values under `less` in one traversal.
/// Requires a nonempty input; minimum is first-equivalent and maximum is
/// last-equivalent, matching C++20 `std::ranges::minmax_element`.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn minmax_element_value_by(data: &list<T>, less: Less)
    -> tuple<T, T> {
    var minimum: T = data[0];
    var maximum: T = data[0];
    let n: i64 = data.len();
    for i in 1..n {
        let value: T = data[i];
        if less(value, minimum) {
            minimum = value;
        }
        if !less(value, maximum) {
            maximum = value;
        }
    }
    return (minimum, maximum);
}

/// @brief Return the first minimum index under projected-key ordering.
/// Returns -1 for an empty range.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn min_element_index_projected(data: &list<T>,
                                   projection: Projection) -> i64 {
    let n: i64 = data.len();
    if n == 0 { return -1; }
    var best: i64 = 0;
    for i in 1..n {
        if projection(data[i]) < projection(data[best]) { best = i; }
    }
    return best;
}

/// @brief Return the first maximum index under projected-key ordering.
/// Returns -1 for an empty range.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn max_element_index_projected(data: &list<T>,
                                   projection: Projection) -> i64 {
    let n: i64 = data.len();
    if n == 0 { return -1; }
    var best: i64 = 0;
    for i in 1..n {
        if projection(data[best]) < projection(data[i]) { best = i; }
    }
    return best;
}

/// @brief Return first-minimum and last-maximum indices by projected keys.
/// Empty input returns `(-1, -1)`.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn minmax_element_index_projected(data: &list<T>,
                                      projection: Projection)
    -> tuple<i64, i64> {
    let n: i64 = data.len();
    if n == 0 { return (-1, -1); }
    var minimum: i64 = 0;
    var maximum: i64 = 0;
    for i in 1..n {
        if projection(data[i]) < projection(data[minimum]) { minimum = i; }
        if !(projection(data[i]) < projection(data[maximum])) { maximum = i; }
    }
    return (minimum, maximum);
}

/// @brief Return the first value with a minimum projected key.
/// Requires a nonempty input.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn min_element_value_projected(data: &list<T>,
                                  projection: Projection) -> T {
    var best: T = data[0];
    let n: i64 = data.len();
    for i in 1..n {
        if projection(data[i]) < projection(best) { best = data[i]; }
    }
    return best;
}

/// @brief Return the first value with a maximum projected key.
/// Requires a nonempty input.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn max_element_value_projected(data: &list<T>,
                                  projection: Projection) -> T {
    var best: T = data[0];
    let n: i64 = data.len();
    for i in 1..n {
        if projection(best) < projection(data[i]) { best = data[i]; }
    }
    return best;
}

/// @brief Return first-minimum and last-maximum values by projected keys.
/// Requires nonempty input, matching C++20 ranges minmax tie behavior.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn minmax_element_value_projected(data: &list<T>,
                                      projection: Projection)
    -> tuple<T, T> {
    var minimum: T = data[0];
    var maximum: T = data[0];
    let n: i64 = data.len();
    for i in 1..n {
        let value: T = data[i];
        if projection(value) < projection(minimum) { minimum = value; }
        if !(projection(value) < projection(maximum)) { maximum = value; }
    }
    return (minimum, maximum);
}

/// @brief Return the first minimum index under comparator-projected ordering.
/// Returns -1 for an empty range.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn min_element_index_by_projected(data: &list<T>, less: Less,
                                      projection: Projection) -> i64 {
    let n: i64 = data.len();
    if n == 0 { return -1; }
    var best: i64 = 0;
    for i in 1..n {
        if less(projection(data[i]), projection(data[best])) { best = i; }
    }
    return best;
}

/// @brief Return the first maximum index under comparator-projected ordering.
/// Returns -1 for an empty range.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn max_element_index_by_projected(data: &list<T>, less: Less,
                                      projection: Projection) -> i64 {
    let n: i64 = data.len();
    if n == 0 { return -1; }
    var best: i64 = 0;
    for i in 1..n {
        if less(projection(data[best]), projection(data[i])) { best = i; }
    }
    return best;
}

/// @brief Return first-minimum and last-maximum indices under projected order.
/// Empty input returns `(-1, -1)`.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn minmax_element_index_by_projected(data: &list<T>, less: Less,
                                         projection: Projection)
    -> tuple<i64, i64> {
    let n: i64 = data.len();
    if n == 0 { return (-1, -1); }
    var minimum: i64 = 0;
    var maximum: i64 = 0;
    for i in 1..n {
        if less(projection(data[i]), projection(data[minimum])) {
            minimum = i;
        }
        if !less(projection(data[i]), projection(data[maximum])) {
            maximum = i;
        }
    }
    return (minimum, maximum);
}

/// @brief Return the minimum element index, or `None` for an empty range.
/// @ingroup algorithm_ranges
generic<T>
pub fn min_element_index_option(data: &list<T>) -> option<i64> {
    let index: i64 = min_element_index(data);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the maximum element index, or `None` for an empty range.
/// @ingroup algorithm_ranges
generic<T>
pub fn max_element_index_option(data: &list<T>) -> option<i64> {
    let index: i64 = max_element_index(data);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the first-minimum and last-maximum indices as an option.
/// @ingroup algorithm_ranges
generic<T>
pub fn minmax_element_index_option(data: &list<T>)
    -> option<tuple<i64, i64>> {
    let indices: tuple<i64, i64> = minmax_element_index(data);
    if indices.0 < 0 { return None<tuple<i64, i64>>(); }
    return Some<tuple<i64, i64>>(indices);
}

/// @brief Return the minimum index under `less`, or `None` if empty.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn min_element_index_by_option(data: &list<T>, less: Less)
    -> option<i64> {
    let index: i64 = min_element_index_by(data, less);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the maximum index under `less`, or `None` if empty.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn max_element_index_by_option(data: &list<T>, less: Less)
    -> option<i64> {
    let index: i64 = max_element_index_by(data, less);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return comparator-based extrema indices as an option.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn minmax_element_index_by_option(data: &list<T>, less: Less)
    -> option<tuple<i64, i64>> {
    let indices: tuple<i64, i64> = minmax_element_index_by(data, less);
    if indices.0 < 0 { return None<tuple<i64, i64>>(); }
    return Some<tuple<i64, i64>>(indices);
}

/// @brief Return the projected minimum index, or `None` if empty.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn min_element_index_projected_option(data: &list<T>,
                                          projection: Projection)
    -> option<i64> {
    let index: i64 = min_element_index_projected(data, projection);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the projected maximum index, or `None` if empty.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn max_element_index_projected_option(data: &list<T>,
                                          projection: Projection)
    -> option<i64> {
    let index: i64 = max_element_index_projected(data, projection);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return projected extrema indices as an option.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn minmax_element_index_projected_option(data: &list<T>,
                                             projection: Projection)
    -> option<tuple<i64, i64>> {
    let indices: tuple<i64, i64> =
        minmax_element_index_projected(data, projection);
    if indices.0 < 0 { return None<tuple<i64, i64>>(); }
    return Some<tuple<i64, i64>>(indices);
}

/// @brief Return comparator-projected minimum index, or `None` if empty.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn min_element_index_by_projected_option(
    data: &list<T>, less: Less, projection: Projection) -> option<i64> {
    let index: i64 = min_element_index_by_projected(data, less, projection);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return comparator-projected maximum index, or `None` if empty.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn max_element_index_by_projected_option(
    data: &list<T>, less: Less, projection: Projection) -> option<i64> {
    let index: i64 = max_element_index_by_projected(data, less, projection);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return comparator-projected extrema indices as an option.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn minmax_element_index_by_projected_option(
    data: &list<T>, less: Less, projection: Projection)
    -> option<tuple<i64, i64>> {
    let indices: tuple<i64, i64> =
        minmax_element_index_by_projected(data, less, projection);
    if indices.0 < 0 { return None<tuple<i64, i64>>(); }
    return Some<tuple<i64, i64>>(indices);
}

/// @brief Return the first value with a minimum comparator-projected key.
/// Requires a nonempty input.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn min_element_value_by_projected(data: &list<T>, less: Less,
                                      projection: Projection) -> T {
    var best: T = data[0];
    let n: i64 = data.len();
    for i in 1..n {
        if less(projection(data[i]), projection(best)) { best = data[i]; }
    }
    return best;
}

/// @brief Return the first value with a maximum comparator-projected key.
/// Requires a nonempty input.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn max_element_value_by_projected(data: &list<T>, less: Less,
                                      projection: Projection) -> T {
    var best: T = data[0];
    let n: i64 = data.len();
    for i in 1..n {
        if less(projection(best), projection(data[i])) { best = data[i]; }
    }
    return best;
}

/// @brief Return first-minimum and last-maximum values under projected order.
/// Requires a nonempty input.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn minmax_element_value_by_projected(data: &list<T>, less: Less,
                                         projection: Projection)
    -> tuple<T, T> {
    var minimum: T = data[0];
    var maximum: T = data[0];
    let n: i64 = data.len();
    for i in 1..n {
        let value: T = data[i];
        if less(projection(value), projection(minimum)) { minimum = value; }
        if !less(projection(value), projection(maximum)) { maximum = value; }
    }
    return (minimum, maximum);
}

/// @brief Return count of elements equal to value.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn count(data: &list<T>, value: U) -> i64 {
    var out: i64 = 0;
    let n: i64 = data.len();
    for i in 0..n {
        if data[i] == value {
            out = out + 1;
        }
    }
    return out;
}

/// @brief Count elements equivalent to `value` under `equivalent`.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn count_by(data: &list<T>, value: U, equivalent: Equivalent) -> i64 {
    var out: i64 = 0;
    let n: i64 = data.len();
    for i in 0..n {
        if equivalent(data[i], value) { out = out + 1; }
    }
    return out;
}

/// @brief Count projected element keys equivalent to `value`.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, Projection>
pub fn count_by_projected(data: &list<T>, value: U, equivalent: Equivalent,
                          projection: Projection) -> i64 {
    var out: i64 = 0;
    let n: i64 = data.len();
    for i in 0..n {
        if equivalent(projection(data[i]), value) { out = out + 1; }
    }
    return out;
}

/// @brief Count elements whose projected value equals `value`.
/// @ingroup algorithm_ranges
generic<T, U, Projection>
pub fn count_projected(data: &list<T>, value: U, projection: Projection) -> i64 {
    var count: i64 = 0;
    let n: i64 = data.len();
    for i in 0..n {
        if projection(data[i]) == value {
            count = count + 1;
        }
    }
    return count;
}

/// @brief Return true when value exists in the list.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn contains(data: &list<T>, value: U) -> bool {
    return find(data, value) >= 0;
}

/// @brief Test whether any element is equivalent to `value`.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn contains_by(data: &list<T>, value: U, equivalent: Equivalent) -> bool {
    return find_by(data, value, equivalent) >= 0;
}

/// @brief Test whether any projected element key matches `value` by equivalence.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, Projection>
pub fn contains_by_projected(data: &list<T>, value: U,
                             equivalent: Equivalent,
                             projection: Projection) -> bool {
    return find_by_projected(data, value, equivalent, projection) >= 0;
}

/// @brief Test whether any element's projected value equals `value`.
/// @ingroup algorithm_ranges
generic<T, U, Projection>
pub fn contains_projected(data: &list<T>, value: U, projection: Projection) -> bool {
    return find_projected(data, value, projection) >= 0;
}

/// @brief Copy a list while excluding values equal to `value`.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn remove(data: &list<T>, value: U) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let item: T = data[i];
        if item != value {
            out.push(item);
        }
    }
    return out;
}

/// @brief Copy a list, excluding values equivalent under `equivalent`.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn remove_by(data: &list<T>, value: U, equivalent: Equivalent) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let item: T = data[i];
        if !equivalent(item, value) { out.push(item); }
    }
    return out;
}

/// @brief Copy a list excluding projected keys equivalent to `value`.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, Projection>
pub fn remove_by_projected(data: &list<T>, value: U, equivalent: Equivalent,
                           projection: Projection) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let item: T = data[i];
        if !equivalent(projection(item), value) { out.push(item); }
    }
    return out;
}

/// @brief Copy a list while excluding elements with projected key `value`.
/// @ingroup algorithm_ranges
generic<T, U, Projection>
pub fn remove_projected(data: &list<T>, value: U,
                        projection: Projection) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if projection(data[i]) != value { out.push(data[i]); }
    }
    return out;
}

generic<T, Predicate, Projection>
fn ranges_remove_if_in_place_core(data: &mut list<T>, predicate: Predicate,
                                  projection: Projection) -> i64 {
    let n: i64 = data.len();
    var output: i64 = 0;
    for input in 0..n {
        let item: T = data[input];
        if !predicate(projection(item)) {
            if output != input { data[output] = item; }
            output = output + 1;
        }
    }
    return output;
}

/// @brief Compact a mutable list, retaining values not equal to `value`.
/// Returns the logical end index; values from that index to `len()` are
/// unspecified and the list length is unchanged.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn remove_in_place(data: &mut list<T>, value: U) -> i64 {
    let n: i64 = data.len();
    var output: i64 = 0;
    for input in 0..n {
        let item: T = data[input];
        if item != value {
            if output != input { data[output] = item; }
            output = output + 1;
        }
    }
    return output;
}

/// @brief Compact a mutable list by rejecting predicate-matching values.
/// Returns the logical end index; the suffix is unspecified and length stays
/// unchanged. The predicate is called exactly once per element.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn remove_if_in_place(data: &mut list<T>, predicate: Predicate) -> i64 {
    return ranges_remove_if_in_place_core(data, predicate, ranges_identity);
}

/// @brief Remove values whose projected key equals `value`, in place.
/// Returns the logical end index; the suffix is unspecified.
/// @ingroup algorithm_ranges
generic<T, U, Projection>
pub fn remove_in_place_projected(data: &mut list<T>, value: U,
                                 projection: Projection) -> i64 {
    let n: i64 = data.len();
    var output: i64 = 0;
    for input in 0..n {
        let item: T = data[input];
        if projection(item) != value {
            if output != input { data[output] = item; }
            output = output + 1;
        }
    }
    return output;
}

/// @brief Compact a mutable list using a predicate on projected keys.
/// Returns the logical end index; the suffix is unspecified and length remains
/// unchanged. Predicate and projection each run exactly once per element.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn remove_if_in_place_projected(data: &mut list<T>, predicate: Predicate,
                                    projection: Projection) -> i64 {
    return ranges_remove_if_in_place_core(data, predicate, projection);
}

/// @brief Erase every element equal to `value` from a mutable list.
/// Unlike `remove_in_place`, this shortens the list and returns the number
/// erased, matching C++20 `std::erase` container semantics.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn erase(data: &mut list<T>, value: U) -> i64 {
    var retained: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let item: T = data[i];
        if item != value { retained.push(item); }
    }
    let erased: i64 = n - retained.len();
    data.clear();
    data.extend(retained);
    return erased;
}

/// @brief Erase values equivalent to `value` under a custom predicate.
/// The retained list order is preserved and the number erased is returned.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn erase_by(data: &mut list<T>, value: U, equivalent: Equivalent) -> i64 {
    var retained: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let item: T = data[i];
        if !equivalent(item, value) { retained.push(item); }
    }
    let erased: i64 = n - retained.len();
    data.clear();
    data.extend(retained);
    return erased;
}

/// @brief Erase projected keys equivalent to `value` under a custom predicate.
/// Each projection and equivalence test runs once per original element.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, Projection>
pub fn erase_by_projected(data: &mut list<T>, value: U,
                          equivalent: Equivalent, projection: Projection)
    -> i64 {
    var retained: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let item: T = data[i];
        if !equivalent(projection(item), value) { retained.push(item); }
    }
    let erased: i64 = n - retained.len();
    data.clear();
    data.extend(retained);
    return erased;
}

/// @brief Erase every predicate-matching element from a mutable list.
/// Returns the number erased and shortens the list, matching C++20
/// `std::erase_if` container semantics. The predicate runs once per element.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn erase_if(data: &mut list<T>, predicate: Predicate) -> i64 {
    var retained: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let item: T = data[i];
        if !predicate(item) { retained.push(item); }
    }
    let erased: i64 = n - retained.len();
    data.clear();
    data.extend(retained);
    return erased;
}

/// @brief Erase elements accepted by a predicate over projected keys.
/// Projection and predicate each run once per element; retained elements and
/// their order are preserved.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn erase_if_projected(data: &mut list<T>, predicate: Predicate,
                          projection: Projection) -> i64 {
    var retained: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let item: T = data[i];
        if !predicate(projection(item)) { retained.push(item); }
    }
    let erased: i64 = n - retained.len();
    data.clear();
    data.extend(retained);
    return erased;
}

/// @brief Copy the first `n` elements (or all elements when n is larger).
/// @ingroup algorithm_ranges
generic<T>
pub fn take(data: &list<T>, n: i64) -> list<T> {
    var out: list<T> = [];
    if n <= 0 {
        return out;
    }
    let len: i64 = data.len();
    let end: i64 = n < len ? n : len;
    for i in 0..end {
        out.push(data[i]);
    }
    return out;
}

/// @brief Copy the initial prefix accepted by `predicate`.
/// Eager C++20 `views::take_while` equivalent.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn take_while(data: &list<T>, predicate: Predicate) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if !predicate(data[i]) {
            break;
        }
        out.push(data[i]);
    }
    return out;
}

/// @brief Copy the initial prefix whose projected keys satisfy `predicate`.
/// The output preserves original elements, not their projected keys.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn take_while_projected(data: &list<T>, predicate: Predicate,
                            projection: Projection) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if !predicate(projection(data[i])) { break; }
        out.push(data[i]);
    }
    return out;
}

/// @brief Copy an accepted prefix into bounded output storage.
/// Stops at the first rejected value, source end, or destination capacity and
/// returns `(consumed, written)`. The rejected value is tested but not counted
/// as consumed, allowing a caller to resume at that index.
/// @ingroup algorithm_ranges
generic<T, Output, Predicate>
pub fn take_while_to(source: &list<T>, destination: &mut list<Output>,
    predicate: Predicate) -> tuple<i64, i64> {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var consumed: i64 = 0;
    var written: i64 = 0;
    while consumed < source_len && written < destination_len {
        let value: T = source[consumed];
        if !predicate(value) { break; }
        destination[written] = value;
        consumed = consumed + 1;
        written = written + 1;
    }
    return (consumed, written);
}

/// @brief Project keys while copying an accepted prefix into bounded output.
/// The projected predicate tests each candidate; original values are
/// converted to the destination type. Returns `(consumed, written)` and leaves
/// the first rejected source value available for resumption.
/// @ingroup algorithm_ranges
generic<T, Output, Predicate, Projection>
pub fn take_while_to_projected(source: &list<T>,
    destination: &mut list<Output>, predicate: Predicate,
    projection: Projection) -> tuple<i64, i64> {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var consumed: i64 = 0;
    var written: i64 = 0;
    while consumed < source_len && written < destination_len {
        let value: T = source[consumed];
        if !predicate(projection(value)) { break; }
        destination[written] = value;
        consumed = consumed + 1;
        written = written + 1;
    }
    return (consumed, written);
}

/// @brief Materialize the integers in the half-open interval `[start, end)`.
/// This is an eager list counterpart to C++20 `std::views::iota`.
/// If `start >= end`, the result is empty.
/// @ingroup algorithm_ranges
pub fn iota(start: i64, end: i64) -> list<i64> {
    var out: list<i64> = [];
    if start >= end {
        return out;
    }
    for value in start..end {
        out.push(value);
    }
    return out;
}

/// @brief Materialize a half-open increasing range while preserving its type.
/// This is the typed counterpart to `iota(start: i64, end: i64)` and mirrors
/// C++20 `std::ranges::iota_view` for element types supporting comparison and
/// addition with one.
/// @ingroup algorithm_ranges
generic<T>
pub fn iota_range(start: T, end: T) -> list<T> {
    var out: list<T> = [];
    var value: T = start;
    while value < end {
        out.push(value);
        value = value + 1;
    }
    return out;
}

/// @brief Materialize a typed half-open progression using `step`.
/// Positive and negative steps follow the direction of the bounds. A zero
/// step, a step directed away from the bound, or arithmetic that stops making
/// progress yields an empty or safely terminated list.
/// @ingroup algorithm_ranges
generic<T>
pub fn iota_range_by(start: T, end: T, step: T) -> list<T> {
    var out: list<T> = [];
    if step == 0 {
        return out;
    }

    var value: T = start;
    if step > 0 {
        while value < end {
            out.push(value);
            let next: T = value + step;
            if next <= value {
                break;
            }
            value = next;
        }
    } else {
        while value > end {
            out.push(value);
            let next: T = value + step;
            if next >= value {
                break;
            }
            value = next;
        }
    }
    return out;
}

/// @brief Materialize a half-open integer progression using `step`.
/// Positive steps produce values below `end`; negative steps produce values
/// above `end`. A zero step or a step directed away from the bound returns an
/// empty list. This combines the behavior of C++20 `views::iota` with a
/// stride-style increment in an eager list.
/// @ingroup algorithm_ranges
pub fn iota_by(start: i64, end: i64, step: i64) -> list<i64> {
    var out: list<i64> = [];
    if step == 0 {
        return out;
    }

    var value: i64 = start;
    if step > 0 {
        while value < end {
            out.push(value);
            if value > 9223372036854775807 - step {
                break;
            }
            value = value + step;
        }
    } else {
        while value > end {
            out.push(value);
            if value < (-9223372036854775807 - 1) - step {
                break;
            }
            value = value + step;
        }
    }
    return out;
}

/// @brief Materialize a one-element list view of `value`.
/// Eager-list counterpart to the C++20 `std::views::single` view.
/// @ingroup algorithm_ranges
generic<T>
pub fn single(value: T) -> list<T> {
    var out: list<T> = [];
    out.push(value);
    return out;
}

/// @brief Materialize `count` copies of `value`.
/// Eager-list counterpart to the C++23 `std::views::repeat` view.
/// Non-positive counts return an empty list.
/// @ingroup algorithm_ranges
generic<T>
pub fn repeat(value: T, count: i64) -> list<T> {
    var out: list<T> = [];
    if count <= 0 {
        return out;
    }
    out.push(value);
    var i: i64 = 1;
    while i < count {
        out.push(out[0]);
        i = i + 1;
    }
    return out;
}

/// @brief Copy all elements after skipping the first `n`.
/// @ingroup algorithm_ranges
generic<T>
pub fn drop(data: &list<T>, n: i64) -> list<T> {
    var out: list<T> = [];
    let len: i64 = data.len();
    let start: i64 = n <= 0 ? 0 : n;
    if start >= len {
        return out;
    }
    for i in start..len {
        out.push(data[i]);
    }
    return out;
}

/// @brief Copy the half-open element interval `[first, last)`.
/// Eager-list counterpart to C++20 `std::ranges::subrange`; bounds are clamped
/// to `[0, len]`, and empty or reversed intervals yield an empty list.
/// @ingroup algorithm_ranges
generic<T>
pub fn subrange(data: &list<T>, first: i64, last: i64) -> list<T> {
    var out: list<T> = [];
    let len: i64 = data.len();
    let start: i64 = first < 0 ? 0 : (first > len ? len : first);
    let end: i64 = last < 0 ? 0 : (last > len ? len : last);
    if end <= start { return out; }
    for i in start..end { out.push(data[i]); }
    return out;
}

/// @brief Copy the final `count` elements of a list.
/// C++23 `views::take_last` eager-list counterpart; non-positive counts are
/// empty and counts at least the size copy the entire input.
/// @ingroup algorithm_ranges
generic<T>
pub fn take_last(data: &list<T>, count: i64) -> list<T> {
    var out: list<T> = [];
    let len: i64 = data.len();
    if count <= 0 { return out; }
    let start: i64 = count >= len ? 0 : len - count;
    for i in start..len { out.push(data[i]); }
    return out;
}

/// @brief Copy all but the final `count` elements of a list.
/// C++23 `views::drop_last` eager-list counterpart; non-positive counts copy
/// the entire input and counts at least the size produce an empty list.
/// @ingroup algorithm_ranges
generic<T>
pub fn drop_last(data: &list<T>, count: i64) -> list<T> {
    var out: list<T> = [];
    let len: i64 = data.len();
    let end: i64 = count <= 0 ? len : len - count;
    let bounded_end: i64 = end < 0 ? 0 : end;
    for i in 0..bounded_end { out.push(data[i]); }
    return out;
}

/// @brief Copy the range after skipping its initial predicate-matching prefix.
/// Eager C++20 `views::drop_while` equivalent.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn drop_while(data: &list<T>, predicate: Predicate) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    var start: i64 = 0;
    while start < n && predicate(data[start]) {
        start = start + 1;
    }
    for i in start..n {
        out.push(data[i]);
    }
    return out;
}

/// @brief Copy the range after skipping the prefix whose projected keys
/// satisfy `predicate`, preserving original elements in the output.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn drop_while_projected(data: &list<T>, predicate: Predicate,
                            projection: Projection) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    var start: i64 = 0;
    while start < n && predicate(projection(data[start])) {
        start = start + 1;
    }
    for i in start..n {
        out.push(data[i]);
    }
    return out;
}

/// @brief Skip a matching prefix and copy the remainder to bounded output.
/// Returns `(consumed, written)`; consumed includes both skipped elements and
/// copied values. No source values are inspected when the destination is empty.
/// @ingroup algorithm_ranges
generic<T, Output, Predicate>
pub fn drop_while_to(source: &list<T>, destination: &mut list<Output>,
    predicate: Predicate) -> tuple<i64, i64> {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    if destination_len == 0 { return (0, 0); }
    var consumed: i64 = 0;
    var written: i64 = 0;
    while consumed < source_len && predicate(source[consumed]) {
        consumed = consumed + 1;
    }
    while consumed < source_len && written < destination_len {
        destination[written] = source[consumed];
        consumed = consumed + 1;
        written = written + 1;
    }
    return (consumed, written);
}

/// @brief Project while skipping a prefix, then copy original values to output.
/// Returns `(consumed, written)`; consumed includes the dropped prefix and the
/// copied suffix. An empty destination causes no predicate/projection calls.
/// @ingroup algorithm_ranges
generic<T, Output, Predicate, Projection>
pub fn drop_while_to_projected(source: &list<T>,
    destination: &mut list<Output>, predicate: Predicate,
    projection: Projection) -> tuple<i64, i64> {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    if destination_len == 0 { return (0, 0); }
    var consumed: i64 = 0;
    var written: i64 = 0;
    while consumed < source_len &&
          predicate(projection(source[consumed])) {
        consumed = consumed + 1;
    }
    while consumed < source_len && written < destination_len {
        destination[written] = source[consumed];
        consumed = consumed + 1;
        written = written + 1;
    }
    return (consumed, written);
}

generic<T>
fn merge_sorted_runs(left: &list<T>, right: &list<T>) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var left_index: i64 = 0;
    var right_index: i64 = 0;

    while left_index < left_len && right_index < right_len {
        if left[left_index] <= right[right_index] {
            out.push(left[left_index]);
            left_index = left_index + 1;
        } else {
            out.push(right[right_index]);
            right_index = right_index + 1;
        }
    }
    while left_index < left_len {
        out.push(left[left_index]);
        left_index = left_index + 1;
    }
    while right_index < right_len {
        out.push(right[right_index]);
        right_index = right_index + 1;
    }
    return out;
}

/// @brief Return a stable, ascending sorted copy of a list.
/// The input is unchanged; elements must support ordering.
/// @ingroup algorithm_ranges
generic<T>
pub fn sorted(data: &list<T>) -> list<T> {
    let n: i64 = data.len();
    if n < 2 {
        return take(data, n);
    }
    let middle: i64 = n / 2;
    let left: list<T> = sorted(take(data, middle));
    let right: list<T> = sorted(drop(data, middle));
    return merge_sorted_runs(left, right);
}

generic<T, Less>
fn merge_sorted_runs_by(left: &list<T>, right: &list<T>, less: Less)
    -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if less(right[j], left[i]) {
            out.push(right[j]);
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
        }
    }
    while i < left_len {
        out.push(left[i]);
        i = i + 1;
    }
    while j < right_len {
        out.push(right[j]);
        j = j + 1;
    }
    return out;
}

/// @brief Return a stable copy sorted by the strict ordering `less`.
/// Equivalent elements keep their input order; the input is unchanged.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn sorted_by(data: &list<T>, less: Less) -> list<T> {
    let n: i64 = data.len();
    if n < 2 {
        return take(data, n);
    }
    let middle: i64 = n / 2;
    let left: list<T> = sorted_by(take(data, middle), less);
    let right: list<T> = sorted_by(drop(data, middle), less);
    return merge_sorted_runs_by(left, right, less);
}

generic<T, Projection>
fn merge_projected_runs(left: &list<T>, right: &list<T>,
                        projection: Projection) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if projection(right[j]) < projection(left[i]) {
            out.push(right[j]);
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
        }
    }
    while i < left_len {
        out.push(left[i]);
        i = i + 1;
    }
    while j < right_len {
        out.push(right[j]);
        j = j + 1;
    }
    return out;
}

generic<T, Less, Projection>
fn merge_by_projected_runs(left: &list<T>, right: &list<T>, less: Less,
                           projection: Projection) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        let right_key = projection(right[j]);
        let left_key = projection(left[i]);
        if less(right_key, left_key) {
            out.push(right[j]);
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
        }
    }
    while i < left_len { out.push(left[i]); i = i + 1; }
    while j < right_len { out.push(right[j]); j = j + 1; }
    return out;
}

/// @brief Return a stable copy ordered by each element's projected key.
/// Equal projected keys retain their input order; the input is unchanged.
/// C++20 `std::ranges::stable_sort` projection counterpart.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn sorted_projected(data: &list<T>, projection: Projection) -> list<T> {
    let n: i64 = data.len();
    if n < 2 {
        return take(data, n);
    }
    let middle: i64 = n / 2;
    let left: list<T> = sorted_projected(take(data, middle), projection);
    let right: list<T> = sorted_projected(drop(data, middle), projection);
    return merge_projected_runs(left, right, projection);
}

/// @brief Return a stable copy sorted by comparator over projected keys.
/// Equivalent projected keys retain their input order; the input is unchanged.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn sorted_by_projected(data: &list<T>, less: Less,
                           projection: Projection) -> list<T> {
    let n: i64 = data.len();
    if n < 2 { return take(data, n); }
    let middle: i64 = n / 2;
    let left: list<T> = sorted_by_projected(
        take(data, middle), less, projection);
    let right: list<T> = sorted_by_projected(
        drop(data, middle), less, projection);
    return merge_by_projected_runs(left, right, less, projection);
}

generic<T>
fn ranges_identity(value: T) -> T { return value; }

generic<T>
fn ranges_default_less(left: T, right: T) -> bool { return left < right; }

generic<T, Less, Projection>
fn ranges_sift_down_in_place(data: &mut list<T>, heap_len: i64, root: i64,
                             less: Less, projection: Projection) -> i64 {
    var parent: i64 = root;
    var swaps: i64 = 0;
    while parent < heap_len / 2 {
        let left: i64 = parent * 2 + 1;
        var larger: i64 = left;
        let right: i64 = left + 1;
        if right < heap_len &&
           less(projection(data[left]), projection(data[right])) {
            larger = right;
        }
        if !less(projection(data[parent]), projection(data[larger])) {
            break;
        }
        let temporary: T = data[parent];
        data[parent] = data[larger];
        data[larger] = temporary;
        swaps = swaps + 1;
        parent = larger;
    }
    return swaps;
}

generic<T, Less, Projection>
fn ranges_partial_sort_in_place_by_projected(
    data: &mut list<T>, count: i64, less: Less,
    projection: Projection) -> i64 {
    let n: i64 = data.len();
    var limit: i64 = count;
    if limit < 0 { limit = 0; }
    if limit > n { limit = n; }
    if limit == 0 { return 0; }

    var parent: i64 = limit / 2;
    while parent > 0 {
        parent = parent - 1;
        ranges_sift_down_in_place(&mut data, limit, parent, less, projection);
    }
    for i in limit..n {
        if less(projection(data[i]), projection(data[0])) {
            let temporary: T = data[0];
            data[0] = data[i];
            data[i] = temporary;
            ranges_sift_down_in_place(&mut data, limit, 0, less, projection);
        }
    }
    var heap_len: i64 = limit;
    while heap_len > 1 {
        heap_len = heap_len - 1;
        let temporary: T = data[0];
        data[0] = data[heap_len];
        data[heap_len] = temporary;
        ranges_sift_down_in_place(&mut data, heap_len, 0, less, projection);
    }
    return limit;
}

/// @brief Sort a mutable list in place using a heap-based O(N log N) sort.
/// Returns the number of element swaps; unlike `sorted`, this operation is
/// not stable and mutates its input.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn sort_in_place_by_projected(data: &mut list<T>, less: Less,
                                  projection: Projection) -> i64 {
    let n: i64 = data.len();
    var swaps: i64 = 0;
    var parent: i64 = n / 2;
    while parent > 0 {
        parent = parent - 1;
        swaps = swaps + ranges_sift_down_in_place(
            &mut data, n, parent, less, projection);
    }
    var heap_len: i64 = n;
    while heap_len > 1 {
        heap_len = heap_len - 1;
        let temporary: T = data[0];
        data[0] = data[heap_len];
        data[heap_len] = temporary;
        swaps = swaps + 1;
        if heap_len > 1 {
            swaps = swaps + ranges_sift_down_in_place(
                &mut data, heap_len, 0, less, projection);
        }
    }
    return swaps;
}

/// @brief Sort a mutable list by a strict comparison function.
/// Returns the number of swaps; equivalent values are not kept stable.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn sort_in_place_by(data: &mut list<T>, less: Less) -> i64 {
    let identity = |value: T| { return value; };
    return sort_in_place_by_projected(&mut data, less, identity);
}

/// @brief Sort a mutable list by its projected keys in place.
/// Returns the number of swaps.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn sort_in_place_projected(data: &mut list<T>,
                               projection: Projection) -> i64 {
    let less = |left: T, right: T| { return left < right; };
    return sort_in_place_by_projected(&mut data, less, projection);
}

/// @brief Sort a mutable list in ascending order in place.
/// Returns the number of swaps; use `sorted` when a stable copy is required.
/// @ingroup algorithm_ranges
generic<T>
pub fn sort_in_place(data: &mut list<T>) -> i64 {
    let less = |left: T, right: T| { return left < right; };
    let identity = |value: T| { return value; };
    return sort_in_place_by_projected(&mut data, less, identity);
}

/// @brief Build a mutable max-heap using comparator and projection.
/// Returns the number of swaps performed.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn make_heap_in_place_by_projected(
    data: &mut list<T>, less: Less, projection: Projection) -> i64 {
    let n: i64 = data.len();
    var swaps: i64 = 0;
    var parent: i64 = n / 2;
    while parent > 0 {
        parent = parent - 1;
        swaps = swaps + ranges_sift_down_in_place(
            &mut data, n, parent, less, projection);
    }
    return swaps;
}

/// @brief Build a mutable heap according to comparator `less`.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn make_heap_in_place_by(data: &mut list<T>, less: Less) -> i64 {
    let identity = |value: T| { return value; };
    return make_heap_in_place_by_projected(&mut data, less, identity);
}

/// @brief Build a mutable max-heap according to projected keys.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn make_heap_in_place_projected(
    data: &mut list<T>, projection: Projection) -> i64 {
    let less = |left: T, right: T| { return left < right; };
    return make_heap_in_place_by_projected(&mut data, less, projection);
}

/// @brief Build a mutable max-heap in place.
/// @ingroup algorithm_ranges
generic<T>
pub fn make_heap_in_place(data: &mut list<T>) -> i64 {
    let less = |left: T, right: T| { return left < right; };
    let identity = |value: T| { return value; };
    return make_heap_in_place_by_projected(&mut data, less, identity);
}

/// @brief Restore heap order after appending an element to a mutable heap.
/// The prefix excluding the final element must already be a heap. Returns the
/// number of swaps performed.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn push_heap_in_place_by_projected(
    data: &mut list<T>, less: Less, projection: Projection) -> i64 {
    let n: i64 = data.len();
    if n < 2 { return 0; }
    var child: i64 = n - 1;
    var swaps: i64 = 0;
    while child > 0 {
        let parent: i64 = (child - 1) / 2;
        if !less(projection(data[parent]), projection(data[child])) {
            break;
        }
        let temporary: T = data[parent];
        data[parent] = data[child];
        data[child] = temporary;
        swaps = swaps + 1;
        child = parent;
    }
    return swaps;
}

/// @brief Restore comparator-defined heap order after appending an element.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn push_heap_in_place_by(data: &mut list<T>, less: Less) -> i64 {
    let identity = |value: T| { return value; };
    return push_heap_in_place_by_projected(&mut data, less, identity);
}

/// @brief Restore projected max-heap order after appending an element.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn push_heap_in_place_projected(
    data: &mut list<T>, projection: Projection) -> i64 {
    let less = |left: T, right: T| { return left < right; };
    return push_heap_in_place_by_projected(&mut data, less, projection);
}

/// @brief Restore max-heap order after appending an element to a mutable heap.
/// @ingroup algorithm_ranges
generic<T>
pub fn push_heap_in_place(data: &mut list<T>) -> i64 {
    let less = |left: T, right: T| { return left < right; };
    let identity = |value: T| { return value; };
    return push_heap_in_place_by_projected(&mut data, less, identity);
}

/// @brief Move a mutable heap's top value to the final slot and restore its prefix.
/// The input must be a heap; returns the number of swaps performed.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn pop_heap_in_place_by_projected(
    data: &mut list<T>, less: Less, projection: Projection) -> i64 {
    let n: i64 = data.len();
    if n < 2 { return 0; }
    let last: i64 = n - 1;
    let temporary: T = data[0];
    data[0] = data[last];
    data[last] = temporary;
    return 1 + ranges_sift_down_in_place(
        &mut data, last, 0, less, projection);
}

/// @brief Pop the top of a comparator-defined heap into its final slot.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn pop_heap_in_place_by(data: &mut list<T>, less: Less) -> i64 {
    let identity = |value: T| { return value; };
    return pop_heap_in_place_by_projected(&mut data, less, identity);
}

/// @brief Pop the top of a projected max-heap into its final slot.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn pop_heap_in_place_projected(
    data: &mut list<T>, projection: Projection) -> i64 {
    let less = |left: T, right: T| { return left < right; };
    return pop_heap_in_place_by_projected(&mut data, less, projection);
}

/// @brief Pop the top of a mutable max-heap into its final slot.
/// @ingroup algorithm_ranges
generic<T>
pub fn pop_heap_in_place(data: &mut list<T>) -> i64 {
    let less = |left: T, right: T| { return left < right; };
    let identity = |value: T| { return value; };
    return pop_heap_in_place_by_projected(&mut data, less, identity);
}

/// @brief Sort a mutable heap in ascending comparator/projection order.
/// The input must be a heap; returns the number of swaps performed.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn sort_heap_in_place_by_projected(
    data: &mut list<T>, less: Less, projection: Projection) -> i64 {
    let n: i64 = data.len();
    var heap_len: i64 = n;
    var swaps: i64 = 0;
    while heap_len > 1 {
        heap_len = heap_len - 1;
        let temporary: T = data[0];
        data[0] = data[heap_len];
        data[heap_len] = temporary;
        swaps = swaps + 1 + ranges_sift_down_in_place(
            &mut data, heap_len, 0, less, projection);
    }
    return swaps;
}

/// @brief Sort a mutable comparator-defined heap.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn sort_heap_in_place_by(data: &mut list<T>, less: Less) -> i64 {
    let identity = |value: T| { return value; };
    return sort_heap_in_place_by_projected(&mut data, less, identity);
}

/// @brief Sort a mutable projected max-heap.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn sort_heap_in_place_projected(
    data: &mut list<T>, projection: Projection) -> i64 {
    let less = |left: T, right: T| { return left < right; };
    return sort_heap_in_place_by_projected(&mut data, less, projection);
}

/// @brief Sort a mutable max-heap in ascending order in place.
/// @ingroup algorithm_ranges
generic<T>
pub fn sort_heap_in_place(data: &mut list<T>) -> i64 {
    let less = |left: T, right: T| { return left < right; };
    let identity = |value: T| { return value; };
    return sort_heap_in_place_by_projected(&mut data, less, identity);
}

generic<T, Less, Projection>
fn ranges_stable_sort_in_place_by_projected(
    data: &mut list<T>, less: Less, projection: Projection) -> i64 {
    let ordered: list<T> = sorted_by_projected(data, less, projection);
    let n: i64 = ordered.len();
    for i in 0..n { data[i] = ordered[i]; }
    return n;
}

/// @brief Stably sort a mutable list using a strict comparator and projection.
/// Equal keys retain their original order; uses O(N) temporary list storage.
/// Returns the number of elements written.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn stable_sort_in_place_by_projected(
    data: &mut list<T>, less: Less, projection: Projection) -> i64 {
    return ranges_stable_sort_in_place_by_projected(
        &mut data, less, projection);
}

/// @brief Stably sort a mutable list by a caller-provided strict comparator.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn stable_sort_in_place_by(data: &mut list<T>, less: Less) -> i64 {
    let identity = |value: T| { return value; };
    return ranges_stable_sort_in_place_by_projected(
        &mut data, less, identity);
}

/// @brief Stably sort a mutable list by projected keys.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn stable_sort_in_place_projected(
    data: &mut list<T>, projection: Projection) -> i64 {
    let less = |left: T, right: T| { return left < right; };
    return ranges_stable_sort_in_place_by_projected(
        &mut data, less, projection);
}

/// @brief Stably sort a mutable list in ascending order.
/// @ingroup algorithm_ranges
generic<T>
pub fn stable_sort_in_place(data: &mut list<T>) -> i64 {
    let less = |left: T, right: T| { return left < right; };
    let identity = |value: T| { return value; };
    return ranges_stable_sort_in_place_by_projected(
        &mut data, less, identity);
}

/// @brief Sort only the smallest requested prefix of a mutable list.
/// The prefix is ascending and the remaining elements are not sorted. Counts
/// clamp to the list length; returns the number of prefix elements sorted.
/// @ingroup algorithm_ranges
generic<T>
pub fn partial_sort_in_place(data: &mut list<T>, count: i64) -> i64 {
    let less = |left: T, right: T| { return left < right; };
    let identity = |value: T| { return value; };
    return ranges_partial_sort_in_place_by_projected(
        &mut data, count, less, identity);
}

/// @brief Partially sort a mutable list using the strict ordering `less`.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn partial_sort_in_place_by(data: &mut list<T>, count: i64,
                                less: Less) -> i64 {
    let identity = |value: T| { return value; };
    return ranges_partial_sort_in_place_by_projected(
        &mut data, count, less, identity);
}

/// @brief Partially sort a mutable list by projected keys.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn partial_sort_in_place_projected(
    data: &mut list<T>, count: i64, projection: Projection) -> i64 {
    let less = |left: T, right: T| { return left < right; };
    return ranges_partial_sort_in_place_by_projected(
        &mut data, count, less, projection);
}

/// @brief Partially sort a mutable list by comparator over projected keys.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn partial_sort_in_place_by_projected(
    data: &mut list<T>, count: i64, less: Less,
    projection: Projection) -> i64 {
    return ranges_partial_sort_in_place_by_projected(
        &mut data, count, less, projection);
}

/// @brief Return the next lexicographic permutation and whether it exists.
/// If no next permutation exists, return the ascending first permutation.
/// The source range is unchanged (C++20 `std::ranges::next_permutation`).
/// @ingroup algorithm_ranges
generic<T>
pub fn next_permutation(data: &list<T>) -> tuple<bool, list<T>> {
    var out: list<T> = [];
    let n: i64 = data.len();
    var pivot: i64 = n - 2;
    while pivot >= 0 && !(data[pivot] < data[pivot + 1]) {
        pivot = pivot - 1;
    }
    if pivot < 0 {
        var i: i64 = n;
        while i > 0 {
            i = i - 1;
            out.push(data[i]);
        }
        return (false, out);
    }
    var successor: i64 = n - 1;
    while !(data[pivot] < data[successor]) {
        successor = successor - 1;
    }
    for i in 0..pivot {
        out.push(data[i]);
    }
    out.push(data[successor]);
    var i: i64 = n - 1;
    while i > successor {
        out.push(data[i]);
        i = i - 1;
    }
    out.push(data[pivot]);
    i = successor - 1;
    while i > pivot {
        out.push(data[i]);
        i = i - 1;
    }
    return (true, out);
}

/// @brief Next permutation under a strict ordering, with an unchanged input.
/// Wraps to the first permutation and returns false when no successor exists.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn next_permutation_by(data: &list<T>, less: Less)
    -> tuple<bool, list<T>> {
    var out: list<T> = [];
    let n: i64 = data.len();
    var pivot: i64 = n - 2;
    while pivot >= 0 && !less(data[pivot], data[pivot + 1]) {
        pivot = pivot - 1;
    }
    if pivot < 0 {
        var i: i64 = n;
        while i > 0 {
            i = i - 1;
            out.push(data[i]);
        }
        return (false, out);
    }
    var successor: i64 = n - 1;
    while !less(data[pivot], data[successor]) {
        successor = successor - 1;
    }
    for i in 0..pivot {
        out.push(data[i]);
    }
    out.push(data[successor]);
    var i: i64 = n - 1;
    while i > successor {
        out.push(data[i]);
        i = i - 1;
    }
    out.push(data[pivot]);
    i = successor - 1;
    while i > pivot {
        out.push(data[i]);
        i = i - 1;
    }
    return (true, out);
}

/// @brief Return the next permutation ordered by projected keys.
/// Wraps to the first key permutation and returns false when no successor exists.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn next_permutation_projected(data: &list<T>,
                                  projection: Projection)
    -> tuple<bool, list<T>> {
    var out: list<T> = [];
    let n: i64 = data.len();
    var pivot: i64 = n - 2;
    while pivot >= 0 && !(projection(data[pivot]) <
                          projection(data[pivot + 1])) {
        pivot = pivot - 1;
    }
    if pivot < 0 {
        var i: i64 = n;
        while i > 0 { i = i - 1; out.push(data[i]); }
        return (false, out);
    }
    var successor: i64 = n - 1;
    while !(projection(data[pivot]) < projection(data[successor])) {
        successor = successor - 1;
    }
    for i in 0..pivot { out.push(data[i]); }
    out.push(data[successor]);
    var i: i64 = n - 1;
    while i > successor { out.push(data[i]); i = i - 1; }
    out.push(data[pivot]);
    i = successor - 1;
    while i > pivot { out.push(data[i]); i = i - 1; }
    return (true, out);
}

/// @brief Advance a permutation under comparator-projected key ordering.
/// On wrap, returns false and reverses the source into the first arrangement.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn next_permutation_by_projected(data: &list<T>, less: Less,
                                     projection: Projection)
    -> tuple<bool, list<T>> {
    var out: list<T> = [];
    let n: i64 = data.len();
    var pivot: i64 = n - 2;
    while pivot >= 0 && !less(projection(data[pivot]),
                              projection(data[pivot + 1])) {
        pivot = pivot - 1;
    }
    if pivot < 0 {
        var i: i64 = n;
        while i > 0 { i = i - 1; out.push(data[i]); }
        return (false, out);
    }
    var successor: i64 = n - 1;
    while !less(projection(data[pivot]), projection(data[successor])) {
        successor = successor - 1;
    }
    for i in 0..pivot { out.push(data[i]); }
    out.push(data[successor]);
    var i: i64 = n - 1;
    while i > successor { out.push(data[i]); i = i - 1; }
    out.push(data[pivot]);
    i = successor - 1;
    while i > pivot { out.push(data[i]); i = i - 1; }
    return (true, out);
}

/// @brief Return the previous lexicographic permutation and whether it exists.
/// If no predecessor exists, return the descending last permutation.
/// @ingroup algorithm_ranges
generic<T>
pub fn prev_permutation(data: &list<T>) -> tuple<bool, list<T>> {
    var out: list<T> = [];
    let n: i64 = data.len();
    var pivot: i64 = n - 2;
    while pivot >= 0 && !(data[pivot] > data[pivot + 1]) {
        pivot = pivot - 1;
    }
    if pivot < 0 {
        var i: i64 = n;
        while i > 0 {
            i = i - 1;
            out.push(data[i]);
        }
        return (false, out);
    }
    var predecessor: i64 = n - 1;
    while !(data[pivot] > data[predecessor]) {
        predecessor = predecessor - 1;
    }
    for i in 0..pivot {
        out.push(data[i]);
    }
    out.push(data[predecessor]);
    var i: i64 = n - 1;
    while i > predecessor {
        out.push(data[i]);
        i = i - 1;
    }
    out.push(data[pivot]);
    i = predecessor - 1;
    while i > pivot {
        out.push(data[i]);
        i = i - 1;
    }
    return (true, out);
}

/// @brief Previous permutation under a strict ordering, with unchanged input.
/// Wraps to the last permutation and returns false when none exists.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn prev_permutation_by(data: &list<T>, less: Less)
    -> tuple<bool, list<T>> {
    var out: list<T> = [];
    let n: i64 = data.len();
    var pivot: i64 = n - 2;
    while pivot >= 0 && !less(data[pivot + 1], data[pivot]) {
        pivot = pivot - 1;
    }
    if pivot < 0 {
        var i: i64 = n;
        while i > 0 {
            i = i - 1;
            out.push(data[i]);
        }
        return (false, out);
    }
    var predecessor: i64 = n - 1;
    while !less(data[predecessor], data[pivot]) {
        predecessor = predecessor - 1;
    }
    for i in 0..pivot {
        out.push(data[i]);
    }
    out.push(data[predecessor]);
    var i: i64 = n - 1;
    while i > predecessor {
        out.push(data[i]);
        i = i - 1;
    }
    out.push(data[pivot]);
    i = predecessor - 1;
    while i > pivot {
        out.push(data[i]);
        i = i - 1;
    }
    return (true, out);
}

/// @brief Return the previous permutation ordered by projected keys.
/// Wraps to the last key permutation and returns false when none exists.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn prev_permutation_projected(data: &list<T>,
                                  projection: Projection)
    -> tuple<bool, list<T>> {
    var out: list<T> = [];
    let n: i64 = data.len();
    var pivot: i64 = n - 2;
    while pivot >= 0 && !(projection(data[pivot + 1]) <
                          projection(data[pivot])) {
        pivot = pivot - 1;
    }
    if pivot < 0 {
        var i: i64 = n;
        while i > 0 { i = i - 1; out.push(data[i]); }
        return (false, out);
    }
    var predecessor: i64 = n - 1;
    while !(projection(data[predecessor]) < projection(data[pivot])) {
        predecessor = predecessor - 1;
    }
    for i in 0..pivot { out.push(data[i]); }
    out.push(data[predecessor]);
    var i: i64 = n - 1;
    while i > predecessor { out.push(data[i]); i = i - 1; }
    out.push(data[pivot]);
    i = predecessor - 1;
    while i > pivot { out.push(data[i]); i = i - 1; }
    return (true, out);
}

/// @brief Retreat a permutation under comparator-projected key ordering.
/// On wrap, returns false and reverses the source into the last arrangement.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn prev_permutation_by_projected(data: &list<T>, less: Less,
                                     projection: Projection)
    -> tuple<bool, list<T>> {
    var out: list<T> = [];
    let n: i64 = data.len();
    var pivot: i64 = n - 2;
    while pivot >= 0 && !less(projection(data[pivot + 1]),
                              projection(data[pivot])) {
        pivot = pivot - 1;
    }
    if pivot < 0 {
        var i: i64 = n;
        while i > 0 { i = i - 1; out.push(data[i]); }
        return (false, out);
    }
    var predecessor: i64 = n - 1;
    while !less(projection(data[predecessor]), projection(data[pivot])) {
        predecessor = predecessor - 1;
    }
    for i in 0..pivot { out.push(data[i]); }
    out.push(data[predecessor]);
    var i: i64 = n - 1;
    while i > predecessor { out.push(data[i]); i = i - 1; }
    out.push(data[pivot]);
    i = predecessor - 1;
    while i > pivot { out.push(data[i]); i = i - 1; }
    return (true, out);
}

generic<T>
fn ranges_reverse_subrange_in_place(data: &mut list<T>, first: i64,
                                    last: i64) -> void {
    var left: i64 = first;
    var right: i64 = last - 1;
    while left < right {
        let temporary: T = data[left];
        data[left] = data[right];
        data[right] = temporary;
        left = left + 1;
        right = right - 1;
    }
}

generic<T, Less, Projection>
fn ranges_next_permutation_in_place_impl(
    data: &mut list<T>, less: Less, projection: Projection) -> bool {
    let n: i64 = data.len();
    var pivot: i64 = n - 2;
    while pivot >= 0 && !less(projection(data[pivot]),
                              projection(data[pivot + 1])) {
        pivot = pivot - 1;
    }
    if pivot < 0 {
        ranges_reverse_subrange_in_place(&mut data, 0, n);
        return false;
    }
    var successor: i64 = n - 1;
    while !less(projection(data[pivot]), projection(data[successor])) {
        successor = successor - 1;
    }
    let temporary: T = data[pivot];
    data[pivot] = data[successor];
    data[successor] = temporary;
    ranges_reverse_subrange_in_place(&mut data, pivot + 1, n);
    return true;
}

generic<T, Less, Projection>
fn ranges_prev_permutation_in_place_impl(
    data: &mut list<T>, less: Less, projection: Projection) -> bool {
    let n: i64 = data.len();
    var pivot: i64 = n - 2;
    while pivot >= 0 && !less(projection(data[pivot + 1]),
                              projection(data[pivot])) {
        pivot = pivot - 1;
    }
    if pivot < 0 {
        ranges_reverse_subrange_in_place(&mut data, 0, n);
        return false;
    }
    var predecessor: i64 = n - 1;
    while !less(projection(data[predecessor]), projection(data[pivot])) {
        predecessor = predecessor - 1;
    }
    let temporary: T = data[pivot];
    data[pivot] = data[predecessor];
    data[predecessor] = temporary;
    ranges_reverse_subrange_in_place(&mut data, pivot + 1, n);
    return true;
}

/// @brief Advance a mutable list to its next lexicographic permutation.
/// On wrap, reverse the range to its first permutation and return false.
/// @ingroup algorithm_ranges
generic<T>
pub fn next_permutation_in_place(data: &mut list<T>) -> bool {
    let less = |left: T, right: T| { return left < right; };
    let identity = |value: T| { return value; };
    return ranges_next_permutation_in_place_impl(
        &mut data, less, identity);
}

/// @brief Advance a mutable permutation under comparator `less`.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn next_permutation_in_place_by(data: &mut list<T>, less: Less) -> bool {
    let identity = |value: T| { return value; };
    return ranges_next_permutation_in_place_impl(
        &mut data, less, identity);
}

/// @brief Advance a mutable permutation by projected keys.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn next_permutation_in_place_projected(
    data: &mut list<T>, projection: Projection) -> bool {
    let less = |left: T, right: T| { return left < right; };
    return ranges_next_permutation_in_place_impl(
        &mut data, less, projection);
}

/// @brief Advance by comparator ordering over projected keys.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn next_permutation_in_place_by_projected(
    data: &mut list<T>, less: Less, projection: Projection) -> bool {
    return ranges_next_permutation_in_place_impl(&mut data, less, projection);
}

/// @brief Retreat a mutable list to its previous lexicographic permutation.
/// On wrap, reverse the range to its last permutation and return false.
/// @ingroup algorithm_ranges
generic<T>
pub fn prev_permutation_in_place(data: &mut list<T>) -> bool {
    let less = |left: T, right: T| { return left < right; };
    let identity = |value: T| { return value; };
    return ranges_prev_permutation_in_place_impl(
        &mut data, less, identity);
}

/// @brief Retreat a mutable permutation under comparator `less`.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn prev_permutation_in_place_by(data: &mut list<T>, less: Less) -> bool {
    let identity = |value: T| { return value; };
    return ranges_prev_permutation_in_place_impl(
        &mut data, less, identity);
}

/// @brief Retreat a mutable permutation by projected keys.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn prev_permutation_in_place_projected(
    data: &mut list<T>, projection: Projection) -> bool {
    let less = |left: T, right: T| { return left < right; };
    return ranges_prev_permutation_in_place_impl(
        &mut data, less, projection);
}

/// @brief Retreat by comparator ordering over projected keys.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn prev_permutation_in_place_by_projected(
    data: &mut list<T>, less: Less, projection: Projection) -> bool {
    return ranges_prev_permutation_in_place_impl(&mut data, less, projection);
}

/// @brief Return a reversed copy of a list.
/// @ingroup algorithm_ranges
generic<T>
pub fn reversed(data: &list<T>) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        out.push(data[n - 1 - i]);
    }
    return out;
}

/// @brief Reverse the elements of a mutable list in place.
/// Returns the number of element swaps performed.
/// @ingroup algorithm_ranges
generic<T>
pub fn reverse_in_place(data: &mut list<T>) -> i64 {
    let n: i64 = data.len();
    let swaps: i64 = n / 2;
    for i in 0..swaps {
        let opposite: i64 = n - 1 - i;
        let temporary: T = data[i];
        data[i] = data[opposite];
        data[opposite] = temporary;
    }
    return swaps;
}

generic<T>
fn ranges_reverse_segment_in_place(data: &mut list<T>, first: i64,
                                   last: i64) -> void {
    var left: i64 = first;
    var right: i64 = last;
    while left < right {
        right = right - 1;
        if left >= right { break; }
        let temporary: T = data[left];
        data[left] = data[right];
        data[right] = temporary;
        left = left + 1;
    }
}

/// @brief Rotate a mutable list left in place so `middle` becomes first.
/// Returns the index of the original first element after rotation, matching
/// `std::ranges::rotate`'s returned iterator. `middle` is clamped to the list
/// bounds; rotation uses at most O(N) swaps and allocates no output list.
/// @ingroup algorithm_ranges
generic<T>
pub fn rotate_in_place(data: &mut list<T>, middle: i64) -> i64 {
    let n: i64 = data.len();
    var split: i64 = middle;
    if split < 0 { split = 0; }
    if split > n { split = n; }
    if split == 0 || split == n { return n - split; }
    ranges_reverse_segment_in_place(data, 0, split);
    ranges_reverse_segment_in_place(data, split, n);
    ranges_reverse_segment_in_place(data, 0, n);
    return n - split;
}

/// @brief Copy a range in reverse order.
/// Eager-list counterpart to C++20 `std::ranges::reverse_copy`.
/// @ingroup algorithm_ranges
generic<T>
pub fn reverse_copy(data: &list<T>) -> list<T> {
    return reversed(data);
}

/// @brief Copy reversed values into existing bounded output storage.
/// Writes at most the destination length and returns the element count written.
/// Both input and destination lengths remain unchanged.
/// @ingroup algorithm_ranges
generic<T>
pub fn reverse_copy_to(source: &list<T>, destination: &mut list<T>) -> i64 {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var written: i64 = 0;
    while written < destination_len && written < source_len {
        destination[written] = source[source_len - written - 1];
        written = written + 1;
    }
    return written;
}

/// @brief Copy reversed values into bounded output of another element type.
/// Source values are converted as written; returns the number written.
/// @ingroup algorithm_ranges
generic<T, Output>
pub fn reverse_copy_to_heterogeneous(source: &list<T>,
    destination: &mut list<Output>) -> i64 {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var written: i64 = 0;
    while written < destination_len && written < source_len {
        destination[written] = source[source_len - written - 1];
        written = written + 1;
    }
    return written;
}

/// @brief Write projected reversed source values to bounded output.
/// @ingroup algorithm_ranges
generic<T, Output, Projection>
pub fn reverse_copy_to_projected(source: &list<T>,
    destination: &mut list<Output>, projection: Projection) -> i64 {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var written: i64 = 0;
    while written < destination_len && written < source_len {
        destination[written] = projection(source[source_len - written - 1]);
        written = written + 1;
    }
    return written;
}

/// @brief Return a copy rotated left by `amount` positions.
/// Negative amounts rotate right; amounts are normalized modulo list length.
/// @ingroup algorithm_ranges
generic<T>
pub fn rotate_left(data: &list<T>, amount: i64) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    if n == 0 {
        return out;
    }
    var start: i64 = amount % n;
    if start < 0 {
        start = start + n;
    }
    let tail_len: i64 = n - start;
    for offset in 0..n {
        let index: i64 = offset < tail_len
            ? start + offset
            : offset - tail_len;
        out.push(data[index]);
    }
    return out;
}

/// @brief Rotate a copied range so `middle` becomes its first element.
/// The split index is clamped to `[0, data.len()]`; unlike the in-place
/// C++20 algorithm, this eager-list counterpart leaves the input unchanged.
/// @ingroup algorithm_ranges
generic<T>
pub fn rotate(data: &list<T>, middle: i64) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    var split: i64 = middle;
    if split < 0 { split = 0; }
    if split > n { split = n; }
    for i in split..n {
        out.push(data[i]);
    }
    for i in 0..split {
        out.push(data[i]);
    }
    return out;
}

/// @brief Copy a range with the element at `middle` moved to the front.
/// The split index is clamped to `[0, data.len()]`; eager-list counterpart to
/// C++20 `std::ranges::rotate_copy`.
/// @ingroup algorithm_ranges
generic<T>
pub fn rotate_copy(data: &list<T>, middle: i64) -> list<T> {
    return rotate(data, middle);
}

/// @brief Copy a rotated range into existing bounded output storage.
/// The split is clamped to `[0, source.len()]`; writes the prefix of the full
/// rotated sequence that fits and returns the number of elements written.
/// @ingroup algorithm_ranges
generic<T>
pub fn rotate_copy_to(source: &list<T>, middle: i64,
                      destination: &mut list<T>) -> i64 {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var split: i64 = middle;
    if split < 0 { split = 0; }
    if split > source_len { split = source_len; }
    var written: i64 = 0;
    var source_index: i64 = split;
    while written < destination_len && source_index < source_len {
        destination[written] = source[source_index];
        written = written + 1;
        source_index = source_index + 1;
    }
    source_index = 0;
    while written < destination_len && source_index < split {
        destination[written] = source[source_index];
        written = written + 1;
        source_index = source_index + 1;
    }
    return written;
}

/// @brief Write a bounded rotated copy to a distinct destination element type.
/// Clamps `middle`, converts source values, and returns the number written.
/// @ingroup algorithm_ranges
generic<T, Output>
pub fn rotate_copy_to_heterogeneous(source: &list<T>, middle: i64,
    destination: &mut list<Output>) -> i64 {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var split: i64 = middle;
    if split < 0 { split = 0; }
    if split > source_len { split = source_len; }
    var written: i64 = 0;
    var source_index: i64 = split;
    while written < destination_len && source_index < source_len {
        destination[written] = source[source_index];
        written = written + 1;
        source_index = source_index + 1;
    }
    source_index = 0;
    while written < destination_len && source_index < split {
        destination[written] = source[source_index];
        written = written + 1;
        source_index = source_index + 1;
    }
    return written;
}

/// @brief Write projected rotated source values to bounded output.
/// The split point is clamped just like `rotate_copy_to`.
/// @ingroup algorithm_ranges
generic<T, Output, Projection>
pub fn rotate_copy_to_projected(source: &list<T>, middle: i64,
    destination: &mut list<Output>, projection: Projection) -> i64 {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var split: i64 = middle;
    if split < 0 { split = 0; }
    if split > source_len { split = source_len; }
    var written: i64 = 0;
    var source_index: i64 = split;
    while written < destination_len && source_index < source_len {
        destination[written] = projection(source[source_index]);
        written = written + 1;
        source_index = source_index + 1;
    }
    source_index = 0;
    while written < destination_len && source_index < split {
        destination[written] = projection(source[source_index]);
        written = written + 1;
        source_index = source_index + 1;
    }
    return written;
}

/// @brief Return the retained range after a left shift by `count` positions.
/// The suffix `[count, end)` is copied to the front; non-positive counts are
/// no-ops, and counts at least the input length produce an empty list.
/// Eager-list counterpart to C++20 `std::ranges::shift_left`.
/// @ingroup algorithm_ranges
generic<T>
pub fn shift_left(data: &list<T>, count: i64) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    var start: i64 = count;
    if start < 0 { start = 0; }
    if start > n { start = n; }
    for i in start..n {
        out.push(data[i]);
    }
    return out;
}

/// @brief Return the retained range after a right shift by `count` positions.
/// The prefix `[0, len-count)` is what C++20 `std::ranges::shift_right`
/// moves to the right; this eager-list counterpart returns that retained
/// prefix. Non-positive counts are no-ops; counts at least the length are empty.
/// @ingroup algorithm_ranges
generic<T>
pub fn shift_right(data: &list<T>, count: i64) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    var removed: i64 = count;
    if removed < 0 { removed = 0; }
    if removed > n { removed = n; }
    let retained: i64 = n - removed;
    for i in 0..retained {
        out.push(data[i]);
    }
    return out;
}

/// @brief Shift the retained suffix to the front of a mutable list.
/// Returns the new logical end index; elements in the remaining suffix are
/// unspecified. Non-positive counts are no-ops, and counts at least the length
/// return the beginning of the range.
/// @ingroup algorithm_ranges
generic<T>
pub fn shift_left_in_place(data: &mut list<T>, count: i64) -> i64 {
    let n: i64 = data.len();
    if count <= 0 { return n; }
    if count >= n { return 0; }
    let retained: i64 = n - count;
    for i in 0..retained { data[i] = data[i + count]; }
    return retained;
}

/// @brief Shift the retained prefix toward the end of a mutable list.
/// Returns the first index of the shifted range; preceding elements are
/// unspecified. Non-positive counts are no-ops, and counts at least the length
/// return the end of the range.
/// @ingroup algorithm_ranges
generic<T>
pub fn shift_right_in_place(data: &mut list<T>, count: i64) -> i64 {
    let n: i64 = data.len();
    if count <= 0 { return 0; }
    if count >= n { return n; }
    var source: i64 = n - count;
    while source > 0 {
        source = source - 1;
        data[source + count] = data[source];
    }
    return count;
}

/// @brief Materialize consecutive chunks of at most `chunk_size` elements.
/// Eager-list counterpart to C++23 `views::chunk`; non-positive sizes are empty.
/// @ingroup algorithm_ranges
generic<T>
pub fn chunked(data: &list<T>, chunk_size: i64) -> list<list<T>> {
    var out: list<list<T>> = [];
    let n: i64 = data.len();
    if chunk_size <= 0 || n == 0 {
        return out;
    }
    var start: i64 = 0;
    while start < n {
        var chunk: list<T> = [];
        let remaining: i64 = n - start;
        let actual_size: i64 = chunk_size < remaining
            ? chunk_size : remaining;
        let end: i64 = start + actual_size;
        for i in start..end {
            chunk.push(data[i]);
        }
        out.push(chunk);
        start = end;
    }
    return out;
}

/// @brief Write consecutive chunks into caller-provided bounded storage.
/// The final chunk may be shorter than `chunk_size`; returns the number of
/// chunks written and leaves unused destination entries unchanged.
/// @ingroup algorithm_ranges
generic<T>
pub fn chunked_to(data: &list<T>, destination: &mut list<list<T>>,
                  chunk_size: i64) -> i64 {
    let n: i64 = data.len();
    if chunk_size <= 0 || n == 0 { return 0; }
    let capacity: i64 = destination.len();
    var start: i64 = 0;
    var written: i64 = 0;
    while start < n && written < capacity {
        let remaining: i64 = n - start;
        let actual_size: i64 = chunk_size < remaining
            ? chunk_size : remaining;
        let end: i64 = start + actual_size;
        var chunk: list<T> = [];
        for i in start..end { chunk.push(data[i]); }
        destination[written] = chunk;
        written = written + 1;
        start = end;
    }
    return written;
}

/// @brief Write projected consecutive chunks into bounded output.
/// @ingroup algorithm_ranges
generic<T, Output, Projection>
pub fn chunked_to_projected(data: &list<T>,
    destination: &mut list<list<Output>>, chunk_size: i64,
    projection: Projection) -> i64 {
    let n: i64 = data.len();
    if chunk_size <= 0 || n == 0 { return 0; }
    let capacity: i64 = destination.len();
    var start: i64 = 0;
    var written: i64 = 0;
    while start < n && written < capacity {
        let remaining: i64 = n - start;
        let actual_size: i64 = chunk_size < remaining
            ? chunk_size : remaining;
        let end: i64 = start + actual_size;
        var chunk: list<Output> = [];
        for i in start..end { chunk.push(projection(data[i])); }
        destination[written] = chunk;
        written = written + 1;
        start = end;
    }
    return written;
}

/// @brief Group adjacent elements while `equivalent` accepts each pair.
/// Eager-list counterpart to C++23 `views::chunk_by`.
/// @ingroup algorithm_ranges
generic<T, Equivalent>
pub fn chunk_by(data: &list<T>, equivalent: Equivalent) -> list<list<T>> {
    var out: list<list<T>> = [];
    let n: i64 = data.len();
    if n == 0 {
        return out;
    }

    var chunk: list<T> = [];
    chunk.push(data[0]);
    for i in 1..n {
        if equivalent(data[i - 1], data[i]) {
            chunk.push(data[i]);
        } else {
            out.push(chunk);
            chunk = [];
            chunk.push(data[i]);
        }
    }
    out.push(chunk);
    return out;
}

/// @brief Group adjacent elements when their projected keys are equivalent.
/// Eager-list counterpart to projected C++23 `views::chunk_by`.
/// @ingroup algorithm_ranges
generic<T, Equivalent, Projection>
pub fn chunk_by_projected(data: &list<T>, equivalent: Equivalent,
                          projection: Projection) -> list<list<T>> {
    var out: list<list<T>> = [];
    let n: i64 = data.len();
    if n == 0 { return out; }

    var chunk: list<T> = [];
    chunk.push(data[0]);
    for i in 1..n {
        if equivalent(projection(data[i - 1]), projection(data[i])) {
            chunk.push(data[i]);
        } else {
            out.push(chunk);
            chunk = [];
            chunk.push(data[i]);
        }
    }
    out.push(chunk);
    return out;
}

/// @brief Write predicate-defined adjacent groups into bounded storage.
/// Each group is stable and maximal under `equivalent`; returns the number of
/// groups written and preserves unused destination entries.
/// @ingroup algorithm_ranges
generic<T, Equivalent>
pub fn chunk_by_to(data: &list<T>, destination: &mut list<list<T>>,
                   equivalent: Equivalent) -> i64 {
    let n: i64 = data.len();
    let capacity: i64 = destination.len();
    var start: i64 = 0;
    var written: i64 = 0;
    while start < n && written < capacity {
        var end: i64 = start + 1;
        while end < n && equivalent(data[end - 1], data[end]) {
            end = end + 1;
        }
        var group: list<T> = [];
        for i in start..end { group.push(data[i]); }
        destination[written] = group;
        written = written + 1;
        start = end;
    }
    return written;
}

/// @brief Write projected predicate-defined groups into bounded storage.
/// Original values are preserved in each output group.
/// @ingroup algorithm_ranges
generic<T, Output, Equivalent, Projection>
pub fn chunk_by_to_projected(data: &list<T>,
    destination: &mut list<list<T>>, equivalent: Equivalent,
    projection: Projection) -> i64 {
    let n: i64 = data.len();
    let capacity: i64 = destination.len();
    var start: i64 = 0;
    var written: i64 = 0;
    while start < n && written < capacity {
        var end: i64 = start + 1;
        while end < n && equivalent(projection(data[end - 1]),
                                    projection(data[end])) {
            end = end + 1;
        }
        var group: list<T> = [];
        for i in start..end { group.push(data[i]); }
        destination[written] = group;
        written = written + 1;
        start = end;
    }
    return written;
}

/// @brief Materialize every overlapping window of `window_size` elements.
/// Eager-list counterpart to C++23 `views::slide`; invalid sizes return empty.
/// @ingroup algorithm_ranges
generic<T>
pub fn windows(data: &list<T>, window_size: i64) -> list<list<T>> {
    var out: list<list<T>> = [];
    let n: i64 = data.len();
    if window_size <= 0 || window_size > n {
        return out;
    }
    let last_start: i64 = n - window_size;
    for start in 0..(last_start + 1) {
        var window: list<T> = [];
        for offset in 0..window_size {
            window.push(data[start + offset]);
        }
        out.push(window);
    }
    return out;
}

/// @brief Write overlapping sliding windows into caller-provided storage.
/// Only complete windows are emitted. Returns the number written and leaves
/// the unused destination suffix unchanged.
/// @ingroup algorithm_ranges
generic<T>
pub fn windows_to(data: &list<T>, destination: &mut list<list<T>>,
                  window_size: i64) -> i64 {
    let n: i64 = data.len();
    if window_size <= 0 || window_size > n { return 0; }
    let capacity: i64 = destination.len();
    let possible: i64 = n - window_size + 1;
    var count: i64 = possible;
    if capacity < count { count = capacity; }
    for start in 0..count {
        var window: list<T> = [];
        for offset in 0..window_size {
            window.push(data[start + offset]);
        }
        destination[start] = window;
    }
    return count;
}

/// @brief Write projected overlapping windows into caller-provided storage.
/// @ingroup algorithm_ranges
generic<T, Output, Projection>
pub fn windows_to_projected(data: &list<T>,
    destination: &mut list<list<Output>>, window_size: i64,
    projection: Projection) -> i64 {
    let n: i64 = data.len();
    if window_size <= 0 || window_size > n { return 0; }
    let capacity: i64 = destination.len();
    let possible: i64 = n - window_size + 1;
    var count: i64 = possible;
    if capacity < count { count = capacity; }
    for start in 0..count {
        var window: list<Output> = [];
        for offset in 0..window_size {
            window.push(projection(data[start + offset]));
        }
        destination[start] = window;
    }
    return count;
}

/// @brief Copy every `stride`-th element, starting at index zero.
/// Eager-list counterpart to C++23 `views::stride`; non-positive strides are empty.
/// @ingroup algorithm_ranges
generic<T>
pub fn strided(data: &list<T>, stride: i64) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    if stride <= 0 {
        return out;
    }
    var index: i64 = 0;
    while index < n {
        out.push(data[index]);
        index = index + stride;
    }
    return out;
}

/// @brief Copy every `stride`-th element into bounded output.
/// Sampling begins at source index zero. Non-positive strides write nothing;
/// the return value is the number of elements written.
/// @ingroup algorithm_ranges
generic<T>
pub fn strided_to(source: &list<T>, destination: &mut list<T>,
                  stride: i64) -> i64 {
    if stride <= 0 { return 0; }
    let source_len: i64 = source.len();
    let capacity: i64 = destination.len();
    var source_index: i64 = 0;
    var written: i64 = 0;
    while source_index < source_len && written < capacity {
        destination[written] = source[source_index];
        written = written + 1;
        if stride >= source_len - source_index { break; }
        source_index = source_index + stride;
    }
    return written;
}

/// @brief Copy every `stride`-th projected element into bounded output.
/// @ingroup algorithm_ranges
generic<T, Output, Projection>
pub fn strided_to_projected(source: &list<T>,
    destination: &mut list<Output>, stride: i64,
    projection: Projection) -> i64 {
    if stride <= 0 { return 0; }
    let source_len: i64 = source.len();
    let capacity: i64 = destination.len();
    var source_index: i64 = 0;
    var written: i64 = 0;
    while source_index < source_len && written < capacity {
        destination[written] = projection(source[source_index]);
        written = written + 1;
        if stride >= source_len - source_index { break; }
        source_index = source_index + stride;
    }
    return written;
}

/// @brief Flatten a list of lists into one copied list.
/// Eager-list counterpart to the C++20 `views::join` adaptor.
/// @ingroup algorithm_ranges
generic<T>
pub fn joined(data: &list<list<T>>) -> list<T> {
    var out: list<T> = [];
    let outer_len: i64 = data.len();
    for outer_index in 0..outer_len {
        let inner: list<T> = data[outer_index];
        let inner_len: i64 = inner.len();
        for inner_index in 0..inner_len {
            out.push(inner[inner_index]);
        }
    }
    return out;
}

/// @brief Flatten a list of lists, inserting `separator` between each pair
/// of inner lists. The separator is inserted even when an inner list is empty.
/// Eager-list counterpart to C++23 `views::join_with`.
/// @ingroup algorithm_ranges
generic<T>
pub fn joined_with(data: &list<list<T>>, separator: &list<T>) -> list<T> {
    var out: list<T> = [];
    let outer_len: i64 = data.len();
    let separator_len: i64 = separator.len();
    for outer_index in 0..outer_len {
        if outer_index > 0 {
            for separator_index in 0..separator_len {
                out.push(separator[separator_index]);
            }
        }
        let inner: list<T> = data[outer_index];
        let inner_len: i64 = inner.len();
        for inner_index in 0..inner_len {
            out.push(inner[inner_index]);
        }
    }
    return out;
}

/// @brief C++23 `views::chunk` spelling for `chunked`.
/// Materializes the same eager list-of-lists result.
/// @ingroup algorithm_ranges
generic<T>
pub fn chunk(data: &list<T>, chunk_size: i64) -> list<list<T>> {
    return chunked(data, chunk_size);
}

/// @brief Bounded spelling of the C++23 `views::chunk` operation.
/// @ingroup algorithm_ranges
generic<T>
pub fn chunk_to(data: &list<T>, destination: &mut list<list<T>>,
                chunk_size: i64) -> i64 {
    return chunked_to(data, destination, chunk_size);
}

/// @brief Projected bounded spelling of `views::chunk`.
/// @ingroup algorithm_ranges
generic<T, Output, Projection>
pub fn chunk_to_projected(data: &list<T>,
    destination: &mut list<list<Output>>, chunk_size: i64,
    projection: Projection) -> i64 {
    return chunked_to_projected(data, destination, chunk_size, projection);
}

/// @brief C++23 `views::slide` spelling for `windows`.
/// Materializes every overlapping fixed-size sublist.
/// @ingroup algorithm_ranges
generic<T>
pub fn slide(data: &list<T>, window_size: i64) -> list<list<T>> {
    return windows(data, window_size);
}

/// @brief Bounded spelling of the C++23 `views::slide` operation.
/// @ingroup algorithm_ranges
generic<T>
pub fn slide_to(data: &list<T>, destination: &mut list<list<T>>,
                window_size: i64) -> i64 {
    return windows_to(data, destination, window_size);
}

/// @brief Projected bounded spelling of `views::slide`.
/// @ingroup algorithm_ranges
generic<T, Output, Projection>
pub fn slide_to_projected(data: &list<T>,
    destination: &mut list<list<Output>>, window_size: i64,
    projection: Projection) -> i64 {
    return windows_to_projected(data, destination, window_size, projection);
}

/// @brief C++23 `views::stride` spelling for `strided`.
/// Copies every `stride`-th element starting at index zero.
/// @ingroup algorithm_ranges
generic<T>
pub fn stride(data: &list<T>, stride: i64) -> list<T> {
    return strided(data, stride);
}

/// @brief C++20 `views::join` spelling for `joined`.
/// Flattens one list-of-lists level into an eager copied list.
/// @ingroup algorithm_ranges
generic<T>
pub fn join(data: &list<list<T>>) -> list<T> {
    return joined(data);
}

/// @brief C++23 `views::join_with` spelling for `joined_with`.
/// Flattens one level and inserts a separator between each pair of lists.
/// @ingroup algorithm_ranges
generic<T>
pub fn join_with(data: &list<list<T>>, separator: &list<T>) -> list<T> {
    return joined_with(data, separator);
}

/// @brief Split a range at each non-overlapping occurrence of `delimiter`.
/// Empty fields are retained between leading, adjacent, and trailing matches.
/// An empty input produces no fields; an empty delimiter returns the whole
/// nonempty input as one field. Eager C++20 `views::split` counterpart.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn split(data: &list<T>, delimiter: &list<U>) -> list<list<T>> {
    var parts: list<list<T>> = [];
    let data_len: i64 = data.len();
    let delimiter_len: i64 = delimiter.len();
    if data_len == 0 {
        return parts;
    }
    if delimiter_len == 0 {
        var whole: list<T> = [];
        for i in 0..data_len {
            whole.push(data[i]);
        }
        parts.push(whole);
        return parts;
    }

    var segment: list<T> = [];
    var index: i64 = 0;
    while index < data_len {
        var matches: bool = false;
        if delimiter_len <= data_len - index {
            matches = true;
            for offset in 0..delimiter_len {
                if data[index + offset] != delimiter[offset] {
                    matches = false;
                    break;
                }
            }
        }

        if matches {
            parts.push(segment);
            segment = [];
            index = index + delimiter_len;
        } else {
            segment.push(data[index]);
            index = index + 1;
        }
    }
    parts.push(segment);
    return parts;
}

/// @brief Concatenate two ranges into a copied list.
/// Eager-list counterpart to C++23 `views::concat` for two same-typed inputs.
/// @ingroup algorithm_ranges
generic<T>
pub fn concat(left: &list<T>, right: &list<T>) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    for i in 0..left_len {
        out.push(left[i]);
    }
    for i in 0..right_len {
        out.push(right[i]);
    }
    return out;
}

/// @brief Concatenate a list of ranges into one copied list.
/// An empty outer list or empty inner range contributes no elements.
/// Eager-list counterpart to a multi-input C++23 `views::concat`.
/// @ingroup algorithm_ranges
generic<T>
pub fn concat_many(ranges: &list<list<T>>) -> list<T> {
    var out: list<T> = [];
    let range_count: i64 = ranges.len();
    for range_index in 0..range_count {
        let range: list<T> = ranges[range_index];
        let element_count: i64 = range.len();
        for element_index in 0..element_count {
            out.push(range[element_index]);
        }
    }
    return out;
}

/// @brief Concatenate ranges into a bounded caller-provided output list.
/// Values are converted to `Output` as they are written. Stops when the
/// destination fills and returns the number of elements written.
/// @ingroup algorithm_ranges
generic<T>
pub fn concat_many_to(ranges: &list<list<T>>,
                      destination: &mut list<T>) -> i64 {
    let range_count: i64 = ranges.len();
    let destination_len: i64 = destination.len();
    var written: i64 = 0;
    for range_index in 0..range_count {
        let range: list<T> = ranges[range_index];
        let element_count: i64 = range.len();
        for element_index in 0..element_count {
            if written >= destination_len {
                return written;
            }
            destination[written] = range[element_index];
            written = written + 1;
        }
    }
    return written;
}

/// @brief Concatenate ranges into bounded output after projecting each value.
/// Stops when the destination fills and returns the number of elements
/// written; the input values remain unchanged.
/// @ingroup algorithm_ranges
generic<T, Output, Projection>
pub fn concat_many_to_projected(
    ranges: &list<list<T>>, destination: &mut list<Output>,
    projection: Projection) -> i64 {
    let range_count: i64 = ranges.len();
    let destination_len: i64 = destination.len();
    var written: i64 = 0;
    for range_index in 0..range_count {
        let range: list<T> = ranges[range_index];
        let element_count: i64 = range.len();
        for element_index in 0..element_count {
            if written >= destination_len {
                return written;
            }
            destination[written] = projection(range[element_index]);
            written = written + 1;
        }
    }
    return written;
}

/// @brief Pair corresponding elements into tuples, stopping at the shorter list.
/// Eager C++23 `views::zip` equivalent; both inputs remain unchanged.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn zip(left: &list<T>, right: &list<U>) -> list<tuple<T, U>> {
    var out: list<tuple<T, U>> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let n: i64 = left_len < right_len ? left_len : right_len;
    for i in 0..n {
        out.push((left[i], right[i]));
    }
    return out;
}

/// @brief Pair corresponding elements from three ranges, stopping at the
/// shortest input. C++23 `views::zip` counterpart with heterogeneous inputs.
/// @ingroup algorithm_ranges
generic<T, U, V>
pub fn zip(first: &list<T>, second: &list<U>, third: &list<V>)
    -> list<tuple<T, U, V>> {
    var out: list<tuple<T, U, V>> = [];
    let first_len: i64 = first.len();
    let second_len: i64 = second.len();
    let third_len: i64 = third.len();
    var n: i64 = first_len;
    if second_len < n {
        n = second_len;
    }
    if third_len < n {
        n = third_len;
    }
    for i in 0..n {
        out.push((first[i], second[i], third[i]));
    }
    return out;
}

/// @brief Zip four heterogeneous ranges, stopping at the shortest input.
/// C++23 `views::zip` eager-list counterpart.
/// @ingroup algorithm_ranges
generic<T, U, V, W>
pub fn zip(first: &list<T>, second: &list<U>, third: &list<V>,
          fourth: &list<W>) -> list<tuple<T, U, V, W>> {
    var out: list<tuple<T, U, V, W>> = [];
    var n: i64 = first.len();
    if second.len() < n { n = second.len(); }
    if third.len() < n { n = third.len(); }
    if fourth.len() < n { n = fourth.len(); }
    for i in 0..n {
        out.push((first[i], second[i], third[i], fourth[i]));
    }
    return out;
}

