        less, projection, 0);
}

/// @brief Write sorted intersection into a bounded destination.
/// Output retains the minimum multiplicity and left-side representatives.
/// @ingroup algorithm_ranges
generic<T>
pub fn intersection_sorted_to(left: &list<T>, right: &list<T>,
    destination: &mut list<T>) -> tuple<i64, i64, i64> {
    return ranges_set_operation_to_core(left, right, destination,
        ranges_default_less, ranges_identity, 1);
