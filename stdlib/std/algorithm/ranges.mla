/// nonmatching elements.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn replace_copy_if_to_projected(
    source: &list<T>, destination: &mut list<T>, predicate: Predicate,
    new_value: T, projection: Projection) -> i64 {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
