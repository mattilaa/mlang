/// @brief Replace predicate-matching values in a bounded destination copy.
/// Returns the number written, bounded by both source and destination lengths.
/// Any unused destination suffix and the source range are left unchanged.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn replace_copy_if_to(source: &list<T>, destination: &mut list<T>,
                          predicate: Predicate, new_value: T) -> i64 {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    let count: i64 = source_len < destination_len ? source_len : destination_len;
    for i in 0..count {
        if predicate(source[i]) { destination[i] = new_value; }
        else { destination[i] = source[i]; }
    }
    return count;
}

/// @brief Replace predicate matches in a bounded distinct-type destination.
/// Replacement and retained source elements are converted to its output type.
/// Returns the number of elements written.
/// @ingroup algorithm_ranges
generic<T, Output, Predicate>
pub fn replace_copy_if_to_heterogeneous(source: &list<T>,
    destination: &mut list<Output>, predicate: Predicate,
    new_value: Output) -> i64 {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
