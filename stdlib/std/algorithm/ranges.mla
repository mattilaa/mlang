/// \file ranges.mla
/// \brief Ranges-style algorithms under std::algorithm.
///
/// C++20 `<ranges>` inspired helpers for Mlang lists.
///
/// @defgroup algorithm_ranges std::algorithm::ranges
/// @ingroup algorithm
/// @brief Ranges-style sequence algorithms.
/// @{

mod std::flat_set;
use std::flat_set::FlatSet;
mod std::flat_map;
use std::flat_map::FlatMap;
mod std::flat_multimap;
use std::flat_multimap::FlatMultiMap;
mod std::flat_multiset;
use std::flat_multiset::FlatMultiSet;

/// @brief Return first index of a value, or -1 when not found.
/// Supports any type that can be equality-compared.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn find(data: &list<T>, value: U) -> i64 {
    let n: i64 = data.len();
    for i in 0..n {
        if data[i] == value {
            return i;
        }
    }
    return -1;
}

/// @brief Return the first matching index as an option instead of a sentinel.
/// This preserves the familiar C++20 `ranges::find` result while making the
/// no-match state explicit in Mlang. The input is unchanged.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn find_option(data: &list<T>, value: U) -> option<i64> {
    let n: i64 = data.len();
    for i in 0..n {
        if data[i] == value { return Some<i64>(i); }
    }
    return None<i64>();
}

/// @brief Find the first element equivalent to `value` under `equivalent`.
/// Returns -1 if no element matches.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn find_by(data: &list<T>, value: U, equivalent: Equivalent) -> i64 {
    let n: i64 = data.len();
    for i in 0..n {
        if equivalent(data[i], value) { return i; }
    }
    return -1;
}

/// @brief Find an element whose projected key matches `value` by equivalence.
/// The predicate receives the projected element key followed by the lookup key.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, Projection>
pub fn find_by_projected(data: &list<T>, value: U, equivalent: Equivalent,
                         projection: Projection) -> i64 {
    let n: i64 = data.len();
    for i in 0..n {
        if equivalent(projection(data[i]), value) { return i; }
    }
    return -1;
}

/// @brief Find the first element whose projected value equals `value`.
/// C++20 `std::ranges::find`-style projection support; returns `-1` if absent.
/// @ingroup algorithm_ranges
generic<T, U, Projection>
pub fn find_projected(data: &list<T>, value: U, projection: Projection) -> i64 {
    let n: i64 = data.len();
    for i in 0..n {
        if projection(data[i]) == value {
            return i;
        }
    }
    return -1;
}

/// @brief Return the first projected value match as an option index.
/// @ingroup algorithm_ranges
generic<T, U, Projection>
pub fn find_projected_option(data: &list<T>, value: U,
                             projection: Projection) -> option<i64> {
    let index: i64 = find_projected(data, value, projection);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the first equivalent value match as an option index.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn find_by_option(data: &list<T>, value: U,
                      equivalent: Equivalent) -> option<i64> {
    let index: i64 = find_by(data, value, equivalent);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the first projected equivalent match as an option index.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, Projection>
pub fn find_by_projected_option(data: &list<T>, value: U,
                                equivalent: Equivalent,
                                projection: Projection) -> option<i64> {
    let index: i64 = find_by_projected(data, value, equivalent, projection);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Find the last element whose projected value equals `value`.
/// Returns -1 when no projected key matches.
/// @ingroup algorithm_ranges
generic<T, U, Projection>
pub fn find_last_projected(data: &list<T>, value: U,
                           projection: Projection) -> i64 {
    var found: i64 = -1;
    let n: i64 = data.len();
    for i in 0..n {
        if projection(data[i]) == value { found = i; }
    }
    return found;
}

/// @brief Return the last index of a value, or -1 when it is absent.
/// C++23 ranges-style last-match search.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn find_last(data: &list<T>, value: U) -> i64 {
    var found: i64 = -1;
    let n: i64 = data.len();
    for i in 0..n {
        if data[i] == value {
            found = i;
        }
    }
    return found;
}

/// @brief Return the last index matching `value` under `equivalent`.
/// The predicate receives an element and the lookup key; the search proceeds
/// backwards and returns -1 when no element matches.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn find_last_by(data: &list<T>, value: U, equivalent: Equivalent) -> i64 {
    var index: i64 = data.len();
    while index > 0 {
        index = index - 1;
        if equivalent(data[index], value) {
            return index;
        }
    }
    return -1;
}

/// @brief Return the last element whose projected key matches `value`.
/// The predicate receives the projected element key followed by the lookup
/// key. Returns -1 when no element matches.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, Projection>
pub fn find_last_by_projected(data: &list<T>, value: U,
                              equivalent: Equivalent,
                              projection: Projection) -> i64 {
    var index: i64 = data.len();
    while index > 0 {
        index = index - 1;
        if equivalent(projection(data[index]), value) { return index; }
    }
    return -1;
}

/// @brief Return the last matching index as an option instead of a sentinel.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn find_last_option(data: &list<T>, value: U) -> option<i64> {
    let index: i64 = find_last(data, value);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the last projected matching index as an option.
/// @ingroup algorithm_ranges
generic<T, U, Projection>
pub fn find_last_projected_option(data: &list<T>, value: U,
                                  projection: Projection) -> option<i64> {
    let index: i64 = find_last_projected(data, value, projection);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the last equivalent index as an option.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn find_last_by_option(data: &list<T>, value: U,
                           equivalent: Equivalent) -> option<i64> {
    let index: i64 = find_last_by(data, value, equivalent);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the last projected equivalent index as an option.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, Projection>
pub fn find_last_by_projected_option(data: &list<T>, value: U,
                                     equivalent: Equivalent,
                                     projection: Projection) -> option<i64> {
    let index: i64 = find_last_by_projected(data, value, equivalent,
                                            projection);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the first index whose value equals its immediate successor.
/// Returns -1 when the range has fewer than two elements or no adjacent match.
/// C++20 ranges-style `adjacent_find`.
/// @ingroup algorithm_ranges
generic<T>
pub fn adjacent_find(data: &list<T>) -> i64 {
    let n: i64 = data.len();
    if n < 2 {
        return -1;
    }
    for i in 0..(n - 1) {
        if data[i] == data[i + 1] {
            return i;
        }
    }
    return -1;
}

/// @brief Find adjacent values with equal projected keys.
/// Returns the first pair's left index, or -1 if there is no such pair.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn adjacent_find_projected(data: &list<T>, projection: Projection) -> i64 {
    let n: i64 = data.len();
    if n < 2 { return -1; }
    for i in 0..(n - 1) {
        if projection(data[i]) == projection(data[i + 1]) { return i; }
    }
    return -1;
}

/// @brief Return the first adjacent pair accepted by `equivalent`, or -1.
/// @ingroup algorithm_ranges
generic<T, Equivalent>
pub fn adjacent_find_by(data: &list<T>, equivalent: Equivalent) -> i64 {
    let n: i64 = data.len();
    if n < 2 {
        return -1;
    }
    for i in 0..(n - 1) {
        if equivalent(data[i], data[i + 1]) {
            return i;
        }
    }
    return -1;
}

/// @brief Find adjacent values matching after projection and equivalence.
/// Returns the first pair's left index, or -1 when no pair matches.
/// @ingroup algorithm_ranges
generic<T, Equivalent, Projection>
pub fn adjacent_find_by_projected(data: &list<T>, equivalent: Equivalent,
                                  projection: Projection) -> i64 {
    let n: i64 = data.len();
    if n < 2 { return -1; }
    for i in 0..(n - 1) {
        if equivalent(projection(data[i]), projection(data[i + 1])) {
            return i;
        }
    }
    return -1;
}

/// @brief Return the first equal adjacent index as an option.
/// @ingroup algorithm_ranges
generic<T>
pub fn adjacent_find_option(data: &list<T>) -> option<i64> {
    let index: i64 = adjacent_find(data);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the first projected-equal adjacent index as an option.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn adjacent_find_projected_option(data: &list<T>,
                                      projection: Projection) -> option<i64> {
    let index: i64 = adjacent_find_projected(data, projection);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the first equivalent adjacent index as an option.
/// @ingroup algorithm_ranges
generic<T, Equivalent>
pub fn adjacent_find_by_option(data: &list<T>, equivalent: Equivalent)
    -> option<i64> {
    let index: i64 = adjacent_find_by(data, equivalent);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the first projected-equivalent adjacent index as an option.
/// @ingroup algorithm_ranges
generic<T, Equivalent, Projection>
pub fn adjacent_find_by_projected_option(
    data: &list<T>, equivalent: Equivalent, projection: Projection)
    -> option<i64> {
    let index: i64 = adjacent_find_by_projected(data, equivalent, projection);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the first index in `data` matching any value in `candidates`.
/// Returns -1 when the ranges have no matching values (C++20 `find_first_of`).
/// @ingroup algorithm_ranges
generic<T, U>
pub fn find_first_of(data: &list<T>, candidates: &list<U>) -> i64 {
    let n: i64 = data.len();
    let candidate_count: i64 = candidates.len();
    for i in 0..n {
        for j in 0..candidate_count {
            if data[i] == candidates[j] {
                return i;
            }
        }
    }
    return -1;
}

/// @brief Find the first data element matching any candidate after projection.
/// Each range has its own projection; returns -1 when there is no match.
/// @ingroup algorithm_ranges
generic<T, U, DataProjection, CandidateProjection>
pub fn find_first_of_projected(data: &list<T>, candidates: &list<U>,
                               data_projection: DataProjection,
                               candidate_projection: CandidateProjection)
    -> i64 {
    let n: i64 = data.len();
    let candidate_count: i64 = candidates.len();
    for i in 0..n {
        let data_key = data_projection(data[i]);
        for j in 0..candidate_count {
            if data_key == candidate_projection(candidates[j]) { return i; }
        }
    }
    return -1;
}

/// @brief Return the first index in `data` matching a candidate under a
/// caller-provided binary predicate.
/// C++20 `std::ranges::find_first_of` predicate overload.
/// @ingroup algorithm_ranges
generic<T, U, Predicate>
pub fn find_first_of_by(data: &list<T>, candidates: &list<U>,
                        equivalent: Predicate) -> i64 {
    let n: i64 = data.len();
    let candidate_count: i64 = candidates.len();
    for i in 0..n {
        for j in 0..candidate_count {
            if equivalent(data[i], candidates[j]) {
                return i;
            }
        }
    }
    return -1;
}

/// @brief Find the first candidate match after independent projections.
/// Returns -1 if no data element matches any candidate under `equivalent`.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, DataProjection, CandidateProjection>
pub fn find_first_of_by_projected(
    data: &list<T>, candidates: &list<U>, equivalent: Equivalent,
    data_projection: DataProjection, candidate_projection: CandidateProjection)
    -> i64 {
    let n: i64 = data.len();
    let candidate_count: i64 = candidates.len();
    for i in 0..n {
        let data_key = data_projection(data[i]);
        for j in 0..candidate_count {
            if equivalent(data_key, candidate_projection(candidates[j])) {
                return i;
            }
        }
    }
    return -1;
}

/// @brief Return the first candidate match as an option index.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn find_first_of_option(data: &list<T>, candidates: &list<U>)
    -> option<i64> {
    let index: i64 = find_first_of(data, candidates);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the first projected candidate match as an option index.
/// @ingroup algorithm_ranges
generic<T, U, DataProjection, CandidateProjection>
pub fn find_first_of_projected_option(
    data: &list<T>, candidates: &list<U>,
    data_projection: DataProjection,
    candidate_projection: CandidateProjection) -> option<i64> {
    let index: i64 = find_first_of_projected(
        data, candidates, data_projection, candidate_projection);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the first equivalent candidate match as an option index.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn find_first_of_by_option(data: &list<T>, candidates: &list<U>,
                               equivalent: Equivalent) -> option<i64> {
    let index: i64 = find_first_of_by(data, candidates, equivalent);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the first projected equivalent candidate match as an option.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, DataProjection, CandidateProjection>
pub fn find_first_of_by_projected_option(
    data: &list<T>, candidates: &list<U>, equivalent: Equivalent,
    data_projection: DataProjection, candidate_projection: CandidateProjection)
    -> option<i64> {
    let index: i64 = find_first_of_by_projected(
        data, candidates, equivalent, data_projection, candidate_projection);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return whether sorted `range` contains sorted `subset`.
/// Duplicate multiplicities matter; both inputs must be nondecreasing.
/// C++20 `std::ranges::includes` equivalent.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn includes(range: &list<T>, subset: &list<U>) -> bool {
    let range_len: i64 = range.len();
    let subset_len: i64 = subset.len();
    var range_index: i64 = 0;
    var subset_index: i64 = 0;
    while range_index < range_len && subset_index < subset_len {
        if range[range_index] < subset[subset_index] {
            range_index = range_index + 1;
        } else if subset[subset_index] < range[range_index] {
            return false;
        } else {
            range_index = range_index + 1;
            subset_index = subset_index + 1;
        }
    }
    return subset_index == subset_len;
}

/// @brief Check sorted-range containment after independent key projections.
/// Duplicate multiplicities matter; both inputs must be sorted by the
/// corresponding projections.
/// @ingroup algorithm_ranges
generic<T, U, RangeProjection, SubsetProjection>
pub fn includes_projected(range: &list<T>, subset: &list<U>,
                          range_projection: RangeProjection,
                          subset_projection: SubsetProjection) -> bool {
    let range_len: i64 = range.len();
    let subset_len: i64 = subset.len();
    var range_index: i64 = 0;
    var subset_index: i64 = 0;
    while range_index < range_len && subset_index < subset_len {
        let range_key = range_projection(range[range_index]);
        let subset_key = subset_projection(subset[subset_index]);
        if range_key < subset_key {
            range_index = range_index + 1;
        } else if subset_key < range_key {
            return false;
        } else {
            range_index = range_index + 1;
            subset_index = subset_index + 1;
        }
    }
    return subset_index == subset_len;
}

/// @brief Check whether sorted `range` contains sorted `subset` under `less`.
/// Duplicate multiplicities count; both inputs use the same strict ordering.
/// @ingroup algorithm_ranges
generic<T, U, Less>
pub fn includes_by(range: &list<T>, subset: &list<U>, less: Less) -> bool {
    let range_len: i64 = range.len();
    let subset_len: i64 = subset.len();
    var range_index: i64 = 0;
    var subset_index: i64 = 0;
    while range_index < range_len && subset_index < subset_len {
        if less(range[range_index], subset[subset_index]) {
            range_index = range_index + 1;
        } else if less(subset[subset_index], range[range_index]) {
            return false;
        } else {
            range_index = range_index + 1;
            subset_index = subset_index + 1;
        }
    }
    return subset_index == subset_len;
}

/// @brief Check sorted-range containment using comparator-projected keys.
/// Both inputs must be sorted by `less` applied to projected values.
/// @ingroup algorithm_ranges
generic<T, U, Less, Projection>
pub fn includes_by_projected(range: &list<T>, subset: &list<U>, less: Less,
                             projection: Projection) -> bool {
    let range_len: i64 = range.len();
    let subset_len: i64 = subset.len();
    var range_index: i64 = 0;
    var subset_index: i64 = 0;
    while range_index < range_len && subset_index < subset_len {
        let range_key = projection(range[range_index]);
        let subset_key = projection(subset[subset_index]);
        if less(range_key, subset_key) {
            range_index = range_index + 1;
        } else if less(subset_key, range_key) {
            return false;
        } else {
            range_index = range_index + 1;
            subset_index = subset_index + 1;
        }
    }
    return subset_index == subset_len;
}

/// @brief Return the number of elements in a list.
/// @ingroup algorithm_ranges
generic<T>
pub fn size(data: &list<T>) -> i64 {
    return data.len();
}

/// @brief Return true when a list has no elements.
/// @ingroup algorithm_ranges
generic<T>
pub fn empty(data: &list<T>) -> bool {
    return data.len() == 0;
}

/// @brief Return whether every boolean in a range is true (C++20 all_of identity form).
/// @ingroup algorithm_ranges
pub fn all_of(data: &list<bool>) -> bool {
    let n: i64 = data.len();
    for i in 0..n {
        if !data[i] {
            return false;
        }
    }
    return true;
}

/// @brief Return whether at least one boolean in a range is true (C++20 any_of identity form).
/// @ingroup algorithm_ranges
pub fn any_of(data: &list<bool>) -> bool {
    let n: i64 = data.len();
    for i in 0..n {
        if data[i] {
            return true;
        }
    }
    return false;
}

/// @brief Return whether no boolean in a range is true (C++20 none_of identity form).
/// @ingroup algorithm_ranges
pub fn none_of(data: &list<bool>) -> bool {
    return !any_of(data);
}

/// @brief Return the index of the first element accepted by `predicate`, or -1.
/// C++20 `std::ranges::find_if` semantics.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn find_if(data: &list<T>, predicate: Predicate) -> i64 {
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(data[i]) {
            return i;
        }
    }
    return -1;
}

/// @brief Find the first element accepted after projection, or -1.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn find_if_projected(data: &list<T>, predicate: Predicate,
                         projection: Projection) -> i64 {
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(projection(data[i])) { return i; }
    }
    return -1;
}

/// @brief Return the first predicate-matching index as an option.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn find_if_option(data: &list<T>, predicate: Predicate) -> option<i64> {
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(data[i]) { return Some<i64>(i); }
    }
    return None<i64>();
}

/// @brief Return the first projected predicate-matching index as an option.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn find_if_projected_option(data: &list<T>, predicate: Predicate,
                                projection: Projection) -> option<i64> {
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(projection(data[i])) { return Some<i64>(i); }
    }
    return None<i64>();
}

/// @brief Return the last index accepted by `predicate`, or -1.
/// C++23 `std::ranges::find_last_if` semantics.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn find_last_if(data: &list<T>, predicate: Predicate) -> i64 {
    var i: i64 = data.len();
    while i > 0 {
        i = i - 1;
        if predicate(data[i]) {
            return i;
        }
    }
    return -1;
}

/// @brief Find the last element accepted after projection, or -1.
/// C++23 `std::ranges::find_last_if` projection form.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn find_last_if_projected(data: &list<T>, predicate: Predicate,
                              projection: Projection) -> i64 {
    var i: i64 = data.len();
    while i > 0 {
        i = i - 1;
        if predicate(projection(data[i])) { return i; }
    }
    return -1;
}

/// @brief Return the last predicate-matching index as an option.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn find_last_if_option(data: &list<T>, predicate: Predicate)
    -> option<i64> {
    let index: i64 = find_last_if(data, predicate);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the last projected predicate-matching index as an option.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn find_last_if_projected_option(data: &list<T>, predicate: Predicate,
                                     projection: Projection) -> option<i64> {
    let index: i64 = find_last_if_projected(data, predicate, projection);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the last predicate-rejected index as an option.
/// C++23 `std::ranges::find_last_if_not` with an explicit absence state.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn find_last_if_not_option(data: &list<T>, predicate: Predicate)
    -> option<i64> {
    let index: i64 = find_last_if_not(data, predicate);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Return the last projected predicate-rejected index as an option.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn find_last_if_not_projected_option(data: &list<T>, predicate: Predicate,
                                         projection: Projection)
    -> option<i64> {
    let index: i64 = find_last_if_not_projected(data, predicate, projection);
    if index < 0 { return None<i64>(); }
    return Some<i64>(index);
}

/// @brief Count elements accepted by `predicate` (C++20 `ranges::count_if`).
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn count_if(data: &list<T>, predicate: Predicate) -> i64 {
    var matched: i64 = 0;
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(data[i]) {
            matched = matched + 1;
        }
    }
    return matched;
}

/// @brief Count elements whose projected keys satisfy `predicate`.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn count_if_projected(data: &list<T>, predicate: Predicate,
                          projection: Projection) -> i64 {
    var matched: i64 = 0;
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(projection(data[i])) { matched = matched + 1; }
    }
    return matched;
}

/// @brief Invoke `operation` once for each element, from first to last.
/// Captured closure state can be used to accumulate effects or results.
/// C++20 `std::ranges::for_each` equivalent (without iterator result).
/// @ingroup algorithm_ranges
generic<T, Operation>
pub fn for_each(data: &list<T>, operation: Operation) -> void {
    let n: i64 = data.len();
    for i in 0..n {
        operation(data[i]);
    }
}

/// @brief Apply an operation to every element and return the callable.
/// This eager-list counterpart to the callable portion of C++20
/// `std::ranges::for_each` is useful when the operation stores state by value.
/// @ingroup algorithm_ranges
generic<T, Operation>
pub fn for_each_result(data: &list<T>, operation: Operation) -> Operation {
    let n: i64 = data.len();
    for i in 0..n {
        operation(data[i]);
    }
    return operation;
}

/// @brief Apply a projected operation to the full range and return the callable.
/// The callable may then be reused with its accumulated state.
/// @ingroup algorithm_ranges
generic<T, Operation, Projection>
pub fn for_each_projected_result(data: &list<T>, operation: Operation,
                                 projection: Projection) -> Operation {
    let n: i64 = data.len();
    for i in 0..n {
        operation(projection(data[i]));
    }
    return operation;
}

/// @brief Invoke `operation` on each element's projected value in order.
/// @ingroup algorithm_ranges
generic<T, Operation, Projection>
pub fn for_each_projected(data: &list<T>, operation: Operation,
                          projection: Projection) -> void {
    let n: i64 = data.len();
    for i in 0..n {
        operation(projection(data[i]));
    }
}

/// @brief Invoke `operation` on the first `count` elements in order.
/// Negative counts perform no calls; counts larger than the range length are
/// clamped to its length. C++20 `std::ranges::for_each_n` counterpart.
/// @ingroup algorithm_ranges
generic<T, Operation>
pub fn for_each_n(data: &list<T>, count: i64, operation: Operation) -> void {
    let data_len: i64 = data.len();
    var n: i64 = count;
    if n < 0 {
        n = 0;
    }
    if n > data_len {
        n = data_len;
    }
    for i in 0..n {
        operation(data[i]);
    }
}

/// @brief Process a bounded prefix and return the callable for reuse.
/// Non-positive counts perform no calls; oversized counts clamp to the range.
/// @ingroup algorithm_ranges
generic<T, Operation>
pub fn for_each_n_result(data: &list<T>, count: i64,
                         operation: Operation) -> Operation {
    let data_len: i64 = data.len();
    var n: i64 = count;
    if n < 0 { n = 0; }
    if n > data_len { n = data_len; }
    for i in 0..n {
        operation(data[i]);
    }
    return operation;
}

/// @brief Invoke an operation on a bounded prefix and return its end index.
/// This exposes the consumed-count part of C++20 `for_each_n`'s result for
/// eager lists; the callable remains an input because generic closure values
/// cannot currently be returned in tuples.
/// @ingroup algorithm_ranges
generic<T, Operation>
pub fn for_each_n_count(data: &list<T>, count: i64,
                        operation: Operation) -> i64 {
    let data_len: i64 = data.len();
    var n: i64 = count;
    if n < 0 { n = 0; }
    if n > data_len { n = data_len; }
    for i in 0..n {
        operation(data[i]);
    }
    return n;
}

/// @brief Invoke `operation` on projected values from a bounded prefix.
/// Counts clamp to the range length; non-positive counts perform no calls.
/// @ingroup algorithm_ranges
generic<T, Operation, Projection>
pub fn for_each_n_projected(data: &list<T>, count: i64,
                            operation: Operation, projection: Projection)
    -> void {
    let data_len: i64 = data.len();
    var n: i64 = count;
    if n < 0 { n = 0; }
    if n > data_len { n = data_len; }
    for i in 0..n {
        operation(projection(data[i]));
    }
}

/// @brief Process projected values from a bounded prefix and return the callable.
/// @ingroup algorithm_ranges
generic<T, Operation, Projection>
pub fn for_each_n_projected_result(
    data: &list<T>, count: i64, operation: Operation, projection: Projection)
    -> Operation {
    let data_len: i64 = data.len();
    var n: i64 = count;
    if n < 0 { n = 0; }
    if n > data_len { n = data_len; }
    for i in 0..n {
        operation(projection(data[i]));
    }
    return operation;
}

/// @brief Process a projected bounded prefix and return the consumed count.
/// @ingroup algorithm_ranges
generic<T, Operation, Projection>
pub fn for_each_n_projected_count(
    data: &list<T>, count: i64, operation: Operation, projection: Projection)
    -> i64 {
    let data_len: i64 = data.len();
    var n: i64 = count;
    if n < 0 { n = 0; }
    if n > data_len { n = data_len; }
    for i in 0..n {
        operation(projection(data[i]));
    }
    return n;
}

/// @brief Fold a range from left to right with an explicit initial value.
/// `operation(accumulator, element)` returns the next accumulator; the
/// accumulator type may differ from the element type. C++23
/// `std::ranges::fold_left` equivalent.
/// @ingroup algorithm_ranges
generic<T, U, Operation>
pub fn fold_left(data: &list<T>, init: U, operation: Operation) -> U {
    var acc: U = init;
    let n: i64 = data.len();
    for i in 0..n {
        acc = operation(acc, data[i]);
    }
    return acc;
}

/// @brief Fold projected elements from left to right with an initial value.
/// The operation receives the accumulator and projected element. This
/// Mlang ranges extension composes projection and C++23 `fold_left` in one
/// pass without allocating an intermediate transformed list.
/// @ingroup algorithm_ranges
generic<T, U, Operation, Projection>
pub fn fold_left_projected(data: &list<T>, init: U, operation: Operation,
                           projection: Projection) -> U {
    var acc: U = init;
    let n: i64 = data.len();
    for i in 0..n {
        acc = operation(acc, projection(data[i]));
    }
    return acc;
}

/// @brief Project each range element before folding it into the accumulator.
/// The accumulator type may differ from the input and projected element types.
/// This eager ranges counterpart to `std::transform_reduce` visits each value
/// once in input order.
/// @ingroup algorithm_ranges
generic<T, U, Reduce, Project>
pub fn transform_reduce(data: &list<T>, init: U, reduce: Reduce,
                        project: Project) -> U {
    var acc: U = init;
    let n: i64 = data.len();
    for i in 0..n {
        acc = reduce(acc, project(data[i]));
    }
    return acc;
}

/// @brief Project paired elements from two ranges and fold each projected term.
/// Stops at the shorter input; input and accumulator types may differ.
/// @ingroup algorithm_ranges
///
/// `project(left, right)` creates a term and `reduce(accumulator, term)` folds
/// it into the result.
generic<T, V, U, Reduce, Project>
pub fn transform_reduce(left: &list<T>, right: &list<V>, init: U,
                        reduce: Reduce, project: Project) -> U {
    var acc: U = init;
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let n: i64 = left_len < right_len ? left_len : right_len;
    for i in 0..n {
        acc = reduce(acc, project(left[i], right[i]));
    }
    return acc;
}

/// @brief Reduce a range into `init` using addition in input order.
/// Mlang uses a deterministic sequential traversal; unlike a parallel
/// `std::reduce`, operations are never reordered. The accumulator may differ
/// from the input element type.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn reduce(data: &list<T>, init: U) -> U {
    var acc: U = init;
    let n: i64 = data.len();
    for i in 0..n {
        acc = acc + data[i];
    }
    return acc;
}

/// @brief Reduce a range with a caller-provided operation in input order.
/// Empty input returns `init` unchanged.
/// @ingroup algorithm_ranges
generic<T, U, Operation>
pub fn reduce(data: &list<T>, init: U, operation: Operation) -> U {
    var acc: U = init;
    let n: i64 = data.len();
    for i in 0..n {
        acc = operation(acc, data[i]);
    }
    return acc;
}

/// @brief Compute the sum of pairwise products over the shared range prefix.
/// The accumulator may use a different type from either input element type.
/// This eager-list counterpart to `std::inner_product` stops at the shorter
/// input and returns `init` when either input is empty.
/// @ingroup algorithm_ranges
generic<T, V, U>
pub fn inner_product(left: &list<T>, right: &list<V>, init: U) -> U {
    var acc: U = init;
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let n: i64 = left_len < right_len ? left_len : right_len;
    for i in 0..n {
        acc = acc + (left[i] * right[i]);
    }
    return acc;
}

/// @brief Compute a paired-range inner product with custom operations.
/// `product(left, right)` creates each term, and `reduce(acc, term)` folds it
/// into the accumulator. Inputs may have different element types.
/// @ingroup algorithm_ranges
generic<T, V, U, Reduce, Product>
pub fn inner_product_by(left: &list<T>, right: &list<V>, init: U,
                        reduce: Reduce, product: Product) -> U {
    var acc: U = init;
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let n: i64 = left_len < right_len ? left_len : right_len;
    for i in 0..n {
        acc = reduce(acc, product(left[i], right[i]));
    }
    return acc;
}

/// @brief C++-style custom-operation overload of `inner_product`.
/// @ingroup algorithm_ranges
generic<T, V, U, Reduce, Product>
pub fn inner_product(left: &list<T>, right: &list<V>, init: U,
                     reduce: Reduce, product: Product) -> U {
    return inner_product_by(left, right, init, reduce, product);
}

/// @brief Materialize an inclusive prefix scan using `operation`.
/// The first input value seeds the output; empty input produces an empty list.
/// @ingroup algorithm_ranges
generic<T, Operation>
pub fn inclusive_scan(data: &list<T>, operation: Operation) -> list<T> {
    let n: i64 = data.len();
    if n == 0 { return []; }
    var out: list<T> = [];
    var acc: T = data[0];
    out.push(acc);
    for i in 1..n {
        acc = operation(acc, data[i]);
        out.push(acc);
    }
    return out;
}

/// @brief Materialize seeded inclusive prefixes; output type may differ from T.
/// Each output incorporates the corresponding input element before emission.
/// @ingroup algorithm_ranges
generic<T, U, Operation>
pub fn inclusive_scan(data: &list<T>, init: U, operation: Operation)
    -> list<U> {
    var out: list<U> = [];
    var acc: U = init;
    let n: i64 = data.len();
    for i in 0..n {
        acc = operation(acc, data[i]);
        out.push(acc);
    }
    return out;
}

/// @brief Emit the accumulator before incorporating each element.
/// @ingroup algorithm_ranges
generic<T, U, Operation>
pub fn exclusive_scan(data: &list<T>, init: U, operation: Operation)
    -> list<U> {
    var out: list<U> = [];
    var acc: U = init;
    let n: i64 = data.len();
    for i in 0..n {
        out.push(acc);
        acc = operation(acc, data[i]);
    }
    return out;
}

/// @brief Project values and materialize inclusive accumulated prefixes.
/// Without an initial value, the first projected element seeds the result.
/// @ingroup algorithm_ranges
generic<T, U, Operation, Projection>
pub fn transform_inclusive_scan(data: &list<T>, operation: Operation,
                                project: Projection) -> list<U> {
    let n: i64 = data.len();
    if n == 0 { return []; }
    var out: list<U> = [];
    var acc: U = project(data[0]);
    out.push(acc);
    for i in 1..n {
        acc = operation(acc, project(data[i]));
        out.push(acc);
    }
    return out;
}

/// @brief Project values into seeded inclusive accumulated prefixes.
/// @ingroup algorithm_ranges
generic<T, U, Operation, Projection>
pub fn transform_inclusive_scan(data: &list<T>, init: U,
                                operation: Operation, project: Projection)
    -> list<U> {
    var out: list<U> = [];
    var acc: U = init;
    let n: i64 = data.len();
    for i in 0..n {
        acc = operation(acc, project(data[i]));
        out.push(acc);
    }
    return out;
}

/// @brief Emit each accumulator before folding in the projected input value.
/// @ingroup algorithm_ranges
generic<T, U, Operation, Projection>
pub fn transform_exclusive_scan(data: &list<T>, init: U,
                                operation: Operation, project: Projection)
    -> list<U> {
    var out: list<U> = [];
    var acc: U = init;
    let n: i64 = data.len();
    for i in 0..n {
        out.push(acc);
        acc = operation(acc, project(data[i]));
    }
    return out;
}

/// @brief Fold a range from right to left with an explicit initial value.
/// `operation(element, accumulator)` returns the next accumulator. C++23
/// `std::ranges::fold_right` equivalent.
/// @ingroup algorithm_ranges
generic<T, U, Operation>
pub fn fold_right(data: &list<T>, init: U, operation: Operation) -> U {
    var acc: U = init;
    var i: i64 = data.len();
    while i > 0 {
        i = i - 1;
        acc = operation(data[i], acc);
    }
    return acc;
}

/// @brief Fold projected elements from right to left with an initial value.
/// The operation receives the projected element and accumulator. This avoids
/// allocating an intermediate transformed list.
/// @ingroup algorithm_ranges
generic<T, U, Operation, Projection>
pub fn fold_right_projected(data: &list<T>, init: U, operation: Operation,
                            projection: Projection) -> U {
    var acc: U = init;
    var i: i64 = data.len();
    while i > 0 {
        i = i - 1;
        acc = operation(projection(data[i]), acc);
    }
    return acc;
}

/// @brief Fold left and return the final consumed index with the accumulator.
/// Mlang's eager-list analogue of C++23 `std::ranges::fold_left_with_iter`.
/// The returned index is the list length, including for empty input.
/// @ingroup algorithm_ranges
generic<T, U, Operation>
pub fn fold_left_with_iter(data: &list<T>, init: U, operation: Operation) -> tuple<i64, U> {
    var acc: U = init;
    let n: i64 = data.len();
    for i in 0..n {
        acc = operation(acc, data[i]);
    }
    return (n, acc);
}

/// @brief Fold projected elements left-to-right and return the consumed count.
/// The projection runs once per input element and no intermediate list is
/// allocated. The count is zero for empty input.
/// @ingroup algorithm_ranges
generic<T, U, Operation, Projection>
pub fn fold_left_with_iter_projected(data: &list<T>, init: U,
                                     operation: Operation,
                                     projection: Projection) -> tuple<i64, U> {
    var acc: U = init;
    let n: i64 = data.len();
    for i in 0..n {
        acc = operation(acc, projection(data[i]));
    }
    return (n, acc);
}

/// @brief Fold right and return the number of consumed elements with result.
/// The consumed count is zero for empty input and the full list length
/// otherwise. This complements the C++23-inspired fold_left_with_iter API for
/// eager lists, which do not expose iterators.
/// @ingroup algorithm_ranges
generic<T, U, Operation>
pub fn fold_right_with_iter(data: &list<T>, init: U,
                            operation: Operation) -> tuple<i64, U> {
    var acc: U = init;
    var i: i64 = data.len();
    while i > 0 {
        i = i - 1;
        acc = operation(data[i], acc);
    }
    return (data.len(), acc);
}

/// @brief Fold projected elements right-to-left and return the consumed count.
/// The projection runs once per input element and no intermediate list is
/// allocated.
/// @ingroup algorithm_ranges
generic<T, U, Operation, Projection>
pub fn fold_right_with_iter_projected(data: &list<T>, init: U,
                                      operation: Operation,
                                      projection: Projection) -> tuple<i64, U> {
    var acc: U = init;
    var i: i64 = data.len();
    while i > 0 {
        i = i - 1;
        acc = operation(projection(data[i]), acc);
    }
    return (data.len(), acc);
}

/// @brief Fold a non-empty range from left to right without an initial value.
/// Empty input returns None. C++23 `std::ranges::fold_left_first` equivalent.
/// @ingroup algorithm_ranges
generic<T, Output, Operation>
pub fn fold_left_first(data: &list<T>, operation: Operation)
    -> option<Output> {
    let n: i64 = data.len();
    if n == 0 {
        return None<Output>();
    }
    var acc: Output = data[0];
    for i in 1..n {
        acc = operation(acc, data[i]);
    }
    return Some<Output>(acc);
}

/// @brief Fold a non-empty range of projected values from left to right.
/// The first projected element seeds the accumulator; empty input returns
/// `None`. This is the projected Mlang counterpart to C++23 `fold_left_first`.
/// @ingroup algorithm_ranges
generic<T, Output, Operation, Projection>
pub fn fold_left_first_projected(data: &list<T>, operation: Operation,
                                 projection: Projection)
    -> option<Output> {
    let n: i64 = data.len();
    if n == 0 { return None<Output>(); }
    var acc: Output = projection(data[0]);
    for i in 1..n {
        acc = operation(acc, projection(data[i]));
    }
    return Some<Output>(acc);
}

/// @brief Fold a non-empty range without an initial value and return the
/// consumed element count with the result. Empty input returns None. This is
/// the eager-list analogue of C++23 `std::ranges::fold_left_first_with_iter`.
/// @ingroup algorithm_ranges
generic<T, Output, Operation>
pub fn fold_left_first_with_iter(data: &list<T>, operation: Operation)
    -> option<tuple<i64, Output>> {
    let n: i64 = data.len();
    if n == 0 {
        return None<tuple<i64, Output>>();
    }
    var acc: Output = data[0];
    for i in 1..n {
        acc = operation(acc, data[i]);
    }
    return Some<tuple<i64, Output>>((n, acc));
}

/// @brief Fold a non-empty range of projected values left-to-right and return
/// the consumed count with the result. Empty input returns None.
/// @ingroup algorithm_ranges
generic<T, Output, Operation, Projection>
pub fn fold_left_first_with_iter_projected(
    data: &list<T>, operation: Operation, projection: Projection)
    -> option<tuple<i64, Output>> {
    let n: i64 = data.len();
    if n == 0 { return None<tuple<i64, Output>>(); }
    var acc: Output = projection(data[0]);
    for i in 1..n {
        acc = operation(acc, projection(data[i]));
    }
    return Some<tuple<i64, Output>>((n, acc));
}

/// @brief Fold a non-empty range from right to left without an initial value.
/// Empty input returns None. C++23 `std::ranges::fold_right_last` equivalent.
/// @ingroup algorithm_ranges
generic<T, Output, Operation>
pub fn fold_right_last(data: &list<T>, operation: Operation)
    -> option<Output> {
    let n: i64 = data.len();
    if n == 0 {
        return None<Output>();
    }
    var i: i64 = n - 1;
    var acc: Output = data[i];
    while i > 0 {
        i = i - 1;
        acc = operation(data[i], acc);
    }
    return Some<Output>(acc);
}

/// @brief Fold a non-empty range of projected values from right to left.
/// The last projected element seeds the accumulator; empty input returns
/// `None`.
/// @ingroup algorithm_ranges
generic<T, Output, Operation, Projection>
pub fn fold_right_last_projected(data: &list<T>, operation: Operation,
                                 projection: Projection)
    -> option<Output> {
    let n: i64 = data.len();
    if n == 0 { return None<Output>(); }
    var i: i64 = n - 1;
    var acc: Output = projection(data[i]);
    while i > 0 {
        i = i - 1;
        acc = operation(projection(data[i]), acc);
    }
    return Some<Output>(acc);
}

/// @brief Materialize `count` values from a zero-argument generator closure.
/// Non-positive counts return an empty list without invoking the generator.
/// Mlang's eager-list form of C++ `std::generate_n`.
/// @ingroup algorithm_ranges
generic<T, Generator>
pub fn generate_n(count: i64, generator: Generator) -> list<T> {
    var generated: list<T> = [];
    var i: i64 = 0;
    while i < count {
        generated.push(generator());
        i = i + 1;
    }
    return generated;
}

/// @brief Generate one value for each position in `shape`.
/// The shape values are ignored; its length specifies the output range size.
/// Eager-list counterpart to C++20 `std::ranges::generate`.
/// @ingroup algorithm_ranges
generic<Shape, Output, Generator>
pub fn generate(shape: &list<Shape>, generator: Generator) -> list<Output> {
    var generated: list<Output> = [];
    for i in 0..shape.len() {
        generated.push(generator());
    }
    return generated;
}

/// @brief Generate a value for every slot in a mutable list.
/// The generated value must match the existing element type. Returns the
/// number of slots written; an empty list does not invoke the generator.
/// @ingroup algorithm_ranges
generic<T, Generator>
pub fn generate_in_place(data: &mut list<T>, generator: Generator) -> i64 {
    let n: i64 = data.len();
    for i in 0..n { data[i] = generator(); }
    return n;
}

/// @brief Generate values into at most the first `count` slots of a mutable list.
/// The requested count is clamped to the destination length and to zero.
/// Returns the number of slots written; no calls are made for an empty prefix.
/// Bounded-destination counterpart to C++ `std::ranges::generate_n`.
/// @ingroup algorithm_ranges
generic<T, Generator>
pub fn generate_n_in_place(data: &mut list<T>, count: i64,
                           generator: Generator) -> i64 {
    let n: i64 = data.len();
    let limit: i64 = count < n ? count : n;
    if limit <= 0 { return 0; }
    for i in 0..limit { data[i] = generator(); }
    return limit;
}

/// @brief Return a copy of `data` filled with `value` at every position.
/// The input length acts as the output range size; the source is unchanged.
/// Eager-list counterpart to C++20 `std::ranges::fill`.
/// @ingroup algorithm_ranges
generic<T>
pub fn fill(data: &list<T>, value: T) -> list<T> {
    var filled: list<T> = [];
    for i in 0..data.len() {
        filled.push(value);
    }
    return filled;
}

/// @brief Fill every existing element of a mutable list with `value`.
/// Returns the number of elements written.
/// @ingroup algorithm_ranges
generic<T>
pub fn fill_in_place(data: &mut list<T>, value: T) -> i64 {
    let n: i64 = data.len();
    for i in 0..n { data[i] = value; }
    return n;
}

/// @brief Fill a bounded prefix of a mutable list.
/// Non-positive counts write nothing; oversized counts clamp to list length.
/// Returns the number of elements written.
/// @ingroup algorithm_ranges
generic<T>
pub fn fill_n_in_place(data: &mut list<T>, count: i64, value: T) -> i64 {
    let n: i64 = data.len();
    var filled: i64 = count;
    if filled < 0 { filled = 0; }
    if filled > n { filled = n; }
    for i in 0..filled { data[i] = value; }
    return filled;
}

/// @brief Materialize `count` copies of `value` in a new list.
/// Non-positive counts return an empty list. Eager-list counterpart to C++20
/// `std::ranges::fill_n`; the input count defines the output length.
/// @ingroup algorithm_ranges
generic<T>
pub fn fill_n(count: i64, value: T) -> list<T> {
    var filled: list<T> = [];
    var i: i64 = 0;
    while i < count {
        filled.push(value);
        i = i + 1;
    }
    return filled;
}

/// @brief Copy at most `count` values from the beginning of `data`.
/// Negative counts return an empty list and counts larger than the range length
/// are clamped to its length. C++20 `std::ranges::copy_n` counterpart.
/// @ingroup algorithm_ranges
generic<T>
pub fn copy_n(data: &list<T>, count: i64) -> list<T> {
    var copied: list<T> = [];
    let data_len: i64 = data.len();
    var copy_len: i64 = count;
    if copy_len < 0 {
        copy_len = 0;
    }
    if copy_len > data_len {
        copy_len = data_len;
    }
    for i in 0..copy_len {
        copied.push(data[i]);
    }
    return copied;
}

/// @brief Copy the projected value of every element into a new list.
/// The source remains unchanged; the output element type is inferred from the
/// projection. C++20 `std::ranges::copy` projection support.
/// @ingroup algorithm_ranges
generic<T, Output, Projection>
pub fn copy_projected(data: &list<T>, projection: Projection)
    -> list<Output> {
    var copied: list<Output> = [];
    let n: i64 = data.len();
    for i in 0..n { copied.push(projection(data[i])); }
    return copied;
}

/// @brief Copy a projected prefix into a new list, clamped to the range.
/// Negative counts return an empty list.
/// @ingroup algorithm_ranges
generic<T, Output, Projection>
pub fn copy_n_projected(data: &list<T>, count: i64,
                        projection: Projection) -> list<Output> {
    var copied: list<Output> = [];
    let data_len: i64 = data.len();
    var copy_len: i64 = count;
    if copy_len < 0 { copy_len = 0; }
    if copy_len > data_len { copy_len = data_len; }
    for i in 0..copy_len { copied.push(projection(data[i])); }
    return copied;
}

/// @brief Copy a bounded prefix and return the consumed count with the copy.
/// Counts below zero consume zero elements; oversized counts clamp to the list
/// length. This exposes the output-iterator progress of C++20 `copy_n` in an
/// eager-list result.
/// @ingroup algorithm_ranges
generic<T>
pub fn copy_n_with_count(data: &list<T>, count: i64)
    -> tuple<i64, list<T>> {
    var copied: list<T> = [];
    let data_len: i64 = data.len();
    var copy_len: i64 = count;
    if copy_len < 0 {
        copy_len = 0;
    }
    if copy_len > data_len {
        copy_len = data_len;
    }
    for i in 0..copy_len {
        copied.push(data[i]);
    }
    return (copy_len, copied);
}

/// @brief Materialize an independent list copy of the complete range.
/// This is the eager-list analogue of C++20 `std::ranges::copy`.
/// @ingroup algorithm_ranges
generic<T>
pub fn copy(data: &list<T>) -> list<T> {
    var copied: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        copied.push(data[i]);
    }
    return copied;
}

/// @brief Copy into an existing mutable list, stopping at either range's end.
/// Returns the number of elements written; the source is unchanged.
/// @ingroup algorithm_ranges
generic<T>
pub fn copy_to(source: &list<T>, destination: &mut list<T>) -> i64 {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var count: i64 = source_len;
    if destination_len < count { count = destination_len; }
    for i in 0..count { destination[i] = source[i]; }
    return count;
}

/// @brief Copy at most `count` source elements into an existing destination.
/// Stops when the requested count, source, or destination is exhausted and
/// returns the number written. Both lists remain at their original lengths.
/// Bounded-output eager-list counterpart to C++20 `std::ranges::copy_n`.
/// @ingroup algorithm_ranges
generic<T>
pub fn copy_n_to(source: &list<T>, destination: &mut list<T>,
                 count: i64) -> i64 {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var copied: i64 = count;
    if copied < 0 { copied = 0; }
    if copied > source_len { copied = source_len; }
    if copied > destination_len { copied = destination_len; }
    for i in 0..copied { destination[i] = source[i]; }
    return copied;
}

/// @brief Copy into a bounded destination with a distinct element type.
/// Source values are converted to the destination type; returns the number
/// written without changing either list's length.
/// @ingroup algorithm_ranges
generic<T, Output>
pub fn copy_to_heterogeneous(source: &list<T>,
                             destination: &mut list<Output>) -> i64 {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var copied: i64 = source_len;
    if destination_len < copied { copied = destination_len; }
    for i in 0..copied { destination[i] = source[i]; }
    return copied;
}

/// @brief Copy a bounded prefix into a distinct destination element type.
/// Returns the number written, limited by `count`, source length, and
/// destination length. Negative counts write nothing.
/// @ingroup algorithm_ranges
generic<T, Output>
pub fn copy_n_to_heterogeneous(source: &list<T>,
                               destination: &mut list<Output>,
                               count: i64) -> i64 {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var copied: i64 = count;
    if copied < 0 { copied = 0; }
    if copied > source_len { copied = source_len; }
    if copied > destination_len { copied = destination_len; }
    for i in 0..copied { destination[i] = source[i]; }
    return copied;
}

/// @brief Project and copy the common source/destination prefix.
/// Returns the number of elements written; neither list changes length.
/// @ingroup algorithm_ranges
generic<T, Output, Projection>
pub fn copy_to_projected(source: &list<T>, destination: &mut list<Output>,
                         projection: Projection) -> i64 {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var copied: i64 = source_len;
    if destination_len < copied { copied = destination_len; }
    for i in 0..copied { destination[i] = projection(source[i]); }
    return copied;
}

/// @brief Copy a projected prefix into a bounded existing destination.
/// Stops at the requested count or either range's end; negative counts write
/// nothing. Returns the number of output elements written.
/// @ingroup algorithm_ranges
generic<T, Output, Projection>
pub fn copy_n_to_projected(source: &list<T>,
                           destination: &mut list<Output>, count: i64,
                           projection: Projection) -> i64 {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var copied: i64 = count;
    if copied < 0 { copied = 0; }
    if copied > source_len { copied = source_len; }
    if copied > destination_len { copied = destination_len; }
    for i in 0..copied { destination[i] = projection(source[i]); }
    return copied;
}

/// @brief Project a bounded source prefix into a distinct output element type.
/// Stops at the requested count or either range's end; negative counts write
/// nothing. Returns the number written and preserves the destination suffix.
/// @ingroup algorithm_ranges
generic<T, Output, Projection>
pub fn copy_n_to_heterogeneous_projected(
    source: &list<T>, destination: &mut list<Output>, count: i64,
    projection: Projection) -> i64 {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var copied: i64 = count;
    if copied < 0 { copied = 0; }
    if copied > source_len { copied = source_len; }
    if copied > destination_len { copied = destination_len; }
    for i in 0..copied { destination[i] = projection(source[i]); }
    return copied;
}

/// @brief Copy a range backward into an existing destination list.
/// Values align at the end of the destination. If the destination is shorter,
/// the source suffix that fits is copied. Returns `(source_first,
/// destination_first)` for the copied subranges; empty copies return the
/// respective end indices. The source and unused destination prefix are kept.
/// This bounded eager-list form adapts C++20 `std::ranges::copy_backward`.
/// @ingroup algorithm_ranges
generic<T>
pub fn copy_backward_to(source: &list<T>, destination: &mut list<T>)
    -> tuple<i64, i64> {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    let count: i64 = source_len < destination_len ? source_len : destination_len;
    let source_first: i64 = source_len - count;
    let destination_first: i64 = destination_len - count;
    var offset: i64 = count;
    while offset > 0 {
        offset = offset - 1;
        destination[destination_first + offset] = source[source_first + offset];
    }
    return (source_first, destination_first);
}

/// @brief Copy a source suffix backward into a distinct destination type.
/// Values align at the destination end; returns the first source and
/// destination indices copied. If the destination is shorter, the source
/// suffix that fits is used.
/// @ingroup algorithm_ranges
generic<T, Output>
pub fn copy_backward_to_heterogeneous(
    source: &list<T>, destination: &mut list<Output>) -> tuple<i64, i64> {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    let count: i64 = source_len < destination_len ? source_len : destination_len;
    let source_first: i64 = source_len - count;
    let destination_first: i64 = destination_len - count;
    var offset: i64 = count;
    while offset > 0 {
        offset = offset - 1;
        destination[destination_first + offset] = source[source_first + offset];
    }
    return (source_first, destination_first);
}

/// @brief Project and copy a source suffix aligned to the destination end.
/// Returns the first copied indices in both lists, matching
/// `copy_backward_to`'s bounded-output convention.
/// @ingroup algorithm_ranges
generic<T, Output, Projection>
pub fn copy_backward_to_projected(source: &list<T>,
                                  destination: &mut list<Output>,
                                  projection: Projection)
    -> tuple<i64, i64> {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    let count: i64 = source_len < destination_len ? source_len : destination_len;
    let source_first: i64 = source_len - count;
    let destination_first: i64 = destination_len - count;
    var offset: i64 = count;
    while offset > 0 {
        offset = offset - 1;
        destination[destination_first + offset] =
            projection(source[source_first + offset]);
    }
    return (source_first, destination_first);
}

/// @brief Project a source suffix into a distinct type aligned to output end.
/// Returns the first copied indices in both lists. If output is shorter, the
/// source suffix that fits is used and the unused destination prefix is kept.
/// @ingroup algorithm_ranges
generic<T, Output, Projection>
pub fn copy_backward_to_heterogeneous_projected(
    source: &list<T>, destination: &mut list<Output>, projection: Projection)
    -> tuple<i64, i64> {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    let count: i64 = source_len < destination_len ? source_len : destination_len;
    let source_first: i64 = source_len - count;
    let destination_first: i64 = destination_len - count;
    var offset: i64 = count;
    while offset > 0 {
        offset = offset - 1;
        destination[destination_first + offset] =
            projection(source[source_first + offset]);
    }
    return (source_first, destination_first);
}

/// @brief Materialize a range as a new list with the requested element type.
/// This is the eager-list counterpart of C++23 `std::ranges::to` for list
/// construction. Each source element is converted to `Output` in order.
/// @ingroup algorithm_ranges
generic<T, Output>
pub fn to_list(data: &list<T>) -> list<Output> {
    var converted: list<Output> = [];
    let n: i64 = data.len();
    for i in 0..n {
        converted.push(Output(data[i]));
    }
    return converted;
}

/// @brief Recursively materialize a nested range as nested output lists.
/// Inner list elements are converted using the same rules as `to_list`.
/// @ingroup algorithm_ranges
generic<T, Output>
pub fn to_list(data: &list<list<T>>) -> list<list<Output>> {
    var converted: list<list<Output>> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let row: list<Output> = to_list(data[i]);
        converted.push(row);
    }
    return converted;
}

/// @brief Materialize an ordered flat set as a list.
/// The result follows ascending iteration order and can be passed to the
/// list-based range algorithms.
/// @ingroup algorithm_ranges
generic<T>
pub fn to_list_from_flat_set(data: &FlatSet<T>) -> list<T> {
    var converted: list<T> = [];
    let n: i64 = data.keys.len();
    for i in 0..n { converted.push(data.keys[i]); }
    return converted;
}

/// @brief Materialize an ordered flat multiset as a list, preserving repeats.
/// @ingroup algorithm_ranges
generic<T>
pub fn to_list_from_flat_multiset(data: &FlatMultiSet<T>) -> list<T> {
    var converted: list<T> = [];
    let n: i64 = data.keys.len();
    for i in 0..n { converted.push(data.keys[i]); }
    return converted;
}

generic<K, V>
pub fn to_list_from_flat_map(data: &FlatMap<K, V>) -> list<tuple<K, V>> {
    return data.entries;
}

/// @brief Materialize flat multimap entries as a list of key/value tuples.
/// Repeated keys and their value order are preserved.
/// @ingroup algorithm_ranges
generic<K, V>
pub fn to_list_from_flat_multimap(data: &FlatMultiMap<K, V>)
    -> list<tuple<K, V>> {
    return data.entries;
}

/// @brief Materialize builtin map entries as a list of key/value tuples.
/// Builtin map iteration order is unspecified, matching the source container.
/// @ingroup algorithm_ranges
generic<K, V>
pub fn to_list_from_map(data: &map<K, V>) -> list<tuple<K, V>> {
    var converted: list<tuple<K, V>> = [];
    for entry in data.entries() { converted.push(entry); }
    return converted;
}

/// @brief Materialize builtin map keys as a list.
/// Order remains unspecified, matching builtin map iteration.
/// @ingroup algorithm_ranges
generic<K, V>
pub fn to_list_from_map_keys(data: &map<K, V>) -> list<K> {
    var converted: list<K> = [];
    for key in data.keys() { converted.push(key); }
    return converted;
}

/// @brief Materialize builtin map values as a list.
/// Values follow the same unspecified order as the corresponding keys.
/// @ingroup algorithm_ranges
generic<K, V>
pub fn to_list_from_map_values(data: &map<K, V>) -> list<V> {
    var converted: list<V> = [];
    for value in data.values() { converted.push(value); }
    return converted;
}

/// @brief Materialize a range after projecting each element to the output type.
/// The projection runs once per source element, in order, and the source is
/// left unchanged. This fuses a transform with C++23-style range materialization.
/// @ingroup algorithm_ranges
generic<T, Output, Projection>
pub fn to_list_projected(data: &list<T>, projection: Projection)
    -> list<Output> {
    var converted: list<Output> = [];
    let n: i64 = data.len();
    for i in 0..n { converted.push(projection(data[i])); }
    return converted;
}

/// @brief Materialize a range as a sorted, unique `FlatSet`.
/// Duplicate values collapse according to `FlatSet` ordering equivalence.
/// C++23 `std::ranges::to` adapted to Mlang's `std::flat_set` container.
/// @ingroup algorithm_ranges
generic<T>
pub fn to_flat_set(data: &list<T>) -> FlatSet<T> {
    var converted: FlatSet<T> = FlatSet<T>::new();
    let n: i64 = data.len();
    for i in 0..n { converted.insert(data[i]); }
    return converted;
}

/// @brief Materialize projected keys as a sorted, unique `FlatSet`.
/// The projection is evaluated once per source element and the input is
/// unchanged. This fuses a transform with C++23-style range materialization.
/// @ingroup algorithm_ranges
generic<T, Key, Projection>
pub fn to_flat_set_projected(data: &list<T>, projection: Projection)
    -> FlatSet<Key> {
    var converted: FlatSet<Key> = FlatSet<Key>::new();
    let n: i64 = data.len();
    for i in 0..n { converted.insert(projection(data[i])); }
    return converted;
}

/// @brief Materialize a range as a sorted `FlatMultiSet`, retaining duplicates.
/// Equivalent values retain their source order within the sorted key group.
/// C++23 `std::ranges::to` adapted to Mlang's flat multiset container.
/// @ingroup algorithm_ranges
generic<T>
pub fn to_flat_multiset(data: &list<T>) -> FlatMultiSet<T> {
    var converted: FlatMultiSet<T> = FlatMultiSet<T>::new();
    let n: i64 = data.len();
    for i in 0..n { converted.insert(data[i]); }
    return converted;
}

/// @brief Materialize projected keys as a sorted `FlatMultiSet`.
/// Duplicate projected keys are retained in source order within each group;
/// the projection is evaluated once per input element.
/// @ingroup algorithm_ranges
generic<T, Key, Projection>
pub fn to_flat_multiset_projected(data: &list<T>, projection: Projection)
    -> FlatMultiSet<Key> {
    var converted: FlatMultiSet<Key> = FlatMultiSet<Key>::new();
    let n: i64 = data.len();
    for i in 0..n { converted.insert(projection(data[i])); }
    return converted;
}

/// @brief Materialize key/value pairs as a sorted, unique `FlatMap`.
/// Pairs are `(key, value)` tuples. If the input contains equivalent keys, the
/// last pair in source order supplies the retained value.
/// C++23 `std::ranges::to` adapted to Mlang's `std::flat_map` container.
/// @ingroup algorithm_ranges
generic<K, V>
pub fn to_flat_map(data: &list<tuple<K, V>>) -> FlatMap<K, V> {
    var converted: FlatMap<K, V> = FlatMap<K, V>::new();
    let n: i64 = data.len();
    for i in 0..n {
        let entry: tuple<K, V> = data[i];
        converted.insert(entry.0, entry.1);
    }
    return converted;
}

/// @brief Materialize projected key/value pairs as a sorted `FlatMap`.
/// The projection runs once per source element. Repeated equivalent keys keep
/// the value from the last source element, matching `to_flat_map`.
/// @ingroup algorithm_ranges
generic<T, K, V, Projection>
pub fn to_flat_map_projected(data: &list<T>, projection: Projection)
    -> FlatMap<K, V> {
    var converted: FlatMap<K, V> = FlatMap<K, V>::new();
    let n: i64 = data.len();
    for i in 0..n {
        let entry: tuple<K, V> = projection(data[i]);
        converted.insert(entry.0, entry.1);
    }
    return converted;
}

/// @brief Materialize key/value pairs as a sorted `FlatMultiMap`.
/// Duplicate keys are retained, and their input order is preserved within each
/// equivalent-key group.
/// C++23 `std::ranges::to` adapted to Mlang's `std::flat_multimap` container.
/// @ingroup algorithm_ranges
generic<K, V>
pub fn to_flat_multimap(data: &list<tuple<K, V>>) -> FlatMultiMap<K, V> {
    var converted: FlatMultiMap<K, V> = FlatMultiMap<K, V>::new();
    let n: i64 = data.len();
    for i in 0..n {
        let entry: tuple<K, V> = data[i];
        converted.insert(entry.0, entry.1);
    }
    return converted;
}

/// @brief Materialize projected pairs as a sorted `FlatMultiMap`.
/// Duplicate keys are retained and projection runs once per source element.
/// @ingroup algorithm_ranges
generic<T, K, V, Projection>
pub fn to_flat_multimap_projected(data: &list<T>, projection: Projection)
    -> FlatMultiMap<K, V> {
    var converted: FlatMultiMap<K, V> = FlatMultiMap<K, V>::new();
    let n: i64 = data.len();
    for i in 0..n {
        let entry: tuple<K, V> = projection(data[i]);
        converted.insert(entry.0, entry.1);
    }
    return converted;
}

/// @brief Materialize key/value tuples into Mlang's built-in map.
/// Iteration order is unspecified. If equivalent keys repeat, the last pair
/// in source order supplies the stored value.
/// C++23 `std::ranges::to` adapted to Mlang's built-in `map` container.
/// @ingroup algorithm_ranges
generic<K, V>
pub fn to_map(data: &list<tuple<K, V>>) -> map<K, V> {
    var converted: map<K, V> {};
    var seen: list<K> = [];
    let n: i64 = data.len();
    var i: i64 = n;
    while i > 0 {
        i = i - 1;
        let entry: tuple<K, V> = data[i];
        var already_seen: bool = false;
        for j in 0..seen.len() {
            if seen[j] == entry.0 {
                already_seen = true;
                break;
            }
        }
        if !already_seen {
            let singleton: map<K, V> = {entry.0: entry.1};
            converted.extend(singleton);
            seen.push(entry.0);
        }
    }
    return converted;
}

/// @brief Materialize projected pairs into Mlang's built-in map.
/// As with `to_map`, the last source element for a repeated key wins.
/// @ingroup algorithm_ranges
generic<T, K, V, Projection>
pub fn to_map_projected(data: &list<T>, projection: Projection) -> map<K, V> {
    var converted: map<K, V> {};
    var seen: list<K> = [];
    let n: i64 = data.len();
    var i: i64 = n;
    while i > 0 {
        i = i - 1;
        let entry: tuple<K, V> = projection(data[i]);
        var already_seen: bool = false;
        for j in 0..seen.len() {
            if seen[j] == entry.0 {
                already_seen = true;
                break;
            }
        }
        if !already_seen {
            let singleton: map<K, V> = {entry.0: entry.1};
            converted.extend(singleton);
            seen.push(entry.0);
        }
    }
    return converted;
}

/// @brief Swap corresponding elements into two copied ranges.
/// Swaps the common prefix and preserves either unmatched tail. Unlike the
/// mutating C++20 algorithm, this eager-list form returns both new lists and
/// leaves the inputs unchanged.
/// @ingroup algorithm_ranges
generic<T>
pub fn swap_ranges(left: &list<T>, right: &list<T>)
    -> tuple<list<T>, list<T>> {
    var swapped_left: list<T> = [];
    var swapped_right: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let common_len: i64 = left_len < right_len ? left_len : right_len;
    for i in 0..common_len {
        swapped_left.push(right[i]);
        swapped_right.push(left[i]);
    }
    for i in common_len..left_len {
        swapped_left.push(left[i]);
    }
    for i in common_len..right_len {
        swapped_right.push(right[i]);
    }
    return (swapped_left, swapped_right);
}

/// @brief Swap corresponding elements of two mutable lists in place.
/// Only the common prefix is exchanged; unmatched tails are untouched.
/// Returns the number of positions swapped, matching the consumed range length
/// of C++20 `std::ranges::swap_ranges` in this eager-list API.
/// @ingroup algorithm_ranges
generic<T>
pub fn swap_ranges_in_place(left: &mut list<T>, right: &mut list<T>) -> i64 {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let common_len: i64 = left_len < right_len ? left_len : right_len;
    for i in 0..common_len {
        let temporary: T = left[i];
        left[i] = right[i];
        right[i] = temporary;
    }
    return common_len;
}

/// @brief Return a copied list containing elements accepted by `predicate`.
/// This is an eager ranges-style filter/copy-if operation.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn filter(data: &list<T>, predicate: Predicate) -> list<T> {
    var selected: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(data[i]) {
            selected.push(data[i]);
        }
    }
    return selected;
}

/// @brief Filter elements using a predicate applied to projected keys.
/// The output retains original elements and order.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn copy_if_projected(data: &list<T>, predicate: Predicate,
                         projection: Projection) -> list<T> {
    var selected: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(projection(data[i])) { selected.push(data[i]); }
    }
    return selected;
}

/// @brief Copy predicate-matching elements into a bounded destination list.
/// Stops when the source ends or the destination fills and returns
/// `(consumed, written)`; each consumed input is tested once.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn copy_if_to(source: &list<T>, destination: &mut list<T>,
                  predicate: Predicate) -> tuple<i64, i64> {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var consumed: i64 = 0;
    var written: i64 = 0;
    while consumed < source_len && written < destination_len {
        let value: T = source[consumed];
        if predicate(value) {
            destination[written] = value;
            written = written + 1;
        }
        consumed = consumed + 1;
    }
    return (consumed, written);
}

/// @brief Copy predicate-matching values into a bounded distinct-type output.
/// Stops when the source ends or the destination fills; returns
/// `(consumed, written)`. Original source values are converted to the output
/// element type.
/// @ingroup algorithm_ranges
generic<T, Output, Predicate>
pub fn copy_if_to_heterogeneous(source: &list<T>,
    destination: &mut list<Output>, predicate: Predicate)
    -> tuple<i64, i64> {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var consumed: i64 = 0;
    var written: i64 = 0;
    while consumed < source_len && written < destination_len {
        let value: T = source[consumed];
        if predicate(value) {
            destination[written] = value;
            written = written + 1;
        }
        consumed = consumed + 1;
    }
    return (consumed, written);
}

/// @brief Copy matching elements using a projected predicate into a bounded destination.
/// Returns `(consumed, written)`; the predicate and projection are each run
/// once for each consumed source item.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn copy_if_to_projected(
    source: &list<T>, destination: &mut list<T>, predicate: Predicate,
    projection: Projection) -> tuple<i64, i64> {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var consumed: i64 = 0;
    var written: i64 = 0;
    while consumed < source_len && written < destination_len {
        let value: T = source[consumed];
        if predicate(projection(value)) {
            destination[written] = value;
            written = written + 1;
        }
        consumed = consumed + 1;
    }
    return (consumed, written);
}

/// @brief Project for filtering while converting original values to output.
/// Returns `(consumed, written)` and stops when the source ends or the bounded
/// destination fills. The projection and predicate run once per consumed
/// source element.
/// @ingroup algorithm_ranges
generic<T, Output, Predicate, Projection>
pub fn copy_if_to_heterogeneous_projected(
    source: &list<T>, destination: &mut list<Output>, predicate: Predicate,
    projection: Projection) -> tuple<i64, i64> {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var consumed: i64 = 0;
    var written: i64 = 0;
    while consumed < source_len && written < destination_len {
        let value: T = source[consumed];
        if predicate(projection(value)) {
            destination[written] = value;
            written = written + 1;
        }
        consumed = consumed + 1;
    }
    return (consumed, written);
}

/// @brief Filter and transform in one pass, preserving the selected order.
/// Eager equivalent of composing C++20 `views::filter` and
/// `views::transform`, without materializing an intermediate list.
/// @ingroup algorithm_ranges
generic<T, Output, Predicate, Operation>
pub fn filter_transform(data: &list<T>, predicate: Predicate,
                        operation: Operation) -> list<Output> {
    var transformed: list<Output> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(data[i]) {
            transformed.push(operation(data[i]));
        }
    }
    return transformed;
}

/// @brief Filter by projected keys and transform selected original elements.
/// Predicate and operation each run at most once per element; the projection
/// runs exactly once per element.
/// @ingroup algorithm_ranges
generic<T, Output, Predicate, Operation, Projection>
pub fn filter_transform_projected(data: &list<T>, predicate: Predicate,
                                  operation: Operation,
                                  projection: Projection) -> list<Output> {
    var transformed: list<Output> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let key = projection(data[i]);
        if predicate(key) {
            transformed.push(operation(data[i]));
        }
    }
    return transformed;
}

/// @brief Filter and transform into a bounded, caller-provided output range.
/// Stops when the source ends or the destination fills; returns
/// `(consumed, written)` so callers can resume at the exact source position.
/// Predicate runs once per consumed input and operation only for matches.
/// @ingroup algorithm_ranges
generic<T, Output, Predicate, Operation>
pub fn filter_transform_to(source: &list<T>, destination: &mut list<Output>,
    predicate: Predicate, operation: Operation) -> tuple<i64, i64> {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var consumed: i64 = 0;
    var written: i64 = 0;
    while consumed < source_len && written < destination_len {
        let value: T = source[consumed];
        if predicate(value) {
            destination[written] = operation(value);
            written = written + 1;
        }
        consumed = consumed + 1;
    }
    return (consumed, written);
}

/// @brief Projected filter-transform into bounded output storage.
/// Projection and predicate run once per consumed input; operation transforms
/// each selected original value. Returns `(consumed, written)`.
/// @ingroup algorithm_ranges
generic<T, Output, Predicate, Operation, Projection>
pub fn filter_transform_to_projected(
    source: &list<T>, destination: &mut list<Output>, predicate: Predicate,
    operation: Operation, projection: Projection) -> tuple<i64, i64> {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var consumed: i64 = 0;
    var written: i64 = 0;
    while consumed < source_len && written < destination_len {
        let value: T = source[consumed];
        if predicate(projection(value)) {
            destination[written] = operation(value);
            written = written + 1;
        }
        consumed = consumed + 1;
    }
    return (consumed, written);
}

/// @brief Transform every element into a new list using `operation`.
/// The output element type is inferred from the operation's return type,
/// so input and output ranges may have different element types.
/// C++20 `std::ranges::transform` (unary form) equivalent.
/// @ingroup algorithm_ranges
generic<T, Output, Operation>
pub fn transform(data: &list<T>, operation: Operation) -> list<Output> {
    var transformed: list<Output> = [];
    let n: i64 = data.len();
    for i in 0..n {
        transformed.push(operation(data[i]));
    }
    return transformed;
}

/// @brief Transform each element of a mutable list in place.
/// The operation must return the list's element type; returns the number of
/// elements transformed.
/// @ingroup algorithm_ranges
generic<T, Operation>
pub fn transform_in_place(data: &mut list<T>, operation: Operation) -> i64 {
    let n: i64 = data.len();
    for i in 0..n { data[i] = operation(data[i]); }
    return n;
}

/// @brief Transform into a caller-provided output range.
/// Stops when either range ends and returns the number of elements written;
/// source and destination element types may differ.
/// C++20 bounded `std::ranges::transform` output-range form.
/// @ingroup algorithm_ranges
generic<T, Output, Operation>
pub fn transform_to(source: &list<T>, destination: &mut list<Output>,
                    operation: Operation) -> i64 {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var count: i64 = source_len;
    if destination_len < count { count = destination_len; }
    for i in 0..count { destination[i] = operation(source[i]); }
    return count;
}

/// @brief Binary transform into a caller-provided output range.
/// Processes paired positions until either input or the destination ends and
/// returns the number written. The two input element types and output type may
/// all differ. C++20 `std::ranges::transform` binary output-range form.
/// @ingroup algorithm_ranges
generic<T, U, Output, Operation>
pub fn transform_to(left: &list<T>, right: &list<U>,
                    destination: &mut list<Output>,
                    operation: Operation) -> i64 {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let destination_len: i64 = destination.len();
    var count: i64 = left_len;
    if right_len < count { count = right_len; }
    if destination_len < count { count = destination_len; }
    for i in 0..count {
        destination[i] = operation(left[i], right[i]);
    }
    return count;
}

/// @brief Transform a range and return the consumed count with the output.
/// The count equals the input length, including zero for empty input. This
/// exposes an eager-list analogue of the input/output progress in C++20's
/// `std::ranges::transform` result.
/// @ingroup algorithm_ranges
generic<T, Output, Operation>
pub fn transform_with_count(data: &list<T>, operation: Operation)
    -> tuple<i64, list<Output>> {
    var transformed: list<Output> = [];
    let n: i64 = data.len();
    for i in 0..n {
        transformed.push(operation(data[i]));
    }
    return (n, transformed);
}

/// @brief Transform corresponding values from two ranges into a new list.
/// Stops when either input ends, matching the bounded binary overload of
/// C++20 `std::ranges::transform`.
/// @ingroup algorithm_ranges
generic<T, U, Output, Operation>
pub fn transform(left: &list<T>, right: &list<U>, operation: Operation)
    -> list<Output> {
    var transformed: list<Output> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var count: i64 = left_len;
    if right_len < count { count = right_len; }
    for i in 0..count {
        transformed.push(operation(left[i], right[i]));
    }
    return transformed;
}

/// @brief Project each input element, then transform the projected value.
/// The result type is inferred from the operation's return type.
/// @ingroup algorithm_ranges
generic<T, Output, Operation, Projection>
pub fn transform_projected(data: &list<T>, operation: Operation,
                           projection: Projection) -> list<Output> {
    var transformed: list<Output> = [];
    let n: i64 = data.len();
    for i in 0..n {
        transformed.push(operation(projection(data[i])));
    }
    return transformed;
}

/// @brief Project and transform each element of a mutable list in place.
/// The operation must return the list's element type; each input element is
/// projected before it is overwritten. Returns the number transformed.
/// @ingroup algorithm_ranges
generic<T, Operation, Projection>
pub fn transform_in_place_projected(data: &mut list<T>, operation: Operation,
                                    projection: Projection) -> i64 {
    let n: i64 = data.len();
    for i in 0..n {
        data[i] = operation(projection(data[i]));
    }
    return n;
}

/// @brief Project and transform into a caller-provided output range.
/// Stops when either range ends; returns the number of elements written.
/// @ingroup algorithm_ranges
generic<T, Output, Operation, Projection>
pub fn transform_to_projected(
    source: &list<T>, destination: &mut list<Output>, operation: Operation,
    projection: Projection) -> i64 {
    let source_len: i64 = source.len();
    let destination_len: i64 = destination.len();
    var count: i64 = source_len;
    if destination_len < count { count = destination_len; }
    for i in 0..count {
        destination[i] = operation(projection(source[i]));
    }
    return count;
}

/// @brief Binary transform after independent input projections.
/// Stops when either input or the destination ends; returns the number written.
/// @ingroup algorithm_ranges
generic<T, U, Output, Operation, LeftProjection, RightProjection>
pub fn transform_to_projected(
    left: &list<T>, right: &list<U>, destination: &mut list<Output>,
    operation: Operation, left_projection: LeftProjection,
    right_projection: RightProjection) -> i64 {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let destination_len: i64 = destination.len();
    var count: i64 = left_len;
    if right_len < count { count = right_len; }
    if destination_len < count { count = destination_len; }
    for i in 0..count {
        destination[i] = operation(left_projection(left[i]),
                                  right_projection(right[i]));
    }
    return count;
}

/// @brief Project and transform a range, returning its consumed count.
/// @ingroup algorithm_ranges
generic<T, Output, Operation, Projection>
pub fn transform_projected_with_count(
    data: &list<T>, operation: Operation, projection: Projection)
    -> tuple<i64, list<Output>> {
    var transformed: list<Output> = [];
    let n: i64 = data.len();
    for i in 0..n {
        transformed.push(operation(projection(data[i])));
    }
    return (n, transformed);
}

/// @brief Transform corresponding elements from two ranges into a new list.
/// Stops when either input range ends. The output element type is inferred
/// from the binary operation's return type (C++23 `ranges::zip_transform`).
/// @ingroup algorithm_ranges
generic<T, U, Output, Operation>
pub fn zip_transform(left: &list<T>, right: &list<U>, operation: Operation)
    -> list<Output> {
    var transformed: list<Output> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var n: i64 = left_len;
    if right_len < n {
        n = right_len;
    }
    for i in 0..n {
        transformed.push(operation(left[i], right[i]));
    }
    return transformed;
}

/// @brief Transform paired values after applying an independent projection.
/// Stops at the shorter input; output type is inferred from `operation`.
/// @ingroup algorithm_ranges
generic<T, U, Output, Operation, LeftProjection, RightProjection>
pub fn zip_transform_projected(
    left: &list<T>, right: &list<U>, operation: Operation,
    left_projection: LeftProjection, right_projection: RightProjection)
    -> list<Output> {
    var transformed: list<Output> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var n: i64 = left_len;
    if right_len < n { n = right_len; }
    for i in 0..n {
        transformed.push(operation(left_projection(left[i]),
                                   right_projection(right[i])));
    }
    return transformed;
}

/// @brief Write binary zip-transform results to bounded output storage.
/// Stops at either input or destination end and returns the number written.
/// @ingroup algorithm_ranges
generic<T, U, Output, Operation>
pub fn zip_transform_to(left: &list<T>, right: &list<U>,
    destination: &mut list<Output>, operation: Operation) -> i64 {
    return transform_to(left, right, destination, operation);
}

/// @brief Bounded zip-transform with independent input projections.
/// @ingroup algorithm_ranges
generic<T, U, Output, Operation, LeftProjection, RightProjection>
pub fn zip_transform_to_projected(
    left: &list<T>, right: &list<U>, destination: &mut list<Output>,
    operation: Operation, left_projection: LeftProjection,
    right_projection: RightProjection) -> i64 {
    return transform_to_projected(left, right, destination, operation,
                                  left_projection, right_projection);
}

/// @brief Bounded three-range zip-transform.
/// Stops at the shortest input or destination and returns the number written.
/// @ingroup algorithm_ranges
generic<T, U, V, Output, Operation>
pub fn zip_transform3_to(first: &list<T>, second: &list<U>,
    third: &list<V>, destination: &mut list<Output>,
    operation: Operation) -> i64 {
    var count: i64 = first.len();
    if second.len() < count { count = second.len(); }
    if third.len() < count { count = third.len(); }
    if destination.len() < count { count = destination.len(); }
    for i in 0..count {
        destination[i] = operation(first[i], second[i], third[i]);
    }
    return count;
}

