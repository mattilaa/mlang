/// @brief Write heterogeneous sorted left-minus-right difference.
/// Values appearing only on the left are copied to bounded output.
/// @ingroup algorithm_ranges
generic<Left, Right, Output>
pub fn difference_sorted_to_heterogeneous(
    left: &list<Left>, right: &list<Right>, destination: &mut list<Output>)
    -> tuple<i64, i64, i64> {
    return ranges_set_operation_to_heterogeneous_core(
        left, right, destination, ranges_heterogeneous_less,
        ranges_identity, ranges_identity, 2);
}

generic<Left, Right, Output, LeftProjection, RightProjection>
pub fn difference_sorted_to_heterogeneous_projected(
    left: &list<Left>, right: &list<Right>, destination: &mut list<Output>,
    left_projection: LeftProjection, right_projection: RightProjection)
    -> tuple<i64, i64, i64> {
    return ranges_set_operation_to_heterogeneous_core(
        left, right, destination, ranges_heterogeneous_less,
        left_projection, right_projection, 2);
}

generic<Left, Right, Output, Less>
pub fn difference_sorted_to_heterogeneous_by(
    left: &list<Left>, right: &list<Right>, destination: &mut list<Output>,
    less: Less) -> tuple<i64, i64, i64> {
    return ranges_set_operation_to_heterogeneous_core(
        left, right, destination, less, ranges_identity, ranges_identity, 2);
}

generic<Left, Right, Output, Less, LeftProjection, RightProjection>
pub fn difference_sorted_to_heterogeneous_by_projected(
    left: &list<Left>, right: &list<Right>, destination: &mut list<Output>,
    less: Less, left_projection: LeftProjection,
    right_projection: RightProjection) -> tuple<i64, i64, i64> {
    return ranges_set_operation_to_heterogeneous_core(
        left, right, destination, less, left_projection, right_projection, 2);
}

/// @brief Write heterogeneous sorted symmetric difference to bounded output.
/// Keys present in only one range are retained, including multiplicity excess.
/// @ingroup algorithm_ranges
generic<Left, Right, Output>
pub fn symmetric_difference_sorted_to_heterogeneous(
    left: &list<Left>, right: &list<Right>, destination: &mut list<Output>)
    -> tuple<i64, i64, i64> {
    return ranges_set_operation_to_heterogeneous_core(
        left, right, destination, ranges_heterogeneous_less,
        ranges_identity, ranges_identity, 3);
}

generic<Left, Right, Output, LeftProjection, RightProjection>
pub fn symmetric_difference_sorted_to_heterogeneous_projected(
    left: &list<Left>, right: &list<Right>, destination: &mut list<Output>,
    left_projection: LeftProjection, right_projection: RightProjection)
    -> tuple<i64, i64, i64> {
    return ranges_set_operation_to_heterogeneous_core(
        left, right, destination, ranges_heterogeneous_less,
        left_projection, right_projection, 3);
}

generic<Left, Right, Output, Less>
pub fn symmetric_difference_sorted_to_heterogeneous_by(
    left: &list<Left>, right: &list<Right>, destination: &mut list<Output>,
    less: Less) -> tuple<i64, i64, i64> {
    return ranges_set_operation_to_heterogeneous_core(
        left, right, destination, less, ranges_identity, ranges_identity, 3);
}

generic<Left, Right, Output, Less, LeftProjection, RightProjection>
pub fn symmetric_difference_sorted_to_heterogeneous_by_projected(
    left: &list<Left>, right: &list<Right>, destination: &mut list<Output>,
    less: Less, left_projection: LeftProjection,
    right_projection: RightProjection) -> tuple<i64, i64, i64> {
    return ranges_set_operation_to_heterogeneous_core(
        left, right, destination, less, left_projection, right_projection, 3);
}

/// @brief Return the sorted multiset union of two sorted ranges.
/// The result keeps the maximum multiplicity of each value.
/// C++20 `std::ranges::set_union` equivalent for same-typed lists.
/// @ingroup algorithm_ranges
generic<T>
pub fn union_sorted(left: &list<T>, right: &list<T>) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if left[i] < right[j] {
            out.push(left[i]);
            i = i + 1;
        } else if right[j] < left[i] {
            out.push(right[j]);
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
            j = j + 1;
        }
    }
    while i < left_len {
        out.push(left[i]);
        i = i + 1;
    }
    while j < right_len {
        out.push(right[j]);
        j = j + 1;
    }
    return out;
}

/// @brief Return the sorted multiset union according to projected keys.
/// The result keeps the maximum multiplicity of each projected equivalence
/// class and prefers left-side representatives for matches.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn union_sorted_projected(left: &list<T>, right: &list<T>,
                              projection: Projection) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if projection(left[i]) < projection(right[j]) {
            out.push(left[i]);
            i = i + 1;
        } else if projection(right[j]) < projection(left[i]) {
            out.push(right[j]);
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
            j = j + 1;
        }
    }
    while i < left_len {
        out.push(left[i]);
        i = i + 1;
    }
    while j < right_len {
        out.push(right[j]);
        j = j + 1;
    }
    return out;
}

/// @brief Return the sorted multiset intersection of two sorted ranges.
/// The result keeps the minimum multiplicity of each value.
/// C++20 `std::ranges::set_intersection` equivalent for same-typed lists.
/// @ingroup algorithm_ranges
generic<T>
pub fn intersection_sorted(left: &list<T>, right: &list<T>) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if left[i] < right[j] {
            i = i + 1;
        } else if right[j] < left[i] {
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
            j = j + 1;
        }
    }
    return out;
}

/// @brief Return the sorted intersection under projected-key equivalence.
/// The result keeps the minimum multiplicity and left-side representatives.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn intersection_sorted_projected(left: &list<T>, right: &list<T>,
                                     projection: Projection) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if projection(left[i]) < projection(right[j]) {
            i = i + 1;
        } else if projection(right[j]) < projection(left[i]) {
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
            j = j + 1;
        }
    }
    return out;
}

/// @brief Return elements in the left sorted range not matched by the right.
/// The result keeps the unmatched excess multiplicity from `left`.
/// C++20 `std::ranges::set_difference` equivalent for same-typed lists.
/// @ingroup algorithm_ranges
generic<T>
pub fn difference_sorted(left: &list<T>, right: &list<T>) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if left[i] < right[j] {
            out.push(left[i]);
            i = i + 1;
        } else if right[j] < left[i] {
            j = j + 1;
        } else {
            i = i + 1;
            j = j + 1;
        }
    }
    while i < left_len {
        out.push(left[i]);
        i = i + 1;
    }
    return out;
}

/// @brief Return the projected-key excess multiplicity from the left range.
/// Both inputs must be sorted by the same projection.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn difference_sorted_projected(left: &list<T>, right: &list<T>,
                                   projection: Projection) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if projection(left[i]) < projection(right[j]) {
            out.push(left[i]);
            i = i + 1;
        } else if projection(right[j]) < projection(left[i]) {
            j = j + 1;
        } else {
            i = i + 1;
            j = j + 1;
        }
    }
    while i < left_len {
        out.push(left[i]);
        i = i + 1;
    }
    return out;
}

/// @brief Return sorted values whose occurrences belong to exactly one range.
/// For each value, output the absolute difference in its multiplicities.
/// C++20 `std::ranges::set_symmetric_difference` equivalent.
/// @ingroup algorithm_ranges
generic<T>
pub fn symmetric_difference_sorted(left: &list<T>, right: &list<T>) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if left[i] < right[j] {
            out.push(left[i]);
            i = i + 1;
        } else if right[j] < left[i] {
            out.push(right[j]);
            j = j + 1;
        } else {
            i = i + 1;
            j = j + 1;
        }
    }
    while i < left_len {
        out.push(left[i]);
        i = i + 1;
    }
    while j < right_len {
        out.push(right[j]);
        j = j + 1;
    }
    return out;
}

/// @brief Return projected-key occurrences present in exactly one input.
/// For each key, the output multiplicity is the absolute difference between
/// the two inputs; equivalent values preserve their source order.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn symmetric_difference_sorted_projected(left: &list<T>, right: &list<T>,
                                              projection: Projection)
    -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if projection(left[i]) < projection(right[j]) {
            out.push(left[i]);
            i = i + 1;
        } else if projection(right[j]) < projection(left[i]) {
            out.push(right[j]);
            j = j + 1;
        } else {
            i = i + 1;
            j = j + 1;
        }
    }
    while i < left_len {
        out.push(left[i]);
        i = i + 1;
    }
    while j < right_len {
        out.push(right[j]);
        j = j + 1;
    }
    return out;
}

/// @brief Stably merge two sorted ranges using `less` as their ordering.
/// Equal elements from `left` come first; both inputs must use this ordering.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn merged_by(left: &list<T>, right: &list<T>, less: Less) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if less(right[j], left[i]) {
            out.push(right[j]);
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
        }
    }
    while i < left_len {
        out.push(left[i]);
        i = i + 1;
    }
    while j < right_len {
        out.push(right[j]);
        j = j + 1;
    }
    return out;
}

/// @brief Stably merge ranges ordered by a comparator over projected keys.
/// Equivalent keys from the left range appear first; both inputs must be
/// sorted with the combined ordering.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn merged_by_projected(left: &list<T>, right: &list<T>, less: Less,
                           projection: Projection) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if less(projection(right[j]), projection(left[i])) {
            out.push(right[j]);
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
        }
    }
    while i < left_len { out.push(left[i]); i = i + 1; }
    while j < right_len { out.push(right[j]); j = j + 1; }
    return out;
}

/// @brief Merge sorted lists into an existing bounded destination.
/// Equal elements from `left` precede equal elements from `right`. Returns
/// `(left_consumed, right_consumed, written)`; an output shorter than the
/// complete merge receives only its prefix, and all input lists are unchanged.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
fn ranges_merge_to_core(left: &list<T>, right: &list<T>,
                        destination: &mut list<T>, less: Less,
                        projection: Projection) -> tuple<i64, i64, i64> {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let output_len: i64 = destination.len();
    var i: i64 = 0;
    var j: i64 = 0;
    var written: i64 = 0;
    while written < output_len && i < left_len && j < right_len {
        if less(projection(right[j]), projection(left[i])) {
            destination[written] = right[j];
            j = j + 1;
        } else {
            destination[written] = left[i];
            i = i + 1;
        }
        written = written + 1;
    }
    while written < output_len && i < left_len {
        destination[written] = left[i];
        i = i + 1;
        written = written + 1;
    }
    while written < output_len && j < right_len {
        destination[written] = right[j];
        j = j + 1;
        written = written + 1;
    }
    return (i, j, written);
}

generic<Left, Right>
fn ranges_heterogeneous_less(left: Left, right: Right) -> bool {
    return left < right;
}

generic<Left, Right, Output, Less, LeftProjection, RightProjection>
fn ranges_merge_to_heterogeneous_core(
    left: &list<Left>, right: &list<Right>, destination: &mut list<Output>,
    less: Less, left_projection: LeftProjection,
    right_projection: RightProjection) -> tuple<i64, i64, i64> {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let output_len: i64 = destination.len();
    var i: i64 = 0;
    var j: i64 = 0;
    var written: i64 = 0;
    while written < output_len && i < left_len && j < right_len {
        if less(right_projection(right[j]), left_projection(left[i])) {
            destination[written] = right[j];
            j = j + 1;
        } else {
            destination[written] = left[i];
            i = i + 1;
        }
        written = written + 1;
    }
    while written < output_len && i < left_len {
        destination[written] = left[i];
        i = i + 1;
        written = written + 1;
    }
    while written < output_len && j < right_len {
        destination[written] = right[j];
        j = j + 1;
        written = written + 1;
    }
    return (i, j, written);
}

/// @brief Merge differently typed sorted inputs into bounded output.
/// Stable ties prefer the left range; returns `(left_consumed, right_consumed,
/// written)`. Cross-type ordering must be available through `<`.
/// C++20 `std::ranges::merge` heterogeneous-range adaptation.
/// @ingroup algorithm_ranges
generic<Left, Right, Output>
pub fn merge_to_heterogeneous(left: &list<Left>, right: &list<Right>,
                              destination: &mut list<Output>)
    -> tuple<i64, i64, i64> {
    return ranges_merge_to_heterogeneous_core(
        left, right, destination, ranges_heterogeneous_less,
        ranges_identity, ranges_identity);
}

/// @brief Merge heterogeneous ranges ordered by separate projected keys.
/// The default cross-type `<` relation orders the projections; ties prefer
/// the left input.
/// @ingroup algorithm_ranges
generic<Left, Right, Output, LeftProjection, RightProjection>
pub fn merge_to_heterogeneous_projected(
    left: &list<Left>, right: &list<Right>, destination: &mut list<Output>,
    left_projection: LeftProjection, right_projection: RightProjection)
    -> tuple<i64, i64, i64> {
    return ranges_merge_to_heterogeneous_core(
        left, right, destination, ranges_heterogeneous_less,
        left_projection, right_projection);
}

/// @brief Merge heterogeneous ranges using a custom cross-type comparator.
/// The comparator is tested as `less(right_value, left_value)`; ties prefer
/// the left input.
/// @ingroup algorithm_ranges
generic<Left, Right, Output, Less>
pub fn merge_to_heterogeneous_by(left: &list<Left>, right: &list<Right>,
                                 destination: &mut list<Output>, less: Less)
    -> tuple<i64, i64, i64> {
    return ranges_merge_to_heterogeneous_core(
        left, right, destination, less, ranges_identity, ranges_identity);
}

/// @brief Merge projected heterogeneous ranges with a custom comparator.
/// Comparator arguments are `(projected_right, projected_left)`; equivalent
/// values from the left input remain first.
/// @ingroup algorithm_ranges
generic<Left, Right, Output, Less, LeftProjection, RightProjection>
pub fn merge_to_heterogeneous_by_projected(
    left: &list<Left>, right: &list<Right>, destination: &mut list<Output>,
    less: Less, left_projection: LeftProjection,
    right_projection: RightProjection) -> tuple<i64, i64, i64> {
    return ranges_merge_to_heterogeneous_core(
        left, right, destination, less, left_projection, right_projection);
}

/// @brief Merge sorted ranges into an existing destination using ascending order.
/// @ingroup algorithm_ranges
generic<T>
pub fn merge_to(left: &list<T>, right: &list<T>,
                destination: &mut list<T>) -> tuple<i64, i64, i64> {
    return ranges_merge_to_core(left, right, destination,
                                ranges_default_less, ranges_identity);
}

/// @brief Merge sorted ranges by projected keys into a bounded destination.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn merge_to_projected(left: &list<T>, right: &list<T>,
                          destination: &mut list<T>,
                          projection: Projection)
    -> tuple<i64, i64, i64> {
    return ranges_merge_to_core(left, right, destination,
                                ranges_default_less, projection);
}

/// @brief Merge ranges into bounded output using a caller-supplied ordering.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn merge_to_by(left: &list<T>, right: &list<T>,
                   destination: &mut list<T>, less: Less)
    -> tuple<i64, i64, i64> {
    return ranges_merge_to_core(left, right, destination, less,
                                ranges_identity);
}

/// @brief Merge projected keys into bounded output using a custom ordering.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn merge_to_by_projected(left: &list<T>, right: &list<T>,
                             destination: &mut list<T>, less: Less,
                             projection: Projection)
    -> tuple<i64, i64, i64> {
    return ranges_merge_to_core(left, right, destination, less, projection);
}

/// @brief Stably merge two sorted halves of one range into a copied range.
/// `middle` is clamped to the valid index interval; both halves must already
/// be sorted in ascending order. C++20 `std::ranges::inplace_merge` analogue.
/// @ingroup algorithm_ranges
generic<T>
pub fn inplace_merge(data: &list<T>, middle: i64) -> list<T> {
    var split: i64 = middle;
    let n: i64 = data.len();
    if split < 0 { split = 0; }
    if split > n { split = n; }
    var left: list<T> = [];
    var right: list<T> = [];
    for i in 0..split {
        left.push(data[i]);
    }
    for i in split..n {
        right.push(data[i]);
    }
    return merged(left, right);
}

/// @brief Comparator-based stable merge of two sorted halves.
/// Both halves must be ordered by `less`; `middle` is clamped to the range.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn inplace_merge_by(data: &list<T>, middle: i64, less: Less) -> list<T> {
    var split: i64 = middle;
    let n: i64 = data.len();
    if split < 0 { split = 0; }
    if split > n { split = n; }
    var left: list<T> = [];
    var right: list<T> = [];
    for i in 0..split {
        left.push(data[i]);
    }
    for i in split..n {
        right.push(data[i]);
    }
    return merged_by(left, right, less);
}

/// @brief Stably merge sorted halves by projected keys into a copied list.
/// Equivalent projected keys from the left half remain before right-half
/// equivalents; `middle` is clamped to the range bounds.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn inplace_merge_projected(data: &list<T>, middle: i64,
                               projection: Projection) -> list<T> {
    var split: i64 = middle;
    let n: i64 = data.len();
    if split < 0 { split = 0; }
    if split > n { split = n; }
    var out: list<T> = [];
    var left: i64 = 0;
    var right: i64 = split;
    while left < split && right < n {
        if projection(data[right]) < projection(data[left]) {
            out.push(data[right]);
            right = right + 1;
        } else {
            out.push(data[left]);
            left = left + 1;
        }
    }
    while left < split { out.push(data[left]); left = left + 1; }
    while right < n { out.push(data[right]); right = right + 1; }
    return out;
}

/// @brief Merge sorted halves by comparator-projected ordering into a copy.
/// Equivalent values from the left half remain first; `middle` is clamped.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn inplace_merge_by_projected(data: &list<T>, middle: i64, less: Less,
                                  projection: Projection) -> list<T> {
    var split: i64 = middle;
    let n: i64 = data.len();
    if split < 0 { split = 0; }
    if split > n { split = n; }
    var out: list<T> = [];
    var left: i64 = 0;
    var right: i64 = split;
    while left < split && right < n {
        if less(projection(data[right]), projection(data[left])) {
            out.push(data[right]);
            right = right + 1;
        } else {
            out.push(data[left]);
            left = left + 1;
        }
    }
    while left < split { out.push(data[left]); left = left + 1; }
    while right < n { out.push(data[right]); right = right + 1; }
    return out;
}

/// @brief Stably merge sorted halves into the original mutable list.
/// Uses O(N) temporary storage and returns the number of elements written.
/// @ingroup algorithm_ranges
generic<T>
pub fn inplace_merge_in_place(data: &mut list<T>, middle: i64) -> i64 {
    var split: i64 = middle;
    let n: i64 = data.len();
    if split < 0 { split = 0; }
    if split > n { split = n; }
    var out: list<T> = [];
    var left: i64 = 0;
    var right: i64 = split;
    while left < split && right < n {
        if data[right] < data[left] {
            out.push(data[right]);
            right = right + 1;
        } else {
            out.push(data[left]);
            left = left + 1;
        }
    }
    while left < split { out.push(data[left]); left = left + 1; }
    while right < n { out.push(data[right]); right = right + 1; }
    for i in 0..n { data[i] = out[i]; }
    return n;
}

/// @brief Stably merge sorted halves into the original list by comparator.
/// Uses O(N) temporary storage and returns the number of elements written.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn inplace_merge_in_place_by(data: &mut list<T>, middle: i64,
                                 less: Less) -> i64 {
    var split: i64 = middle;
    let n: i64 = data.len();
    if split < 0 { split = 0; }
    if split > n { split = n; }
    var out: list<T> = [];
    var left: i64 = 0;
    var right: i64 = split;
    while left < split && right < n {
        if less(data[right], data[left]) {
            out.push(data[right]);
            right = right + 1;
        } else {
            out.push(data[left]);
            left = left + 1;
        }
    }
    while left < split { out.push(data[left]); left = left + 1; }
    while right < n { out.push(data[right]); right = right + 1; }
    for i in 0..n { data[i] = out[i]; }
    return n;
}

/// @brief Stably merge sorted halves into the original list by projected key.
/// Uses O(N) temporary storage and returns the number of elements written.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn inplace_merge_in_place_projected(
    data: &mut list<T>, middle: i64, projection: Projection) -> i64 {
    var split: i64 = middle;
    let n: i64 = data.len();
    if split < 0 { split = 0; }
    if split > n { split = n; }
    var out: list<T> = [];
    var left: i64 = 0;
    var right: i64 = split;
    while left < split && right < n {
        if projection(data[right]) < projection(data[left]) {
            out.push(data[right]);
            right = right + 1;
        } else {
            out.push(data[left]);
            left = left + 1;
        }
    }
    while left < split { out.push(data[left]); left = left + 1; }
    while right < n { out.push(data[right]); right = right + 1; }
    for i in 0..n { data[i] = out[i]; }
    return n;
}

/// @brief Stably merge by comparator over projected keys into the original list.
/// Uses O(N) temporary storage and returns the number of elements written.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn inplace_merge_in_place_by_projected(
    data: &mut list<T>, middle: i64, less: Less,
    projection: Projection) -> i64 {
    var split: i64 = middle;
    let n: i64 = data.len();
    if split < 0 { split = 0; }
    if split > n { split = n; }
    var out: list<T> = [];
    var left: i64 = 0;
    var right: i64 = split;
    while left < split && right < n {
        if less(projection(data[right]), projection(data[left])) {
            out.push(data[right]);
            right = right + 1;
        } else {
            out.push(data[left]);
            left = left + 1;
        }
    }
    while left < split { out.push(data[left]); left = left + 1; }
    while right < n { out.push(data[right]); right = right + 1; }
    for i in 0..n { data[i] = out[i]; }
    return n;
}

/// @brief Return the sorted multiset union using `less` as the ordering.
/// Equivalent elements are those for which neither value is less than the
/// other.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn union_sorted_by(left: &list<T>, right: &list<T>, less: Less)
    -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if less(left[i], right[j]) {
            out.push(left[i]);
            i = i + 1;
        } else if less(right[j], left[i]) {
            out.push(right[j]);
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
            j = j + 1;
        }
    }
    while i < left_len {
        out.push(left[i]);
        i = i + 1;
    }
    while j < right_len {
        out.push(right[j]);
        j = j + 1;
    }
    return out;
}

/// @brief Return the sorted multiset intersection using `less` as the ordering.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn intersection_sorted_by(left: &list<T>, right: &list<T>, less: Less)
    -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if less(left[i], right[j]) {
            i = i + 1;
        } else if less(right[j], left[i]) {
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
            j = j + 1;
        }
    }
    return out;
}

/// @brief Return the left multiset difference using `less` as the ordering.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn difference_sorted_by(left: &list<T>, right: &list<T>, less: Less)
    -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if less(left[i], right[j]) {
            out.push(left[i]);
            i = i + 1;
        } else if less(right[j], left[i]) {
            j = j + 1;
        } else {
            i = i + 1;
            j = j + 1;
        }
    }
    while i < left_len {
        out.push(left[i]);
        i = i + 1;
    }
    return out;
}

/// @brief Return the sorted multiset symmetric difference using `less`.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn symmetric_difference_sorted_by(left: &list<T>, right: &list<T>, less: Less)
    -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if less(left[i], right[j]) {
            out.push(left[i]);
            i = i + 1;
        } else if less(right[j], left[i]) {
            out.push(right[j]);
            j = j + 1;
        } else {
            i = i + 1;
            j = j + 1;
        }
    }
    while i < left_len {
        out.push(left[i]);
        i = i + 1;
    }
    while j < right_len {
        out.push(right[j]);
        j = j + 1;
    }
    return out;
}

/// @brief Return the sorted multiset union by comparator-projected keys.
/// Equivalent values contribute the maximum multiplicity; matched outputs
/// prefer the left-side representative.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn union_sorted_by_projected(left: &list<T>, right: &list<T>,
                                 less: Less, projection: Projection)
    -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        let left_key = projection(left[i]);
        let right_key = projection(right[j]);
        if less(left_key, right_key) {
            out.push(left[i]);
            i = i + 1;
        } else if less(right_key, left_key) {
            out.push(right[j]);
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
            j = j + 1;
        }
    }
    while i < left_len { out.push(left[i]); i = i + 1; }
    while j < right_len { out.push(right[j]); j = j + 1; }
    return out;
}

/// @brief Return the sorted multiset intersection by comparator-projected keys.
/// Matched values use the left-side representative and minimum multiplicity.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn intersection_sorted_by_projected(left: &list<T>, right: &list<T>,
                                         less: Less, projection: Projection)
    -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        let left_key = projection(left[i]);
        let right_key = projection(right[j]);
        if less(left_key, right_key) {
            i = i + 1;
        } else if less(right_key, left_key) {
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
            j = j + 1;
        }
    }
    return out;
}

/// @brief Return the left multiset difference by comparator-projected keys.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn difference_sorted_by_projected(left: &list<T>, right: &list<T>,
                                       less: Less, projection: Projection)
    -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        let left_key = projection(left[i]);
        let right_key = projection(right[j]);
        if less(left_key, right_key) {
            out.push(left[i]);
            i = i + 1;
        } else if less(right_key, left_key) {
            j = j + 1;
        } else {
            i = i + 1;
            j = j + 1;
        }
    }
    while i < left_len { out.push(left[i]); i = i + 1; }
    return out;
}

/// @brief Return the multiset symmetric difference by projected ordering.
/// The result has the multiplicity difference of each projected equivalence
/// class and retains original values from the side with extra occurrences.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn symmetric_difference_sorted_by_projected(
    left: &list<T>, right: &list<T>, less: Less, projection: Projection)
    -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        let left_key = projection(left[i]);
        let right_key = projection(right[j]);
        if less(left_key, right_key) {
            out.push(left[i]);
            i = i + 1;
        } else if less(right_key, left_key) {
            out.push(right[j]);
            j = j + 1;
        } else {
            i = i + 1;
            j = j + 1;
        }
    }
    while i < left_len { out.push(left[i]); i = i + 1; }
    while j < right_len { out.push(right[j]); j = j + 1; }
    return out;
}

/// @brief Copy a list, replacing every value equal to `old_value`.
/// C++20 ranges-style replace algorithm; the input remains unchanged.
/// @ingroup algorithm_ranges
generic<T, U, V>
pub fn replace(data: &list<T>, old_value: U, new_value: V) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if data[i] == old_value {
            out.push(new_value);
        } else {
            out.push(data[i]);
        }
    }
    return out;
}

/// @brief Copy a list, replacing elements whose projected key matches.
/// The input is unchanged.
/// @ingroup algorithm_ranges
generic<T, U, V, Projection>
pub fn replace_projected(data: &list<T>, old_value: U, new_value: V,
                         projection: Projection) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if projection(data[i]) == old_value {
            out.push(new_value);
        } else {
            out.push(data[i]);
        }
    }
    return out;
}

/// @brief Copy a list, replacing elements matching `old_value` by equivalence.
/// The input is unchanged.
/// @ingroup algorithm_ranges
generic<T, U, V, Equivalent>
pub fn replace_by(data: &list<T>, old_value: U, new_value: V,
                  equivalent: Equivalent) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if equivalent(data[i], old_value) { out.push(new_value); }
        else { out.push(data[i]); }
    }
    return out;
}

/// @brief Copy a list, replacing values whose projected key is equivalent.
/// `old_key` is compared directly with each projected element key.
/// @ingroup algorithm_ranges
generic<T, U, V, Equivalent, Projection>
pub fn replace_by_projected(data: &list<T>, old_key: U, new_value: V,
                            equivalent: Equivalent,
                            projection: Projection) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if equivalent(projection(data[i]), old_key) { out.push(new_value); }
        else { out.push(data[i]); }
    }
    return out;
}

/// @brief Copy a list while removing adjacent duplicate values.
/// @ingroup algorithm_ranges
generic<T>
pub fn unique(data: &list<T>) -> list<T> {
    let n: i64 = data.len();
    if n == 0 {
        return [];
    }
    var out: list<T> = [];
    var last: T = data[0];
    out.push(last);
    for i in 1..n {
        let item: T = data[i];
        if item != last {
            out.push(item);
            last = item;
        }
    }
    return out;
}

/// @brief Copy a range while removing adjacent duplicate values.
/// C++20 `std::ranges::unique_copy` counterpart; the source is unchanged.
/// @ingroup algorithm_ranges
generic<T>
pub fn unique_copy(data: &list<T>) -> list<T> {
    return unique(data);
}

/// @brief Copy a list while keeping only each value's first occurrence.
/// @ingroup algorithm_ranges
generic<T>
pub fn unique_stable(data: &list<T>) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let item: T = data[i];
        var found: bool = false;
        let out_len: i64 = out.len();
        for j in 0..out_len {
            if out[j] == item {
                found = true;
                break;
            }
        }
        if found == false {
            out.push(item);
        }
    }
    return out;
}

/// @brief Copy a list with each value clamped to the inclusive bounds.
/// @ingroup algorithm_ranges
generic<T>
pub fn clamp(data: &list<T>, low: T, high: T) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let item: T = data[i];
        if item < low {
            out.push(low);
        } else if item > high {
            out.push(high);
        } else {
            out.push(item);
        }
    }
    return out;
}

/// @brief Clamp a copied list using projected element and bound keys.
/// `low` and `high` must be ordered by their projected keys.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn clamp_projected(data: &list<T>, low: T, high: T,
                       projection: Projection) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    if n == 0 { return out; }
    let low_key = projection(low);
    let high_key = projection(high);
    for i in 0..n {
        let item: T = data[i];
        let item_key = projection(item);
        if item_key < low_key {
            out.push(low);
        } else if high_key < item_key {
            out.push(high);
        } else {
            out.push(item);
        }
    }
    return out;
}

/// @brief Copy a list with values clamped according to the ordering `less`.
/// `low` must not follow `high` under the comparator.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn clamp_by(data: &list<T>, low: T, high: T, less: Less) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let item: T = data[i];
        if less(item, low) {
            out.push(low);
        } else if less(high, item) {
            out.push(high);
        } else {
            out.push(item);
        }
    }
    return out;
}

/// @brief Clamp values using a comparator over projected element and bound keys.
/// `low` must not follow `high` under the combined ordering.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn clamp_by_projected(data: &list<T>, low: T, high: T, less: Less,
                          projection: Projection) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    if n == 0 { return out; }
    let low_key = projection(low);
    let high_key = projection(high);
    for i in 0..n {
        let item: T = data[i];
        let item_key = projection(item);
        if less(item_key, low_key) {
            out.push(low);
        } else if less(high_key, item_key) {
            out.push(high);
        } else {
            out.push(item);
        }
    }
    return out;
}

/// @brief Return first index of an i64 value, or -1 when not found.
/// @ingroup algorithm_ranges
pub fn find_i64(data: &list<i64>, value: i64) -> i64 {
    let n: i64 = data.len();
    for i in 0..n {
        if data[i] == value {
            return i;
        }
    }
    return -1;
}

/// @brief Return count of elements equal to value.
/// @ingroup algorithm_ranges
pub fn count_i64(data: &list<i64>, value: i64) -> i64 {
    var out: i64 = 0;
    let n: i64 = data.len();
    for i in 0..n {
        if data[i] == value {
            out = out + 1;
        }
    }
    return out;
}

/// @brief Return 1 when value exists; else 0.
/// @ingroup algorithm_ranges
pub fn contains_i64(data: &list<i64>, value: i64) -> i32 {
    return find_i64(data, value) >= 0 ? 1 : 0;
}

/// @brief Return a copy without elements equal to value.
/// Similar to C++ remove-erase style result container.
/// @ingroup algorithm_ranges
pub fn remove_i64(data: &list<i64>, value: i64) -> list<i64> {
    var out: list<i64> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let v: i64 = data[i];
        if v != value {
            out.push(v);
        }
    }
    return out;
}

/// @brief Return first n elements (or all when n >= len).
/// @ingroup algorithm_ranges
pub fn take_i64(data: &list<i64>, n: i64) -> list<i64> {
    var out: list<i64> = [];
    if n <= 0 {
        return out;
    }
    let len: i64 = data.len();
    let end: i64 = n < len ? n : len;
    for i in 0..end {
        out.push(data[i]);
    }
    return out;
}

/// @brief Return elements after skipping first n.
/// @ingroup algorithm_ranges
pub fn drop_i64(data: &list<i64>, n: i64) -> list<i64> {
    var out: list<i64> = [];
    let len: i64 = data.len();
    if n <= 0 {
        for i in 0..len {
            out.push(data[i]);
        }
        return out;
    }
    if n >= len {
        return out;
    }
    for i in n..len {
        out.push(data[i]);
    }
    return out;
}

/// @brief Remove adjacent duplicates and return compacted copy.
/// Equivalent behavior to C++20 `std::ranges::unique` result sequence.
/// @ingroup algorithm_ranges
pub fn unique_i64(data: &list<i64>) -> list<i64> {
    let n: i64 = data.len();
    if n == 0 {
        return [];
    }
    var out: list<i64> = [];
    var last: i64 = data[0];
    out.push(last);
    for i in 1..n {
        let v: i64 = data[i];
        if v != last {
            out.push(v);
            last = v;
        }
    }
    return out;
}

/// @brief Remove all duplicates while preserving first-occurrence order.
/// @ingroup algorithm_ranges
pub fn unique_stable_i64(data: &list<i64>) -> list<i64> {
    var out: list<i64> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let v: i64 = data[i];
        if out.contains(v) == false {
            out.push(v);
        }
    }
    return out;
}

/// @brief Clamp every element to [low, high] and return the result list.
/// @ingroup algorithm_ranges
pub fn clamp_i64(data: &list<i64>, low: i64, high: i64) -> list<i64> {
    var out: list<i64> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let v: i64 = data[i];
        if v < low {
            out.push(low);
        } else if v > high {
            out.push(high);
        } else {
            out.push(v);
        }
    }
    return out;
}

/// @}
