/// @brief Project a predicate key, then copy original rejected values to a
/// distinct-type bounded output. Returns `(consumed, written)`.
/// @ingroup algorithm_ranges
generic<T, Output, Predicate, Projection>
pub fn remove_copy_if_to_heterogeneous_projected(
    source: &list<T>, destination: &mut list<Output>, predicate: Predicate,
