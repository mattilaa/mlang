/// @brief Transform adjacent pairs into caller-provided bounded output.
/// Returns the number written; short inputs and unused destination slots are
/// handled without allocation.
/// @ingroup algorithm_ranges
generic<T, Output, Operation>
pub fn adjacent_transform_to(data: &list<T>, destination: &mut list<Output>,
                             operation: Operation) -> i64 {
    let n: i64 = data.len();
    let capacity: i64 = destination.len();
    var count: i64 = n > 0 ? n - 1 : 0;
    if capacity < count { count = capacity; }
    for i in 0..count { destination[i] = operation(data[i], data[i + 1]); }
    return count;
}

/// @brief Transform projected adjacent pairs into bounded output.
/// @ingroup algorithm_ranges
generic<T, Output, Operation, Projection>
pub fn adjacent_transform_to_projected(
    data: &list<T>, destination: &mut list<Output>, operation: Operation,
    projection: Projection) -> i64 {
    let n: i64 = data.len();
    let capacity: i64 = destination.len();
    var count: i64 = n > 0 ? n - 1 : 0;
    if capacity < count { count = capacity; }
    for i in 0..count {
        destination[i] = operation(projection(data[i]),
                                  projection(data[i + 1]));
    }
    return count;
}

/// @brief Bounded ternary adjacent transform.
/// @ingroup algorithm_ranges
generic<T, Output, Operation>
pub fn adjacent_transform3_to(data: &list<T>, destination: &mut list<Output>,
                              operation: Operation) -> i64 {
    let n: i64 = data.len();
    let capacity: i64 = destination.len();
    var count: i64 = n >= 3 ? n - 2 : 0;
    if capacity < count { count = capacity; }
    for i in 0..count {
        destination[i] = operation(data[i], data[i + 1], data[i + 2]);
    }
    return count;
}

