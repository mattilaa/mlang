/// @brief Zip two ranges into a caller-provided tuple output range.
/// Stops at either input or the destination end and returns the number of
/// tuples written; unused destination elements are preserved.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn zip_to(first: &list<T>, second: &list<U>,
              destination: &mut list<tuple<T, U>>) -> i64 {
    var count: i64 = first.len();
    if second.len() < count { count = second.len(); }
    if destination.len() < count { count = destination.len(); }
    for i in 0..count { destination[i] = (first[i], second[i]); }
    return count;
}

/// @brief Zip three heterogeneous ranges into a bounded tuple output.
/// @ingroup algorithm_ranges
