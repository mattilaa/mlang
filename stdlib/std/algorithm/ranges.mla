/// @brief Materialize every pair from two ranges in nested-loop order.
/// The right range varies fastest; equivalent to C++23 `views::cartesian_product`.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn cartesian_product(left: &list<T>, right: &list<U>)
    -> list<tuple<T, U>> {
    var out: list<tuple<T, U>> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    for i in 0..left_len {
        for j in 0..right_len {
            out.push((left[i], right[j]));
        }
    }
    return out;
}

/// @brief Materialize every triple from three ranges in nested-loop order.
/// The third range varies fastest, then the second; inputs are unchanged.
/// @ingroup algorithm_ranges
generic<T, U, V>
pub fn cartesian_product(first: &list<T>, second: &list<U>, third: &list<V>)
    -> list<tuple<T, U, V>> {
    var out: list<tuple<T, U, V>> = [];
    let first_len: i64 = first.len();
    let second_len: i64 = second.len();
    let third_len: i64 = third.len();
    for i in 0..first_len {
        for j in 0..second_len {
            for k in 0..third_len {
                out.push((first[i], second[j], third[k]));
            }
        }
    }
    return out;
}

/// @brief Materialize every quadruple from four ranges in nested-loop order.
/// The rightmost range varies fastest; inputs remain unchanged.
/// @ingroup algorithm_ranges
generic<T, U, V, W>
pub fn cartesian_product(first: &list<T>, second: &list<U>, third: &list<V>,
                         fourth: &list<W>) -> list<tuple<T, U, V, W>> {
    var out: list<tuple<T, U, V, W>> = [];
    for i in 0..first.len() {
        for j in 0..second.len() {
            for k in 0..third.len() {
                for m in 0..fourth.len() {
                    out.push((first[i], second[j], third[k], fourth[m]));
                }
            }
        }
    }
    return out;
}

/// @brief Materialize every combination from five heterogeneous ranges.
/// The rightmost input varies fastest; any empty input yields an empty result.
/// @ingroup algorithm_ranges
generic<T, U, V, W, X>
pub fn cartesian_product(first: &list<T>, second: &list<U>, third: &list<V>,
                         fourth: &list<W>, fifth: &list<X>)
    -> list<tuple<T, U, V, W, X>> {
    var out: list<tuple<T, U, V, W, X>> = [];
    for i in 0..first.len() {
        for j in 0..second.len() {
            for k in 0..third.len() {
                for m in 0..fourth.len() {
                    for n in 0..fifth.len() {
                        out.push((first[i], second[j], third[k], fourth[m],
                                  fifth[n]));
                    }
                }
            }
        }
    }
    return out;
}

/// @brief Materialize every combination from six heterogeneous ranges.
/// The rightmost input varies fastest; any empty input yields an empty result.
/// @ingroup algorithm_ranges
generic<T, U, V, W, X, Y>
pub fn cartesian_product(first: &list<T>, second: &list<U>, third: &list<V>,
                         fourth: &list<W>, fifth: &list<X>,
                         sixth: &list<Y>)
    -> list<tuple<T, U, V, W, X, Y>> {
    var out: list<tuple<T, U, V, W, X, Y>> = [];
    for i in 0..first.len() {
        for j in 0..second.len() {
            for k in 0..third.len() {
                for m in 0..fourth.len() {
                    for n in 0..fifth.len() {
                        for p in 0..sixth.len() {
                            out.push((first[i], second[j], third[k], fourth[m],
                                      fifth[n], sixth[p]));
                        }
                    }
                }
            }
        }
    }
    return out;
}

/// @brief Materialize every combination from seven heterogeneous ranges.
/// The rightmost range varies fastest; any empty input yields an empty result.
/// @ingroup algorithm_ranges
generic<T, U, V, W, X, Y, Z>
pub fn cartesian_product(first: &list<T>, second: &list<U>, third: &list<V>,
                         fourth: &list<W>, fifth: &list<X>,
                         sixth: &list<Y>, seventh: &list<Z>)
    -> list<tuple<T, U, V, W, X, Y, Z>> {
    var out: list<tuple<T, U, V, W, X, Y, Z>> = [];
    for i in 0..first.len() {
        for j in 0..second.len() {
            for k in 0..third.len() {
                for m in 0..fourth.len() {
                    for n in 0..fifth.len() {
                        for p in 0..sixth.len() {
                            for q in 0..seventh.len() {
                                out.push((first[i], second[j], third[k],
                                          fourth[m], fifth[n], sixth[p],
                                          seventh[q]));
                            }
                        }
                    }
                }
            }
        }
    }
    return out;
}

/// @brief Materialize every combination from eight heterogeneous ranges.
/// The rightmost range varies fastest; any empty input yields an empty result.
/// @ingroup algorithm_ranges
generic<T, U, V, W, X, Y, Z, A>
pub fn cartesian_product(first: &list<T>, second: &list<U>, third: &list<V>,
                         fourth: &list<W>, fifth: &list<X>,
                         sixth: &list<Y>, seventh: &list<Z>,
                         eighth: &list<A>)
    -> list<tuple<T, U, V, W, X, Y, Z, A>> {
    var out: list<tuple<T, U, V, W, X, Y, Z, A>> = [];
    for i in 0..first.len() {
        for j in 0..second.len() {
            for k in 0..third.len() {
                for m in 0..fourth.len() {
                    for n in 0..fifth.len() {
                        for p in 0..sixth.len() {
                            for q in 0..seventh.len() {
                                for r in 0..eighth.len() {
                                    out.push((first[i], second[j], third[k],
                                              fourth[m], fifth[n], sixth[p],
                                              seventh[q], eighth[r]));
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return out;
}

/// @brief Write Cartesian-product tuples into a bounded destination.
/// The rightmost input varies fastest. Returns the number written, stops
/// immediately at destination capacity, and preserves the unused suffix.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn cartesian_product_to(left: &list<T>, right: &list<U>,
                            destination: &mut list<tuple<T, U>>) -> i64 {
    let capacity: i64 = destination.len();
    if capacity <= 0 { return 0; }
    var written: i64 = 0;
    for i in 0..left.len() {
        for j in 0..right.len() {
            destination[written] = (left[i], right[j]);
            written = written + 1;
            if written >= capacity { return written; }
        }
    }
    return written;
}

/// @brief Write three-range Cartesian-product tuples into bounded output.
/// @ingroup algorithm_ranges
generic<T, U, V>
pub fn cartesian_product_to(first: &list<T>, second: &list<U>,
    third: &list<V>, destination: &mut list<tuple<T, U, V>>) -> i64 {
    let capacity: i64 = destination.len();
    if capacity <= 0 { return 0; }
    var written: i64 = 0;
    for i in 0..first.len() {
        for j in 0..second.len() {
            for k in 0..third.len() {
                destination[written] = (first[i], second[j], third[k]);
                written = written + 1;
                if written >= capacity { return written; }
            }
        }
    }
    return written;
}

/// @brief Write four-range Cartesian-product tuples into bounded output.
/// @ingroup algorithm_ranges
generic<T, U, V, W>
pub fn cartesian_product_to(first: &list<T>, second: &list<U>,
    third: &list<V>, fourth: &list<W>,
    destination: &mut list<tuple<T, U, V, W>>) -> i64 {
    let capacity: i64 = destination.len();
    if capacity <= 0 { return 0; }
    var written: i64 = 0;
    for i in 0..first.len() {
        for j in 0..second.len() {
            for k in 0..third.len() {
                for m in 0..fourth.len() {
                    destination[written] = (first[i], second[j], third[k],
                                            fourth[m]);
                    written = written + 1;
                    if written >= capacity { return written; }
                }
            }
        }
    }
    return written;
}

/// @brief Write five-range Cartesian-product tuples into bounded output.
/// @ingroup algorithm_ranges
generic<T, U, V, W, X>
pub fn cartesian_product_to(first: &list<T>, second: &list<U>,
    third: &list<V>, fourth: &list<W>, fifth: &list<X>,
    destination: &mut list<tuple<T, U, V, W, X>>) -> i64 {
    let capacity: i64 = destination.len();
    if capacity <= 0 { return 0; }
    var written: i64 = 0;
    for i in 0..first.len() {
        for j in 0..second.len() {
            for k in 0..third.len() {
                for m in 0..fourth.len() {
                    for n in 0..fifth.len() {
                        destination[written] = (first[i], second[j], third[k],
                                                fourth[m], fifth[n]);
                        written = written + 1;
                        if written >= capacity { return written; }
                    }
                }
            }
        }
    }
    return written;
}

/// @brief Write six-range Cartesian-product tuples into bounded output.
/// @ingroup algorithm_ranges
generic<T, U, V, W, X, Y>
pub fn cartesian_product_to(first: &list<T>, second: &list<U>,
    third: &list<V>, fourth: &list<W>, fifth: &list<X>, sixth: &list<Y>,
    destination: &mut list<tuple<T, U, V, W, X, Y>>) -> i64 {
    let capacity: i64 = destination.len();
    if capacity <= 0 { return 0; }
    var written: i64 = 0;
    for i in 0..first.len() {
        for j in 0..second.len() {
            for k in 0..third.len() {
                for m in 0..fourth.len() {
                    for n in 0..fifth.len() {
                        for p in 0..sixth.len() {
                            destination[written] = (first[i], second[j],
                                third[k], fourth[m], fifth[n], sixth[p]);
                            written = written + 1;
                            if written >= capacity { return written; }
                        }
                    }
                }
            }
        }
    }
    return written;
}

/// @brief Write seven-range Cartesian-product tuples into bounded output.
/// @ingroup algorithm_ranges
generic<T, U, V, W, X, Y, Z>
pub fn cartesian_product_to(first: &list<T>, second: &list<U>,
    third: &list<V>, fourth: &list<W>, fifth: &list<X>, sixth: &list<Y>,
    seventh: &list<Z>,
    destination: &mut list<tuple<T, U, V, W, X, Y, Z>>) -> i64 {
    let capacity: i64 = destination.len();
    if capacity <= 0 { return 0; }
    var written: i64 = 0;
    for i in 0..first.len() {
        for j in 0..second.len() {
            for k in 0..third.len() {
                for m in 0..fourth.len() {
                    for n in 0..fifth.len() {
                        for p in 0..sixth.len() {
                            for q in 0..seventh.len() {
                                destination[written] = (first[i], second[j],
                                    third[k], fourth[m], fifth[n], sixth[p],
                                    seventh[q]);
                                written = written + 1;
                                if written >= capacity { return written; }
                            }
                        }
                    }
                }
            }
        }
    }
    return written;
}

/// @brief Write eight-range Cartesian-product tuples into bounded output.
/// @ingroup algorithm_ranges
generic<T, U, V, W, X, Y, Z, A>
pub fn cartesian_product_to(first: &list<T>, second: &list<U>,
    third: &list<V>, fourth: &list<W>, fifth: &list<X>, sixth: &list<Y>,
    seventh: &list<Z>, eighth: &list<A>,
    destination: &mut list<tuple<T, U, V, W, X, Y, Z, A>>) -> i64 {
    let capacity: i64 = destination.len();
    if capacity <= 0 { return 0; }
    var written: i64 = 0;
    for i in 0..first.len() {
        for j in 0..second.len() {
            for k in 0..third.len() {
                for m in 0..fourth.len() {
                    for n in 0..fifth.len() {
                        for p in 0..sixth.len() {
                            for q in 0..seventh.len() {
                                for r in 0..eighth.len() {
                                    destination[written] = (first[i],
                                        second[j], third[k], fourth[m],
                                        fifth[n], sixth[p], seventh[q],
                                        eighth[r]);
                                    written = written + 1;
                                    if written >= capacity { return written; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return written;
}

/// @brief Pair each element with its zero-based position.
/// Eager C++23 `views::enumerate` equivalent; the input remains unchanged.
/// @ingroup algorithm_ranges
generic<T>
pub fn enumerate(data: &list<T>) -> list<tuple<i64, T>> {
    var out: list<tuple<i64, T>> = [];
    let n: i64 = data.len();
    for i in 0..n {
        out.push((i, data[i]));
    }
    return out;
}

/// @brief Pair each element with a position beginning at `first_index`.
/// The input is unchanged; negative starting indices are permitted.
/// @ingroup algorithm_ranges
generic<T>
pub fn enumerate_from(data: &list<T>, first_index: i64)
    -> list<tuple<i64, T>> {
    var out: list<tuple<i64, T>> = [];
    let n: i64 = data.len();
    for i in 0..n {
        out.push((first_index + i, data[i]));
    }
    return out;
}

/// @brief Enumerate into caller-provided tuple storage.
/// Writes the prefix that fits, pairs values with zero-based indices, and
/// returns the number written without changing the destination suffix.
/// @ingroup algorithm_ranges
generic<T>
pub fn enumerate_to(data: &list<T>,
                    destination: &mut list<tuple<i64, T>>) -> i64 {
    var count: i64 = data.len();
    if destination.len() < count { count = destination.len(); }
    for i in 0..count { destination[i] = (i, data[i]); }
    return count;
}

/// @brief Enumerate into bounded storage beginning at a caller-selected index.
/// Negative starting indices are permitted.
/// @ingroup algorithm_ranges
generic<T>
pub fn enumerate_from_to(data: &list<T>,
                         destination: &mut list<tuple<i64, T>>,
                         first_index: i64) -> i64 {
    var count: i64 = data.len();
    if destination.len() < count { count = destination.len(); }
    if first_index > 0 && count > 9223372036854775807 - first_index {
        count = 9223372036854775807 - first_index;
    }
    for i in 0..count { destination[i] = (first_index + i, data[i]); }
    return count;
}

/// @brief Enumerate projected values into bounded tuple storage.
/// @ingroup algorithm_ranges
generic<T, Output, Projection>
pub fn enumerate_to_projected(
    data: &list<T>, destination: &mut list<tuple<i64, Output>>,
    projection: Projection) -> i64 {
    var count: i64 = data.len();
    if destination.len() < count { count = destination.len(); }
    for i in 0..count {
        destination[i] = (i, projection(data[i]));
    }
    return count;
}

/// @brief Enumerate projected values into bounded storage with an offset.
/// @ingroup algorithm_ranges
generic<T, Output, Projection>
pub fn enumerate_from_to_projected(
    data: &list<T>, destination: &mut list<tuple<i64, Output>>,
    first_index: i64, projection: Projection) -> i64 {
    var count: i64 = data.len();
    if destination.len() < count { count = destination.len(); }
    if first_index > 0 && count > 9223372036854775807 - first_index {
        count = 9223372036854775807 - first_index;
    }
    for i in 0..count {
        destination[i] = (first_index + i, projection(data[i]));
    }
    return count;
}

/// @brief Project the first element from every pair-like tuple.
/// Eager C++20 `views::keys` counterpart for `list<tuple<K, V>>`.
/// @ingroup algorithm_ranges
generic<K, V>
pub fn keys(data: &list<tuple<K, V>>) -> list<K> {
    var projected: list<K> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let entry: tuple<K, V> = data[i];
        projected.push(entry.0);
    }
    return projected;
}

/// @brief Project the second element from every pair-like tuple.
/// Eager C++20 `views::values` counterpart for `list<tuple<K, V>>`.
/// @ingroup algorithm_ranges
generic<K, V>
pub fn values(data: &list<tuple<K, V>>) -> list<V> {
    var projected: list<V> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let entry: tuple<K, V> = data[i];
        projected.push(entry.1);
    }
    return projected;
}

/// @brief Merge two nondecreasing ranges into one stable sorted copy.
/// Both inputs must already be sorted; equal elements from `left` come first.
/// C++20 `std::ranges::merge` equivalent for same-typed lists.
/// @ingroup algorithm_ranges
generic<T>
pub fn merged(left: &list<T>, right: &list<T>) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var left_index: i64 = 0;
    var right_index: i64 = 0;
    while left_index < left_len && right_index < right_len {
        if right[right_index] < left[left_index] {
            out.push(right[right_index]);
            right_index = right_index + 1;
        } else {
            out.push(left[left_index]);
            left_index = left_index + 1;
        }
    }
    while left_index < left_len {
        out.push(left[left_index]);
        left_index = left_index + 1;
    }
    while right_index < right_len {
        out.push(right[right_index]);
        right_index = right_index + 1;
    }
    return out;
}

/// @brief Stably merge sorted ranges according to projected keys.
/// Equivalent keys from the left range appear first; inputs must be sorted by
/// the same projection.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn merged_projected(left: &list<T>, right: &list<T>,
                        projection: Projection) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if projection(right[j]) < projection(left[i]) {
            out.push(right[j]);
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
        }
    }
    while i < left_len {
        out.push(left[i]);
        i = i + 1;
    }
    while j < right_len {
        out.push(right[j]);
        j = j + 1;
    }
    return out;
}

generic<T, Less, Projection>
fn ranges_set_operation_to_core(
    left: &list<T>, right: &list<T>, destination: &mut list<T>,
    less: Less, projection: Projection, operation: i32)
    -> tuple<i64, i64, i64> {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let output_len: i64 = destination.len();
    var i: i64 = 0;
    var j: i64 = 0;
    var written: i64 = 0;
    while i < left_len && j < right_len {
        let left_key = projection(left[i]);
        let right_key = projection(right[j]);
        if less(left_key, right_key) {
            if operation == 0 || operation == 2 || operation == 3 {
                if written >= output_len { break; }
                destination[written] = left[i];
                written = written + 1;
            }
            i = i + 1;
        } else if less(right_key, left_key) {
            if operation == 0 || operation == 3 {
                if written >= output_len { break; }
                destination[written] = right[j];
                written = written + 1;
            }
            j = j + 1;
        } else {
            if operation == 0 || operation == 1 {
                if written >= output_len { break; }
                destination[written] = left[i];
                written = written + 1;
            }
            i = i + 1;
            j = j + 1;
        }
    }
    if operation == 0 || operation == 2 || operation == 3 {
        while i < left_len && written < output_len {
            destination[written] = left[i];
            i = i + 1;
            written = written + 1;
        }
    }
    if operation == 0 || operation == 3 {
        while j < right_len && written < output_len {
            destination[written] = right[j];
            j = j + 1;
            written = written + 1;
        }
    }
    return (i, j, written);
}

generic<Left, Right, Output, Less, LeftProjection, RightProjection>
fn ranges_set_operation_to_heterogeneous_core(
    left: &list<Left>, right: &list<Right>, destination: &mut list<Output>,
    less: Less, left_projection: LeftProjection,
    right_projection: RightProjection, operation: i32)
    -> tuple<i64, i64, i64> {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let output_len: i64 = destination.len();
    var i: i64 = 0;
    var j: i64 = 0;
    var written: i64 = 0;
    while i < left_len && j < right_len {
        let left_key = left_projection(left[i]);
        let right_key = right_projection(right[j]);
        if less(left_key, right_key) {
            if operation == 0 || operation == 2 || operation == 3 {
                if written >= output_len { break; }
                destination[written] = left[i];
                written = written + 1;
            }
            i = i + 1;
        } else if less(right_key, left_key) {
            if operation == 0 || operation == 3 {
                if written >= output_len { break; }
                destination[written] = right[j];
                written = written + 1;
            }
            j = j + 1;
        } else {
            if operation == 0 || operation == 1 {
                if written >= output_len { break; }
                destination[written] = left[i];
                written = written + 1;
            }
            i = i + 1;
            j = j + 1;
        }
    }
    if operation == 0 || operation == 2 || operation == 3 {
        while i < left_len && written < output_len {
            destination[written] = left[i];
            i = i + 1;
            written = written + 1;
        }
    }
    if operation == 0 || operation == 3 {
        while j < right_len && written < output_len {
            destination[written] = right[j];
            j = j + 1;
            written = written + 1;
        }
    }
    return (i, j, written);
}

/// @brief Write sorted union into a bounded destination.
/// Operation aliases use C++20 `ranges::set_union` multiplicity rules.
/// Returns `(left_consumed, right_consumed, written)`.
/// @ingroup algorithm_ranges
generic<T>
pub fn union_sorted_to(left: &list<T>, right: &list<T>,
                       destination: &mut list<T>) -> tuple<i64, i64, i64> {
    return ranges_set_operation_to_core(left, right, destination,
        ranges_default_less, ranges_identity, 0);
}

/// @brief Write sorted union using projected ordering keys.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn union_sorted_to_projected(left: &list<T>, right: &list<T>,
    destination: &mut list<T>, projection: Projection)
    -> tuple<i64, i64, i64> {
    return ranges_set_operation_to_core(left, right, destination,
        ranges_default_less, projection, 0);
}

/// @brief Write sorted union using a custom ordering.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn union_sorted_to_by(left: &list<T>, right: &list<T>,
    destination: &mut list<T>, less: Less) -> tuple<i64, i64, i64> {
    return ranges_set_operation_to_core(left, right, destination,
        less, ranges_identity, 0);
}

