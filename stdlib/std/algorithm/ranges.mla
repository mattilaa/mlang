/// \file ranges.mla
/// \brief Ranges-style algorithms under std::algorithm.
///
/// C++20 `<ranges>` inspired helpers for Mlang lists.
///
/// @defgroup algorithm_ranges std::algorithm::ranges
/// @ingroup algorithm
/// @brief Ranges-style sequence algorithms.
/// @{

/// @brief Return first index of a value, or -1 when not found.
/// Supports any type that can be equality-compared.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn find(data: &list<T>, value: U) -> i64 {
    let n: i64 = data.len();
    for i in 0..n {
        if data[i] == value {
            return i;
        }
    }
    return -1;
}

/// @brief Find the first element equivalent to `value` under `equivalent`.
/// Returns -1 if no element matches.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn find_by(data: &list<T>, value: U, equivalent: Equivalent) -> i64 {
    let n: i64 = data.len();
    for i in 0..n {
        if equivalent(data[i], value) { return i; }
    }
    return -1;
}

/// @brief Find an element whose projected key matches `value` by equivalence.
/// The predicate receives the projected element key followed by the lookup key.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, Projection>
pub fn find_by_projected(data: &list<T>, value: U, equivalent: Equivalent,
                         projection: Projection) -> i64 {
    let n: i64 = data.len();
    for i in 0..n {
        if equivalent(projection(data[i]), value) { return i; }
    }
    return -1;
}

/// @brief Find the first element whose projected value equals `value`.
/// C++20 `std::ranges::find`-style projection support; returns `-1` if absent.
/// @ingroup algorithm_ranges
generic<T, U, Projection>
pub fn find_projected(data: &list<T>, value: U, projection: Projection) -> i64 {
    let n: i64 = data.len();
    for i in 0..n {
        if projection(data[i]) == value {
            return i;
        }
    }
    return -1;
}

/// @brief Find the last element whose projected value equals `value`.
/// Returns -1 when no projected key matches.
/// @ingroup algorithm_ranges
generic<T, U, Projection>
pub fn find_last_projected(data: &list<T>, value: U,
                           projection: Projection) -> i64 {
    var found: i64 = -1;
    let n: i64 = data.len();
    for i in 0..n {
        if projection(data[i]) == value { found = i; }
    }
    return found;
}

/// @brief Return the last index of a value, or -1 when it is absent.
/// C++23 ranges-style last-match search.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn find_last(data: &list<T>, value: U) -> i64 {
    var found: i64 = -1;
    let n: i64 = data.len();
    for i in 0..n {
        if data[i] == value {
            found = i;
        }
    }
    return found;
}

/// @brief Return the last index matching `value` under `equivalent`.
/// The predicate receives an element and the lookup key; the search proceeds
/// backwards and returns -1 when no element matches.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn find_last_by(data: &list<T>, value: U, equivalent: Equivalent) -> i64 {
    var index: i64 = data.len();
    while index > 0 {
        index = index - 1;
        if equivalent(data[index], value) {
            return index;
        }
    }
    return -1;
}

/// @brief Return the last element whose projected key matches `value`.
/// The predicate receives the projected element key followed by the lookup
/// key. Returns -1 when no element matches.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, Projection>
pub fn find_last_by_projected(data: &list<T>, value: U,
                              equivalent: Equivalent,
                              projection: Projection) -> i64 {
    var index: i64 = data.len();
    while index > 0 {
        index = index - 1;
        if equivalent(projection(data[index]), value) { return index; }
    }
    return -1;
}

/// @brief Return the first index whose value equals its immediate successor.
/// Returns -1 when the range has fewer than two elements or no adjacent match.
/// C++20 ranges-style `adjacent_find`.
/// @ingroup algorithm_ranges
generic<T>
pub fn adjacent_find(data: &list<T>) -> i64 {
    let n: i64 = data.len();
    if n < 2 {
        return -1;
    }
    for i in 0..(n - 1) {
        if data[i] == data[i + 1] {
            return i;
        }
    }
    return -1;
}

/// @brief Find adjacent values with equal projected keys.
/// Returns the first pair's left index, or -1 if there is no such pair.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn adjacent_find_projected(data: &list<T>, projection: Projection) -> i64 {
    let n: i64 = data.len();
    if n < 2 { return -1; }
    for i in 0..(n - 1) {
        if projection(data[i]) == projection(data[i + 1]) { return i; }
    }
    return -1;
}

/// @brief Return the first adjacent pair accepted by `equivalent`, or -1.
/// @ingroup algorithm_ranges
generic<T, Equivalent>
pub fn adjacent_find_by(data: &list<T>, equivalent: Equivalent) -> i64 {
    let n: i64 = data.len();
    if n < 2 {
        return -1;
    }
    for i in 0..(n - 1) {
        if equivalent(data[i], data[i + 1]) {
            return i;
        }
    }
    return -1;
}

/// @brief Find adjacent values matching after projection and equivalence.
/// Returns the first pair's left index, or -1 when no pair matches.
/// @ingroup algorithm_ranges
generic<T, Equivalent, Projection>
pub fn adjacent_find_by_projected(data: &list<T>, equivalent: Equivalent,
                                  projection: Projection) -> i64 {
    let n: i64 = data.len();
    if n < 2 { return -1; }
    for i in 0..(n - 1) {
        if equivalent(projection(data[i]), projection(data[i + 1])) {
            return i;
        }
    }
    return -1;
}

/// @brief Return the first index in `data` matching any value in `candidates`.
/// Returns -1 when the ranges have no matching values (C++20 `find_first_of`).
/// @ingroup algorithm_ranges
generic<T, U>
pub fn find_first_of(data: &list<T>, candidates: &list<U>) -> i64 {
    let n: i64 = data.len();
    let candidate_count: i64 = candidates.len();
    for i in 0..n {
        for j in 0..candidate_count {
            if data[i] == candidates[j] {
                return i;
            }
        }
    }
    return -1;
}

/// @brief Find the first data element matching any candidate after projection.
/// Each range has its own projection; returns -1 when there is no match.
/// @ingroup algorithm_ranges
generic<T, U, DataProjection, CandidateProjection>
pub fn find_first_of_projected(data: &list<T>, candidates: &list<U>,
                               data_projection: DataProjection,
                               candidate_projection: CandidateProjection)
    -> i64 {
    let n: i64 = data.len();
    let candidate_count: i64 = candidates.len();
    for i in 0..n {
        let data_key = data_projection(data[i]);
        for j in 0..candidate_count {
            if data_key == candidate_projection(candidates[j]) { return i; }
        }
    }
    return -1;
}

/// @brief Return the first index in `data` matching a candidate under a
/// caller-provided binary predicate.
/// C++20 `std::ranges::find_first_of` predicate overload.
/// @ingroup algorithm_ranges
generic<T, U, Predicate>
pub fn find_first_of_by(data: &list<T>, candidates: &list<U>,
                        equivalent: Predicate) -> i64 {
    let n: i64 = data.len();
    let candidate_count: i64 = candidates.len();
    for i in 0..n {
        for j in 0..candidate_count {
            if equivalent(data[i], candidates[j]) {
                return i;
            }
        }
    }
    return -1;
}

/// @brief Find the first candidate match after independent projections.
/// Returns -1 if no data element matches any candidate under `equivalent`.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, DataProjection, CandidateProjection>
pub fn find_first_of_by_projected(
    data: &list<T>, candidates: &list<U>, equivalent: Equivalent,
    data_projection: DataProjection, candidate_projection: CandidateProjection)
    -> i64 {
    let n: i64 = data.len();
    let candidate_count: i64 = candidates.len();
    for i in 0..n {
        let data_key = data_projection(data[i]);
        for j in 0..candidate_count {
            if equivalent(data_key, candidate_projection(candidates[j])) {
                return i;
            }
        }
    }
    return -1;
}

/// @brief Return whether sorted `range` contains sorted `subset`.
/// Duplicate multiplicities matter; both inputs must be nondecreasing.
/// C++20 `std::ranges::includes` equivalent.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn includes(range: &list<T>, subset: &list<U>) -> bool {
    let range_len: i64 = range.len();
    let subset_len: i64 = subset.len();
    var range_index: i64 = 0;
    var subset_index: i64 = 0;
    while range_index < range_len && subset_index < subset_len {
        if range[range_index] < subset[subset_index] {
            range_index = range_index + 1;
        } else if subset[subset_index] < range[range_index] {
            return false;
        } else {
            range_index = range_index + 1;
            subset_index = subset_index + 1;
        }
    }
    return subset_index == subset_len;
}

/// @brief Check sorted-range containment after independent key projections.
/// Duplicate multiplicities matter; both inputs must be sorted by the
/// corresponding projections.
/// @ingroup algorithm_ranges
generic<T, U, RangeProjection, SubsetProjection>
pub fn includes_projected(range: &list<T>, subset: &list<U>,
                          range_projection: RangeProjection,
                          subset_projection: SubsetProjection) -> bool {
    let range_len: i64 = range.len();
    let subset_len: i64 = subset.len();
    var range_index: i64 = 0;
    var subset_index: i64 = 0;
    while range_index < range_len && subset_index < subset_len {
        let range_key = range_projection(range[range_index]);
        let subset_key = subset_projection(subset[subset_index]);
        if range_key < subset_key {
            range_index = range_index + 1;
        } else if subset_key < range_key {
            return false;
        } else {
            range_index = range_index + 1;
            subset_index = subset_index + 1;
        }
    }
    return subset_index == subset_len;
}

/// @brief Check whether sorted `range` contains sorted `subset` under `less`.
/// Duplicate multiplicities count; both inputs use the same strict ordering.
/// @ingroup algorithm_ranges
generic<T, U, Less>
pub fn includes_by(range: &list<T>, subset: &list<U>, less: Less) -> bool {
    let range_len: i64 = range.len();
    let subset_len: i64 = subset.len();
    var range_index: i64 = 0;
    var subset_index: i64 = 0;
    while range_index < range_len && subset_index < subset_len {
        if less(range[range_index], subset[subset_index]) {
            range_index = range_index + 1;
        } else if less(subset[subset_index], range[range_index]) {
            return false;
        } else {
            range_index = range_index + 1;
            subset_index = subset_index + 1;
        }
    }
    return subset_index == subset_len;
}

/// @brief Check sorted-range containment using comparator-projected keys.
/// Both inputs must be sorted by `less` applied to projected values.
/// @ingroup algorithm_ranges
generic<T, U, Less, Projection>
pub fn includes_by_projected(range: &list<T>, subset: &list<U>, less: Less,
                             projection: Projection) -> bool {
    let range_len: i64 = range.len();
    let subset_len: i64 = subset.len();
    var range_index: i64 = 0;
    var subset_index: i64 = 0;
    while range_index < range_len && subset_index < subset_len {
        let range_key = projection(range[range_index]);
        let subset_key = projection(subset[subset_index]);
        if less(range_key, subset_key) {
            range_index = range_index + 1;
        } else if less(subset_key, range_key) {
            return false;
        } else {
            range_index = range_index + 1;
            subset_index = subset_index + 1;
        }
    }
    return subset_index == subset_len;
}

/// @brief Return the number of elements in a list.
/// @ingroup algorithm_ranges
generic<T>
pub fn size(data: &list<T>) -> i64 {
    return data.len();
}

/// @brief Return true when a list has no elements.
/// @ingroup algorithm_ranges
generic<T>
pub fn empty(data: &list<T>) -> bool {
    return data.len() == 0;
}

/// @brief Return whether every boolean in a range is true (C++20 all_of identity form).
/// @ingroup algorithm_ranges
pub fn all_of(data: &list<bool>) -> bool {
    let n: i64 = data.len();
    for i in 0..n {
        if !data[i] {
            return false;
        }
    }
    return true;
}

/// @brief Return whether at least one boolean in a range is true (C++20 any_of identity form).
/// @ingroup algorithm_ranges
pub fn any_of(data: &list<bool>) -> bool {
    let n: i64 = data.len();
    for i in 0..n {
        if data[i] {
            return true;
        }
    }
    return false;
}

/// @brief Return whether no boolean in a range is true (C++20 none_of identity form).
/// @ingroup algorithm_ranges
pub fn none_of(data: &list<bool>) -> bool {
    return !any_of(data);
}

/// @brief Return the index of the first element accepted by `predicate`, or -1.
/// C++20 `std::ranges::find_if` semantics.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn find_if(data: &list<T>, predicate: Predicate) -> i64 {
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(data[i]) {
            return i;
        }
    }
    return -1;
}

/// @brief Find the first element accepted after projection, or -1.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn find_if_projected(data: &list<T>, predicate: Predicate,
                         projection: Projection) -> i64 {
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(projection(data[i])) { return i; }
    }
    return -1;
}

/// @brief Return the last index accepted by `predicate`, or -1.
/// C++23 `std::ranges::find_last_if` semantics.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn find_last_if(data: &list<T>, predicate: Predicate) -> i64 {
    var i: i64 = data.len();
    while i > 0 {
        i = i - 1;
        if predicate(data[i]) {
            return i;
        }
    }
    return -1;
}

/// @brief Find the last element accepted after projection, or -1.
/// C++23 `std::ranges::find_last_if` projection form.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn find_last_if_projected(data: &list<T>, predicate: Predicate,
                              projection: Projection) -> i64 {
    var i: i64 = data.len();
    while i > 0 {
        i = i - 1;
        if predicate(projection(data[i])) { return i; }
    }
    return -1;
}

/// @brief Count elements accepted by `predicate` (C++20 `ranges::count_if`).
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn count_if(data: &list<T>, predicate: Predicate) -> i64 {
    var matched: i64 = 0;
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(data[i]) {
            matched = matched + 1;
        }
    }
    return matched;
}

/// @brief Count elements whose projected keys satisfy `predicate`.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn count_if_projected(data: &list<T>, predicate: Predicate,
                          projection: Projection) -> i64 {
    var matched: i64 = 0;
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(projection(data[i])) { matched = matched + 1; }
    }
    return matched;
}

/// @brief Invoke `operation` once for each element, from first to last.
/// Captured closure state can be used to accumulate effects or results.
/// C++20 `std::ranges::for_each` equivalent (without iterator result).
/// @ingroup algorithm_ranges
generic<T, Operation>
pub fn for_each(data: &list<T>, operation: Operation) -> void {
    let n: i64 = data.len();
    for i in 0..n {
        operation(data[i]);
    }
}

/// @brief Invoke `operation` on each element's projected value in order.
/// @ingroup algorithm_ranges
generic<T, Operation, Projection>
pub fn for_each_projected(data: &list<T>, operation: Operation,
                          projection: Projection) -> void {
    let n: i64 = data.len();
    for i in 0..n {
        operation(projection(data[i]));
    }
}

/// @brief Invoke `operation` on the first `count` elements in order.
/// Negative counts perform no calls; counts larger than the range length are
/// clamped to its length. C++20 `std::ranges::for_each_n` counterpart.
/// @ingroup algorithm_ranges
generic<T, Operation>
pub fn for_each_n(data: &list<T>, count: i64, operation: Operation) -> void {
    let data_len: i64 = data.len();
    var n: i64 = count;
    if n < 0 {
        n = 0;
    }
    if n > data_len {
        n = data_len;
    }
    for i in 0..n {
        operation(data[i]);
    }
}

/// @brief Invoke `operation` on projected values from a bounded prefix.
/// Counts clamp to the range length; non-positive counts perform no calls.
/// @ingroup algorithm_ranges
generic<T, Operation, Projection>
pub fn for_each_n_projected(data: &list<T>, count: i64,
                            operation: Operation, projection: Projection)
    -> void {
    let data_len: i64 = data.len();
    var n: i64 = count;
    if n < 0 { n = 0; }
    if n > data_len { n = data_len; }
    for i in 0..n {
        operation(projection(data[i]));
    }
}

/// @brief Fold a range from left to right with an explicit initial value.
/// `operation(accumulator, element)` returns the next accumulator; the
/// accumulator type may differ from the element type. C++23
/// `std::ranges::fold_left` equivalent.
/// @ingroup algorithm_ranges
generic<T, U, Operation>
pub fn fold_left(data: &list<T>, init: U, operation: Operation) -> U {
    var acc: U = init;
    let n: i64 = data.len();
    for i in 0..n {
        acc = operation(acc, data[i]);
    }
    return acc;
}

/// @brief Fold a range from right to left with an explicit initial value.
/// `operation(element, accumulator)` returns the next accumulator. C++23
/// `std::ranges::fold_right` equivalent.
/// @ingroup algorithm_ranges
generic<T, U, Operation>
pub fn fold_right(data: &list<T>, init: U, operation: Operation) -> U {
    var acc: U = init;
    var i: i64 = data.len();
    while i > 0 {
        i = i - 1;
        acc = operation(data[i], acc);
    }
    return acc;
}

/// @brief Fold left and return the final consumed index with the accumulator.
/// Mlang's eager-list analogue of C++23 `std::ranges::fold_left_with_iter`.
/// The returned index is the list length, including for empty input.
/// @ingroup algorithm_ranges
generic<T, U, Operation>
pub fn fold_left_with_iter(data: &list<T>, init: U, operation: Operation) -> tuple<i64, U> {
    var acc: U = init;
    let n: i64 = data.len();
    for i in 0..n {
        acc = operation(acc, data[i]);
    }
    return (n, acc);
}

/// @brief Fold a non-empty range from left to right without an initial value.
/// Empty input returns None. C++23 `std::ranges::fold_left_first` equivalent.
/// @ingroup algorithm_ranges
generic<T, Operation>
pub fn fold_left_first(data: &list<T>, operation: Operation) -> option<T> {
    let n: i64 = data.len();
    if n == 0 {
        return None<T>();
    }
    var acc: T = data[0];
    for i in 1..n {
        acc = operation(acc, data[i]);
    }
    return Some<T>(acc);
}

/// @brief Fold a non-empty range without an initial value and return the
/// consumed element count with the result. Empty input returns None. This is
/// the eager-list analogue of C++23 `std::ranges::fold_left_first_with_iter`.
/// @ingroup algorithm_ranges
generic<T, Output, Operation>
pub fn fold_left_first_with_iter(data: &list<T>, operation: Operation)
    -> option<tuple<i64, Output>> {
    let n: i64 = data.len();
    if n == 0 {
        return None<tuple<i64, Output>>();
    }
    var acc: Output = data[0];
    for i in 1..n {
        acc = operation(acc, data[i]);
    }
    return Some<tuple<i64, Output>>((n, acc));
}

/// @brief Fold a non-empty range from right to left without an initial value.
/// Empty input returns None. C++23 `std::ranges::fold_right_last` equivalent.
/// @ingroup algorithm_ranges
generic<T, Operation>
pub fn fold_right_last(data: &list<T>, operation: Operation) -> option<T> {
    let n: i64 = data.len();
    if n == 0 {
        return None<T>();
    }
    var i: i64 = n - 1;
    var acc: T = data[i];
    while i > 0 {
        i = i - 1;
        acc = operation(data[i], acc);
    }
    return Some<T>(acc);
}

/// @brief Materialize `count` values from a zero-argument generator closure.
/// Non-positive counts return an empty list without invoking the generator.
/// Mlang's eager-list form of C++ `std::generate_n`.
/// @ingroup algorithm_ranges
generic<T, Generator>
pub fn generate_n(count: i64, generator: Generator) -> list<T> {
    var generated: list<T> = [];
    var i: i64 = 0;
    while i < count {
        generated.push(generator());
        i = i + 1;
    }
    return generated;
}

/// @brief Generate one value for each position in `shape`.
/// The shape values are ignored; its length specifies the output range size.
/// Eager-list counterpart to C++20 `std::ranges::generate`.
/// @ingroup algorithm_ranges
generic<Shape, Output, Generator>
pub fn generate(shape: &list<Shape>, generator: Generator) -> list<Output> {
    var generated: list<Output> = [];
    for i in 0..shape.len() {
        generated.push(generator());
    }
    return generated;
}

/// @brief Return a copy of `data` filled with `value` at every position.
/// The input length acts as the output range size; the source is unchanged.
/// Eager-list counterpart to C++20 `std::ranges::fill`.
/// @ingroup algorithm_ranges
generic<T>
pub fn fill(data: &list<T>, value: T) -> list<T> {
    var filled: list<T> = [];
    for i in 0..data.len() {
        filled.push(value);
    }
    return filled;
}

/// @brief Materialize `count` copies of `value` in a new list.
/// Non-positive counts return an empty list. Eager-list counterpart to C++20
/// `std::ranges::fill_n`; the input count defines the output length.
/// @ingroup algorithm_ranges
generic<T>
pub fn fill_n(count: i64, value: T) -> list<T> {
    var filled: list<T> = [];
    var i: i64 = 0;
    while i < count {
        filled.push(value);
        i = i + 1;
    }
    return filled;
}

/// @brief Copy at most `count` values from the beginning of `data`.
/// Negative counts return an empty list and counts larger than the range length
/// are clamped to its length. C++20 `std::ranges::copy_n` counterpart.
/// @ingroup algorithm_ranges
generic<T>
pub fn copy_n(data: &list<T>, count: i64) -> list<T> {
    var copied: list<T> = [];
    let data_len: i64 = data.len();
    var copy_len: i64 = count;
    if copy_len < 0 {
        copy_len = 0;
    }
    if copy_len > data_len {
        copy_len = data_len;
    }
    for i in 0..copy_len {
        copied.push(data[i]);
    }
    return copied;
}

/// @brief Materialize an independent list copy of the complete range.
/// This is the eager-list analogue of C++20 `std::ranges::copy`.
/// @ingroup algorithm_ranges
generic<T>
pub fn copy(data: &list<T>) -> list<T> {
    var copied: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        copied.push(data[i]);
    }
    return copied;
}

/// @brief Swap corresponding elements into two copied ranges.
/// Swaps the common prefix and preserves either unmatched tail. Unlike the
/// mutating C++20 algorithm, this eager-list form returns both new lists and
/// leaves the inputs unchanged.
/// @ingroup algorithm_ranges
generic<T>
pub fn swap_ranges(left: &list<T>, right: &list<T>)
    -> tuple<list<T>, list<T>> {
    var swapped_left: list<T> = [];
    var swapped_right: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let common_len: i64 = left_len < right_len ? left_len : right_len;
    for i in 0..common_len {
        swapped_left.push(right[i]);
        swapped_right.push(left[i]);
    }
    for i in common_len..left_len {
        swapped_left.push(left[i]);
    }
    for i in common_len..right_len {
        swapped_right.push(right[i]);
    }
    return (swapped_left, swapped_right);
}

/// @brief Return a copied list containing elements accepted by `predicate`.
/// This is an eager ranges-style filter/copy-if operation.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn filter(data: &list<T>, predicate: Predicate) -> list<T> {
    var selected: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(data[i]) {
            selected.push(data[i]);
        }
    }
    return selected;
}

/// @brief Filter elements using a predicate applied to projected keys.
/// The output retains original elements and order.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn copy_if_projected(data: &list<T>, predicate: Predicate,
                         projection: Projection) -> list<T> {
    var selected: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(projection(data[i])) { selected.push(data[i]); }
    }
    return selected;
}

/// @brief Transform every element into a new list using `operation`.
/// The output element type is inferred from the operation's return type,
/// so input and output ranges may have different element types.
/// C++20 `std::ranges::transform` (unary form) equivalent.
/// @ingroup algorithm_ranges
generic<T, Output, Operation>
pub fn transform(data: &list<T>, operation: Operation) -> list<Output> {
    var transformed: list<Output> = [];
    let n: i64 = data.len();
    for i in 0..n {
        transformed.push(operation(data[i]));
    }
    return transformed;
}

/// @brief Transform corresponding values from two ranges into a new list.
/// Stops when either input ends, matching the bounded binary overload of
/// C++20 `std::ranges::transform`.
/// @ingroup algorithm_ranges
generic<T, U, Output, Operation>
pub fn transform(left: &list<T>, right: &list<U>, operation: Operation)
    -> list<Output> {
    var transformed: list<Output> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var count: i64 = left_len;
    if right_len < count { count = right_len; }
    for i in 0..count {
        transformed.push(operation(left[i], right[i]));
    }
    return transformed;
}

/// @brief Project each input element, then transform the projected value.
/// The result type is inferred from the operation's return type.
/// @ingroup algorithm_ranges
generic<T, Output, Operation, Projection>
pub fn transform_projected(data: &list<T>, operation: Operation,
                           projection: Projection) -> list<Output> {
    var transformed: list<Output> = [];
    let n: i64 = data.len();
    for i in 0..n {
        transformed.push(operation(projection(data[i])));
    }
    return transformed;
}

/// @brief Transform corresponding elements from two ranges into a new list.
/// Stops when either input range ends. The output element type is inferred
/// from the binary operation's return type (C++23 `ranges::zip_transform`).
/// @ingroup algorithm_ranges
generic<T, U, Output, Operation>
pub fn zip_transform(left: &list<T>, right: &list<U>, operation: Operation)
    -> list<Output> {
    var transformed: list<Output> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var n: i64 = left_len;
    if right_len < n {
        n = right_len;
    }
    for i in 0..n {
        transformed.push(operation(left[i], right[i]));
    }
    return transformed;
}

/// @brief Transform paired values after applying an independent projection.
/// Stops at the shorter input; output type is inferred from `operation`.
/// @ingroup algorithm_ranges
generic<T, U, Output, Operation, LeftProjection, RightProjection>
pub fn zip_transform_projected(
    left: &list<T>, right: &list<U>, operation: Operation,
    left_projection: LeftProjection, right_projection: RightProjection)
    -> list<Output> {
    var transformed: list<Output> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var n: i64 = left_len;
    if right_len < n { n = right_len; }
    for i in 0..n {
        transformed.push(operation(left_projection(left[i]),
                                   right_projection(right[i])));
    }
    return transformed;
}

/// @brief Transform projected values from three ranges in their common prefix.
/// Output type is inferred from the ternary operation's return value.
/// @ingroup algorithm_ranges
generic<T, U, V, Output, Operation, FirstProjection, SecondProjection,
        ThirdProjection>
pub fn zip_transform3_projected(
    first: &list<T>, second: &list<U>, third: &list<V>, operation: Operation,
    first_projection: FirstProjection, second_projection: SecondProjection,
    third_projection: ThirdProjection) -> list<Output> {
    var transformed: list<Output> = [];
    var n: i64 = first.len();
    if second.len() < n { n = second.len(); }
    if third.len() < n { n = third.len(); }
    for i in 0..n {
        transformed.push(operation(first_projection(first[i]),
                                   second_projection(second[i]),
                                   third_projection(third[i])));
    }
    return transformed;
}

/// @brief Transform projected values from four ranges in their common prefix.
/// Output type is inferred from the four-argument operation.
/// @ingroup algorithm_ranges
generic<T, U, V, W, Output, Operation, FirstProjection, SecondProjection,
        ThirdProjection, FourthProjection>
pub fn zip_transform4_projected(
    first: &list<T>, second: &list<U>, third: &list<V>, fourth: &list<W>,
    operation: Operation, first_projection: FirstProjection,
    second_projection: SecondProjection, third_projection: ThirdProjection,
    fourth_projection: FourthProjection) -> list<Output> {
    var transformed: list<Output> = [];
    var n: i64 = first.len();
    if second.len() < n { n = second.len(); }
    if third.len() < n { n = third.len(); }
    if fourth.len() < n { n = fourth.len(); }
    for i in 0..n {
        transformed.push(operation(first_projection(first[i]),
                                   second_projection(second[i]),
                                   third_projection(third[i]),
                                   fourth_projection(fourth[i])));
    }
    return transformed;
}

/// @brief Transform corresponding elements from three ranges into a new list.
/// Stops at the shortest input; output type comes from the ternary operation.
/// C++23 `ranges::zip_transform` counterpart for three inputs.
/// @ingroup algorithm_ranges
generic<T, U, V, Output, Operation>
pub fn zip_transform(first: &list<T>, second: &list<U>, third: &list<V>,
                      operation: Operation) -> list<Output> {
    var transformed: list<Output> = [];
    let first_len: i64 = first.len();
    let second_len: i64 = second.len();
    let third_len: i64 = third.len();
    var n: i64 = first_len;
    if second_len < n {
        n = second_len;
    }
    if third_len < n {
        n = third_len;
    }
    for i in 0..n {
        transformed.push(operation(first[i], second[i], third[i]));
    }
    return transformed;
}

/// @brief Transform corresponding elements from four ranges.
/// Stops at the shortest input; the output type comes from the operation's
/// return value. C++23 `ranges::zip_transform` eager-list counterpart.
/// @ingroup algorithm_ranges
generic<T, U, V, W, Output, Operation>
pub fn zip_transform(first: &list<T>, second: &list<U>, third: &list<V>,
                     fourth: &list<W>, operation: Operation)
    -> list<Output> {
    var transformed: list<Output> = [];
    var n: i64 = first.len();
    if second.len() < n { n = second.len(); }
    if third.len() < n { n = third.len(); }
    if fourth.len() < n { n = fourth.len(); }
    for i in 0..n {
        transformed.push(operation(first[i], second[i], third[i], fourth[i]));
    }
    return transformed;
}

/// @brief Transform corresponding elements from five ranges.
/// Stops at the shortest input; the output type comes from the operation.
generic<T, U, V, W, X, Output, Operation>
pub fn zip_transform(first: &list<T>, second: &list<U>, third: &list<V>,
                     fourth: &list<W>, fifth: &list<X>, operation: Operation)
    -> list<Output> {
    var transformed: list<Output> = [];
    var n: i64 = first.len();
    if second.len() < n { n = second.len(); }
    if third.len() < n { n = third.len(); }
    if fourth.len() < n { n = fourth.len(); }
    if fifth.len() < n { n = fifth.len(); }
    for i in 0..n {
        transformed.push(operation(first[i], second[i], third[i],
                                   fourth[i], fifth[i]));
    }
    return transformed;
}

/// @brief Return whether every element is accepted by `predicate`.
/// Empty ranges return true, matching C++20 `std::ranges::all_of`.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn all_of(data: &list<T>, predicate: Predicate) -> bool {
    let n: i64 = data.len();
    for i in 0..n {
        if !predicate(data[i]) {
            return false;
        }
    }
    return true;
}

/// @brief Check whether every projected key satisfies `predicate`.
/// Empty ranges return true.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn all_of_projected(data: &list<T>, predicate: Predicate,
                        projection: Projection) -> bool {
    let n: i64 = data.len();
    for i in 0..n {
        if !predicate(projection(data[i])) { return false; }
    }
    return true;
}

/// @brief Return whether any element is accepted by `predicate`.
/// Empty ranges return false, matching C++20 `std::ranges::any_of`.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn any_of(data: &list<T>, predicate: Predicate) -> bool {
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(data[i]) {
            return true;
        }
    }
    return false;
}

/// @brief Check whether any projected key satisfies `predicate`.
/// Empty ranges return false.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn any_of_projected(data: &list<T>, predicate: Predicate,
                        projection: Projection) -> bool {
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(projection(data[i])) { return true; }
    }
    return false;
}

/// @brief Return whether no element is accepted by `predicate`.
/// Empty ranges return true, matching C++20 `std::ranges::none_of`.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn none_of(data: &list<T>, predicate: Predicate) -> bool {
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(data[i]) {
            return false;
        }
    }
    return true;
}

/// @brief Check whether no projected key satisfies `predicate`.
/// Empty ranges return true.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn none_of_projected(data: &list<T>, predicate: Predicate,
                         projection: Projection) -> bool {
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(projection(data[i])) { return false; }
    }
    return true;
}

/// @brief Check that matching elements precede all nonmatching elements.
/// C++20 `std::ranges::is_partitioned` semantics.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn is_partitioned(data: &list<T>, predicate: Predicate) -> bool {
    var saw_nonmatching: bool = false;
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(data[i]) {
            if saw_nonmatching {
                return false;
            }
        } else {
            saw_nonmatching = true;
        }
    }
    return true;
}

/// @brief Check projected keys for a true prefix followed by false values.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn is_partitioned_projected(data: &list<T>, predicate: Predicate,
                                projection: Projection) -> bool {
    var saw_nonmatching: bool = false;
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(projection(data[i])) {
            if saw_nonmatching { return false; }
        } else {
            saw_nonmatching = true;
        }
    }
    return true;
}

/// @brief Binary-search the first index not accepted by a partitioned predicate.
/// Returns `data.len()` if all elements match; requires partitioned input.
/// Performs O(log(data.len())) predicate calls.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn partition_point(data: &list<T>, predicate: Predicate) -> i64 {
    var first: i64 = 0;
    var last: i64 = data.len();
    while first < last {
        let middle: i64 = first + (last - first) / 2;
        if predicate(data[middle]) {
            first = middle + 1;
        } else {
            last = middle;
        }
    }
    return first;
}

/// @brief Find the boundary of a partitioned range using projected keys.
/// Requires the predicate to be true on a prefix and false afterwards.
/// Performs O(log(data.len())) predicate calls.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn partition_point_projected(data: &list<T>, predicate: Predicate,
                                 projection: Projection) -> i64 {
    var first: i64 = 0;
    var last: i64 = data.len();
    while first < last {
        let middle: i64 = first + (last - first) / 2;
        if predicate(projection(data[middle])) {
            first = middle + 1;
        } else {
            last = middle;
        }
    }
    return first;
}

/// @brief Return a stable copy with matching elements before the rest.
/// The input remains unchanged; each predicate result is evaluated once.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn stable_partition(data: &list<T>, predicate: Predicate) -> list<T> {
    var matches: list<i32> = [];
    var partitioned: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(data[i]) {
            matches.push(1);
        } else {
            matches.push(0);
        }
    }
    for i in 0..n {
        if matches[i] == 1 {
            partitioned.push(data[i]);
        }
    }
    for i in 0..n {
        if matches[i] == 0 {
            partitioned.push(data[i]);
        }
    }
    return partitioned;
}

/// @brief Return a stable copy partitioned by a predicate over projected keys.
/// Each projection and predicate is evaluated exactly once per element.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn stable_partition_projected(data: &list<T>, predicate: Predicate,
                                  projection: Projection) -> list<T> {
    var matches: list<i32> = [];
    var partitioned: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(projection(data[i])) { matches.push(1); }
        else { matches.push(0); }
    }
    for i in 0..n {
        if matches[i] == 1 { partitioned.push(data[i]); }
    }
    for i in 0..n {
        if matches[i] == 0 { partitioned.push(data[i]); }
    }
    return partitioned;
}

/// @brief Return a partitioned copy and the boundary between both groups.
/// Matching elements precede nonmatching elements; the eager list is left
/// unchanged and each predicate result is evaluated exactly once. The copy
/// preserves order within each group. C++20 `std::ranges::partition` analogue.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn partition(data: &list<T>, predicate: Predicate)
    -> tuple<list<T>, i64> {
    var matching: list<T> = [];
    var nonmatching: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(data[i]) {
            matching.push(data[i]);
        } else {
            nonmatching.push(data[i]);
        }
    }
    let boundary: i64 = matching.len();
    var output: list<T> = [];
    for i in 0..matching.len() {
        output.push(matching[i]);
    }
    for i in 0..nonmatching.len() {
        output.push(nonmatching[i]);
    }
    return (output, boundary);
}

/// @brief Return a stable partitioned copy and boundary using projected keys.
/// Each projection and predicate is evaluated exactly once per element.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn partition_projected(data: &list<T>, predicate: Predicate,
                           projection: Projection) -> tuple<list<T>, i64> {
    var matching: list<T> = [];
    var nonmatching: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(projection(data[i])) { matching.push(data[i]); }
        else { nonmatching.push(data[i]); }
    }
    let boundary: i64 = matching.len();
    var output: list<T> = [];
    for i in 0..matching.len() { output.push(matching[i]); }
    for i in 0..nonmatching.len() { output.push(nonmatching[i]); }
    return (output, boundary);
}

/// @brief Copy matching and nonmatching elements into separate stable lists.
/// Each element's predicate is evaluated exactly once; the source is unchanged.
/// C++20 `std::ranges::partition_copy` equivalent.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn partition_copy(data: &list<T>, predicate: Predicate)
    -> tuple<list<T>, list<T>> {
    var matching: list<T> = [];
    var nonmatching: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(data[i]) {
            matching.push(data[i]);
        } else {
            nonmatching.push(data[i]);
        }
    }
    return (matching, nonmatching);
}

/// @brief Copy matching and nonmatching elements using projected keys.
/// Each projection and predicate is evaluated once; both outputs are stable.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn partition_copy_projected(data: &list<T>, predicate: Predicate,
                                projection: Projection)
    -> tuple<list<T>, list<T>> {
    var matching: list<T> = [];
    var nonmatching: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(projection(data[i])) { matching.push(data[i]); }
        else { nonmatching.push(data[i]); }
    }
    return (matching, nonmatching);
}

/// @brief Return the first index rejected by `predicate`, or -1 if all match.
/// C++20 `std::ranges::find_if_not` semantics.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn find_if_not(data: &list<T>, predicate: Predicate) -> i64 {
    let n: i64 = data.len();
    for i in 0..n {
        if !predicate(data[i]) {
            return i;
        }
    }
    return -1;
}

/// @brief Find the first element rejected after projection, or -1.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn find_if_not_projected(data: &list<T>, predicate: Predicate,
                             projection: Projection) -> i64 {
    let n: i64 = data.len();
    for i in 0..n {
        if !predicate(projection(data[i])) { return i; }
    }
    return -1;
}

/// @brief Return the last index rejected by `predicate`, or -1.
/// C++23 `std::ranges::find_last_if_not` semantics.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn find_last_if_not(data: &list<T>, predicate: Predicate) -> i64 {
    var i: i64 = data.len();
    while i > 0 {
        i = i - 1;
        if !predicate(data[i]) {
            return i;
        }
    }
    return -1;
}

/// @brief Find the last element rejected after projection, or -1.
/// C++23 `std::ranges::find_last_if_not` projection form.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn find_last_if_not_projected(data: &list<T>, predicate: Predicate,
                                  projection: Projection) -> i64 {
    var i: i64 = data.len();
    while i > 0 {
        i = i - 1;
        if !predicate(projection(data[i])) { return i; }
    }
    return -1;
}

/// @brief Return a compacted copy without elements accepted by `predicate`.
/// This eager form leaves the input range unchanged.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn remove_if(data: &list<T>, predicate: Predicate) -> list<T> {
    var kept: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if !predicate(data[i]) {
            kept.push(data[i]);
        }
    }
    return kept;
}

/// @brief Copy elements rejected by a predicate over projected keys.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn remove_if_projected(data: &list<T>, predicate: Predicate,
                           projection: Projection) -> list<T> {
    var kept: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if !predicate(projection(data[i])) { kept.push(data[i]); }
    }
    return kept;
}

/// @brief Copy elements accepted by `predicate` into a new list.
/// C++20 `std::ranges::copy_if` counterpart for eager Mlang lists.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn copy_if(data: &list<T>, predicate: Predicate) -> list<T> {
    var copied: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(data[i]) {
            copied.push(data[i]);
        }
    }
    return copied;
}

/// @brief Copy elements rejected by a predicate over projected keys.
/// C++20 `std::ranges::remove_copy_if` projection form.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn remove_copy_if_projected(data: &list<T>, predicate: Predicate,
                                projection: Projection) -> list<T> {
    var copied: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if !predicate(projection(data[i])) { copied.push(data[i]); }
    }
    return copied;
}

/// @brief Sample up to `count` distinct elements in their original order.
/// `choose_index(upper_bound)` must return an index in
/// `[0, upper_bound)`. This eager C++20 `std::ranges::sample` counterpart lets
/// callers supply their own random engine and leaves the input unchanged.
/// @ingroup algorithm_ranges
generic<T, ChooseIndex>
pub fn sample(data: &list<T>, count: i64, choose_index: ChooseIndex) -> list<T> {
    var sampled: list<T> = [];
    let n: i64 = data.len();
    var sample_count: i64 = count;
    if sample_count < 0 {
        sample_count = 0;
    }
    if sample_count > n {
        sample_count = n;
    }

    // Sequential selection chooses each candidate with probability
    // remaining_needed / remaining_items, and stops drawing once all remaining
    // candidates must be selected. This samples uniformly without replacement.
    for i in 0..n {
        let needed: i64 = sample_count - sampled.len();
        let remaining_items: i64 = n - i;
        if needed >= remaining_items {
            sampled.push(data[i]);
        } else if needed > 0 {
            let requested_index: i64 = choose_index(remaining_items);
            let selected_index: i64 = requested_index < 0 ? 0 :
                (requested_index >= remaining_items ?
                    remaining_items - 1 : requested_index);
            if selected_index < needed {
                sampled.push(data[i]);
            }
        }
    }
    return sampled;
}

/// @brief Return a shuffled copy using a bounded random-index selector.
/// `choose_index(upper_bound)` must return an index in
/// `[0, upper_bound)`. The eager implementation leaves the source unchanged;
/// removing selected elements from the remaining list makes this O(N^2).
/// @ingroup algorithm_ranges
generic<T, ChooseIndex>
pub fn shuffle(data: &list<T>, choose_index: ChooseIndex) -> list<T> {
    var shuffled: list<T> = [];
    var remaining: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        remaining.push(data[i]);
    }

    while remaining.len() > 0 {
        let bound: i64 = remaining.len();
        var selected_index: i64 = choose_index(bound);
        if selected_index < 0 {
            selected_index = 0;
        }
        if selected_index >= bound {
            selected_index = bound - 1;
        }
        shuffled.push(remaining[selected_index]);

        var next_remaining: list<T> = [];
        for i in 0..bound {
            if i != selected_index {
                next_remaining.push(remaining[i]);
            }
        }
        remaining = next_remaining;
    }
    return shuffled;
}

/// @brief Copy elements unequal to `value` into a new list.
/// C++20 `std::ranges::remove_copy` counterpart; the input is unchanged.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn remove_copy(data: &list<T>, value: U) -> list<T> {
    var copied: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if data[i] != value {
            copied.push(data[i]);
        }
    }
    return copied;
}

/// @brief Copy elements not equivalent to `value` into a new list.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn remove_copy_by(data: &list<T>, value: U,
                      equivalent: Equivalent) -> list<T> {
    return remove_by(data, value, equivalent);
}

/// @brief Copy elements whose projected keys are not equivalent to `value`.
/// The predicate receives the projected element key followed by the lookup key.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, Projection>
pub fn remove_copy_by_projected(data: &list<T>, value: U,
                                equivalent: Equivalent,
                                projection: Projection) -> list<T> {
    return remove_by_projected(data, value, equivalent, projection);
}

/// @brief Copy elements whose projected key differs from `value`.
/// C++20 `std::ranges::remove_copy` projection form; the input is unchanged.
/// @ingroup algorithm_ranges
generic<T, U, Projection>
pub fn remove_copy_projected(data: &list<T>, value: U,
                             projection: Projection) -> list<T> {
    var copied: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if projection(data[i]) != value { copied.push(data[i]); }
    }
    return copied;
}

/// @brief Copy elements rejected by `predicate` into a new list.
/// C++20 `std::ranges::remove_copy_if` counterpart; the input is unchanged.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn remove_copy_if(data: &list<T>, predicate: Predicate) -> list<T> {
    var copied: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if !predicate(data[i]) {
            copied.push(data[i]);
        }
    }
    return copied;
}

/// @brief Copy a range while replacing each value equal to `old_value`.
/// C++20 `std::ranges::replace_copy` counterpart; the input is unchanged.
/// @ingroup algorithm_ranges
generic<T, U, V>
pub fn replace_copy(data: &list<T>, old_value: U, new_value: V) -> list<T> {
    var copied: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if data[i] == old_value {
            copied.push(new_value);
        } else {
            copied.push(data[i]);
        }
    }
    return copied;
}

/// @brief Replace values matching `old_value` under `equivalent` in a copy.
/// The input range is unchanged.
/// @ingroup algorithm_ranges
generic<T, U, V, Equivalent>
pub fn replace_copy_by(data: &list<T>, old_value: U, new_value: V,
                       equivalent: Equivalent) -> list<T> {
    var copied: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if equivalent(data[i], old_value) { copied.push(new_value); }
        else { copied.push(data[i]); }
    }
    return copied;
}

/// @brief Replace values whose projected key equals `old_value` in a copy.
/// C++20 `std::ranges::replace_copy` projection form; the input is unchanged.
/// @ingroup algorithm_ranges
generic<T, U, V, Projection>
pub fn replace_copy_projected(data: &list<T>, old_value: U, new_value: V,
                              projection: Projection) -> list<T> {
    var copied: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if projection(data[i]) == old_value {
            copied.push(new_value);
        } else {
            copied.push(data[i]);
        }
    }
    return copied;
}

/// @brief Replace values whose projected key matches under `equivalent`.
/// `old_key` is compared directly with each projected element key.
/// @ingroup algorithm_ranges
generic<T, U, V, Equivalent, Projection>
pub fn replace_copy_by_projected(data: &list<T>, old_key: U, new_value: V,
                                 equivalent: Equivalent,
                                 projection: Projection) -> list<T> {
    var copied: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if equivalent(projection(data[i]), old_key) { copied.push(new_value); }
        else { copied.push(data[i]); }
    }
    return copied;
}

/// @brief Copy a range, replacing each element accepted by `predicate`.
/// C++20 `std::ranges::replace_copy_if` counterpart; the input is unchanged.
/// @ingroup algorithm_ranges
generic<T, Predicate, V>
pub fn replace_copy_if(data: &list<T>, predicate: Predicate,
                       new_value: V) -> list<T> {
    var copied: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(data[i]) {
            copied.push(new_value);
        } else {
            copied.push(data[i]);
        }
    }
    return copied;
}

/// @brief Replace matching projected-key values in a copied list.
/// C++20 `std::ranges::replace_copy_if` projection form.
/// @ingroup algorithm_ranges
generic<T, Predicate, V, Projection>
pub fn replace_copy_if_projected(data: &list<T>, predicate: Predicate,
                                 new_value: V, projection: Projection)
    -> list<T> {
    var copied: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(projection(data[i])) { copied.push(new_value); }
        else { copied.push(data[i]); }
    }
    return copied;
}

/// @brief Replace each element accepted by `predicate` in a copied range.
/// The original range is unchanged.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn replace_if(data: &list<T>, predicate: Predicate, replacement: T) -> list<T> {
    var replaced: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(data[i]) {
            replaced.push(replacement);
        } else {
            replaced.push(data[i]);
        }
    }
    return replaced;
}

/// @brief Replace matching projected-key values in a copied list.
/// The original range is unchanged.
/// @ingroup algorithm_ranges
generic<T, Predicate, V, Projection>
pub fn replace_if_projected(data: &list<T>, predicate: Predicate,
                            replacement: V, projection: Projection)
    -> list<T> {
    var replaced: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if predicate(projection(data[i])) { replaced.push(replacement); }
        else { replaced.push(data[i]); }
    }
    return replaced;
}

/// @brief Remove adjacent elements equivalent under `equivalent`.
/// The first element in each adjacent run is preserved.
/// @ingroup algorithm_ranges
generic<T, Equivalent>
pub fn unique_by(data: &list<T>, equivalent: Equivalent) -> list<T> {
    let n: i64 = data.len();
    if n == 0 {
        return [];
    }
    var unique_values: list<T> = [];
    var previous: T = data[0];
    unique_values.push(previous);
    for i in 1..n {
        if !equivalent(previous, data[i]) {
            previous = data[i];
            unique_values.push(previous);
        }
    }
    return unique_values;
}

/// @brief Remove adjacent values whose projected keys are equal.
/// The first original value in each adjacent key run is preserved.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn unique_projected(data: &list<T>, projection: Projection) -> list<T> {
    let n: i64 = data.len();
    if n == 0 {
        return [];
    }
    var unique_values: list<T> = [];
    var previous_key = projection(data[0]);
    unique_values.push(data[0]);
    for i in 1..n {
        let current_key = projection(data[i]);
        if current_key != previous_key {
            unique_values.push(data[i]);
            previous_key = current_key;
        }
    }
    return unique_values;
}

/// @brief Remove adjacent values equivalent under projected keys.
/// The first original value in each adjacent equivalence run is preserved.
/// @ingroup algorithm_ranges
generic<T, Equivalent, Projection>
pub fn unique_by_projected(data: &list<T>, equivalent: Equivalent,
                           projection: Projection) -> list<T> {
    let n: i64 = data.len();
    if n == 0 { return []; }
    var unique_values: list<T> = [];
    var previous_key = projection(data[0]);
    unique_values.push(data[0]);
    for i in 1..n {
        let current_key = projection(data[i]);
        if !equivalent(previous_key, current_key) {
            unique_values.push(data[i]);
            previous_key = current_key;
        }
    }
    return unique_values;
}

/// @brief Copy one value from each adjacent equivalence class.
/// C++20 `std::ranges::unique_copy` counterpart; the source is unchanged.
/// @ingroup algorithm_ranges
generic<T, Equivalent>
pub fn unique_copy_by(data: &list<T>, equivalent: Equivalent) -> list<T> {
    return unique_by(data, equivalent);
}

/// @brief Copy one value from each adjacent projected-key run.
/// The first original value in each run is retained; the source is unchanged.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn unique_copy_projected(data: &list<T>, projection: Projection) -> list<T> {
    return unique_projected(data, projection);
}

/// @brief Copy one value from each adjacent projected equivalence class.
/// The first original value in each run is retained; the source is unchanged.
/// @ingroup algorithm_ranges
generic<T, Equivalent, Projection>
pub fn unique_copy_by_projected(data: &list<T>, equivalent: Equivalent,
                                projection: Projection) -> list<T> {
    return unique_by_projected(data, equivalent, projection);
}


/// @brief Return whether two lists contain the same elements in order.
/// The ranges may have different, equality-comparable element types.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn equal(left: &list<T>, right: &list<U>) -> bool {
    let n: i64 = left.len();
    if n != right.len() {
        return false;
    }
    for i in 0..n {
        if left[i] != right[i] {
            return false;
        }
    }
    return true;
}

/// @brief Compare ranges for equality after applying a projection to each.
/// The two projections may return distinct equality-comparable types.
/// @ingroup algorithm_ranges
generic<T, U, LeftProjection, RightProjection>
pub fn equal_projected(left: &list<T>, right: &list<U>,
                       left_projection: LeftProjection,
                       right_projection: RightProjection) -> bool {
    let n: i64 = left.len();
    if n != right.len() {
        return false;
    }
    for i in 0..n {
        if left_projection(left[i]) != right_projection(right[i]) {
            return false;
        }
    }
    return true;
}

/// @brief Return indices of the first unequal elements in two ranges.
/// Comparison stops when either range ends; equal prefixes return the shared
/// prefix length for both indices, matching C++20 `std::ranges::mismatch`.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn mismatch(left: &list<T>, right: &list<U>) -> tuple<i64, i64> {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var n: i64 = left_len;
    if right_len < n {
        n = right_len;
    }
    for i in 0..n {
        if left[i] != right[i] {
            return (i, i);
        }
    }
    return (n, n);
}

/// @brief Find the first mismatch between ranges after projecting each value.
/// Stops at the shorter range; an equal prefix returns its shared length.
/// @ingroup algorithm_ranges
generic<T, U, LeftProjection, RightProjection>
pub fn mismatch_projected(left: &list<T>, right: &list<U>,
                          left_projection: LeftProjection,
                          right_projection: RightProjection)
    -> tuple<i64, i64> {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var n: i64 = left_len;
    if right_len < n { n = right_len; }
    for i in 0..n {
        if left_projection(left[i]) != right_projection(right[i]) {
            return (i, i);
        }
    }
    return (n, n);
}

/// @brief Find the first pair rejected by `equivalent`, stopping at either end.
/// Equal prefixes return their shared length for both indices.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn mismatch_by(left: &list<T>, right: &list<U>, equivalent: Equivalent)
    -> tuple<i64, i64> {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var n: i64 = left_len;
    if right_len < n {
        n = right_len;
    }
    for i in 0..n {
        if !equivalent(left[i], right[i]) {
            return (i, i);
        }
    }
    return (n, n);
}

/// @brief Find the first mismatch after projecting both ranges and comparing
/// projected values with `equivalent`. Stops at the shorter input.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, LeftProjection, RightProjection>
pub fn mismatch_by_projected(
    left: &list<T>, right: &list<U>, equivalent: Equivalent,
    left_projection: LeftProjection, right_projection: RightProjection)
    -> tuple<i64, i64> {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var n: i64 = left_len;
    if right_len < n { n = right_len; }
    for i in 0..n {
        if !equivalent(left_projection(left[i]),
                       right_projection(right[i])) {
            return (i, i);
        }
    }
    return (n, n);
}

/// @brief Compare corresponding elements with a caller-supplied equivalence.
/// The ranges are equal only when they have the same length and every pair
/// satisfies `equivalent(left[i], right[i])`.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn equal_by(left: &list<T>, right: &list<U>, equivalent: Equivalent)
    -> bool {
    let n: i64 = left.len();
    if n != right.len() {
        return false;
    }
    for i in 0..n {
        if !equivalent(left[i], right[i]) {
            return false;
        }
    }
    return true;
}

/// @brief Compare projected ranges elementwise with an equivalence predicate.
/// The ranges must have equal lengths.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, LeftProjection, RightProjection>
pub fn equal_by_projected(
    left: &list<T>, right: &list<U>, equivalent: Equivalent,
    left_projection: LeftProjection, right_projection: RightProjection)
    -> bool {
    let n: i64 = left.len();
    if n != right.len() { return false; }
    for i in 0..n {
        if !equivalent(left_projection(left[i]),
                       right_projection(right[i])) {
            return false;
        }
    }
    return true;
}

/// @brief Return whether two lists contain the same multiset of values.
/// Duplicate multiplicities matter; element order does not.
/// C++20 ranges-style permutation comparison.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn is_permutation(left: &list<T>, right: &list<U>) -> bool {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    if left_len != right_len {
        return false;
    }
    for i in 0..left_len {
        let value: T = left[i];
        var left_count: i64 = 0;
        var right_count: i64 = 0;
        for j in 0..left_len {
            if left[j] == value {
                left_count = left_count + 1;
            }
        }
        for j in 0..right_len {
            if right[j] == value {
                right_count = right_count + 1;
            }
        }
        if left_count != right_count {
            return false;
        }
    }
    return true;
}

/// @brief Compare two lists as multisets using `equivalent` for values.
/// Duplicate multiplicities matter; element order does not.
/// @ingroup algorithm_ranges
generic<T, Equivalent>
pub fn is_permutation_by(left: &list<T>, right: &list<T>,
                         equivalent: Equivalent) -> bool {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    if left_len != right_len {
        return false;
    }
    for i in 0..left_len {
        var left_count: i64 = 0;
        var right_count: i64 = 0;
        for j in 0..left_len {
            if equivalent(left[i], left[j]) {
                left_count = left_count + 1;
            }
        }
        for j in 0..right_len {
            if equivalent(left[i], right[j]) {
                right_count = right_count + 1;
            }
        }
        if left_count != right_count {
            return false;
        }
    }
    return true;
}

/// @brief Compare projected values as multisets, including duplicate counts.
/// The two projections may map different element types to a common comparable
/// key type.
/// @ingroup algorithm_ranges
generic<T, U, LeftProjection, RightProjection>
pub fn is_permutation_projected(left: &list<T>, right: &list<U>,
                                left_projection: LeftProjection,
                                right_projection: RightProjection) -> bool {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    if left_len != right_len { return false; }
    for i in 0..left_len {
        let key = left_projection(left[i]);
        var left_count: i64 = 0;
        var right_count: i64 = 0;
        for j in 0..left_len {
            if left_projection(left[j]) == key {
                left_count = left_count + 1;
            }
        }
        for j in 0..right_len {
            if right_projection(right[j]) == key {
                right_count = right_count + 1;
            }
        }
        if left_count != right_count { return false; }
    }
    return true;
}

/// @brief Compare projected multisets by a strict ordering's equivalence.
/// Duplicate multiplicities matter; the projections may accept different
/// element types but must produce keys accepted by the same comparator.
/// @ingroup algorithm_ranges
generic<T, U, Less, LeftProjection, RightProjection>
pub fn is_permutation_by_projected(
    left: &list<T>, right: &list<U>, less: Less,
    left_projection: LeftProjection, right_projection: RightProjection)
    -> bool {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    if left_len != right_len { return false; }
    for i in 0..left_len {
        let key = left_projection(left[i]);
        var left_count: i64 = 0;
        var right_count: i64 = 0;
        for j in 0..left_len {
            let candidate = left_projection(left[j]);
            if !less(key, candidate) && !less(candidate, key) {
                left_count = left_count + 1;
            }
        }
        for j in 0..right_len {
            let candidate = right_projection(right[j]);
            if !less(key, candidate) && !less(candidate, key) {
                right_count = right_count + 1;
            }
        }
        if left_count != right_count { return false; }
    }
    return true;
}

/// @brief Return whether `prefix` matches the beginning of `data`.
/// The two ranges may have different, equality-comparable element types.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn starts_with(data: &list<T>, prefix: &list<U>) -> bool {
    let prefix_len: i64 = prefix.len();
    if prefix_len > data.len() {
        return false;
    }
    for i in 0..prefix_len {
        if data[i] != prefix[i] {
            return false;
        }
    }
    return true;
}

/// @brief Check whether projected prefix keys match the range's initial keys.
/// @ingroup algorithm_ranges
generic<T, U, DataProjection, PrefixProjection>
pub fn starts_with_projected(data: &list<T>, prefix: &list<U>,
                             data_projection: DataProjection,
                             prefix_projection: PrefixProjection) -> bool {
    let prefix_len: i64 = prefix.len();
    if prefix_len > data.len() { return false; }
    for i in 0..prefix_len {
        if data_projection(data[i]) != prefix_projection(prefix[i]) {
            return false;
        }
    }
    return true;
}

/// @brief Return whether `prefix` matches the beginning of `data` using a
/// caller-provided binary predicate.
/// C++20 `std::ranges::starts_with` predicate overload.
/// @ingroup algorithm_ranges
generic<T, U, Predicate>
pub fn starts_with_by(data: &list<T>, prefix: &list<U>,
                      equivalent: Predicate) -> bool {
    let prefix_len: i64 = prefix.len();
    if prefix_len > data.len() {
        return false;
    }
    for i in 0..prefix_len {
        if !equivalent(data[i], prefix[i]) {
            return false;
        }
    }
    return true;
}

/// @brief Check a prefix using an equivalence predicate over projected values.
/// The two ranges may have different element types.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, DataProjection, PrefixProjection>
pub fn starts_with_by_projected(
    data: &list<T>, prefix: &list<U>, equivalent: Equivalent,
    data_projection: DataProjection, prefix_projection: PrefixProjection)
    -> bool {
    let prefix_len: i64 = prefix.len();
    if prefix_len > data.len() { return false; }
    for i in 0..prefix_len {
        if !equivalent(data_projection(data[i]),
                       prefix_projection(prefix[i])) {
            return false;
        }
    }
    return true;
}

/// @brief Find the first occurrence of a subsequence, returning its start index.
/// Returns 0 for an empty pattern and -1 when no match exists.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn search(data: &list<T>, pattern: &list<U>) -> i64 {
    let data_len: i64 = data.len();
    let pattern_len: i64 = pattern.len();
    if pattern_len == 0 {
        return 0;
    }
    if pattern_len > data_len {
        return -1;
    }
    let last_start: i64 = data_len - pattern_len;
    for start in 0..(last_start + 1) {
        var matched: bool = true;
        for offset in 0..pattern_len {
            if data[start + offset] != pattern[offset] {
                matched = false;
                break;
            }
        }
        if matched {
            return start;
        }
    }
    return -1;
}

/// @brief Find the first subrange matching after independent projections.
/// Returns 0 for an empty pattern and -1 when no match exists.
/// @ingroup algorithm_ranges
generic<T, U, DataProjection, PatternProjection>
pub fn search_projected(data: &list<T>, pattern: &list<U>,
                        data_projection: DataProjection,
                        pattern_projection: PatternProjection) -> i64 {
    let data_len: i64 = data.len();
    let pattern_len: i64 = pattern.len();
    if pattern_len == 0 { return 0; }
    if pattern_len > data_len { return -1; }
    let last_start: i64 = data_len - pattern_len;
    for start in 0..(last_start + 1) {
        var matched: bool = true;
        for offset in 0..pattern_len {
            if data_projection(data[start + offset]) !=
               pattern_projection(pattern[offset]) {
                matched = false;
                break;
            }
        }
        if matched { return start; }
    }
    return -1;
}

/// @brief Find the first subrange matching with a binary equivalence predicate.
/// Returns 0 for an empty pattern and -1 when no match exists.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn search_by(data: &list<T>, pattern: &list<U>,
                 equivalent: Equivalent) -> i64 {
    let data_len: i64 = data.len();
    let pattern_len: i64 = pattern.len();
    if pattern_len == 0 {
        return 0;
    }
    if pattern_len > data_len {
        return -1;
    }
    let last_start: i64 = data_len - pattern_len;
    for start in 0..(last_start + 1) {
        var matched: bool = true;
        for offset in 0..pattern_len {
            if !equivalent(data[start + offset], pattern[offset]) {
                matched = false;
                break;
            }
        }
        if matched {
            return start;
        }
    }
    return -1;
}

/// @brief Find the first projected subrange matching under `equivalent`.
/// The two ranges may have different element types; empty pattern returns 0.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, DataProjection, PatternProjection>
pub fn search_by_projected(
    data: &list<T>, pattern: &list<U>, equivalent: Equivalent,
    data_projection: DataProjection, pattern_projection: PatternProjection)
    -> i64 {
    let data_len: i64 = data.len();
    let pattern_len: i64 = pattern.len();
    if pattern_len == 0 { return 0; }
    if pattern_len > data_len { return -1; }
    let last_start: i64 = data_len - pattern_len;
    for start in 0..(last_start + 1) {
        var matched: bool = true;
        for offset in 0..pattern_len {
            if !equivalent(data_projection(data[start + offset]),
                           pattern_projection(pattern[offset])) {
                matched = false;
                break;
            }
        }
        if matched { return start; }
    }
    return -1;
}

/// @brief Find the first run of `count` consecutive values equal to `value`.
/// Returns 0 for a non-positive count and -1 when no run exists.
/// C++20 `std::ranges::search_n` equivalent.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn search_n(data: &list<T>, count: i64, value: U) -> i64 {
    if count <= 0 {
        return 0;
    }
    let n: i64 = data.len();
    if count > n {
        return -1;
    }
    let last_start: i64 = n - count;
    for start in 0..(last_start + 1) {
        var matches: bool = true;
        for offset in 0..count {
            if data[start + offset] != value {
                matches = false;
                break;
            }
        }
        if matches {
            return start;
        }
    }
    return -1;
}

/// @brief Find a run whose projected keys equal `value`.
/// Returns 0 for a non-positive count and -1 when no run exists.
/// C++20 `std::ranges::search_n` projection form.
/// @ingroup algorithm_ranges
generic<T, U, Projection>
pub fn search_n_projected(data: &list<T>, count: i64, value: U,
                          projection: Projection) -> i64 {
    if count <= 0 { return 0; }
    let n: i64 = data.len();
    if count > n { return -1; }
    let last_start: i64 = n - count;
    for start in 0..(last_start + 1) {
        var matches: bool = true;
        for offset in 0..count {
            if projection(data[start + offset]) != value {
                matches = false;
                break;
            }
        }
        if matches { return start; }
    }
    return -1;
}

/// @brief Find a run whose elements satisfy `equivalent(element, value)`.
/// Returns 0 for a non-positive count and -1 when no run exists.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn search_n_by(data: &list<T>, count: i64, value: U,
                   equivalent: Equivalent) -> i64 {
    if count <= 0 {
        return 0;
    }
    let n: i64 = data.len();
    if count > n {
        return -1;
    }
    let last_start: i64 = n - count;
    for start in 0..(last_start + 1) {
        var matches: bool = true;
        for offset in 0..count {
            if !equivalent(data[start + offset], value) {
                matches = false;
                break;
            }
        }
        if matches {
            return start;
        }
    }
    return -1;
}

/// @brief Find a projected run whose keys match `value` under `equivalent`.
/// Returns 0 for a non-positive count and -1 when no run exists.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, Projection>
pub fn search_n_by_projected(data: &list<T>, count: i64, value: U,
                             equivalent: Equivalent,
                             projection: Projection) -> i64 {
    if count <= 0 { return 0; }
    let n: i64 = data.len();
    if count > n { return -1; }
    let last_start: i64 = n - count;
    for start in 0..(last_start + 1) {
        var matches: bool = true;
        for offset in 0..count {
            if !equivalent(projection(data[start + offset]), value) {
                matches = false;
                break;
            }
        }
        if matches { return start; }
    }
    return -1;
}

/// @brief Return the start index of the last matching subrange.
/// Returns the range length for an empty pattern and -1 when absent.
/// C++20 `std::ranges::find_end` equivalent.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn find_end(data: &list<T>, pattern: &list<U>) -> i64 {
    let n: i64 = data.len();
    let m: i64 = pattern.len();
    if m == 0 {
        return n;
    }
    if m > n {
        return -1;
    }
    let last_start: i64 = n - m;
    var found: i64 = -1;
    for start in 0..(last_start + 1) {
        var matches: bool = true;
        for offset in 0..m {
            if data[start + offset] != pattern[offset] {
                matches = false;
                break;
            }
        }
        if matches {
            found = start;
        }
    }
    return found;
}

/// @brief Find the last subrange matching after independent projections.
/// Returns `data.len()` for an empty pattern and -1 when absent.
/// @ingroup algorithm_ranges
generic<T, U, DataProjection, PatternProjection>
pub fn find_end_projected(data: &list<T>, pattern: &list<U>,
                          data_projection: DataProjection,
                          pattern_projection: PatternProjection) -> i64 {
    let n: i64 = data.len();
    let m: i64 = pattern.len();
    if m == 0 { return n; }
    if m > n { return -1; }
    let last_start: i64 = n - m;
    var found: i64 = -1;
    for start in 0..(last_start + 1) {
        var matches: bool = true;
        for offset in 0..m {
            if data_projection(data[start + offset]) !=
               pattern_projection(pattern[offset]) {
                matches = false;
                break;
            }
        }
        if matches { found = start; }
    }
    return found;
}

/// @brief Return the last matching subrange index using `equivalent`.
/// Returns `data.len()` for an empty pattern and -1 when absent.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn find_end_by(data: &list<T>, pattern: &list<U>,
                   equivalent: Equivalent) -> i64 {
    let n: i64 = data.len();
    let m: i64 = pattern.len();
    if m == 0 {
        return n;
    }
    if m > n {
        return -1;
    }
    let last_start: i64 = n - m;
    var found: i64 = -1;
    for start in 0..(last_start + 1) {
        var matches: bool = true;
        for offset in 0..m {
            if !equivalent(data[start + offset], pattern[offset]) {
                matches = false;
                break;
            }
        }
        if matches {
            found = start;
        }
    }
    return found;
}

/// @brief Find the last projected subrange matching under `equivalent`.
/// An empty pattern returns `data.len()`; absent patterns return -1.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, DataProjection, PatternProjection>
pub fn find_end_by_projected(
    data: &list<T>, pattern: &list<U>, equivalent: Equivalent,
    data_projection: DataProjection, pattern_projection: PatternProjection)
    -> i64 {
    let n: i64 = data.len();
    let m: i64 = pattern.len();
    if m == 0 { return n; }
    if m > n { return -1; }
    let last_start: i64 = n - m;
    var found: i64 = -1;
    for start in 0..(last_start + 1) {
        var matches: bool = true;
        for offset in 0..m {
            if !equivalent(data_projection(data[start + offset]),
                           pattern_projection(pattern[offset])) {
                matches = false;
                break;
            }
        }
        if matches { found = start; }
    }
    return found;
}

/// @brief Return whether `pattern` occurs as a contiguous subsequence.
/// C++23 ranges-style subrange membership check.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn contains_subrange(data: &list<T>, pattern: &list<U>) -> bool {
    return search(data, pattern) >= 0;
}

/// @brief Test for a contiguous match after independent projections.
/// An empty pattern matches every range.
/// @ingroup algorithm_ranges
generic<T, U, DataProjection, PatternProjection>
pub fn contains_subrange_projected(
    data: &list<T>, pattern: &list<U>,
    data_projection: DataProjection,
    pattern_projection: PatternProjection) -> bool {
    return search_projected(data, pattern, data_projection,
                            pattern_projection) >= 0;
}

/// @brief Return whether `pattern` occurs contiguously under `equivalent`.
/// The ranges may have different element types. An empty pattern always
/// matches, including an empty input range.
/// C++23 `std::ranges::contains_subrange` predicate overload.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn contains_subrange_by(data: &list<T>, pattern: &list<U>,
                            equivalent: Equivalent) -> bool {
    return search_by(data, pattern, equivalent) >= 0;
}

/// @brief Test for a projected subrange match under `equivalent`.
/// Empty patterns match every range.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, DataProjection, PatternProjection>
pub fn contains_subrange_by_projected(
    data: &list<T>, pattern: &list<U>, equivalent: Equivalent,
    data_projection: DataProjection, pattern_projection: PatternProjection)
    -> bool {
    return search_by_projected(data, pattern, equivalent, data_projection,
                               pattern_projection) >= 0;
}

/// @brief Return whether `suffix` matches the end of `data`.
/// The two ranges may have different, equality-comparable element types.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn ends_with(data: &list<T>, suffix: &list<U>) -> bool {
    let suffix_len: i64 = suffix.len();
    let data_len: i64 = data.len();
    if suffix_len > data_len {
        return false;
    }
    let offset: i64 = data_len - suffix_len;
    for i in 0..suffix_len {
        if data[offset + i] != suffix[i] {
            return false;
        }
    }
    return true;
}

/// @brief Check whether projected suffix keys match the range's final keys.
/// @ingroup algorithm_ranges
generic<T, U, DataProjection, SuffixProjection>
pub fn ends_with_projected(data: &list<T>, suffix: &list<U>,
                           data_projection: DataProjection,
                           suffix_projection: SuffixProjection) -> bool {
    let suffix_len: i64 = suffix.len();
    let data_len: i64 = data.len();
    if suffix_len > data_len { return false; }
    let offset: i64 = data_len - suffix_len;
    for i in 0..suffix_len {
        if data_projection(data[offset + i]) != suffix_projection(suffix[i]) {
            return false;
        }
    }
    return true;
}

/// @brief Return whether `suffix` matches the end of `data` using a
/// caller-provided binary predicate.
/// C++20 `std::ranges::ends_with` predicate overload.
/// @ingroup algorithm_ranges
generic<T, U, Predicate>
pub fn ends_with_by(data: &list<T>, suffix: &list<U>,
                    equivalent: Predicate) -> bool {
    let suffix_len: i64 = suffix.len();
    let data_len: i64 = data.len();
    if suffix_len > data_len {
        return false;
    }
    let offset: i64 = data_len - suffix_len;
    for i in 0..suffix_len {
        if !equivalent(data[offset + i], suffix[i]) {
            return false;
        }
    }
    return true;
}

/// @brief Check a suffix using equivalence over independent projected values.
/// Empty suffixes match; ranges may have different element types.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, DataProjection, SuffixProjection>
pub fn ends_with_by_projected(
    data: &list<T>, suffix: &list<U>, equivalent: Equivalent,
    data_projection: DataProjection, suffix_projection: SuffixProjection)
    -> bool {
    let suffix_len: i64 = suffix.len();
    let data_len: i64 = data.len();
    if suffix_len > data_len { return false; }
    let offset: i64 = data_len - suffix_len;
    for i in 0..suffix_len {
        if !equivalent(data_projection(data[offset + i]),
                       suffix_projection(suffix[i])) {
            return false;
        }
    }
    return true;
}

/// @brief Compare two lists in lexicographical order.
/// The ranges may have different, mutually order-comparable element types.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn lexicographical_compare(left: &list<T>, right: &list<U>) -> bool {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let n: i64 = left_len < right_len ? left_len : right_len;
    for i in 0..n {
        if left[i] < right[i] {
            return true;
        }
        if left[i] > right[i] {
            return false;
        }
    }
    return left_len < right_len;
}

/// @brief Compare projected keys in lexicographical order.
/// Each range has an independent projection; projected key types must be
/// mutually order-comparable.
/// @ingroup algorithm_ranges
generic<T, U, LeftProjection, RightProjection>
pub fn lexicographical_compare_projected(
    left: &list<T>, right: &list<U>,
    left_projection: LeftProjection, right_projection: RightProjection) -> bool {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let n: i64 = left_len < right_len ? left_len : right_len;
    for i in 0..n {
        let left_key = left_projection(left[i]);
        let right_key = right_projection(right[i]);
        if left_key < right_key {
            return true;
        }
        if left_key > right_key {
            return false;
        }
    }
    return left_len < right_len;
}

/// @brief Compare ranges lexicographically using the strict ordering `less`.
/// @ingroup algorithm_ranges
generic<T, U, Less>
pub fn lexicographical_compare_by(left: &list<T>, right: &list<U>, less: Less)
    -> bool {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let n: i64 = left_len < right_len ? left_len : right_len;
    for i in 0..n {
        if less(left[i], right[i]) {
            return true;
        }
        if less(right[i], left[i]) {
            return false;
        }
    }
    return left_len < right_len;
}

/// @brief Compare ranges lexicographically by projected keys and `less`.
/// Each range has an independent projection; a matching prefix sorts first.
/// @ingroup algorithm_ranges
generic<T, U, Less, LeftProjection, RightProjection>
pub fn lexicographical_compare_by_projected(
    left: &list<T>, right: &list<U>, less: Less,
    left_projection: LeftProjection, right_projection: RightProjection)
    -> bool {
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let n: i64 = left_len < right_len ? left_len : right_len;
    for i in 0..n {
        let left_key = left_projection(left[i]);
        let right_key = right_projection(right[i]);
        if less(left_key, right_key) { return true; }
        if less(right_key, left_key) { return false; }
    }
    return left_len < right_len;
}

/// @brief Return true when elements are in nondecreasing order.
/// @ingroup algorithm_ranges
generic<T>
pub fn is_sorted(data: &list<T>) -> bool {
    let n: i64 = data.len();
    if n < 2 {
        return true;
    }
    for i in 1..n {
        if data[i] < data[i - 1] {
            return false;
        }
    }
    return true;
}

/// @brief Return the first index violating sorted order, or the range length.
/// This is the index form of C++20 `std::ranges::is_sorted_until`.
/// @ingroup algorithm_ranges
generic<T>
pub fn is_sorted_until(data: &list<T>) -> i64 {
    let n: i64 = data.len();
    for i in 1..n {
        if data[i] < data[i - 1] {
            return i;
        }
    }
    return n;
}

/// @brief Find the first inversion after applying `projection`.
/// The result is the range length when projected values are sorted.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn is_sorted_until_projected(data: &list<T>, projection: Projection) -> i64 {
    let n: i64 = data.len();
    for i in 1..n {
        if projection(data[i]) < projection(data[i - 1]) {
            return i;
        }
    }
    return n;
}

/// @brief Check nondecreasing order after applying `projection`.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn is_sorted_projected(data: &list<T>, projection: Projection) -> bool {
    return is_sorted_until_projected(data, projection) == data.len();
}

/// @brief Return the first child index violating max-heap order, or range length.
/// C++20 `std::ranges::is_heap_until` equivalent.
/// @ingroup algorithm_ranges
generic<T>
pub fn is_heap_until(data: &list<T>) -> i64 {
    let n: i64 = data.len();
    for child in 1..n {
        let parent: i64 = (child - 1) / 2;
        if data[parent] < data[child] {
            return child;
        }
    }
    return n;
}

/// @brief Return whether a list satisfies max-heap order (C++20 ranges).
/// @ingroup algorithm_ranges
generic<T>
pub fn is_heap(data: &list<T>) -> bool {
    return is_heap_until(data) == data.len();
}

/// @brief Return the first child violating heap order defined by `less`.
/// A child violates the heap when its parent compares less than it.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn is_heap_until_by(data: &list<T>, less: Less) -> i64 {
    let n: i64 = data.len();
    for child in 1..n {
        let parent: i64 = (child - 1) / 2;
        if less(data[parent], data[child]) {
            return child;
        }
    }
    return n;
}

/// @brief Return whether a list satisfies heap order defined by `less`.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn is_heap_by(data: &list<T>, less: Less) -> bool {
    return is_heap_until_by(data, less) == data.len();
}

/// @brief Return the first child violating projected heap order defined by `less`.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn is_heap_until_by_projected(data: &list<T>, less: Less,
                                  projection: Projection) -> i64 {
    let n: i64 = data.len();
    for child in 1..n {
        let parent: i64 = (child - 1) / 2;
        if less(projection(data[parent]), projection(data[child])) {
            return child;
        }
    }
    return n;
}

/// @brief Check heap order defined by a comparator over projected keys.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn is_heap_by_projected(data: &list<T>, less: Less,
                            projection: Projection) -> bool {
    return is_heap_until_by_projected(data, less, projection) == data.len();
}

/// @brief Return the first child violating max-heap order after projection.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn is_heap_until_projected(data: &list<T>, projection: Projection) -> i64 {
    let n: i64 = data.len();
    for child in 1..n {
        let parent: i64 = (child - 1) / 2;
        if projection(data[parent]) < projection(data[child]) {
            return child;
        }
    }
    return n;
}

/// @brief Check max-heap order according to projected keys.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn is_heap_projected(data: &list<T>, projection: Projection) -> bool {
    return is_heap_until_projected(data, projection) == data.len();
}

generic<T>
fn heap_swap_at(data: &list<T>, first: i64, second: i64) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if i == first {
            out.push(data[second]);
        } else if i == second {
            out.push(data[first]);
        } else {
            out.push(data[i]);
        }
    }
    return out;
}

generic<T, Less>
fn heap_sift_down_by(data: &list<T>, heap_len: i64, root: i64,
                     less: Less) -> list<T> {
    var heap: list<T> = take(data, data.len());
    var parent: i64 = root;
    while parent < heap_len / 2 {
        let left: i64 = parent * 2 + 1;
        var larger: i64 = left;
        let right: i64 = left + 1;
        if right < heap_len && less(heap[left], heap[right]) {
            larger = right;
        }
        if !less(heap[parent], heap[larger]) {
            break;
        }
        heap = heap_swap_at(heap, parent, larger);
        parent = larger;
    }
    return heap;
}

generic<T, Projection>
fn heap_sift_down_projected(data: &list<T>, heap_len: i64, root: i64,
                            projection: Projection) -> list<T> {
    var heap: list<T> = take(data, data.len());
    var parent: i64 = root;
    while parent < heap_len / 2 {
        let left: i64 = parent * 2 + 1;
        var larger: i64 = left;
        let right: i64 = left + 1;
        if right < heap_len && projection(heap[left]) < projection(heap[right]) {
            larger = right;
        }
        if !(projection(heap[parent]) < projection(heap[larger])) {
            break;
        }
        heap = heap_swap_at(heap, parent, larger);
        parent = larger;
    }
    return heap;
}

generic<T, Less, Projection>
fn heap_sift_down_by_projected(data: &list<T>, heap_len: i64, root: i64,
                               less: Less, projection: Projection) -> list<T> {
    var heap: list<T> = take(data, data.len());
    var parent: i64 = root;
    while parent < heap_len / 2 {
        let left: i64 = parent * 2 + 1;
        var larger: i64 = left;
        let right: i64 = left + 1;
        if right < heap_len &&
           less(projection(heap[left]), projection(heap[right])) {
            larger = right;
        }
        if !less(projection(heap[parent]), projection(heap[larger])) {
            break;
        }
        heap = heap_swap_at(heap, parent, larger);
        parent = larger;
    }
    return heap;
}

/// @brief Return a max-heap copy of `data` (C++20 `ranges::make_heap`).
/// @ingroup algorithm_ranges
generic<T>
pub fn make_heap(data: &list<T>) -> list<T> {
    var heap: list<T> = take(data, data.len());
    var parent: i64 = heap.len() / 2;
    while parent > 0 {
        parent = parent - 1;
        var current: i64 = parent;
        while current < heap.len() / 2 {
            let left: i64 = current * 2 + 1;
            var larger: i64 = left;
            let right: i64 = left + 1;
            if right < heap.len() && heap[left] < heap[right] {
                larger = right;
            }
            if !(heap[current] < heap[larger]) {
                break;
            }
            heap = heap_swap_at(heap, current, larger);
            current = larger;
        }
    }
    return heap;
}

/// @brief Return a heap ordered by the strict comparison `less`.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn make_heap_by(data: &list<T>, less: Less) -> list<T> {
    var heap: list<T> = take(data, data.len());
    var parent: i64 = heap.len() / 2;
    while parent > 0 {
        parent = parent - 1;
        heap = heap_sift_down_by(heap, heap.len(), parent, less);
    }
    return heap;
}

/// @brief Build a max-heap according to projected keys.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn make_heap_projected(data: &list<T>, projection: Projection) -> list<T> {
    var heap: list<T> = take(data, data.len());
    var parent: i64 = heap.len() / 2;
    while parent > 0 {
        parent = parent - 1;
        heap = heap_sift_down_projected(heap, heap.len(), parent, projection);
    }
    return heap;
}

/// @brief Build a heap ordered by `less` over projected keys.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn make_heap_by_projected(data: &list<T>, less: Less,
                              projection: Projection) -> list<T> {
    var heap: list<T> = take(data, data.len());
    var parent: i64 = heap.len() / 2;
    while parent > 0 {
        parent = parent - 1;
        heap = heap_sift_down_by_projected(heap, heap.len(), parent,
                                           less, projection);
    }
    return heap;
}

/// @brief Restore heap order after appending one item to a max-heap copy.
/// The input must have a heap-ordered prefix; the last element is the new item.
/// @ingroup algorithm_ranges
generic<T>
pub fn push_heap(data: &list<T>) -> list<T> {
    var heap: list<T> = take(data, data.len());
    var child: i64 = heap.len() - 1;
    while child > 0 {
        let parent: i64 = (child - 1) / 2;
        if !(heap[parent] < heap[child]) {
            break;
        }
        heap = heap_swap_at(heap, parent, child);
        child = parent;
    }
    return heap;
}

/// @brief Restore heap order after append, using `less` for priority order.
/// The input must have a heap-ordered prefix; the last element is the new item.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn push_heap_by(data: &list<T>, less: Less) -> list<T> {
    var heap: list<T> = take(data, data.len());
    var child: i64 = heap.len() - 1;
    while child > 0 {
        let parent: i64 = (child - 1) / 2;
        if !less(heap[parent], heap[child]) {
            break;
        }
        heap = heap_swap_at(heap, parent, child);
        child = parent;
    }
    return heap;
}

/// @brief Restore projected max-heap order after appending one element.
/// The prefix before the last element must already be a projected max-heap.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn push_heap_projected(data: &list<T>, projection: Projection) -> list<T> {
    var heap: list<T> = take(data, data.len());
    var child: i64 = heap.len() - 1;
    while child > 0 {
        let parent: i64 = (child - 1) / 2;
        if !(projection(heap[parent]) < projection(heap[child])) {
            break;
        }
        heap = heap_swap_at(heap, parent, child);
        child = parent;
    }
    return heap;
}

/// @brief Restore heap order by `less` over projected keys after appending.
/// The prefix before the final element must already be a matching heap.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn push_heap_by_projected(data: &list<T>, less: Less,
                              projection: Projection) -> list<T> {
    var heap: list<T> = take(data, data.len());
    var child: i64 = heap.len() - 1;
    while child > 0 {
        let parent: i64 = (child - 1) / 2;
        if !less(projection(heap[parent]), projection(heap[child])) {
            break;
        }
        heap = heap_swap_at(heap, parent, child);
        child = parent;
    }
    return heap;
}

/// @brief Move the max element to the final slot and restore the prefix heap.
/// For an empty range this returns an empty copy; the input is unchanged.
/// @ingroup algorithm_ranges
generic<T>
pub fn pop_heap(data: &list<T>) -> list<T> {
    let n: i64 = data.len();
    var heap: list<T> = take(data, n);
    if n < 2 {
        return heap;
    }
    heap = heap_swap_at(heap, 0, n - 1);
    var parent: i64 = 0;
    let heap_len: i64 = n - 1;
    while parent < heap_len / 2 {
        let left: i64 = parent * 2 + 1;
        var larger: i64 = left;
        let right: i64 = left + 1;
        if right < heap_len && heap[left] < heap[right] {
            larger = right;
        }
        if !(heap[parent] < heap[larger]) {
            break;
        }
        heap = heap_swap_at(heap, parent, larger);
        parent = larger;
    }
    return heap;
}

/// @brief Pop from a heap ordered by `less`, placing its top at the end.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn pop_heap_by(data: &list<T>, less: Less) -> list<T> {
    let n: i64 = data.len();
    var heap: list<T> = take(data, n);
    if n < 2 {
        return heap;
    }
    heap = heap_swap_at(heap, 0, n - 1);
    return heap_sift_down_by(heap, n - 1, 0, less);
}

/// @brief Move the projected maximum to the last slot and restore the prefix.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn pop_heap_projected(data: &list<T>, projection: Projection) -> list<T> {
    let n: i64 = data.len();
    var heap: list<T> = take(data, n);
    if n < 2 {
        return heap;
    }
    heap = heap_swap_at(heap, 0, n - 1);
    return heap_sift_down_projected(heap, n - 1, 0, projection);
}

/// @brief Move the top value to the end and restore projected comparator order.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn pop_heap_by_projected(data: &list<T>, less: Less,
                             projection: Projection) -> list<T> {
    let n: i64 = data.len();
    var heap: list<T> = take(data, n);
    if n < 2 { return heap; }
    heap = heap_swap_at(heap, 0, n - 1);
    return heap_sift_down_by_projected(heap, n - 1, 0, less, projection);
}

/// @brief Return an ascending copy sorted from a max-heap.
/// The input must satisfy max-heap order; inputs are not modified.
/// @ingroup algorithm_ranges
generic<T>
pub fn sort_heap(data: &list<T>) -> list<T> {
    return sorted(data);
}

/// @brief Return a copy sorted by `less` from a heap using that ordering.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn sort_heap_by(data: &list<T>, less: Less) -> list<T> {
    return sorted_by(data, less);
}

/// @brief Return elements from a projected max-heap in ascending key order.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn sort_heap_projected(data: &list<T>, projection: Projection) -> list<T> {
    return sorted_projected(data, projection);
}

/// @brief Return heap values sorted by `less` over projected keys.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn sort_heap_by_projected(data: &list<T>, less: Less,
                              projection: Projection) -> list<T> {
    return sorted_by_projected(data, less, projection);
}

/// @brief Return the smallest `count` elements in ascending order.
/// The count is clamped to `[0, data.len()]`; the input is unchanged.
/// C++20 `std::ranges::partial_sort` eager-list counterpart.
/// @ingroup algorithm_ranges
generic<T>
pub fn partial_sort(data: &list<T>, count: i64) -> list<T> {
    var limit: i64 = count;
    let n: i64 = data.len();
    if limit < 0 { limit = 0; }
    if limit > n { limit = n; }
    if limit == 0 { return []; }

    var initial: list<T> = take(data, limit);
    var heap: list<T> = make_heap(initial);
    for i in limit..n {
        if data[i] < heap[0] {
            let popped: list<T> = pop_heap(heap);
            var prefix: list<T> = take(popped, limit - 1);
            prefix.push(data[i]);
            heap = push_heap(prefix);
        }
    }
    return sort_heap(heap);
}

/// @brief Return the first `count` values according to the ordering `less`.
/// The retained prefix is sorted; counts clamp to `[0, data.len()]` and the
/// input is unchanged. Equivalent values retain heap-algorithm ordering.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn partial_sort_by(data: &list<T>, count: i64, less: Less) -> list<T> {
    var limit: i64 = count;
    let n: i64 = data.len();
    if limit < 0 { limit = 0; }
    if limit > n { limit = n; }
    if limit == 0 { return []; }

    var initial: list<T> = take(data, limit);
    var heap: list<T> = make_heap_by(initial, less);
    for i in limit..n {
        if less(data[i], heap[0]) {
            let popped: list<T> = pop_heap_by(heap, less);
            var prefix: list<T> = take(popped, limit - 1);
            prefix.push(data[i]);
            heap = push_heap_by(prefix, less);
        }
    }
    return sort_heap_by(heap, less);
}

/// @brief Return the first `count` values ordered by their projected keys.
/// The selected prefix is sorted; count is clamped to the range bounds and
/// the input is unchanged. This mirrors C++20 ranges partial sorting with a
/// projection and preserves the bounded-heap behavior of `partial_sort_by`.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn partial_sort_projected(data: &list<T>, count: i64,
                              projection: Projection) -> list<T> {
    var limit: i64 = count;
    let n: i64 = data.len();
    if limit < 0 { limit = 0; }
    if limit > n { limit = n; }
    if limit == 0 { return []; }

    let initial: list<T> = take(data, limit);
    var heap: list<T> = make_heap_projected(initial, projection);
    for i in limit..n {
        if projection(data[i]) < projection(heap[0]) {
            let popped: list<T> = pop_heap_projected(heap, projection);
            var prefix: list<T> = take(popped, limit - 1);
            prefix.push(data[i]);
            heap = push_heap_projected(prefix, projection);
        }
    }
    return sort_heap_projected(heap, projection);
}

/// @brief Select and sort a prefix using a comparator over projected keys.
/// Counts clamp to `[0, data.len()]`; the input list remains unchanged.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn partial_sort_by_projected(data: &list<T>, count: i64, less: Less,
                                 projection: Projection) -> list<T> {
    var limit: i64 = count;
    let n: i64 = data.len();
    if limit < 0 { limit = 0; }
    if limit > n { limit = n; }
    if limit == 0 { return []; }

    let initial: list<T> = take(data, limit);
    var heap: list<T> = make_heap_by_projected(initial, less, projection);
    for i in limit..n {
        if less(projection(data[i]), projection(heap[0])) {
            let popped: list<T> = pop_heap_by_projected(heap, less,
                                                         projection);
            var prefix: list<T> = take(popped, limit - 1);
            prefix.push(data[i]);
            heap = push_heap_by_projected(prefix, less, projection);
        }
    }
    return sort_heap_by_projected(heap, less, projection);
}

/// @brief Sort up to `output_capacity` selected values into a new list.
/// This is the eager-list C++20 `std::ranges::partial_sort_copy` counterpart:
/// the capacity stands for the destination range length, and the source stays
/// unchanged.
/// @ingroup algorithm_ranges
generic<T>
pub fn partial_sort_copy(data: &list<T>, output_capacity: i64) -> list<T> {
    return partial_sort(data, output_capacity);
}

/// @brief Sort up to `output_capacity` values by projected keys.
/// The input is unchanged; capacity is clamped to the source length.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn partial_sort_copy_projected(data: &list<T>, output_capacity: i64,
                                   projection: Projection) -> list<T> {
    return partial_sort_projected(data, output_capacity, projection);
}

/// @brief Comparator form of `partial_sort_copy`.
/// Selects the first values according to `less` and returns them sorted.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn partial_sort_copy_by(data: &list<T>, output_capacity: i64,
                            less: Less) -> list<T> {
    return partial_sort_by(data, output_capacity, less);
}

/// @brief Comparator-and-projection form of `partial_sort_copy`.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn partial_sort_copy_by_projected(data: &list<T>, output_capacity: i64,
                                      less: Less,
                                      projection: Projection) -> list<T> {
    return partial_sort_by_projected(data, output_capacity, less, projection);
}

generic<T, Less>
fn nth_element_impl_by(data: &list<T>, nth: i64, less: Less) -> list<T> {
    let n: i64 = data.len();
    if nth < 0 || nth >= n { return []; }
    if n < 2 {
        return take(data, n);
    }

    let pivot: T = data[n / 2];
    var lower: list<T> = [];
    var equal: list<T> = [];
    var upper: list<T> = [];
    for i in 0..n {
        let value: T = data[i];
        if less(value, pivot) {
            lower.push(value);
        } else if less(pivot, value) {
            upper.push(value);
        } else {
            equal.push(value);
        }
    }

    let lower_len: i64 = lower.len();
    let equal_len: i64 = equal.len();
    var result: list<T> = [];
    if nth < lower_len {
        result = nth_element_impl_by(lower, nth, less);
        for i in 0..equal_len { result.push(equal[i]); }
        for i in 0..upper.len() { result.push(upper[i]); }
        return result;
    }
    if nth >= lower_len + equal_len {
        for i in 0..lower_len { result.push(lower[i]); }
        for i in 0..equal_len { result.push(equal[i]); }
        let selected_values: list<T> =
            nth_element_impl_by(upper, nth - lower_len - equal_len, less);
        for i in 0..selected_values.len() { result.push(selected_values[i]); }
        return result;
    }

    for i in 0..lower_len { result.push(lower[i]); }
    for i in 0..equal_len { result.push(equal[i]); }
    for i in 0..upper.len() { result.push(upper[i]); }
    return result;
}

generic<T>
fn nth_element_impl(data: &list<T>, nth: i64) -> list<T> {
    let n: i64 = data.len();
    if nth < 0 || nth >= n { return []; }
    if n < 2 { return take(data, n); }

    let pivot: T = data[n / 2];
    var lower: list<T> = [];
    var equal: list<T> = [];
    var upper: list<T> = [];
    for i in 0..n {
        let value: T = data[i];
        if value < pivot {
            lower.push(value);
        } else if pivot < value {
            upper.push(value);
        } else {
            equal.push(value);
        }
    }

    let lower_len: i64 = lower.len();
    let equal_len: i64 = equal.len();
    var result: list<T> = [];
    if nth < lower_len {
        result = nth_element_impl(lower, nth);
        for i in 0..equal_len { result.push(equal[i]); }
        for i in 0..upper.len() { result.push(upper[i]); }
        return result;
    }
    if nth >= lower_len + equal_len {
        for i in 0..lower_len { result.push(lower[i]); }
        for i in 0..equal_len { result.push(equal[i]); }
        let selected: list<T> = nth_element_impl(upper, nth - lower_len - equal_len);
        for i in 0..selected.len() { result.push(selected[i]); }
        return result;
    }
    for i in 0..lower_len { result.push(lower[i]); }
    for i in 0..equal_len { result.push(equal[i]); }
    for i in 0..upper.len() { result.push(upper[i]); }
    return result;
}

generic<T, Projection>
fn nth_element_impl_projected(data: &list<T>, nth: i64,
                              projection: Projection) -> list<T> {
    let n: i64 = data.len();
    if nth < 0 || nth >= n { return []; }
    if n < 2 { return take(data, n); }

    let pivot: T = data[n / 2];
    var lower: list<T> = [];
    var equal: list<T> = [];
    var upper: list<T> = [];
    for i in 0..n {
        let value: T = data[i];
        if projection(value) < projection(pivot) {
            lower.push(value);
        } else if projection(pivot) < projection(value) {
            upper.push(value);
        } else {
            equal.push(value);
        }
    }

    let lower_len: i64 = lower.len();
    let equal_len: i64 = equal.len();
    var result: list<T> = [];
    if nth < lower_len {
        result = nth_element_impl_projected(lower, nth, projection);
        for i in 0..equal_len { result.push(equal[i]); }
        for i in 0..upper.len() { result.push(upper[i]); }
        return result;
    }
    if nth >= lower_len + equal_len {
        for i in 0..lower_len { result.push(lower[i]); }
        for i in 0..equal_len { result.push(equal[i]); }
        let selected: list<T> = nth_element_impl_projected(
            upper, nth - lower_len - equal_len, projection);
        for i in 0..selected.len() { result.push(selected[i]); }
        return result;
    }
    for i in 0..lower_len { result.push(lower[i]); }
    for i in 0..equal_len { result.push(equal[i]); }
    for i in 0..upper.len() { result.push(upper[i]); }
    return result;
}

generic<T, Less, Projection>
fn nth_element_impl_by_projected(data: &list<T>, nth: i64, less: Less,
                                 projection: Projection) -> list<T> {
    let n: i64 = data.len();
    if nth < 0 || nth >= n { return []; }
    if n < 2 { return take(data, n); }

    let pivot: T = data[n / 2];
    var lower: list<T> = [];
    var equal: list<T> = [];
    var upper: list<T> = [];
    for i in 0..n {
        let value: T = data[i];
        let value_key = projection(value);
        let pivot_key = projection(pivot);
        if less(value_key, pivot_key) {
            lower.push(value);
        } else if less(pivot_key, value_key) {
            upper.push(value);
        } else {
            equal.push(value);
        }
    }

    let lower_len: i64 = lower.len();
    let equal_len: i64 = equal.len();
    var result: list<T> = [];
    if nth < lower_len {
        result = nth_element_impl_by_projected(lower, nth, less, projection);
        for i in 0..equal_len { result.push(equal[i]); }
        for i in 0..upper.len() { result.push(upper[i]); }
        return result;
    }
    if nth >= lower_len + equal_len {
        for i in 0..lower_len { result.push(lower[i]); }
        for i in 0..equal_len { result.push(equal[i]); }
        let selected: list<T> = nth_element_impl_by_projected(
            upper, nth - lower_len - equal_len, less, projection);
        for i in 0..selected.len() { result.push(selected[i]); }
        return result;
    }
    for i in 0..lower_len { result.push(lower[i]); }
    for i in 0..equal_len { result.push(equal[i]); }
    for i in 0..upper.len() { result.push(upper[i]); }
    return result;
}

/// @brief Reorder a copied range around its `nth` element.
/// Values before it are no greater and values after it are no smaller; neither
/// side is otherwise sorted. Invalid indices return an empty list. This
/// eager-list algorithm is the C++20 `std::ranges::nth_element` counterpart.
/// @ingroup algorithm_ranges
generic<T>
pub fn nth_element(data: &list<T>, nth: i64) -> list<T> {
    return nth_element_impl(data, nth);
}

/// @brief Comparator-based `nth_element`; invalid indices return an empty list.
/// `less` defines the order and partitions the result around the selected value.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn nth_element_by(data: &list<T>, nth: i64, less: Less)
    -> list<T> {
    return nth_element_impl_by(data, nth, less);
}

/// @brief Partition a copied range around the `nth` projected key.
/// Items before it have no greater key and items after it have no smaller key;
/// neither side is otherwise sorted. Invalid indices return an empty list.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn nth_element_projected(data: &list<T>, nth: i64,
                             projection: Projection) -> list<T> {
    return nth_element_impl_projected(data, nth, projection);
}

/// @brief Partition a copied range using a comparator over projected keys.
/// Invalid indices return an empty list; neither side is otherwise sorted.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn nth_element_by_projected(data: &list<T>, nth: i64, less: Less,
                                projection: Projection) -> list<T> {
    return nth_element_impl_by_projected(data, nth, less, projection);
}

/// @brief First index where `value` can be inserted without breaking order.
/// Requires nondecreasing input; returns `data.len()` when value is too large.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn lower_bound(data: &list<T>, value: U) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = data.len();
    while lo < hi {
        let mid: i64 = lo + (hi - lo) / 2;
        if data[mid] < value {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

/// @brief Projected lower bound for a range sorted by projected values.
/// @ingroup algorithm_ranges
generic<T, U, Projection>
pub fn lower_bound_projected(data: &list<T>, value: U, projection: Projection) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = data.len();
    while lo < hi {
        let mid: i64 = lo + (hi - lo) / 2;
        if projection(data[mid]) < value {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

/// @brief First index where `value` would be inserted after equal elements.
/// Requires nondecreasing input; returns `data.len()` when value is too large.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn upper_bound(data: &list<T>, value: U) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = data.len();
    while lo < hi {
        let mid: i64 = lo + (hi - lo) / 2;
        if value < data[mid] {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    return lo;
}

/// @brief Projected upper bound for a range sorted by projected values.
/// @ingroup algorithm_ranges
generic<T, U, Projection>
pub fn upper_bound_projected(data: &list<T>, value: U, projection: Projection) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = data.len();
    while lo < hi {
        let mid: i64 = lo + (hi - lo) / 2;
        if value < projection(data[mid]) {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    return lo;
}

/// @brief Return the half-open index range containing equivalent values.
/// Requires nondecreasing input. The result is `(lower_bound, upper_bound)`.
/// C++20 `std::ranges::equal_range` equivalent.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn equal_range(data: &list<T>, value: U) -> tuple<i64, i64> {
    let first: i64 = lower_bound(data, value);
    let last: i64 = upper_bound(data, value);
    return (first, last);
}

/// @brief Return the projected half-open matching index range.
/// Requires projected values sorted in nondecreasing order.
/// @ingroup algorithm_ranges
generic<T, U, Projection>
pub fn equal_range_projected(data: &list<T>, value: U, projection: Projection)
    -> tuple<i64, i64> {
    let first: i64 = lower_bound_projected(data, value, projection);
    let last: i64 = upper_bound_projected(data, value, projection);
    return (first, last);
}

/// @brief Return whether a sorted list contains `value`.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn binary_search(data: &list<T>, value: U) -> bool {
    let position: i64 = lower_bound(data, value);
    if position >= data.len() {
        return false;
    }
    return data[position] == value;
}

/// @brief Check whether a projected value occurs in a sorted range.
/// @ingroup algorithm_ranges
generic<T, U, Projection>
pub fn binary_search_projected(data: &list<T>, value: U, projection: Projection)
    -> bool {
    let position: i64 = lower_bound_projected(data, value, projection);
    if position >= data.len() {
        return false;
    }
    let projected: U = projection(data[position]);
    return projected == value;
}

/// @brief Comparator-and-projection lower bound for an ordered range.
/// `less` receives projected element keys and the lookup value.
/// @ingroup algorithm_ranges
generic<T, U, Less, Projection>
pub fn lower_bound_by_projected(data: &list<T>, value: U, less: Less,
                                projection: Projection) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = data.len();
    while lo < hi {
        let mid: i64 = lo + (hi - lo) / 2;
        if less(projection(data[mid]), value) { lo = mid + 1; }
        else { hi = mid; }
    }
    return lo;
}

/// @brief Comparator-and-projection upper bound for an ordered range.
/// `less` receives the lookup value and projected element keys.
/// @ingroup algorithm_ranges
generic<T, U, Less, Projection>
pub fn upper_bound_by_projected(data: &list<T>, value: U, less: Less,
                                projection: Projection) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = data.len();
    while lo < hi {
        let mid: i64 = lo + (hi - lo) / 2;
        if less(value, projection(data[mid])) { hi = mid; }
        else { lo = mid + 1; }
    }
    return lo;
}

/// @brief Return the comparator-and-projection matching half-open range.
/// @ingroup algorithm_ranges
generic<T, U, Less, Projection>
pub fn equal_range_by_projected(data: &list<T>, value: U, less: Less,
                                projection: Projection) -> tuple<i64, i64> {
    let first: i64 = lower_bound_by_projected(data, value, less, projection);
    let last: i64 = upper_bound_by_projected(data, value, less, projection);
    return (first, last);
}

/// @brief Search for a value using comparator-and-projection ordering.
/// @ingroup algorithm_ranges
generic<T, U, Less, Projection>
pub fn binary_search_by_projected(data: &list<T>, value: U, less: Less,
                                  projection: Projection) -> bool {
    let position: i64 = lower_bound_by_projected(
        data, value, less, projection);
    if position >= data.len() { return false; }
    let key = projection(data[position]);
    return !less(key, value) && !less(value, key);
}

/// @brief Check sorted order using `less` as the strict ordering comparator.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn is_sorted_by(data: &list<T>, less: Less) -> bool {
    let n: i64 = data.len();
    for i in 1..n {
        if less(data[i], data[i - 1]) {
            return false;
        }
    }
    return true;
}

/// @brief Return the first index violating comparator order, or range length.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn is_sorted_until_by(data: &list<T>, less: Less) -> i64 {
    let n: i64 = data.len();
    for i in 1..n {
        if less(data[i], data[i - 1]) {
            return i;
        }
    }
    return n;
}

/// @brief Check comparator order on projected keys.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn is_sorted_by_projected(data: &list<T>, less: Less,
                              projection: Projection) -> bool {
    let n: i64 = data.len();
    for i in 1..n {
        if less(projection(data[i]), projection(data[i - 1])) {
            return false;
        }
    }
    return true;
}

/// @brief Return the first projected comparator-order violation, or length.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn is_sorted_until_by_projected(data: &list<T>, less: Less,
                                   projection: Projection) -> i64 {
    let n: i64 = data.len();
    for i in 1..n {
        if less(projection(data[i]), projection(data[i - 1])) { return i; }
    }
    return n;
}

/// @brief Comparator-based lower bound for a range sorted by `less`.
/// @ingroup algorithm_ranges
generic<T, U, Less>
pub fn lower_bound_by(data: &list<T>, value: U, less: Less) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = data.len();
    while lo < hi {
        let mid: i64 = lo + (hi - lo) / 2;
        if less(data[mid], value) {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

/// @brief Comparator-based upper bound for a range sorted by `less`.
/// @ingroup algorithm_ranges
generic<T, U, Less>
pub fn upper_bound_by(data: &list<T>, value: U, less: Less) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = data.len();
    while lo < hi {
        let mid: i64 = lo + (hi - lo) / 2;
        if less(value, data[mid]) {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    return lo;
}

/// @brief Return the equivalent-value index range under `less`.
/// Requires input sorted according to the same strict ordering.
/// @ingroup algorithm_ranges
generic<T, U, Less>
pub fn equal_range_by(data: &list<T>, value: U, less: Less) -> tuple<i64, i64> {
    let first: i64 = lower_bound_by(data, value, less);
    let last: i64 = upper_bound_by(data, value, less);
    return (first, last);
}

/// @brief Check whether a comparator-sorted range contains `value`.
/// @ingroup algorithm_ranges
generic<T, U, Less>
pub fn binary_search_by(data: &list<T>, value: U, less: Less) -> bool {
    var lo: i64 = 0;
    var hi: i64 = data.len();
    while lo < hi {
        let mid: i64 = lo + (hi - lo) / 2;
        if less(data[mid], value) {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo >= data.len() {
        return false;
    }
    return !less(data[lo], value) && !less(value, data[lo]);
}

/// @brief Return the index of the smallest element, or -1 for an empty list.
/// @ingroup algorithm_ranges
generic<T>
pub fn min_element_index(data: &list<T>) -> i64 {
    let n: i64 = data.len();
    if n == 0 {
        return -1;
    }
    var best: i64 = 0;
    for i in 1..n {
        if data[i] < data[best] {
            best = i;
        }
    }
    return best;
}

/// @brief Return the index of the largest element, or -1 for an empty list.
/// @ingroup algorithm_ranges
generic<T>
pub fn max_element_index(data: &list<T>) -> i64 {
    let n: i64 = data.len();
    if n == 0 {
        return -1;
    }
    var best: i64 = 0;
    for i in 1..n {
        if data[i] > data[best] {
            best = i;
        }
    }
    return best;
}

/// @brief Return the first minimum and last maximum indices in one pass.
/// Empty input returns `(-1, -1)`, matching C++20 `std::ranges::minmax_element`
/// with index sentinels instead of iterators.
/// @ingroup algorithm_ranges
generic<T>
pub fn minmax_element_index(data: &list<T>) -> tuple<i64, i64> {
    let n: i64 = data.len();
    if n == 0 {
        return (-1, -1);
    }
    var minimum: i64 = 0;
    var maximum: i64 = 0;
    for i in 1..n {
        if data[i] < data[minimum] {
            minimum = i;
        }
        if !(data[i] < data[maximum]) {
            maximum = i;
        }
    }
    return (minimum, maximum);
}

/// @brief Return the smallest element of a nonempty range.
/// Use `min_element_index` to handle an empty range without a precondition.
/// @ingroup algorithm_ranges
generic<T>
pub fn min_element_value(data: &list<T>) -> T {
    let n: i64 = data.len();
    var best: T = data[0];
    for i in 1..n {
        if data[i] < best {
            best = data[i];
        }
    }
    return best;
}

/// @brief Return the largest element of a nonempty range.
/// Use `max_element_index` to handle an empty range without a precondition.
/// @ingroup algorithm_ranges
generic<T>
pub fn max_element_value(data: &list<T>) -> T {
    let n: i64 = data.len();
    var best: T = data[0];
    for i in 1..n {
        if data[i] > best {
            best = data[i];
        }
    }
    return best;
}

/// @brief Return the minimum and maximum values in one traversal.
/// Requires a nonempty input; use `minmax_element_index` to handle emptiness.
/// The minimum is the first equivalent value and maximum the last, matching
/// C++20 `std::ranges::minmax_element` tie behavior.
/// @ingroup algorithm_ranges
generic<T>
pub fn minmax_element_value(data: &list<T>) -> tuple<T, T> {
    var minimum: T = data[0];
    var maximum: T = data[0];
    let n: i64 = data.len();
    for i in 1..n {
        let value: T = data[i];
        if value < minimum {
            minimum = value;
        }
        if !(value < maximum) {
            maximum = value;
        }
    }
    return (minimum, maximum);
}

/// @brief Return the first minimum index under `less`, or -1 if empty.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn min_element_index_by(data: &list<T>, less: Less) -> i64 {
    let n: i64 = data.len();
    if n == 0 {
        return -1;
    }
    var best: i64 = 0;
    for i in 1..n {
        if less(data[i], data[best]) {
            best = i;
        }
    }
    return best;
}

/// @brief Return the first maximum index under `less`, or -1 if empty.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn max_element_index_by(data: &list<T>, less: Less) -> i64 {
    let n: i64 = data.len();
    if n == 0 {
        return -1;
    }
    var best: i64 = 0;
    for i in 1..n {
        if less(data[best], data[i]) {
            best = i;
        }
    }
    return best;
}

/// @brief Return the first minimum and last maximum indices under `less`.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn minmax_element_index_by(data: &list<T>, less: Less)
    -> tuple<i64, i64> {
    let n: i64 = data.len();
    if n == 0 {
        return (-1, -1);
    }
    var minimum: i64 = 0;
    var maximum: i64 = 0;
    for i in 1..n {
        if less(data[i], data[minimum]) {
            minimum = i;
        }
        if !less(data[i], data[maximum]) {
            maximum = i;
        }
    }
    return (minimum, maximum);
}

/// @brief Return the first minimum value under `less`; requires nonempty input.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn min_element_value_by(data: &list<T>, less: Less) -> T {
    var best: T = data[0];
    let n: i64 = data.len();
    for i in 1..n {
        if less(data[i], best) {
            best = data[i];
        }
    }
    return best;
}

/// @brief Return the first maximum value under `less`; requires nonempty input.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn max_element_value_by(data: &list<T>, less: Less) -> T {
    var best: T = data[0];
    let n: i64 = data.len();
    for i in 1..n {
        if less(best, data[i]) {
            best = data[i];
        }
    }
    return best;
}

/// @brief Return minimum and maximum values under `less` in one traversal.
/// Requires a nonempty input; minimum is first-equivalent and maximum is
/// last-equivalent, matching C++20 `std::ranges::minmax_element`.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn minmax_element_value_by(data: &list<T>, less: Less)
    -> tuple<T, T> {
    var minimum: T = data[0];
    var maximum: T = data[0];
    let n: i64 = data.len();
    for i in 1..n {
        let value: T = data[i];
        if less(value, minimum) {
            minimum = value;
        }
        if !less(value, maximum) {
            maximum = value;
        }
    }
    return (minimum, maximum);
}

/// @brief Return the first minimum index under projected-key ordering.
/// Returns -1 for an empty range.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn min_element_index_projected(data: &list<T>,
                                   projection: Projection) -> i64 {
    let n: i64 = data.len();
    if n == 0 { return -1; }
    var best: i64 = 0;
    for i in 1..n {
        if projection(data[i]) < projection(data[best]) { best = i; }
    }
    return best;
}

/// @brief Return the first maximum index under projected-key ordering.
/// Returns -1 for an empty range.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn max_element_index_projected(data: &list<T>,
                                   projection: Projection) -> i64 {
    let n: i64 = data.len();
    if n == 0 { return -1; }
    var best: i64 = 0;
    for i in 1..n {
        if projection(data[best]) < projection(data[i]) { best = i; }
    }
    return best;
}

/// @brief Return first-minimum and last-maximum indices by projected keys.
/// Empty input returns `(-1, -1)`.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn minmax_element_index_projected(data: &list<T>,
                                      projection: Projection)
    -> tuple<i64, i64> {
    let n: i64 = data.len();
    if n == 0 { return (-1, -1); }
    var minimum: i64 = 0;
    var maximum: i64 = 0;
    for i in 1..n {
        if projection(data[i]) < projection(data[minimum]) { minimum = i; }
        if !(projection(data[i]) < projection(data[maximum])) { maximum = i; }
    }
    return (minimum, maximum);
}

/// @brief Return the first value with a minimum projected key.
/// Requires a nonempty input.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn min_element_value_projected(data: &list<T>,
                                  projection: Projection) -> T {
    var best: T = data[0];
    let n: i64 = data.len();
    for i in 1..n {
        if projection(data[i]) < projection(best) { best = data[i]; }
    }
    return best;
}

/// @brief Return the first value with a maximum projected key.
/// Requires a nonempty input.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn max_element_value_projected(data: &list<T>,
                                  projection: Projection) -> T {
    var best: T = data[0];
    let n: i64 = data.len();
    for i in 1..n {
        if projection(best) < projection(data[i]) { best = data[i]; }
    }
    return best;
}

/// @brief Return first-minimum and last-maximum values by projected keys.
/// Requires nonempty input, matching C++20 ranges minmax tie behavior.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn minmax_element_value_projected(data: &list<T>,
                                      projection: Projection)
    -> tuple<T, T> {
    var minimum: T = data[0];
    var maximum: T = data[0];
    let n: i64 = data.len();
    for i in 1..n {
        let value: T = data[i];
        if projection(value) < projection(minimum) { minimum = value; }
        if !(projection(value) < projection(maximum)) { maximum = value; }
    }
    return (minimum, maximum);
}

/// @brief Return the first minimum index under comparator-projected ordering.
/// Returns -1 for an empty range.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn min_element_index_by_projected(data: &list<T>, less: Less,
                                      projection: Projection) -> i64 {
    let n: i64 = data.len();
    if n == 0 { return -1; }
    var best: i64 = 0;
    for i in 1..n {
        if less(projection(data[i]), projection(data[best])) { best = i; }
    }
    return best;
}

/// @brief Return the first maximum index under comparator-projected ordering.
/// Returns -1 for an empty range.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn max_element_index_by_projected(data: &list<T>, less: Less,
                                      projection: Projection) -> i64 {
    let n: i64 = data.len();
    if n == 0 { return -1; }
    var best: i64 = 0;
    for i in 1..n {
        if less(projection(data[best]), projection(data[i])) { best = i; }
    }
    return best;
}

/// @brief Return first-minimum and last-maximum indices under projected order.
/// Empty input returns `(-1, -1)`.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn minmax_element_index_by_projected(data: &list<T>, less: Less,
                                         projection: Projection)
    -> tuple<i64, i64> {
    let n: i64 = data.len();
    if n == 0 { return (-1, -1); }
    var minimum: i64 = 0;
    var maximum: i64 = 0;
    for i in 1..n {
        if less(projection(data[i]), projection(data[minimum])) {
            minimum = i;
        }
        if !less(projection(data[i]), projection(data[maximum])) {
            maximum = i;
        }
    }
    return (minimum, maximum);
}

/// @brief Return the first value with a minimum comparator-projected key.
/// Requires a nonempty input.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn min_element_value_by_projected(data: &list<T>, less: Less,
                                      projection: Projection) -> T {
    var best: T = data[0];
    let n: i64 = data.len();
    for i in 1..n {
        if less(projection(data[i]), projection(best)) { best = data[i]; }
    }
    return best;
}

/// @brief Return the first value with a maximum comparator-projected key.
/// Requires a nonempty input.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn max_element_value_by_projected(data: &list<T>, less: Less,
                                      projection: Projection) -> T {
    var best: T = data[0];
    let n: i64 = data.len();
    for i in 1..n {
        if less(projection(best), projection(data[i])) { best = data[i]; }
    }
    return best;
}

/// @brief Return first-minimum and last-maximum values under projected order.
/// Requires a nonempty input.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn minmax_element_value_by_projected(data: &list<T>, less: Less,
                                         projection: Projection)
    -> tuple<T, T> {
    var minimum: T = data[0];
    var maximum: T = data[0];
    let n: i64 = data.len();
    for i in 1..n {
        let value: T = data[i];
        if less(projection(value), projection(minimum)) { minimum = value; }
        if !less(projection(value), projection(maximum)) { maximum = value; }
    }
    return (minimum, maximum);
}

/// @brief Return count of elements equal to value.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn count(data: &list<T>, value: U) -> i64 {
    var out: i64 = 0;
    let n: i64 = data.len();
    for i in 0..n {
        if data[i] == value {
            out = out + 1;
        }
    }
    return out;
}

/// @brief Count elements equivalent to `value` under `equivalent`.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn count_by(data: &list<T>, value: U, equivalent: Equivalent) -> i64 {
    var out: i64 = 0;
    let n: i64 = data.len();
    for i in 0..n {
        if equivalent(data[i], value) { out = out + 1; }
    }
    return out;
}

/// @brief Count projected element keys equivalent to `value`.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, Projection>
pub fn count_by_projected(data: &list<T>, value: U, equivalent: Equivalent,
                          projection: Projection) -> i64 {
    var out: i64 = 0;
    let n: i64 = data.len();
    for i in 0..n {
        if equivalent(projection(data[i]), value) { out = out + 1; }
    }
    return out;
}

/// @brief Count elements whose projected value equals `value`.
/// @ingroup algorithm_ranges
generic<T, U, Projection>
pub fn count_projected(data: &list<T>, value: U, projection: Projection) -> i64 {
    var count: i64 = 0;
    let n: i64 = data.len();
    for i in 0..n {
        if projection(data[i]) == value {
            count = count + 1;
        }
    }
    return count;
}

/// @brief Return true when value exists in the list.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn contains(data: &list<T>, value: U) -> bool {
    return find(data, value) >= 0;
}

/// @brief Test whether any element is equivalent to `value`.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn contains_by(data: &list<T>, value: U, equivalent: Equivalent) -> bool {
    return find_by(data, value, equivalent) >= 0;
}

/// @brief Test whether any projected element key matches `value` by equivalence.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, Projection>
pub fn contains_by_projected(data: &list<T>, value: U,
                             equivalent: Equivalent,
                             projection: Projection) -> bool {
    return find_by_projected(data, value, equivalent, projection) >= 0;
}

/// @brief Test whether any element's projected value equals `value`.
/// @ingroup algorithm_ranges
generic<T, U, Projection>
pub fn contains_projected(data: &list<T>, value: U, projection: Projection) -> bool {
    return find_projected(data, value, projection) >= 0;
}

/// @brief Copy a list while excluding values equal to `value`.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn remove(data: &list<T>, value: U) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let item: T = data[i];
        if item != value {
            out.push(item);
        }
    }
    return out;
}

/// @brief Copy a list, excluding values equivalent under `equivalent`.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent>
pub fn remove_by(data: &list<T>, value: U, equivalent: Equivalent) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let item: T = data[i];
        if !equivalent(item, value) { out.push(item); }
    }
    return out;
}

/// @brief Copy a list excluding projected keys equivalent to `value`.
/// @ingroup algorithm_ranges
generic<T, U, Equivalent, Projection>
pub fn remove_by_projected(data: &list<T>, value: U, equivalent: Equivalent,
                           projection: Projection) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let item: T = data[i];
        if !equivalent(projection(item), value) { out.push(item); }
    }
    return out;
}

/// @brief Copy a list while excluding elements with projected key `value`.
/// @ingroup algorithm_ranges
generic<T, U, Projection>
pub fn remove_projected(data: &list<T>, value: U,
                        projection: Projection) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if projection(data[i]) != value { out.push(data[i]); }
    }
    return out;
}

/// @brief Copy the first `n` elements (or all elements when n is larger).
/// @ingroup algorithm_ranges
generic<T>
pub fn take(data: &list<T>, n: i64) -> list<T> {
    var out: list<T> = [];
    if n <= 0 {
        return out;
    }
    let len: i64 = data.len();
    let end: i64 = n < len ? n : len;
    for i in 0..end {
        out.push(data[i]);
    }
    return out;
}

/// @brief Copy the initial prefix accepted by `predicate`.
/// Eager C++20 `views::take_while` equivalent.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn take_while(data: &list<T>, predicate: Predicate) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if !predicate(data[i]) {
            break;
        }
        out.push(data[i]);
    }
    return out;
}

/// @brief Copy the initial prefix whose projected keys satisfy `predicate`.
/// The output preserves original elements, not their projected keys.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn take_while_projected(data: &list<T>, predicate: Predicate,
                            projection: Projection) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if !predicate(projection(data[i])) { break; }
        out.push(data[i]);
    }
    return out;
}

/// @brief Materialize the integers in the half-open interval `[start, end)`.
/// This is an eager list counterpart to C++20 `std::views::iota`.
/// If `start >= end`, the result is empty.
/// @ingroup algorithm_ranges
pub fn iota(start: i64, end: i64) -> list<i64> {
    var out: list<i64> = [];
    if start >= end {
        return out;
    }
    for value in start..end {
        out.push(value);
    }
    return out;
}

/// @brief Materialize a half-open increasing range while preserving its type.
/// This is the typed counterpart to `iota(start: i64, end: i64)` and mirrors
/// C++20 `std::ranges::iota_view` for element types supporting comparison and
/// addition with one.
/// @ingroup algorithm_ranges
generic<T>
pub fn iota_range(start: T, end: T) -> list<T> {
    var out: list<T> = [];
    var value: T = start;
    while value < end {
        out.push(value);
        value = value + 1;
    }
    return out;
}

/// @brief Materialize a typed half-open progression using `step`.
/// Positive and negative steps follow the direction of the bounds. A zero
/// step, a step directed away from the bound, or arithmetic that stops making
/// progress yields an empty or safely terminated list.
/// @ingroup algorithm_ranges
generic<T>
pub fn iota_range_by(start: T, end: T, step: T) -> list<T> {
    var out: list<T> = [];
    if step == 0 {
        return out;
    }

    var value: T = start;
    if step > 0 {
        while value < end {
            out.push(value);
            let next: T = value + step;
            if next <= value {
                break;
            }
            value = next;
        }
    } else {
        while value > end {
            out.push(value);
            let next: T = value + step;
            if next >= value {
                break;
            }
            value = next;
        }
    }
    return out;
}

/// @brief Materialize a half-open integer progression using `step`.
/// Positive steps produce values below `end`; negative steps produce values
/// above `end`. A zero step or a step directed away from the bound returns an
/// empty list. This combines the behavior of C++20 `views::iota` with a
/// stride-style increment in an eager list.
/// @ingroup algorithm_ranges
pub fn iota_by(start: i64, end: i64, step: i64) -> list<i64> {
    var out: list<i64> = [];
    if step == 0 {
        return out;
    }

    var value: i64 = start;
    if step > 0 {
        while value < end {
            out.push(value);
            if value > 9223372036854775807 - step {
                break;
            }
            value = value + step;
        }
    } else {
        while value > end {
            out.push(value);
            if value < (-9223372036854775807 - 1) - step {
                break;
            }
            value = value + step;
        }
    }
    return out;
}

/// @brief Materialize a one-element list view of `value`.
/// Eager-list counterpart to the C++20 `std::views::single` view.
/// @ingroup algorithm_ranges
generic<T>
pub fn single(value: T) -> list<T> {
    var out: list<T> = [];
    out.push(value);
    return out;
}

/// @brief Materialize `count` copies of `value`.
/// Eager-list counterpart to the C++23 `std::views::repeat` view.
/// Non-positive counts return an empty list.
/// @ingroup algorithm_ranges
generic<T>
pub fn repeat(value: T, count: i64) -> list<T> {
    var out: list<T> = [];
    if count <= 0 {
        return out;
    }
    out.push(value);
    var i: i64 = 1;
    while i < count {
        out.push(out[0]);
        i = i + 1;
    }
    return out;
}

/// @brief Copy all elements after skipping the first `n`.
/// @ingroup algorithm_ranges
generic<T>
pub fn drop(data: &list<T>, n: i64) -> list<T> {
    var out: list<T> = [];
    let len: i64 = data.len();
    let start: i64 = n <= 0 ? 0 : n;
    if start >= len {
        return out;
    }
    for i in start..len {
        out.push(data[i]);
    }
    return out;
}

/// @brief Copy the half-open element interval `[first, last)`.
/// Eager-list counterpart to C++20 `std::ranges::subrange`; bounds are clamped
/// to `[0, len]`, and empty or reversed intervals yield an empty list.
/// @ingroup algorithm_ranges
generic<T>
pub fn subrange(data: &list<T>, first: i64, last: i64) -> list<T> {
    var out: list<T> = [];
    let len: i64 = data.len();
    let start: i64 = first < 0 ? 0 : (first > len ? len : first);
    let end: i64 = last < 0 ? 0 : (last > len ? len : last);
    if end <= start { return out; }
    for i in start..end { out.push(data[i]); }
    return out;
}

/// @brief Copy the final `count` elements of a list.
/// C++23 `views::take_last` eager-list counterpart; non-positive counts are
/// empty and counts at least the size copy the entire input.
/// @ingroup algorithm_ranges
generic<T>
pub fn take_last(data: &list<T>, count: i64) -> list<T> {
    var out: list<T> = [];
    let len: i64 = data.len();
    if count <= 0 { return out; }
    let start: i64 = count >= len ? 0 : len - count;
    for i in start..len { out.push(data[i]); }
    return out;
}

/// @brief Copy all but the final `count` elements of a list.
/// C++23 `views::drop_last` eager-list counterpart; non-positive counts copy
/// the entire input and counts at least the size produce an empty list.
/// @ingroup algorithm_ranges
generic<T>
pub fn drop_last(data: &list<T>, count: i64) -> list<T> {
    var out: list<T> = [];
    let len: i64 = data.len();
    let end: i64 = count <= 0 ? len : len - count;
    let bounded_end: i64 = end < 0 ? 0 : end;
    for i in 0..bounded_end { out.push(data[i]); }
    return out;
}

/// @brief Copy the range after skipping its initial predicate-matching prefix.
/// Eager C++20 `views::drop_while` equivalent.
/// @ingroup algorithm_ranges
generic<T, Predicate>
pub fn drop_while(data: &list<T>, predicate: Predicate) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    var start: i64 = 0;
    while start < n && predicate(data[start]) {
        start = start + 1;
    }
    for i in start..n {
        out.push(data[i]);
    }
    return out;
}

/// @brief Copy the range after skipping the prefix whose projected keys
/// satisfy `predicate`, preserving original elements in the output.
/// @ingroup algorithm_ranges
generic<T, Predicate, Projection>
pub fn drop_while_projected(data: &list<T>, predicate: Predicate,
                            projection: Projection) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    var start: i64 = 0;
    while start < n && predicate(projection(data[start])) {
        start = start + 1;
    }
    for i in start..n {
        out.push(data[i]);
    }
    return out;
}

generic<T>
fn merge_sorted_runs(left: &list<T>, right: &list<T>) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var left_index: i64 = 0;
    var right_index: i64 = 0;

    while left_index < left_len && right_index < right_len {
        if left[left_index] <= right[right_index] {
            out.push(left[left_index]);
            left_index = left_index + 1;
        } else {
            out.push(right[right_index]);
            right_index = right_index + 1;
        }
    }
    while left_index < left_len {
        out.push(left[left_index]);
        left_index = left_index + 1;
    }
    while right_index < right_len {
        out.push(right[right_index]);
        right_index = right_index + 1;
    }
    return out;
}

/// @brief Return a stable, ascending sorted copy of a list.
/// The input is unchanged; elements must support ordering.
/// @ingroup algorithm_ranges
generic<T>
pub fn sorted(data: &list<T>) -> list<T> {
    let n: i64 = data.len();
    if n < 2 {
        return take(data, n);
    }
    let middle: i64 = n / 2;
    let left: list<T> = sorted(take(data, middle));
    let right: list<T> = sorted(drop(data, middle));
    return merge_sorted_runs(left, right);
}

generic<T, Less>
fn merge_sorted_runs_by(left: &list<T>, right: &list<T>, less: Less)
    -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if less(right[j], left[i]) {
            out.push(right[j]);
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
        }
    }
    while i < left_len {
        out.push(left[i]);
        i = i + 1;
    }
    while j < right_len {
        out.push(right[j]);
        j = j + 1;
    }
    return out;
}

/// @brief Return a stable copy sorted by the strict ordering `less`.
/// Equivalent elements keep their input order; the input is unchanged.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn sorted_by(data: &list<T>, less: Less) -> list<T> {
    let n: i64 = data.len();
    if n < 2 {
        return take(data, n);
    }
    let middle: i64 = n / 2;
    let left: list<T> = sorted_by(take(data, middle), less);
    let right: list<T> = sorted_by(drop(data, middle), less);
    return merge_sorted_runs_by(left, right, less);
}

generic<T, Projection>
fn merge_projected_runs(left: &list<T>, right: &list<T>,
                        projection: Projection) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if projection(right[j]) < projection(left[i]) {
            out.push(right[j]);
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
        }
    }
    while i < left_len {
        out.push(left[i]);
        i = i + 1;
    }
    while j < right_len {
        out.push(right[j]);
        j = j + 1;
    }
    return out;
}

generic<T, Less, Projection>
fn merge_by_projected_runs(left: &list<T>, right: &list<T>, less: Less,
                           projection: Projection) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        let right_key = projection(right[j]);
        let left_key = projection(left[i]);
        if less(right_key, left_key) {
            out.push(right[j]);
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
        }
    }
    while i < left_len { out.push(left[i]); i = i + 1; }
    while j < right_len { out.push(right[j]); j = j + 1; }
    return out;
}

/// @brief Return a stable copy ordered by each element's projected key.
/// Equal projected keys retain their input order; the input is unchanged.
/// C++20 `std::ranges::stable_sort` projection counterpart.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn sorted_projected(data: &list<T>, projection: Projection) -> list<T> {
    let n: i64 = data.len();
    if n < 2 {
        return take(data, n);
    }
    let middle: i64 = n / 2;
    let left: list<T> = sorted_projected(take(data, middle), projection);
    let right: list<T> = sorted_projected(drop(data, middle), projection);
    return merge_projected_runs(left, right, projection);
}

/// @brief Return a stable copy sorted by comparator over projected keys.
/// Equivalent projected keys retain their input order; the input is unchanged.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn sorted_by_projected(data: &list<T>, less: Less,
                           projection: Projection) -> list<T> {
    let n: i64 = data.len();
    if n < 2 { return take(data, n); }
    let middle: i64 = n / 2;
    let left: list<T> = sorted_by_projected(
        take(data, middle), less, projection);
    let right: list<T> = sorted_by_projected(
        drop(data, middle), less, projection);
    return merge_by_projected_runs(left, right, less, projection);
}

/// @brief Return the next lexicographic permutation and whether it exists.
/// If no next permutation exists, return the ascending first permutation.
/// The source range is unchanged (C++20 `std::ranges::next_permutation`).
/// @ingroup algorithm_ranges
generic<T>
pub fn next_permutation(data: &list<T>) -> tuple<bool, list<T>> {
    var out: list<T> = [];
    let n: i64 = data.len();
    var pivot: i64 = n - 2;
    while pivot >= 0 && !(data[pivot] < data[pivot + 1]) {
        pivot = pivot - 1;
    }
    if pivot < 0 {
        var i: i64 = n;
        while i > 0 {
            i = i - 1;
            out.push(data[i]);
        }
        return (false, out);
    }
    var successor: i64 = n - 1;
    while !(data[pivot] < data[successor]) {
        successor = successor - 1;
    }
    for i in 0..pivot {
        out.push(data[i]);
    }
    out.push(data[successor]);
    var i: i64 = n - 1;
    while i > successor {
        out.push(data[i]);
        i = i - 1;
    }
    out.push(data[pivot]);
    i = successor - 1;
    while i > pivot {
        out.push(data[i]);
        i = i - 1;
    }
    return (true, out);
}

/// @brief Next permutation under a strict ordering, with an unchanged input.
/// Wraps to the first permutation and returns false when no successor exists.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn next_permutation_by(data: &list<T>, less: Less)
    -> tuple<bool, list<T>> {
    var out: list<T> = [];
    let n: i64 = data.len();
    var pivot: i64 = n - 2;
    while pivot >= 0 && !less(data[pivot], data[pivot + 1]) {
        pivot = pivot - 1;
    }
    if pivot < 0 {
        var i: i64 = n;
        while i > 0 {
            i = i - 1;
            out.push(data[i]);
        }
        return (false, out);
    }
    var successor: i64 = n - 1;
    while !less(data[pivot], data[successor]) {
        successor = successor - 1;
    }
    for i in 0..pivot {
        out.push(data[i]);
    }
    out.push(data[successor]);
    var i: i64 = n - 1;
    while i > successor {
        out.push(data[i]);
        i = i - 1;
    }
    out.push(data[pivot]);
    i = successor - 1;
    while i > pivot {
        out.push(data[i]);
        i = i - 1;
    }
    return (true, out);
}

/// @brief Return the next permutation ordered by projected keys.
/// Wraps to the first key permutation and returns false when no successor exists.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn next_permutation_projected(data: &list<T>,
                                  projection: Projection)
    -> tuple<bool, list<T>> {
    var out: list<T> = [];
    let n: i64 = data.len();
    var pivot: i64 = n - 2;
    while pivot >= 0 && !(projection(data[pivot]) <
                          projection(data[pivot + 1])) {
        pivot = pivot - 1;
    }
    if pivot < 0 {
        var i: i64 = n;
        while i > 0 { i = i - 1; out.push(data[i]); }
        return (false, out);
    }
    var successor: i64 = n - 1;
    while !(projection(data[pivot]) < projection(data[successor])) {
        successor = successor - 1;
    }
    for i in 0..pivot { out.push(data[i]); }
    out.push(data[successor]);
    var i: i64 = n - 1;
    while i > successor { out.push(data[i]); i = i - 1; }
    out.push(data[pivot]);
    i = successor - 1;
    while i > pivot { out.push(data[i]); i = i - 1; }
    return (true, out);
}

/// @brief Advance a permutation under comparator-projected key ordering.
/// On wrap, returns false and reverses the source into the first arrangement.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn next_permutation_by_projected(data: &list<T>, less: Less,
                                     projection: Projection)
    -> tuple<bool, list<T>> {
    var out: list<T> = [];
    let n: i64 = data.len();
    var pivot: i64 = n - 2;
    while pivot >= 0 && !less(projection(data[pivot]),
                              projection(data[pivot + 1])) {
        pivot = pivot - 1;
    }
    if pivot < 0 {
        var i: i64 = n;
        while i > 0 { i = i - 1; out.push(data[i]); }
        return (false, out);
    }
    var successor: i64 = n - 1;
    while !less(projection(data[pivot]), projection(data[successor])) {
        successor = successor - 1;
    }
    for i in 0..pivot { out.push(data[i]); }
    out.push(data[successor]);
    var i: i64 = n - 1;
    while i > successor { out.push(data[i]); i = i - 1; }
    out.push(data[pivot]);
    i = successor - 1;
    while i > pivot { out.push(data[i]); i = i - 1; }
    return (true, out);
}

/// @brief Return the previous lexicographic permutation and whether it exists.
/// If no predecessor exists, return the descending last permutation.
/// @ingroup algorithm_ranges
generic<T>
pub fn prev_permutation(data: &list<T>) -> tuple<bool, list<T>> {
    var out: list<T> = [];
    let n: i64 = data.len();
    var pivot: i64 = n - 2;
    while pivot >= 0 && !(data[pivot] > data[pivot + 1]) {
        pivot = pivot - 1;
    }
    if pivot < 0 {
        var i: i64 = n;
        while i > 0 {
            i = i - 1;
            out.push(data[i]);
        }
        return (false, out);
    }
    var predecessor: i64 = n - 1;
    while !(data[pivot] > data[predecessor]) {
        predecessor = predecessor - 1;
    }
    for i in 0..pivot {
        out.push(data[i]);
    }
    out.push(data[predecessor]);
    var i: i64 = n - 1;
    while i > predecessor {
        out.push(data[i]);
        i = i - 1;
    }
    out.push(data[pivot]);
    i = predecessor - 1;
    while i > pivot {
        out.push(data[i]);
        i = i - 1;
    }
    return (true, out);
}

/// @brief Previous permutation under a strict ordering, with unchanged input.
/// Wraps to the last permutation and returns false when none exists.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn prev_permutation_by(data: &list<T>, less: Less)
    -> tuple<bool, list<T>> {
    var out: list<T> = [];
    let n: i64 = data.len();
    var pivot: i64 = n - 2;
    while pivot >= 0 && !less(data[pivot + 1], data[pivot]) {
        pivot = pivot - 1;
    }
    if pivot < 0 {
        var i: i64 = n;
        while i > 0 {
            i = i - 1;
            out.push(data[i]);
        }
        return (false, out);
    }
    var predecessor: i64 = n - 1;
    while !less(data[predecessor], data[pivot]) {
        predecessor = predecessor - 1;
    }
    for i in 0..pivot {
        out.push(data[i]);
    }
    out.push(data[predecessor]);
    var i: i64 = n - 1;
    while i > predecessor {
        out.push(data[i]);
        i = i - 1;
    }
    out.push(data[pivot]);
    i = predecessor - 1;
    while i > pivot {
        out.push(data[i]);
        i = i - 1;
    }
    return (true, out);
}

/// @brief Return the previous permutation ordered by projected keys.
/// Wraps to the last key permutation and returns false when none exists.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn prev_permutation_projected(data: &list<T>,
                                  projection: Projection)
    -> tuple<bool, list<T>> {
    var out: list<T> = [];
    let n: i64 = data.len();
    var pivot: i64 = n - 2;
    while pivot >= 0 && !(projection(data[pivot + 1]) <
                          projection(data[pivot])) {
        pivot = pivot - 1;
    }
    if pivot < 0 {
        var i: i64 = n;
        while i > 0 { i = i - 1; out.push(data[i]); }
        return (false, out);
    }
    var predecessor: i64 = n - 1;
    while !(projection(data[predecessor]) < projection(data[pivot])) {
        predecessor = predecessor - 1;
    }
    for i in 0..pivot { out.push(data[i]); }
    out.push(data[predecessor]);
    var i: i64 = n - 1;
    while i > predecessor { out.push(data[i]); i = i - 1; }
    out.push(data[pivot]);
    i = predecessor - 1;
    while i > pivot { out.push(data[i]); i = i - 1; }
    return (true, out);
}

/// @brief Retreat a permutation under comparator-projected key ordering.
/// On wrap, returns false and reverses the source into the last arrangement.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn prev_permutation_by_projected(data: &list<T>, less: Less,
                                     projection: Projection)
    -> tuple<bool, list<T>> {
    var out: list<T> = [];
    let n: i64 = data.len();
    var pivot: i64 = n - 2;
    while pivot >= 0 && !less(projection(data[pivot + 1]),
                              projection(data[pivot])) {
        pivot = pivot - 1;
    }
    if pivot < 0 {
        var i: i64 = n;
        while i > 0 { i = i - 1; out.push(data[i]); }
        return (false, out);
    }
    var predecessor: i64 = n - 1;
    while !less(projection(data[predecessor]), projection(data[pivot])) {
        predecessor = predecessor - 1;
    }
    for i in 0..pivot { out.push(data[i]); }
    out.push(data[predecessor]);
    var i: i64 = n - 1;
    while i > predecessor { out.push(data[i]); i = i - 1; }
    out.push(data[pivot]);
    i = predecessor - 1;
    while i > pivot { out.push(data[i]); i = i - 1; }
    return (true, out);
}

/// @brief Return a reversed copy of a list.
/// @ingroup algorithm_ranges
generic<T>
pub fn reversed(data: &list<T>) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        out.push(data[n - 1 - i]);
    }
    return out;
}

/// @brief Copy a range in reverse order.
/// Eager-list counterpart to C++20 `std::ranges::reverse_copy`.
/// @ingroup algorithm_ranges
generic<T>
pub fn reverse_copy(data: &list<T>) -> list<T> {
    return reversed(data);
}

/// @brief Return a copy rotated left by `amount` positions.
/// Negative amounts rotate right; amounts are normalized modulo list length.
/// @ingroup algorithm_ranges
generic<T>
pub fn rotate_left(data: &list<T>, amount: i64) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    if n == 0 {
        return out;
    }
    var start: i64 = amount % n;
    if start < 0 {
        start = start + n;
    }
    let tail_len: i64 = n - start;
    for offset in 0..n {
        let index: i64 = offset < tail_len
            ? start + offset
            : offset - tail_len;
        out.push(data[index]);
    }
    return out;
}

/// @brief Rotate a copied range so `middle` becomes its first element.
/// The split index is clamped to `[0, data.len()]`; unlike the in-place
/// C++20 algorithm, this eager-list counterpart leaves the input unchanged.
/// @ingroup algorithm_ranges
generic<T>
pub fn rotate(data: &list<T>, middle: i64) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    var split: i64 = middle;
    if split < 0 { split = 0; }
    if split > n { split = n; }
    for i in split..n {
        out.push(data[i]);
    }
    for i in 0..split {
        out.push(data[i]);
    }
    return out;
}

/// @brief Copy a range with the element at `middle` moved to the front.
/// The split index is clamped to `[0, data.len()]`; eager-list counterpart to
/// C++20 `std::ranges::rotate_copy`.
/// @ingroup algorithm_ranges
generic<T>
pub fn rotate_copy(data: &list<T>, middle: i64) -> list<T> {
    return rotate(data, middle);
}

/// @brief Return the retained range after a left shift by `count` positions.
/// The suffix `[count, end)` is copied to the front; non-positive counts are
/// no-ops, and counts at least the input length produce an empty list.
/// Eager-list counterpart to C++20 `std::ranges::shift_left`.
/// @ingroup algorithm_ranges
generic<T>
pub fn shift_left(data: &list<T>, count: i64) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    var start: i64 = count;
    if start < 0 { start = 0; }
    if start > n { start = n; }
    for i in start..n {
        out.push(data[i]);
    }
    return out;
}

/// @brief Return the retained range after a right shift by `count` positions.
/// The prefix `[0, len-count)` is what C++20 `std::ranges::shift_right`
/// moves to the right; this eager-list counterpart returns that retained
/// prefix. Non-positive counts are no-ops; counts at least the length are empty.
/// @ingroup algorithm_ranges
generic<T>
pub fn shift_right(data: &list<T>, count: i64) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    var removed: i64 = count;
    if removed < 0 { removed = 0; }
    if removed > n { removed = n; }
    let retained: i64 = n - removed;
    for i in 0..retained {
        out.push(data[i]);
    }
    return out;
}

/// @brief Materialize consecutive chunks of at most `chunk_size` elements.
/// Eager-list counterpart to C++23 `views::chunk`; non-positive sizes are empty.
/// @ingroup algorithm_ranges
generic<T>
pub fn chunked(data: &list<T>, chunk_size: i64) -> list<list<T>> {
    var out: list<list<T>> = [];
    let n: i64 = data.len();
    if chunk_size <= 0 || n == 0 {
        return out;
    }
    var start: i64 = 0;
    while start < n {
        var chunk: list<T> = [];
        let end: i64 = start + chunk_size < n ? start + chunk_size : n;
        for i in start..end {
            chunk.push(data[i]);
        }
        out.push(chunk);
        start = end;
    }
    return out;
}

/// @brief Group adjacent elements while `equivalent` accepts each pair.
/// Eager-list counterpart to C++23 `views::chunk_by`.
/// @ingroup algorithm_ranges
generic<T, Equivalent>
pub fn chunk_by(data: &list<T>, equivalent: Equivalent) -> list<list<T>> {
    var out: list<list<T>> = [];
    let n: i64 = data.len();
    if n == 0 {
        return out;
    }

    var chunk: list<T> = [];
    chunk.push(data[0]);
    for i in 1..n {
        if equivalent(data[i - 1], data[i]) {
            chunk.push(data[i]);
        } else {
            out.push(chunk);
            chunk = [];
            chunk.push(data[i]);
        }
    }
    out.push(chunk);
    return out;
}

/// @brief Group adjacent elements when their projected keys are equivalent.
/// Eager-list counterpart to projected C++23 `views::chunk_by`.
/// @ingroup algorithm_ranges
generic<T, Equivalent, Projection>
pub fn chunk_by_projected(data: &list<T>, equivalent: Equivalent,
                          projection: Projection) -> list<list<T>> {
    var out: list<list<T>> = [];
    let n: i64 = data.len();
    if n == 0 { return out; }

    var chunk: list<T> = [];
    chunk.push(data[0]);
    for i in 1..n {
        if equivalent(projection(data[i - 1]), projection(data[i])) {
            chunk.push(data[i]);
        } else {
            out.push(chunk);
            chunk = [];
            chunk.push(data[i]);
        }
    }
    out.push(chunk);
    return out;
}

/// @brief Materialize every overlapping window of `window_size` elements.
/// Eager-list counterpart to C++23 `views::slide`; invalid sizes return empty.
/// @ingroup algorithm_ranges
generic<T>
pub fn windows(data: &list<T>, window_size: i64) -> list<list<T>> {
    var out: list<list<T>> = [];
    let n: i64 = data.len();
    if window_size <= 0 || window_size > n {
        return out;
    }
    let last_start: i64 = n - window_size;
    for start in 0..(last_start + 1) {
        var window: list<T> = [];
        for offset in 0..window_size {
            window.push(data[start + offset]);
        }
        out.push(window);
    }
    return out;
}

/// @brief Copy every `stride`-th element, starting at index zero.
/// Eager-list counterpart to C++23 `views::stride`; non-positive strides are empty.
/// @ingroup algorithm_ranges
generic<T>
pub fn strided(data: &list<T>, stride: i64) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    if stride <= 0 {
        return out;
    }
    var index: i64 = 0;
    while index < n {
        out.push(data[index]);
        index = index + stride;
    }
    return out;
}

/// @brief Flatten a list of lists into one copied list.
/// Eager-list counterpart to the C++20 `views::join` adaptor.
/// @ingroup algorithm_ranges
generic<T>
pub fn joined(data: &list<list<T>>) -> list<T> {
    var out: list<T> = [];
    let outer_len: i64 = data.len();
    for outer_index in 0..outer_len {
        let inner: list<T> = data[outer_index];
        let inner_len: i64 = inner.len();
        for inner_index in 0..inner_len {
            out.push(inner[inner_index]);
        }
    }
    return out;
}

/// @brief Flatten a list of lists, inserting `separator` between each pair
/// of inner lists. The separator is inserted even when an inner list is empty.
/// Eager-list counterpart to C++23 `views::join_with`.
/// @ingroup algorithm_ranges
generic<T>
pub fn joined_with(data: &list<list<T>>, separator: &list<T>) -> list<T> {
    var out: list<T> = [];
    let outer_len: i64 = data.len();
    let separator_len: i64 = separator.len();
    for outer_index in 0..outer_len {
        if outer_index > 0 {
            for separator_index in 0..separator_len {
                out.push(separator[separator_index]);
            }
        }
        let inner: list<T> = data[outer_index];
        let inner_len: i64 = inner.len();
        for inner_index in 0..inner_len {
            out.push(inner[inner_index]);
        }
    }
    return out;
}

/// @brief C++23 `views::chunk` spelling for `chunked`.
/// Materializes the same eager list-of-lists result.
/// @ingroup algorithm_ranges
generic<T>
pub fn chunk(data: &list<T>, chunk_size: i64) -> list<list<T>> {
    return chunked(data, chunk_size);
}

/// @brief C++23 `views::slide` spelling for `windows`.
/// Materializes every overlapping fixed-size sublist.
/// @ingroup algorithm_ranges
generic<T>
pub fn slide(data: &list<T>, window_size: i64) -> list<list<T>> {
    return windows(data, window_size);
}

/// @brief C++23 `views::stride` spelling for `strided`.
/// Copies every `stride`-th element starting at index zero.
/// @ingroup algorithm_ranges
generic<T>
pub fn stride(data: &list<T>, stride: i64) -> list<T> {
    return strided(data, stride);
}

/// @brief C++20 `views::join` spelling for `joined`.
/// Flattens one list-of-lists level into an eager copied list.
/// @ingroup algorithm_ranges
generic<T>
pub fn join(data: &list<list<T>>) -> list<T> {
    return joined(data);
}

/// @brief C++23 `views::join_with` spelling for `joined_with`.
/// Flattens one level and inserts a separator between each pair of lists.
/// @ingroup algorithm_ranges
generic<T>
pub fn join_with(data: &list<list<T>>, separator: &list<T>) -> list<T> {
    return joined_with(data, separator);
}

/// @brief Split a range at each non-overlapping occurrence of `delimiter`.
/// Empty fields are retained between leading, adjacent, and trailing matches.
/// An empty input produces no fields; an empty delimiter returns the whole
/// nonempty input as one field. Eager C++20 `views::split` counterpart.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn split(data: &list<T>, delimiter: &list<U>) -> list<list<T>> {
    var parts: list<list<T>> = [];
    let data_len: i64 = data.len();
    let delimiter_len: i64 = delimiter.len();
    if data_len == 0 {
        return parts;
    }
    if delimiter_len == 0 {
        var whole: list<T> = [];
        for i in 0..data_len {
            whole.push(data[i]);
        }
        parts.push(whole);
        return parts;
    }

    var segment: list<T> = [];
    var index: i64 = 0;
    while index < data_len {
        var matches: bool = false;
        if delimiter_len <= data_len - index {
            matches = true;
            for offset in 0..delimiter_len {
                if data[index + offset] != delimiter[offset] {
                    matches = false;
                    break;
                }
            }
        }

        if matches {
            parts.push(segment);
            segment = [];
            index = index + delimiter_len;
        } else {
            segment.push(data[index]);
            index = index + 1;
        }
    }
    parts.push(segment);
    return parts;
}

/// @brief Concatenate two ranges into a copied list.
/// Eager-list counterpart to C++23 `views::concat` for two same-typed inputs.
/// @ingroup algorithm_ranges
generic<T>
pub fn concat(left: &list<T>, right: &list<T>) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    for i in 0..left_len {
        out.push(left[i]);
    }
    for i in 0..right_len {
        out.push(right[i]);
    }
    return out;
}

/// @brief Pair corresponding elements into tuples, stopping at the shorter list.
/// Eager C++23 `views::zip` equivalent; both inputs remain unchanged.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn zip(left: &list<T>, right: &list<U>) -> list<tuple<T, U>> {
    var out: list<tuple<T, U>> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    let n: i64 = left_len < right_len ? left_len : right_len;
    for i in 0..n {
        out.push((left[i], right[i]));
    }
    return out;
}

/// @brief Pair corresponding elements from three ranges, stopping at the
/// shortest input. C++23 `views::zip` counterpart with heterogeneous inputs.
/// @ingroup algorithm_ranges
generic<T, U, V>
pub fn zip(first: &list<T>, second: &list<U>, third: &list<V>)
    -> list<tuple<T, U, V>> {
    var out: list<tuple<T, U, V>> = [];
    let first_len: i64 = first.len();
    let second_len: i64 = second.len();
    let third_len: i64 = third.len();
    var n: i64 = first_len;
    if second_len < n {
        n = second_len;
    }
    if third_len < n {
        n = third_len;
    }
    for i in 0..n {
        out.push((first[i], second[i], third[i]));
    }
    return out;
}

/// @brief Zip four heterogeneous ranges, stopping at the shortest input.
/// C++23 `views::zip` eager-list counterpart.
/// @ingroup algorithm_ranges
generic<T, U, V, W>
pub fn zip(first: &list<T>, second: &list<U>, third: &list<V>,
          fourth: &list<W>) -> list<tuple<T, U, V, W>> {
    var out: list<tuple<T, U, V, W>> = [];
    var n: i64 = first.len();
    if second.len() < n { n = second.len(); }
    if third.len() < n { n = third.len(); }
    if fourth.len() < n { n = fourth.len(); }
    for i in 0..n {
        out.push((first[i], second[i], third[i], fourth[i]));
    }
    return out;
}

/// @brief Zip five heterogeneous ranges, stopping at the shortest input.
/// @ingroup algorithm_ranges
generic<T, U, V, W, X>
pub fn zip(first: &list<T>, second: &list<U>, third: &list<V>,
          fourth: &list<W>, fifth: &list<X>) -> list<tuple<T, U, V, W, X>> {
    var out: list<tuple<T, U, V, W, X>> = [];
    var n: i64 = first.len();
    if second.len() < n { n = second.len(); }
    if third.len() < n { n = third.len(); }
    if fourth.len() < n { n = fourth.len(); }
    if fifth.len() < n { n = fifth.len(); }
    for i in 0..n {
        out.push((first[i], second[i], third[i], fourth[i], fifth[i]));
    }
    return out;
}

/// @brief Materialize tuples for each pair of adjacent elements.
/// Eager C++23 `views::pairwise` equivalent; fewer than two elements yield
/// an empty list and the input is unchanged.
/// @ingroup algorithm_ranges
generic<T>
pub fn pairwise(data: &list<T>) -> list<tuple<T, T>> {
    var out: list<tuple<T, T>> = [];
    let n: i64 = data.len();
    if n < 2 {
        return out;
    }
    for i in 0..(n - 1) {
        out.push((data[i], data[i + 1]));
    }
    return out;
}

/// @brief Materialize a tuple for every adjacent triple.
/// Eager counterpart to C++23 `views::adjacent<3>`; short inputs are empty.
/// @ingroup algorithm_ranges
generic<T>
pub fn adjacent3(data: &list<T>) -> list<tuple<T, T, T>> {
    var out: list<tuple<T, T, T>> = [];
    let n: i64 = data.len();
    if n < 3 { return out; }
    for i in 0..(n - 2) {
        out.push((data[i], data[i + 1], data[i + 2]));
    }
    return out;
}

/// @brief Materialize a tuple for every adjacent group of four.
/// Eager counterpart to C++23 `views::adjacent<4>`; short inputs are empty.
/// @ingroup algorithm_ranges
generic<T>
pub fn adjacent4(data: &list<T>) -> list<tuple<T, T, T, T>> {
    var out: list<tuple<T, T, T, T>> = [];
    let n: i64 = data.len();
    if n < 4 { return out; }
    for i in 0..(n - 3) {
        out.push((data[i], data[i + 1], data[i + 2], data[i + 3]));
    }
    return out;
}

/// @brief Materialize a tuple for every adjacent group of five.
/// Eager counterpart to C++23 `views::adjacent<5>`; short inputs are empty.
/// @ingroup algorithm_ranges
generic<T>
pub fn adjacent5(data: &list<T>) -> list<tuple<T, T, T, T, T>> {
    var out: list<tuple<T, T, T, T, T>> = [];
    let n: i64 = data.len();
    if n < 5 { return out; }
    for i in 0..(n - 4) {
        out.push((data[i], data[i + 1], data[i + 2], data[i + 3],
                  data[i + 4]));
    }
    return out;
}

/// @brief Apply a binary operation to every adjacent pair of elements.
/// Eager C++23 `views::adjacent_transform<2>` equivalent; output length is
/// max(data.len() - 1, 0), and output type follows the operation's result.
/// @ingroup algorithm_ranges
generic<T, Output, Operation>
pub fn adjacent_transform(data: &list<T>, operation: Operation)
    -> list<Output> {
    var out: list<Output> = [];
    let n: i64 = data.len();
    if n < 2 {
        return out;
    }
    for i in 0..(n - 1) {
        out.push(operation(data[i], data[i + 1]));
    }
    return out;
}

/// @brief Apply a binary operation to each adjacent pair's projected keys.
/// The original list is unchanged; result length is max(len - 1, 0).
/// @ingroup algorithm_ranges
generic<T, Output, Operation, Projection>
pub fn adjacent_transform_projected(data: &list<T>, operation: Operation,
                                    projection: Projection) -> list<Output> {
    var out: list<Output> = [];
    let n: i64 = data.len();
    if n < 2 { return out; }
    for i in 0..(n - 1) {
        out.push(operation(projection(data[i]), projection(data[i + 1])));
    }
    return out;
}

/// @brief Apply a ternary operation to each adjacent triple.
/// Eager C++23 `views::adjacent_transform<3>` counterpart.
/// @ingroup algorithm_ranges
generic<T, Output, Operation>
pub fn adjacent_transform3(data: &list<T>, operation: Operation)
    -> list<Output> {
    var out: list<Output> = [];
    let n: i64 = data.len();
    if n < 3 { return out; }
    for i in 0..(n - 2) {
        out.push(operation(data[i], data[i + 1], data[i + 2]));
    }
    return out;
}

/// @brief Apply a ternary operation to each triple of projected keys.
/// @ingroup algorithm_ranges
generic<T, Output, Operation, Projection>
pub fn adjacent_transform3_projected(data: &list<T>, operation: Operation,
                                     projection: Projection) -> list<Output> {
    var out: list<Output> = [];
    let n: i64 = data.len();
    if n < 3 { return out; }
    for i in 0..(n - 2) {
        out.push(operation(projection(data[i]), projection(data[i + 1]),
                           projection(data[i + 2])));
    }
    return out;
}

/// @brief Apply a four-argument operation to each adjacent group of four.
/// Eager C++23 `views::adjacent_transform<4>` counterpart.
/// @ingroup algorithm_ranges
generic<T, Output, Operation>
pub fn adjacent_transform4(data: &list<T>, operation: Operation)
    -> list<Output> {
    var out: list<Output> = [];
    let n: i64 = data.len();
    if n < 4 { return out; }
    for i in 0..(n - 3) {
        out.push(operation(data[i], data[i + 1], data[i + 2], data[i + 3]));
    }
    return out;
}

/// @brief Apply a four-argument operation to each group of four projected keys.
/// @ingroup algorithm_ranges
generic<T, Output, Operation, Projection>
pub fn adjacent_transform4_projected(data: &list<T>, operation: Operation,
                                     projection: Projection) -> list<Output> {
    var out: list<Output> = [];
    let n: i64 = data.len();
    if n < 4 { return out; }
    for i in 0..(n - 3) {
        out.push(operation(projection(data[i]), projection(data[i + 1]),
                           projection(data[i + 2]), projection(data[i + 3])));
    }
    return out;
}

/// @brief Apply a five-argument operation to each adjacent group of five.
/// Eager C++23 `views::adjacent_transform<5>` counterpart.
/// @ingroup algorithm_ranges
generic<T, Output, Operation>
pub fn adjacent_transform5(data: &list<T>, operation: Operation)
    -> list<Output> {
    var out: list<Output> = [];
    let n: i64 = data.len();
    if n < 5 { return out; }
    for i in 0..(n - 4) {
        out.push(operation(data[i], data[i + 1], data[i + 2], data[i + 3],
                           data[i + 4]));
    }
    return out;
}

/// @brief Apply a five-argument operation to each group of projected keys.
/// @ingroup algorithm_ranges
generic<T, Output, Operation, Projection>
pub fn adjacent_transform5_projected(data: &list<T>, operation: Operation,
                                     projection: Projection) -> list<Output> {
    var out: list<Output> = [];
    let n: i64 = data.len();
    if n < 5 { return out; }
    for i in 0..(n - 4) {
        out.push(operation(projection(data[i]), projection(data[i + 1]),
                           projection(data[i + 2]), projection(data[i + 3]),
                           projection(data[i + 4])));
    }
    return out;
}

/// @brief Materialize every pair from two ranges in nested-loop order.
/// The right range varies fastest; equivalent to C++23 `views::cartesian_product`.
/// @ingroup algorithm_ranges
generic<T, U>
pub fn cartesian_product(left: &list<T>, right: &list<U>)
    -> list<tuple<T, U>> {
    var out: list<tuple<T, U>> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    for i in 0..left_len {
        for j in 0..right_len {
            out.push((left[i], right[j]));
        }
    }
    return out;
}

/// @brief Materialize every triple from three ranges in nested-loop order.
/// The third range varies fastest, then the second; inputs are unchanged.
/// @ingroup algorithm_ranges
generic<T, U, V>
pub fn cartesian_product(first: &list<T>, second: &list<U>, third: &list<V>)
    -> list<tuple<T, U, V>> {
    var out: list<tuple<T, U, V>> = [];
    let first_len: i64 = first.len();
    let second_len: i64 = second.len();
    let third_len: i64 = third.len();
    for i in 0..first_len {
        for j in 0..second_len {
            for k in 0..third_len {
                out.push((first[i], second[j], third[k]));
            }
        }
    }
    return out;
}

/// @brief Materialize every quadruple from four ranges in nested-loop order.
/// The rightmost range varies fastest; inputs remain unchanged.
/// @ingroup algorithm_ranges
generic<T, U, V, W>
pub fn cartesian_product(first: &list<T>, second: &list<U>, third: &list<V>,
                         fourth: &list<W>) -> list<tuple<T, U, V, W>> {
    var out: list<tuple<T, U, V, W>> = [];
    for i in 0..first.len() {
        for j in 0..second.len() {
            for k in 0..third.len() {
                for m in 0..fourth.len() {
                    out.push((first[i], second[j], third[k], fourth[m]));
                }
            }
        }
    }
    return out;
}

/// @brief Materialize every combination from five heterogeneous ranges.
/// The rightmost input varies fastest; any empty input yields an empty result.
/// @ingroup algorithm_ranges
generic<T, U, V, W, X>
pub fn cartesian_product(first: &list<T>, second: &list<U>, third: &list<V>,
                         fourth: &list<W>, fifth: &list<X>)
    -> list<tuple<T, U, V, W, X>> {
    var out: list<tuple<T, U, V, W, X>> = [];
    for i in 0..first.len() {
        for j in 0..second.len() {
            for k in 0..third.len() {
                for m in 0..fourth.len() {
                    for n in 0..fifth.len() {
                        out.push((first[i], second[j], third[k], fourth[m],
                                  fifth[n]));
                    }
                }
            }
        }
    }
    return out;
}

/// @brief Pair each element with its zero-based position.
/// Eager C++23 `views::enumerate` equivalent; the input remains unchanged.
/// @ingroup algorithm_ranges
generic<T>
pub fn enumerate(data: &list<T>) -> list<tuple<i64, T>> {
    var out: list<tuple<i64, T>> = [];
    let n: i64 = data.len();
    for i in 0..n {
        out.push((i, data[i]));
    }
    return out;
}

/// @brief Pair each element with a position beginning at `first_index`.
/// The input is unchanged; negative starting indices are permitted.
/// @ingroup algorithm_ranges
generic<T>
pub fn enumerate_from(data: &list<T>, first_index: i64)
    -> list<tuple<i64, T>> {
    var out: list<tuple<i64, T>> = [];
    let n: i64 = data.len();
    for i in 0..n {
        out.push((first_index + i, data[i]));
    }
    return out;
}

/// @brief Project the first element from every pair-like tuple.
/// Eager C++20 `views::keys` counterpart for `list<tuple<K, V>>`.
/// @ingroup algorithm_ranges
generic<K, V>
pub fn keys(data: &list<tuple<K, V>>) -> list<K> {
    var projected: list<K> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let entry: tuple<K, V> = data[i];
        projected.push(entry.0);
    }
    return projected;
}

/// @brief Project the second element from every pair-like tuple.
/// Eager C++20 `views::values` counterpart for `list<tuple<K, V>>`.
/// @ingroup algorithm_ranges
generic<K, V>
pub fn values(data: &list<tuple<K, V>>) -> list<V> {
    var projected: list<V> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let entry: tuple<K, V> = data[i];
        projected.push(entry.1);
    }
    return projected;
}

/// @brief Merge two nondecreasing ranges into one stable sorted copy.
/// Both inputs must already be sorted; equal elements from `left` come first.
/// C++20 `std::ranges::merge` equivalent for same-typed lists.
/// @ingroup algorithm_ranges
generic<T>
pub fn merged(left: &list<T>, right: &list<T>) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var left_index: i64 = 0;
    var right_index: i64 = 0;
    while left_index < left_len && right_index < right_len {
        if right[right_index] < left[left_index] {
            out.push(right[right_index]);
            right_index = right_index + 1;
        } else {
            out.push(left[left_index]);
            left_index = left_index + 1;
        }
    }
    while left_index < left_len {
        out.push(left[left_index]);
        left_index = left_index + 1;
    }
    while right_index < right_len {
        out.push(right[right_index]);
        right_index = right_index + 1;
    }
    return out;
}

/// @brief Stably merge sorted ranges according to projected keys.
/// Equivalent keys from the left range appear first; inputs must be sorted by
/// the same projection.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn merged_projected(left: &list<T>, right: &list<T>,
                        projection: Projection) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if projection(right[j]) < projection(left[i]) {
            out.push(right[j]);
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
        }
    }
    while i < left_len {
        out.push(left[i]);
        i = i + 1;
    }
    while j < right_len {
        out.push(right[j]);
        j = j + 1;
    }
    return out;
}

/// @brief Return the sorted multiset union of two sorted ranges.
/// The result keeps the maximum multiplicity of each value.
/// C++20 `std::ranges::set_union` equivalent for same-typed lists.
/// @ingroup algorithm_ranges
generic<T>
pub fn union_sorted(left: &list<T>, right: &list<T>) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if left[i] < right[j] {
            out.push(left[i]);
            i = i + 1;
        } else if right[j] < left[i] {
            out.push(right[j]);
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
            j = j + 1;
        }
    }
    while i < left_len {
        out.push(left[i]);
        i = i + 1;
    }
    while j < right_len {
        out.push(right[j]);
        j = j + 1;
    }
    return out;
}

/// @brief Return the sorted multiset union according to projected keys.
/// The result keeps the maximum multiplicity of each projected equivalence
/// class and prefers left-side representatives for matches.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn union_sorted_projected(left: &list<T>, right: &list<T>,
                              projection: Projection) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if projection(left[i]) < projection(right[j]) {
            out.push(left[i]);
            i = i + 1;
        } else if projection(right[j]) < projection(left[i]) {
            out.push(right[j]);
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
            j = j + 1;
        }
    }
    while i < left_len {
        out.push(left[i]);
        i = i + 1;
    }
    while j < right_len {
        out.push(right[j]);
        j = j + 1;
    }
    return out;
}

/// @brief Return the sorted multiset intersection of two sorted ranges.
/// The result keeps the minimum multiplicity of each value.
/// C++20 `std::ranges::set_intersection` equivalent for same-typed lists.
/// @ingroup algorithm_ranges
generic<T>
pub fn intersection_sorted(left: &list<T>, right: &list<T>) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if left[i] < right[j] {
            i = i + 1;
        } else if right[j] < left[i] {
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
            j = j + 1;
        }
    }
    return out;
}

/// @brief Return the sorted intersection under projected-key equivalence.
/// The result keeps the minimum multiplicity and left-side representatives.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn intersection_sorted_projected(left: &list<T>, right: &list<T>,
                                     projection: Projection) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if projection(left[i]) < projection(right[j]) {
            i = i + 1;
        } else if projection(right[j]) < projection(left[i]) {
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
            j = j + 1;
        }
    }
    return out;
}

/// @brief Return elements in the left sorted range not matched by the right.
/// The result keeps the unmatched excess multiplicity from `left`.
/// C++20 `std::ranges::set_difference` equivalent for same-typed lists.
/// @ingroup algorithm_ranges
generic<T>
pub fn difference_sorted(left: &list<T>, right: &list<T>) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if left[i] < right[j] {
            out.push(left[i]);
            i = i + 1;
        } else if right[j] < left[i] {
            j = j + 1;
        } else {
            i = i + 1;
            j = j + 1;
        }
    }
    while i < left_len {
        out.push(left[i]);
        i = i + 1;
    }
    return out;
}

/// @brief Return the projected-key excess multiplicity from the left range.
/// Both inputs must be sorted by the same projection.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn difference_sorted_projected(left: &list<T>, right: &list<T>,
                                   projection: Projection) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if projection(left[i]) < projection(right[j]) {
            out.push(left[i]);
            i = i + 1;
        } else if projection(right[j]) < projection(left[i]) {
            j = j + 1;
        } else {
            i = i + 1;
            j = j + 1;
        }
    }
    while i < left_len {
        out.push(left[i]);
        i = i + 1;
    }
    return out;
}

/// @brief Return sorted values whose occurrences belong to exactly one range.
/// For each value, output the absolute difference in its multiplicities.
/// C++20 `std::ranges::set_symmetric_difference` equivalent.
/// @ingroup algorithm_ranges
generic<T>
pub fn symmetric_difference_sorted(left: &list<T>, right: &list<T>) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if left[i] < right[j] {
            out.push(left[i]);
            i = i + 1;
        } else if right[j] < left[i] {
            out.push(right[j]);
            j = j + 1;
        } else {
            i = i + 1;
            j = j + 1;
        }
    }
    while i < left_len {
        out.push(left[i]);
        i = i + 1;
    }
    while j < right_len {
        out.push(right[j]);
        j = j + 1;
    }
    return out;
}

/// @brief Return projected-key occurrences present in exactly one input.
/// For each key, the output multiplicity is the absolute difference between
/// the two inputs; equivalent values preserve their source order.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn symmetric_difference_sorted_projected(left: &list<T>, right: &list<T>,
                                              projection: Projection)
    -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if projection(left[i]) < projection(right[j]) {
            out.push(left[i]);
            i = i + 1;
        } else if projection(right[j]) < projection(left[i]) {
            out.push(right[j]);
            j = j + 1;
        } else {
            i = i + 1;
            j = j + 1;
        }
    }
    while i < left_len {
        out.push(left[i]);
        i = i + 1;
    }
    while j < right_len {
        out.push(right[j]);
        j = j + 1;
    }
    return out;
}

/// @brief Stably merge two sorted ranges using `less` as their ordering.
/// Equal elements from `left` come first; both inputs must use this ordering.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn merged_by(left: &list<T>, right: &list<T>, less: Less) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if less(right[j], left[i]) {
            out.push(right[j]);
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
        }
    }
    while i < left_len {
        out.push(left[i]);
        i = i + 1;
    }
    while j < right_len {
        out.push(right[j]);
        j = j + 1;
    }
    return out;
}

/// @brief Stably merge ranges ordered by a comparator over projected keys.
/// Equivalent keys from the left range appear first; both inputs must be
/// sorted with the combined ordering.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn merged_by_projected(left: &list<T>, right: &list<T>, less: Less,
                           projection: Projection) -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if less(projection(right[j]), projection(left[i])) {
            out.push(right[j]);
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
        }
    }
    while i < left_len { out.push(left[i]); i = i + 1; }
    while j < right_len { out.push(right[j]); j = j + 1; }
    return out;
}

/// @brief Stably merge two sorted halves of one range into a copied range.
/// `middle` is clamped to the valid index interval; both halves must already
/// be sorted in ascending order. C++20 `std::ranges::inplace_merge` analogue.
/// @ingroup algorithm_ranges
generic<T>
pub fn inplace_merge(data: &list<T>, middle: i64) -> list<T> {
    var split: i64 = middle;
    let n: i64 = data.len();
    if split < 0 { split = 0; }
    if split > n { split = n; }
    var left: list<T> = [];
    var right: list<T> = [];
    for i in 0..split {
        left.push(data[i]);
    }
    for i in split..n {
        right.push(data[i]);
    }
    return merged(left, right);
}

/// @brief Comparator-based stable merge of two sorted halves.
/// Both halves must be ordered by `less`; `middle` is clamped to the range.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn inplace_merge_by(data: &list<T>, middle: i64, less: Less) -> list<T> {
    var split: i64 = middle;
    let n: i64 = data.len();
    if split < 0 { split = 0; }
    if split > n { split = n; }
    var left: list<T> = [];
    var right: list<T> = [];
    for i in 0..split {
        left.push(data[i]);
    }
    for i in split..n {
        right.push(data[i]);
    }
    return merged_by(left, right, less);
}

/// @brief Stably merge sorted halves by projected keys into a copied list.
/// Equivalent projected keys from the left half remain before right-half
/// equivalents; `middle` is clamped to the range bounds.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn inplace_merge_projected(data: &list<T>, middle: i64,
                               projection: Projection) -> list<T> {
    var split: i64 = middle;
    let n: i64 = data.len();
    if split < 0 { split = 0; }
    if split > n { split = n; }
    var out: list<T> = [];
    var left: i64 = 0;
    var right: i64 = split;
    while left < split && right < n {
        if projection(data[right]) < projection(data[left]) {
            out.push(data[right]);
            right = right + 1;
        } else {
            out.push(data[left]);
            left = left + 1;
        }
    }
    while left < split { out.push(data[left]); left = left + 1; }
    while right < n { out.push(data[right]); right = right + 1; }
    return out;
}

/// @brief Merge sorted halves by comparator-projected ordering into a copy.
/// Equivalent values from the left half remain first; `middle` is clamped.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn inplace_merge_by_projected(data: &list<T>, middle: i64, less: Less,
                                  projection: Projection) -> list<T> {
    var split: i64 = middle;
    let n: i64 = data.len();
    if split < 0 { split = 0; }
    if split > n { split = n; }
    var out: list<T> = [];
    var left: i64 = 0;
    var right: i64 = split;
    while left < split && right < n {
        if less(projection(data[right]), projection(data[left])) {
            out.push(data[right]);
            right = right + 1;
        } else {
            out.push(data[left]);
            left = left + 1;
        }
    }
    while left < split { out.push(data[left]); left = left + 1; }
    while right < n { out.push(data[right]); right = right + 1; }
    return out;
}

/// @brief Return the sorted multiset union using `less` as the ordering.
/// Equivalent elements are those for which neither value is less than the
/// other.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn union_sorted_by(left: &list<T>, right: &list<T>, less: Less)
    -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if less(left[i], right[j]) {
            out.push(left[i]);
            i = i + 1;
        } else if less(right[j], left[i]) {
            out.push(right[j]);
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
            j = j + 1;
        }
    }
    while i < left_len {
        out.push(left[i]);
        i = i + 1;
    }
    while j < right_len {
        out.push(right[j]);
        j = j + 1;
    }
    return out;
}

/// @brief Return the sorted multiset intersection using `less` as the ordering.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn intersection_sorted_by(left: &list<T>, right: &list<T>, less: Less)
    -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if less(left[i], right[j]) {
            i = i + 1;
        } else if less(right[j], left[i]) {
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
            j = j + 1;
        }
    }
    return out;
}

/// @brief Return the left multiset difference using `less` as the ordering.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn difference_sorted_by(left: &list<T>, right: &list<T>, less: Less)
    -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if less(left[i], right[j]) {
            out.push(left[i]);
            i = i + 1;
        } else if less(right[j], left[i]) {
            j = j + 1;
        } else {
            i = i + 1;
            j = j + 1;
        }
    }
    while i < left_len {
        out.push(left[i]);
        i = i + 1;
    }
    return out;
}

/// @brief Return the sorted multiset symmetric difference using `less`.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn symmetric_difference_sorted_by(left: &list<T>, right: &list<T>, less: Less)
    -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        if less(left[i], right[j]) {
            out.push(left[i]);
            i = i + 1;
        } else if less(right[j], left[i]) {
            out.push(right[j]);
            j = j + 1;
        } else {
            i = i + 1;
            j = j + 1;
        }
    }
    while i < left_len {
        out.push(left[i]);
        i = i + 1;
    }
    while j < right_len {
        out.push(right[j]);
        j = j + 1;
    }
    return out;
}

/// @brief Return the sorted multiset union by comparator-projected keys.
/// Equivalent values contribute the maximum multiplicity; matched outputs
/// prefer the left-side representative.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn union_sorted_by_projected(left: &list<T>, right: &list<T>,
                                 less: Less, projection: Projection)
    -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        let left_key = projection(left[i]);
        let right_key = projection(right[j]);
        if less(left_key, right_key) {
            out.push(left[i]);
            i = i + 1;
        } else if less(right_key, left_key) {
            out.push(right[j]);
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
            j = j + 1;
        }
    }
    while i < left_len { out.push(left[i]); i = i + 1; }
    while j < right_len { out.push(right[j]); j = j + 1; }
    return out;
}

/// @brief Return the sorted multiset intersection by comparator-projected keys.
/// Matched values use the left-side representative and minimum multiplicity.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn intersection_sorted_by_projected(left: &list<T>, right: &list<T>,
                                         less: Less, projection: Projection)
    -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        let left_key = projection(left[i]);
        let right_key = projection(right[j]);
        if less(left_key, right_key) {
            i = i + 1;
        } else if less(right_key, left_key) {
            j = j + 1;
        } else {
            out.push(left[i]);
            i = i + 1;
            j = j + 1;
        }
    }
    return out;
}

/// @brief Return the left multiset difference by comparator-projected keys.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn difference_sorted_by_projected(left: &list<T>, right: &list<T>,
                                       less: Less, projection: Projection)
    -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        let left_key = projection(left[i]);
        let right_key = projection(right[j]);
        if less(left_key, right_key) {
            out.push(left[i]);
            i = i + 1;
        } else if less(right_key, left_key) {
            j = j + 1;
        } else {
            i = i + 1;
            j = j + 1;
        }
    }
    while i < left_len { out.push(left[i]); i = i + 1; }
    return out;
}

/// @brief Return the multiset symmetric difference by projected ordering.
/// The result has the multiplicity difference of each projected equivalence
/// class and retains original values from the side with extra occurrences.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn symmetric_difference_sorted_by_projected(
    left: &list<T>, right: &list<T>, less: Less, projection: Projection)
    -> list<T> {
    var out: list<T> = [];
    let left_len: i64 = left.len();
    let right_len: i64 = right.len();
    var i: i64 = 0;
    var j: i64 = 0;
    while i < left_len && j < right_len {
        let left_key = projection(left[i]);
        let right_key = projection(right[j]);
        if less(left_key, right_key) {
            out.push(left[i]);
            i = i + 1;
        } else if less(right_key, left_key) {
            out.push(right[j]);
            j = j + 1;
        } else {
            i = i + 1;
            j = j + 1;
        }
    }
    while i < left_len { out.push(left[i]); i = i + 1; }
    while j < right_len { out.push(right[j]); j = j + 1; }
    return out;
}

/// @brief Copy a list, replacing every value equal to `old_value`.
/// C++20 ranges-style replace algorithm; the input remains unchanged.
/// @ingroup algorithm_ranges
generic<T, U, V>
pub fn replace(data: &list<T>, old_value: U, new_value: V) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if data[i] == old_value {
            out.push(new_value);
        } else {
            out.push(data[i]);
        }
    }
    return out;
}

/// @brief Copy a list, replacing elements whose projected key matches.
/// The input is unchanged.
/// @ingroup algorithm_ranges
generic<T, U, V, Projection>
pub fn replace_projected(data: &list<T>, old_value: U, new_value: V,
                         projection: Projection) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if projection(data[i]) == old_value {
            out.push(new_value);
        } else {
            out.push(data[i]);
        }
    }
    return out;
}

/// @brief Copy a list, replacing elements matching `old_value` by equivalence.
/// The input is unchanged.
/// @ingroup algorithm_ranges
generic<T, U, V, Equivalent>
pub fn replace_by(data: &list<T>, old_value: U, new_value: V,
                  equivalent: Equivalent) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if equivalent(data[i], old_value) { out.push(new_value); }
        else { out.push(data[i]); }
    }
    return out;
}

/// @brief Copy a list, replacing values whose projected key is equivalent.
/// `old_key` is compared directly with each projected element key.
/// @ingroup algorithm_ranges
generic<T, U, V, Equivalent, Projection>
pub fn replace_by_projected(data: &list<T>, old_key: U, new_value: V,
                            equivalent: Equivalent,
                            projection: Projection) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        if equivalent(projection(data[i]), old_key) { out.push(new_value); }
        else { out.push(data[i]); }
    }
    return out;
}

/// @brief Copy a list while removing adjacent duplicate values.
/// @ingroup algorithm_ranges
generic<T>
pub fn unique(data: &list<T>) -> list<T> {
    let n: i64 = data.len();
    if n == 0 {
        return [];
    }
    var out: list<T> = [];
    var last: T = data[0];
    out.push(last);
    for i in 1..n {
        let item: T = data[i];
        if item != last {
            out.push(item);
            last = item;
        }
    }
    return out;
}

/// @brief Copy a range while removing adjacent duplicate values.
/// C++20 `std::ranges::unique_copy` counterpart; the source is unchanged.
/// @ingroup algorithm_ranges
generic<T>
pub fn unique_copy(data: &list<T>) -> list<T> {
    return unique(data);
}

/// @brief Copy a list while keeping only each value's first occurrence.
/// @ingroup algorithm_ranges
generic<T>
pub fn unique_stable(data: &list<T>) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let item: T = data[i];
        var found: bool = false;
        let out_len: i64 = out.len();
        for j in 0..out_len {
            if out[j] == item {
                found = true;
                break;
            }
        }
        if found == false {
            out.push(item);
        }
    }
    return out;
}

/// @brief Copy a list with each value clamped to the inclusive bounds.
/// @ingroup algorithm_ranges
generic<T>
pub fn clamp(data: &list<T>, low: T, high: T) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let item: T = data[i];
        if item < low {
            out.push(low);
        } else if item > high {
            out.push(high);
        } else {
            out.push(item);
        }
    }
    return out;
}

/// @brief Clamp a copied list using projected element and bound keys.
/// `low` and `high` must be ordered by their projected keys.
/// @ingroup algorithm_ranges
generic<T, Projection>
pub fn clamp_projected(data: &list<T>, low: T, high: T,
                       projection: Projection) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    if n == 0 { return out; }
    let low_key = projection(low);
    let high_key = projection(high);
    for i in 0..n {
        let item: T = data[i];
        let item_key = projection(item);
        if item_key < low_key {
            out.push(low);
        } else if high_key < item_key {
            out.push(high);
        } else {
            out.push(item);
        }
    }
    return out;
}

/// @brief Copy a list with values clamped according to the ordering `less`.
/// `low` must not follow `high` under the comparator.
/// @ingroup algorithm_ranges
generic<T, Less>
pub fn clamp_by(data: &list<T>, low: T, high: T, less: Less) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let item: T = data[i];
        if less(item, low) {
            out.push(low);
        } else if less(high, item) {
            out.push(high);
        } else {
            out.push(item);
        }
    }
    return out;
}

/// @brief Clamp values using a comparator over projected element and bound keys.
/// `low` must not follow `high` under the combined ordering.
/// @ingroup algorithm_ranges
generic<T, Less, Projection>
pub fn clamp_by_projected(data: &list<T>, low: T, high: T, less: Less,
                          projection: Projection) -> list<T> {
    var out: list<T> = [];
    let n: i64 = data.len();
    if n == 0 { return out; }
    let low_key = projection(low);
    let high_key = projection(high);
    for i in 0..n {
        let item: T = data[i];
        let item_key = projection(item);
        if less(item_key, low_key) {
            out.push(low);
        } else if less(high_key, item_key) {
            out.push(high);
        } else {
            out.push(item);
        }
    }
    return out;
}

/// @brief Return first index of an i64 value, or -1 when not found.
/// @ingroup algorithm_ranges
pub fn find_i64(data: &list<i64>, value: i64) -> i64 {
    let n: i64 = data.len();
    for i in 0..n {
        if data[i] == value {
            return i;
        }
    }
    return -1;
}

/// @brief Return count of elements equal to value.
/// @ingroup algorithm_ranges
pub fn count_i64(data: &list<i64>, value: i64) -> i64 {
    var out: i64 = 0;
    let n: i64 = data.len();
    for i in 0..n {
        if data[i] == value {
            out = out + 1;
        }
    }
    return out;
}

/// @brief Return 1 when value exists; else 0.
/// @ingroup algorithm_ranges
pub fn contains_i64(data: &list<i64>, value: i64) -> i32 {
    return find_i64(data, value) >= 0 ? 1 : 0;
}

/// @brief Return a copy without elements equal to value.
/// Similar to C++ remove-erase style result container.
/// @ingroup algorithm_ranges
pub fn remove_i64(data: &list<i64>, value: i64) -> list<i64> {
    var out: list<i64> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let v: i64 = data[i];
        if v != value {
            out.push(v);
        }
    }
    return out;
}

/// @brief Return first n elements (or all when n >= len).
/// @ingroup algorithm_ranges
pub fn take_i64(data: &list<i64>, n: i64) -> list<i64> {
    var out: list<i64> = [];
    if n <= 0 {
        return out;
    }
    let len: i64 = data.len();
    let end: i64 = n < len ? n : len;
    for i in 0..end {
        out.push(data[i]);
    }
    return out;
}

/// @brief Return elements after skipping first n.
/// @ingroup algorithm_ranges
pub fn drop_i64(data: &list<i64>, n: i64) -> list<i64> {
    var out: list<i64> = [];
    let len: i64 = data.len();
    if n <= 0 {
        for i in 0..len {
            out.push(data[i]);
        }
        return out;
    }
    if n >= len {
        return out;
    }
    for i in n..len {
        out.push(data[i]);
    }
    return out;
}

/// @brief Remove adjacent duplicates and return compacted copy.
/// Equivalent behavior to C++20 `std::ranges::unique` result sequence.
/// @ingroup algorithm_ranges
pub fn unique_i64(data: &list<i64>) -> list<i64> {
    let n: i64 = data.len();
    if n == 0 {
        return [];
    }
    var out: list<i64> = [];
    var last: i64 = data[0];
    out.push(last);
    for i in 1..n {
        let v: i64 = data[i];
        if v != last {
            out.push(v);
            last = v;
        }
    }
    return out;
}

/// @brief Remove all duplicates while preserving first-occurrence order.
/// @ingroup algorithm_ranges
pub fn unique_stable_i64(data: &list<i64>) -> list<i64> {
    var out: list<i64> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let v: i64 = data[i];
        if out.contains(v) == false {
            out.push(v);
        }
    }
    return out;
}

/// @brief Clamp every element to [low, high] and return the result list.
/// @ingroup algorithm_ranges
pub fn clamp_i64(data: &list<i64>, low: i64, high: i64) -> list<i64> {
    var out: list<i64> = [];
    let n: i64 = data.len();
    for i in 0..n {
        let v: i64 = data[i];
        if v < low {
            out.push(low);
        } else if v > high {
            out.push(high);
        } else {
            out.push(v);
        }
    }
    return out;
}

/// @}
