/// \file ssl.mla
/// \brief TLS client/server helpers for MLang (std::ssl).


/// \cond INTERNAL_IMPORTS
mod std::ssl::detail;
use std::ssl::detail::*;
/// \endcond

/// @brief Owned handle to a TLS-accepting server socket.
pub struct TlsListener {
    var handle: i64;
};

/// @brief Owned handle to a TLS-wrapped client/server stream.
pub struct TlsStream {
    var handle: i64;
};

/// @brief Lowercase stdlib type alias for `TlsListener`.
alias tls_listener = TlsListener;

/// @brief Lowercase stdlib type alias for `TlsStream`.
alias tls_stream = TlsStream;


/// @brief Return the last `std::ssl` error message.
/// @return UTF-8 error description, or empty string if none.
pub fn last_error() -> str8 {
    return __mlang_std_ssl_last_error();
}

impl TlsListener {
    /// Bind a TLS listener using PEM certificate and private key files.
    pub fn bind(addr: str8, port: i64, cert_file: str8, key_file: str8) -> Result<TlsListener, str8> {
        let h: i64 = __mlang_std_ssl_listener_bind(addr, port, cert_file, key_file);
        if h == 0 {
            return Err<TlsListener, str8>(last_error());
        }
        return Ok<TlsListener, str8>(TlsListener { handle: h });
    }

    /// @brief Return the port the listener is bound to.
    /// @return `Ok(port)` or an error message.
    pub fn local_port(self: TlsListener) -> Result<i64, str8> {
        let p: i64 = __mlang_std_ssl_listener_local_port(self.handle);
        if p < 0 {
            return Err<i64, str8>(last_error());
        }
        return Ok<i64, str8>(p);
    }

    /// @brief Accept the next incoming TLS connection.
    /// @return A ready-to-use `TlsStream` or an error message.
    pub fn accept(self: TlsListener) -> Result<TlsStream, str8> {
        let h: i64 = __mlang_std_ssl_listener_accept(self.handle);
        if h == 0 {
            return Err<TlsStream, str8>(last_error());
        }
        return Ok<TlsStream, str8>(TlsStream { handle: h });
    }

    /// @brief Close the listener socket.
    /// @return 0 on success.
    pub fn close(self: TlsListener) -> i32 {
        return __mlang_std_ssl_listener_close(self.handle);
    }

    /// @brief Wrap an owned raw handle in a `TlsListener`.
    /// @param handle Native handle previously produced by `std::ssl`.
    /// @return Wrapping `TlsListener`.
    pub fn from_handle(handle: i64) -> TlsListener {
        return TlsListener { handle: handle };
    }

    /// @brief Return the underlying raw handle.
    /// @return Raw integer handle.
    pub fn raw_handle(self: TlsListener) -> i64 {
        return self.handle;
    }
}

impl TlsStream {
    /// Connect using system trust roots and hostname verification.
    pub fn connect(host: str8, port: i64) -> Result<TlsStream, str8> {
        return TlsStream::connect_with_options(host, port, host, "", 1);
    }

    /// Connect with explicit server-name verification and CA bundle override.
    /// When `verify_peer == 0`, certificate verification is disabled.
    pub fn connect_with_options(host: str8, port: i64, server_name: str8, ca_file: str8, verify_peer: i32) -> Result<TlsStream, str8> {
        let h: i64 = __mlang_std_ssl_client_connect(host, port, server_name, ca_file, verify_peer);
        if h == 0 {
            return Err<TlsStream, str8>(last_error());
        }
        return Ok<TlsStream, str8>(TlsStream { handle: h });
    }

    /// @brief Read up to `capacity` bytes into `buf`.
    /// @param buf Destination buffer (reused in-place).
    /// @param capacity Maximum bytes to read.
    /// @return Bytes read (0 = EOF) or an error message.
    pub fn read(self: TlsStream, buf: str8, capacity: i64) -> Result<i64, str8> {
        let n: i64 = __mlang_std_ssl_stream_read(self.handle, buf, capacity);
        if n < 0 {
            return Err<i64, str8>(last_error());
        }
        return Ok<i64, str8>(n);
    }

    /// @brief Write all bytes of `s` to the stream.
    /// @param s Payload bytes.
    /// @return Bytes written or an error message.
    pub fn write(self: TlsStream, s: str8) -> Result<i64, str8> {
        let n: i64 = __mlang_std_ssl_stream_write(self.handle, s);
        if n < 0 {
            return Err<i64, str8>(last_error());
        }
        return Ok<i64, str8>(n);
    }

    /// @brief Apply a read timeout in milliseconds (0 disables).
    /// @param timeout_ms Timeout in milliseconds.
    /// @return `Ok(0)` on success, else error message.
    pub fn set_read_timeout_ms(self: TlsStream, timeout_ms: i64) -> Result<i32, str8> {
        let rc: i32 = __mlang_std_ssl_stream_set_read_timeout_ms(self.handle, timeout_ms);
        if rc != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Apply a write timeout in milliseconds (0 disables).
    /// @param timeout_ms Timeout in milliseconds.
    /// @return `Ok(0)` on success, else error message.
    pub fn set_write_timeout_ms(self: TlsStream, timeout_ms: i64) -> Result<i32, str8> {
        let rc: i32 = __mlang_std_ssl_stream_set_write_timeout_ms(self.handle, timeout_ms);
        if rc != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// Construct a TLS stream wrapper from an owned raw handle.
    /// Caller must ensure the handle is valid and closed exactly once.
    pub fn from_handle(handle: i64) -> TlsStream {
        return TlsStream { handle: handle };
    }

    /// Expose underlying TLS stream handle for handoff patterns.
    pub fn raw_handle(self: TlsStream) -> i64 {
        return self.handle;
    }

    /// @brief Close the TLS stream, flushing any pending shutdown.
    /// @return 0 on success, non-zero on error.
    pub fn close(self: TlsStream) -> i32 {
        return __mlang_std_ssl_stream_close(self.handle);
    }
}
