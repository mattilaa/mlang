/// \file math.mla
/// \brief Generic math helpers for MLang (std::math).
///
/// Functions here are backed by the stdlib native library (libmlang_std).

// std::math - generic math helpers

extern fn __mlang_std_math_add_i32(a: int, b: int) -> int;
extern fn __mlang_std_math_add_f32(a: float, b: float) -> float;
extern fn __mlang_std_math_add_f64(a: double, b: double) -> double;
extern fn __mlang_std_math_subtract_i32(a: int, b: int) -> int;
extern fn __mlang_std_math_subtract_f32(a: float, b: float) -> float;
extern fn __mlang_std_math_subtract_f64(a: double, b: double) -> double;
extern fn __mlang_std_math_multiply_i32(a: int, b: int) -> int;
extern fn __mlang_std_math_multiply_f32(a: float, b: float) -> float;
extern fn __mlang_std_math_multiply_f64(a: double, b: double) -> double;
extern fn __mlang_std_math_square_i32(x: int) -> int;
extern fn __mlang_std_math_square_f32(x: float) -> float;
extern fn __mlang_std_math_square_f64(x: double) -> double;
extern fn __mlang_std_math_sum_range_i32(start: int, end: int) -> int;
extern fn __mlang_std_math_factorial_i32(n: int) -> int;
extern fn __mlang_std_math_abs_i32(x: int) -> int;
extern fn __mlang_std_math_abs_f32(x: float) -> float;
extern fn __mlang_std_math_abs_f64(x: double) -> double;
extern fn __mlang_std_math_min_i32(a: int, b: int) -> int;
extern fn __mlang_std_math_min_f32(a: float, b: float) -> float;
extern fn __mlang_std_math_min_f64(a: double, b: double) -> double;
extern fn __mlang_std_math_max_i32(a: int, b: int) -> int;
extern fn __mlang_std_math_max_f32(a: float, b: float) -> float;
extern fn __mlang_std_math_max_f64(a: double, b: double) -> double;
extern fn __mlang_std_math_clamp_i32(x: int, low: int, high: int) -> int;
extern fn __mlang_std_math_clamp_f32(x: float, low: float, high: float) -> float;
extern fn __mlang_std_math_clamp_f64(x: double, low: double, high: double) -> double;
extern fn __mlang_std_math_pow_i32(a: int, b: int) -> int;
extern fn __mlang_std_math_pow_f32(a: float, b: float) -> float;
extern fn __mlang_std_math_pow_f64(a: double, b: double) -> double;
extern fn __mlang_std_math_sqrt_i32(x: int) -> int;
extern fn __mlang_std_math_sqrt_f32(x: float) -> float;
extern fn __mlang_std_math_sqrt_f64(x: double) -> double;
extern fn __mlang_std_math_sin_i32(x: int) -> int;
extern fn __mlang_std_math_sin_f32(x: float) -> float;
extern fn __mlang_std_math_sin_f64(x: double) -> double;
extern fn __mlang_std_math_cos_i32(x: int) -> int;
extern fn __mlang_std_math_cos_f32(x: float) -> float;
extern fn __mlang_std_math_cos_f64(x: double) -> double;
extern fn __mlang_std_math_tan_i32(x: int) -> int;
extern fn __mlang_std_math_tan_f32(x: float) -> float;
extern fn __mlang_std_math_tan_f64(x: double) -> double;
extern fn __mlang_std_math_floor_i32(x: int) -> int;
extern fn __mlang_std_math_floor_f32(x: float) -> float;
extern fn __mlang_std_math_floor_f64(x: double) -> double;
