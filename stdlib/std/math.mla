/// \file math.mla
/// \brief Generic math helpers for MLang (std::math).
///
/// Functions here are backed by the stdlib native library (libmlang_std).

// std::math - generic math helpers

/// \cond INTERNAL_IMPORTS
mod std::math::detail;
use std::math::detail::*;
mod std::ops;
use std::ops::*;
/// \endcond

/// @brief Add two values.
/// @param a a value.
/// @param b b value.
/// @return Add two values.
pub fn add(a: i32, b: i32) -> i32 {
    return __mlang_std_math_add_i32(a, b);
}

/// @brief Add two values.
/// @param a a value.
/// @param b b value.
/// @return Add two values.
pub fn add(a: f32, b: f32) -> f32 {
    return __mlang_std_math_add_f32(a, b);
}

/// @brief Add two values.
