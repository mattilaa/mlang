/// @brief Generic complex number value (Rust-like `Complex<T>` style).
/// @note Arithmetic methods require `T` to support the used operators.
pub struct Complex<T> {
    /// @brief Real part.
    var re: T;
    /// @brief Imaginary part.
    var im: T;
};

/// @brief Lowercase stdlib type alias for `Complex`.
alias complex<T> = Complex<T>;


impl<T> Complex {
    /// @brief Construct a complex number from real and imaginary parts.
    pub fn new(re: T, im: T) -> Complex<T> {
        return Complex<T> { re: re, im: im };
    }

    /// @brief Complex conjugate.
    pub fn conj(self: Complex<T>) -> Complex<T> {
        return Complex<T> { re: self.re, im: -self.im };
    }

    /// @brief Squared magnitude (`re^2 + im^2`).
    pub fn norm_sqr(self: Complex<T>) -> T {
        return (self.re * self.re) + (self.im * self.im);
    }
    /// @brief Magnitude.
    pub fn abs(self: Complex<T>) -> T {
        return sqrt((self.re * self.re) + (self.im * self.im));
    }
}

impl<T> Add for Complex {
    fn add(self: &mut Self, other: Complex<T>) -> Complex<T> {
        return Complex<T> {
            re: self.re + other.re,
            im: self.im + other.im
        };
    }
}

impl<T> Sub for Complex {
    fn sub(self: &mut Self, other: Complex<T>) -> Complex<T> {
        return Complex<T> {
            re: self.re - other.re,
            im: self.im - other.im
        };
    }
}

impl<T> Mul for Complex {
    fn mul(self: &mut Self, other: Complex<T>) -> Complex<T> {
        return Complex<T> {
            re: (self.re * other.re) - (self.im * other.im),
            im: (self.re * other.im) + (self.im * other.re)
        };
    }
}

impl<T> Neg for Complex {
    fn neg(self: &mut Self) -> Complex<T> {
        return Complex<T> { re: -self.re, im: -self.im };
    }
}

