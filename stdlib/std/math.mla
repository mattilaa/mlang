/// @brief Clamp a value to [low, high].
/// @param x x value.
/// @param low low value.
/// @param high high value.
/// @return Clamp a value to [low, high].
pub fn clamp(x: int, low: int, high: int) -> int {
    return __mlang_std_math_clamp_i32(x, low, high);
}

/// @brief Clamp a value to [low, high].
/// @param x x value.
/// @param low low value.
/// @param high high value.
/// @return Clamp a value to [low, high].
pub fn clamp(x: float, low: float, high: float) -> float {
    return __mlang_std_math_clamp_f32(x, low, high);
}

/// @brief Clamp a value to [low, high].
/// @param x x value.
/// @param low low value.
/// @param high high value.
/// @return Clamp a value to [low, high].
pub fn clamp(x: double, low: double, high: double) -> double {
    return __mlang_std_math_clamp_f64(x, low, high);
}

/// @brief Power function (x^y).
/// @param a a value.
/// @param b b value.
/// @return Power function (x^y).
pub fn pow(a: int, b: int) -> int {
    return __mlang_std_math_pow_i32(a, b);
}

