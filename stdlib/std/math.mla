extern fn __mlang_std_math_ceil_f32(x: float) -> float;
extern fn __mlang_std_math_ceil_f64(x: double) -> double;
extern fn __mlang_std_math_round_i32(x: int) -> int;
extern fn __mlang_std_math_round_f32(x: float) -> float;
extern fn __mlang_std_math_round_f64(x: double) -> double;
extern fn __mlang_std_math_log_i32(x: int) -> int;
extern fn __mlang_std_math_log_f32(x: float) -> float;
extern fn __mlang_std_math_log_f64(x: double) -> double;
extern fn __mlang_std_math_exp_i32(x: int) -> int;
extern fn __mlang_std_math_exp_f32(x: float) -> float;
extern fn __mlang_std_math_exp_f64(x: double) -> double;
