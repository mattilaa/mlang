/// @brief Add two values.
/// @param a a value.
/// @param b b value.
/// @return Add two values.
pub fn add(a: int, b: int) -> int {
    return __mlang_std_math_add_i32(a, b);
}

/// @brief Add two values.
/// @param a a value.
/// @param b b value.
/// @return Add two values.
pub fn add(a: float, b: float) -> float {
    return __mlang_std_math_add_f32(a, b);
}

/// @brief Add two values.
/// @param a a value.
/// @param b b value.
/// @return Add two values.
pub fn add(a: double, b: double) -> double {
    return __mlang_std_math_add_f64(a, b);
}

/// @brief Subtract two values.
/// @param a a value.
/// @param b b value.
/// @return Subtract two values.
pub fn subtract(a: int, b: int) -> int {
    return __mlang_std_math_subtract_i32(a, b);
}

/// @brief Subtract two values.
/// @param a a value.
/// @param b b value.
/// @return Subtract two values.
pub fn subtract(a: float, b: float) -> float {
    return __mlang_std_math_subtract_f32(a, b);
}

/// @brief Subtract two values.
/// @param a a value.
/// @param b b value.
/// @return Subtract two values.
pub fn subtract(a: double, b: double) -> double {
    return __mlang_std_math_subtract_f64(a, b);
}

/// @brief Multiply two values.
/// @param a a value.
/// @param b b value.
/// @return Multiply two values.
pub fn multiply(a: int, b: int) -> int {
    return __mlang_std_math_multiply_i32(a, b);
}

/// @brief Multiply two values.
/// @param a a value.
/// @param b b value.
/// @return Multiply two values.
pub fn multiply(a: float, b: float) -> float {
    return __mlang_std_math_multiply_f32(a, b);
}

/// @brief Multiply two values.
/// @param a a value.
/// @param b b value.
/// @return Multiply two values.
pub fn multiply(a: double, b: double) -> double {
    return __mlang_std_math_multiply_f64(a, b);
}

/// @brief Square a value.
/// @param x x value.
/// @return Square a value.
pub fn square(x: int) -> int {
    return __mlang_std_math_square_i32(x);
}

/// @brief Square a value.
/// @param x x value.
/// @return Square a value.
pub fn square(x: float) -> float {
    return __mlang_std_math_square_f32(x);
}

/// @brief Square a value.
/// @param x x value.
/// @return Square a value.
pub fn square(x: double) -> double {
    return __mlang_std_math_square_f64(x);
}

/// @brief Sum integers in [start, end) (end is exclusive).
/// @param start start value.
/// @param end end value.
/// @return Sum integers in [start, end) (end is exclusive).
pub fn sum_range(start: int, end: int) -> int {
    return __mlang_std_math_sum_range_i32(start, end);
}

/// @brief Factorial for n >= 0.
/// @param n n value.
/// @return Factorial for n >= 0.
pub fn factorial(n: int) -> int {
    return __mlang_std_math_factorial_i32(n);
}

/// @brief Absolute value.
/// @param x x value.
/// @return Absolute value.
pub fn abs(x: int) -> int {
    return __mlang_std_math_abs_i32(x);
}

/// @brief Absolute value.
/// @param x x value.
/// @return Absolute value.
pub fn abs(x: float) -> float {
    return __mlang_std_math_abs_f32(x);
}

/// @brief Absolute value.
/// @param x x value.
/// @return Absolute value.
pub fn abs(x: double) -> double {
    return __mlang_std_math_abs_f64(x);
}

/// @brief Minimum of two values.
/// @param a a value.
/// @param b b value.
/// @return Minimum of two values.
pub fn min(a: int, b: int) -> int {
    return __mlang_std_math_min_i32(a, b);
}

/// @brief Minimum of two values.
/// @param a a value.
/// @param b b value.
/// @return Minimum of two values.
pub fn min(a: float, b: float) -> float {
    return __mlang_std_math_min_f32(a, b);
}

/// @brief Minimum of two values.
/// @param a a value.
/// @param b b value.
/// @return Minimum of two values.
pub fn min(a: double, b: double) -> double {
    return __mlang_std_math_min_f64(a, b);
}

/// @brief Maximum of two values.
/// @param a a value.
/// @param b b value.
/// @return Maximum of two values.
pub fn max(a: int, b: int) -> int {
    return __mlang_std_math_max_i32(a, b);
}

/// @brief Maximum of two values.
/// @param a a value.
/// @param b b value.
