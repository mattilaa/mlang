/// \file toml.mla
/// \brief Runtime-bound TOML helpers used by package-manager tooling (std::toml).
///
/// This is a compact facade over host/runtime TOML functions.


/// \cond INTERNAL_IMPORTS
mod std::toml::detail;
use std::toml::detail::*;
/// \endcond

/// @brief Opaque TOML document handle.
pub struct TomlDoc {
    var handle: i64;
};

/// @brief Parse TOML text into an opaque handle.
pub fn parse(text: str8) -> TomlDoc {
    return TomlDoc { handle: __toml_parse(text) };
}

/// @brief Read string value by dotted key path with fallback.
pub fn get_string(doc: &TomlDoc, key: str8, fallback: str8) -> str8 {
    return __toml_get_string(doc.handle, key, fallback);
}

/// @brief Set `key.field = "value"` style inline table entry.
pub fn set_inline_table(doc: &TomlDoc, key: str8, field_name: str8, value: str8) -> void {
    __toml_set_inline_table(doc.handle, key, field_name, value);
}

/// @brief Serialize document back to TOML text.
pub fn stringify(doc: &TomlDoc) -> str8 {
    return __toml_stringify(doc.handle);
}

// Compatibility names used by imported mlangpkg prototype.

/// @brief Compatibility alias for `parse(text)`.
/// @param text TOML source text.
/// @return Parsed document handle.
pub fn toml_parse(text: str8) -> TomlDoc { return parse(text); }
/// @brief Compatibility alias for `get_string(doc, key, fallback)`.
/// @param doc Parsed document reference.
/// @param key Dotted key path.
/// @param fallback Value returned when the key is missing.
/// @return Stored string or `fallback`.
pub fn toml_get_string(doc: &TomlDoc, key: str8, fallback: str8) -> str8 { return get_string(doc, key, fallback); }
/// @brief Compatibility alias for `set_inline_table(doc, key, field_name, value)`.
/// @param doc Parsed document reference.
/// @param key Table name.
/// @param field_name Field name inside the inline table.
/// @param value New string value.
pub fn toml_set_inline_table(doc: &TomlDoc, key: str8, field_name: str8, value: str8) -> void { set_inline_table(doc, key, field_name, value); }
/// @brief Compatibility alias for `stringify(doc)`.
/// @param doc Parsed document reference.
/// @return Serialized TOML text.
pub fn toml_stringify(doc: &TomlDoc) -> str8 { return stringify(doc); }
