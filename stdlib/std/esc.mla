/// \file esc.mla
/// \brief ANSI terminal escape helpers for MLang (std::esc).
///
/// Provides named value-sets for:
/// - foreground/background colors
/// - text styles (bold, underline, inverse)
/// - cursor controls (home, clear, show/hide, move)
///
/// Ownership: `std::esc` helpers mostly return borrowed/static escape strings.
/// Treat returned `str8` values as read-only and do not pass them to `String::free()`.
/// ACS box-drawing helpers are the exception: they return owned formatted strings.
///
/// Escape sequences auto-disable when `std::term::supports_ansi()` is false.

extern pub fn __mlang_std_esc_reset() -> str8;
extern pub fn __mlang_std_esc_sgr_code(code: i32) -> str8;
extern pub fn __mlang_std_esc_sgr_palette(is_bg: i32, idx: i32) -> str8;
extern pub fn __mlang_std_esc_sgr_rgb(is_bg: i32, r: i32, g: i32, b: i32) -> str8;
extern pub fn __mlang_std_esc_cursor_code(code: i32) -> str8;
extern pub fn __mlang_std_esc_cursor_move(dir: i32, amount: i32) -> str8;
extern pub fn __mlang_std_esc_cursor_pos(row1: i32, col1: i32) -> str8;
extern pub fn __mlang_std_esc_cursor_style(style: i32) -> str8;
extern pub fn __mlang_std_esc_cursor_color_rgb(r: i32, g: i32, b: i32) -> str8;
extern pub fn __mlang_std_esc_cursor_color_reset() -> str8;
extern pub fn __mlang_std_term_stdout_supports_ansi() -> i32;

use type Color = i32;
use type CursorCommand = i32;
use type CursorDirection = i32;

fn ansi_enabled() -> i32 {
    return __mlang_std_term_stdout_supports_ansi();
}

/// @brief Color value helpers.
pub fn color_default() -> Color { return 0; }
pub fn color_black() -> Color { return 1; }
pub fn color_red() -> Color { return 2; }
pub fn color_green() -> Color { return 3; }
pub fn color_yellow() -> Color { return 4; }
pub fn color_blue() -> Color { return 5; }
pub fn color_magenta() -> Color { return 6; }
pub fn color_cyan() -> Color { return 7; }
pub fn color_white() -> Color { return 8; }
pub fn color_bright_black() -> Color { return 9; }
pub fn color_bright_red() -> Color { return 10; }
pub fn color_bright_green() -> Color { return 11; }
pub fn color_bright_yellow() -> Color { return 12; }
pub fn color_bright_blue() -> Color { return 13; }
pub fn color_bright_magenta() -> Color { return 14; }
pub fn color_bright_cyan() -> Color { return 15; }
pub fn color_bright_white() -> Color { return 16; }

/// @brief Cursor command value helpers.
pub fn cmd_home() -> CursorCommand { return 0; }
pub fn cmd_clear_screen() -> CursorCommand { return 1; }
pub fn cmd_clear_line() -> CursorCommand { return 2; }
pub fn cmd_hide() -> CursorCommand { return 3; }
pub fn cmd_show() -> CursorCommand { return 4; }
pub fn cmd_save() -> CursorCommand { return 5; }
pub fn cmd_restore() -> CursorCommand { return 6; }

/// @brief Cursor direction value helpers.
pub fn dir_up() -> CursorDirection { return 0; }
pub fn dir_down() -> CursorDirection { return 1; }
pub fn dir_right() -> CursorDirection { return 2; }
pub fn dir_left() -> CursorDirection { return 3; }

fn fg_code(c: Color) -> i32 {
    if c == color_black() { return 30; }
    if c == color_red() { return 31; }
    if c == color_green() { return 32; }
    if c == color_yellow() { return 33; }
    if c == color_blue() { return 34; }
    if c == color_magenta() { return 35; }
    if c == color_cyan() { return 36; }
    if c == color_white() { return 37; }
    if c == color_bright_black() { return 90; }
    if c == color_bright_red() { return 91; }
    if c == color_bright_green() { return 92; }
    if c == color_bright_yellow() { return 93; }
    if c == color_bright_blue() { return 94; }
    if c == color_bright_magenta() { return 95; }
    if c == color_bright_cyan() { return 96; }
    if c == color_bright_white() { return 97; }
    return 39;
}

fn bg_code(c: Color) -> i32 {
    if c == color_black() { return 40; }
    if c == color_red() { return 41; }
    if c == color_green() { return 42; }
    if c == color_yellow() { return 43; }
    if c == color_blue() { return 44; }
    if c == color_magenta() { return 45; }
    if c == color_cyan() { return 46; }
    if c == color_white() { return 47; }
    if c == color_bright_black() { return 100; }
    if c == color_bright_red() { return 101; }
    if c == color_bright_green() { return 102; }
    if c == color_bright_yellow() { return 103; }
    if c == color_bright_blue() { return 104; }
    if c == color_bright_magenta() { return 105; }
    if c == color_bright_cyan() { return 106; }
    if c == color_bright_white() { return 107; }
    return 49;
}

/// @brief Reset all SGR styles/colors. Returns a borrowed/static string; do not free.
pub fn reset() -> str8 {
    if ansi_enabled() == 0 { return ""; }
    return __mlang_std_esc_reset();
}

/// @brief Set foreground color. Returns a borrowed/static string; do not free.
pub fn fg(color: Color) -> str8 {
    if ansi_enabled() == 0 { return ""; }
    return __mlang_std_esc_sgr_code(fg_code(color));
}

/// @brief Set background color. Returns a borrowed/static string; do not free.
pub fn bg(color: Color) -> str8 {
    if ansi_enabled() == 0 { return ""; }
    return __mlang_std_esc_sgr_code(bg_code(color));
}

/// @brief Set 256-color foreground (0..255). Returns a borrowed/static string; do not free.
pub fn fg_256(index: i32) -> str8 {
    if ansi_enabled() == 0 { return ""; }
    return __mlang_std_esc_sgr_palette(0, index);
}

/// @brief Set 256-color background (0..255). Returns a borrowed/static string; do not free.
pub fn bg_256(index: i32) -> str8 {
    if ansi_enabled() == 0 { return ""; }
    return __mlang_std_esc_sgr_palette(1, index);
}

/// @brief Set truecolor foreground using RGB channels (0..255 each). Returns a borrowed/static string; do not free.
pub fn fg_rgb(r: i32, g: i32, b: i32) -> str8 {
    if ansi_enabled() == 0 { return ""; }
    return __mlang_std_esc_sgr_rgb(0, r, g, b);
}

/// @brief Set truecolor background using RGB channels (0..255 each). Returns a borrowed/static string; do not free.
pub fn bg_rgb(r: i32, g: i32, b: i32) -> str8 {
    if ansi_enabled() == 0 { return ""; }
    return __mlang_std_esc_sgr_rgb(1, r, g, b);
}

/// @brief Enable bold text. Returns a borrowed/static string; do not free.
pub fn bold_on() -> str8 {
    if ansi_enabled() == 0 { return ""; }
    return __mlang_std_esc_sgr_code(1);
}

/// @brief Disable bold/dim text. Returns a borrowed/static string; do not free.
pub fn bold_off() -> str8 {
    if ansi_enabled() == 0 { return ""; }
    return __mlang_std_esc_sgr_code(22);
}

/// @brief Enable underline. Returns a borrowed/static string; do not free.
pub fn underline_on() -> str8 {
    if ansi_enabled() == 0 { return ""; }
    return __mlang_std_esc_sgr_code(4);
}

/// @brief Disable underline. Returns a borrowed/static string; do not free.
pub fn underline_off() -> str8 {
    if ansi_enabled() == 0 { return ""; }
    return __mlang_std_esc_sgr_code(24);
}

/// @brief Enable inverse video. Returns a borrowed/static string; do not free.
pub fn inverse_on() -> str8 {
    if ansi_enabled() == 0 { return ""; }
    return __mlang_std_esc_sgr_code(7);
}

/// @brief Disable inverse video. Returns a borrowed/static string; do not free.
pub fn inverse_off() -> str8 {
    if ansi_enabled() == 0 { return ""; }
    return __mlang_std_esc_sgr_code(27);
}

/// @brief Return a cursor control escape sequence. Returns a borrowed/static string; do not free.
pub fn cursor(cmd: CursorCommand) -> str8 {
    if ansi_enabled() == 0 { return ""; }
    return __mlang_std_esc_cursor_code(cmd);
}

/// @brief Move cursor by `amount` in given direction. Returns a borrowed/static string; do not free.
pub fn cursor_move(dir: CursorDirection, amount: i32) -> str8 {
    if ansi_enabled() == 0 { return ""; }
    return __mlang_std_esc_cursor_move(dir, amount);
}

/// @brief Move cursor to 1-based absolute terminal position. Returns a borrowed/static string; do not free.
pub fn cursor_pos(row1: i32, col1: i32) -> str8 {
    if ansi_enabled() == 0 { return ""; }
    return __mlang_std_esc_cursor_pos(row1, col1);
}

/// @brief Set terminal cursor shape. Common values: 1/2 block, 3/4 underline, 5/6 bar. Returns a borrowed/static string; do not free.
pub fn cursor_style(style: i32) -> str8 {
    if ansi_enabled() == 0 { return ""; }
    return __mlang_std_esc_cursor_style(style);
}

/// @brief Blinking thin bar cursor. Returns a borrowed/static string; do not free.
pub fn cursor_blink_bar() -> str8 {
    return cursor_style(5);
}

/// @brief Blinking underline cursor. Returns a borrowed/static string; do not free.
pub fn cursor_blink_underline() -> str8 {
    return cursor_style(3);
}

/// @brief Steady underline cursor. Returns a borrowed/static string; do not free.
pub fn cursor_steady_underline() -> str8 {
    return cursor_style(4);
}

/// @brief Steady thin bar cursor. Returns a borrowed/static string; do not free.
pub fn cursor_steady_bar() -> str8 {
    return cursor_style(6);
}

/// @brief Set terminal cursor color using RGB channels. Returns a borrowed/static string; do not free.
pub fn cursor_color_rgb(r: i32, g: i32, b: i32) -> str8 {
    if ansi_enabled() == 0 { return ""; }
    return __mlang_std_esc_cursor_color_rgb(r, g, b);
}

/// @brief Reset terminal cursor color to the terminal default. Returns a borrowed/static string; do not free.
pub fn cursor_color_reset() -> str8 {
    if ansi_enabled() == 0 { return ""; }
    return __mlang_std_esc_cursor_color_reset();
}

/// @brief Enter alternate screen buffer (ncurses-like full-screen mode). Returns a borrowed/static string; do not free.
pub fn alt_screen_on() -> str8 {
    if ansi_enabled() == 0 { return ""; }
    return "\x1b[?1049h";
}

/// @brief Leave alternate screen buffer. Returns a borrowed/static string; do not free.
pub fn alt_screen_off() -> str8 {
    if ansi_enabled() == 0 { return ""; }
    return "\x1b[?1049l";
}

/// @brief Clear from cursor to end-of-line. Returns a borrowed/static string; do not free.
pub fn clear_eol() -> str8 {
    if ansi_enabled() == 0 { return ""; }
    return "\x1b[K";
}

/// @brief ncurses-style standout aliases.
pub fn standout_on() -> str8 { return inverse_on(); }
pub fn standout_off() -> str8 { return inverse_off(); }

/// @brief ncurses-style ACS line-drawing (ASCII-safe).

/// @brief Cursor shape (DECSCUSR). Returns a borrowed/static string; do not free.
pub fn cursor_blink_bar() -> str8 {
    if ansi_enabled() == 0 { return ""; }
    return "\x1b[5 q";
}

pub fn cursor_reset_shape() -> str8 {
    if ansi_enabled() == 0 { return ""; }
    return "\x1b[0 q";
}

/// @brief Box-drawing horizontal line glyph. Returns an owned formatted string.
pub fn acs_hline() -> str8 { return format!("{}", "─"); }
/// @brief Box-drawing vertical line glyph. Returns an owned formatted string.
pub fn acs_vline() -> str8 { return format!("{}", "│"); }
/// @brief Box-drawing upper-left corner glyph. Returns an owned formatted string.
pub fn acs_ulcorner() -> str8 { return format!("{}", "┌"); }
/// @brief Box-drawing upper-right corner glyph. Returns an owned formatted string.
pub fn acs_urcorner() -> str8 { return format!("{}", "┐"); }
/// @brief Box-drawing lower-left corner glyph. Returns an owned formatted string.
pub fn acs_llcorner() -> str8 { return format!("{}", "└"); }
/// @brief Box-drawing lower-right corner glyph. Returns an owned formatted string.
pub fn acs_lrcorner() -> str8 { return format!("{}", "┘"); }
/// @brief Box-drawing left tee glyph. Returns an owned formatted string.
pub fn acs_ltee() -> str8 { return format!("{}", "├"); }
/// @brief Box-drawing right tee glyph. Returns an owned formatted string.
pub fn acs_rtee() -> str8 { return format!("{}", "┤"); }
/// @brief Box-drawing top tee glyph. Returns an owned formatted string.
pub fn acs_ttee() -> str8 { return format!("{}", "┬"); }
/// @brief Box-drawing bottom tee glyph. Returns an owned formatted string.
pub fn acs_btee() -> str8 { return format!("{}", "┴"); }
/// @brief Box-drawing cross glyph. Returns an owned formatted string.
pub fn acs_plus() -> str8 { return format!("{}", "┼"); }
