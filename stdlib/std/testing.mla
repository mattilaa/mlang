/// @ingroup std_testing
pub fn expect_eq(expected: string, actual: string) -> void {
    __mlang_std_testing_expect_eq_string(expected, actual);
}

/// Expect inequality for string values.
/// @ingroup std_testing
pub fn expect_not_eq(left: string, right: string) -> void {
    __mlang_std_testing_expect_not_eq_string(left, right);
}

/// Expect equality for f32 values.
/// @ingroup std_testing
pub fn expect_eq(expected: f32, actual: f32) -> void {
    __mlang_std_testing_expect_eq_f32(expected, actual);
}

/// Expect inequality for f32 values.
/// @ingroup std_testing
pub fn expect_not_eq(left: f32, right: f32) -> void {
    __mlang_std_testing_expect_not_eq_f32(left, right);
}

/// Expect equality for f64 values.
/// @ingroup std_testing
pub fn expect_eq(expected: f64, actual: f64) -> void {
    __mlang_std_testing_expect_eq_f64(expected, actual);
}

/// Expect inequality for f64 values.
/// @ingroup std_testing
pub fn expect_not_eq(left: f64, right: f64) -> void {
    __mlang_std_testing_expect_not_eq_f64(left, right);
}

/// Verify condition is true. Fatal on failure (aborts immediately).
/// @ingroup std_testing
pub fn verify_true(cond: bool) -> void {
    __mlang_std_testing_verify_true(bool_to_i32(cond));
}

/// Verify condition is true. Fatal on failure (aborts immediately).
/// @ingroup std_testing
pub fn verify(cond: bool) -> void {
    verify_true(cond);
}

/// Verify condition is false. Fatal on failure (aborts immediately).
/// @ingroup std_testing
pub fn verify_false(cond: bool) -> void {
    __mlang_std_testing_verify_false(bool_to_i32(cond));
}

/// Explicit i32 verify helper (avoids overload ambiguity for integer literals).
/// @ingroup std_testing
pub fn verify_eq_i32(expected: i32, actual: i32) -> void {
    __mlang_std_testing_verify_eq_i32(expected, actual);
}

/// Verify equality for i64 values. Fatal on failure.
/// @ingroup std_testing
pub fn verify_eq(expected: i64, actual: i64) -> void {
    __mlang_std_testing_verify_eq_i64(expected, actual);
}

/// Verify inequality for i32 values. Fatal on failure.
/// @ingroup std_testing
pub fn verify_not_eq_i32(left: i32, right: i32) -> void {
    __mlang_std_testing_verify_not_eq_i32(left, right);
}

