/// Expect inequality for i64 arrays (non-fatal).
/// Passes when arrays differ by length or at least one element.
/// @ingroup std_testing
pub fn expect_array_not_eq(left: &list<i64>, right: &list<i64>) -> void {
    if left.len() != right.len() {
        expect_true(true);
        return;
    }
    let n: i64 = left.len();
    for i in 0..n {
        if left[i] != right[i] {
            expect_true(true);
            return;
        }
    }
    expect_true(false);
}

/// Expect inequality for i32 arrays (non-fatal).
/// Passes when arrays differ by length or at least one element.
/// @ingroup std_testing
pub fn expect_array_not_eq(left: &list<i32>, right: &list<i32>) -> void {
    if left.len() != right.len() {
        expect_true(true);
        return;
    }
    let n: i64 = left.len();
    for i in 0..n {
        if left[i] != right[i] {
            expect_true(true);
            return;
        }
    }
    expect_true(false);
}

