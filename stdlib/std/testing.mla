/// \file testing.mla
/// \brief GoogleTest-like non-fatal expectation helpers for MLang tests.

extern pub fn __mlang_std_testing_reset() -> void;
extern pub fn __mlang_std_testing_checks() -> i32;
extern pub fn __mlang_std_testing_failures() -> i32;
extern pub fn __mlang_std_testing_result() -> i32;
extern pub fn __mlang_std_testing_set_quiet(enabled: i32) -> void;
extern pub fn __mlang_std_testing_expect_true(cond: i32) -> void;
extern pub fn __mlang_std_testing_expect_false(cond: i32) -> void;
extern pub fn __mlang_std_testing_expect_eq_i32(expected: i32,
                                                actual: i32) -> void;
extern pub fn __mlang_std_testing_expect_eq_i64(expected: i64,
                                                actual: i64) -> void;
extern pub fn __mlang_std_testing_expect_eq_bool(expected: i32,
                                                 actual: i32) -> void;
extern pub fn __mlang_std_testing_expect_eq_string(expected: string,
                                                   actual: string) -> void;
extern pub fn __mlang_std_testing_expect_eq_f32(expected: f32,
                                                actual: f32) -> void;
extern pub fn __mlang_std_testing_expect_eq_f64(expected: f64,
                                                actual: f64) -> void;
extern pub fn __mlang_std_testing_verify_true(cond: i32) -> void;
extern pub fn __mlang_std_testing_verify_false(cond: i32) -> void;
extern pub fn __mlang_std_testing_verify_eq_i32(expected: i32,
                                                actual: i32) -> void;
extern pub fn __mlang_std_testing_verify_eq_i64(expected: i64,
                                                actual: i64) -> void;
extern pub fn __mlang_std_testing_verify_eq_bool(expected: i32,
                                                 actual: i32) -> void;
extern pub fn __mlang_std_testing_verify_eq_string(expected: string,
                                                   actual: string) -> void;
extern pub fn __mlang_std_testing_verify_eq_f32(expected: f32,
                                                actual: f32) -> void;
extern pub fn __mlang_std_testing_verify_eq_f64(expected: f64,
                                                actual: f64) -> void;
extern pub fn __mlang_std_testing_mock_create() -> i64;
extern pub fn __mlang_std_testing_mock_destroy(handle: i64) -> void;
extern pub fn __mlang_std_testing_mock_reset(handle: i64) -> void;
extern pub fn __mlang_std_testing_mock_expect_called(handle: i64,
                                                     name: string,
                                                     expected_calls: i32) -> void;
extern pub fn __mlang_std_testing_mock_called(handle: i64,
                                              name: string) -> void;
extern pub fn __mlang_std_testing_mock_actual_calls(handle: i64,
                                                    name: string) -> i32;
extern pub fn __mlang_std_testing_mock_verify(handle: i64) -> i32;

fn bool_to_i32(v: bool) -> i32 {
    return int(v);
}

/// Mock handle used by std::testing mock helpers.
pub struct Mock {
    var handle: i64;
};

/// Reset per-test expectation counters.
pub fn reset() -> void {
    __mlang_std_testing_reset();
}

/// Return how many expectations have been evaluated.
pub fn checks() -> i32 {
    return __mlang_std_testing_checks();
}

/// Return how many expectations have failed.
pub fn failures() -> i32 {
    return __mlang_std_testing_failures();
}

/// Return 0 when no expectations failed, otherwise 1.
pub fn result() -> i32 {
    return __mlang_std_testing_result();
}

/// Toggle diagnostic emission for failing non-fatal expectations.
/// Counters still update while quiet mode is enabled.
pub fn set_quiet(enabled: bool) -> void {
    __mlang_std_testing_set_quiet(bool_to_i32(enabled));
}

/// Expect condition to be true. Records failure without aborting.
pub fn expect_true(cond: bool) -> void {
    __mlang_std_testing_expect_true(bool_to_i32(cond));
}

/// Expect condition to be false. Records failure without aborting.
pub fn expect_false(cond: bool) -> void {
    __mlang_std_testing_expect_false(bool_to_i32(cond));
}

/// Expect equality for i32 values.
pub fn expect_eq(expected: i32, actual: i32) -> void {
    __mlang_std_testing_expect_eq_i32(expected, actual);
}

/// Expect equality for i64 values.
pub fn expect_eq(expected: i64, actual: i64) -> void {
    __mlang_std_testing_expect_eq_i64(expected, actual);
}

/// Expect equality for bool values.
pub fn expect_eq(expected: bool, actual: bool) -> void {
    __mlang_std_testing_expect_eq_bool(bool_to_i32(expected),
                                       bool_to_i32(actual));
}

/// Expect equality for string values.
pub fn expect_eq(expected: string, actual: string) -> void {
    __mlang_std_testing_expect_eq_string(expected, actual);
}

/// Expect equality for f32 values.
pub fn expect_eq(expected: f32, actual: f32) -> void {
    __mlang_std_testing_expect_eq_f32(expected, actual);
}

/// Expect equality for f64 values.
pub fn expect_eq(expected: f64, actual: f64) -> void {
    __mlang_std_testing_expect_eq_f64(expected, actual);
}

/// Verify condition is true. Fatal on failure (aborts immediately).
pub fn verify_true(cond: bool) -> void {
    __mlang_std_testing_verify_true(bool_to_i32(cond));
}

/// Verify condition is false. Fatal on failure (aborts immediately).
pub fn verify_false(cond: bool) -> void {
    __mlang_std_testing_verify_false(bool_to_i32(cond));
}

/// Verify equality for i32 values. Fatal on failure.
pub fn verify_eq(expected: i32, actual: i32) -> void {
    __mlang_std_testing_verify_eq_i32(expected, actual);
}

/// Verify equality for i64 values. Fatal on failure.
pub fn verify_eq(expected: i64, actual: i64) -> void {
    __mlang_std_testing_verify_eq_i64(expected, actual);
}

/// Verify equality for bool values. Fatal on failure.
pub fn verify_eq(expected: bool, actual: bool) -> void {
    __mlang_std_testing_verify_eq_bool(bool_to_i32(expected),
                                       bool_to_i32(actual));
}

/// Verify equality for string values. Fatal on failure.
pub fn verify_eq(expected: string, actual: string) -> void {
    __mlang_std_testing_verify_eq_string(expected, actual);
}

/// Verify equality for f32 values. Fatal on failure.
pub fn verify_eq(expected: f32, actual: f32) -> void {
    __mlang_std_testing_verify_eq_f32(expected, actual);
}

/// Verify equality for f64 values. Fatal on failure.
pub fn verify_eq(expected: f64, actual: f64) -> void {
    __mlang_std_testing_verify_eq_f64(expected, actual);
}

/// GoogleTest-style alias.
pub fn EXPECT_TRUE(cond: bool) -> void {
    expect_true(cond);
}

/// GoogleTest-style alias.
pub fn EXPECT_FALSE(cond: bool) -> void {
    expect_false(cond);
}

/// GoogleTest-style alias.
pub fn EXPECT_EQ(expected: i32, actual: i32) -> void {
    expect_eq(expected, actual);
}

/// GoogleTest-style alias.
pub fn EXPECT_EQ(expected: i64, actual: i64) -> void {
    expect_eq(expected, actual);
}

/// GoogleTest-style alias.
pub fn EXPECT_EQ(expected: bool, actual: bool) -> void {
    expect_eq(expected, actual);
}

/// GoogleTest-style alias.
pub fn EXPECT_EQ(expected: string, actual: string) -> void {
    expect_eq(expected, actual);
}

/// GoogleTest-style alias.
pub fn EXPECT_EQ(expected: f32, actual: f32) -> void {
    expect_eq(expected, actual);
}

/// GoogleTest-style alias.
pub fn EXPECT_EQ(expected: f64, actual: f64) -> void {
    expect_eq(expected, actual);
}

/// GoogleTest-style fatal alias.
pub fn VERIFY_TRUE(cond: bool) -> void {
    verify_true(cond);
}

/// GoogleTest-style fatal alias.
pub fn VERIFY_FALSE(cond: bool) -> void {
    verify_false(cond);
}

/// GoogleTest-style fatal alias.
pub fn VERIFY_EQ(expected: i32, actual: i32) -> void {
    verify_eq(expected, actual);
}

/// GoogleTest-style fatal alias.
pub fn VERIFY_EQ(expected: i64, actual: i64) -> void {
    verify_eq(expected, actual);
}

/// GoogleTest-style fatal alias.
pub fn VERIFY_EQ(expected: bool, actual: bool) -> void {
    verify_eq(expected, actual);
}

/// GoogleTest-style fatal alias.
pub fn VERIFY_EQ(expected: string, actual: string) -> void {
    verify_eq(expected, actual);
}

/// GoogleTest-style fatal alias.
pub fn VERIFY_EQ(expected: f32, actual: f32) -> void {
    verify_eq(expected, actual);
}

/// GoogleTest-style fatal alias.
pub fn VERIFY_EQ(expected: f64, actual: f64) -> void {
    verify_eq(expected, actual);
}

/// Create a new mock state object.
///
/// Example:
/// @code{.mla}
/// mod std::testing;
/// use std::testing::*;
///
/// let m: Mock = mock_new();
/// mock_expect_call(m.handle, "send", 2);
/// mock_called(m.handle, "send");
/// mock_called(m.handle, "send");
/// expect_true(mock_verify(m.handle));
/// mock_free(m.handle);
/// @endcode
pub fn mock_new() -> Mock {
    return Mock { handle: __mlang_std_testing_mock_create() };
}

/// Free native resources associated with a mock.
pub fn mock_free(handle: i64) -> void {
    __mlang_std_testing_mock_destroy(handle);
}

/// Clear all expectations/call counters from a mock.
pub fn mock_reset(handle: i64) -> void {
    __mlang_std_testing_mock_reset(handle);
}

/// Set expected invocation count for a call name.
pub fn mock_expect_call(handle: i64, name: string, expected_calls: i32) -> void {
    __mlang_std_testing_mock_expect_called(handle, name, expected_calls);
}

/// Record one invocation for a call name.
pub fn mock_called(handle: i64, name: string) -> void {
    __mlang_std_testing_mock_called(handle, name);
}

/// Return the currently recorded call count for a call name.
pub fn mock_calls(handle: i64, name: string) -> i32 {
    return __mlang_std_testing_mock_actual_calls(handle, name);
}

/// Verify all mock expectations and record failures in test counters.
///
/// Returns true when all expected call counts match actual call counts.
pub fn mock_verify(handle: i64) -> bool {
    return __mlang_std_testing_mock_verify(handle) != 0;
}
