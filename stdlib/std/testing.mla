/// Expect equality for i64 arrays (non-fatal).
/// @ingroup std_testing
pub fn expect_array_eq(expected: &list<i64>, actual: &list<i64>) -> void {
    if expected.len() != actual.len() {
        expect_true(false);
        return;
    }
    let n: i64 = expected.len();
    for i in 0..n {
        expect_eq(expected[i], actual[i]);
    }
}

/// Expect equality for i32 arrays (non-fatal).
/// @ingroup std_testing
pub fn expect_array_eq(expected: &list<i32>, actual: &list<i32>) -> void {
    if expected.len() != actual.len() {
        expect_true(false);
        return;
    }
    let n: i64 = expected.len();
    for i in 0..n {
        expect_eq_i32(expected[i], actual[i]);
    }
}

