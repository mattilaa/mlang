/// \file detail.mla
/// \brief Native bindings for std::sync.

extern pub fn __mlang_std_sync_last_error() -> str8;
extern pub fn __mlang_std_sync_mutex_new() -> i64;
extern pub fn __mlang_std_sync_mutex_lock(handle: i64) -> i32;
extern pub fn __mlang_std_sync_mutex_unlock(handle: i64) -> i32;
extern pub fn __mlang_std_sync_mutex_free(handle: i64) -> i32;
extern pub fn __mlang_std_sync_condvar_new() -> i64;
extern pub fn __mlang_std_sync_condvar_wait(cond_handle: i64, mutex_handle: i64) -> i32;
extern pub fn __mlang_std_sync_condvar_wait_timeout_ms(cond_handle: i64, mutex_handle: i64, timeout_ms: i64) -> i32;
extern pub fn __mlang_std_sync_condvar_notify_one(cond_handle: i64) -> i32;
extern pub fn __mlang_std_sync_condvar_notify_all(cond_handle: i64) -> i32;
extern pub fn __mlang_std_sync_condvar_free(cond_handle: i64) -> i32;
extern pub fn __mlang_std_sync_channel_new(capacity: i64) -> i64;
extern pub fn __mlang_std_sync_channel_send(channel_handle: i64, s: str8) -> i32;
extern pub fn __mlang_std_sync_channel_recv(channel_handle: i64, buf: str8, capacity: i64) -> i64;
extern pub fn __mlang_std_sync_channel_try_recv(channel_handle: i64, buf: str8, capacity: i64) -> i64;
extern pub fn __mlang_std_sync_channel_close(channel_handle: i64) -> i32;
extern pub fn __mlang_std_sync_channel_free(channel_handle: i64) -> i32;
extern pub fn __mlang_std_sync_lfqueue_new(capacity: i64) -> i64;
extern pub fn __mlang_std_sync_lfqueue_send(queue_handle: i64, s: str8) -> i32;
extern pub fn __mlang_std_sync_lfqueue_try_recv(queue_handle: i64, buf: str8, capacity: i64) -> i64;
extern pub fn __mlang_std_sync_lfqueue_close(queue_handle: i64) -> i32;
extern pub fn __mlang_std_sync_lfqueue_free(queue_handle: i64) -> i32;
extern pub fn __mlang_std_sync_spsc_new(capacity: i64, item_size: i64) -> i64;
extern pub fn __mlang_std_sync_spsc_push(handle: i64, value: ptr<void>) -> i32;
extern pub fn __mlang_std_sync_spsc_pop(handle: i64, value: ptr<void>) -> i32;
extern pub fn __mlang_std_sync_spsc_free(handle: i64) -> void;
extern pub fn __mlang_std_sync_atomic_i64_new(initial: i64) -> i64;
extern pub fn __mlang_std_sync_atomic_i64_load(handle: i64, order: i32, output: ptr<i64>) -> i32;
extern pub fn __mlang_std_sync_atomic_i64_store(handle: i64, value: i64, order: i32) -> i32;
extern pub fn __mlang_std_sync_atomic_i64_exchange(handle: i64, value: i64, order: i32, output: ptr<i64>) -> i32;
extern pub fn __mlang_std_sync_atomic_i64_fetch_add(handle: i64, value: i64, order: i32, output: ptr<i64>) -> i32;
extern pub fn __mlang_std_sync_atomic_i64_fetch_sub(handle: i64, value: i64, order: i32, output: ptr<i64>) -> i32;
extern pub fn __mlang_std_sync_atomic_i64_fetch_and(handle: i64, value: i64, order: i32, output: ptr<i64>) -> i32;
extern pub fn __mlang_std_sync_atomic_i64_fetch_or(handle: i64, value: i64, order: i32, output: ptr<i64>) -> i32;
extern pub fn __mlang_std_sync_atomic_i64_fetch_xor(handle: i64, value: i64, order: i32, output: ptr<i64>) -> i32;
extern pub fn __mlang_std_sync_atomic_i64_compare_exchange(handle: i64, expected: ptr<i64>, desired: i64, order: i32) -> i32;
extern pub fn __mlang_std_sync_atomic_i64_free(handle: i64) -> i32;
extern pub fn __mlang_std_sync_latch_new(expected: i64) -> i64;
extern pub fn __mlang_std_sync_latch_count_down(handle: i64, update: i64) -> i32;
extern pub fn __mlang_std_sync_latch_try_wait(handle: i64) -> i32;
extern pub fn __mlang_std_sync_latch_wait(handle: i64) -> i32;
extern pub fn __mlang_std_sync_latch_free(handle: i64) -> i32;
extern pub fn __mlang_std_sync_barrier_new(expected: i64) -> i64;
extern pub fn __mlang_std_sync_barrier_arrive(handle: i64, update: i64) -> i64;
extern pub fn __mlang_std_sync_barrier_arrive_and_drop(handle: i64) -> i64;
extern pub fn __mlang_std_sync_barrier_wait(handle: i64, phase: i64) -> i32;
extern pub fn __mlang_std_sync_barrier_free(handle: i64) -> i32;
