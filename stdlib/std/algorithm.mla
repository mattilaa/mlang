/// \file algorithm.mla
/// \brief Algorithm namespace root for stdlib.
///
/// Submodules:
/// - `std::algorithm::fuzzy`
/// - `std::algorithm::order`
/// - `std::algorithm::numeric`
/// - `std::algorithm::ranges`
/// - `std::algorithm::rand`
/// - `std::algorithm::regex`
/// - `std::algorithm::fft`
///
/// @defgroup algorithm std::algorithm
/// @brief Algorithm namespace and submodules.
///
/// Re-exports algorithm-oriented modules under a common namespace.
/// @{

mod std::algorithm::fuzzy;
mod std::algorithm::order;
mod std::algorithm::numeric;
mod std::algorithm::ranges;
mod std::algorithm::rand;
mod std::algorithm::regex;
mod std::algorithm::fft;

/// @}
