/// \file event_loop.mla
/// \cond INTERNAL_IMPORTS
/// \cond INTERNAL_IMPORTS
mod std::event_loop::detail;
use std::event_loop::detail::*;
/// \endcond

/// \brief Event-loop helpers for lock-free queue based async loops.

mod std::sync;
use std::sync::LockFreeQueue;
/// \endcond


/// @brief Handle for periodic event posting to a lock-free queue.
pub struct EventLoop {
    var ticker_handle: i64;
};

/// @brief Lowercase stdlib type alias for `EventLoop`.
alias event_loop = EventLoop;


impl EventLoop {
    /// @brief Start event loop ticker thread that periodically posts `event_name`
    /// to `queue_handle`. Use lock-free queue try_recv in main loop.
    pub fn start(queue_handle: i64, interval_ms: i64, event_name: str8) -> result<EventLoop, str8> {
        let h: i64 = __mlang_std_timer_async_ticker_new(queue_handle, interval_ms, event_name);
        if h == 0 {
            return Err<EventLoop, str8>("std::event_loop::EventLoop::start failed");
        }
        return Ok<EventLoop, str8>(EventLoop { ticker_handle: h });
    }

    /// @brief Start ticker using `std::sync::LockFreeQueue`.
    pub fn start_queue(queue: LockFreeQueue, interval_ms: i64, event_name: str8) -> result<EventLoop, str8> {
        return EventLoop::start(queue.handle, interval_ms, event_name);
    }

    /// @brief Stop periodic event posting.
    pub fn stop(self: EventLoop) -> i32 {
        return __mlang_std_timer_async_ticker_stop(self.ticker_handle);
    }

    /// @brief Stop and free resources.
    pub fn close(self: EventLoop) -> i32 {
        return __mlang_std_timer_async_ticker_free(self.ticker_handle);
    }
}
