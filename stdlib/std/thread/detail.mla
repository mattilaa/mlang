/// \file detail.mla
/// \brief Compiler-intrinsic declarations for std::thread primitives.
///
/// These are NOT external C functions — they are handled directly by the
/// MLang code generator (mapped to pthreads / atomic builtins).
/// The declarations here exist solely for documentation and LSP navigation.

/// @brief Spawn a new thread and return its handle.
/// Compiler intrinsic: generates pthread_create internally.
extern fn thread_spawn(fn_ptr: ptr<void>) -> Handle<Thread>;

/// @brief Join a spawned thread, waiting for it to finish.
/// Compiler intrinsic: generates pthread_join internally.
/// Returns the thread exit status (0 on success).
extern fn thread_join(handle: Handle<Thread>) -> int;

/// @brief Allocate and initialise a new mutex.
/// Compiler intrinsic: allocates memory and calls pthread_mutex_init.
extern fn mutex_create() -> Handle<Mutex>;

/// @brief Acquire (lock) a mutex, blocking until available.
/// Compiler intrinsic: calls pthread_mutex_lock.
/// Returns 0 on success.
extern fn mutex_lock(handle: Handle<Mutex>) -> int;

/// @brief Release (unlock) a mutex.
/// Compiler intrinsic: calls pthread_mutex_unlock.
/// Returns 0 on success.
extern fn mutex_unlock(handle: Handle<Mutex>) -> int;

/// @brief Destroy and free a mutex.
/// Compiler intrinsic: calls pthread_mutex_destroy then free.
/// Returns 0 on success.
extern fn mutex_destroy(handle: Handle<Mutex>) -> int;

/// @brief Allocate a 64-bit atomic counter with an initial value.
/// Compiler intrinsic: malloc + atomic store.
extern fn atomic_i64_new(initial: i64) -> Handle<Atomic64>;

/// @brief Atomically load the current value.
/// Compiler intrinsic: sequentially-consistent atomic load.
extern fn atomic_i64_load(handle: Handle<Atomic64>) -> i64;

/// @brief Atomically store a new value.
/// Compiler intrinsic: sequentially-consistent atomic store.
/// Returns the stored value.
extern fn atomic_i64_store(handle: Handle<Atomic64>, value: i64) -> i64;

/// @brief Atomically add `delta` to the counter.
/// Compiler intrinsic: sequentially-consistent atomic fetch-add.
/// Returns the previous value.
extern fn atomic_i64_add(handle: Handle<Atomic64>, delta: i64) -> i64;

/// @brief Free an atomic counter allocated with atomic_i64_new.
/// Compiler intrinsic: free().
extern fn atomic_i64_free(handle: Handle<Atomic64>) -> void;
