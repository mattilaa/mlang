/// \file simd.mla
/// \brief SIMD-friendly vector math helpers for MLang (std::simd).
///
/// The public API operates on normal `list<T>` values and returns new lists.
/// Implementations are backed by native code that uses fixed-width vector
/// operations where the host compiler supports them, with scalar tails for
/// lengths that are not a multiple of the vector lane count.

mod std::bitset;

use std::bitset::BitSet;

extern pub fn __mlang_std_simd_add_i32(lhs: &list<i32>, rhs: &list<i32>) -> list<i32>;
extern pub fn __mlang_std_simd_subtract_i32(lhs: &list<i32>, rhs: &list<i32>) -> list<i32>;
extern pub fn __mlang_std_simd_multiply_i32(lhs: &list<i32>, rhs: &list<i32>) -> list<i32>;
extern pub fn __mlang_std_simd_bit_and_i32(lhs: &list<i32>, rhs: &list<i32>) -> list<i32>;
extern pub fn __mlang_std_simd_bit_or_i32(lhs: &list<i32>, rhs: &list<i32>) -> list<i32>;
extern pub fn __mlang_std_simd_bit_xor_i32(lhs: &list<i32>, rhs: &list<i32>) -> list<i32>;
extern pub fn __mlang_std_simd_bit_not_i32(values: &list<i32>) -> list<i32>;
extern pub fn __mlang_std_simd_shift_left_i32(values: &list<i32>, amount: i32) -> list<i32>;
extern pub fn __mlang_std_simd_shift_right_i32(values: &list<i32>, amount: i32) -> list<i32>;
extern pub fn __mlang_std_simd_sum_i32(values: &list<i32>) -> i32;
extern pub fn __mlang_std_simd_product_i32(values: &list<i32>) -> i32;
extern pub fn __mlang_std_simd_prefix_sum_i32(values: &list<i32>) -> list<i32>;
extern pub fn __mlang_std_simd_min_i32(values: &list<i32>) -> i32;
extern pub fn __mlang_std_simd_max_i32(values: &list<i32>) -> i32;
extern pub fn __mlang_std_simd_any_nonzero_i32(values: &list<i32>) -> i32;
extern pub fn __mlang_std_simd_all_nonzero_i32(values: &list<i32>) -> i32;

extern pub fn __mlang_std_simd_add_i64(lhs: &list<i64>, rhs: &list<i64>) -> list<i64>;
extern pub fn __mlang_std_simd_subtract_i64(lhs: &list<i64>, rhs: &list<i64>) -> list<i64>;
extern pub fn __mlang_std_simd_multiply_i64(lhs: &list<i64>, rhs: &list<i64>) -> list<i64>;
extern pub fn __mlang_std_simd_bit_and_i64(lhs: &list<i64>, rhs: &list<i64>) -> list<i64>;
extern pub fn __mlang_std_simd_bit_or_i64(lhs: &list<i64>, rhs: &list<i64>) -> list<i64>;
extern pub fn __mlang_std_simd_bit_xor_i64(lhs: &list<i64>, rhs: &list<i64>) -> list<i64>;
extern pub fn __mlang_std_simd_bit_not_i64(values: &list<i64>) -> list<i64>;
extern pub fn __mlang_std_simd_shift_left_i64(values: &list<i64>, amount: i32) -> list<i64>;
extern pub fn __mlang_std_simd_shift_right_i64(values: &list<i64>, amount: i32) -> list<i64>;
extern pub fn __mlang_std_simd_sum_i64(values: &list<i64>) -> i64;
extern pub fn __mlang_std_simd_product_i64(values: &list<i64>) -> i64;
extern pub fn __mlang_std_simd_prefix_sum_i64(values: &list<i64>) -> list<i64>;
extern pub fn __mlang_std_simd_min_i64(values: &list<i64>) -> i64;
extern pub fn __mlang_std_simd_max_i64(values: &list<i64>) -> i64;
extern pub fn __mlang_std_simd_any_nonzero_i64(values: &list<i64>) -> i32;
extern pub fn __mlang_std_simd_all_nonzero_i64(values: &list<i64>) -> i32;

extern pub fn __mlang_std_simd_add_f32(lhs: &list<f32>, rhs: &list<f32>) -> list<f32>;
extern pub fn __mlang_std_simd_subtract_f32(lhs: &list<f32>, rhs: &list<f32>) -> list<f32>;
extern pub fn __mlang_std_simd_multiply_f32(lhs: &list<f32>, rhs: &list<f32>) -> list<f32>;
extern pub fn __mlang_std_simd_sum_f32(values: &list<f32>) -> f32;
extern pub fn __mlang_std_simd_product_f32(values: &list<f32>) -> f32;
extern pub fn __mlang_std_simd_prefix_sum_f32(values: &list<f32>) -> list<f32>;
extern pub fn __mlang_std_simd_min_f32(values: &list<f32>) -> f32;
extern pub fn __mlang_std_simd_max_f32(values: &list<f32>) -> f32;
extern pub fn __mlang_std_simd_any_nonzero_f32(values: &list<f32>) -> i32;
extern pub fn __mlang_std_simd_all_nonzero_f32(values: &list<f32>) -> i32;

extern pub fn __mlang_std_simd_add_f64(lhs: &list<f64>, rhs: &list<f64>) -> list<f64>;
extern pub fn __mlang_std_simd_subtract_f64(lhs: &list<f64>, rhs: &list<f64>) -> list<f64>;
extern pub fn __mlang_std_simd_multiply_f64(lhs: &list<f64>, rhs: &list<f64>) -> list<f64>;
extern pub fn __mlang_std_simd_sum_f64(values: &list<f64>) -> f64;
extern pub fn __mlang_std_simd_product_f64(values: &list<f64>) -> f64;
extern pub fn __mlang_std_simd_prefix_sum_f64(values: &list<f64>) -> list<f64>;
extern pub fn __mlang_std_simd_min_f64(values: &list<f64>) -> f64;
extern pub fn __mlang_std_simd_max_f64(values: &list<f64>) -> f64;
extern pub fn __mlang_std_simd_any_nonzero_f64(values: &list<f64>) -> i32;
extern pub fn __mlang_std_simd_all_nonzero_f64(values: &list<f64>) -> i32;

extern pub fn __mlang_std_simd_any_bool(values: &list<bool>) -> i32;
extern pub fn __mlang_std_simd_all_bool(values: &list<bool>) -> i32;

extern pub fn __mlang_std_simd_bitset_and_eq(lhs_handle: i64, rhs_handle: i64) -> i32;
extern pub fn __mlang_std_simd_bitset_or_eq(lhs_handle: i64, rhs_handle: i64) -> i32;
extern pub fn __mlang_std_simd_bitset_xor_eq(lhs_handle: i64, rhs_handle: i64) -> i32;
extern pub fn __mlang_std_simd_bitset_not_eq(handle: i64) -> i32;
extern pub fn __mlang_std_simd_bitset_count_ones(handle: i64) -> i64;
extern pub fn __mlang_std_simd_bitset_any(handle: i64) -> i32;
extern pub fn __mlang_std_simd_bitset_all(handle: i64) -> i32;

/// @brief Element-wise vector addition.
///
/// Returns an empty list when input lengths differ.
pub fn add(lhs: &list<i32>, rhs: &list<i32>) -> list<i32> {
    return __mlang_std_simd_add_i32(lhs, rhs);
}

/// @brief Element-wise vector addition.
///
/// Returns an empty list when input lengths differ.
pub fn add(lhs: &list<i64>, rhs: &list<i64>) -> list<i64> {
    return __mlang_std_simd_add_i64(lhs, rhs);
}

/// @brief Element-wise vector addition.
///
/// Returns an empty list when input lengths differ.
pub fn add(lhs: &list<f32>, rhs: &list<f32>) -> list<f32> {
    return __mlang_std_simd_add_f32(lhs, rhs);
}

/// @brief Element-wise vector addition.
///
/// Returns an empty list when input lengths differ.
pub fn add(lhs: &list<f64>, rhs: &list<f64>) -> list<f64> {
    return __mlang_std_simd_add_f64(lhs, rhs);
}

/// @brief Element-wise vector subtraction.
///
/// Returns an empty list when input lengths differ.
pub fn subtract(lhs: &list<i32>, rhs: &list<i32>) -> list<i32> {
    return __mlang_std_simd_subtract_i32(lhs, rhs);
}

/// @brief Element-wise vector subtraction.
///
/// Returns an empty list when input lengths differ.
pub fn subtract(lhs: &list<i64>, rhs: &list<i64>) -> list<i64> {
    return __mlang_std_simd_subtract_i64(lhs, rhs);
}

/// @brief Element-wise vector subtraction.
///
/// Returns an empty list when input lengths differ.
pub fn subtract(lhs: &list<f32>, rhs: &list<f32>) -> list<f32> {
    return __mlang_std_simd_subtract_f32(lhs, rhs);
}

/// @brief Element-wise vector subtraction.
///
/// Returns an empty list when input lengths differ.
pub fn subtract(lhs: &list<f64>, rhs: &list<f64>) -> list<f64> {
    return __mlang_std_simd_subtract_f64(lhs, rhs);
}

/// @brief Element-wise vector multiplication.
///
/// Returns an empty list when input lengths differ.
pub fn multiply(lhs: &list<i32>, rhs: &list<i32>) -> list<i32> {
    return __mlang_std_simd_multiply_i32(lhs, rhs);
}

/// @brief Element-wise vector multiplication.
///
/// Returns an empty list when input lengths differ.
pub fn multiply(lhs: &list<i64>, rhs: &list<i64>) -> list<i64> {
    return __mlang_std_simd_multiply_i64(lhs, rhs);
}

/// @brief Element-wise vector multiplication.
///
/// Returns an empty list when input lengths differ.
pub fn multiply(lhs: &list<f32>, rhs: &list<f32>) -> list<f32> {
    return __mlang_std_simd_multiply_f32(lhs, rhs);
}

/// @brief Element-wise vector multiplication.
///
/// Returns an empty list when input lengths differ.
pub fn multiply(lhs: &list<f64>, rhs: &list<f64>) -> list<f64> {
    return __mlang_std_simd_multiply_f64(lhs, rhs);
}

/// @brief Element-wise bitwise AND.
///
/// Returns an empty list when input lengths differ.
pub fn bit_and(lhs: &list<i32>, rhs: &list<i32>) -> list<i32> {
    return __mlang_std_simd_bit_and_i32(lhs, rhs);
}

/// @brief Element-wise bitwise AND.
///
/// Returns an empty list when input lengths differ.
pub fn bit_and(lhs: &list<i64>, rhs: &list<i64>) -> list<i64> {
    return __mlang_std_simd_bit_and_i64(lhs, rhs);
}

/// @brief Element-wise bitwise OR.
///
/// Returns an empty list when input lengths differ.
pub fn bit_or(lhs: &list<i32>, rhs: &list<i32>) -> list<i32> {
    return __mlang_std_simd_bit_or_i32(lhs, rhs);
}

/// @brief Element-wise bitwise OR.
///
/// Returns an empty list when input lengths differ.
pub fn bit_or(lhs: &list<i64>, rhs: &list<i64>) -> list<i64> {
    return __mlang_std_simd_bit_or_i64(lhs, rhs);
}

/// @brief Element-wise bitwise XOR.
///
/// Returns an empty list when input lengths differ.
pub fn bit_xor(lhs: &list<i32>, rhs: &list<i32>) -> list<i32> {
    return __mlang_std_simd_bit_xor_i32(lhs, rhs);
}

/// @brief Element-wise bitwise XOR.
///
/// Returns an empty list when input lengths differ.
pub fn bit_xor(lhs: &list<i64>, rhs: &list<i64>) -> list<i64> {
    return __mlang_std_simd_bit_xor_i64(lhs, rhs);
}

/// @brief Element-wise bitwise NOT.
pub fn bit_not(values: &list<i32>) -> list<i32> {
    return __mlang_std_simd_bit_not_i32(values);
}

/// @brief Element-wise bitwise NOT.
pub fn bit_not(values: &list<i64>) -> list<i64> {
    return __mlang_std_simd_bit_not_i64(values);
}

/// @brief Shift every lane left by `amount` bits.
///
/// Returns an empty list when `amount` is negative.
pub fn shift_left(values: &list<i32>, amount: i32) -> list<i32> {
    return __mlang_std_simd_shift_left_i32(values, amount);
}

/// @brief Shift every lane left by `amount` bits.
///
/// Returns an empty list when `amount` is negative.
pub fn shift_left(values: &list<i64>, amount: i32) -> list<i64> {
    return __mlang_std_simd_shift_left_i64(values, amount);
}

/// @brief Shift every lane right by `amount` bits.
///
/// Returns an empty list when `amount` is negative.
pub fn shift_right(values: &list<i32>, amount: i32) -> list<i32> {
    return __mlang_std_simd_shift_right_i32(values, amount);
}

/// @brief Shift every lane right by `amount` bits.
///
/// Returns an empty list when `amount` is negative.
pub fn shift_right(values: &list<i64>, amount: i32) -> list<i64> {
    return __mlang_std_simd_shift_right_i64(values, amount);
}

/// @brief Horizontal sum of all vector elements.
pub fn sum(values: &list<i32>) -> i32 {
    return __mlang_std_simd_sum_i32(values);
}

/// @brief Horizontal sum of all vector elements.
pub fn sum(values: &list<i64>) -> i64 {
    return __mlang_std_simd_sum_i64(values);
}

/// @brief Horizontal sum of all vector elements.
pub fn sum(values: &list<f32>) -> f32 {
    return __mlang_std_simd_sum_f32(values);
}

/// @brief Horizontal sum of all vector elements.
pub fn sum(values: &list<f64>) -> f64 {
    return __mlang_std_simd_sum_f64(values);
}

/// @brief Horizontal product of all vector elements.
pub fn product(values: &list<i32>) -> i32 {
    return __mlang_std_simd_product_i32(values);
}

/// @brief Horizontal product of all vector elements.
pub fn product(values: &list<i64>) -> i64 {
    return __mlang_std_simd_product_i64(values);
}

/// @brief Horizontal product of all vector elements.
pub fn product(values: &list<f32>) -> f32 {
    return __mlang_std_simd_product_f32(values);
}

/// @brief Horizontal product of all vector elements.
pub fn product(values: &list<f64>) -> f64 {
    return __mlang_std_simd_product_f64(values);
}

/// @brief Running sum across vector elements.
pub fn prefix_sum(values: &list<i32>) -> list<i32> {
    return __mlang_std_simd_prefix_sum_i32(values);
}

/// @brief Running sum across vector elements.
pub fn prefix_sum(values: &list<i64>) -> list<i64> {
    return __mlang_std_simd_prefix_sum_i64(values);
}

/// @brief Running sum across vector elements.
pub fn prefix_sum(values: &list<f32>) -> list<f32> {
    return __mlang_std_simd_prefix_sum_f32(values);
}

/// @brief Running sum across vector elements.
pub fn prefix_sum(values: &list<f64>) -> list<f64> {
    return __mlang_std_simd_prefix_sum_f64(values);
}

/// @brief Minimum element in the vector, or zero for an empty list.
pub fn min(values: &list<i32>) -> i32 {
    return __mlang_std_simd_min_i32(values);
}

/// @brief Minimum element in the vector, or zero for an empty list.
pub fn min(values: &list<i64>) -> i64 {
    return __mlang_std_simd_min_i64(values);
}

/// @brief Minimum element in the vector, or zero for an empty list.
pub fn min(values: &list<f32>) -> f32 {
    return __mlang_std_simd_min_f32(values);
}

/// @brief Minimum element in the vector, or zero for an empty list.
pub fn min(values: &list<f64>) -> f64 {
    return __mlang_std_simd_min_f64(values);
}

/// @brief Maximum element in the vector, or zero for an empty list.
pub fn max(values: &list<i32>) -> i32 {
    return __mlang_std_simd_max_i32(values);
}

/// @brief Maximum element in the vector, or zero for an empty list.
pub fn max(values: &list<i64>) -> i64 {
    return __mlang_std_simd_max_i64(values);
}

/// @brief Maximum element in the vector, or zero for an empty list.
pub fn max(values: &list<f32>) -> f32 {
    return __mlang_std_simd_max_f32(values);
}

/// @brief Maximum element in the vector, or zero for an empty list.
pub fn max(values: &list<f64>) -> f64 {
    return __mlang_std_simd_max_f64(values);
}

/// @brief True when at least one boolean element is true.
pub fn any(values: &list<bool>) -> bool {
    return __mlang_std_simd_any_bool(values) != 0;
}

/// @brief True when every boolean element is true.
pub fn all(values: &list<bool>) -> bool {
    return __mlang_std_simd_all_bool(values) != 0;
}

/// @brief True when at least one numeric element is non-zero.
pub fn any_nonzero(values: &list<i32>) -> bool {
    return __mlang_std_simd_any_nonzero_i32(values) != 0;
}

/// @brief True when at least one numeric element is non-zero.
pub fn any_nonzero(values: &list<i64>) -> bool {
    return __mlang_std_simd_any_nonzero_i64(values) != 0;
}

/// @brief True when at least one numeric element is non-zero.
pub fn any_nonzero(values: &list<f32>) -> bool {
    return __mlang_std_simd_any_nonzero_f32(values) != 0;
}

/// @brief True when at least one numeric element is non-zero.
pub fn any_nonzero(values: &list<f64>) -> bool {
    return __mlang_std_simd_any_nonzero_f64(values) != 0;
}

/// @brief True when every numeric element is non-zero.
pub fn all_nonzero(values: &list<i32>) -> bool {
    return __mlang_std_simd_all_nonzero_i32(values) != 0;
}

/// @brief True when every numeric element is non-zero.
pub fn all_nonzero(values: &list<i64>) -> bool {
    return __mlang_std_simd_all_nonzero_i64(values) != 0;
}

/// @brief True when every numeric element is non-zero.
pub fn all_nonzero(values: &list<f32>) -> bool {
    return __mlang_std_simd_all_nonzero_f32(values) != 0;
}

/// @brief True when every numeric element is non-zero.
pub fn all_nonzero(values: &list<f64>) -> bool {
    return __mlang_std_simd_all_nonzero_f64(values) != 0;
}

/// @brief In-place packed BitSet AND. Returns 0 on success.
///
/// The input bitsets must have the same active bit length.
pub fn bit_and_eq(lhs: BitSet, rhs: BitSet) -> i32 {
    return __mlang_std_simd_bitset_and_eq(lhs.raw_handle(), rhs.raw_handle());
}

/// @brief In-place packed BitSet OR. Returns 0 on success.
///
/// The input bitsets must have the same active bit length.
pub fn bit_or_eq(lhs: BitSet, rhs: BitSet) -> i32 {
    return __mlang_std_simd_bitset_or_eq(lhs.raw_handle(), rhs.raw_handle());
}

/// @brief In-place packed BitSet XOR. Returns 0 on success.
///
/// The input bitsets must have the same active bit length.
pub fn bit_xor_eq(lhs: BitSet, rhs: BitSet) -> i32 {
    return __mlang_std_simd_bitset_xor_eq(lhs.raw_handle(), rhs.raw_handle());
}

/// @brief In-place packed BitSet NOT over the active bit length.
pub fn bit_not_eq(values: BitSet) -> i32 {
    return __mlang_std_simd_bitset_not_eq(values.raw_handle());
}

/// @brief Count set bits in a packed BitSet.
pub fn count_ones(values: BitSet) -> i64 {
    return __mlang_std_simd_bitset_count_ones(values.raw_handle());
}

/// @brief True when at least one packed BitSet bit is set.
pub fn any(values: BitSet) -> bool {
    return __mlang_std_simd_bitset_any(values.raw_handle()) != 0;
}

/// @brief True when every active packed BitSet bit is set.
pub fn all(values: BitSet) -> bool {
    return __mlang_std_simd_bitset_all(values.raw_handle()) != 0;
}
