/// \file fs.mla
/// \brief Minimal filesystem module (std::fs).

extern pub fn __mlang_std_fs_open_read(path: string) -> i64;
extern pub fn __mlang_std_fs_open_write(path: string) -> i64;
extern pub fn __mlang_std_fs_close(handle: i64) -> int;
extern pub fn __mlang_std_fs_read_line(handle: i64, buf: string, capacity: i64) -> i64;
extern pub fn __mlang_std_fs_write(handle: i64, s: string) -> i64;
extern pub fn __mlang_std_fs_read_all_lines(handle: i64) -> list<string>;
extern pub fn __mlang_std_fs_free_lines(lines: list<string>) -> void;
extern pub fn __mlang_std_fs_file_exists(path: string) -> int;
extern pub fn __mlang_std_fs_parent_dir(path: string) -> string;
extern pub fn __mlang_std_fs_cwd() -> string;
extern pub fn __mlang_std_fs_read_all_text(path: string) -> string;
extern pub fn __mlang_std_fs_write_all_text(path: string, text: string) -> int;
extern pub fn __mlang_std_strbuf_len(s: string) -> i64;

/// @brief Owned file handle.
pub struct File {
    var handle: i64;
};

/// @brief Buffered line reader over a file handle.
pub struct BufReader {
    var file: File;
    var line_capacity: i64;
};

impl File {
    ///  Open existing file for reading.
    pub fn open(path: string) -> Result<File, string> {
        let h = __mlang_std_fs_open_read(path);
        if h == 0: {
            return Err<File, string>("std::fs::File::open failed");
        }
        return Ok<File, string>(File { handle: h });
    }

    ///  Create/truncate file for writing.
    pub fn create(path: string) -> Result<File, string> {
        let h = __mlang_std_fs_open_write(path);
        if h == 0: {
            return Err<File, string>("std::fs::File::create failed");
        }
        return Ok<File, string>(File { handle: h });
    }

    ///  Close file handle.
    /// Returns `0` on success.
    pub fn close(self: File) -> i32 {
        if self.handle == 0: {
            return 0;
        }
        return __mlang_std_fs_close(self.handle);
    }

    ///  Write text into file.
    /// Returns bytes written.
    pub fn write(self: File, s: string) -> Result<i64, string> {
        let n = __mlang_std_fs_write(self.handle, s);
        if n < 0: {
            return Err<i64, string>("std::fs::File::write failed");
        }
        return Ok<i64, string>(n);
    }

    ///  Write text followed by newline.
    pub fn write_line(self: File, s: string) -> Result<i64, string> {
        let n1: Result<i64, string> = self.write(s);
        if n1.is_err(): {
            return Err<i64, string>("std::fs::File::write_line failed");
        }
        let n2: Result<i64, string> = self.write("\n");
        if n2.is_err(): {
            return Err<i64, string>("std::fs::File::write_line failed");
        }
        return Ok<i64, string>(n1.unwrap() + n2.unwrap());
    }
}

impl BufReader {
    ///  Construct buffered reader with default capacity.
    pub fn new(file: File) -> BufReader {
        return BufReader { file: file, line_capacity: 4096 };
    }

    ///  Construct buffered reader with custom line buffer size.
    pub fn with_capacity(file: File, capacity: i64) -> BufReader {
        return BufReader { file: file, line_capacity: capacity };
    }

    ///  Read one line into caller-owned buffer.
    /// Returns bytes read.
    pub fn read_line(self: BufReader, buf: string) -> Result<i64, string> {
        let n = __mlang_std_fs_read_line(self.file.handle, buf, self.line_capacity);
        if n < 0: {
            return Err<i64, string>("std::fs::BufReader::read_line failed");
        }
        return Ok<i64, string>(n);
    }

    ///  Read all lines into `list<string>`.
    pub fn lines(self: BufReader) -> list<string> {
        return __mlang_std_fs_read_all_lines(self.file.handle);
    }
}

/// @brief Free list returned by `BufReader::lines()`.
pub fn free_lines(lines: list<string>) -> void {
    __mlang_std_fs_free_lines(lines);
}

/// @brief Return `1` if a path exists.
pub fn file_exists(path: string) -> int {
    return __mlang_std_fs_file_exists(path);
}

/// @brief Return parent directory path.
pub fn parent_dir(path: string) -> string {
    return __mlang_std_fs_parent_dir(path);
}

/// @brief Return current working directory.
pub fn cwd() -> string {
    return __mlang_std_fs_cwd();
}

/// @brief Read entire file text into one string.
pub fn read_all_text(path: string) -> Result<string, string> {
    let text: string = __mlang_std_fs_read_all_text(path);
    if __mlang_std_strbuf_len(text) == 0: {
        if file_exists(path) == 0: {
            return Err<string, string>("std::fs::read_all_text failed");
        }
    }
    return Ok<string, string>(text);
}

/// @brief Write entire text to file path.
pub fn write_all_text(path: string, text: string) -> Result<i32, string> {
    let rc: i32 = __mlang_std_fs_write_all_text(path, text);
    if rc != 0: {
        return Err<i32, string>("std::fs::write_all_text failed");
    }
    return Ok<i32, string>(0);
}
