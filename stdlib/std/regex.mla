/// \file regex.mla
/// \brief POSIX regular expressions for MLang (std::regex).
///
/// This module wraps a compiled regex handle and exposes:
/// - `Regex::compile(pattern)`
/// - `Regex::is_match(text)`
/// - `Regex::match_start(text, group)`
/// - `Regex::match_end(text, group)`
/// - `Regex::find_start(text)` / `Regex::find_end(text)` (group 0 helpers)


/// \cond INTERNAL_IMPORTS
mod std::regex::detail;
use std::regex::detail::*;
/// \endcond

/// @brief Handle to a compiled POSIX regular expression.
pub struct Regex {
    var handle: i64;
};

/// @brief Return the last `std::regex` error message.
/// @return UTF-8 error description, or empty string if none.
pub fn last_error() -> str8 {
    return __mlang_std_regex_last_error();
}

impl Regex {
    /// Compile a pattern using POSIX ERE syntax.
    pub fn compile(pattern: str8) -> Result<Regex, str8> {
        let h: i64 = __mlang_std_regex_compile(pattern);
        if h == 0 {
            return Err<Regex, str8>(last_error());
        }
        return Ok<Regex, str8>(Regex { handle: h });
    }

    /// Return 1 if pattern matches anywhere in `text`, else 0.
    pub fn is_match(self: Regex, text: str8) -> i32 {
        return __mlang_std_regex_is_match(self.handle, text);
    }

    /// Start byte offset of the selected capture group. Returns -1 on no match.
    pub fn match_start(self: Regex, text: str8, group_index: i64) -> i64 {
        return __mlang_std_regex_match_start(self.handle, text, group_index);
    }

    /// End byte offset (exclusive) of the selected capture group. Returns -1 on no match.
    pub fn match_end(self: Regex, text: str8, group_index: i64) -> i64 {
        return __mlang_std_regex_match_end(self.handle, text, group_index);
    }

    /// Start byte offset of whole match (group 0), or -1.
    pub fn find_start(self: Regex, text: str8) -> i64 {
        return self.match_start(text, 0);
    }

    /// End byte offset of whole match (group 0), or -1.
    pub fn find_end(self: Regex, text: str8) -> i64 {
        return self.match_end(text, 0);
    }

    /// Release compiled regex resources.
    pub fn close(self: Regex) -> i32 {
        return __mlang_std_regex_free(self.handle);
    }
}
