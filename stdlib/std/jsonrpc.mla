/// \file jsonrpc.mla
/// \brief JSON-RPC/LSP stdio transport runtime helpers for MLang (std::jsonrpc).
///
/// Features:
/// - Content-Length framed stdio read/write
/// - Timeout-aware framed reads
/// - Thread-safe cancellation registry (for `$/cancelRequest`)
/// - Channel-backed runtime queues for concurrent request/response pipelines

/// \cond INTERNAL_IMPORTS
extern pub fn __mlang_std_strbuf_contains(s: string, needle: string) -> int;
extern pub fn __mlang_std_strbuf_len(s: string) -> i64;
/// \endcond

