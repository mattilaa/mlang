/// @brief Parse a JSON-RPC payload and register `$/cancelRequest` ids.
/// Returns:
/// - `1` when a cancel request id was registered
/// - `0` when payload is not a cancel notification
pub fn register_cancel_from_payload(payload: string) -> Result<i32, string> {
    let request_id: i64 = __mlang_std_jsonrpc_extract_cancel_id(payload);
    if request_id == -1: {
        return Ok<i32, string>(0);
    }
    if request_id == -2: {
        return Err<i32, string>("std::jsonrpc cancel payload missing/invalid params.id");
    }
    let mark_r: Result<i32, string> = cancel_mark(request_id);
    if mark_r.is_err(): {
        return Err<i32, string>(mark_r.unwrap_err());
    }
    return Ok<i32, string>(1);
}

/// @brief Drain one outbound frame from runtime queue and write it.
/// Returns:
/// - `1` when one message was flushed
/// - `0` when queue was empty
pub fn flush_one_outbound(rt: Runtime, transport: StdioTransport, scratch: string, capacity: i64) -> Result<i32, string> {
    let recv_r: Result<i64, string> = rt.try_pop_outbound(scratch, capacity);
    if recv_r.is_err(): {
        return Err<i32, string>(recv_r.unwrap_err());
    }
    let n: i64 = match recv_r {
        Ok(v) => v,
        Err(_e) => -1
    };
    if n == -2: {
        return Ok<i32, string>(0);
    }
    if n <= 0: {
        return Ok<i32, string>(0);
    }
    let wr: Result<i32, string> = transport.write_frame(scratch);
    if wr.is_err(): {
        return Err<i32, string>(wr.unwrap_err());
    }
    return Ok<i32, string>(1);
}

/// @brief Classify read errors that represent timeout/no-data.
pub fn is_timeout_error(err: string) -> int {
    return __mlang_std_strbuf_contains(err, "timeout");
}

fn __jsonrpc_reader_thread(inbound_handle: i64, done_handle: i64, frame_capacity: i64) -> i32 {
    let transport: StdioTransport = stdio();
    var frame = String::with_capacity(frame_capacity);

    for _i in 0..2147483647 {
        let rr: Result<i64, string> = transport.read_frame(frame, frame_capacity);
        if rr.is_err(): {
            break;
        }
        let cr: Result<i32, string> = register_cancel_from_payload(frame);
        if cr.is_ok(): {
            let c: i32 = match cr {
                Ok(v) => v,
                Err(_e) => 0
            };
            if c == 1: {
                continue;
            }
        }
        let rc: i32 = __mlang_std_sync_channel_send(inbound_handle, frame);
        if rc != 0: {
            break;
        }
    }

    __mlang_std_sync_channel_close(inbound_handle);
    __mlang_std_sync_channel_send(done_handle, "reader_done");
    String::free(frame);
    return 0;
}

fn __jsonrpc_worker_thread(inbound_handle: i64, done_handle: i64, request_capacity: i64, response_capacity: i64) -> i32 {
    let transport: StdioTransport = stdio();
    var request_buf = String::with_capacity(request_capacity);

    for _i in 0..2147483647 {
        let n: i64 = __mlang_std_sync_channel_recv(inbound_handle, request_buf, request_capacity);
        if n <= 0: {
            break;
        }

        let request_id: i64 = __mlang_std_jsonrpc_extract_request_id(request_buf);
        if request_id >= 0: {
            if cancel_take(request_id) == 1: {
                continue;
            }
        }

        let response_payload: string = __mlang_std_jsonrpc_runtime_dispatch(request_buf);
        if __mlang_std_strbuf_len(response_payload) <= 0: {
            String::free(response_payload);
            continue;
        }

        if request_id >= 0: {
            if cancel_take(request_id) == 1: {
                String::free(response_payload);
                continue;
            }
        }

        let wr: Result<i32, string> = transport.write_frame(response_payload);
        String::free(response_payload);
        if wr.is_err(): {
            break;
        }
    }

    __mlang_std_sync_channel_send(done_handle, "worker_done");
    String::free(request_buf);
    return 0;
}

fn __jsonrpc_spawn_workers(remaining: i32, rt: Runtime, done_handle: i64, request_capacity: i64, response_capacity: i64) -> i32 {
    if remaining <= 0: {
        return 0;
    }
    thread_spawn(__jsonrpc_worker_thread, rt.inbound_handle, done_handle, request_capacity, response_capacity);
    return __jsonrpc_spawn_workers(remaining - 1, rt, done_handle, request_capacity, response_capacity);
}

/// @brief Run full stdio JSON-RPC loop with worker-thread dispatch.
///
/// Behavior:
/// - reader thread consumes framed stdin messages
/// - built-in `$/cancelRequest` messages are handled immediately
/// - non-cancel payloads are queued to worker threads
/// - workers call `__mlang_std_jsonrpc_runtime_dispatch(...)`
/// - non-empty responses are written as framed stdout messages
///
/// `__mlang_std_jsonrpc_runtime_dispatch` has a weak default implementation
/// in libmlang_std (returns no response). Servers should override it.
pub fn run_stdio_loop(worker_count: i32, frame_capacity: i64, response_capacity: i64) -> Result<i32, string> {
    var workers: i32 = worker_count;
    if workers <= 0: {
        workers = 1;
    }
    var req_cap: i64 = frame_capacity;
    if req_cap < 1024: {
        req_cap = 1024;
    }
    var resp_cap: i64 = response_capacity;
    if resp_cap < 1024: {
        resp_cap = 1024;
    }

    let rt_r: Result<Runtime, string> = Runtime::new(256);
    if rt_r.is_err(): {
        return Err<i32, string>(rt_r.unwrap_err());
    }
    let rt: Runtime = match rt_r {
        Ok(v) => v,
        Err(_e) => Runtime { inbound_handle: 0, outbound_handle: 0 }
    };

    let done_handle: i64 = __mlang_std_sync_channel_new(workers + 1);
    if done_handle == 0: {
        rt.close();
        return Err<i32, string>(__mlang_std_sync_last_error());
    }

    thread_spawn(__jsonrpc_reader_thread, rt.inbound_handle, done_handle, req_cap);
    __jsonrpc_spawn_workers(workers, rt, done_handle, req_cap, resp_cap);

    var done_buf = String::with_capacity(32);
    for _i in 0..(workers + 1) {
        let _n: i64 = __mlang_std_sync_channel_recv(done_handle, done_buf, 32);
    }

    String::free(done_buf);
    __mlang_std_sync_channel_close(done_handle);
    __mlang_std_sync_channel_free(done_handle);
    rt.close();
    return Ok<i32, string>(0);
}
