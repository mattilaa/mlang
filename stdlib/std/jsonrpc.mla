pub fn cancel_mark(request_id: i64) -> Result<i32, string> {
    let rc: i32 = __mlang_std_jsonrpc_cancel_mark(request_id);
    if rc != 0: {
        return Err<i32, string>(last_error());
    }
    return Ok<i32, string>(0);
}

