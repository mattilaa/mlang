/// @brief Stdio transport marker.
pub struct StdioTransport {
    var _tag: i32;
};

/// @brief Channel-backed runtime queues for concurrent pipelines.
pub struct Runtime {
    var inbound_handle: i64;
    var outbound_handle: i64;
};

pub fn last_error() -> string {
    return __mlang_std_jsonrpc_last_error();
}

/// @brief Return stdio JSON-RPC transport handle.
pub fn stdio() -> StdioTransport {
    return StdioTransport { _tag: 0 };
}

impl StdioTransport {
    /// @brief Blocking framed read from stdin.
    /// Returns frame payload bytes copied to `buf`.
    pub fn read_frame(self: StdioTransport, buf: string, capacity: i64) -> Result<i64, string> {
        let n: i64 = __mlang_std_jsonrpc_stdio_read_frame(buf, capacity);
        if n == -2: {
            return Err<i64, string>("std::jsonrpc read_frame timeout");
        }
        if n == -3: {
            return Err<i64, string>("std::jsonrpc read_frame payload too large for buffer");
        }
        if n < 0: {
            return Err<i64, string>(last_error());
        }
        return Ok<i64, string>(n);
    }

    /// @brief Timeout-aware framed read from stdin.
    /// `timeout_ms` >= 0, returns timeout error if no data arrives in time.
    pub fn read_frame_timeout(self: StdioTransport, buf: string, capacity: i64, timeout_ms: i64) -> Result<i64, string> {
        let n: i64 = __mlang_std_jsonrpc_stdio_read_frame_timeout(buf, capacity, timeout_ms);
        if n == -2: {
            return Err<i64, string>("std::jsonrpc read_frame timeout");
        }
        if n == -3: {
            return Err<i64, string>("std::jsonrpc read_frame payload too large for buffer");
        }
        if n < 0: {
            return Err<i64, string>(last_error());
        }
        return Ok<i64, string>(n);
    }

    /// @brief Write one JSON payload as a framed `Content-Length` message.
    pub fn write_frame(self: StdioTransport, payload: string) -> Result<i32, string> {
        let rc: i32 = __mlang_std_jsonrpc_stdio_write_frame(payload);
        if rc != 0: {
            return Err<i32, string>(last_error());
        }
        return Ok<i32, string>(0);
    }
}

impl Runtime {
    /// @brief Build runtime queues with bounded channel capacity.
    pub fn new(queue_capacity: i64) -> Result<Runtime, string> {
        let in_h: i64 = __mlang_std_sync_channel_new(queue_capacity);
        if in_h == 0: {
            return Err<Runtime, string>(__mlang_std_sync_last_error());
        }
        let out_h: i64 = __mlang_std_sync_channel_new(queue_capacity);
        if out_h == 0: {
            __mlang_std_sync_channel_free(in_h);
            return Err<Runtime, string>(__mlang_std_sync_last_error());
        }
        return Ok<Runtime, string>(Runtime {
            inbound_handle: in_h,
            outbound_handle: out_h
        });
    }

    /// @brief Push parsed inbound request/notification payload.
    pub fn push_inbound(self: Runtime, payload: string) -> Result<i32, string> {
        let rc: i32 = __mlang_std_sync_channel_send(self.inbound_handle, payload);
        if rc != 0: {
            return Err<i32, string>(__mlang_std_sync_last_error());
        }
        return Ok<i32, string>(0);
    }

    /// @brief Non-blocking inbound poll.
    /// Returns copied bytes (>0), `-2` empty, `0` closed+drained.
    pub fn try_pop_inbound(self: Runtime, buf: string, capacity: i64) -> Result<i64, string> {
        let n: i64 = __mlang_std_sync_channel_try_recv(self.inbound_handle, buf, capacity);
        if n < -1: {
            return Ok<i64, string>(n);
        }
        if n < 0: {
            return Err<i64, string>(__mlang_std_sync_last_error());
        }
        return Ok<i64, string>(n);
    }

    /// @brief Queue outbound payload.
    pub fn push_outbound(self: Runtime, payload: string) -> Result<i32, string> {
        let rc: i32 = __mlang_std_sync_channel_send(self.outbound_handle, payload);
        if rc != 0: {
            return Err<i32, string>(__mlang_std_sync_last_error());
        }
        return Ok<i32, string>(0);
    }

    /// @brief Non-blocking outbound poll.
    /// Returns copied bytes (>0), `-2` empty, `0` closed+drained.
    pub fn try_pop_outbound(self: Runtime, buf: string, capacity: i64) -> Result<i64, string> {
        let n: i64 = __mlang_std_sync_channel_try_recv(self.outbound_handle, buf, capacity);
        if n < -1: {
            return Ok<i64, string>(n);
        }
        if n < 0: {
            return Err<i64, string>(__mlang_std_sync_last_error());
        }
        return Ok<i64, string>(n);
    }

    /// @brief Close + free queue resources.
    pub fn close(self: Runtime) -> void {
        __mlang_std_sync_channel_close(self.inbound_handle);
        __mlang_std_sync_channel_close(self.outbound_handle);
        __mlang_std_sync_channel_free(self.inbound_handle);
        __mlang_std_sync_channel_free(self.outbound_handle);
    }
}

/// @brief Build one raw `Content-Length` frame string from payload.
pub fn build_frame(payload: string) -> string {
    return __mlang_std_jsonrpc_build_frame(payload);
}

/// @brief Parse one raw frame string into `out` payload buffer.
pub fn parse_frame(frame: string, out: string, capacity: i64) -> Result<i64, string> {
    let n: i64 = __mlang_std_jsonrpc_parse_frame(frame, out, capacity);
    if n < 0: {
        return Err<i64, string>(last_error());
    }
    return Ok<i64, string>(n);
}

