/// \file io.mla
/// \brief Basic stdin/stdout helpers for MLang (std::io).
///
/// This module provides:
/// - Rust-like handles: `stdin()` and `stdout()`
/// - Explicit stdout synchronization via `lock(stdout())`
/// - Scoped synchronized writes via `write_sync` / `writeln_sync`
///
/// Note:
/// - MLang compiler runs `__drop(T)` on scope/function exit for local values
///   when a matching drop overload exists. `StdoutLock` uses this to unlock
///   automatically.

/// \cond INTERNAL_IMPORTS
mod std::io::detail;
use std::io::detail::*;
mod std::strbuf;
use std::strbuf::free;
use std::strbuf::len;
use std::strbuf::sub;
/// \endcond

pub struct Stdin {
    var _tag: i32;
};

pub struct Stdout {
    var _tag: i32;
};

pub struct Stderr {
    var _tag: i32;
};

pub struct StdoutLock {
    var _tag: i32;
};

/// @brief In-memory byte stream cursor (owned resource).
pub struct Cursor {
    var handle: i64;
};

/// @brief Trait-like read handle.
/// kind: 0 = Cursor, 1 = Stdin.
pub struct Read {
    var kind: i32;
    var cursor: Cursor;
};

/// @brief Trait-like write handle.
/// kind: 0 = Cursor, 1 = Stdout.
pub struct Write {
    var kind: i32;
    var cursor: Cursor;
};

/// @brief Trait-like seek handle (Cursor-backed).
pub struct Seek {
    var cursor: Cursor;
};

/// @brief Trait-like buffered reader handle.
/// kind: 0 = Cursor, 1 = Stdin.
pub struct BufRead {
    var kind: i32;
    var cursor: Cursor;
};

/// @brief Seek constants (same semantics as C stdio).
pub fn seek_set() -> i32 { return 0; }
pub fn seek_cur() -> i32 { return 1; }
pub fn seek_end() -> i32 { return 2; }
pub fn buffering_unbuffered() -> i32 { return 0; }
pub fn buffering_line() -> i32 { return 1; }
pub fn buffering_full() -> i32 { return 2; }

/// @brief Return stdin handle.
pub fn stdin() -> Stdin {
    return Stdin { _tag: 0 };
}

/// @brief Return stdout handle.
pub fn stdout() -> Stdout {
    return Stdout { _tag: 0 };
}

/// @brief Return stderr handle.
pub fn stderr() -> Stderr {
    return Stderr { _tag: 0 };
}

/// @brief Read a line from stdin into `buf` (NUL-terminated).
/// @param input stdin handle.
/// @param buf caller-allocated writable string buffer.
/// @param capacity max bytes including NUL.
/// @return bytes read (without trailing newline), or -1 on EOF/error.
pub fn read_line(input: Stdin, buf: string, capacity: i64) -> i64 {
    return __mlang_std_io_stdin_read_line(buf, capacity);
}

/// @brief Non-blocking line read from stdin.
/// @return >0 bytes read, 0 if no data available yet, -1 on EOF/error.
pub fn read_line_nonblocking(input: Stdin, buf: string, capacity: i64) -> i64 {
    return __mlang_std_io_stdin_read_line_nonblocking(buf, capacity);
}

/// @brief Non-blocking read of one raw byte from stdin.
/// @return 0..255 byte value, -2 when no byte available, -1 on EOF/error.
pub fn read_keycode_nonblocking(input: Stdin) -> i32 {
    return __mlang_std_io_stdin_read_byte_nonblocking();
}

/// @brief Non-blocking read into a newly allocated string.
/// @return Newly allocated text when available, otherwise empty string.
pub fn read_keys_nonblocking(input: Stdin, capacity: i64) -> string {
    let cap: i64 = capacity <= 1 ? 32 : capacity;
    let buf: string = String::with_capacity(cap);
    let n: i64 = read_line_nonblocking(input, buf, cap);
    if n <= 0 {
        String::free(buf);
        return String::new();
    }
    return buf;
}

/// @brief Read first pending key as single-byte string (non-blocking).
/// Intended for stdin raw mode polling loops.
/// @return Newly allocated one-char string, or empty string when no key.
pub fn read_key_nonblocking(input: Stdin) -> string {
    let keys: string = read_keys_nonblocking(input, 32);
    if len(keys) == 0 {
        return keys;
    }
    let one: string = sub(keys, 0, 1);
    free(keys);
    return one;
}

/// @brief Create in-memory cursor with initial capacity.
pub fn cursor_with_capacity(capacity: i64) -> Cursor {
    let h = __mlang_std_io_cursor_new(capacity);
    return Cursor { handle: h };
}

/// @brief Build a cursor initialized with `s` and reset to start.
pub fn cursor_from_string(s: string) -> Cursor {
    let c = cursor_with_capacity(16);
    __mlang_std_io_cursor_write(c.handle, s);
    __mlang_std_io_cursor_seek(c.handle, 0, seek_set());
    return c;
}

/// @brief Free a cursor resource.
pub fn cursor_free(c: Cursor) -> void {
    __mlang_std_io_cursor_free(c.handle);
}

/// @brief Read one line into a newly allocated buffer.
/// Returns empty string on EOF/error.
pub fn read_line_owned(input: Stdin, capacity: i64) -> string {
    let buf = String::with_capacity(capacity);
    let n = read_line(input, buf, capacity);
    if n < 0 {
        String::free(buf);
        return String::new();
    }
    return buf;
}

/// @brief Acquire global stdout lock.
/// @param out stdout handle.
/// @return lock token used for synchronized writes.
pub fn lock(out: Stdout) -> StdoutLock {
    __mlang_std_io_stdout_lock();
    return StdoutLock { _tag: 0 };
}

/// @brief Write text to stdout.
/// @param out stdout handle.
pub fn write(out: Stdout, s: string) -> i64 {
    return __mlang_std_io_stdout_write(s);
}

/// @brief Write text to stderr.
pub fn write(err: Stderr, s: string) -> i64 {
    return __mlang_std_io_stderr_write(s);
}

/// @brief Adapt Stdin to trait-like Read.
pub fn as_read(input: Stdin) -> Read {
    return Read { kind: 1, cursor: Cursor { handle: 0 } };
}

/// @brief Adapt Cursor to trait-like Read.
pub fn as_read(c: Cursor) -> Read {
    return Read { kind: 0, cursor: c };
}

/// @brief Write text + newline to stdout.
/// @param out stdout handle.
pub fn writeln(out: Stdout, s: string) -> i64 {
    return __mlang_std_io_stdout_writeln(s);
}

/// @brief Write text + newline to stderr.
pub fn writeln(err: Stderr, s: string) -> i64 {
    return __mlang_std_io_stderr_writeln(s);
}

/// @brief Adapt Stdout to trait-like Write.
pub fn as_write(out: Stdout) -> Write {
    return Write { kind: 1, cursor: Cursor { handle: 0 } };
}

/// @brief Adapt Stderr to trait-like Write.
pub fn as_write(err: Stderr) -> Write {
    return Write { kind: 2, cursor: Cursor { handle: 0 } };
}

/// @brief Adapt Cursor to trait-like Write.
pub fn as_write(c: Cursor) -> Write {
    return Write { kind: 0, cursor: c };
}

/// @brief Adapt Stdin to trait-like BufRead.
pub fn as_buf_read(input: Stdin) -> BufRead {
    return BufRead { kind: 1, cursor: Cursor { handle: 0 } };
}

/// @brief Adapt Cursor to trait-like BufRead.
pub fn as_buf_read(c: Cursor) -> BufRead {
    return BufRead { kind: 0, cursor: c };
}

/// @brief Adapt Cursor to trait-like Seek.
pub fn as_seek(c: Cursor) -> Seek {
    return Seek { cursor: c };
}

/// @brief Write text while holding stdout lock.
/// @param lockToken stdout lock token.
pub fn write_locked(lockToken: StdoutLock, s: string) -> i64 {
    return __mlang_std_io_stdout_write(s);
}

/// @brief Write text + newline while holding stdout lock.
/// @param lockToken stdout lock token.
pub fn writeln_locked(lockToken: StdoutLock, s: string) -> i64 {
    return __mlang_std_io_stdout_writeln(s);
}

/// @brief Explicitly release stdout lock.
pub fn unlock(lockToken: StdoutLock) -> i32 {
    return __mlang_std_io_stdout_unlock();
}

/// @brief Check whether stdout lock is currently acquirable.
/// Returns 1 when lock is free, 0 when busy.
pub fn try_lock(out: Stdout) -> i32 {
    return __mlang_std_io_stdout_try_lock();
}

/// @brief Write text with implicit lock/unlock around the write.
pub fn write_sync(out: Stdout, s: string) -> i64 {
    let lk: StdoutLock = lock(out);
    return write_locked(lk, s);
}

/// @brief Write text+newline with implicit lock/unlock around the write.
pub fn writeln_sync(out: Stdout, s: string) -> i64 {
    let lk: StdoutLock = lock(out);
    return writeln_locked(lk, s);
}

/// @brief Trait-like read.
/// Stdin backend currently reads one logical line.
pub fn read(reader: Read, buf: string, capacity: i64) -> i64 {
    if reader.kind == 1 {
        return __mlang_std_io_stdin_read_line(buf, capacity);
    }
    return __mlang_std_io_cursor_read(reader.cursor.handle, buf, capacity);
}

/// @brief Trait-like write.
pub fn write(writer: Write, s: string) -> i64 {
    if writer.kind == 1 {
        return __mlang_std_io_stdout_write(s);
    }
    if writer.kind == 2 {
        return __mlang_std_io_stderr_write(s);
    }
    return __mlang_std_io_cursor_write(writer.cursor.handle, s);
}

/// @brief Trait-like buffered read line.
pub fn read_line(reader: BufRead, buf: string, capacity: i64) -> i64 {
    if reader.kind == 1 {
        return __mlang_std_io_stdin_read_line(buf, capacity);
    }
    return __mlang_std_io_cursor_read_line(reader.cursor.handle, buf, capacity);
}

/// @brief Trait-like seek.
pub fn seek(seeker: Seek, offset: i64, whence: i32) -> i64 {
    return __mlang_std_io_cursor_seek(seeker.cursor.handle, offset, whence);
}

/// @brief Read full cursor contents as a newly allocated string.
pub fn to_string(c: Cursor) -> string {
    return __mlang_std_io_cursor_to_string(c.handle);
}

/// @brief Flush stdout stream buffers.
pub fn flush(out: Stdout) -> i32 {
    return __mlang_std_io_stdout_flush();
}

/// @brief Flush stderr stream buffers.
pub fn flush(err: Stderr) -> i32 {
    return __mlang_std_io_stderr_flush();
}

/// @brief Set stdin buffering mode and size (bytes for full/line modes).
pub fn set_stdin_buffering(mode: i32, size: i64) -> i32 {
    return __mlang_std_io_set_stdin_buffering(mode, size);
}

/// @brief Set stdout buffering mode and size.
pub fn set_stdout_buffering(mode: i32, size: i64) -> i32 {
    return __mlang_std_io_set_stdout_buffering(mode, size);
}

/// @brief Set stderr buffering mode and size.
pub fn set_stderr_buffering(mode: i32, size: i64) -> i32 {
    return __mlang_std_io_set_stderr_buffering(mode, size);
}

/// @brief Read one character from stdin.
///
/// Wraps C `getchar()`.  Returns the character as an `i32` code point,
/// or `-1` on EOF or error.
///
/// ```mlang
/// let ch: i32 = get_char();
/// if ch == -1: { /* EOF */ }
/// println!("got: {}", ch);
/// ```
pub fn get_char() -> i32 {
    return __mlang_std_io_get_char();
}

/// @brief Compiler-recognized scope-exit destructor for StdoutLock.
/// Local `StdoutLock` variables are auto-unlocked on scope/function exit.
pub fn __drop(lockToken: StdoutLock) -> void {
    unlock(lockToken);
}
