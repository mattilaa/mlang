/// \file audio.mla
/// \brief Common audio hardware output helpers (std::audio).
///
/// Backends:
/// - macOS: CoreAudio Audio Queue output.
/// - Linux: JACK2 output when `libjack` and a running JACK server are present.

/// \cond INTERNAL_IMPORTS
mod std::audio::detail;
use std::audio::detail::*;
/// \endcond

/// @brief Owned output device/stream handle.
pub struct AudioDevice {
    var handle: i64;
};

/// @brief Lowercase stdlib type alias for `AudioDevice`.
alias audio_device = AudioDevice;

/// @brief Owned stereo input processing graph with serial inserts and parallel racks.
pub struct AudioInsertStack {
    var handle: i64;
};

/// @brief Non-owning effect-rack reference created by an `AudioInsertStack`.
pub struct AudioEffectRack {
    var stack_handle: i64;
    var rack_id: i64;
};

alias audio_insert_stack = AudioInsertStack;
alias audio_effect_rack = AudioEffectRack;

/// @brief Ableton-style multi-track routing graph with one master device.
pub struct AudioMixer {
    var handle: i64;
};

/// @brief Non-owning ordinary audio-track reference.
pub struct AudioTrack {
    var mixer_handle: i64;
    var track_id: i64;
};

/// @brief Non-owning send-only return-track reference.
pub struct AudioReturnTrack {
    var mixer_handle: i64;
    var track_id: i64;
};

alias audio_mixer = AudioMixer;
alias audio_track = AudioTrack;
alias audio_return_track = AudioReturnTrack;

/// @brief Owned decoded mono/stereo 16-bit PCM WAV or AIFF file.
pub struct PcmAudio {
    var handle: i64;
};

/// @brief Lowercase stdlib type alias for `PcmAudio`.
alias pcm_audio = PcmAudio;

/// @brief Owned preallocated interleaved stereo PCM producer block.
pub struct PcmBlock {
    var handle: i64;
};

/// @brief Lowercase stdlib type alias for `PcmBlock`.
alias pcm_block = PcmBlock;

/// @brief Streaming stereo 16-bit PCM WAV file writer.
pub struct PcmWavWriter {
    var handle: i64;
};

/// @brief Lowercase stdlib type alias for `PcmWavWriter`.
alias pcm_wav_writer = PcmWavWriter;


/// @brief Return the compiled/default std::audio backend name.
pub fn backend_name() -> str8 {
    return __mlang_std_audio_backend_name();
}

/// @brief Return the latest std::audio backend error.
pub fn last_error() -> str8 {
    return __mlang_std_audio_last_error();
}

/// @brief Return the number of selectable output devices.
pub fn device_count() -> i64 {
    return __mlang_std_audio_device_count();
}

/// @brief Return the default output device id, or `-1` if unavailable.
pub fn default_output_device_id() -> i64 {
    return __mlang_std_audio_default_output_device_id();
}

/// @brief Return a printable output device name for an integer device id.
pub fn device_name(device_id: i64) -> str8 {
    return __mlang_std_audio_device_name(device_id);
}

/// @brief Return the number of selectable stereo input device pairs.
pub fn input_device_count() -> i64 {
    return __mlang_std_audio_input_device_count();
}

/// @brief Return the default input device id, or `-1` if unavailable.
pub fn default_input_device_id() -> i64 {
    return __mlang_std_audio_default_input_device_id();
}

/// @brief Return a printable input device name for an integer device id.
pub fn input_device_name(device_id: i64) -> str8 {
    return __mlang_std_audio_input_device_name(device_id);
}

/// @brief Explicit output-oriented alias for `device_count()`.
pub fn output_device_count() -> i64 {
    return device_count();
}

/// @brief Explicit output-oriented alias for `device_name()`.
pub fn output_device_name(device_id: i64) -> str8 {
    return device_name(device_id);
}

impl PcmAudio {
    /// @brief Decode a mono/stereo 16-bit PCM WAV, AIFF, or AIFF-C file.
    ///
    /// Paths beginning with `~/` are expanded using the current home directory.
    pub fn load(path: str8) -> result<PcmAudio, str8> {
        let h: i64 = __mlang_std_audio_pcm_load(path);
        if h == 0 {
            return Err<PcmAudio, str8>(last_error());
        }
        return Ok<PcmAudio, str8>(PcmAudio { handle: h });
    }

    /// @brief Return the decoded source sample rate.
    pub fn sample_rate(self: PcmAudio) -> i64 {
        return __mlang_std_audio_pcm_file_sample_rate(self.handle);
    }

    /// @brief Return one or two decoded channels.
    pub fn channels(self: PcmAudio) -> i64 {
        return __mlang_std_audio_pcm_file_channels(self.handle);
    }

    /// @brief Return the decoded frame count.
    pub fn frame_count(self: PcmAudio) -> i64 {
        return __mlang_std_audio_pcm_file_frame_count(self.handle);
    }

    /// @brief Copy decoded interleaved samples into an MLang f32 list.
    pub fn samples(self: PcmAudio) -> list<f32> {
        return __mlang_std_audio_pcm_file_samples(self.handle);
    }

    /// @brief Release the native decoded file buffer.
    pub fn close(self: PcmAudio) -> i32 {
        return __mlang_std_audio_pcm_file_close(self.handle);
    }
}

impl PcmBlock {
    /// @brief Allocate a reusable zero-filled stereo block.
    pub fn new(capacity_frames: i64) -> result<PcmBlock, str8> {
        let h: i64 = __mlang_std_audio_pcm_block_new(capacity_frames);
        if h == 0 {
            return Err<PcmBlock, str8>(last_error());
        }
        return Ok<PcmBlock, str8>(PcmBlock { handle: h });
    }

    /// @brief Return the fixed block capacity in stereo frames.
    pub fn capacity_frames(self: PcmBlock) -> i64 {
        return __mlang_std_audio_pcm_block_capacity_frames(self.handle);
    }

    /// @brief Write one stereo frame without allocating.
    pub fn set_stereo(self: PcmBlock, frame: i64, left: f32, right: f32) -> i32 {
        return __mlang_std_audio_pcm_block_set_stereo(self.handle, frame, left, right);
    }

    /// @brief Read the left sample of a stereo frame.
    pub fn left(self: PcmBlock, frame: i64) -> f32 {
        return __mlang_std_audio_pcm_block_sample(self.handle, frame, 0);
    }

    /// @brief Read the right sample of a stereo frame.
    pub fn right(self: PcmBlock, frame: i64) -> f32 {
        return __mlang_std_audio_pcm_block_sample(self.handle, frame, 1);
    }

    /// @brief Fill the complete block with silence.
    pub fn clear(self: PcmBlock) -> i32 {
        return __mlang_std_audio_pcm_block_clear(self.handle);
    }

    /// @brief Release the native block.
    pub fn close(self: PcmBlock) -> i32 {
        return __mlang_std_audio_pcm_block_close(self.handle);
    }
}

impl PcmWavWriter {
    /// @brief Create or replace a stereo 16-bit PCM WAV output file.
    ///
    /// Paths beginning with `~/` are expanded using the current home directory.
    /// Call `close()` to finalize the RIFF and data sizes in the WAV header.
    pub fn create(path: str8, sample_rate: i64) -> result<PcmWavWriter, str8> {
        let h: i64 = __mlang_std_audio_pcm_wav_writer_new(path, sample_rate);
        if h == 0 {
            return Err<PcmWavWriter, str8>(last_error());
        }
        return Ok<PcmWavWriter, str8>(PcmWavWriter { handle: h });
    }

    /// @brief Append frames from a reusable stereo PCM block.
    pub fn write_pcm_block(self: PcmWavWriter, block: PcmBlock, frames: i64) -> result<i64, str8> {
        let written: i64 = __mlang_std_audio_pcm_wav_writer_write_block(self.handle, block.handle, frames);
        if written < 0 {
            return Err<i64, str8>(last_error());
        }
        return Ok<i64, str8>(written);
    }

    /// @brief Return the number of stereo frames written so far.
    pub fn frames_written(self: PcmWavWriter) -> i64 {
        return __mlang_std_audio_pcm_wav_writer_frames_written(self.handle);
    }

    /// @brief Finalize the WAV header, close the file, and release the writer.
    pub fn close(self: PcmWavWriter) -> result<i32, str8> {
        let rc: i32 = __mlang_std_audio_pcm_wav_writer_close(self.handle);
        if rc != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }
}

impl AudioInsertStack {
    /// @brief Create an offline insert stack for deterministic block processing.
    pub fn new(sample_rate: i64, buffer_frames: i64) -> result<AudioInsertStack, str8> {
        let h: i64 = __mlang_std_audio_insert_stack_new(sample_rate, buffer_frames);
        if h == 0 {
            return Err<AudioInsertStack, str8>(last_error());
        }
        return Ok<AudioInsertStack, str8>(AudioInsertStack { handle: h });
    }

    /// @brief Open the default stereo input and output as a real-time insert stack.
    pub fn open_default(client_name: str8, sample_rate: i64, buffer_frames: i64) -> result<AudioInsertStack, str8> {
        let h: i64 = __mlang_std_audio_insert_stack_open_default(client_name, sample_rate, buffer_frames);
        if h == 0 {
            return Err<AudioInsertStack, str8>(last_error());
        }
        return Ok<AudioInsertStack, str8>(AudioInsertStack { handle: h });
    }

    /// @brief Open selected stereo input and output device ids.
    pub fn open(input_device_id: i64, output_device_id: i64, client_name: str8, sample_rate: i64, buffer_frames: i64) -> result<AudioInsertStack, str8> {
        let h: i64 = __mlang_std_audio_insert_stack_open_devices(input_device_id, output_device_id, client_name, sample_rate, buffer_frames);
        if h == 0 { return Err<AudioInsertStack, str8>(last_error()); }
        return Ok<AudioInsertStack, str8>(AudioInsertStack { handle: h });
    }

    /// @brief Add a serial gain insert. `wet` is clamped to `0..1`.
    pub fn add_gain(self: AudioInsertStack, gain: f64, wet: f64) -> result<i64, str8> {
        let id: i64 = __mlang_std_audio_insert_stack_add_gain(self.handle, gain, wet);
        if id < 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(id);
    }

    /// @brief Add a serial one-pole low-pass insert.
    pub fn add_lowpass(self: AudioInsertStack, cutoff_hz: f64, wet: f64) -> result<i64, str8> {
        let id: i64 = __mlang_std_audio_insert_stack_add_lowpass(self.handle, cutoff_hz, wet);
        if id < 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(id);
    }

    /// @brief Add a serial soft-clipping distortion insert.
    pub fn add_distortion(self: AudioInsertStack, drive: f64, wet: f64) -> result<i64, str8> {
        let id: i64 = __mlang_std_audio_insert_stack_add_distortion(self.handle, drive, wet);
        if id < 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(id);
    }

    /// @brief Add a serial feedback delay insert.
    pub fn add_delay(self: AudioInsertStack, delay_ms: f64, feedback: f64, wet: f64) -> result<i64, str8> {
        let id: i64 = __mlang_std_audio_insert_stack_add_delay(self.handle, delay_ms, feedback, wet);
        if id < 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(id);
    }

    /// @brief Add a parallel effect-rack track with independent dry/wet gains.
    ///
    /// Rack tracks are summed. For conventional auxiliary sends, use a dry gain
    /// of `1` on one rack and `0` on additional racks to avoid duplicating dry audio.
    pub fn add_rack(self: AudioInsertStack, dry: f64, wet: f64) -> result<AudioEffectRack, str8> {
        let id: i64 = __mlang_std_audio_insert_stack_add_rack(self.handle, dry, wet);
        if id < 0 { return Err<AudioEffectRack, str8>(last_error()); }
        return Ok<AudioEffectRack, str8>(AudioEffectRack { stack_handle: self.handle, rack_id: id });
    }

    /// @brief Process stereo PCM through this graph without opening audio hardware.
    pub fn process_block(self: AudioInsertStack, input: PcmBlock, output: PcmBlock, frames: i64) -> result<i32, str8> {
        let rc: i32 = __mlang_std_audio_insert_stack_process_block(self.handle, input.handle, output.handle, frames);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    pub fn insert_count(self: AudioInsertStack) -> i64 {
        return __mlang_std_audio_insert_stack_insert_count(self.handle);
    }

    pub fn rack_count(self: AudioInsertStack) -> i64 {
        return __mlang_std_audio_insert_stack_rack_count(self.handle);
    }

    pub fn sample_rate(self: AudioInsertStack) -> i64 {
        return __mlang_std_audio_insert_stack_sample_rate(self.handle);
    }

    pub fn buffer_frames(self: AudioInsertStack) -> i64 {
        return __mlang_std_audio_insert_stack_buffer_frames(self.handle);
    }

    /// @brief Start real-time input processing. Only valid for `open_default()`.
    pub fn start(self: AudioInsertStack) -> result<i32, str8> {
        let rc: i32 = __mlang_std_audio_insert_stack_start(self.handle);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    pub fn stop(self: AudioInsertStack) -> i32 {
        return __mlang_std_audio_insert_stack_stop(self.handle);
    }

    pub fn close(self: AudioInsertStack) -> i32 {
        return __mlang_std_audio_insert_stack_close(self.handle);
    }
}

impl AudioEffectRack {
    /// @brief Change this rack track's dry/wet gains while the stack is stopped.
    pub fn set_mix(self: AudioEffectRack, dry: f64, wet: f64) -> result<i32, str8> {
        let rc: i32 = __mlang_std_audio_insert_stack_set_rack_mix(self.stack_handle, self.rack_id, dry, wet);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    pub fn add_gain(self: AudioEffectRack, gain: f64) -> result<i64, str8> {
        let id: i64 = __mlang_std_audio_insert_stack_rack_add_gain(self.stack_handle, self.rack_id, gain);
        if id < 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(id);
    }

    pub fn add_lowpass(self: AudioEffectRack, cutoff_hz: f64) -> result<i64, str8> {
        let id: i64 = __mlang_std_audio_insert_stack_rack_add_lowpass(self.stack_handle, self.rack_id, cutoff_hz);
        if id < 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(id);
    }

    pub fn add_distortion(self: AudioEffectRack, drive: f64) -> result<i64, str8> {
        let id: i64 = __mlang_std_audio_insert_stack_rack_add_distortion(self.stack_handle, self.rack_id, drive);
        if id < 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(id);
    }

    pub fn add_delay(self: AudioEffectRack, delay_ms: f64, feedback: f64) -> result<i64, str8> {
        let id: i64 = __mlang_std_audio_insert_stack_rack_add_delay(self.stack_handle, self.rack_id, delay_ms, feedback);
        if id < 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(id);
    }
}

impl AudioMixer {
    /// @brief Create an offline mixer for block rendering and tests.
    pub fn new(sample_rate: i64, buffer_frames: i64) -> result<AudioMixer, str8> {
        let h: i64 = __mlang_std_audio_mixer_new(sample_rate, buffer_frames);
        if h == 0 { return Err<AudioMixer, str8>(last_error()); }
        return Ok<AudioMixer, str8>(AudioMixer { handle: h });
    }

    /// @brief Open one default stereo input and one master output device.
    pub fn open_default(client_name: str8, sample_rate: i64, buffer_frames: i64) -> result<AudioMixer, str8> {
        let h: i64 = __mlang_std_audio_mixer_open_default(client_name, sample_rate, buffer_frames);
        if h == 0 { return Err<AudioMixer, str8>(last_error()); }
        return Ok<AudioMixer, str8>(AudioMixer { handle: h });
    }

    /// @brief Open selected stereo input and master output device ids.
    ///
    /// Pass ids returned by `input_device_count()`/`output_device_count()`.
    /// Negative ids select the corresponding system default.
    pub fn open(input_device_id: i64, output_device_id: i64, client_name: str8, sample_rate: i64, buffer_frames: i64) -> result<AudioMixer, str8> {
        let h: i64 = __mlang_std_audio_mixer_open_devices(input_device_id, output_device_id, client_name, sample_rate, buffer_frames);
        if h == 0 { return Err<AudioMixer, str8>(last_error()); }
        return Ok<AudioMixer, str8>(AudioMixer { handle: h });
    }

    /// @brief Add an audio track. Its initial input is the default device and output is master.
    pub fn add_audio_track(self: AudioMixer, name: str8) -> result<AudioTrack, str8> {
        let id: i64 = __mlang_std_audio_mixer_add_audio_track(self.handle, name);
        if id < 0 { return Err<AudioTrack, str8>(last_error()); }
        return Ok<AudioTrack, str8>(AudioTrack { mixer_handle: self.handle, track_id: id });
    }

    /// @brief Add a return track fed only by sends. Its initial output is master.
    pub fn add_return_track(self: AudioMixer, name: str8) -> result<AudioReturnTrack, str8> {
        let id: i64 = __mlang_std_audio_mixer_add_return_track(self.handle, name);
        if id < 0 { return Err<AudioReturnTrack, str8>(last_error()); }
        return Ok<AudioReturnTrack, str8>(AudioReturnTrack { mixer_handle: self.handle, track_id: id });
    }

    pub fn set_master_gain(self: AudioMixer, gain: f64) -> result<i32, str8> {
        let rc: i32 = __mlang_std_audio_mixer_set_master_gain(self.handle, gain);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    pub fn process_block(self: AudioMixer, input: PcmBlock, output: PcmBlock, frames: i64) -> result<i32, str8> {
        let rc: i32 = __mlang_std_audio_mixer_process_block(self.handle, input.handle, output.handle, frames);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    pub fn track_count(self: AudioMixer) -> i64 {
        return __mlang_std_audio_mixer_track_count(self.handle);
    }

    pub fn sample_rate(self: AudioMixer) -> i64 {
        return __mlang_std_audio_mixer_sample_rate(self.handle);
    }

    pub fn buffer_frames(self: AudioMixer) -> i64 {
        return __mlang_std_audio_mixer_buffer_frames(self.handle);
    }

    pub fn start(self: AudioMixer) -> result<i32, str8> {
        let rc: i32 = __mlang_std_audio_mixer_start(self.handle);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    pub fn stop(self: AudioMixer) -> i32 {
        return __mlang_std_audio_mixer_stop(self.handle);
    }

    pub fn close(self: AudioMixer) -> i32 {
        return __mlang_std_audio_mixer_close(self.handle);
    }
}

impl AudioTrack {
    /// @brief Select the mixer's default stereo hardware input.
    pub fn set_input_device(self: AudioTrack) -> result<i32, str8> {
        let rc: i32 = __mlang_std_audio_mixer_track_set_input_device(self.mixer_handle, self.track_id);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    /// @brief Select another ordinary track's post-fader signal as input.
    pub fn set_input_track(self: AudioTrack, source: AudioTrack) -> result<i32, str8> {
        if self.mixer_handle != source.mixer_handle {
            return Err<i32, str8>("audio tracks belong to different mixers");
        }
        let rc: i32 = __mlang_std_audio_mixer_track_set_input_track(self.mixer_handle, self.track_id, source.track_id);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    /// @brief Route this track directly to the one physical master output.
    pub fn set_output_master(self: AudioTrack) -> result<i32, str8> {
        let rc: i32 = __mlang_std_audio_mixer_track_set_output(self.mixer_handle, self.track_id, -1);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    /// @brief Route this track's post-fader signal into another track.
    pub fn set_output_track(self: AudioTrack, destination: AudioTrack) -> result<i32, str8> {
        if self.mixer_handle != destination.mixer_handle {
            return Err<i32, str8>("audio tracks belong to different mixers");
        }
        let rc: i32 = __mlang_std_audio_mixer_track_set_output(self.mixer_handle, self.track_id, destination.track_id);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    /// @brief Set volume immediately. Prefer `set_volume()` for live automation.
    pub fn set_gain(self: AudioTrack, gain: f64) -> result<i32, str8> {
        let rc: i32 = __mlang_std_audio_mixer_track_set_gain(self.mixer_handle, self.track_id, gain);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    /// @brief Ramp volume to `volume` over `ramp_ms` milliseconds.
    ///
    /// This method is lock-free and may be called while the mixer is running.
    pub fn set_volume(self: AudioTrack, volume: f64, ramp_ms: f64) -> result<i32, str8> {
        let rc: i32 = __mlang_std_audio_mixer_track_set_volume(self.mixer_handle, self.track_id, volume, ramp_ms);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    /// @brief Ramp stereo balance to `pan` (`-1` left, `0` center, `1` right).
    ///
    /// This method is lock-free and may be called while the mixer is running.
    pub fn set_pan(self: AudioTrack, pan: f64, ramp_ms: f64) -> result<i32, str8> {
        let rc: i32 = __mlang_std_audio_mixer_track_set_pan(self.mixer_handle, self.track_id, pan, ramp_ms);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    pub fn set_muted(self: AudioTrack, muted: bool) -> result<i32, str8> {
        let rc: i32 = __mlang_std_audio_mixer_track_set_muted(self.mixer_handle, self.track_id, i32(muted));
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    /// @brief Set or replace a pre-fader (`false`) or post-fader (`true`) send.
    pub fn set_send(self: AudioTrack, target: AudioReturnTrack, level: f64, post_fader: bool) -> result<i32, str8> {
        if self.mixer_handle != target.mixer_handle {
            return Err<i32, str8>("audio tracks belong to different mixers");
        }
        let rc: i32 = __mlang_std_audio_mixer_track_set_send(self.mixer_handle, self.track_id, target.track_id, level, i32(post_fader));
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    pub fn add_gain(self: AudioTrack, gain: f64, wet: f64) -> result<i64, str8> {
        let id: i64 = __mlang_std_audio_mixer_track_add_gain(self.mixer_handle, self.track_id, gain, wet);
        if id < 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(id);
    }

    pub fn add_lowpass(self: AudioTrack, cutoff_hz: f64, wet: f64) -> result<i64, str8> {
        let id: i64 = __mlang_std_audio_mixer_track_add_lowpass(self.mixer_handle, self.track_id, cutoff_hz, wet);
        if id < 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(id);
    }

    pub fn add_distortion(self: AudioTrack, drive: f64, wet: f64) -> result<i64, str8> {
        let id: i64 = __mlang_std_audio_mixer_track_add_distortion(self.mixer_handle, self.track_id, drive, wet);
        if id < 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(id);
    }

    pub fn add_delay(self: AudioTrack, delay_ms: f64, feedback: f64, wet: f64) -> result<i64, str8> {
        let id: i64 = __mlang_std_audio_mixer_track_add_delay(self.mixer_handle, self.track_id, delay_ms, feedback, wet);
        if id < 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(id);
    }
}

impl AudioReturnTrack {
    pub fn set_output_master(self: AudioReturnTrack) -> result<i32, str8> {
        let rc: i32 = __mlang_std_audio_mixer_track_set_output(self.mixer_handle, self.track_id, -1);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    /// @brief Set volume immediately. Prefer `set_volume()` for live automation.
    pub fn set_gain(self: AudioReturnTrack, gain: f64) -> result<i32, str8> {
        let rc: i32 = __mlang_std_audio_mixer_track_set_gain(self.mixer_handle, self.track_id, gain);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    /// @brief Ramp return volume without discontinuities.
    pub fn set_volume(self: AudioReturnTrack, volume: f64, ramp_ms: f64) -> result<i32, str8> {
        let rc: i32 = __mlang_std_audio_mixer_track_set_volume(self.mixer_handle, self.track_id, volume, ramp_ms);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    /// @brief Ramp return stereo balance (`-1` left, `0` center, `1` right).
    pub fn set_pan(self: AudioReturnTrack, pan: f64, ramp_ms: f64) -> result<i32, str8> {
        let rc: i32 = __mlang_std_audio_mixer_track_set_pan(self.mixer_handle, self.track_id, pan, ramp_ms);
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    pub fn set_muted(self: AudioReturnTrack, muted: bool) -> result<i32, str8> {
        let rc: i32 = __mlang_std_audio_mixer_track_set_muted(self.mixer_handle, self.track_id, i32(muted));
        if rc != 0 { return Err<i32, str8>(last_error()); }
        return Ok<i32, str8>(0);
    }

    pub fn add_gain(self: AudioReturnTrack, gain: f64, wet: f64) -> result<i64, str8> {
        let id: i64 = __mlang_std_audio_mixer_track_add_gain(self.mixer_handle, self.track_id, gain, wet);
        if id < 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(id);
    }

    pub fn add_lowpass(self: AudioReturnTrack, cutoff_hz: f64, wet: f64) -> result<i64, str8> {
        let id: i64 = __mlang_std_audio_mixer_track_add_lowpass(self.mixer_handle, self.track_id, cutoff_hz, wet);
        if id < 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(id);
    }

    pub fn add_distortion(self: AudioReturnTrack, drive: f64, wet: f64) -> result<i64, str8> {
        let id: i64 = __mlang_std_audio_mixer_track_add_distortion(self.mixer_handle, self.track_id, drive, wet);
        if id < 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(id);
    }

    pub fn add_delay(self: AudioReturnTrack, delay_ms: f64, feedback: f64, wet: f64) -> result<i64, str8> {
        let id: i64 = __mlang_std_audio_mixer_track_add_delay(self.mixer_handle, self.track_id, delay_ms, feedback, wet);
        if id < 0 { return Err<i64, str8>(last_error()); }
        return Ok<i64, str8>(id);
    }
}

impl AudioDevice {
    /// @brief Open the default stereo output device.
    pub fn open_default(client_name: str8) -> result<AudioDevice, str8> {
        let h: i64 = __mlang_std_audio_open_default_output(client_name);
        if h == 0 {
            return Err<AudioDevice, str8>(last_error());
        }
        return Ok<AudioDevice, str8>(AudioDevice { handle: h });
    }

    /// @brief Open the default stereo output with requested sample rate and latency buffer.
    ///
    /// `sample_rate <= 0` and `buffer_frames <= 0` use backend defaults.
    /// JACK2 uses the server sample rate and treats `buffer_frames` as a server
    /// buffer-size request; query `sample_rate()` and `buffer_frames()` after open
    /// for the actual values.
    pub fn open_default_with_config(client_name: str8, sample_rate: i64, buffer_frames: i64) -> result<AudioDevice, str8> {
        let h: i64 = __mlang_std_audio_open_default_output_config(client_name, sample_rate, buffer_frames);
        if h == 0 {
            return Err<AudioDevice, str8>(last_error());
        }
        return Ok<AudioDevice, str8>(AudioDevice { handle: h });
    }

    /// @brief Open a selected stereo output device by integer device id.
    ///
    /// Pass an id from `0..device_count()-1`; use `default_output_device_id()`
    /// to select the system default.
    pub fn open(device_id: i64, client_name: str8) -> result<AudioDevice, str8> {
        let h: i64 = __mlang_std_audio_open_output_device(device_id, client_name);
        if h == 0 {
            return Err<AudioDevice, str8>(last_error());
        }
        return Ok<AudioDevice, str8>(AudioDevice { handle: h });
    }

    /// @brief Open a selected output device with requested sample rate and latency buffer.
    ///
    /// `sample_rate <= 0` and `buffer_frames <= 0` use backend defaults.
    pub fn open_with_config(device_id: i64, client_name: str8, sample_rate: i64, buffer_frames: i64) -> result<AudioDevice, str8> {
        let h: i64 = __mlang_std_audio_open_output_device_config(device_id, client_name, sample_rate, buffer_frames);
        if h == 0 {
            return Err<AudioDevice, str8>(last_error());
        }
        return Ok<AudioDevice, str8>(AudioDevice { handle: h });
    }

    /// @brief Start audio processing.
    pub fn start(self: AudioDevice) -> result<i32, str8> {
        let rc: i32 = __mlang_std_audio_start(self.handle);
        if rc != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Stop audio processing.
    pub fn stop(self: AudioDevice) -> i32 {
        return __mlang_std_audio_stop(self.handle);
    }

    /// @brief Close the audio device and release backend resources.
    pub fn close(self: AudioDevice) -> i32 {
        return __mlang_std_audio_close(self.handle);
    }

    /// @brief Query the active stream sample rate.
    pub fn sample_rate(self: AudioDevice) -> i64 {
        return __mlang_std_audio_sample_rate(self.handle);
    }

    /// @brief Query backend buffer size in frames.
    pub fn buffer_frames(self: AudioDevice) -> i64 {
        return __mlang_std_audio_buffer_frames(self.handle);
    }

    /// @brief Return the fixed stereo PCM queue capacity in frames.
    pub fn pcm_capacity_frames(self: AudioDevice) -> i64 {
        return __mlang_std_audio_pcm_capacity_frames(self.handle);
    }

    /// @brief Return the number of stereo PCM frames waiting for playback.
    pub fn pcm_queued_frames(self: AudioDevice) -> i64 {
        return __mlang_std_audio_pcm_queued_frames(self.handle);
    }

    /// @brief Return the number of stereo PCM frames that can be queued now.
    pub fn pcm_available_frames(self: AudioDevice) -> i64 {
        return __mlang_std_audio_pcm_available_frames(self.handle);
    }

    /// @brief Return the number of callbacks that exhausted the PCM queue.
    pub fn pcm_underrun_count(self: AudioDevice) -> i64 {
        return __mlang_std_audio_pcm_underrun_count(self.handle);
    }

    /// @brief Discard queued PCM and reset its underrun counter.
    ///
    /// Call while stopped; clearing concurrently with playback is not supported.
    pub fn clear_pcm_queue(self: AudioDevice) -> i32 {
        return __mlang_std_audio_pcm_clear(self.handle);
    }

    /// @brief Queue nonblocking interleaved stereo f32 samples.
    ///
    /// The list layout is `[L0, R0, L1, R1, ...]`. The complete list is copied
    /// into a preallocated native ring, or an error is returned when its length
    /// is odd or insufficient free frames are available. Queue initial blocks
    /// before `start()` and refill according to `pcm_available_frames()`.
    pub fn queue_interleaved_f32(self: AudioDevice, samples: &list<f32>) -> result<i64, str8> {
        let frames: i64 = __mlang_std_audio_queue_interleaved_f32(self.handle, samples);
        if frames < 0 {
            return Err<i64, str8>(last_error());
        }
        return Ok<i64, str8>(frames);
    }

    /// @brief Queue frames from a reusable preallocated stereo PCM block.
    pub fn queue_pcm_block(self: AudioDevice, block: PcmBlock, frames: i64) -> result<i64, str8> {
        let queued: i64 = __mlang_std_audio_queue_pcm_block(self.handle, block.handle, frames);
        if queued < 0 {
            return Err<i64, str8>(last_error());
        }
        return Ok<i64, str8>(queued);
    }

    /// @brief Play a built-in stereo sine tone through the output stream.
    pub fn play_sine(self: AudioDevice, frequency_hz: f64, gain: f64, duration_ms: i64) -> result<i32, str8> {
        let rc: i32 = __mlang_std_audio_play_sine(self.handle, frequency_hz, gain, duration_ms);
        if rc != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }
}
