/// \file audio.mla
/// \brief Common audio hardware output helpers (std::audio).
///
/// Backends:
/// - macOS: CoreAudio Audio Queue output.
/// - Linux: JACK2 output when `libjack` and a running JACK server are present.

/// \cond INTERNAL_IMPORTS
mod std::audio::detail;
use std::audio::detail::*;
/// \endcond

/// @brief Owned output device/stream handle.
pub struct AudioDevice {
    var handle: i64;
};

/// @brief Lowercase stdlib type alias for `AudioDevice`.
alias audio_device = AudioDevice;

/// @brief Owned decoded mono/stereo 16-bit PCM WAV or AIFF file.
pub struct PcmAudio {
    var handle: i64;
};

/// @brief Lowercase stdlib type alias for `PcmAudio`.
alias pcm_audio = PcmAudio;

/// @brief Owned preallocated interleaved stereo PCM producer block.
pub struct PcmBlock {
    var handle: i64;
};

/// @brief Lowercase stdlib type alias for `PcmBlock`.
alias pcm_block = PcmBlock;


/// @brief Return the compiled/default std::audio backend name.
pub fn backend_name() -> str8 {
    return __mlang_std_audio_backend_name();
}

/// @brief Return the latest std::audio backend error.
pub fn last_error() -> str8 {
    return __mlang_std_audio_last_error();
}

/// @brief Return the number of selectable output devices.
pub fn device_count() -> i64 {
    return __mlang_std_audio_device_count();
}

/// @brief Return the default output device id, or `-1` if unavailable.
pub fn default_output_device_id() -> i64 {
    return __mlang_std_audio_default_output_device_id();
}

/// @brief Return a printable output device name for an integer device id.
pub fn device_name(device_id: i64) -> str8 {
    return __mlang_std_audio_device_name(device_id);
}

impl PcmAudio {
    /// @brief Decode a mono/stereo 16-bit PCM WAV, AIFF, or AIFF-C file.
    ///
    /// Paths beginning with `~/` are expanded using the current home directory.
    pub fn load(path: str8) -> Result<PcmAudio, str8> {
        let h: i64 = __mlang_std_audio_pcm_load(path);
        if h == 0 {
            return Err<PcmAudio, str8>(last_error());
        }
        return Ok<PcmAudio, str8>(PcmAudio { handle: h });
    }

    /// @brief Return the decoded source sample rate.
    pub fn sample_rate(self: PcmAudio) -> i64 {
        return __mlang_std_audio_pcm_file_sample_rate(self.handle);
    }

    /// @brief Return one or two decoded channels.
    pub fn channels(self: PcmAudio) -> i64 {
        return __mlang_std_audio_pcm_file_channels(self.handle);
    }

    /// @brief Return the decoded frame count.
    pub fn frame_count(self: PcmAudio) -> i64 {
        return __mlang_std_audio_pcm_file_frame_count(self.handle);
    }

    /// @brief Copy decoded interleaved samples into an MLang f32 list.
    pub fn samples(self: PcmAudio) -> list<f32> {
        return __mlang_std_audio_pcm_file_samples(self.handle);
    }

    /// @brief Release the native decoded file buffer.
    pub fn close(self: PcmAudio) -> i32 {
        return __mlang_std_audio_pcm_file_close(self.handle);
    }
}

impl PcmBlock {
    /// @brief Allocate a reusable zero-filled stereo block.
    pub fn new(capacity_frames: i64) -> Result<PcmBlock, str8> {
        let h: i64 = __mlang_std_audio_pcm_block_new(capacity_frames);
        if h == 0 {
            return Err<PcmBlock, str8>(last_error());
        }
        return Ok<PcmBlock, str8>(PcmBlock { handle: h });
    }

    /// @brief Return the fixed block capacity in stereo frames.
    pub fn capacity_frames(self: PcmBlock) -> i64 {
        return __mlang_std_audio_pcm_block_capacity_frames(self.handle);
    }

    /// @brief Write one stereo frame without allocating.
    pub fn set_stereo(self: PcmBlock, frame: i64, left: f32, right: f32) -> i32 {
        return __mlang_std_audio_pcm_block_set_stereo(self.handle, frame, left, right);
    }

    /// @brief Fill the complete block with silence.
    pub fn clear(self: PcmBlock) -> i32 {
        return __mlang_std_audio_pcm_block_clear(self.handle);
    }

    /// @brief Release the native block.
    pub fn close(self: PcmBlock) -> i32 {
        return __mlang_std_audio_pcm_block_close(self.handle);
    }
}

impl AudioDevice {
    /// @brief Open the default stereo output device.
    pub fn open_default(client_name: str8) -> Result<AudioDevice, str8> {
        let h: i64 = __mlang_std_audio_open_default_output(client_name);
        if h == 0 {
            return Err<AudioDevice, str8>(last_error());
        }
        return Ok<AudioDevice, str8>(AudioDevice { handle: h });
    }

    /// @brief Open the default stereo output with requested sample rate and latency buffer.
    ///
    /// `sample_rate <= 0` and `buffer_frames <= 0` use backend defaults.
    /// JACK2 uses the server sample rate and treats `buffer_frames` as a server
    /// buffer-size request; query `sample_rate()` and `buffer_frames()` after open
    /// for the actual values.
    pub fn open_default_with_config(client_name: str8, sample_rate: i64, buffer_frames: i64) -> Result<AudioDevice, str8> {
        let h: i64 = __mlang_std_audio_open_default_output_config(client_name, sample_rate, buffer_frames);
        if h == 0 {
            return Err<AudioDevice, str8>(last_error());
        }
        return Ok<AudioDevice, str8>(AudioDevice { handle: h });
    }

    /// @brief Open a selected stereo output device by integer device id.
    ///
    /// Pass an id from `0..device_count()-1`; use `default_output_device_id()`
    /// to select the system default.
    pub fn open(device_id: i64, client_name: str8) -> Result<AudioDevice, str8> {
        let h: i64 = __mlang_std_audio_open_output_device(device_id, client_name);
        if h == 0 {
            return Err<AudioDevice, str8>(last_error());
        }
        return Ok<AudioDevice, str8>(AudioDevice { handle: h });
    }

    /// @brief Open a selected output device with requested sample rate and latency buffer.
    ///
    /// `sample_rate <= 0` and `buffer_frames <= 0` use backend defaults.
    pub fn open_with_config(device_id: i64, client_name: str8, sample_rate: i64, buffer_frames: i64) -> Result<AudioDevice, str8> {
        let h: i64 = __mlang_std_audio_open_output_device_config(device_id, client_name, sample_rate, buffer_frames);
        if h == 0 {
            return Err<AudioDevice, str8>(last_error());
        }
        return Ok<AudioDevice, str8>(AudioDevice { handle: h });
    }

    /// @brief Start audio processing.
    pub fn start(self: AudioDevice) -> Result<i32, str8> {
        let rc: i32 = __mlang_std_audio_start(self.handle);
        if rc != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Stop audio processing.
    pub fn stop(self: AudioDevice) -> i32 {
        return __mlang_std_audio_stop(self.handle);
    }

    /// @brief Close the audio device and release backend resources.
    pub fn close(self: AudioDevice) -> i32 {
        return __mlang_std_audio_close(self.handle);
    }

    /// @brief Query the active stream sample rate.
    pub fn sample_rate(self: AudioDevice) -> i64 {
        return __mlang_std_audio_sample_rate(self.handle);
    }

    /// @brief Query backend buffer size in frames.
    pub fn buffer_frames(self: AudioDevice) -> i64 {
        return __mlang_std_audio_buffer_frames(self.handle);
    }

    /// @brief Return the fixed stereo PCM queue capacity in frames.
    pub fn pcm_capacity_frames(self: AudioDevice) -> i64 {
        return __mlang_std_audio_pcm_capacity_frames(self.handle);
    }

    /// @brief Return the number of stereo PCM frames waiting for playback.
    pub fn pcm_queued_frames(self: AudioDevice) -> i64 {
        return __mlang_std_audio_pcm_queued_frames(self.handle);
    }

    /// @brief Return the number of stereo PCM frames that can be queued now.
    pub fn pcm_available_frames(self: AudioDevice) -> i64 {
        return __mlang_std_audio_pcm_available_frames(self.handle);
    }

    /// @brief Return the number of callbacks that exhausted the PCM queue.
    pub fn pcm_underrun_count(self: AudioDevice) -> i64 {
        return __mlang_std_audio_pcm_underrun_count(self.handle);
    }

    /// @brief Discard queued PCM and reset its underrun counter.
    ///
    /// Call while stopped; clearing concurrently with playback is not supported.
    pub fn clear_pcm_queue(self: AudioDevice) -> i32 {
        return __mlang_std_audio_pcm_clear(self.handle);
    }

    /// @brief Queue nonblocking interleaved stereo f32 samples.
    ///
    /// The list layout is `[L0, R0, L1, R1, ...]`. The complete list is copied
    /// into a preallocated native ring, or an error is returned when its length
    /// is odd or insufficient free frames are available. Queue initial blocks
    /// before `start()` and refill according to `pcm_available_frames()`.
    pub fn queue_interleaved_f32(self: AudioDevice, samples: &list<f32>) -> Result<i64, str8> {
        let frames: i64 = __mlang_std_audio_queue_interleaved_f32(self.handle, samples);
        if frames < 0 {
            return Err<i64, str8>(last_error());
        }
        return Ok<i64, str8>(frames);
    }

    /// @brief Queue frames from a reusable preallocated stereo PCM block.
    pub fn queue_pcm_block(self: AudioDevice, block: PcmBlock, frames: i64) -> Result<i64, str8> {
        let queued: i64 = __mlang_std_audio_queue_pcm_block(self.handle, block.handle, frames);
        if queued < 0 {
            return Err<i64, str8>(last_error());
        }
        return Ok<i64, str8>(queued);
    }

    /// @brief Play a built-in stereo sine tone through the output stream.
    pub fn play_sine(self: AudioDevice, frequency_hz: f64, gain: f64, duration_ms: i64) -> Result<i32, str8> {
        let rc: i32 = __mlang_std_audio_play_sine(self.handle, frequency_hz, gain, duration_ms);
        if rc != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }
}
