/// \file ascii.mla
/// \brief ASCII keycode enum constants (0..127) for keyboard/input handling.
///
/// Typical usage:
///   mod std::ascii;
///   use std::ascii::AsciiKey;
///
///   if keycode == AsciiKey::Esc { ... }

/// @brief ASCII keycode enum values 0..127 for use in keyboard handlers.
pub enum AsciiKey : i32 {
    Nul = 0,
    Soh = 1,
    Stx = 2,
    Etx = 3,
    Eot = 4,
    Enq = 5,
    Ack = 6,
    Bell = 7,
    Backspace = 8,
    Tab = 9,
    Lf = 10,
    Vt = 11,
    Ff = 12,
    Cr = 13,
    So = 14,
    Si = 15,
    Dle = 16,
    Dc1 = 17,
    Dc2 = 18,
    Dc3 = 19,
    Dc4 = 20,
    Nak = 21,
    Syn = 22,
    Etb = 23,
    Can = 24,
    Em = 25,
    Sub = 26,
    Esc = 27,
    Fs = 28,
    Gs = 29,
    Rs = 30,
    Us = 31,
    Space = 32,
    Exclamation = 33,
    DoubleQuote = 34,
    Hash = 35,
    Dollar = 36,
    Percent = 37,
    Ampersand = 38,
    SingleQuote = 39,
    LParen = 40,
    RParen = 41,
    Star = 42,
    Plus = 43,
    Comma = 44,
    Minus = 45,
    Dot = 46,
    Slash = 47,
    Digit0 = 48,
    Digit1 = 49,
    Digit2 = 50,
    Digit3 = 51,
    Digit4 = 52,
    Digit5 = 53,
    Digit6 = 54,
    Digit7 = 55,
    Digit8 = 56,
    Digit9 = 57,
    Colon = 58,
    Semicolon = 59,
    Less = 60,
    Equal = 61,
    Greater = 62,
    Question = 63,
    At = 64,
    UpperA = 65,
    UpperB = 66,
    UpperC = 67,
    UpperD = 68,
    UpperE = 69,
    UpperF = 70,
    UpperG = 71,
    UpperH = 72,
    UpperI = 73,
    UpperJ = 74,
    UpperK = 75,
    UpperL = 76,
    UpperM = 77,
    UpperN = 78,
    UpperO = 79,
    UpperP = 80,
    UpperQ = 81,
    UpperR = 82,
    UpperS = 83,
    UpperT = 84,
    UpperU = 85,
    UpperV = 86,
    UpperW = 87,
    UpperX = 88,
    UpperY = 89,
    UpperZ = 90,
    LBracket = 91,
    Backslash = 92,
