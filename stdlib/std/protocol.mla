/// \file protocol.mla
/// \brief Base framed TCP protocol helpers for project-level protocol stacks (std::protocol).
///
/// Frame wire format:
/// - magic: 4 bytes: `MLP1`
/// - opcode: big-endian u32
/// - payload_len: big-endian u32
/// - payload bytes (text-oriented)
///
/// This module provides a reusable base transport with opcode dispatch so
/// projects can implement derived protocols on top.

/// \cond INTERNAL_IMPORTS
mod std::net;
mod std::strbuf;

use std::net::TcpStream;
use std::strbuf::sub;
/// \endcond

extern pub fn __mlang_std_protocol_last_error() -> string;
extern pub fn __mlang_std_protocol_last_opcode() -> i32;
extern pub fn __mlang_std_protocol_stream_write_text(socket_handle: i64, opcode: i32, payload: string) -> i64;
extern pub fn __mlang_std_protocol_stream_read_text(socket_handle: i64, out: string, capacity: i64, max_payload_bytes: i64) -> i64;

/// @brief One decoded protocol frame.
pub struct ProtocolFrame {
    var opcode: i32;
    var payload: string;
};

/// @brief Default maximum payload size for recv in bytes.
pub fn default_max_payload_bytes() -> i64 {
    return 64 * 1024;
}

/// @brief Return last protocol backend error.
pub fn last_error() -> string {
    return __mlang_std_protocol_last_error();
}

/// @brief Connect to TCP endpoint and wrap as protocol stream handle.
pub fn connect(addr: string, port: i64) -> Result<i64, string> {
    let cr: Result<TcpStream, string> = TcpStream::connect(addr, port);
    if cr.is_err() {
        return Err<i64, string>(cr.unwrap_err());
    }
    let s: TcpStream = cr.unwrap();
    return Ok<i64, string>(s.raw_handle());
}

/// @brief Convert accepted/connected TcpStream into ProtocolStream handle.
/// Ownership transfers to protocol handle; close with `close(stream)`.
pub fn from_stream(stream: TcpStream) -> i64 {
    return stream.raw_handle();
}

/// @brief Send one framed message.
pub fn send(stream_handle: i64, opcode: i32, payload: string) -> Result<i64, string> {
    let n: i64 = __mlang_std_protocol_stream_write_text(stream_handle, opcode, payload);
    if n < 0 {
        return Err<i64, string>(last_error());
    }
    return Ok<i64, string>(n);
}

/// @brief Receive one framed message.
/// Caller owns returned payload and should free via `String::free`.
pub fn recv(stream_handle: i64, payload_capacity: i64, max_payload_bytes: i64) -> Result<ProtocolFrame, string> {
    var buf: string = String::with_capacity(payload_capacity);
    let n: i64 = __mlang_std_protocol_stream_read_text(
        stream_handle,
        buf,
        payload_capacity,
        max_payload_bytes
    );
    if n < 0 {
        String::free(buf);
        return Err<ProtocolFrame, string>(last_error());
    }

    let payload: string = sub(buf, 0, n);
    String::free(buf);

    return Ok<ProtocolFrame, string>(ProtocolFrame {
        opcode: __mlang_std_protocol_last_opcode(),
        payload: payload
    });
}

/// @brief Close protocol stream handle.
pub fn close(stream_handle: i64) -> i32 {
    let s: TcpStream = TcpStream::from_handle(stream_handle);
    return s.close();
}

/// @brief Return underlying socket handle.
pub fn raw_handle(stream_handle: i64) -> i64 {
    return stream_handle;
}
