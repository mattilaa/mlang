/// \file term.mla
/// \cond INTERNAL_IMPORTS
mod std::term::detail;
use std::term::detail::*;
/// \endcond

/// \brief Terminal capability and termios helpers for MLang (std::term).
///
/// Provides:
/// - tty detection (`stdin/stdout/stderr`)
/// - terminal size queries (`rows/cols`)
/// - color capability detection (none/16/256/truecolor)
/// - stdin raw-mode enable/restore (termios)


use type ColorLevel = i32;

/// @brief Lowercase stdlib type alias for `ColorLevel`.
alias color_level = ColorLevel;

/// @brief Terminal size measured in rows and columns.
pub struct TermSize {
    var rows: i32;
    var cols: i32;
};

/// @brief Snapshot of detected terminal capabilities for a given stream.
pub struct TerminalCaps {
    var is_tty: i32;
    var rows: i32;
    var cols: i32;
    var color_level: ColorLevel;
    var truecolor: i32;
    var term_name: str8;
};

/// @brief Lowercase stdlib type alias for `TermSize`.
alias term_size = TermSize;

/// @brief Lowercase stdlib type alias for `TerminalCaps`.
alias terminal_caps = TerminalCaps;


/// @brief Color level constant indicating no color support.
/// @return `ColorLevel` zero.
pub fn color_none() -> ColorLevel { return 0; }
/// @brief Color level constant for 16-color ANSI support.
/// @return `ColorLevel` = 16.
pub fn color_16() -> ColorLevel { return 16; }
/// @brief Color level constant for 256-color ANSI support.
/// @return `ColorLevel` = 256.
pub fn color_256() -> ColorLevel { return 256; }
/// @brief Color level constant for 24-bit truecolor support.
/// @return `ColorLevel` = 16777216.
pub fn color_truecolor() -> ColorLevel { return 16777216; }

/// @brief Terminal `$TERM` value, or `"unknown"`.
pub fn term_name() -> str8 {
    return __mlang_std_term_term_name();
}

/// @brief Return 1 if stdin is attached to a TTY, else 0.
/// @return TTY flag.
pub fn stdin_is_tty() -> i32 {
    return __mlang_std_term_stdin_is_tty();
}

/// @brief Return 1 if stdout is attached to a TTY, else 0.
/// @return TTY flag.
pub fn stdout_is_tty() -> i32 {
    return __mlang_std_term_stdout_is_tty();
}

/// @brief Return 1 if stderr is attached to a TTY, else 0.
/// @return TTY flag.
pub fn stderr_is_tty() -> i32 {
    return __mlang_std_term_stderr_is_tty();
}

/// @brief Query the terminal size associated with stdout.
/// @return `TermSize` with rows and cols. Zero values mean "unknown".
pub fn stdout_size() -> TermSize {
    return TermSize {
        rows: __mlang_std_term_stdout_rows(),
        cols: __mlang_std_term_stdout_cols()
    };
}

/// @brief Query the terminal size associated with stderr.
/// @return `TermSize` with rows and cols. Zero values mean "unknown".
pub fn stderr_size() -> TermSize {
    return TermSize {
        rows: __mlang_std_term_stderr_rows(),
        cols: __mlang_std_term_stderr_cols()
    };
}

/// @brief Detected color level for stdout.
/// @return One of the `color_*()` constants.
pub fn stdout_color_level() -> ColorLevel {
    return __mlang_std_term_stdout_color_level();
}

/// @brief Detected color level for stderr.
/// @return One of the `color_*()` constants.
pub fn stderr_color_level() -> ColorLevel {
    return __mlang_std_term_stderr_color_level();
}

/// @brief Return 1 if stdout supports 24-bit truecolor, else 0.
/// @return Truecolor flag.
pub fn stdout_truecolor() -> i32 {
    return __mlang_std_term_stdout_truecolor();
}

/// @brief Return 1 if stderr supports 24-bit truecolor, else 0.
/// @return Truecolor flag.
pub fn stderr_truecolor() -> i32 {
    return __mlang_std_term_stderr_truecolor();
}

/// @brief Convenience check for ANSI escape support on stdout.
/// Returns `1` when stdout is a TTY and ANSI colors are not explicitly
/// disabled (e.g. via `NO_COLOR`), otherwise `0`.
pub fn supports_ansi() -> i32 {
    return __mlang_std_term_stdout_supports_ansi();
}

/// @brief Snapshot terminal capabilities for stdout.
pub fn stdout_caps() -> TerminalCaps {
    let s: TermSize = stdout_size();
    return TerminalCaps {
        is_tty: stdout_is_tty(),
        rows: s.rows,
        cols: s.cols,
        color_level: stdout_color_level(),
        truecolor: stdout_truecolor(),
        term_name: term_name()
    };
}

/// @brief Snapshot terminal capabilities for stderr.
pub fn stderr_caps() -> TerminalCaps {
    let s: TermSize = stderr_size();
    return TerminalCaps {
        is_tty: stderr_is_tty(),
        rows: s.rows,
        cols: s.cols,
        color_level: stderr_color_level(),
        truecolor: stderr_truecolor(),
        term_name: term_name()
    };
}

/// @brief Enable raw mode for stdin using termios.
/// @return `0` on success, non-zero on failure.
pub fn stdin_enable_raw() -> i32 {
    return __mlang_std_term_stdin_enable_raw();
}

/// @brief Enable cbreak/no-echo mode for stdin while preserving output processing.
///
/// This disables canonical input, echo, and job-control signals for byte-wise
/// input handling, but keeps normal terminal output translation enabled.
pub fn stdin_enable_cbreak() -> i32 {
    return __mlang_std_term_stdin_enable_cbreak();
}

/// @brief Restore stdin termios state saved by `stdin_enable_raw`.
/// @return `0` on success, non-zero on failure.
pub fn stdin_restore() -> i32 {
    return __mlang_std_term_stdin_restore();
}

/// @brief Force stdin terminal into a sane cooked mode.
///
/// This is useful before handing control to fullscreen terminal programs when
/// the caller wants a known-good tty state even if no saved raw snapshot is
/// currently available.
pub fn stdin_make_sane() -> i32 {
    return __mlang_std_term_stdin_make_sane();
}

/// @brief Discard any unread pending input bytes queued on stdin.
///
/// This is useful before handing control to another interactive terminal
/// program so buffered editor keystrokes do not leak into the child process.
pub fn stdin_flush_input() -> i32 {
    return __mlang_std_term_stdin_flush_input();
}
