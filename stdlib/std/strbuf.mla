/// \file strbuf.mla
/// \brief String allocation helpers for MLang (std::strbuf).
///
/// Rust-like constructor style is available via compiler intrinsics:
/// - String::new()
/// - String::with_capacity(cap)
/// - String::free(buf)
///
/// Additional utility helpers are backed by libmlang_std.

/// \cond INTERNAL_IMPORTS
mod std::strbuf::detail;
use std::strbuf::detail::*;
/// \endcond

/// @brief Allocate an empty string buffer (NUL-terminated).
pub fn new() -> str8 {
    return String::new();
}

/// @brief Allocate a string buffer with requested capacity in bytes.
pub fn with_capacity(capacity: i64) -> str8 {
    return String::with_capacity(capacity);
}

/// @brief Free a string buffer allocated by std::strbuf helpers.
pub fn free(buf: str8) -> void {
    String::free(buf);
}

/// @brief Growable UTF-8 byte string builder handle.
use type StringBuilder = i64;

/// @brief Create a StringBuilder with auto-growth and default page size.
///
/// Default page size is 256 bytes.
pub fn builder_new(initial_capacity: i64) -> StringBuilder {
    return __mlang_std_strbuf_builder_rt_new(initial_capacity, 256);
}

/// @brief Create a StringBuilder with explicit growth page size.
///
/// `page_size` controls allocation granularity; smaller values reduce
/// over-allocation, larger values reduce realloc frequency.
pub fn builder_with_page(initial_capacity: i64, page_size: i64) -> StringBuilder {
    return __mlang_std_strbuf_builder_rt_new(initial_capacity, page_size);
}

/// @brief Return `1` when builder allocation succeeded.
pub fn builder_is_valid(builder: StringBuilder) -> i32 {
    return builder != 0 ? 1 : 0;
}

/// @brief Current content length in bytes.
pub fn builder_len(builder: StringBuilder) -> i64 {
    return __mlang_std_strbuf_builder_rt_len(builder);
}

/// @brief Current writable byte capacity (excluding trailing NUL).
pub fn builder_capacity(builder: StringBuilder) -> i64 {
    return __mlang_std_strbuf_builder_rt_capacity(builder);
}

/// @brief Change growth page size for future expansions.
/// @return 0 on success, -1 on invalid page size or builder.
pub fn builder_set_page_size(builder: StringBuilder, page_size: i64) -> i32 {
    return __mlang_std_strbuf_builder_rt_set_page_size(builder, page_size);
}

/// @brief Reset builder to empty content while keeping allocated storage.
/// @return 0 on success, -1 on invalid builder.
pub fn builder_clear(builder: StringBuilder) -> i32 {
    return __mlang_std_strbuf_builder_rt_clear(builder);
}

/// @brief Ensure minimum writable capacity in bytes.
/// @return 0 on success, -1 on invalid builder/allocation failure.
pub fn builder_reserve(builder: StringBuilder, min_capacity: i64) -> i32 {
    return __mlang_std_strbuf_builder_rt_reserve(builder, min_capacity);
}

/// @brief Append UTF-8 text; grows automatically.
/// @return Number of appended bytes, or -1 on failure.
pub fn builder_append(builder: StringBuilder, s: str8) -> i64 {
    return __mlang_std_strbuf_builder_rt_append(builder, s);
}

/// @brief Append one byte value (0..255) as a character.
/// @return 1 on success, -1 on invalid byte/builder/failure.
pub fn builder_append_char(builder: StringBuilder, ch: i32) -> i64 {
    return __mlang_std_strbuf_builder_rt_append_char(builder, ch);
}

/// @brief Clone current contents into a new string.
/// Caller owns and frees returned string via `strbuf::free`.
pub fn builder_to_string(builder: StringBuilder) -> str8 {
    return __mlang_std_strbuf_builder_rt_to_string(builder);
}

/// @brief Move current contents out as an owned string and reset builder.
/// Caller owns and frees returned string via `strbuf::free`.
pub fn builder_take_string(builder: StringBuilder) -> str8 {
    return __mlang_std_strbuf_builder_rt_take_string(builder);
}

/// @brief Release builder and any owned internal buffer.
pub fn builder_free(builder: StringBuilder) -> void {
    __mlang_std_strbuf_builder_rt_free(builder);
}

/// @brief Return UTF-8 string length in bytes.
pub fn len(s: str8) -> i64 {
    return __mlang_std_strbuf_len(s);
}

/// @brief Return `1` when empty, `0` otherwise.
pub fn is_empty(s: str8) -> i32 {
    return __mlang_std_strbuf_is_empty(s);
}

/// @brief Clone a string into newly allocated memory.
pub fn clone(s: str8) -> str8 {
    return __mlang_std_strbuf_clone(s);
}

/// @brief Construct a new string from an existing UTF-8 string.
/// Mirrors compiler intrinsic semantics used by `String::from(...)`.
pub fn from(s: str8) -> str8 {
    return __mlang_std_strbuf_clone(s);
}

/// @brief Compare two strings for equality (`1` true, `0` false).
pub fn eq(a: str8, b: str8) -> i32 {
    return __mlang_std_strbuf_eq(a, b);
}

/// @brief Compare two strings (like `strcmp`).
/// Returns `0` if equal, `<0` if `a<b`, `>0` if `a>b`.
pub fn compare(a: str8, b: str8) -> i64 {
    return __mlang_std_strbuf_compare(a, b);
}

/// @brief Return `1` if `s` starts with `prefix`.
pub fn starts_with(s: str8, prefix: str8) -> i32 {
    return __mlang_std_strbuf_starts_with(s, prefix);
}

/// @brief Return `1` if `s` ends with `suffix`.
pub fn ends_with(s: str8, suffix: str8) -> i32 {
    return __mlang_std_strbuf_ends_with(s, suffix);
}

/// @brief Return `1` if `s` contains `needle`.
pub fn contains(s: str8, needle: str8) -> i32 {
    return __mlang_std_strbuf_contains(s, needle);
}

/// @brief Find first index of `needle` in `s`.
/// Returns `-1` when not found.
pub fn find(s: str8, needle: str8) -> i64 {
    return __mlang_std_strbuf_find(s, needle);
}

/// @brief Find last index of `needle` in `s`.
/// Returns `-1` when not found.
pub fn rfind(s: str8, needle: str8) -> i64 {
    return __mlang_std_strbuf_rfind(s, needle);
}

/// @brief Return a byte-based substring of `s`.
/// @param s Input UTF-8 string.
/// @param start 0-based start offset in bytes (clamped to `[0, len(s)]`).
/// @param count Maximum bytes to include (negative values produce `""`).
/// @return Newly allocated substring (caller frees with `free`).
/// @note Slicing is byte-based and may split multi-byte UTF-8 codepoints.
pub fn sub(s: str8, start: i64, count: i64) -> str8 {
    return __mlang_std_strbuf_sub(s, start, count);
}

/// @brief Concatenate two strings into newly allocated memory.
pub fn concat(a: str8, b: str8) -> str8 {
    return __mlang_std_strbuf_concat(a, b);
}

/// @brief Repeat `s` `count` times into a newly allocated string.
pub fn repeat(s: str8, count: i64) -> str8 {
    return __mlang_std_strbuf_repeat(s, count);
}

/// @brief Left-pad `s` to at least `width` bytes using repeated `pad`.
/// Returns a newly allocated string; caller frees with `free`.
pub fn pad_left(s: str8, width: i64, pad: str8) -> str8 {
    let n: i64 = len(s);
    if n >= width {
        return clone(s);
    }
    let fill: str8 = repeat(pad, width - n);
    let out: str8 = concat(fill, s);
    free(fill);
    return out;
}

/// @brief Right-pad `s` to at least `width` bytes using repeated `pad`.
/// Returns a newly allocated string; caller frees with `free`.
pub fn pad_right(s: str8, width: i64, pad: str8) -> str8 {
    let n: i64 = len(s);
    if n >= width {
        return clone(s);
    }
    let fill: str8 = repeat(pad, width - n);
    let out: str8 = concat(s, fill);
    free(fill);
    return out;
}

/// @brief Fit `s` to exactly `width` bytes by right-padding or truncating.
/// Returns a newly allocated string; caller frees with `free`.
pub fn fit_right(s: str8, width: i64, pad: str8) -> str8 {
    if width <= 0 {
        return String::new();
    }
    let n: i64 = len(s);
    if n == width {
        return clone(s);
    }
    if n > width {
        return sub(s, 0, width);
    }
    return pad_right(s, width, pad);
}

/// @brief Convert `value` to string and left-pad to `width`.
/// Returns a newly allocated string; caller frees with `free`.
pub fn pad_i64_left(value: i64, width: i64, pad: str8) -> str8 {
    let s: str8 = format!("{}", value);
    let out: str8 = pad_left(s, width, pad);
    free(s);
    return out;
}

/// @brief Convert `value` to string and right-pad to `width`.
/// Returns a newly allocated string; caller frees with `free`.
pub fn pad_i64_right(value: i64, width: i64, pad: str8) -> str8 {
    let s: str8 = format!("{}", value);
    let out: str8 = pad_right(s, width, pad);
    free(s);
    return out;
}

/// @brief Zero-pad integer to at least `width` characters.
/// Returns a newly allocated string; caller frees with `free`.
pub fn zpad_i64(value: i64, width: i64) -> str8 {
    return pad_i64_left(value, width, "0");
}

/// @brief Return a newly allocated trimmed string (both ends).
pub fn trim(s: str8) -> str8 {
    return __mlang_std_strbuf_trim(s);
}

/// @brief Return a newly allocated left-trimmed string.
pub fn ltrim(s: str8) -> str8 {
    return __mlang_std_strbuf_ltrim(s);
}

/// @brief Return a newly allocated right-trimmed string.
pub fn rtrim(s: str8) -> str8 {
    return __mlang_std_strbuf_rtrim(s);
}

/// @brief Convert UTF-8 (`string`) to UTF-16 (`str16`).
pub fn to_utf16(s: str8) -> str16 {
    return __mlang_std_strbuf_utf8_to_utf16(s);
}

/// @brief Convert UTF-16 (`str16`) to UTF-8 (`string`).
pub fn from_utf16(s: str16) -> str8 {
    return __mlang_std_strbuf_utf16_to_utf8(s);
}

/// @brief Alias for `from_utf16` to mirror explicit UTF target naming.
pub fn to_utf8(s: str16) -> str8 {
    return from_utf16(s);
}

/// @brief Free UTF-16 buffer allocated by `to_utf16`.
pub fn free_utf16(s: str16) -> void {
    __mlang_std_strbuf_free_str16(s);
}

/// @brief Escape a string for JSON string literal embedding.
pub fn json_escape(s: str8) -> str8 {
    return __mlang_std_strbuf_json_escape(s);
}
