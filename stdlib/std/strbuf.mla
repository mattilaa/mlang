/// \file strbuf.mla
/// \brief String allocation helpers for MLang (std::strbuf).
///
/// Rust-like constructor style is available via compiler intrinsics:
/// - String::new()
/// - String::with_capacity(cap)
/// - String::free(buf)
///
/// Additional utility helpers are backed by libmlang_std.

extern fn __mlang_std_strbuf_len(s: string) -> i64;
extern fn __mlang_std_strbuf_is_empty(s: string) -> int;
extern fn __mlang_std_strbuf_clone(s: string) -> string;
extern fn __mlang_std_strbuf_eq(a: string, b: string) -> int;
extern fn __mlang_std_strbuf_compare(a: string, b: string) -> i64;
extern fn __mlang_std_strbuf_starts_with(s: string, prefix: string) -> int;
extern fn __mlang_std_strbuf_ends_with(s: string, suffix: string) -> int;
extern fn __mlang_std_strbuf_contains(s: string, needle: string) -> int;
extern fn __mlang_std_strbuf_find(s: string, needle: string) -> i64;
extern fn __mlang_std_strbuf_rfind(s: string, needle: string) -> i64;
extern fn __mlang_std_strbuf_sub(s: string, start: i64, count: i64) -> string;
extern fn __mlang_std_strbuf_concat(a: string, b: string) -> string;
extern fn __mlang_std_strbuf_repeat(s: string, count: i64) -> string;
extern fn __mlang_std_strbuf_trim(s: string) -> string;
extern fn __mlang_std_strbuf_ltrim(s: string) -> string;
extern fn __mlang_std_strbuf_rtrim(s: string) -> string;
extern fn __mlang_std_strbuf_utf8_to_utf16(s: string) -> str16;
extern fn __mlang_std_strbuf_utf16_to_utf8(s: str16) -> string;
extern fn __mlang_std_strbuf_free_str16(s: str16) -> void;
extern fn __mlang_std_strbuf_json_escape(s: string) -> string;

/// @brief Allocate an empty string buffer (NUL-terminated).
pub fn new() -> string {
    return String::new();
}

/// @brief Allocate a string buffer with requested capacity in bytes.
pub fn with_capacity(capacity: i64) -> string {
    return String::with_capacity(capacity);
}

/// @brief Free a string buffer allocated by std::strbuf helpers.
pub fn free(buf: string) -> void {
    String::free(buf);
}

/// @brief Append `suffix` to `buf` in-place.
///
/// This is equivalent to the builtin method call `buf.push_str(suffix)`.
pub fn push_str(buf: string, suffix: string) -> void {
    buf.push_str(suffix);
}

/// @brief Return UTF-8 string length in bytes.
pub fn len(s: string) -> i64 {
    return __mlang_std_strbuf_len(s);
}

/// @brief Return `1` when empty, `0` otherwise.
pub fn is_empty(s: string) -> int {
    return __mlang_std_strbuf_is_empty(s);
}

/// @brief Clone a string into newly allocated memory.
pub fn clone(s: string) -> string {
    return __mlang_std_strbuf_clone(s);
}

/// @brief Compare two strings for equality (`1` true, `0` false).
pub fn eq(a: string, b: string) -> int {
    return __mlang_std_strbuf_eq(a, b);
}

/// @brief Compare two strings (like `strcmp`).
/// Returns `0` if equal, `<0` if `a<b`, `>0` if `a>b`.
pub fn compare(a: string, b: string) -> i64 {
    return __mlang_std_strbuf_compare(a, b);
}

/// @brief Return `1` if `s` starts with `prefix`.
pub fn starts_with(s: string, prefix: string) -> int {
    return __mlang_std_strbuf_starts_with(s, prefix);
}

/// @brief Return `1` if `s` ends with `suffix`.
pub fn ends_with(s: string, suffix: string) -> int {
    return __mlang_std_strbuf_ends_with(s, suffix);
}

/// @brief Return `1` if `s` contains `needle`.
pub fn contains(s: string, needle: string) -> int {
    return __mlang_std_strbuf_contains(s, needle);
}

/// @brief Find first index of `needle` in `s`.
/// Returns `-1` when not found.
pub fn find(s: string, needle: string) -> i64 {
    return __mlang_std_strbuf_find(s, needle);
}

/// @brief Find last index of `needle` in `s`.
/// Returns `-1` when not found.
pub fn rfind(s: string, needle: string) -> i64 {
    return __mlang_std_strbuf_rfind(s, needle);
}

/// @brief Return a byte-based substring of `s`.
/// @param s Input UTF-8 string.
/// @param start 0-based start offset in bytes (clamped to `[0, len(s)]`).
/// @param count Maximum bytes to include (negative values produce `""`).
/// @return Newly allocated substring (caller frees with `free`).
/// @note Slicing is byte-based and may split multi-byte UTF-8 codepoints.
pub fn sub(s: string, start: i64, count: i64) -> string {
    return __mlang_std_strbuf_sub(s, start, count);
}

/// @brief Concatenate two strings into newly allocated memory.
pub fn concat(a: string, b: string) -> string {
    return __mlang_std_strbuf_concat(a, b);
}

/// @brief Repeat `s` `count` times into a newly allocated string.
pub fn repeat(s: string, count: i64) -> string {
    return __mlang_std_strbuf_repeat(s, count);
}

/// @brief Return a newly allocated trimmed string (both ends).
pub fn trim(s: string) -> string {
    return __mlang_std_strbuf_trim(s);
}

/// @brief Return a newly allocated left-trimmed string.
pub fn ltrim(s: string) -> string {
    return __mlang_std_strbuf_ltrim(s);
}

/// @brief Return a newly allocated right-trimmed string.
pub fn rtrim(s: string) -> string {
    return __mlang_std_strbuf_rtrim(s);
}

/// @brief Convert UTF-8 (`string`) to UTF-16 (`str16`).
pub fn to_utf16(s: string) -> str16 {
    return __mlang_std_strbuf_utf8_to_utf16(s);
}

/// @brief Convert UTF-16 (`str16`) to UTF-8 (`string`).
pub fn from_utf16(s: str16) -> string {
    return __mlang_std_strbuf_utf16_to_utf8(s);
}

/// @brief Alias for `from_utf16` to mirror explicit UTF target naming.
pub fn to_utf8(s: str16) -> string {
    return from_utf16(s);
}

/// @brief Free UTF-16 buffer allocated by `to_utf16`.
pub fn free_utf16(s: str16) -> void {
    __mlang_std_strbuf_free_str16(s);
}

/// @brief Escape a string for JSON string literal embedding.
pub fn json_escape(s: string) -> string {
    return __mlang_std_strbuf_json_escape(s);
}
