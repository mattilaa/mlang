    /// output, so the input is not heard twice.
    pub fn instrument_input(self: AudioController, slot: i64, source: i64) -> i32 {
        return __mlang_std_audio_controller_instrument_input(self.handle, slot, source);
    }
    /// Monitor the live audio input on PCM track `track` (1-64), or stop: the
