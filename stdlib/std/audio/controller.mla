    pub fn instrument_outputs(self: AudioController, slot: i64) -> i64 {
        return __mlang_std_audio_controller_instrument_outputs(self.handle, slot);
    }
    /// Name of output bus `bus` (0 = main), "" when unknown. Borrowed.
    pub fn instrument_output_name(self: AudioController, slot: i64, bus: i64) -> str8 {
        return __mlang_std_audio_controller_instrument_output_name(self.handle, slot, bus);
    }
    /// Route aux bus `bus` (1..outputs-1): -1 = with the instrument's main
    /// output (the default), 0 = master, 1-64 = that PCM track's channel,
    /// 65-72 = the input of aux effect channel 0-7 (a send), 73 = nowhere.
    /// Audio may run. Loading an instrument resets its routes. 0 or -1.
    /// Audio input of the instrument in `slot` (1-32), e.g. a vocoder's
    /// modulator: 0 = none (silence), 1-64 = the voices of that PCM track,
    /// taken before its inserts and fader (the track still plays on its own
