    pub fn input_monitor(self: AudioController, track: i64, on: bool) -> i32 {
        return __mlang_std_audio_controller_input_monitor(self.handle, track, on ? 1 : 0);
    }
    /// Open the live audio input on input device `device` (an index as
    /// `std::audio::input_device_count()` counts them, -1 = the system
    /// default); -2 closes it. It runs on its own device clock and is read a
    /// little behind, resampled to the controller rate. Audio may run.
    pub fn input_open(self: AudioController, device: i64) -> i32 { return __mlang_std_audio_controller_input_open(self.handle, device); }
    /// Feed interleaved frames (1 or 2 channels at `rate`) as if an input
    /// device had captured them; refused while a device input is open.
    pub fn input_feed(self: AudioController, samples: list<f32>, channels: i64, rate: i64) -> i32 { return __mlang_std_audio_controller_input_feed(self.handle, samples, channels, rate); }
    /// Peak of the live input since the last read, 0-1000; the read resets it.
    pub fn input_peak(self: AudioController, channel: i64) -> i32 { return __mlang_std_audio_controller_input_peak(self.handle, channel); }
    /// True while a device input is open.
    pub fn input_active(self: AudioController) -> bool { return __mlang_std_audio_controller_input_active(self.handle) != 0; }
    /// Frames a sound played at an output frame takes to come back in the
    /// live input (both devices' latency plus the read margin).
    pub fn record_latency(self: AudioController) -> i64 { return __mlang_std_audio_controller_record_latency(self.handle); }
    /// Record the live input so its first frame lines up with what output
    /// frame `frame` played; drops anything an earlier take left unread.
    pub fn record_start(self: AudioController, frame: i64) -> i32 { return __mlang_std_audio_controller_record_start(self.handle, frame); }
    /// Stop recording; what was recorded stays readable.
    pub fn record_stop(self: AudioController) -> i32 { return __mlang_std_audio_controller_record_stop(self.handle); }
    /// Drain up to `max_frames` recorded frames as interleaved stereo. Call
    /// often while a take runs: the ring holds about ten seconds.
    pub fn record_read(self: AudioController, max_frames: i64) -> list<f32> { return __mlang_std_audio_controller_record_read(self.handle, max_frames); }
    /// Frames dropped because the take was not drained in time.
    pub fn record_overruns(self: AudioController) -> i64 { return __mlang_std_audio_controller_record_overruns(self.handle); }
    pub fn instrument_output_route(self: AudioController, slot: i64, bus: i64, destination: i64) -> i32 {
        return __mlang_std_audio_controller_instrument_output_route(self.handle, slot, bus, destination);
    }
    /// Optional host is installed by the application (mlacker installs VST3).
    pub fn processor_support() -> bool { return __mlang_std_audio_controller_processor_support() != 0; }
    /// Cap on the threads every controller renders with, its audio thread
    /// included: 0 = one per core (the default), 1 = no worker threads.
    /// Instruments, tracks of equal routing depth and aux returns run in
    /// parallel and are summed in slot order, so the mix does not depend on
    /// it. Any thread; running controllers apply it from their next block.
    pub fn set_render_threads(threads: i64) -> i32 { return __mlang_std_audio_controller_set_render_threads(threads); }
    /// The cap last set with `set_render_threads` (0 = one per core).
    pub fn render_thread_limit() -> i64 { return __mlang_std_audio_controller_render_thread_limit(); }
    /// Most threads a controller can render with on this machine.
    pub fn max_render_threads() -> i64 { return __mlang_std_audio_controller_max_render_threads(); }
    /// Threads the latest rendered block could use (1 until a plugin loads).
    pub fn render_threads(self: AudioController) -> i64 { return __mlang_std_audio_controller_info(self.handle, 7); }
    /// Worst render time of a block since the last call, as a fraction of the
    /// block's real duration (1.0 = at the dropout limit). Resets on read.
    pub fn dsp_load(self: AudioController) -> f64 { return f64(__mlang_std_audio_controller_info(self.handle, 8)) / 1000.0; }
    /// Control thread, while stopped. Empty path unloads; failure retains old processor.
    pub fn load_processor(self: AudioController, path: str8) -> i32 { return __mlang_std_audio_controller_load_processor(self.handle, path); }
    /// Borrowed name, valid until replacement/close. Clone if retaining it.
    pub fn processor_name(self: AudioController) -> str8 { return __mlang_std_audio_controller_processor_name(self.handle); }
    pub fn processor_errors(self: AudioController) -> i64 { return __mlang_std_audio_controller_info(self.handle, 4); }
    pub fn hardware_output(self: AudioController) -> bool { return __mlang_std_audio_controller_info(self.handle, 5) != 0; }
    /// Open AUHAL stereo output, using its native sample rate. -1 = default.
    /// Buffer size is a hardware hint, not a guaranteed latency. Query actual.
    pub fn open(device: i64, frames: i64) -> result<AudioController, str8> {
        let handle: i64 = __mlang_std_audio_controller_open(device, frames);
        if handle == 0 { return Err<AudioController, str8>(__mlang_std_audio_last_error()); }
        return Ok<AudioController, str8>(AudioController { handle: handle });
    }
    /// Open AUHAL at an explicit processing rate; 0 uses the native device rate.
    /// CoreAudio converts the client stream if the device uses another rate.
    pub fn open_at_rate(device: i64, frames: i64, rate: i64) -> result<AudioController, str8> {
        let handle: i64 = __mlang_std_audio_controller_open_rate(device, frames, rate);
        if handle == 0 { return Err<AudioController, str8>(__mlang_std_audio_last_error()); }
        return Ok<AudioController, str8>(AudioController { handle: handle });
    }
    /// Offline renderer, with identical event processing; no hardware needed.
    pub fn new(rate: i64, frames: i64) -> result<AudioController, str8> {
        let handle: i64 = __mlang_std_audio_controller_new(rate, frames);
        if handle == 0 { return Err<AudioController, str8>(__mlang_std_audio_last_error()); }
        return Ok<AudioController, str8>(AudioController { handle: handle });
    }
    /// Nonblocking: 0=posted, 1=full, -1=invalid. Exactly ONE producer per lane.
    /// Lane 0: main (immediate); lane 1: dedicated MIDI input producer;
    /// lane 2: sequencer events stamped with the absolute `frame_clock` frame
    /// they sound on, posted ahead of time in nondecreasing frame order
    /// (frame -1 = as soon as possible, still after everything queued before).
    /// Overflow requests panic to avoid stuck notes. 256 events/lane/callback.
    pub fn post(self: AudioController, event: AudioEvent, lane: i64) -> i32 {
        let kind: i64 = match event.kind {
            AudioEventKind::NoteOn => 1, AudioEventKind::NoteOff => 2,
            AudioEventKind::MasterGain => 3, AudioEventKind::PlaySample => 4,
            AudioEventKind::StopSource => 5, AudioEventKind::InstrumentNoteOn => 6,
            AudioEventKind::InstrumentNoteOff => 7, AudioEventKind::ControlChange => 8,
            AudioEventKind::InstrumentControlChange => 9, AudioEventKind::InstrumentText => 11,
            AudioEventKind::InstrumentSysEx => 12, _ => 0
        };
        return __mlang_std_audio_controller_post(self.handle, lane, kind,
            event.midi.channel, event.midi.note, event.midi.velocity,
            event.source, event.frame, event.sample, event.gain);
    }
    /// Atomically silence all voices and discard queued commands next callback.
    pub fn panic(self: AudioController) -> void { __mlang_std_audio_controller_panic(self.handle); }
    /// Copy immutable PCM while stopped. Up to 256 samples; owned until close.
    /// Source PcmAudio may be closed immediately after this call.
    pub fn add_sample(self: AudioController, pcm: PcmAudio) -> i64 { return __mlang_std_audio_controller_sample(self.handle, pcm.handle); }
    /// Stopped owner only; all producers must be joined before clearing.
    pub fn clear_samples(self: AudioController) -> i32 { return __mlang_std_audio_controller_clear_samples(self.handle); }
    pub fn add_sample_data(self: AudioController, samples: list<f32>, channels: i64, rate: i64) -> i64 { return __mlang_std_audio_controller_sample_data(self.handle, samples, channels, rate); }
    /// Audition interleaved PCM on the master bus, outside every track, from
    /// its start; replaces any preview playing. Any thread but the render
    /// thread, while running or stopped. Uses no sample slot. 0 = ok, -1 = invalid.
    pub fn preview(self: AudioController, samples: list<f32>, channels: i64, rate: i64) -> i32 { return __mlang_std_audio_controller_preview(self.handle, samples, channels, rate); }
    pub fn stop_preview(self: AudioController) -> i32 { let none: list<f32> = []; return __mlang_std_audio_controller_preview(self.handle, none, 1, 1); }
    /// True while a preview is loaded and has not played to its end.
    pub fn preview_playing(self: AudioController) -> bool { return __mlang_std_audio_controller_preview_playing(self.handle) == 1; }
    /// Offset and length are source PCM frames; length 0 plays to the natural end.
    pub fn play_sample(self: AudioController, sample: i64, source: i64, offset: i64, length: i64) -> i32 {
        return self.post(AudioEvent { kind: AudioEventKind::PlaySample, sample: sample, source: source,
            midi: AudioMidiEvent { note: offset, velocity: length } }, 0);
    }
    /// Render offline/while stopped into preallocated stereo PCM.
    pub fn process(self: AudioController, block: PcmBlock, frames: i64) -> i32 { return __mlang_std_audio_controller_process(self.handle, block.handle, frames); }
    pub fn start(self: AudioController) -> i32 { return __mlang_std_audio_controller_start(self.handle); }
    pub fn stop(self: AudioController) -> i32 { return __mlang_std_audio_controller_stop(self.handle); }
    /// Join all producers before close. Handle aliases are non-owning.
    pub fn close(self: AudioController) -> i32 { return __mlang_std_audio_controller_close(self.handle); }
    pub fn sample_rate(self: AudioController) -> i64 { return __mlang_std_audio_controller_info(self.handle, 0); }
    pub fn buffer_frames(self: AudioController) -> i64 { return __mlang_std_audio_controller_info(self.handle, 1); }
    pub fn frame_clock(self: AudioController) -> i64 { return __mlang_std_audio_controller_info(self.handle, 2); }
    pub fn dropped_events(self: AudioController) -> i64 { return __mlang_std_audio_controller_info(self.handle, 3); }
}
