    pub fn instrument_set_markers(self: AudioController, slot: i64, pad: i64, frames: list<f64>, detect: bool) -> i32 {
        return __mlang_std_audio_controller_instrument_set_markers(self.handle, slot, pad, frames, detect ? 1 : 0);
    }
    pub fn instrument_sampler(self: AudioController, slot: i64, key: i64) -> i64 {
        return __mlang_std_audio_controller_instrument_sampler(self.handle, slot, key);
    }
    /// Stereo output buses of the instrument in `slot`, main included (1 for a
