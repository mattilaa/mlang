    /// Audio may keep running. 0 or -1 (see last_error).
    pub fn instrument_text(self: AudioController, slot: i64, index: i64, text: str8) -> i32 {
        return __mlang_std_audio_controller_instrument_text(self.handle, slot, index, text);
    }
    /// Store the system exclusive message `bytes` (F0 through F7, 3-1024
    /// bytes) as message `index` (0-255) of the instrument in `slot` (1-32),
    /// or of the master processor for slot 0; an InstrumentSysEx event sends
    /// it. Audio may keep running. 0 or -1 (see last_error).
    pub fn instrument_sysex(self: AudioController, slot: i64, index: i64, bytes: &list<i32>) -> i32 {
        return __mlang_std_audio_controller_instrument_sysex(self.handle, slot, index, bytes);
    }
    /// Empty pad `pad` of the sampler instrument in `slot`. 0 or -1.
    pub fn instrument_clear_pad(self: AudioController, slot: i64, pad: i64) -> i32 {
        return __mlang_std_audio_controller_instrument_clear_pad(self.handle, slot, pad);
    }
    /// Sampler layout: key 0 = MIDI key of pad 0, 1 = pad count, 2 = loaded-pad
    /// bitmask. -1 when the instrument is not a sampler.
    /// Live MIDI timing: 0 plays live notes and controllers when the next
    /// block starts; 1 (the default) stamps them with the frame they arrived
