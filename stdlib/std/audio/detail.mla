/// \file detail.mla
/// \brief Native bindings for std::audio.

extern pub fn __mlang_std_audio_last_error() -> str8;
extern pub fn __mlang_std_audio_backend_name() -> str8;
extern pub fn __mlang_std_audio_device_count() -> i64;
extern pub fn __mlang_std_audio_default_output_device_id() -> i64;
extern pub fn __mlang_std_audio_device_name(device_id: i64) -> str8;
extern pub fn __mlang_std_audio_open_default_output(client_name: str8) -> i64;
extern pub fn __mlang_std_audio_open_output_device(device_id: i64, client_name: str8) -> i64;
extern pub fn __mlang_std_audio_open_default_output_config(client_name: str8, sample_rate: i64, buffer_frames: i64) -> i64;
extern pub fn __mlang_std_audio_open_output_device_config(device_id: i64, client_name: str8, sample_rate: i64, buffer_frames: i64) -> i64;
extern pub fn __mlang_std_audio_start(handle: i64) -> i32;
extern pub fn __mlang_std_audio_stop(handle: i64) -> i32;
extern pub fn __mlang_std_audio_close(handle: i64) -> i32;
extern pub fn __mlang_std_audio_sample_rate(handle: i64) -> i64;
extern pub fn __mlang_std_audio_buffer_frames(handle: i64) -> i64;
extern pub fn __mlang_std_audio_pcm_capacity_frames(handle: i64) -> i64;
extern pub fn __mlang_std_audio_pcm_queued_frames(handle: i64) -> i64;
extern pub fn __mlang_std_audio_pcm_available_frames(handle: i64) -> i64;
extern pub fn __mlang_std_audio_pcm_underrun_count(handle: i64) -> i64;
extern pub fn __mlang_std_audio_pcm_clear(handle: i64) -> i32;
extern pub fn __mlang_std_audio_queue_interleaved_f32(handle: i64, samples: &list<f32>) -> i64;
extern pub fn __mlang_std_audio_play_sine(handle: i64, frequency_hz: f64, gain: f64, duration_ms: i64) -> i32;
extern pub fn __mlang_std_audio_pcm_load(path: str8) -> i64;
extern pub fn __mlang_std_audio_pcm_file_sample_rate(handle: i64) -> i64;
extern pub fn __mlang_std_audio_pcm_file_channels(handle: i64) -> i64;
extern pub fn __mlang_std_audio_pcm_file_frame_count(handle: i64) -> i64;
extern pub fn __mlang_std_audio_pcm_file_samples(handle: i64) -> list<f32>;
extern pub fn __mlang_std_audio_pcm_file_close(handle: i64) -> i32;
extern pub fn __mlang_std_audio_pcm_block_new(capacity_frames: i64) -> i64;
extern pub fn __mlang_std_audio_pcm_block_capacity_frames(handle: i64) -> i64;
extern pub fn __mlang_std_audio_pcm_block_set_stereo(handle: i64, frame: i64, left: f32, right: f32) -> i32;
extern pub fn __mlang_std_audio_pcm_block_clear(handle: i64) -> i32;
extern pub fn __mlang_std_audio_pcm_block_close(handle: i64) -> i32;
extern pub fn __mlang_std_audio_queue_pcm_block(handle: i64, block_handle: i64, frames: i64) -> i64;
