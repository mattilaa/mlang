/// \file detail.mla
/// \brief Native bindings for std::serde.

extern pub fn __mlang_std_serde_last_error() -> str8;
extern pub fn __mlang_std_serde_last_ok() -> i32;
extern pub fn __mlang_std_serde_binary_new(initial_capacity: i64) -> i64;
extern pub fn __mlang_std_serde_binary_free(handle: i64) -> i32;
extern pub fn __mlang_std_serde_binary_len(handle: i64) -> i64;
extern pub fn __mlang_std_serde_binary_capacity(handle: i64) -> i64;
extern pub fn __mlang_std_serde_binary_clear(handle: i64) -> i32;
extern pub fn __mlang_std_serde_binary_reserve(handle: i64, min_capacity: i64) -> i32;
extern pub fn __mlang_std_serde_binary_append_u8(handle: i64, value: i32) -> i32;
extern pub fn __mlang_std_serde_binary_append_bool(handle: i64, value: i32) -> i32;
extern pub fn __mlang_std_serde_binary_append_i32(handle: i64, value: i32) -> i32;
extern pub fn __mlang_std_serde_binary_append_i64(handle: i64, value: i64) -> i32;
extern pub fn __mlang_std_serde_binary_append_f32(handle: i64, value: f32) -> i32;
extern pub fn __mlang_std_serde_binary_append_f64(handle: i64, value: f64) -> i32;
extern pub fn __mlang_std_serde_binary_append_string(handle: i64, s: str8) -> i32;
extern pub fn __mlang_std_serde_binary_get_u8(handle: i64, index: i64) -> i32;
extern pub fn __mlang_std_serde_binary_write_file(handle: i64, path: str8) -> i32;
extern pub fn __mlang_std_serde_binary_read_file(path: str8) -> i64;
extern pub fn __mlang_std_serde_reader_new(binary_handle: i64) -> i64;
extern pub fn __mlang_std_serde_reader_free(reader_handle: i64) -> i32;
extern pub fn __mlang_std_serde_reader_remaining(reader_handle: i64) -> i64;
extern pub fn __mlang_std_serde_reader_read_u8(reader_handle: i64) -> i32;
extern pub fn __mlang_std_serde_reader_read_bool(reader_handle: i64) -> i32;
extern pub fn __mlang_std_serde_reader_read_i32(reader_handle: i64) -> i32;
extern pub fn __mlang_std_serde_reader_read_i64(reader_handle: i64) -> i64;
extern pub fn __mlang_std_serde_reader_read_f32(reader_handle: i64) -> f32;
extern pub fn __mlang_std_serde_reader_read_f64(reader_handle: i64) -> f64;
extern pub fn __mlang_std_serde_reader_read_string(reader_handle: i64) -> str8;
