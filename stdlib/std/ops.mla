/// \file ops.mla
/// \brief Operator traits for user-defined types (std::ops).
///
/// These traits let structs participate in language operators.
/// The compiler maps operators to the following trait methods:
/// - `a + b` -> `Add::add(self, other)`
/// - `a - b` -> `Sub::sub(self, other)`
/// - `a * b` -> `Mul::mul(self, other)`
/// - `a / b` -> `Div::div(self, other)`
/// - `a % b` -> `Rem::rem(self, other)`
/// - `-a`    -> `Neg::neg(self)`
///
/// Current compiler expectation:
/// - Binary operator methods return `Self`.
/// - Unary negation method returns `Self`.

trait Add {
    fn add(self: &mut Self, other: Self) -> Self;
}

trait Sub {
    fn sub(self: &mut Self, other: Self) -> Self;
}

trait Mul {
    fn mul(self: &mut Self, other: Self) -> Self;
}

trait Div {
    fn div(self: &mut Self, other: Self) -> Self;
}

trait Rem {
    fn rem(self: &mut Self, other: Self) -> Self;
}

trait Neg {
    fn neg(self: &mut Self) -> Self;
}
