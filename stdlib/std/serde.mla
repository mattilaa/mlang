/// \file serde.mla
/// \brief Binary serialization and deserialization helpers (std::serde).
///
/// This module provides:
/// - `Binary`: growable binary output buffer
/// - `Reader`: sequential binary reader
/// - `BinarySerde`: trait for custom-type serialization contracts
///
/// Primitive encoding format is little-endian for numeric values and
/// length-prefixed (`i64` byte length) for strings.
///
/// @defgroup std_serde std::serde
/// @brief Binary serialization/deserialization.
/// @{

/// \cond INTERNAL_IMPORTS
mod std::serde::detail;
use std::serde::detail::*;
/// \endcond

/// @cond INTERNAL
mod std::bitset;
use std::bitset::BitSet;
/// @endcond




/// @brief Return the last backend error string.
/// @ingroup std_serde
pub fn last_error() -> str8 {
    return __mlang_std_serde_last_error();
}

/// @brief Return backend status of last serde operation (`1` ok, `0` fail).
/// @ingroup std_serde
pub fn last_ok() -> i32 {
    return __mlang_std_serde_last_ok();
}

/// @brief Growable binary serialization buffer.
/// @ingroup std_serde
pub struct Binary {
    var handle: i64;
};

/// @brief Sequential binary input reader.
/// @ingroup std_serde
pub struct Reader {
    var handle: i64;
};

/// @brief Trait contract for custom type serde support.
/// @ingroup std_serde
trait BinarySerde {
    fn serialize(self: &mut Self, out_handle: i64) -> Result<i32, str8>;
    fn deserialize(self: &mut Self, input_handle: i64) -> Result<i32, str8>;
}

/// @brief Lowercase stdlib type alias for `Binary`.
alias binary = Binary;

/// @brief Lowercase stdlib type alias for `Reader`.
alias reader = Reader;


impl Binary {
    /// @brief Create a new empty binary buffer.
    pub fn new(initial_capacity: i64) -> Result<Binary, str8> {
        let h: i64 = __mlang_std_serde_binary_new(initial_capacity);
        if h == 0 {
            return Err<Binary, str8>(last_error());
        }
        return Ok<Binary, str8>(Binary { handle: h });
    }

    /// @brief Read full file bytes into a new binary buffer.
    pub fn from_file(path: str8) -> Result<Binary, str8> {
        let h: i64 = __mlang_std_serde_binary_read_file(path);
        if h == 0 {
            return Err<Binary, str8>(last_error());
        }
        return Ok<Binary, str8>(Binary { handle: h });
    }

    /// @brief Current serialized byte length.
    pub fn len(self: Binary) -> i64 {
        return __mlang_std_serde_binary_len(self.handle);
    }

    /// @brief Current allocated byte capacity.
    pub fn capacity(self: Binary) -> i64 {
        return __mlang_std_serde_binary_capacity(self.handle);
    }

    /// @brief Reset serialized byte length to 0.
    pub fn clear(self: Binary) -> Result<i32, str8> {
        if __mlang_std_serde_binary_clear(self.handle) != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Ensure capacity is at least `min_capacity` bytes.
    pub fn reserve(self: Binary, min_capacity: i64) -> Result<i32, str8> {
        if __mlang_std_serde_binary_reserve(self.handle, min_capacity) != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Append one unsigned byte (`0..255`).
    pub fn write_u8(self: Binary, value: i32) -> Result<i32, str8> {
        if __mlang_std_serde_binary_append_u8(self.handle, value) != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Append one bool byte (`0` or `1`).
    pub fn write_bool(self: Binary, value: bool) -> Result<i32, str8> {
        if __mlang_std_serde_binary_append_bool(self.handle, i32(value)) != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Append one little-endian `i32`.
    pub fn write_i32(self: Binary, value: i32) -> Result<i32, str8> {
        if __mlang_std_serde_binary_append_i32(self.handle, value) != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Append one little-endian `i64`.
    pub fn write_i64(self: Binary, value: i64) -> Result<i32, str8> {
        if __mlang_std_serde_binary_append_i64(self.handle, value) != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Append one IEEE754 `f32`.
    pub fn write_f32(self: Binary, value: f32) -> Result<i32, str8> {
        if __mlang_std_serde_binary_append_f32(self.handle, value) != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Append one IEEE754 `f64`.
    pub fn write_f64(self: Binary, value: f64) -> Result<i32, str8> {
        if __mlang_std_serde_binary_append_f64(self.handle, value) != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Append length-prefixed UTF-8/string payload.
    pub fn write_string(self: Binary, value: str8) -> Result<i32, str8> {
        if __mlang_std_serde_binary_append_string(self.handle, value) != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Append `list<i32>` as `len(i64)` + elements.
    pub fn write_list_i32(self: Binary, values: list<i32>) -> Result<i32, str8> {
        let l: i64 = values.len();
        let wl: Result<i32, str8> = self.write_i64(l);
        if wl.is_err() {
            return wl;
        }
        for i in 0..l {
            let we: Result<i32, str8> = self.write_i32(values[i]);
            if we.is_err() {
                return we;
            }
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Append `list<i64>` as `len(i64)` + elements.
    pub fn write_list_i64(self: Binary, values: list<i64>) -> Result<i32, str8> {
        let l: i64 = values.len();
        let wl: Result<i32, str8> = self.write_i64(l);
        if wl.is_err() {
            return wl;
        }
        for i in 0..l {
            let we: Result<i32, str8> = self.write_i64(values[i]);
            if we.is_err() {
                return we;
            }
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Append `list<bool>` as `len(i64)` + elements.
    pub fn write_list_bool(self: Binary, values: list<bool>) -> Result<i32, str8> {
        let l: i64 = values.len();
        let wl: Result<i32, str8> = self.write_i64(l);
        if wl.is_err() {
            return wl;
        }
        for i in 0..l {
            let we: Result<i32, str8> = self.write_bool(values[i]);
            if we.is_err() {
                return we;
            }
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Append `list<f64>` as `len(i64)` + elements.
    pub fn write_list_f64(self: Binary, values: list<f64>) -> Result<i32, str8> {
        let l: i64 = values.len();
        let wl: Result<i32, str8> = self.write_i64(l);
        if wl.is_err() {
            return wl;
        }
        for i in 0..l {
            let we: Result<i32, str8> = self.write_f64(values[i]);
            if we.is_err() {
                return we;
            }
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Append `list<str8>` as `len(i64)` + elements.
    pub fn write_list_string(self: Binary, values: list<str8>) -> Result<i32, str8> {
        let l: i64 = values.len();
        let wl: Result<i32, str8> = self.write_i64(l);
        if wl.is_err() {
            return wl;
        }
        for i in 0..l {
            let we: Result<i32, str8> = self.write_string(values[i]);
            if we.is_err() {
                return we;
            }
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Append packed bitset as `bit_len(i64)` + bit payload bytes.
    pub fn write_bitset(self: Binary, bits_handle: i64, bit_len: i64) -> Result<i32, str8> {
        let bits: BitSet = BitSet { handle: bits_handle };
        let n: i64 = bit_len;
        let w0: Result<i32, str8> = self.write_i64(n);
        if w0.is_err() {
            return w0;
        }
        let byte_len: i64 = (n + 7) / 8;
        for bi in 0..byte_len {
            var v: i32 = 0;
            var mask: i32 = 1;
            for bj in 0..8 {
                let idx: i64 = bi * 8 + bj;
                if idx < n {
                    let br: Result<bool, str8> = bits.get(idx);
                    if br.is_err() {
                        return Err<i32, str8>(br.unwrap_err());
                    }
                    if br.unwrap() {
                        v += mask;
                    }
                }
                mask *= 2;
            }
            let wb: Result<i32, str8> = self.write_u8(v);
            if wb.is_err() {
                return wb;
            }
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Read byte at index from output buffer.
    pub fn get_u8(self: Binary, index: i64) -> Result<i32, str8> {
        let v: i32 = __mlang_std_serde_binary_get_u8(self.handle, index);
        if __mlang_std_serde_last_ok() == 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(v);
    }

    /// @brief Create an independent sequential reader over current bytes.
    pub fn to_reader(self: Binary) -> Result<Reader, str8> {
        let h: i64 = __mlang_std_serde_reader_new(self.handle);
        if h == 0 {
            return Err<Reader, str8>(last_error());
        }
        return Ok<Reader, str8>(Reader { handle: h });
    }

    /// @brief Write serialized bytes to file.
    pub fn write_file(self: Binary, path: str8) -> Result<i32, str8> {
        if __mlang_std_serde_binary_write_file(self.handle, path) != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Return underlying binary handle (for trait/custom codec plumbing).
    pub fn raw_handle(self: Binary) -> i64 {
        return self.handle;
    }

    /// @brief Free buffer resources.
    pub fn close(self: Binary) -> i32 {
        return __mlang_std_serde_binary_free(self.handle);
    }
}

impl Reader {
    /// @brief Create reader over a snapshot of a binary buffer.
    pub fn from_binary(binary: Binary) -> Result<Reader, str8> {
        let h: i64 = __mlang_std_serde_reader_new(binary.handle);
        binary.close();
        if h == 0 {
            return Err<Reader, str8>(last_error());
        }
        return Ok<Reader, str8>(Reader { handle: h });
    }

    /// @brief Create reader by loading all bytes from a file.
    pub fn from_file(path: str8) -> Result<Reader, str8> {
        let br: Result<Binary, str8> = Binary::from_file(path);
        if br.is_err() {
            return Err<Reader, str8>(br.unwrap_err());
        }
        let b: Binary = br.unwrap();
        return Reader::from_binary(b);
    }

    /// @brief Unread bytes still available.
    pub fn remaining(self: Reader) -> i64 {
        return __mlang_std_serde_reader_remaining(self.handle);
    }

    /// @brief Read one unsigned byte.
    pub fn read_u8(self: Reader) -> Result<i32, str8> {
        let v: i32 = __mlang_std_serde_reader_read_u8(self.handle);
        if __mlang_std_serde_last_ok() == 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(v);
    }

    /// @brief Read one bool byte.
    pub fn read_bool(self: Reader) -> Result<bool, str8> {
        let v: i32 = __mlang_std_serde_reader_read_bool(self.handle);
        if __mlang_std_serde_last_ok() == 0 {
            return Err<bool, str8>(last_error());
        }
        return Ok<bool, str8>(v != 0);
    }

    /// @brief Read one little-endian `i32`.
    pub fn read_i32(self: Reader) -> Result<i32, str8> {
        let v: i32 = __mlang_std_serde_reader_read_i32(self.handle);
        if __mlang_std_serde_last_ok() == 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(v);
    }

    /// @brief Read one little-endian `i64`.
    pub fn read_i64(self: Reader) -> Result<i64, str8> {
        let v: i64 = __mlang_std_serde_reader_read_i64(self.handle);
        if __mlang_std_serde_last_ok() == 0 {
            return Err<i64, str8>(last_error());
        }
        return Ok<i64, str8>(v);
    }

    /// @brief Read one IEEE754 `f32`.
    pub fn read_f32(self: Reader) -> Result<f32, str8> {
        let v: f32 = __mlang_std_serde_reader_read_f32(self.handle);
        if __mlang_std_serde_last_ok() == 0 {
            return Err<f32, str8>(last_error());
        }
        return Ok<f32, str8>(v);
    }

    /// @brief Read one IEEE754 `f64`.
    pub fn read_f64(self: Reader) -> Result<f64, str8> {
        let v: f64 = __mlang_std_serde_reader_read_f64(self.handle);
        if __mlang_std_serde_last_ok() == 0 {
            return Err<f64, str8>(last_error());
        }
        return Ok<f64, str8>(v);
    }

    /// @brief Read one length-prefixed UTF-8/string value.
    pub fn read_string(self: Reader) -> Result<str8, str8> {
        let s: str8 = __mlang_std_serde_reader_read_string(self.handle);
        if __mlang_std_serde_last_ok() == 0 {
            return Err<str8, str8>(last_error());
        }
        return Ok<str8, str8>(s);
    }

    /// @brief Read `list<i32>` encoded as `len(i64)` + elements.
    pub fn read_list_i32(self: Reader) -> Result<list<i32>, str8> {
        let lr: Result<i64, str8> = self.read_i64();
        if lr.is_err() {
            return Err<list<i32>, str8>(lr.unwrap_err());
        }
        let l: i64 = lr.unwrap();
        if l < 0 {
            return Err<list<i32>, str8>("negative list length");
        }
        var out: list<i32> = [];
        for _i in 0..l {
            let vr: Result<i32, str8> = self.read_i32();
            if vr.is_err() {
                return Err<list<i32>, str8>(vr.unwrap_err());
            }
            out.push(vr.unwrap());
        }
        return Ok<list<i32>, str8>(out);
    }

    /// @brief Read `list<i64>` encoded as `len(i64)` + elements.
    pub fn read_list_i64(self: Reader) -> Result<list<i64>, str8> {
        let lr: Result<i64, str8> = self.read_i64();
        if lr.is_err() {
            return Err<list<i64>, str8>(lr.unwrap_err());
        }
        let l: i64 = lr.unwrap();
        if l < 0 {
            return Err<list<i64>, str8>("negative list length");
        }
        var out: list<i64> = [];
        for _i in 0..l {
            let vr: Result<i64, str8> = self.read_i64();
            if vr.is_err() {
                return Err<list<i64>, str8>(vr.unwrap_err());
            }
            out.push(vr.unwrap());
        }
        return Ok<list<i64>, str8>(out);
    }

    /// @brief Read `list<bool>` encoded as `len(i64)` + elements.
    pub fn read_list_bool(self: Reader) -> Result<list<bool>, str8> {
        let lr: Result<i64, str8> = self.read_i64();
        if lr.is_err() {
            return Err<list<bool>, str8>(lr.unwrap_err());
        }
        let l: i64 = lr.unwrap();
        if l < 0 {
            return Err<list<bool>, str8>("negative list length");
        }
        var out: list<bool> = [];
        for _i in 0..l {
            let vr: Result<bool, str8> = self.read_bool();
            if vr.is_err() {
                return Err<list<bool>, str8>(vr.unwrap_err());
            }
            out.push(vr.unwrap());
        }
        return Ok<list<bool>, str8>(out);
    }

    /// @brief Read `list<f64>` encoded as `len(i64)` + elements.
    pub fn read_list_f64(self: Reader) -> Result<list<f64>, str8> {
        let lr: Result<i64, str8> = self.read_i64();
        if lr.is_err() {
            return Err<list<f64>, str8>(lr.unwrap_err());
        }
        let l: i64 = lr.unwrap();
        if l < 0 {
            return Err<list<f64>, str8>("negative list length");
        }
        var out: list<f64> = [];
        for _i in 0..l {
            let vr: Result<f64, str8> = self.read_f64();
            if vr.is_err() {
                return Err<list<f64>, str8>(vr.unwrap_err());
            }
            out.push(vr.unwrap());
        }
        return Ok<list<f64>, str8>(out);
    }

    /// @brief Read `list<str8>` encoded as `len(i64)` + elements.
    pub fn read_list_string(self: Reader) -> Result<list<str8>, str8> {
        let lr: Result<i64, str8> = self.read_i64();
        if lr.is_err() {
            return Err<list<str8>, str8>(lr.unwrap_err());
        }
        let l: i64 = lr.unwrap();
        if l < 0 {
            return Err<list<str8>, str8>("negative list length");
        }
        var out: list<str8> = [];
        for _i in 0..l {
            let vr: Result<str8, str8> = self.read_string();
            if vr.is_err() {
                return Err<list<str8>, str8>(vr.unwrap_err());
            }
            out.push(vr.unwrap());
        }
        return Ok<list<str8>, str8>(out);
    }

    /// @brief Read packed bitset encoded as `bit_len(i64)` + bit payload bytes.
    pub fn read_bitset(self: Reader) -> Result<BitSet, str8> {
        let nr: Result<i64, str8> = self.read_i64();
        if nr.is_err() {
            return Err<BitSet, str8>(nr.unwrap_err());
        }
        let n: i64 = nr.unwrap();
        if n < 0 {
            return Err<BitSet, str8>("negative bitset length");
        }
        let bsr: Result<BitSet, str8> = BitSet::new(n);
        if bsr.is_err() {
            return Err<BitSet, str8>(bsr.unwrap_err());
        }
        let bs: BitSet = bsr.unwrap();
        if bs.resize(n, false) != 0 {
            let e: str8 = std::bitset::last_error();
            bs.close();
            return Err<BitSet, str8>(e);
        }

        let byte_len: i64 = (n + 7) / 8;
        for bi in 0..byte_len {
            let vr: Result<i32, str8> = self.read_u8();
            if vr.is_err() {
                bs.close();
                return Err<BitSet, str8>(vr.unwrap_err());
            }
            let v: i32 = vr.unwrap();
            var mask: i32 = 1;
            for bj in 0..8 {
                let idx: i64 = bi * 8 + bj;
                if idx < n {
                    let bit_on: bool = (v & mask) != 0;
                    if bs.set(idx, bit_on) != 0 {
                        let e: str8 = std::bitset::last_error();
                        bs.close();
                        return Err<BitSet, str8>(e);
                    }
                }
                mask *= 2;
            }
        }
        return Ok<BitSet, str8>(bs);
    }

    /// @brief Return underlying reader handle (for trait/custom codec plumbing).
    pub fn raw_handle(self: Reader) -> i64 {
        return self.handle;
    }

    /// @brief Free reader resources.
    pub fn close(self: Reader) -> i32 {
        return __mlang_std_serde_reader_free(self.handle);
    }
}

/// @}
