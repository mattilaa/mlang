/// \file process.mla
/// \brief Child process spawning helpers for MLang (std::process).
///
/// This module provides:
/// - spawning a child process (`spawn`)
/// - optional stdin/stdout/stderr pipe access
/// - wait + exit status decoding


/// \cond INTERNAL_IMPORTS
mod std::process::detail;
use std::process::detail::*;
/// \endcond

/// @brief Nonblocking pipe read result.
pub struct PipeRead {
    var ready: i32;
    var len: i64;
};

/// @brief Child process handle.
pub struct Child {
    var handle: i64;
};

/// @brief Writable child stdin pipe.
pub struct ChildStdin {
    var handle: i64;
};

/// @brief Readable child stdout pipe.
pub struct ChildStdout {
    var handle: i64;
};

/// @brief Readable child stderr pipe.
pub struct ChildStderr {
    var handle: i64;
};

/// @brief Read/write child PTY master.
pub struct ChildPty {
    var handle: i64;
};

/// @brief Process exit status wrapper.
pub struct ExitStatus {
    var raw: i32;
};

/// @brief Nonblocking child wait poll result.
pub struct WaitPoll {
    var ready: i32;
    var status: ExitStatus;
};

/// @brief Lowercase stdlib type alias for `PipeRead`.
alias pipe_read = PipeRead;

/// @brief Lowercase stdlib type alias for `Child`.
alias child = Child;

/// @brief Lowercase stdlib type alias for `ChildStdin`.
alias child_stdin = ChildStdin;

/// @brief Lowercase stdlib type alias for `ChildStdout`.
alias child_stdout = ChildStdout;

/// @brief Lowercase stdlib type alias for `ChildStderr`.
alias child_stderr = ChildStderr;

/// @brief Lowercase stdlib type alias for `ChildPty`.
alias child_pty = ChildPty;

/// @brief Lowercase stdlib type alias for `ExitStatus`.
alias exit_status = ExitStatus;

/// @brief Lowercase stdlib type alias for `WaitPoll`.
alias wait_poll = WaitPoll;


/// @brief Return last backend process error.
pub fn last_error() -> str8 {
    return __mlang_std_process_last_error();
}

/// @brief Spawn a child process with stdin/stdout/stderr pipes enabled.
pub fn spawn(program: str8, args: list<str8>) -> Result<Child, str8> {
    let h: i64 = __mlang_std_process_spawn(program, args, 1, 1, 1);
    if h == 0 {
        return Err<Child, str8>(last_error());
    }
    return Ok<Child, str8>(Child { handle: h });
}

/// @brief Spawn a child process inheriting parent stdio.
pub fn spawn_inherit(program: str8, args: list<str8>) -> Result<Child, str8> {
    let h: i64 = __mlang_std_process_spawn(program, args, 0, 0, 0);
    if h == 0 {
        return Err<Child, str8>(last_error());
    }
    return Ok<Child, str8>(Child { handle: h });
}

/// @brief Spawn a foreground child process inheriting parent stdio.
///
/// This is intended for terminal-oriented full-screen programs that should
/// temporarily own the controlling terminal while they run.
pub fn spawn_foreground_inherit(program: str8, args: list<str8>) -> Result<Child, str8> {
    let h: i64 = __mlang_std_process_spawn_foreground_inherit(program, args);
    if h == 0 {
        return Err<Child, str8>(last_error());
    }
    return Ok<Child, str8>(Child { handle: h });
}

/// @brief Spawn a child process attached to a PTY.
pub fn spawn_pty(program: str8, args: list<str8>) -> Result<Child, str8> {
    let h: i64 = __mlang_std_process_spawn_pty(program, args);
    if h == 0 {
        return Err<Child, str8>(last_error());
    }
    return Ok<Child, str8>(Child { handle: h });
}

impl Child {
    /// @brief Take writable child stdin pipe.
    pub fn stdin(self: Child) -> Result<ChildStdin, str8> {
        let h: i64 = __mlang_std_process_take_stdin(self.handle);
        if h == 0 {
            return Err<ChildStdin, str8>(last_error());
        }
        return Ok<ChildStdin, str8>(ChildStdin { handle: h });
    }

    /// @brief Take readable child stdout pipe.
    pub fn stdout(self: Child) -> Result<ChildStdout, str8> {
        let h: i64 = __mlang_std_process_take_stdout(self.handle);
        if h == 0 {
            return Err<ChildStdout, str8>(last_error());
        }
        return Ok<ChildStdout, str8>(ChildStdout { handle: h });
    }

    /// @brief Take readable child stderr pipe.
    pub fn stderr(self: Child) -> Result<ChildStderr, str8> {
        let h: i64 = __mlang_std_process_take_stderr(self.handle);
        if h == 0 {
            return Err<ChildStderr, str8>(last_error());
        }
        return Ok<ChildStderr, str8>(ChildStderr { handle: h });
    }

    /// @brief Take PTY master handle.
    pub fn pty(self: Child) -> Result<ChildPty, str8> {
        let h: i64 = __mlang_std_process_take_pty(self.handle);
        if h == 0 {
            return Err<ChildPty, str8>(last_error());
        }
        return Ok<ChildPty, str8>(ChildPty { handle: h });
    }

    /// @brief Wait for child completion and return exit status.
    pub fn wait(self: Child) -> Result<ExitStatus, str8> {
        let raw: i32 = __mlang_std_process_wait_raw(self.handle);
        if raw < 0 {
            return Err<ExitStatus, str8>(last_error());
        }
        return Ok<ExitStatus, str8>(ExitStatus { raw: raw });
    }

    /// @brief Poll child status without blocking.
    ///
    /// Returns `WaitPoll { ready: 0, ... }` while the child is still running.
    /// When `ready == 1`, `status` contains the same decoded raw status values
    /// as `wait()`.
    pub fn try_wait(self: Child) -> Result<WaitPoll, str8> {
        let raw: i32 = __mlang_std_process_try_wait_raw(self.handle);
        if raw < -1 {
            return Err<WaitPoll, str8>(last_error());
        }
        if raw == -1 {
            let status: ExitStatus = ExitStatus { raw: 0 };
            let out: WaitPoll = WaitPoll { ready: 0, status: status };
            return Ok<WaitPoll, str8>(out);
        }
        let status: ExitStatus = ExitStatus { raw: raw };
        let out: WaitPoll = WaitPoll { ready: 1, status: status };
        return Ok<WaitPoll, str8>(out);
    }

    /// @brief Send signal `sig` to child process.
    pub fn kill(self: Child, sig: i32) -> Result<i32, str8> {
        let rc: i32 = __mlang_std_process_kill(self.handle, sig);
        if rc != 0 {
            return Err<i32, str8>(last_error());
        }
        return Ok<i32, str8>(0);
    }

    /// @brief Close child handle and owned OS resources.
    pub fn close(self: Child) -> i32 {
        return __mlang_std_process_child_close(self.handle);
    }
}

impl ExitStatus {
    /// @brief Return 1 when process exited normally.
    pub fn exited(self: ExitStatus) -> i32 {
        return __mlang_std_process_status_exited(self.raw);
    }

    /// @brief Return exit code, or -1 when not exited.
    pub fn code(self: ExitStatus) -> i32 {
        return __mlang_std_process_status_code(self.raw);
    }

    /// @brief Return 1 when process terminated by signal.
    pub fn signaled(self: ExitStatus) -> i32 {
        return __mlang_std_process_status_signaled(self.raw);
    }

    /// @brief Return terminating signal, or -1 when not signaled.
    pub fn signal(self: ExitStatus) -> i32 {
        return __mlang_std_process_status_signal(self.raw);
    }

    /// @brief Return 1 on successful exit code 0.
    pub fn success(self: ExitStatus) -> i32 {
        if self.exited() != 1 {
            return 0;
        }
        return self.code() == 0 ? 1 : 0;
    }
}

impl ChildStdin {
    /// @brief Write bytes to child stdin pipe.
    pub fn write(self: ChildStdin, s: str8) -> Result<i64, str8> {
        let n: i64 = __mlang_std_process_pipe_write(self.handle, s);
        if n < 0 {
            return Err<i64, str8>(last_error());
        }
        return Ok<i64, str8>(n);
    }

    /// @brief Close child stdin pipe.
    pub fn close(self: ChildStdin) -> i32 {
        return __mlang_std_process_pipe_close(self.handle);
    }
}

impl ChildStdout {
    /// @brief Read up to `capacity-1` bytes into `buf` (NUL-terminated).
    pub fn read(self: ChildStdout, buf: str8, capacity: i64) -> Result<i64, str8> {
        let n: i64 = __mlang_std_process_pipe_read(self.handle, buf, capacity);
        if n < 0 {
            return Err<i64, str8>(last_error());
        }
        return Ok<i64, str8>(n);
    }

    /// @brief Read available bytes from child stdout without blocking.
    ///
    /// Returns `PipeRead { ready: 0, len: 0 }` when no bytes are currently
    /// available. When `ready == 1`, `len == 0` means EOF and `len > 0`
    /// means bytes were read into `buf`.
    pub fn read_nonblocking(self: ChildStdout, buf: str8, capacity: i64) -> Result<PipeRead, str8> {
        let n: i64 = __mlang_std_process_pipe_read_nonblocking(self.handle, buf, capacity);
        if n < -1 {
            return Err<PipeRead, str8>(last_error());
        }
        if n == -1 {
            let out: PipeRead = PipeRead { ready: 0, len: 0 };
            return Ok<PipeRead, str8>(out);
        }
        let out: PipeRead = PipeRead { ready: 1, len: n };
        return Ok<PipeRead, str8>(out);
    }

    /// @brief Close child stdout pipe.
    pub fn close(self: ChildStdout) -> i32 {
        return __mlang_std_process_pipe_close(self.handle);
    }
}

impl ChildStderr {
    /// @brief Read up to `capacity-1` bytes into `buf` (NUL-terminated).
    pub fn read(self: ChildStderr, buf: str8, capacity: i64) -> Result<i64, str8> {
        let n: i64 = __mlang_std_process_pipe_read(self.handle, buf, capacity);
        if n < 0 {
            return Err<i64, str8>(last_error());
        }
        return Ok<i64, str8>(n);
    }

    /// @brief Read available bytes from child stderr without blocking.
    ///
    /// Returns `PipeRead { ready: 0, len: 0 }` when no bytes are currently
    /// available. When `ready == 1`, `len == 0` means EOF and `len > 0`
    /// means bytes were read into `buf`.
    pub fn read_nonblocking(self: ChildStderr, buf: str8, capacity: i64) -> Result<PipeRead, str8> {
        let n: i64 = __mlang_std_process_pipe_read_nonblocking(self.handle, buf, capacity);
        if n < -1 {
            return Err<PipeRead, str8>(last_error());
        }
        if n == -1 {
            let out: PipeRead = PipeRead { ready: 0, len: 0 };
            return Ok<PipeRead, str8>(out);
        }
        let out: PipeRead = PipeRead { ready: 1, len: n };
        return Ok<PipeRead, str8>(out);
    }

    /// @brief Close child stderr pipe.
    pub fn close(self: ChildStderr) -> i32 {
        return __mlang_std_process_pipe_close(self.handle);
    }
}

impl ChildPty {
    /// @brief Wait for stdin and/or PTY readability.
    ///
    /// Returns a bitmask:
    /// - `1` => parent stdin readable
    /// - `2` => PTY master readable
    pub fn wait_events(self: ChildPty, timeout_ms: i32) -> i32 {
        return __mlang_std_process_wait_pty_events(self.handle, timeout_ms);
    }

    /// @brief Write bytes to PTY master.
    pub fn write(self: ChildPty, s: str8) -> Result<i64, str8> {
        let n: i64 = __mlang_std_process_pipe_write(self.handle, s);
        if n < 0 {
            return Err<i64, str8>(last_error());
        }
        return Ok<i64, str8>(n);
    }

    /// @brief Read available bytes from PTY master without blocking.
    pub fn read_nonblocking(self: ChildPty, buf: str8, capacity: i64) -> Result<PipeRead, str8> {
        let n: i64 = __mlang_std_process_pipe_read_nonblocking(self.handle, buf, capacity);
        if n < -1 {
            return Err<PipeRead, str8>(last_error());
        }
        if n == -1 {
            return Ok<PipeRead, str8>(PipeRead { ready: 0, len: 0 });
        }
        return Ok<PipeRead, str8>(PipeRead { ready: 1, len: n });
    }

    /// @brief Resize the PTY window.
    pub fn resize(self: ChildPty, rows: i32, cols: i32) -> i32 {
        return __mlang_std_process_pty_resize(self.handle, rows, cols);
    }

    /// @brief Close PTY master.
    pub fn close(self: ChildPty) -> i32 {
        return __mlang_std_process_pipe_close(self.handle);
    }
}

/// @brief Compatibility helper: run argv vector inheriting stdio.
///
/// `argv[0]` is treated as program path and the rest as args.
/// Returns process exit code or `-1` on spawn/wait failure.
pub fn process_run(argv: list<str8>) -> i32 {
    if argv.len() <= 0 {
        return -1;
    }
    let program: str8 = argv[0];
    var args: list<str8> = [];
    for i in 1..argv.len() {
        args.push(argv[i]);
    }
    let sr: Result<Child, str8> = spawn_inherit(program, args);
    if sr.is_err() {
        return -1;
    }
    let child: Child = sr.unwrap();
    let wr: Result<ExitStatus, str8> = child.wait();
    if wr.is_err() {
        child.close();
        return -1;
    }
    let st: ExitStatus = wr.unwrap();
    let code: i32 = st.code();
    child.close();
    return code;
}

/// @brief Compatibility helper: build an app from `src_dir/main.mla` to `out`.
///
/// Uses `./build/mlang` and sets optimization by `release_mode`.
/// Returns builder exit code (0 on success).
pub fn process_run_build(cwd: str8, src_dir: str8, out: str8, release_mode: i32) -> i32 {
    let _ = cwd;
    var argv: list<str8> = [];
    argv.push("./build/mlang");
    argv.push(format!("{}/main.mla", src_dir));
    argv.push("-o");
    argv.push(out);
    if release_mode == 1 {
        argv.push("-O2");
    } else {
        argv.push("-O0");
    }
    return process_run(argv);
}
