}

fn c_stdlib_function_location(name: str8) -> str8 {
    if len(name) == 0 { return String::new(); }
    if starts_with(name, "__mlang_std_") == 1 { return String::new(); }
    if is_known_c_stdlib_symbol(name) == 0 { return String::new(); }

    let root: str8 = root_path_from_store();
    let here: str8 = cwd();
    let pattern: str8 = format!("{}(", name);

    var headers: list<str8> = [];
    headers.push("stdio.h");
    headers.push("_stdio.h");
    headers.push("stdlib.h");
    headers.push("_stdlib.h");
    headers.push("string.h");
    headers.push("_string.h");
    headers.push("strings.h");
    headers.push("math.h");
    headers.push("unistd.h");
    headers.push("_unistd.h");
    headers.push("fcntl.h");
    headers.push("sys/stat.h");
    headers.push("sys/types.h");
    headers.push("ctype.h");
    headers.push("time.h");

    for i in 0..headers.len() {
        let hname: str8 = headers[i];
        var candidates: list<str8> = [];
        if len(root) > 0 {
            candidates.push(concat(root, format!("/{}", hname)));
        }
        candidates.push(concat(here, format!("/{}", hname)));
        candidates.push(concat("/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/include/", hname));
        candidates.push(concat("/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/include/", hname));
        candidates.push(concat("/usr/include/", hname));

        for j in 0..candidates.len() {
            let hpath: str8 = candidates[j];
            if file_exists(hpath) != 1 { continue; }
            let htext_r: Result<str8, str8> = read_all_text(hpath);
            if htext_r.is_err() { continue; }
            let htext: str8 = htext_r.unwrap();
            let hloc: str8 = first_match_location(hpath, htext, pattern);
            if len(hloc) > 0 { return hloc; }
        }
    }

    var include_roots: list<str8> = [];
    include_roots.push("/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/include");
    include_roots.push("/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/include");
    include_roots.push("/usr/include");

    for i in 0..include_roots.len() {
        let inc_root: str8 = include_roots[i];
        if file_exists(inc_root) != 1 { continue; }
        let hdrs: list<str8> = glob_recursive(inc_root, "*.h");
        for j in 0..hdrs.len() {
            let hpath: str8 = hdrs[j];
            let htext_r: Result<str8, str8> = read_all_text(hpath);
            if htext_r.is_err() { continue; }
            let htext: str8 = htext_r.unwrap();
            let hloc: str8 = first_match_location(hpath, htext, pattern);
            if len(hloc) > 0 { return hloc; }
        }
    }

    return String::new();
}

fn extract_word_and_prefix(line_text: str8, col0: i64) -> str8 {
    let n: i64 = len(line_text);
    if n <= 0 { return "::"; }
    var idx: i64 = col0;
    if idx < 0 { idx = 0; }
    if idx > n { idx = n; }
    if idx > 0 {
        let ch: str8 = sub(line_text, idx - 1, 1);
        if is_ident_char(ch) == 1 {
            idx = idx - 1;
        }
    }
    if idx >= n {
        if n == 0 { return "::"; }
        idx = n - 1;
    }
    let c0: str8 = sub(line_text, idx, 1);
    if is_ident_char(c0) == 0 {
        return "::";
    }

    var starti: i64 = idx;
    let idx0: i64 = idx;
    for k in 0..idx0 {
        let pos: i64 = idx0 - k - 1;
        let ch: str8 = sub(line_text, pos, 1);
        if is_ident_char(ch) == 0 { break; }
        starti = pos;
    }
    var endi: i64 = idx + 1;
    for j in (idx0 + 1)..n {
        let ch: str8 = sub(line_text, j, 1);
        if is_ident_char(ch) == 0 { break; }
        endi = j + 1;
    }
    let word: str8 = sub(line_text, starti, endi - starti);

    var prefix: str8 = String::new();
    let left: str8 = sub(line_text, 0, starti);
    let sep: i64 = rfind(left, "::");
    if sep >= 0 {
        var sep0: i64 = -1;
        let ln: i64 = len(left);
        if sep + 1 < ln {
            let a: str8 = sub(left, sep, 1);
            let b: str8 = sub(left, sep + 1, 1);
            if eq(a, ":") == 1 {
                if eq(b, ":") == 1 {
                    sep0 = sep;
                }
            }
        }
        if sep0 < 0 {
            if sep > 0 {
                let a: str8 = sub(left, sep - 1, 1);
                let b: str8 = sub(left, sep, 1);
                if eq(a, ":") == 1 {
                    if eq(b, ":") == 1 {
                        sep0 = sep - 1;
                    }
                }
            }
        }
        if sep0 < 0 {
            if sep > 1 {
                let a: str8 = sub(left, sep - 2, 1);
                let b: str8 = sub(left, sep - 1, 1);
                if eq(a, ":") == 1 {
                    if eq(b, ":") == 1 {
                        sep0 = sep - 2;
                    }
                }
            }
        }
        if sep0 < 0 {
            return format!("{}::{}", prefix, word);
        }
        var qend: i64 = sep0;
        for t in 0..sep0 {
            let pos: i64 = sep0 - t - 1;
            let ch: str8 = sub(left, pos, 1);
            if eq(ch, " ") == 1 {
                qend = pos;
                continue;
            }
            if eq(ch, "\t") == 1 {
                qend = pos;
                continue;
            }
            break;
        }
        var qstart: i64 = qend;
        let qend0: i64 = qend;
        for t in 0..qend0 {
            let pos: i64 = qend0 - t - 1;
            let ch: str8 = sub(left, pos, 1);
            if is_ident_char(ch) == 1 {
                qstart = pos;
                continue;
            }
            break;
        }
        if qstart < qend {
            prefix = sub(left, qstart, qend - qstart);
        }
    }

    return format!("{}::{}", prefix, word);
}

fn word_at_col(line_text: str8, col0: i64) -> str8 {
    let n: i64 = len(line_text);
    if n <= 0 { return String::new(); }
    var idx: i64 = col0;
    if idx < 0 { idx = 0; }
    if idx > n { idx = n; }
    if idx > 0 {
        let chp: str8 = sub(line_text, idx - 1, 1);
        if is_ident_char(chp) == 1 {
            idx = idx - 1;
        }
    }
    if idx >= n { idx = n - 1; }
    if idx < 0 { return String::new(); }
    let ch: str8 = sub(line_text, idx, 1);
    if is_ident_char(ch) == 0 { return String::new(); }
    var s: i64 = idx;
    let idx0: i64 = idx;
    for i in 0..idx0 {
        let p: i64 = idx0 - i - 1;
        let c: str8 = sub(line_text, p, 1);
        if is_ident_char(c) == 1 {
            s = p;
            continue;
        }
        break;
    }
    var e: i64 = idx + 1;
    for i in (idx0 + 1)..n {
        let c: str8 = sub(line_text, i, 1);
        if is_ident_char(c) == 1 {
            e = i + 1;
            continue;
        }
        break;
    }
    if e <= s { return String::new(); }
    return sub(line_text, s, e - s);
}

fn symbol_kind_lsp(sig: str8) -> i32 {
    if contains(sig, "fn ") == 1 {
        return 12;
    }
    if contains(sig, "struct ") == 1 {
        return 23;
    }
    if contains(sig, "enum ") == 1 {
        return 10;
    }
    if contains(sig, "mod ") == 1 {
        return 2;
    }
    return 13;
}

fn completion_kind_lsp(label: str8) -> i32 {
    if ends_with(label, "!") == 1 { return 14; }
    if eq(label, "fn") == 1 { return 14; }
    if eq(label, "let") == 1 { return 14; }
    if eq(label, "var") == 1 { return 14; }
    if eq(label, "if") == 1 { return 14; }
    if eq(label, "else") == 1 { return 14; }
    if eq(label, "asm") == 1 { return 14; }
    if eq(label, "volatile") == 1 { return 14; }
    if eq(label, "for") == 1 { return 14; }
    if eq(label, "return") == 1 { return 14; }
    if eq(label, "struct") == 1 { return 14; }
    if eq(label, "enum") == 1 { return 14; }
    if eq(label, "mod") == 1 { return 14; }
    if eq(label, "use") == 1 { return 14; }
    if eq(label, "match") == 1 { return 14; }
    if eq(label, "impl") == 1 { return 14; }
    if eq(label, "extern") == 1 { return 14; }
    if eq(label, "pub") == 1 { return 14; }
    if eq(label, "i32") == 1 { return 22; }
    if eq(label, "i64") == 1 { return 22; }
    if eq(label, "u32") == 1 { return 22; }
    if eq(label, "u64") == 1 { return 22; }
    if eq(label, "bool") == 1 { return 22; }
    if eq(label, "f32") == 1 { return 22; }
    if eq(label, "f64") == 1 { return 22; }
    if eq(label, "f32") == 1 { return 22; }
    if eq(label, "f64") == 1 { return 22; }
    if eq(label, "string") == 1 { return 22; }
    return 6;
}

fn completion_detail(label: str8) -> str8 {
    if ends_with(label, "!") == 1 { return "builtin macro"; }
    if eq(label, "fn") == 1 { return "keyword: function definition"; }
    if eq(label, "let") == 1 { return "keyword: immutable binding"; }
    if eq(label, "var") == 1 { return "keyword: mutable binding"; }
    if eq(label, "if") == 1 { return "keyword: conditional branch"; }
    if eq(label, "else") == 1 { return "keyword: alternate branch"; }
    if eq(label, "asm") == 1 { return "keyword: inline assembly expression"; }
    if eq(label, "volatile") == 1 { return "keyword: marks inline assembly as side-effecting"; }
    if eq(label, "for") == 1 { return "keyword: loop over range/iterable"; }
    if eq(label, "return") == 1 { return "keyword: return from function"; }
    if eq(label, "struct") == 1 { return "keyword: struct type declaration"; }
    if eq(label, "enum") == 1 { return "keyword: enum type declaration"; }
    if eq(label, "mod") == 1 { return "keyword: module declaration"; }
    if eq(label, "use") == 1 { return "keyword: import symbol/module"; }
    if eq(label, "match") == 1 { return "keyword: pattern matching"; }
    if eq(label, "impl") == 1 { return "keyword: implementation block"; }
    if eq(label, "extern") == 1 { return "keyword: external symbol declaration"; }
    if eq(label, "pub") == 1 { return "keyword: public visibility"; }
    if eq(label, "i32") == 1 { return "builtin 32-bit signed integer"; }
    if eq(label, "i64") == 1 { return "builtin 64-bit signed integer"; }
    if eq(label, "u32") == 1 { return "builtin 32-bit unsigned integer"; }
    if eq(label, "u64") == 1 { return "builtin 64-bit unsigned integer"; }
    if eq(label, "bool") == 1 { return "builtin boolean type"; }
    if eq(label, "f32") == 1 { return "builtin 32-bit floating point"; }
    if eq(label, "f64") == 1 { return "builtin 64-bit floating point"; }
    if eq(label, "f32") == 1 { return "alias of f32"; }
    if eq(label, "f64") == 1 { return "alias of f64"; }
    if eq(label, "Handle") == 1 { return "builtin generic runtime handle type"; }
    if eq(label, "Thread") == 1 { return "builtin thread handle payload marker type"; }
    if eq(label, "Mutex") == 1 { return "builtin mutex handle payload marker type"; }
    if eq(label, "Atomic64") == 1 { return "builtin 64-bit atomic handle payload marker type"; }
    if eq(label, "string") == 1 { return "builtin UTF-8 string type"; }
    if eq(label, "is_ok") == 1 { return "builtin Result method"; }
    if eq(label, "is_err") == 1 { return "builtin Result method"; }
    if eq(label, "unwrap") == 1 { return "builtin Result/Option method"; }
    if eq(label, "unwrap_err") == 1 { return "builtin Result method"; }
    if eq(label, "is_some") == 1 { return "builtin Option method"; }
    if eq(label, "set") == 1 { return "BitSet method"; }
    if eq(label, "get") == 1 { return "BitSet method"; }
    if eq(label, "toggle") == 1 { return "BitSet method"; }
    if eq(label, "push") == 1 { return "BitSet method"; }
    if eq(label, "pop") == 1 { return "BitSet method"; }
    if eq(label, "resize") == 1 { return "BitSet method"; }
    if eq(label, "clear") == 1 { return "BitSet method"; }
    if eq(label, "len") == 1 { return "BitSet method"; }
    if eq(label, "capacity") == 1 { return "BitSet method"; }
    if eq(label, "count_ones") == 1 { return "BitSet method"; }
    if eq(label, "and_eq") == 1 { return "BitSet method"; }
    if eq(label, "or_eq") == 1 { return "BitSet method"; }
    if eq(label, "xor_eq") == 1 { return "BitSet method"; }
    if eq(label, "not_eq") == 1 { return "BitSet method"; }
    if eq(label, "raw_handle") == 1 { return "BitSet method"; }
    if eq(label, "close") == 1 { return "BitSet method"; }
    return String::new();
}

