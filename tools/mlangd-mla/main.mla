var g_session_ready: i32 = 0;
var g_session_handle: i64 = 0;
var g_uri_store_handle: i64 = 0;
var g_text_store_handle: i64 = 0;
var g_log_enabled: i32 = 0;
var g_log_level: i32 = 2;
var g_log_handle: i64 = 0;
var g_log_color: i32 = 0;

fn log_level_error() -> i32 { return 0; }
fn log_level_warn() -> i32 { return 1; }
fn log_level_info() -> i32 { return 2; }
fn log_level_debug() -> i32 { return 3; }
fn log_level_verbose() -> i32 { return 4; }

fn log_level_name(level: i32) -> string {
    if level == log_level_error(): { return "ERROR"; }
    if level == log_level_warn(): { return "WARN"; }
    if level == log_level_info(): { return "INFO"; }
    if level == log_level_debug(): { return "DEBUG"; }
    if level == log_level_verbose(): { return "VERBOSE"; }
    return "INFO";
}

fn parse_log_level(level_raw: str8) -> i32 {
    if strcmp(level_raw, "ERROR") == 0: {
        return log_level_error();
    }
    if strcmp(level_raw, "error") == 0: {
        return log_level_error();
    }
    if strcmp(level_raw, "WARN") == 0: {
        return log_level_warn();
    }
    if strcmp(level_raw, "warn") == 0: {
        return log_level_warn();
    }
    if strcmp(level_raw, "INFO") == 0: {
        return log_level_info();
    }
    if strcmp(level_raw, "info") == 0: {
        return log_level_info();
    }
    if strcmp(level_raw, "DEBUG") == 0: {
        return log_level_debug();
    }
    if strcmp(level_raw, "debug") == 0: {
        return log_level_debug();
    }
    if strcmp(level_raw, "VERBOSE") == 0: {
        return log_level_verbose();
    }
    if strcmp(level_raw, "verbose") == 0: {
        return log_level_verbose();
    }
    return -1;
}

fn should_log(level: i32) -> bool {
    if g_log_enabled == 0: { return false; }
    if g_log_handle == 0: { return false; }
    if level <= g_log_level: { return true; }
    return false;
}

fn log_level_tag(level: i32) -> string {
    return __mlang_std_time_log_level_tag(level, g_log_color);
}

fn log_write(level: i32, message: string) -> void {
    if should_log(level) == false: {
        return;
    }
    let ts: string = __mlang_std_time_local_datetime();
    let tag: string = log_level_tag(level);
    let line: string = format!("{} {} {}", ts, tag, message);
    let _ = __mlang_std_fs_write(g_log_handle, line);
    let _ = __mlang_std_fs_write(g_log_handle, "\n");
}

fn log_path_for_dir(dir: string) -> string {
    if len(dir) == 0: {
        return "/tmp/mlangd-mla.log";
    }
    if ends_with(dir, "/") == 1: {
        return concat(dir, "mlangd-mla.log");
    }
    return concat(dir, "/mlangd-mla.log");
}

fn setup_logging(args: list<str8>) -> i32 {
    var seen_prog: bool = false;
    var expect_level: bool = false;
    var expect_dir: bool = false;
    var enable_log: bool = false;
    var log_dir: string = "/tmp";
    var chosen_level: i32 = log_level_info();
    var use_color: bool = false;

    for arg in args {
        if seen_prog == false: {
            seen_prog = true;
            continue;
        }
        if expect_level: {
            let parsed_level: i32 = parse_log_level(arg);
            if parsed_level < 0: {
                eprintln!("mlangd-mla: invalid --log-level '{}'; expected DEBUG|INFO|ERROR|WARN|VERBOSE", arg);
                return 1;
            }
            chosen_level = parsed_level;
            enable_log = true;
            expect_level = false;
            continue;
        }
        if expect_dir: {
            log_dir = format!("{}", arg);
            enable_log = true;
            expect_dir = false;
            continue;
        }
        if strcmp(arg, "--enable-log") == 0: {
            enable_log = true;
            continue;
        }
        if strcmp(arg, "--log-color") == 0: {
            enable_log = true;
            use_color = true;
            continue;
        }
        if strcmp(arg, "--log-colors") == 0: {
            enable_log = true;
            use_color = true;
            continue;
        }
        if strcmp(arg, "--log-level") == 0: {
            expect_level = true;
            continue;
        }
        if strcmp(arg, "--log-dir") == 0: {
            expect_dir = true;
            continue;
        }

        let arg_s: string = format!("{}", arg);
        if starts_with(arg_s, "--log-level=") == 1: {
            eprintln!("mlangd-mla: use '--log-level <LEVEL>' (space form), not --log-level=<LEVEL>");
            return 1;
        }
        if starts_with(arg_s, "--log-dir=") == 1: {
            eprintln!("mlangd-mla: use '--log-dir <DIR>' (space form), not --log-dir=<DIR>");
            return 1;
        }
        if starts_with(arg_s, "--log-color=") == 1: {
            eprintln!("mlangd-mla: use '--log-colors' (flag form), not --log-colors=<...>");
            return 1;
        }
        if starts_with(arg_s, "--log-colors=") == 1: {
            eprintln!("mlangd-mla: use '--log-colors' (flag form), not --log-colors=<...>");
            return 1;
        }
    }

    if expect_level: {
        eprintln!("mlangd-mla: missing value after --log-level");
        return 1;
    }
    if expect_dir: {
        eprintln!("mlangd-mla: missing value after --log-dir");
        return 1;
    }
    if enable_log == false: {
        return 0;
    }

    let path: string = log_path_for_dir(log_dir);
    let handle: i64 = __mlang_std_fs_open_write(path);
    if handle == 0: {
        eprintln!("mlangd-mla: failed to open log file: {}", path);
        return 1;
    }

    g_log_handle = handle;
    g_log_level = chosen_level;
    g_log_enabled = 1;
    if use_color: {
        g_log_color = 1;
    }
    log_write(log_level_info(), format!("logging enabled path={} level={} color={}", path, log_level_name(g_log_level), g_log_color));
    return 0;
}

fn current_session() -> Session {
    return Session { handle: g_session_handle };
}

fn ensure_session() -> i32 {
    if g_session_ready == 1: {
        return 0;
    }
    let sr: Result<Session, string> = session_create();
    if sr.is_err(): {
        return 1;
    }
    let s: Session = match sr {
        Ok(v) => v,
        Err(_e) => Session { handle: 0 }
    };
    g_session_handle = s.handle;
    g_session_ready = 1;
    return 0;
}

fn ensure_uri_store() -> i32 {
    if g_uri_store_handle != 0: {
        return 0;
    }
    let h: i64 = uri_store_new();
    if h == 0: {
        return 1;
    }
    g_uri_store_handle = h;
    return 0;
}

fn ensure_text_store() -> i32 {
    if g_text_store_handle != 0: {
        return 0;
    }
    let h: i64 = text_store_new();
    if h == 0: {
        return 1;
    }
    g_text_store_handle = h;
    return 0;
}

fn make_result_response(id: i64, result_json: string) -> string {
    let id_s: string = format!("{}", id);
    let p1: string = concat("{\"jsonrpc\":\"2.0\",\"id\":", id_s);
    let p2: string = concat(p1, ",\"result\":");
    let p3: string = concat(p2, result_json);
    let out: string = concat(p3, "}");
    return out;
}

fn make_error_response(id: i64, code: i32, message: string) -> string {
    let id_s: string = format!("{}", id);
    let code_s: string = format!("{}", code);
    let p1: string = concat("{\"jsonrpc\":\"2.0\",\"id\":", id_s);
    let p2: string = concat(p1, ",\"error\":{\"code\":");
    let p3: string = concat(p2, code_s);
    let p4: string = concat(p3, ",\"message\":\"");
    let p5: string = concat(p4, message);
    let out: string = concat(p5, "\"}}");
    return out;
}

fn lsp_line(v: i32) -> i32 {
    if v > 0: {
        return v - 1;
    }
    return 0;
}

fn lsp_col(v: i32) -> i32 {
    if v > 0: {
        return v - 1;
    }
    return 0;
}

fn location_json(uri: string, line1: i32, col1: i32) -> string {
    let euri: string = json_escape(uri);
    let out: string = format!(
        "{{\"uri\":\"{}\",\"range\":{{\"start\":{{\"line\":{},\"character\":{}}},\"end\":{{\"line\":{},\"character\":{}}}}}}}",
        euri, lsp_line(line1), lsp_col(col1), lsp_line(line1), lsp_col(col1)
    );
    return out;
}

fn range_json(line1: i32, col1: i32) -> string {
    return format!(
        "{{\"start\":{{\"line\":{},\"character\":{}}},\"end\":{{\"line\":{},\"character\":{}}}}}",
        lsp_line(line1), lsp_col(col1), lsp_line(line1), lsp_col(col1)
    );
}

fn is_ident_char(ch: string) -> bool {
    if len(ch) != 1: { return false; }
    if contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", ch) == 1: {
        return true;
    }
    return false;
}

fn line_text_at(text: string, line0: i64) -> string {
    if line0 < 0: { return String::new(); }
    let n: i64 = len(text);
    var cur: i64 = 0;
    var start: i64 = 0;
    var found_start: i32 = 0;
    for i in 0..n {
        if cur == line0: {
            start = i;
            found_start = 1;
            break;
        }
        let ch: string = sub(text, i, 1);
        if eq(ch, "\n") == 1: {
            cur = cur + 1;
        }
    }
    if found_start == 0: {
        if cur == line0: {
            start = n;
        } else: {
            return String::new();
        }
    }
    var endi: i64 = start;
    var found_end: i32 = 0;
    for j in start..n {
        let ch: string = sub(text, j, 1);
        if eq(ch, "\n") == 1: { break; }
        endi = j + 1;
        found_end = 1;
    }
    if found_end == 0: {
        endi = start;
    }
    return sub(text, start, endi - start);
}

fn offset_to_line_col1(text: string, off: i64) -> i64 {
    let n: i64 = len(text);
    var pos: i64 = off;
    if pos < 0: { pos = 0; }
    if pos > n: { pos = n; }
    var line1: i64 = 1;
    var col1: i64 = 1;
    for i in 0..pos {
        let ch: string = sub(text, i, 1);
        if eq(ch, "\n") == 1: {
            line1 = line1 + 1;
            col1 = 1;
        } else: {
            col1 = col1 + 1;
        }
    }
    return line1 * 1000000 + col1;
}

fn root_path_from_store() -> string {
    if ensure_text_store() != 0: { return String::new(); }
    let root_uri: string = text_store_get(g_text_store_handle, "__mlang_root_uri__");
    if len(root_uri) == 0: { return String::new(); }
    if starts_with(root_uri, "file://") == 1: {
        return sub(root_uri, 7, len(root_uri) - 7);
    }
    return root_uri;
}

fn path_to_file_uri(path: string) -> string {
    if len(path) == 0: { return String::new(); }
    if starts_with(path, "file://") == 1: { return path; }
    return concat("file://", path);
}

fn first_match_location(path: string, text: string, pattern: string) -> string {
    let off: i64 = find(text, pattern);
    if off < 0: { return String::new(); }
    let packed: i64 = offset_to_line_col1(text, off);
    let line1: i32 = packed / 1000000;
    let col1: i32 = packed - (line1 * 1000000);
    return location_json(path_to_file_uri(path), line1, col1);
}

fn runtime_builtin_location(word: string) -> string {
    let root: string = root_path_from_store();
    if len(root) == 0: { return String::new(); }
    let docs: string = concat(root, "/docs/runtime_builtins.mlastub");
    if file_exists(docs) == 0: { return String::new(); }
    let text_r: Result<string, string> = read_all_text(docs);
    if text_r.is_err(): { return String::new(); }
    let text: string = text_r.unwrap();

    let tpat: string = format!("struct {}", word);
    let eloc: string = first_match_location(docs, text, tpat);
    if len(eloc) > 0: { return eloc; }

    let fpat: string = format!("extern fn {}", word);
    let floc: string = first_match_location(docs, text, fpat);
    if len(floc) > 0: { return floc; }
    return String::new();
}

fn string_intrinsic_location(member: string) -> string {
    var target: string = String::new();
    if eq(member, "new") == 1: { target = "new"; }
    if eq(member, "with_capacity") == 1: { target = "with_capacity"; }
    if eq(member, "free") == 1: { target = "free"; }
    if len(target) == 0: { return String::new(); }

    let root: string = root_path_from_store();
    var p1: string = String::new();
    var p2: string = String::new();
    if len(root) > 0: {
        p1 = concat(root, "/stdlib/std/strbuf.mla");
        p2 = concat(root, "/std/strbuf.mla");
    }

    var path: string = String::new();
    if len(p1) > 0: {
        if file_exists(p1) == 1: {
            path = p1;
        }
    }
    if len(path) == 0: {
        if len(p2) > 0: {
            if file_exists(p2) == 1: {
                path = p2;
            }
        }
    }
    if len(path) == 0: {
        let here: string = cwd();
        let p3: string = concat(here, "/stdlib/std/strbuf.mla");
        if file_exists(p3) == 1: {
            path = p3;
        }
    }
    if len(path) == 0: { return String::new(); }

    let text_r: Result<string, string> = read_all_text(path);
    if text_r.is_err(): { return String::new(); }
    let text: string = text_r.unwrap();
    let pat: string = format!("pub fn {}", target);
    return first_match_location(path, text, pat);
}

fn c_type_target(word: string) -> string {
    if eq(word, "i8") == 1: { return "int8_t"; }
    if eq(word, "i16") == 1: { return "int16_t"; }
    if eq(word, "i32") == 1: { return "int32_t"; }
    if eq(word, "i64") == 1: { return "int64_t"; }
    if eq(word, "u8") == 1: { return "uint8_t"; }
    if eq(word, "u16") == 1: { return "uint16_t"; }
    if eq(word, "u32") == 1: { return "uint32_t"; }
    if eq(word, "u64") == 1: { return "uint64_t"; }
    if eq(word, "int") == 1: { return "int32_t"; }
    if eq(word, "bool") == 1: { return "bool"; }
    if eq(word, "float") == 1: { return "mlang_float"; }
    if eq(word, "double") == 1: { return "mlang_double"; }
    if eq(word, "string") == 1: { return "mlang_string"; }
    if eq(word, "str8") == 1: { return "mlang_str8"; }
    if eq(word, "str16") == 1: { return "mlang_str16"; }
    return String::new();
}

fn c_internals_location(word: string) -> string {
    let target: string = c_type_target(word);
    if len(target) == 0: { return String::new(); }

    let root: string = root_path_from_store();
    let here: string = cwd();
    var p1: string = String::new();
    var p2: string = String::new();
    var p3: string = String::new();
    var p4: string = String::new();
    if len(root) > 0: {
        p1 = concat(root, "/mlang_c_types.h");
        p2 = concat(root, "/docs/runtime_builtins.h");
    }
    p3 = concat(here, "/mlang_c_types.h");
    p4 = concat(here, "/docs/runtime_builtins.h");

    var path: string = String::new();
    if len(path) == 0: {
        if len(p1) > 0: {
            if file_exists(p1) == 1: {
                path = p1;
            }
        }
    }
    if len(path) == 0: {
        if len(p3) > 0: {
            if file_exists(p3) == 1: {
                path = p3;
            }
        }
    }
    if len(path) > 0: {
        let text_r: Result<string, string> = read_all_text(path);
        if text_r.is_ok(): {
            let text: string = text_r.unwrap();
            let tloc: string = first_match_location(path, text, target);
            if len(tloc) > 0: { return tloc; }
        }
    }

    if starts_with(target, "mlang_") == 0: {
        var hname: string = "stdint.h";
        if eq(target, "bool") == 1: {
            hname = "stdbool.h";
        }
        var hp1: string = String::new();
        var hp2: string = String::new();
        var hp3: string = "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/include/";
        var hp4: string = "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/include/";
        var hp5: string = "/usr/include/";
        if len(root) > 0: {
            hp1 = concat(root, "/");
        }
        hp2 = concat(here, "/");

        var hpath: string = String::new();
        let c1: string = concat(hp1, hname);
        if file_exists(c1) == 1: { hpath = c1; }
        if len(hpath) == 0: {
            let c2: string = concat(hp2, hname);
            if file_exists(c2) == 1: { hpath = c2; }
        }
        if len(hpath) == 0: {
            let c3: string = concat(hp3, hname);
            if file_exists(c3) == 1: { hpath = c3; }
        }
        if len(hpath) == 0: {
            let c4: string = concat(hp4, hname);
            if file_exists(c4) == 1: { hpath = c4; }
        }
        if len(hpath) == 0: {
            let c5: string = concat(hp5, hname);
            if file_exists(c5) == 1: { hpath = c5; }
        }
        if len(hpath) > 0: {
            let htext_r: Result<string, string> = read_all_text(hpath);
            if htext_r.is_ok(): {
                let htext: string = htext_r.unwrap();
                let hloc: string = first_match_location(hpath, htext, target);
                if len(hloc) > 0: { return hloc; }
            }
        }

        var srcp1: string = String::new();
        var srcp2: string = String::new();
        var srcp3: string = String::new();
        if len(root) > 0: {
            srcp1 = concat(root, "/stdlib/src/std_math.c");
            srcp2 = concat(root, "/stdlib/src/std_strbuf.c");
        }
        srcp3 = concat(here, "/stdlib/src/std_math.c");

        var spath: string = String::new();
        if len(srcp1) > 0: {
            if file_exists(srcp1) == 1: { spath = srcp1; }
        }
        if len(spath) == 0: {
            if len(srcp3) > 0: {
                if file_exists(srcp3) == 1: { spath = srcp3; }
            }
        }
        if len(spath) == 0: {
            if len(srcp2) > 0: {
                if file_exists(srcp2) == 1: { spath = srcp2; }
            }
        }
        if len(spath) > 0: {
            let stext_r: Result<string, string> = read_all_text(spath);
            if stext_r.is_ok(): {
                let stext: string = stext_r.unwrap();
                let sloc: string = first_match_location(spath, stext, target);
                if len(sloc) > 0: { return sloc; }
            }
        }
        return String::new();
    }

    path = String::new();
    if len(path) == 0: {
        if len(p2) > 0: {
            if file_exists(p2) == 1: {
                path = p2;
            }
        }
    }
    if len(path) == 0: {
        if len(p4) > 0: {
            if file_exists(p4) == 1: {
                path = p4;
            }
        }
    }
    if len(path) > 0: {
        let text2_r: Result<string, string> = read_all_text(path);
        if text2_r.is_ok(): {
            let text2: string = text2_r.unwrap();
            let tloc2: string = first_match_location(path, text2, target);
            if len(tloc2) > 0: { return tloc2; }
        }
    }
    return String::new();
}

fn extract_word_and_prefix(line_text: string, col0: i64) -> string {
    let n: i64 = len(line_text);
    if n <= 0: { return "::"; }
    var idx: i64 = col0;
    if idx < 0: { idx = 0; }
    if idx > n: { idx = n; }
    if idx > 0: {
        let ch: string = sub(line_text, idx - 1, 1);
        if is_ident_char(ch) == 1: {
            idx = idx - 1;
        }
    }
    if idx >= n: {
        if n == 0: { return "::"; }
        idx = n - 1;
    }
    let c0: string = sub(line_text, idx, 1);
    if is_ident_char(c0) == 0: {
        return "::";
    }

    var starti: i64 = idx;
    let idx0: i64 = idx;
    for k in 0..idx0 {
        let pos: i64 = idx0 - k - 1;
        let ch: string = sub(line_text, pos, 1);
        if is_ident_char(ch) == 0: { break; }
        starti = pos;
    }
    var endi: i64 = idx + 1;
    for j in (idx0 + 1)..n {
        let ch: string = sub(line_text, j, 1);
        if is_ident_char(ch) == 0: { break; }
        endi = j + 1;
    }
    let word: string = sub(line_text, starti, endi - starti);

    var prefix: string = String::new();
    let left: string = sub(line_text, 0, starti);
    let sep: i64 = rfind(left, "::");
    if sep >= 0: {
        var sep0: i64 = -1;
        let ln: i64 = len(left);
        if sep + 1 < ln: {
            let a: string = sub(left, sep, 1);
            let b: string = sub(left, sep + 1, 1);
            if eq(a, ":") == 1: {
                if eq(b, ":") == 1: {
                    sep0 = sep;
                }
            }
        }
        if sep0 < 0: {
            if sep > 0: {
                let a: string = sub(left, sep - 1, 1);
                let b: string = sub(left, sep, 1);
                if eq(a, ":") == 1: {
                    if eq(b, ":") == 1: {
                        sep0 = sep - 1;
                    }
                }
            }
        }
        if sep0 < 0: {
            if sep > 1: {
                let a: string = sub(left, sep - 2, 1);
                let b: string = sub(left, sep - 1, 1);
                if eq(a, ":") == 1: {
                    if eq(b, ":") == 1: {
                        sep0 = sep - 2;
                    }
                }
            }
        }
        if sep0 < 0: {
            return format!("{}::{}", prefix, word);
        }
        var qend: i64 = sep0;
        for t in 0..sep0 {
            let pos: i64 = sep0 - t - 1;
            let ch: string = sub(left, pos, 1);
            if eq(ch, " ") == 1: {
                qend = pos;
                continue;
            }
            if eq(ch, "\t") == 1: {
                qend = pos;
                continue;
            }
            break;
        }
        var qstart: i64 = qend;
        let qend0: i64 = qend;
        for t in 0..qend0 {
            let pos: i64 = qend0 - t - 1;
            let ch: string = sub(left, pos, 1);
            if is_ident_char(ch) == 1: {
                qstart = pos;
                continue;
            }
            break;
        }
        if qstart < qend: {
            prefix = sub(left, qstart, qend - qstart);
        }
    }

    return format!("{}::{}", prefix, word);
}

fn symbol_kind_lsp(sym: DocumentSymbol) -> i32 {
    if contains(sym.signature, "fn ") == 1: {
        return 12;
    }
    if contains(sym.signature, "struct ") == 1: {
        return 23;
    }
    if contains(sym.signature, "enum ") == 1: {
        return 10;
    }
    if contains(sym.signature, "mod ") == 1: {
        return 2;
    }
    return 13;
}

fn completion_kind_lsp(label: string) -> i32 {
    if ends_with(label, "!") == 1: { return 14; }
    if eq(label, "fn") == 1: { return 14; }
    if eq(label, "let") == 1: { return 14; }
    if eq(label, "var") == 1: { return 14; }
    if eq(label, "if") == 1: { return 14; }
    if eq(label, "else") == 1: { return 14; }
    if eq(label, "for") == 1: { return 14; }
    if eq(label, "return") == 1: { return 14; }
    if eq(label, "struct") == 1: { return 14; }
    if eq(label, "enum") == 1: { return 14; }
    if eq(label, "mod") == 1: { return 14; }
    if eq(label, "use") == 1: { return 14; }
    if eq(label, "match") == 1: { return 14; }
    if eq(label, "impl") == 1: { return 14; }
    if eq(label, "extern") == 1: { return 14; }
    if eq(label, "pub") == 1: { return 14; }
    if eq(label, "int") == 1: { return 22; }
    if eq(label, "i32") == 1: { return 22; }
    if eq(label, "i64") == 1: { return 22; }
    if eq(label, "u32") == 1: { return 22; }
    if eq(label, "u64") == 1: { return 22; }
    if eq(label, "bool") == 1: { return 22; }
    if eq(label, "string") == 1: { return 22; }
    return 6;
}

fn completion_detail(label: string) -> string {
    if ends_with(label, "!") == 1: { return "builtin macro"; }
    if eq(label, "fn") == 1: { return "keyword: function definition"; }
    if eq(label, "let") == 1: { return "keyword: immutable binding"; }
    if eq(label, "var") == 1: { return "keyword: mutable binding"; }
    if eq(label, "if") == 1: { return "keyword: conditional branch"; }
    if eq(label, "else") == 1: { return "keyword: alternate branch"; }
    if eq(label, "for") == 1: { return "keyword: loop over range/iterable"; }
    if eq(label, "return") == 1: { return "keyword: return from function"; }
    if eq(label, "struct") == 1: { return "keyword: struct type declaration"; }
    if eq(label, "enum") == 1: { return "keyword: enum type declaration"; }
    if eq(label, "mod") == 1: { return "keyword: module declaration"; }
    if eq(label, "use") == 1: { return "keyword: import symbol/module"; }
    if eq(label, "match") == 1: { return "keyword: pattern matching"; }
    if eq(label, "impl") == 1: { return "keyword: implementation block"; }
    if eq(label, "extern") == 1: { return "keyword: external symbol declaration"; }
    if eq(label, "pub") == 1: { return "keyword: public visibility"; }
    if eq(label, "int") == 1: { return "builtin type alias (int32_t)"; }
    if eq(label, "i32") == 1: { return "builtin 32-bit signed integer"; }
    if eq(label, "i64") == 1: { return "builtin 64-bit signed integer"; }
    if eq(label, "u32") == 1: { return "builtin 32-bit unsigned integer"; }
    if eq(label, "u64") == 1: { return "builtin 64-bit unsigned integer"; }
    if eq(label, "bool") == 1: { return "builtin boolean type"; }
    if eq(label, "string") == 1: { return "builtin UTF-8 string type"; }
    return String::new();
}

fn completion_documentation(label: string) -> string {
    if eq(label, "int") == 1: {
        return "Alias for a 32-bit signed integer. Maps to C int32_t in the runtime ABI.";
    }
    if eq(label, "i32") == 1: {
        return "Signed 32-bit integer type for arithmetic and integer APIs.";
    }
    if eq(label, "i64") == 1: {
        return "Signed 64-bit integer type for larger integer values.";
    }
    if eq(label, "bool") == 1: {
        return "Boolean type with true/false values.";
    }
    if eq(label, "string") == 1: {
        return "UTF-8 string type used by stdlib and formatting macros.";
    }
    if eq(label, "println!") == 1: {
        return "Print formatted text to stdout and append a newline.";
    }
    if eq(label, "print!") == 1: {
        return "Print formatted text to stdout without a trailing newline.";
    }
    if eq(label, "eprintln!") == 1: {
        return "Print formatted text to stderr and append a newline.";
    }
    if eq(label, "eprint!") == 1: {
        return "Print formatted text to stderr without a trailing newline.";
    }
    if eq(label, "fn") == 1: {
        return "Starts a function declaration: fn name(params) -> ReturnType { ... }";
    }
    if eq(label, "if") == 1: {
        return "Conditional branch. Executes block when condition is true.";
    }
    if eq(label, "else") == 1: {
        return "Alternate branch executed when the preceding if-condition is false.";
    }
    if eq(label, "let") == 1: {
        return "Introduce an immutable local binding.";
    }
    if eq(label, "var") == 1: {
        return "Introduce a mutable local binding.";
    }
    if eq(label, "for") == 1: {
        return "Loop construct, commonly used with ranges: for i in 0..n { ... }";
    }
    if eq(label, "return") == 1: {
        return "Return a value from the current function.";
    }
    if eq(label, "match") == 1: {
        return "Pattern matching expression over enum/option/result and literals.";
    }
    return String::new();
}

fn completion_symbol_detail_in_uri(s: Session, target_uri: string, label: string) -> string {
    if len(target_uri) == 0: { return String::new(); }
    if len(label) == 0: { return String::new(); }
    let cr: Result<i32, string> = s.document_symbol_count(target_uri);
    if cr.is_err(): { return String::new(); }
    let n: i32 = match cr {
        Ok(v) => v,
        Err(_e) => 0
    };
    for i in 0..n {
        let sr: Result<DocumentSymbol, string> = s.document_symbol_get(target_uri, i);
        if sr.is_err(): { continue; }
        let sym: DocumentSymbol = match sr {
            Ok(v) => v,
            Err(_e) => DocumentSymbol {
                id: String::new(),
                name: String::new(),
                type_info: String::new(),
                signature: String::new(),
                kind: 0,
                line: 0,
                column: 0
            }
        };
        if eq(sym.name, label) != 1: { continue; }
        if len(sym.signature) > 0: { return sym.signature; }
        if len(sym.type_info) > 0: { return sym.type_info; }
        if ensure_text_store() == 0: {
            let text: string = text_store_get(g_text_store_handle, target_uri);
            if len(text) > 0: {
                let line0: i64 = sym.line - 1;
                if line0 >= 0: {
                    let ltxt: string = line_text_at(text, line0);
                    if contains(ltxt, "struct ") == 1: {
                        if contains(ltxt, label) == 1: {
                            return format!("struct {}", label);
                        }
                    }
                    if contains(ltxt, "enum ") == 1: {
                        if contains(ltxt, label) == 1: {
                            return format!("enum {}", label);
                        }
                    }
                    if contains(ltxt, "fn ") == 1: {
                        if contains(ltxt, label) == 1: {
                            return format!("fn {}", label);
                        }
                    }
                }
            }
        }
    }
    return String::new();
}

fn completion_symbol_doc_in_uri(s: Session, target_uri: string, label: string) -> string {
    if len(target_uri) == 0: { return String::new(); }
    if len(label) == 0: { return String::new(); }
    let cr: Result<i32, string> = s.document_symbol_count(target_uri);
    if cr.is_err(): { return String::new(); }
    let n: i32 = match cr {
        Ok(v) => v,
        Err(_e) => 0
    };
    for i in 0..n {
        let sr: Result<DocumentSymbol, string> = s.document_symbol_get(target_uri, i);
        if sr.is_err(): { continue; }
        let sym: DocumentSymbol = match sr {
            Ok(v) => v,
            Err(_e) => DocumentSymbol {
                id: String::new(),
                name: String::new(),
                type_info: String::new(),
                signature: String::new(),
                kind: 0,
                line: 0,
                column: 0
            }
        };
        if eq(sym.name, label) != 1: { continue; }
        if len(sym.type_info) > 0: {
            if len(sym.signature) > 0: {
                if eq(sym.type_info, sym.signature) != 1: {
                    return format!("type: {}", sym.type_info);
                }
            }
            return sym.type_info;
        }
        if len(sym.signature) > 0: { return sym.signature; }
    }
    return String::new();
}

fn completion_symbol_detail(s: Session, current_uri: string, label: string) -> string {
    let d0: string = completion_symbol_detail_in_uri(s, current_uri, label);
    if len(d0) > 0: { return d0; }
    if ensure_uri_store() != 0: { return String::new(); }
    let n: i64 = uri_store_count(g_uri_store_handle);
    for i in 0..n {
        let u: string = uri_store_get(g_uri_store_handle, i);
        if len(u) == 0: { continue; }
        if eq(u, current_uri) == 1: { continue; }
        let d: string = completion_symbol_detail_in_uri(s, u, label);
        if len(d) > 0: { return d; }
    }
    return String::new();
}

fn completion_symbol_doc(s: Session, current_uri: string, label: string) -> string {
    let d0: string = completion_symbol_doc_in_uri(s, current_uri, label);
    if len(d0) > 0: { return d0; }
    if ensure_uri_store() != 0: { return String::new(); }
    let n: i64 = uri_store_count(g_uri_store_handle);
    for i in 0..n {
        let u: string = uri_store_get(g_uri_store_handle, i);
        if len(u) == 0: { continue; }
        if eq(u, current_uri) == 1: { continue; }
        let d: string = completion_symbol_doc_in_uri(s, u, label);
        if len(d) > 0: { return d; }
    }
    return String::new();
}

fn handle_did_open(payload: string) -> i32 {
    if ensure_session() != 0: {
        return 1;
    }
    if ensure_uri_store() != 0: {
        return 1;
    }
    if ensure_text_store() != 0: {
        return 1;
    }
    let uri: string = extract_text_document_uri(payload);
    let lang: string = extract_text_document_language_id(payload);
    let text: string = extract_text_document_text(payload);
    let version: i64 = extract_text_document_version(payload);
    if len(uri) == 0: { return 1; }
    if len(lang) == 0: { return 1; }
    let s: Session = current_session();
    let r: Result<i32, string> = s.open_document(uri, lang, text, version);
    if r.is_err(): {
        return 1;
    }
    if uri_store_add(g_uri_store_handle, uri) != 0: {
        return 1;
    }
    if text_store_upsert(g_text_store_handle, uri, text) != 0: {
        return 1;
    }
    log_write(log_level_debug(), format!("didOpen uri={}", uri));
    return 0;
}

fn handle_did_change(payload: string) -> i32 {
    if ensure_session() != 0: {
        return 1;
    }
    if ensure_text_store() != 0: {
        return 1;
    }
    let uri: string = extract_text_document_uri(payload);
    let text: string = extract_first_change_text(payload);
    let version: i64 = extract_text_document_version(payload);
    if len(uri) == 0: { return 1; }
    let s: Session = current_session();
    let r: Result<i32, string> = s.change_document(uri, text, version);
    if r.is_err(): {
        return 1;
    }
    if text_store_upsert(g_text_store_handle, uri, text) != 0: {
        return 1;
    }
    log_write(log_level_debug(), format!("didChange uri={}", uri));
    return 0;
}

fn handle_did_close(payload: string) -> i32 {
    if ensure_session() != 0: {
        return 1;
    }
    let uri: string = extract_text_document_uri(payload);
    if len(uri) == 0: { return 1; }
    let s: Session = current_session();
    let r: Result<i32, string> = s.close_document(uri);
    if r.is_err(): {
        return 1;
    }
    if g_uri_store_handle != 0: {
        let _ = uri_store_remove(g_uri_store_handle, uri);
    }
    if g_text_store_handle != 0: {
        let _ = text_store_remove(g_text_store_handle, uri);
    }
    log_write(log_level_debug(), format!("didClose uri={}", uri));
    return 0;
}

fn handle_code_action(payload: string) -> string {
    if ensure_text_store() != 0: { return "[]"; }
    let uri: string = extract_text_document_uri(payload);
    if len(uri) == 0: { return "[]"; }
    let text: string = text_store_get(g_text_store_handle, uri);
    if len(text) == 0: { return "[]"; }
    let uri_e: string = json_escape(uri);

    var out: string = String::new();
    out = concat(out, "[");
    var j: i32 = 0;

    if contains(payload, "source.organizeImports") == 1: {
        let import_lines: i64 = organize_imports_line_count(text);
        if import_lines > 0: {
            let new_block_raw: string = organize_imports_text(text);
            if len(new_block_raw) > 0: {
                let new_block: string = json_escape(new_block_raw);
                let action_oi: string = format!(
                    "{{\"title\":\"Organize Imports\",\"kind\":\"source.organizeImports\",\"edit\":{{\"changes\":{{\"{}\":[{{\"range\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":{},\"character\":0}}}},\"newText\":\"{}\"}}]}}}}}}",
                    uri_e, import_lines, new_block
                );
                if j > 0: {
                    out = format!("{},{}", out, action_oi);
                } else: {
                    out = format!("{}{}", out, action_oi);
                }
                j = j + 1;
            }
        }
    }

    if contains(payload, "quickfix") == 1: {
        let msg: string = extract_first_diagnostic_message(payload);
        let sl: i64 = extract_first_diagnostic_start_line(payload);
        let sc: i64 = extract_first_diagnostic_start_character(payload);
        let el: i64 = extract_first_diagnostic_end_line(payload);
        let ec: i64 = extract_first_diagnostic_end_character(payload);
        var semicolon_hint: i32 = 0;
        if contains(msg, "semicolon") == 1: {
            semicolon_hint = 1;
        } else: {
            if contains(msg, "expected ';'") == 1: {
                semicolon_hint = 1;
            }
        }
        if semicolon_hint == 1: {
            if sl >= 0: {
                if sc >= 0: {
                    if el >= 0: {
                        if ec >= 0: {
                            var target_line: i64 = el;
                            var target_char: i64 = ec;
                            if ec == 0: {
                                if el > sl: {
                                    target_line = el - 1;
                                    target_char = line_length(text, target_line);
                                }
                            }
                            if target_line >= 0: {
                                if should_insert_semicolon(text, target_line, target_char) == 1: {
                                    let action_qf: string = format!(
                                        "{{\"title\":\"Insert ';'\",\"kind\":\"quickfix\",\"edit\":{{\"changes\":{{\"{}\":[{{\"range\":{{\"start\":{{\"line\":{},\"character\":{}}},\"end\":{{\"line\":{},\"character\":{}}}}},\"newText\":\";\"}}]}}}}}}",
                                        uri_e, target_line, target_char, target_line, target_char
                                    );
                                    if j > 0: {
                                        out = format!("{},{}", out, action_qf);
                                    } else: {
                                        out = format!("{}{}", out, action_qf);
                                    }
                                    j = j + 1;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    out = concat(out, "]");
    return out;
}

fn handle_definition(payload: string) -> string {
    if ensure_session() != 0: { return "[]"; }
    let uri: string = extract_text_document_uri(payload);
    let line: i64 = extract_position_line(payload);
    let col: i64 = extract_position_character(payload);
    if len(uri) == 0: { return "[]"; }
    if line < 0: { return "[]"; }
    if col < 0: { return "[]"; }

    if ensure_text_store() == 0: {
        let query_text: string = text_store_get(g_text_store_handle, uri);
        if len(query_text) > 0: {
            let line_text: string = line_text_at(query_text, line);
            let packed: string = extract_word_and_prefix(line_text, col);
            let sep: i64 = find(packed, "::");
            if sep >= 0: {
                let prefix: string = sub(packed, 0, sep);
                let word: string = sub(packed, sep + 2, len(packed) - sep - 2);
                if len(prefix) > 0: {
                    if eq(prefix, "String") == 1: {
                        let loc: string = string_intrinsic_location(word);
                        if len(loc) > 0: { return format!("[{}]", loc); }
                    }
                }
                if len(prefix) == 0: {
                    if len(word) > 0: {
                        let root_uri2: string = text_store_get(g_text_store_handle, "__mlang_root_uri__");
                        if len(root_uri2) > 0: {
                            let c_loc_ws: string = workspace_c_definition_search(root_uri2, word);
                            if len(c_loc_ws) > 0: { return format!("[{}]", c_loc_ws); }
                        }
                        if eq(word, "new") == 1: {
                            if contains(line_text, "String::new") == 1: {
                                let sloc1: string = string_intrinsic_location(word);
                                if len(sloc1) > 0: { return format!("[{}]", sloc1); }
                            }
                        }
                        if eq(word, "with_capacity") == 1: {
                            if contains(line_text, "String::with_capacity") == 1: {
                                let sloc2: string = string_intrinsic_location(word);
                                if len(sloc2) > 0: { return format!("[{}]", sloc2); }
                            }
                        }
                        if eq(word, "free") == 1: {
                            if contains(line_text, "String::free") == 1: {
                                let sloc3: string = string_intrinsic_location(word);
                                if len(sloc3) > 0: { return format!("[{}]", sloc3); }
                            }
                        }
                        let cloc: string = c_internals_location(word);
                        if len(cloc) > 0: { return format!("[{}]", cloc); }
                        let loc2: string = runtime_builtin_location(word);
                        if len(loc2) > 0: { return format!("[{}]", loc2); }
                    }
                }
            }
        }
    }

    let s: Session = current_session();
    let dr: Result<DefinitionLocation, string> =
        s.definition(uri, line + 1, col + 1);
    if dr.is_err(): { return "[]"; }

    let d: DefinitionLocation = match dr {
        Ok(v) => v,
        Err(_e) => DefinitionLocation { id: String::new(), name: String::new(), uri: String::new(), line: 0, column: 0 }
    };
    let loc: string = location_json(d.uri, d.line, d.column);
    let out: string = format!("[{}]", loc);
    return out;
}

fn handle_references(payload: string) -> string {
    if ensure_session() != 0: { return "[]"; }
    let uri: string = extract_text_document_uri(payload);
    let line: i64 = extract_position_line(payload);
    let col: i64 = extract_position_character(payload);
    if len(uri) == 0: { return "[]"; }
    if line < 0: { return "[]"; }
    if col < 0: { return "[]"; }

    let s: Session = current_session();
    let cr: Result<i32, string> = s.references_count(uri, line + 1, col + 1);
    if cr.is_err(): { return "[]"; }
    let include_decl: int = extract_include_declaration(payload);
    let n: i32 = match cr {
        Ok(v) => v,
        Err(_e) => 0
    };
    var def_uri: string = String::new();
    var def_line: i32 = -1;
    var def_col: i32 = -1;
    if include_decl == 0: {
        let dr: Result<DefinitionLocation, string> = s.definition(uri, line + 1, col + 1);
        if dr.is_ok(): {
            let d: DefinitionLocation = match dr {
                Ok(v) => v,
                Err(_e) => DefinitionLocation { id: String::new(), name: String::new(), uri: String::new(), line: -1, column: -1 }
            };
            def_uri = d.uri;
            def_line = d.line;
            def_col = d.column;
        }
    }

    var out: string = String::new();
    let p0: string = concat(out, "[");
    out = p0;
    var j: i32 = 0;

    for i in 0..n {
        let rr: Result<ReferenceLocation, string> = s.reference_get(uri, line + 1, col + 1, i);
        if rr.is_err(): { continue; }
        let r: ReferenceLocation = match rr {
            Ok(v) => v,
            Err(_e) => ReferenceLocation { uri: String::new(), line: 0, column: 0 }
        };
        if include_decl == 0: {
            if eq(r.uri, def_uri) == 1: {
                if r.line == def_line: {
                    if r.column == def_col: {
                        continue;
                    }
                }
            }
        }
        let loc: string = location_json(r.uri, r.line, r.column);
        if j > 0: {
            out = format!("{},{}", out, loc);
        } else: {
            out = format!("{}{}", out, loc);
        }
        j = j + 1;
    }

    let prev2: string = out;
    out = concat(out, "]");
    return out;
}

fn handle_hover(payload: string) -> string {
    if ensure_session() != 0: { return "null"; }
    let uri: string = extract_text_document_uri(payload);
    let line: i64 = extract_position_line(payload);
    let col: i64 = extract_position_character(payload);
    if len(uri) == 0: { return "null"; }
    if line < 0: { return "null"; }
    if col < 0: { return "null"; }

    let s: Session = current_session();
    let hr: Result<string, string> = s.hover(uri, line + 1, col + 1);
    if hr.is_err(): { return "null"; }
    let h: string = match hr {
        Ok(v) => v,
        Err(_e) => String::new()
    };
    let esc: string = json_escape(h);
    let out: string = format!(
        "{{\"contents\":{{\"kind\":\"plaintext\",\"value\":\"{}\"}}}}",
        esc
    );
    return out;
}

fn handle_completion(payload: string) -> string {
    if ensure_session() != 0: { return "[]"; }
    let uri: string = extract_text_document_uri(payload);
    let line: i64 = extract_position_line(payload);
    let col: i64 = extract_position_character(payload);
    if len(uri) == 0: { return "[]"; }
    if line < 0: { return "[]"; }
    if col < 0: { return "[]"; }

    let s: Session = current_session();
    let cr: Result<i32, string> = s.completion_count(uri, line + 1, col + 1);
    if cr.is_err(): { return "[]"; }
    let n: i32 = match cr {
        Ok(v) => v,
        Err(_e) => 0
    };

    var out: string = String::new();
    let p0: string = concat(out, "[");
    out = p0;
    var j: i32 = 0;

    for i in 0..n {
        let ir: Result<string, string> = s.completion_get(uri, line + 1, col + 1, i);
        if ir.is_err(): { continue; }
        let label_raw: string = match ir {
            Ok(v) => v,
            Err(_e) => String::new()
        };
        let label: string = json_escape(label_raw);
        let kind: i32 = completion_kind_lsp(label_raw);
        var detail_raw: string = completion_detail(label_raw);
        var doc_raw: string = completion_documentation(label_raw);
        if len(detail_raw) == 0: {
            detail_raw = completion_symbol_detail(s, uri, label_raw);
        }
        if len(doc_raw) == 0: {
            doc_raw = completion_symbol_doc(s, uri, label_raw);
        }
        let detail: string = json_escape(detail_raw);
        let doc: string = json_escape(doc_raw);
        var item: string = String::new();
        if len(doc_raw) > 0: {
            item = format!(
                "{{\"label\":\"{}\",\"kind\":{},\"detail\":\"{}\",\"documentation\":{{\"kind\":\"plaintext\",\"value\":\"{}\"}}}}",
                label, kind, detail, doc
            );
        } else: {
            item = format!(
                "{{\"label\":\"{}\",\"kind\":{},\"detail\":\"{}\"}}",
                label, kind, detail
            );
        }
        if j > 0: {
            out = format!("{},{}", out, item);
        } else: {
            out = format!("{}{}", out, item);
        }
        j = j + 1;
    }

    let prev2: string = out;
    out = concat(out, "]");
    return out;
}

fn handle_document_symbol(payload: string) -> string {
    if ensure_session() != 0: { return "[]"; }
    let uri: string = extract_text_document_uri(payload);
    if len(uri) == 0: { return "[]"; }
    let s: Session = current_session();
    let cr: Result<i32, string> = s.document_symbol_count(uri);
    if cr.is_err(): { return "[]"; }
    let n: i32 = match cr {
        Ok(v) => v,
        Err(_e) => 0
    };
    var out: string = String::new();
    out = concat(out, "[");
    for i in 0..n {
        let sr: Result<DocumentSymbol, string> = s.document_symbol_get(uri, i);
        if sr.is_err(): { continue; }
        let sym: DocumentSymbol = match sr {
            Ok(v) => v,
            Err(_e) => DocumentSymbol {
                id: String::new(),
                name: String::new(),
                type_info: String::new(),
                signature: String::new(),
                kind: 0,
                line: 0,
                column: 0
            }
        };
        let name_e: string = json_escape(sym.name);
        let range: string = range_json(sym.line, sym.column);
        let kind: i32 = symbol_kind_lsp(sym);
        let item: string = format!(
            "{{\"name\":\"{}\",\"kind\":{},\"range\":{},\"selectionRange\":{}}}",
            name_e, kind, range, range
        );
        let prev: string = out;
        if i > 0: {
            out = format!("{},{}", out, item);
        } else: {
            out = format!("{}{}", out, item);
        }
    }
    let prev2: string = out;
    out = concat(out, "]");
    return out;
}

fn handle_document_highlight(payload: string) -> string {
    if ensure_session() != 0: { return "[]"; }
    let uri: string = extract_text_document_uri(payload);
    let line: i64 = extract_position_line(payload);
    let col: i64 = extract_position_character(payload);
    if len(uri) == 0: { return "[]"; }
    if line < 0: { return "[]"; }
    if col < 0: { return "[]"; }

    let s: Session = current_session();
    let cr: Result<i32, string> = s.references_count(uri, line + 1, col + 1);
    if cr.is_err(): { return "[]"; }
    let n: i32 = match cr {
        Ok(v) => v,
        Err(_e) => 0
    };

    var out: string = String::new();
    out = concat(out, "[");
    var j: i32 = 0;
    for i in 0..n {
        let rr: Result<ReferenceLocation, string> = s.reference_get(uri, line + 1, col + 1, i);
        if rr.is_err(): { continue; }
        let r: ReferenceLocation = match rr {
            Ok(v) => v,
            Err(_e) => ReferenceLocation { uri: String::new(), line: 0, column: 0 }
        };
        if eq(r.uri, uri) != 1: { continue; }
        let range: string = range_json(r.line, r.column);
        let item: string = format!(
            "{{\"range\":{},\"kind\":1}}",
            range
        );
        let prev: string = out;
