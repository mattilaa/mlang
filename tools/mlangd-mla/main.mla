    if eq(label, "raw_handle") == 1 {
        return "BitSet.raw_handle() returns the underlying runtime handle.";
    }
    if eq(label, "close") == 1 {
        return "BitSet.close() releases the underlying packed bitset storage.";
    }
    if eq(label, "bool") == 1 {
        return "Boolean type with true/false values.";
    }
    if eq(label, "Handle") == 1 {
        return "Generic runtime handle wrapper used by thread/sync intrinsics (Handle<T>).";
    }
    if eq(label, "Thread") == 1 {
        return "Opaque payload marker used with Handle<Thread> for spawned threads.";
    }
    if eq(label, "Mutex") == 1 {
        return "Opaque payload marker used with Handle<Mutex> for mutex intrinsics.";
    }
    if eq(label, "Atomic64") == 1 {
        return "Opaque payload marker used with Handle<Atomic64> for 64-bit atomic intrinsics.";
    }
    if eq(label, "string") == 1 {
        return "UTF-8 string type used by stdlib and formatting macros.";
    }
    if eq(label, "println!") == 1 {
        return "Print formatted text to stdout and append a newline.";
    }
    if eq(label, "print!") == 1 {
        return "Print formatted text to stdout without a trailing newline.";
    }
    if eq(label, "eprintln!") == 1 {
        return "Print formatted text to stderr and append a newline.";
    }
    if eq(label, "eprint!") == 1 {
        return "Print formatted text to stderr without a trailing newline.";
    }
    if eq(label, "fn") == 1 {
        return "Starts a function declaration: fn name(params) -> ReturnType { ... }";
    }
    if eq(label, "if") == 1 {
        return "Conditional branch. Executes block when condition is true.";
    }
    if eq(label, "else") == 1 {
        return "Alternate branch executed when the preceding if-condition is false.";
    }
    if eq(label, "asm") == 1 {
        return "Inline assembly expression lowered directly to LLVM inline asm. Use `asm(type, \"...\", args...)` or `asm volatile(type, \"...\", args...)`.";
    }
    if eq(label, "volatile") == 1 {
        return "Marks inline assembly as side-effecting so LLVM keeps and orders it conservatively.";
    }
    if eq(label, "let") == 1 {
        return "Introduce an immutable local binding.";
    }
    if eq(label, "var") == 1 {
        return "Introduce a mutable local binding.";
    }
    if eq(label, "for") == 1 {
        return "Loop construct, commonly used with ranges: for i in 0..n { ... }";
    }
    if eq(label, "return") == 1 {
        return "Return a value from the current function.";
    }
    if eq(label, "match") == 1 {
        return "Pattern matching expression over enum/option/result and literals.";
    }
    return String::new();
}

fn load_document_symbols(target_uri: str8) -> list<DocumentSymbol> {
    var out: list<DocumentSymbol> = [];
    if len(target_uri) == 0 { return out; }
    let s: SessionRef = current_session();
    let cr: Result<i32, str8> = s.document_symbol_count(target_uri);
    if cr.is_err() { return out; }
    let n: i32 = match cr {
        Ok(v) => v,
        Err(_e) => 0
    };
    for i in 0..n {
        let sr: Result<DocumentSymbol, str8> = s.document_symbol_get(target_uri, i);
        if sr.is_err() { continue; }
        let sym: DocumentSymbol = match sr {
            Ok(v) => v,
            Err(_e) => DocumentSymbol {
                id: String::new(),
                name: String::new(),
                type_info: String::new(),
                signature: String::new(),
                kind: 0,
                line: 0,
                column: 0
            }
        };
        out.push(sym);
    }
    return out;
}

fn doc_comment_above_symbol(text: str8, line1: i32) -> str8 {
    if len(text) == 0 { return String::new(); }
    if line1 <= 1 { return String::new(); }
    var out: str8 = String::new();
    var found: i32 = 0;
    var y: i64 = line1 - 2;
    while y >= 0 {
        let raw: str8 = line_text_at(text, y);
        let line: str8 = trim_ascii_ws(raw);
        if starts_with(line, "///") == 1 {
            var body: str8 = sub(line, 3, len(line) - 3);
            body = trim_ascii_ws(body);
            if found == 0 {
                out = body;
            } else {
                out = format!("{}\n{}", body, out);
            }
            found = 1;
            y = y - 1;
            continue;
        }
        if found == 1 {
            break;
        }
        if len(line) == 0 {
            y = y - 1;
            continue;
        }
        break;
    }
    return out;
}

fn declaration_doc_in_text(text: str8, label: str8) -> str8 {
    if len(text) == 0 { return String::new(); }
    if len(label) == 0 { return String::new(); }
    let n: i64 = line_count(text);
    for i in 0..n {
        let raw: str8 = line_text_at(text, i);
        let line: str8 = trim_ascii_ws(raw);
        if contains(line, format!("struct {}", label)) == 1 {            return doc_comment_above_symbol(text, i + 1);
        }
        if contains(line, format!("enum {}", label)) == 1 {            return doc_comment_above_symbol(text, i + 1);
        }
        if contains(line, format!("fn {}", label)) == 1 {            return doc_comment_above_symbol(text, i + 1);
        }
    }
    return String::new();
}

fn completion_symbol_meta_from_symbols(label: str8,
                                       symbols: &list<DocumentSymbol>,
                                       text_cache: str8) -> CompletionMeta {
    if len(label) == 0 {
        return CompletionMeta { detail: String::new(), doc: String::new() };
    }
    for sym in symbols {
        if eq(sym.name, label) != 1 { continue; }

        var detail: str8 = String::new();
        if len(sym.signature) > 0 {
            detail = sym.signature;
        } else if len(sym.type_info) > 0 {
            detail = sym.type_info;
        } else if len(text_cache) > 0 {
            let line0: i64 = sym.line - 1;
            if line0 >= 0 {
                let ltxt: str8 = line_text_at(text_cache, line0);
                if contains(ltxt, "struct ") == 1 {
                    if contains(ltxt, label) == 1 {
                        detail = format!("struct {}", label);
                    }
                }
                if len(detail) == 0 {
                    if contains(ltxt, "enum ") == 1 {
                        if contains(ltxt, label) == 1 {
                            detail = format!("enum {}", label);
                        }
                    }
                }
                if len(detail) == 0 {
                    if contains(ltxt, "fn ") == 1 {
                        if contains(ltxt, label) == 1 {
                            detail = format!("fn {}", label);
                        }
                    }
                }
            }
        }

        var doc: str8 = String::new();
        if len(text_cache) > 0 {
            doc = doc_comment_above_symbol(text_cache, sym.line);
        }
        if len(doc) == 0 {
            if len(sym.type_info) > 0 {
                if len(sym.signature) > 0 {
                    if eq(sym.type_info, sym.signature) != 1 {
                        doc = format!("type: {}", sym.type_info);
                    }
                } else {
                    doc = sym.type_info;
                }
            }
        }
        if len(doc) == 0 {
            if len(sym.signature) > 0 {
                doc = sym.signature;
            }
        }
        return CompletionMeta { detail: detail, doc: doc };
    }
    if len(text_cache) > 0 {
        let fallback_doc: str8 = declaration_doc_in_text(text_cache, label);
        if len(fallback_doc) > 0 {
            return CompletionMeta { detail: String::new(), doc: fallback_doc };
        }
    }
    return CompletionMeta { detail: String::new(), doc: String::new() };
}

fn handle_did_open(payload: str8) -> i32 {
    if ensure_session() != 0 {
        return 1;
    }
    if ensure_uri_store() != 0 {
        return 1;
    }
    if ensure_text_store() != 0 {
        return 1;
    }
    let uri: str8 = extract_text_document_uri(payload);
    let lang: str8 = extract_text_document_language_id(payload);
    let text: str8 = extract_text_document_text(payload);
    let version: i64 = extract_text_document_version(payload);
    if len(uri) == 0 { return 1; }
    if len(lang) == 0 { return 1; }
    let s: SessionRef = current_session();
    let r: Result<i32, str8> = s.open_document(uri, lang, text, version);
    if r.is_err() {
        return 1;
    }
    if uri_store_add(g_uri_store_handle, uri) != 0 {
        return 1;
    }
    if text_store_upsert(g_text_store_handle, uri, text) != 0 {
        return 1;
    }
    log_write(log_level_debug(), format!("didOpen uri={}", uri));
    return 0;
}

fn handle_did_change(payload: str8) -> i32 {
    if ensure_session() != 0 {
        return 1;
    }
    if ensure_text_store() != 0 {
        return 1;
    }
    let uri: str8 = extract_text_document_uri(payload);
    let text: str8 = extract_first_change_text(payload);
    let version: i64 = extract_text_document_version(payload);
    if len(uri) == 0 { return 1; }
    let s: SessionRef = current_session();
    let r: Result<i32, str8> = s.change_document(uri, text, version);
    if r.is_err() {
        return 1;
    }
    if text_store_upsert(g_text_store_handle, uri, text) != 0 {
        return 1;
    }
    log_write(log_level_debug(), format!("didChange uri={}", uri));
    return 0;
}

fn handle_did_close(payload: str8) -> i32 {
    if ensure_session() != 0 {
        return 1;
    }
    let uri: str8 = extract_text_document_uri(payload);
    if len(uri) == 0 { return 1; }
    let s: SessionRef = current_session();
    let r: Result<i32, str8> = s.close_document(uri);
    if r.is_err() {
        return 1;
    }
    if g_uri_store_handle != 0 {
        let _ = uri_store_remove(g_uri_store_handle, uri);
    }
    if g_text_store_handle != 0 {
        let _ = text_store_remove(g_text_store_handle, uri);
    }
    log_write(log_level_debug(), format!("didClose uri={}", uri));
    return 0;
}

fn handle_code_action(payload: str8) -> str8 {
    if ensure_text_store() != 0 { return "[]"; }
    let uri: str8 = extract_text_document_uri(payload);
    if len(uri) == 0 { return "[]"; }
    let text: str8 = text_store_get(g_text_store_handle, uri);
    if len(text) == 0 { return "[]"; }
    let uri_e: str8 = json_escape(uri);

    var out: str8 = String::new();
    out = concat(out, "[");
    var j: i32 = 0;

    if contains(payload, "source.organizeImports") == 1 {
        let import_lines: i64 = organize_imports_line_count(text);
        if import_lines > 0 {
            let new_block_raw: str8 = organize_imports_text(text);
            if len(new_block_raw) > 0 {
                let new_block: str8 = json_escape(new_block_raw);
                let action_oi: str8 = format!(
                    "{{\"title\":\"Organize Imports\",\"kind\":\"source.organizeImports\",\"edit\":{{\"changes\":{{\"{}\":[{{\"range\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":{},\"character\":0}}}},\"newText\":\"{}\"}}]}}}}}}",
                    uri_e, import_lines, new_block
                );
                if j > 0 {
                    out = format!("{},{}", out, action_oi);
                } else {
                    out = format!("{}{}", out, action_oi);
                }
                j = j + 1;
            }
        }
    }

    if contains(payload, "quickfix") == 1 {
        let msg: str8 = extract_first_diagnostic_message(payload);
        let sl: i64 = extract_first_diagnostic_start_line(payload);
        let sc: i64 = extract_first_diagnostic_start_character(payload);
        let el: i64 = extract_first_diagnostic_end_line(payload);
        let ec: i64 = extract_first_diagnostic_end_character(payload);
        var semicolon_hint: i32 = 0;
        if contains(msg, "semicolon") == 1 {
            semicolon_hint = 1;
        } else {
            if contains(msg, "expected ';'") == 1 {
                semicolon_hint = 1;
            }
        }
        if semicolon_hint == 1 {
            if sl >= 0 {
                if sc >= 0 {
                    if el >= 0 {
                        if ec >= 0 {
                            var target_line: i64 = el;
                            var target_char: i64 = ec;
                            if ec == 0 {
                                if el > sl {
                                    target_line = el - 1;
                                    target_char = line_length(text, target_line);
                                }
                            }
                            if target_line >= 0 {
                                if should_insert_semicolon(text, target_line, target_char) == 1 {
                                    let action_qf: str8 = format!(
                                        "{{\"title\":\"Insert ';'\",\"kind\":\"quickfix\",\"edit\":{{\"changes\":{{\"{}\":[{{\"range\":{{\"start\":{{\"line\":{},\"character\":{}}},\"end\":{{\"line\":{},\"character\":{}}}}},\"newText\":\";\"}}]}}}}}}",
                                        uri_e, target_line, target_char, target_line, target_char
                                    );
                                    if j > 0 {
                                        out = format!("{},{}", out, action_qf);
                                    } else {
                                        out = format!("{}{}", out, action_qf);
                                    }
                                    j = j + 1;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    out = concat(out, "]");
    return out;
}

fn handle_definition(payload: str8) -> str8 {
    if ensure_session() != 0 { return "[]"; }
    let uri: str8 = extract_text_document_uri(payload);
    let line: i64 = extract_position_line(payload);
    let col: i64 = extract_position_character(payload);
    if len(uri) == 0 { return "[]"; }
    if line < 0 { return "[]"; }
    if col < 0 { return "[]"; }

    var query_text: str8 = String::new();
    if ensure_text_store() == 0 {
        query_text = text_store_get(g_text_store_handle, uri);
    }
    if len(query_text) == 0 {
        let p: str8 = file_uri_to_path(uri);
        if len(p) > 0 {
            if file_exists(p) == 1 {
                let tr: Result<str8, str8> = read_all_text(p);
                if tr.is_ok() {
                    query_text = tr.unwrap();
                }
            }
        }
    }

    if len(query_text) > 0 {
            let line_text: str8 = line_text_at(query_text, line);
            let extern_here0: str8 = extern_fn_name_from_line(line_text);
            if len(extern_here0) > 0 {
                let c_std_decl0: str8 = c_stdlib_function_location(extern_here0);
                if len(c_std_decl0) > 0 { return format!("[{}]", c_std_decl0); }
                let root_uri0: str8 = text_store_get(g_text_store_handle, "__mlang_root_uri__");
                if len(root_uri0) > 0 {
                    let c_loc_ws0: str8 = workspace_c_definition_search(root_uri0, extern_here0);
                    if len(c_loc_ws0) > 0 { return format!("[{}]", c_loc_ws0); }
                }
            }
            let import_loc0: str8 = module_import_location_from_line(line_text);
            if len(import_loc0) > 0 { return format!("[{}]", import_loc0); }
            if line > 0 {
                let line_prev: str8 = line_text_at(query_text, line - 1);
                let import_loc1: str8 = module_import_location_from_line(line_prev);
                if len(import_loc1) > 0 { return format!("[{}]", import_loc1); }
            }
            if contains(line_text, "#[") == 1 {
                let attr_loc: str8 = attribute_doc_location(line_text);
                if len(attr_loc) > 0 { return format!("[{}]", attr_loc); }
            }
            let line_trim: str8 = trim_ascii_ws(line_text);
            if starts_with(line_trim, "use ") == 1 {
                let use_mod: str8 = use_line_module_name(line_trim);
                if len(use_mod) > 0 {
                    let use_loc: str8 = module_file_location(use_mod);
                    if len(use_loc) > 0 { return format!("[{}]", use_loc); }
                }
            }
            if starts_with(line_trim, "mod ") == 1 {
                let mod_n: str8 = mod_line_module_name(line_trim);
                if len(mod_n) > 0 {
                    let mod_loc: str8 = module_file_location(mod_n);
                    if len(mod_loc) > 0 { return format!("[{}]", mod_loc); }
                }
                return "[]";
            }
            if contains(line_text, "TcpListener::bind(") == 1 {
                let nloc0: str8 = std_net_method_location("bind");
                if len(nloc0) > 0 { return format!("[{}]", nloc0); }
            }
            if contains(line_text, ".local_port(") == 1 {
                let nloc1: str8 = std_net_method_location("local_port");
                if len(nloc1) > 0 { return format!("[{}]", nloc1); }
            }
            let sc_pair: str8 = first_static_call_pair(line_text);
            let sc_sep: i64 = find(sc_pair, "::");
            if sc_sep > 0 {
                let sc_recv: str8 = sub(sc_pair, 0, sc_sep);
                let sc_method: str8 = sub(sc_pair, sc_sep + 2, len(sc_pair) - sc_sep - 2);
                if len(sc_recv) > 0 && len(sc_method) > 0 {
                    let sc_loc: str8 = associated_type_method_location(query_text, sc_recv, sc_method);
                    if len(sc_loc) > 0 { return format!("[{}]", sc_loc); }
                }
            }
            let dc_pair: str8 = first_dot_call_pair(line_text);
            let dc_sep: i64 = find(dc_pair, "::");
            if dc_sep > 0 {
                let dc_recv: str8 = sub(dc_pair, 0, dc_sep);
                let dc_method: str8 = sub(dc_pair, dc_sep + 2, len(dc_pair) - dc_sep - 2);
                let dc_ty: str8 = local_binding_type(query_text, dc_recv);
                if len(dc_ty) > 0 && len(dc_method) > 0 {
                    let dc_loc: str8 = associated_type_method_location(query_text, base_type_name(dc_ty), dc_method);
                    if len(dc_loc) > 0 { return format!("[{}]", dc_loc); }
                    if eq(base_type_name(dc_ty), "Result") == 1 {
                        let rloc0: str8 = builtin_result_method_location(dc_method);
                        if len(rloc0) > 0 { return format!("[{}]", rloc0); }
                    }
                }
            }
            let packed: str8 = extract_word_and_prefix(line_text, col);
            let sep: i64 = find(packed, "::");
            if sep >= 0 {
                let prefix: str8 = sub(packed, 0, sep);
                var word: str8 = sub(packed, sep + 2, len(packed) - sep - 2);
                if len(word) == 0 {
                    word = word_at_col(line_text, col);
                }
                if len(prefix) > 0 {
                    if eq(prefix, "String") == 1 {
                        let loc: str8 = string_intrinsic_location(word);
                        if len(loc) > 0 { return format!("[{}]", loc); }
                    }
                    let assoc_loc: str8 = associated_type_method_location(query_text, prefix, word);
                    if len(assoc_loc) > 0 { return format!("[{}]", assoc_loc); }
                    let static_recv: str8 = static_call_receiver_name(line_text, word);
                    if len(static_recv) > 0 {
                        let static_assoc: str8 = associated_type_method_location(query_text, static_recv, word);
                        if len(static_assoc) > 0 { return format!("[{}]", static_assoc); }
                    }
                    let result_mloc: str8 = builtin_result_method_location(word);
                    if len(result_mloc) > 0 { return format!("[{}]", result_mloc); }
                }
                if len(prefix) == 0 {
                    let result_mloc2: str8 = builtin_result_method_location(word);
                    if len(result_mloc2) > 0 {
                        if contains(line_text, format!(".{}(", word)) == 1 {
                            return format!("[{}]", result_mloc2);
                        }
                    }
                    if len(word) > 0 {
                        let p_word: str8 = file_uri_to_path(uri);
                        let decl_loc_word: str8 = extern_decl_location_in_text(p_word, query_text, word);
                        if len(decl_loc_word) > 0 { return format!("[{}]", decl_loc_word); }
                        let recv_static: str8 = static_call_receiver_name(line_text, word);
                        if len(recv_static) > 0 {
                            let recv_static_assoc: str8 = associated_type_method_location(query_text, recv_static, word);
                            if len(recv_static_assoc) > 0 { return format!("[{}]", recv_static_assoc); }
                        }
                        let recv: str8 = dot_call_receiver_name(line_text, word);
                        if len(recv) > 0 {
                            let recv_ty: str8 = local_binding_type(query_text, recv);
                            if len(recv_ty) > 0 {
                                let recv_assoc: str8 = associated_type_method_location(query_text, base_type_name(recv_ty), word);
                                if len(recv_assoc) > 0 { return format!("[{}]", recv_assoc); }
                                let recv_result_loc: str8 = builtin_result_method_location(word);
                                if len(recv_result_loc) > 0 {
                                    if eq(base_type_name(recv_ty), "Result") == 1 {
                                        return format!("[{}]", recv_result_loc);
                                    }
                                }
                            }
                        }
                        let qual_mod: str8 = find_module_for_qualifier(query_text, word);
                        if len(qual_mod) > 0 {
                            let qual_loc: str8 = module_file_location(qual_mod);
                            if len(qual_loc) > 0 { return format!("[{}]", qual_loc); }
                        }
                        if eq(word, "new") == 1 {
                            if contains(line_text, "String::new") == 1 {
                                let sloc1: str8 = string_intrinsic_location(word);
                                if len(sloc1) > 0 { return format!("[{}]", sloc1); }
                            }
                        }
                        if eq(word, "with_capacity") == 1 {
                            if contains(line_text, "String::with_capacity") == 1 {
                                let sloc2: str8 = string_intrinsic_location(word);
                                if len(sloc2) > 0 { return format!("[{}]", sloc2); }
                            }
                        }
                        if eq(word, "free") == 1 {
                            if contains(line_text, "String::free") == 1 {
                                let sloc3: str8 = string_intrinsic_location(word);
                                if len(sloc3) > 0 { return format!("[{}]", sloc3); }
                            }
                        }
                        let btloc: str8 = builtin_type_location(word);
                        if len(btloc) > 0 { return format!("[{}]", btloc); }
                        let thloc: str8 = thread_intrinsic_location(word);
                        if len(thloc) > 0 { return format!("[{}]", thloc); }
                        let cloc: str8 = c_internals_location(word);
                        if len(cloc) > 0 { return format!("[{}]", cloc); }
                        let loc2: str8 = runtime_builtin_location(word);
                        if len(loc2) > 0 { return format!("[{}]", loc2); }
                    }
                }
            }
    }

    let s: SessionRef = current_session();
    let dr: Result<DefinitionLocation, str8> =
        s.definition(uri, line + 1, col + 1);
    if dr.is_err() {
        if len(query_text) > 0 {
            let line_text2: str8 = line_text_at(query_text, line);
            let packed2: str8 = extract_word_and_prefix(line_text2, col);
            let sep2: i64 = find(packed2, "::");
            if sep2 >= 0 {
                var word2: str8 = sub(packed2, sep2 + 2, len(packed2) - sep2 - 2);
                if len(word2) == 0 {
                    word2 = word_at_col(line_text2, col);
                }
                if len(word2) > 0 {
                    let c_std_loc0: str8 = c_stdlib_function_location(word2);
                    if len(c_std_loc0) > 0 { return format!("[{}]", c_std_loc0); }
                    let root_uri2: str8 = text_store_get(g_text_store_handle, "__mlang_root_uri__");
                    if len(root_uri2) > 0 {
                        let c_loc_ws: str8 = workspace_c_definition_search(root_uri2, word2);
                        if len(c_loc_ws) > 0 { return format!("[{}]", c_loc_ws); }
                    }
                }
            }
        }
        return "[]";
    }

    let d: DefinitionLocation = match dr {
        Ok(v) => v,
        Err(_e) => DefinitionLocation { id: String::new(), name: String::new(), uri: String::new(), line: 0, column: 0 }
    };
    if len(query_text) > 0 {
            let root_uri3: str8 = text_store_get(g_text_store_handle, "__mlang_root_uri__");
            let line_text2: str8 = line_text_at(query_text, line);
            let extern_here: str8 = extern_fn_name_from_line(line_text2);
            if len(extern_here) > 0 {
                let c_std_loc2: str8 = c_stdlib_function_location(extern_here);
                if len(c_std_loc2) > 0 { return format!("[{}]", c_std_loc2); }
                if len(root_uri3) > 0 {
                    let c_loc_ws3: str8 = workspace_c_definition_search(root_uri3, extern_here);
                    if len(c_loc_ws3) > 0 { return format!("[{}]", c_loc_ws3); }
                }
            }
            let sc_pair2: str8 = first_static_call_pair(line_text2);
            let sc_sep2: i64 = find(sc_pair2, "::");
            if sc_sep2 > 0 {
                let sc_recv2: str8 = sub(sc_pair2, 0, sc_sep2);
                let sc_method2: str8 = sub(sc_pair2, sc_sep2 + 2, len(sc_pair2) - sc_sep2 - 2);
                if len(sc_recv2) > 0 && len(sc_method2) > 0 {
                    let sc_loc2: str8 = associated_type_method_location(query_text, sc_recv2, sc_method2);
                    if len(sc_loc2) > 0 { return format!("[{}]", sc_loc2); }
                }
            }
            let dc_pair2: str8 = first_dot_call_pair(line_text2);
            let dc_sep2: i64 = find(dc_pair2, "::");
            if dc_sep2 > 0 {
                let dc_recv2: str8 = sub(dc_pair2, 0, dc_sep2);
                let dc_method2: str8 = sub(dc_pair2, dc_sep2 + 2, len(dc_pair2) - dc_sep2 - 2);
                let dc_ty2: str8 = local_binding_type(query_text, dc_recv2);
                if len(dc_ty2) > 0 && len(dc_method2) > 0 {
                    let dc_loc2: str8 = associated_type_method_location(query_text, base_type_name(dc_ty2), dc_method2);
                    if len(dc_loc2) > 0 { return format!("[{}]", dc_loc2); }
                    if eq(base_type_name(dc_ty2), "Result") == 1 {
                        let rloc3: str8 = builtin_result_method_location(dc_method2);
                        if len(rloc3) > 0 { return format!("[{}]", rloc3); }
                    }
                }
            }
            let packed2: str8 = extract_word_and_prefix(line_text2, col);
            let sep2: i64 = find(packed2, "::");
            if sep2 >= 0 {
                let prefix2: str8 = sub(packed2, 0, sep2);
                var word2: str8 = sub(packed2, sep2 + 2, len(packed2) - sep2 - 2);
                if len(word2) == 0 {
                    word2 = word_at_col(line_text2, col);
                }
                if len(word2) > 0 {
                    let static_recv2: str8 = static_call_receiver_name(line_text2, word2);
                    if len(static_recv2) > 0 {
                        let static_assoc2: str8 = associated_type_method_location(query_text, static_recv2, word2);
                        if len(static_assoc2) > 0 { return format!("[{}]", static_assoc2); }
                    }
                    if len(prefix2) > 0 {
                        let assoc2: str8 = associated_type_method_location(query_text, prefix2, word2);
                        if len(assoc2) > 0 { return format!("[{}]", assoc2); }
                    }
                    let dot_recv2: str8 = dot_call_receiver_name(line_text2, word2);
                    if len(dot_recv2) > 0 {
                        let dot_ty2: str8 = local_binding_type(query_text, dot_recv2);
                        if len(dot_ty2) > 0 {
                            let dot_assoc2: str8 = associated_type_method_location(query_text, base_type_name(dot_ty2), word2);
                            if len(dot_assoc2) > 0 { return format!("[{}]", dot_assoc2); }
                            if eq(base_type_name(dot_ty2), "Result") == 1 {
                                let rloc2: str8 = builtin_result_method_location(word2);
                                if len(rloc2) > 0 { return format!("[{}]", rloc2); }
                            }
                        }
                    }
                }
            }
    }
    let loc: str8 = location_json(d.uri, d.line, d.column);
    let out: str8 = format!("[{}]", loc);
    return out;
}

fn handle_references(payload: str8) -> str8 {
    if ensure_session() != 0 { return "[]"; }
    let uri: str8 = extract_text_document_uri(payload);
    let line: i64 = extract_position_line(payload);
    let col: i64 = extract_position_character(payload);
    if len(uri) == 0 { return "[]"; }
    if line < 0 { return "[]"; }
    if col < 0 { return "[]"; }

    let s: SessionRef = current_session();
    let cr: Result<i32, str8> = s.references_count(uri, line + 1, col + 1);
    if cr.is_err() { return "[]"; }
    let include_decl: i32 = extract_include_declaration(payload);
    let n: i32 = match cr {
        Ok(v) => v,
        Err(_e) => 0
    };
    var def_uri: str8 = String::new();
    var def_line: i32 = -1;
    var def_col: i32 = -1;
    if include_decl == 0 {
        let dr: Result<DefinitionLocation, str8> = s.definition(uri, line + 1, col + 1);
        if dr.is_ok() {
            let d: DefinitionLocation = match dr {
                Ok(v) => v,
                Err(_e) => DefinitionLocation { id: String::new(), name: String::new(), uri: String::new(), line: -1, column: -1 }
            };
            def_uri = d.uri;
            def_line = d.line;
            def_col = d.column;
        }
    }

    var out: str8 = String::new();
    let p0: str8 = concat(out, "[");
    out = p0;
    var j: i32 = 0;

    for i in 0..n {
        let rr: Result<ReferenceLocation, str8> = s.reference_get(uri, line + 1, col + 1, i);
        if rr.is_err() { continue; }
        let r: ReferenceLocation = match rr {
            Ok(v) => v,
            Err(_e) => ReferenceLocation { uri: String::new(), line: 0, column: 0 }
        };
        if include_decl == 0 {
            if eq(r.uri, def_uri) == 1 {
                if r.line == def_line {
                    if r.column == def_col {
                        continue;
                    }
                }
            }
        }
        let loc: str8 = location_json(r.uri, r.line, r.column);
        if j > 0 {
            out = format!("{},{}", out, loc);
        } else {
            out = format!("{}{}", out, loc);
        }
        j = j + 1;
    }

    let prev2: str8 = out;
    out = concat(out, "]");
    return out;
}

fn handle_hover(payload: str8) -> str8 {
    if ensure_session() != 0 { return "null"; }
    let uri: str8 = extract_text_document_uri(payload);
    let line: i64 = extract_position_line(payload);
    let col: i64 = extract_position_character(payload);
    if len(uri) == 0 { return "null"; }
    if line < 0 { return "null"; }
    if col < 0 { return "null"; }

    let s: SessionRef = current_session();
    let hr: Result<str8, str8> = s.hover(uri, line + 1, col + 1);
    if hr.is_err() { return "null"; }
    let h: str8 = match hr {
        Ok(v) => v,
        Err(_e) => String::new()
    };
    let esc: str8 = json_escape(h);
    let out: str8 = format!(
        "{{\"contents\":{{\"kind\":\"plaintext\",\"value\":\"{}\"}}}}",
        esc
    );
    return out;
}

fn handle_completion(payload: str8) -> str8 {
    if ensure_session() != 0 { return "[]"; }
    if ensure_text_store() != 0 { return "[]"; }
    let uri: str8 = extract_text_document_uri(payload);
    let line: i64 = extract_position_line(payload);
    let col: i64 = extract_position_character(payload);
    if len(uri) == 0 { return "[]"; }
    if line < 0 { return "[]"; }
    if col < 0 { return "[]"; }

    let s: SessionRef = current_session();
    let cr: Result<i32, str8> = s.completion_count(uri, line + 1, col + 1);
    if cr.is_err() { return "[]"; }
    let n: i32 = match cr {
        Ok(v) => v,
        Err(_e) => 0
    };

    var need_symbol_meta: i32 = 0;
    for i in 0..n {
        let ir0: Result<str8, str8> = s.completion_get(uri, line + 1, col + 1, i);
        if ir0.is_err() { continue; }
        let label0: str8 = match ir0 {
            Ok(v) => v,
            Err(_e) => String::new()
        };
        if len(completion_detail(label0)) == 0 || len(completion_documentation(label0)) == 0 {
            need_symbol_meta = 1;
            break;
        }
    }

    var current_symbols: list<DocumentSymbol> = [];
    var current_text: str8 = String::new();
    if need_symbol_meta == 1 {
        current_symbols = load_document_symbols(uri);
        current_text = text_store_get(g_text_store_handle, uri);
    }

    var out: str8 = String::new();
    let p0: str8 = concat(out, "[");
    out = p0;
    var j: i32 = 0;

    for i in 0..n {
        let ir: Result<str8, str8> = s.completion_get(uri, line + 1, col + 1, i);
        if ir.is_err() { continue; }
        let label_raw: str8 = match ir {
            Ok(v) => v,
            Err(_e) => String::new()
        };
        let label: str8 = json_escape(label_raw);
        let kind: i32 = completion_kind_lsp(label_raw);
        var detail_raw: str8 = completion_detail(label_raw);
        var doc_raw: str8 = completion_documentation(label_raw);
        if len(detail_raw) == 0 || len(doc_raw) == 0 {
            let meta: CompletionMeta =
                completion_symbol_meta_from_symbols(label_raw, current_symbols,
                                                   current_text);
            if len(detail_raw) == 0 {
                detail_raw = meta.detail;
            }
            if len(doc_raw) == 0 {
                doc_raw = meta.doc;
            }
        }
        let detail: str8 = json_escape(detail_raw);
        let doc: str8 = json_escape(doc_raw);
        var item: str8 = String::new();
        if len(doc_raw) > 0 {
            item = format!(
                "{{\"label\":\"{}\",\"kind\":{},\"detail\":\"{}\",\"documentation\":{{\"kind\":\"plaintext\",\"value\":\"{}\"}}}}",
                label, kind, detail, doc
            );
        } else {
            item = format!(
                "{{\"label\":\"{}\",\"kind\":{},\"detail\":\"{}\"}}",
                label, kind, detail
            );
        }
        if j > 0 {
            out = format!("{},{}", out, item);
        } else {
            out = format!("{}{}", out, item);
        }
        j = j + 1;
    }

    let prev2: str8 = out;
    out = concat(out, "]");
    return out;
}

fn handle_document_symbol(payload: str8) -> str8 {
    if ensure_session() != 0 { return "[]"; }
    let uri: str8 = extract_text_document_uri(payload);
    if len(uri) == 0 { return "[]"; }
    let s: SessionRef = current_session();
    let cr: Result<i32, str8> = s.document_symbol_count(uri);
    if cr.is_err() { return "[]"; }
    let n: i32 = match cr {
        Ok(v) => v,
        Err(_e) => 0
    };
    var out: str8 = String::new();
    out = concat(out, "[");
    for i in 0..n {
        let sr: Result<DocumentSymbol, str8> = s.document_symbol_get(uri, i);
        if sr.is_err() { continue; }
        let sym: DocumentSymbol = match sr {
            Ok(v) => v,
            Err(_e) => DocumentSymbol {
                id: String::new(),
                name: String::new(),
                type_info: String::new(),
                signature: String::new(),
                kind: 0,
                line: 0,
                column: 0
            }
        };
        let name_e: str8 = json_escape(sym.name);
        let range: str8 = range_json(sym.line, sym.column);
        let kind: i32 = symbol_kind_lsp(sym.signature);
        let item: str8 = format!(
            "{{\"name\":\"{}\",\"kind\":{},\"range\":{},\"selectionRange\":{}}}",
            name_e, kind, range, range
        );
        let prev: str8 = out;
        if i > 0 {
            out = format!("{},{}", out, item);
        } else {
            out = format!("{}{}", out, item);
        }
    }
    let prev2: str8 = out;
    out = concat(out, "]");
    return out;
}

fn handle_document_highlight(payload: str8) -> str8 {
    if ensure_session() != 0 { return "[]"; }
    let uri: str8 = extract_text_document_uri(payload);
    let line: i64 = extract_position_line(payload);
    let col: i64 = extract_position_character(payload);
    if len(uri) == 0 { return "[]"; }
    if line < 0 { return "[]"; }
    if col < 0 { return "[]"; }

    let s: SessionRef = current_session();
    let cr: Result<i32, str8> = s.references_count(uri, line + 1, col + 1);
    if cr.is_err() { return "[]"; }
    let n: i32 = match cr {
        Ok(v) => v,
        Err(_e) => 0
    };

    var out: str8 = String::new();
    out = concat(out, "[");
    var j: i32 = 0;
    for i in 0..n {
        let rr: Result<ReferenceLocation, str8> = s.reference_get(uri, line + 1, col + 1, i);
        if rr.is_err() { continue; }
        let r: ReferenceLocation = match rr {
            Ok(v) => v,
            Err(_e) => ReferenceLocation { uri: String::new(), line: 0, column: 0 }
        };
        if eq(r.uri, uri) != 1 { continue; }
        let range: str8 = range_json(r.line, r.column);
        let item: str8 = format!(
            "{{\"range\":{},\"kind\":1}}",
            range
        );
        let prev: str8 = out;
        if j > 0 {
            out = format!("{},{}", out, item);
        } else {
            out = format!("{}{}", out, item);
        }
        j = j + 1;
    }
    let prev2: str8 = out;
    out = concat(out, "]");
    return out;
}

fn handle_signature_help(payload: str8) -> str8 {
    if ensure_session() != 0 { return "{\"signatures\":[],\"activeSignature\":0,\"activeParameter\":0}"; }
    let uri: str8 = extract_text_document_uri(payload);
    let line: i64 = extract_position_line(payload);
    let col: i64 = extract_position_character(payload);
    if len(uri) == 0 { return "{\"signatures\":[],\"activeSignature\":0,\"activeParameter\":0}"; }
    if line < 0 { return "{\"signatures\":[],\"activeSignature\":0,\"activeParameter\":0}"; }
    if col < 0 { return "{\"signatures\":[],\"activeSignature\":0,\"activeParameter\":0}"; }

    let s: SessionRef = current_session();
    let rr: Result<ResolvedSymbol, str8> = s.resolve_symbol(uri, line + 1, col + 1);
    var sig: str8 = String::new();
    if rr.is_ok() {
        let sym: ResolvedSymbol = match rr {
            Ok(v) => v,
            Err(_e) => ResolvedSymbol {
                id: String::new(),
                name: String::new(),
                uri: String::new(),
                type_info: String::new(),
                signature: String::new(),
                kind: 0,
                line: 0,
                column: 0,
                overload_count: 0,
                from_current_document: 0
            }
        };
        sig = sym.signature;
    }
    if len(sig) == 0 {
        if ensure_text_store() == 0 {
            if ensure_uri_store() == 0 {
                let query_text: str8 = text_store_get(g_text_store_handle, uri);
                if len(query_text) > 0 {
                    let callee: str8 = signature_help_callee(query_text, line, col);
                    if len(callee) > 0 {
                        let pat: str8 = format!("fn {}(", callee);
                        let uri_count: i64 = uri_store_count(g_uri_store_handle);
                        for ui in 0..uri_count {
                            let doc_uri: str8 = uri_store_get(g_uri_store_handle, ui);
                            if len(doc_uri) == 0 { continue; }
                            let cr: Result<i32, str8> = s.document_symbol_count(doc_uri);
                            if cr.is_err() { continue; }
                            let n: i32 = match cr {
                                Ok(v) => v,
                                Err(_e) => 0
                            };
                            for i in 0..n {
                                let sr: Result<DocumentSymbol, str8> = s.document_symbol_get(doc_uri, i);
                                if sr.is_err() { continue; }
                                let d: DocumentSymbol = match sr {
                                    Ok(v) => v,
                                    Err(_e) => DocumentSymbol {
                                        id: String::new(),
                                        name: String::new(),
                                        type_info: String::new(),
                                        signature: String::new(),
                                        kind: 0,
                                        line: 0,
                                        column: 0
                                    }
                                };
                                if len(d.signature) == 0 { continue; }
                                if contains(d.signature, pat) == 1 {
                                    sig = d.signature;
                                    break;
                                }
                            }
                            if len(sig) > 0 { break; }
                        }
                    }
                }
            }
        }
    }
    if len(sig) == 0 {
        let hr: Result<str8, str8> = s.hover(uri, line + 1, col + 1);
        if hr.is_err() { return "{\"signatures\":[],\"activeSignature\":0,\"activeParameter\":0}"; }
        sig = match hr {
            Ok(v) => v,
            Err(_e) => String::new()
        };
    }
    if len(sig) == 0 { return "{\"signatures\":[],\"activeSignature\":0,\"activeParameter\":0}"; }
    let label: str8 = json_escape(sig);
    return format!(
        "{{\"signatures\":[{{\"label\":\"{}\"}}],\"activeSignature\":0,\"activeParameter\":0}}",
        label
    );
}

fn handle_prepare_rename(payload: str8) -> str8 {
    if ensure_session() != 0 { return "null"; }
    let uri: str8 = extract_text_document_uri(payload);
    let line: i64 = extract_position_line(payload);
    let col: i64 = extract_position_character(payload);
    if len(uri) == 0 { return "null"; }
    if line < 0 { return "null"; }
    if col < 0 { return "null"; }
    let s: SessionRef = current_session();
    let rr: Result<ResolvedSymbol, str8> = s.resolve_symbol(uri, line + 1, col + 1);
    if rr.is_err() { return "null"; }
    let sym: ResolvedSymbol = match rr {
        Ok(v) => v,
        Err(_e) => ResolvedSymbol {
            id: String::new(),
            name: String::new(),
            uri: String::new(),
            type_info: String::new(),
            signature: String::new(),
            kind: 0,
            line: 0,
            column: 0,
            overload_count: 0,
            from_current_document: 0
        }
    };
    if len(sym.name) == 0 { return "null"; }
    let start_line: i32 = lsp_line(sym.line);
    let start_col: i32 = lsp_col(sym.column);
    let end_col: i32 = start_col + len(sym.name);
    return format!(
        "{{\"range\":{{\"start\":{{\"line\":{},\"character\":{}}},\"end\":{{\"line\":{},\"character\":{}}}}}}}",
        start_line, start_col, start_line, end_col
    );
}

fn handle_rename(payload: str8) -> str8 {
    if ensure_session() != 0 { return "null"; }
    let uri: str8 = extract_text_document_uri(payload);
    let line: i64 = extract_position_line(payload);
    let col: i64 = extract_position_character(payload);
    let new_name: str8 = extract_new_name(payload);
    if len(uri) == 0 { return "null"; }
    if line < 0 { return "null"; }
    if col < 0 { return "null"; }
    if len(new_name) == 0 { return "null"; }

    let s: SessionRef = current_session();
    let safe_r: Result<i32, str8> = s.rename_is_safe(uri, line + 1, col + 1, new_name);
    if safe_r.is_err() { return "null"; }
    let safe: i32 = match safe_r {
        Ok(v) => v,
        Err(_e) => 0
    };
    if safe != 1 { return "null"; }

    let sym_r: Result<ResolvedSymbol, str8> = s.resolve_symbol(uri, line + 1, col + 1);
    if sym_r.is_err() { return "null"; }
    let sym: ResolvedSymbol = match sym_r {
        Ok(v) => v,
        Err(_e) => ResolvedSymbol {
            id: String::new(),
            name: String::new(),
            uri: String::new(),
            type_info: String::new(),
            signature: String::new(),
            kind: 0,
            line: 0,
            column: 0,
            overload_count: 0,
            from_current_document: 0
        }
    };
    let old_len: i32 = len(sym.name);
    if old_len <= 0 { return "null"; }

    let refs_r: Result<i32, str8> = s.references_count(uri, line + 1, col + 1);
    if refs_r.is_err() { return "null"; }
    let n: i32 = match refs_r {
        Ok(v) => v,
        Err(_e) => 0
    };

    var changes: str8 = String::new();
    changes = concat(changes, "[");
    var j: i32 = 0;
    let new_e: str8 = json_escape(new_name);
    for i in 0..n {
        let rr: Result<ReferenceLocation, str8> = s.reference_get(uri, line + 1, col + 1, i);
        if rr.is_err() { continue; }
        let r: ReferenceLocation = match rr {
            Ok(v) => v,
            Err(_e) => ReferenceLocation { uri: String::new(), line: 0, column: 0 }
        };
        if len(r.uri) == 0 { continue; }
        let sl: i32 = lsp_line(r.line);
        let sc: i32 = lsp_col(r.column);
        let ec: i32 = sc + old_len;
        let uri_e: str8 = json_escape(r.uri);
        let change: str8 = format!(
            "{{\"textDocument\":{{\"uri\":\"{}\",\"version\":null}},\"edits\":[{{\"range\":{{\"start\":{{\"line\":{},\"character\":{}}},\"end\":{{\"line\":{},\"character\":{}}}}},\"newText\":\"{}\"}}]}}",
            uri_e, sl, sc, sl, ec, new_e
        );
        if j > 0 {
            changes = format!("{},{}", changes, change);
        } else {
            changes = format!("{}{}", changes, change);
        }
        j = j + 1;
    }
    changes = concat(changes, "]");
    if j <= 0 { return "null"; }
    return format!(
        "{{\"documentChanges\":{}}}",
        changes
    );
}

fn handle_diagnostic(payload: str8) -> str8 {
    if ensure_session() != 0 { return "{\"kind\":\"full\",\"items\":[]}"; }
    let uri: str8 = extract_text_document_uri(payload);
    if len(uri) == 0 { return "{\"kind\":\"full\",\"items\":[]}"; }
    let previous_result_id: str8 = extract_previous_result_id(payload);
    let s: SessionRef = current_session();
    let cr: Result<i32, str8> = s.syntax_diagnostic_count(uri);
    if cr.is_err() { return "{\"kind\":\"full\",\"items\":[]}"; }
    let n: i32 = match cr {
        Ok(v) => v,
        Err(_e) => 0
    };
    var items: str8 = String::new();
    items = concat(items, "[");
    var result_id: str8 = format!("v1|{}", n);
    var j: i32 = 0;
    for i in 0..n {
        let dr: Result<SyntaxDiagnostic, str8> = s.syntax_diagnostic_get(uri, i);
        if dr.is_err() { continue; }
        let d: SyntaxDiagnostic = match dr {
            Ok(v) => v,
            Err(_e) => SyntaxDiagnostic { line: 0, column: 0, message: String::new() }
        };
        let msg: str8 = json_escape(d.message);
        let sl: i32 = lsp_line(d.line);
        let sc: i32 = lsp_col(d.column);
        let item: str8 = format!(
            "{{\"range\":{{\"start\":{{\"line\":{},\"character\":{}}},\"end\":{{\"line\":{},\"character\":{}}}}},\"severity\":1,\"message\":\"{}\"}}",
            sl, sc, sl, sc, msg
        );
        result_id = format!("{}|{}:{}:{}", result_id, d.line, d.column, d.message);
        if j > 0 {
            items = format!("{},{}", items, item);
        } else {
            items = format!("{}{}", items, item);
        }
        j = j + 1;
    }
    items = concat(items, "]");
    if len(previous_result_id) > 0 {
        if eq(previous_result_id, result_id) == 1 {
            let result_id_e: str8 = json_escape(result_id);
            return format!(
                "{{\"kind\":\"unchanged\",\"resultId\":\"{}\"}}",
                result_id_e
            );
        }
    }
    let result_id_e: str8 = json_escape(result_id);
    return format!(
        "{{\"kind\":\"full\",\"resultId\":\"{}\",\"items\":{}}}",
        result_id_e, items
    );
}

fn handle_workspace_symbol(payload: str8) -> str8 {
    if ensure_session() != 0 { return "[]"; }
    if ensure_uri_store() != 0 { return "[]"; }
    let query: str8 = extract_workspace_query(payload);
    let uri_count: i64 = uri_store_count(g_uri_store_handle);
    if uri_count <= 0 { return "[]"; }

    let s: SessionRef = current_session();
    var out: str8 = String::new();
    out = concat(out, "[");
    var j: i32 = 0;

    for ui in 0..uri_count {
        let uri: str8 = uri_store_get(g_uri_store_handle, ui);
        if len(uri) == 0 { continue; }
        let cr: Result<i32, str8> = s.document_symbol_count(uri);
        if cr.is_err() { continue; }
        let n: i32 = match cr {
            Ok(v) => v,
            Err(_e) => 0
        };
        for i in 0..n {
            let sr: Result<DocumentSymbol, str8> = s.document_symbol_get(uri, i);
            if sr.is_err() { continue; }
            let sym: DocumentSymbol = match sr {
                Ok(v) => v,
                Err(_e) => DocumentSymbol {
                    id: String::new(),
                    name: String::new(),
                    type_info: String::new(),
                    signature: String::new(),
                    kind: 0,
                    line: 0,
                    column: 0
                }
            };
            if len(query) > 0 {
                if contains(sym.name, query) != 1 { continue; }
            }
            let kind: i32 = symbol_kind_lsp(sym.signature);
            let name_e: str8 = json_escape(sym.name);
            let loc: str8 = location_json(uri, sym.line, sym.column);
            let item: str8 = format!(
                "{{\"name\":\"{}\",\"kind\":{},\"location\":{}}}",
                name_e, kind, loc
            );
            if j > 0 {
                out = format!("{},{}", out, item);
            } else {
                out = format!("{}{}", out, item);
            }
            j = j + 1;
        }
    }
    if j == 0 {
        if len(query) > 0 {
            if ensure_text_store() == 0 {
                let root_uri: str8 = text_store_get(g_text_store_handle, "__mlang_root_uri__");
                if len(root_uri) > 0 {
                    return workspace_symbol_search(root_uri, query);
                }
            }
        }
    }
    out = concat(out, "]");
    return out;
}

fn semantic_token_type(sig: str8) -> i32 {
    let kind_lsp: i32 = symbol_kind_lsp(sig);
    if kind_lsp == 12 {
        return 2; // function
    }
    if kind_lsp == 23 {
        return 5; // type
    }
    if kind_lsp == 10 {
        return 5; // type
    }
    if kind_lsp == 2 {
        return 0; // keyword/module
    }
    if contains(sig, "fn ") == 1 {
        return 2; // function
    }
    if contains(sig, "struct ") == 1 {
        return 5; // type
    }
    if contains(sig, "enum ") == 1 {
        return 5; // type
    }
    if contains(sig, "mod ") == 1 {
        return 0; // keyword
    }
    return 4; // variable
}

fn semantic_token_modifiers(sig: str8) -> i32 {
    // bit 0: declaration
    // bit 1: static
    // bit 2: readonly
    var mods: i32 = 1;
    if contains(sig, "static ") == 1 {
        mods = mods + 2;
    }
    if contains(sig, "let ") == 1 {
        mods = mods + 4;
    }
    return mods;
}

fn handle_semantic_tokens_full(payload: str8) -> str8 {
    if ensure_session() != 0 { return "{\"data\":[]}"; }
    let uri: str8 = extract_text_document_uri(payload);
    if len(uri) == 0 { return "{\"data\":[]}"; }
    let s: SessionRef = current_session();
    let cr: Result<i32, str8> = s.document_symbol_count(uri);
    if cr.is_err() { return "{\"data\":[]}"; }
    let n: i32 = match cr {
        Ok(v) => v,
        Err(_e) => 0
    };
    if n <= 0 { return "{\"data\":[]}"; }

    var data: str8 = String::new();
    data = concat(data, "[");
    var j: i32 = 0;
    var prev_line: i32 = 0;
    var prev_col: i32 = 0;

    for i in 0..n {
        let sr: Result<DocumentSymbol, str8> = s.document_symbol_get(uri, i);
        if sr.is_err() { continue; }
        let sym: DocumentSymbol = match sr {
            Ok(v) => v,
            Err(_e) => DocumentSymbol {
                id: String::new(),
                name: String::new(),
                type_info: String::new(),
                signature: String::new(),
                kind: 0,
                line: 0,
                column: 0
            }
        };
        if len(sym.name) <= 0 { continue; }
        let line0: i32 = lsp_line(sym.line);
        let col0: i32 = lsp_col(sym.column);
        if line0 < 0 { continue; }
        if col0 < 0 { continue; }
        let dl: i32 = line0 - prev_line;
        var ds: i32 = col0;
        if dl == 0 {
            ds = col0 - prev_col;
        }
        let tlen: i32 = len(sym.name);
        let ttype: i32 = semantic_token_type(sym.signature);
        let tmods: i32 = semantic_token_modifiers(sym.signature);
        let chunk: str8 = format!("{},{},{},{},{}", dl, ds, tlen, ttype, tmods);
        if j > 0 {
            data = format!("{},{}", data, chunk);
        } else {
            data = format!("{}{}", data, chunk);
        }
        prev_line = line0;
        prev_col = col0;
        j = j + 1;
    }

    data = concat(data, "]");
    return format!("{{\"data\":{}}}", data);
}

fn handle_implementation(payload: str8) -> str8 {
    if ensure_text_store() != 0 { return "[]"; }
    if ensure_uri_store() != 0 { return "[]"; }
    let uri: str8 = extract_text_document_uri(payload);
    let line: i64 = extract_position_line(payload);
    let col: i64 = extract_position_character(payload);
    if len(uri) == 0 { return "[]"; }
    if line < 0 { return "[]"; }
    if col < 0 { return "[]"; }

    let query_text: str8 = text_store_get(g_text_store_handle, uri);
    if len(query_text) == 0 { return "[]"; }

    let uri_count: i64 = uri_store_count(g_uri_store_handle);
    if uri_count <= 0 { return "[]"; }

    var out: str8 = String::new();
    out = concat(out, "[");
    var j: i32 = 0;

    for ui in 0..uri_count {
        let doc_uri: str8 = uri_store_get(g_uri_store_handle, ui);
        if len(doc_uri) == 0 { continue; }
        let candidate_text: str8 = text_store_get(g_text_store_handle, doc_uri);
        if len(candidate_text) == 0 { continue; }
        let packed: i64 = find_implementation_pos(query_text, line, col, candidate_text);
        if packed <= 0 { continue; }
        var divisor: i64 = 1;
        var shift_iter: i32 = 0;
        while shift_iter < 32 {
            divisor = divisor * 2;
            shift_iter = shift_iter + 1;
        }
        let line1: i32 = packed / divisor;
        let col1: i32 = packed - line1 * divisor;
        let loc: str8 = location_json(doc_uri, line1, col1);
        if j > 0 {
            out = format!("{},{}", out, loc);
        } else {
            out = format!("{}{}", out, loc);
        }
        j = j + 1;
    }
    out = concat(out, "]");
    return out;
}

fn handle_formatting(payload: str8) -> str8 {
    if ensure_text_store() != 0 { return "[]"; }
    let uri: str8 = extract_text_document_uri(payload);
    if len(uri) == 0 { return "[]"; }
    let text: str8 = text_store_get(g_text_store_handle, uri);
    if len(text) == 0 { return "[]"; }
    let tab_size: i64 = extract_format_tab_size(payload);
    let insert_spaces: i32 = extract_format_insert_spaces(payload);
    let formatted: str8 = format_text_with_options(text, tab_size, insert_spaces);
    if eq(formatted, text) == 1 { return "[]"; }
    let lc: i64 = line_count(text);
    var end_line: i64 = lc - 1;
    if end_line < 0 { end_line = 0; }
    let end_char: i64 = line_length(text, end_line);
    let fmt_e: str8 = json_escape(formatted);
    return format!(
        "[{{\"range\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":{},\"character\":{}}}}},\"newText\":\"{}\"}}]",
        end_line, end_char, fmt_e
    );
}

fn handle_range_formatting(payload: str8) -> str8 {
    if ensure_text_store() != 0 { return "[]"; }
    let uri: str8 = extract_text_document_uri(payload);
    if len(uri) == 0 { return "[]"; }
    let start_line: i64 = extract_range_start_line(payload);
    let start_char: i64 = extract_range_start_character(payload);
    let end_line: i64 = extract_range_end_line(payload);
    let end_char: i64 = extract_range_end_character(payload);
    if start_line < 0 { return "[]"; }
    if start_char < 0 { return "[]"; }
    if end_line < start_line { return "[]"; }
    if end_char < 0 { return "[]"; }
    let text: str8 = text_store_get(g_text_store_handle, uri);
    if len(text) == 0 { return "[]"; }
    let raw: str8 = extract_range_text(text, start_line, start_char, end_line, end_char);
    let tab_size: i64 = extract_format_tab_size(payload);
    let insert_spaces: i32 = extract_format_insert_spaces(payload);
    let formatted: str8 = format_text_with_options(raw, tab_size, insert_spaces);
    if eq(formatted, raw) == 1 { return "[]"; }
    let fmt_e: str8 = json_escape(formatted);
    return format!(
        "[{{\"range\":{{\"start\":{{\"line\":{},\"character\":{}}},\"end\":{{\"line\":{},\"character\":{}}}}},\"newText\":\"{}\"}}]",
        start_line, start_char, end_line, end_char, fmt_e
    );
}

fn dispatch_result_json(payload: str8) -> str8 {
    let method: str8 = extract_method(payload);
    log_write(log_level_verbose(), format!("request method={}", method));

    if eq(method, "initialize") == 1 {
        let _ = ensure_session();
        if ensure_text_store() == 0 {
            let root_uri: str8 = extract_root_uri(payload);
            if len(root_uri) > 0 {
                let _ = text_store_upsert(g_text_store_handle, "__mlang_root_uri__", root_uri);
            }
        }
        let ver_e: str8 = json_escape(version());
        return format!(
            "{{\"capabilities\":{{\"textDocumentSync\":{{\"openClose\":true,\"change\":1}},\"definitionProvider\":true,\"implementationProvider\":true,\"referencesProvider\":true,\"hoverProvider\":true,\"documentHighlightProvider\":true,\"completionProvider\":{{\"triggerCharacters\":[\".\",\":\"]}},\"signatureHelpProvider\":{{\"triggerCharacters\":[\"(\",\",\"]}},\"renameProvider\":{{\"prepareProvider\":true}},\"documentSymbolProvider\":true,\"workspaceSymbolProvider\":true,\"documentFormattingProvider\":true,\"documentRangeFormattingProvider\":true,\"codeActionProvider\":true,\"diagnosticProvider\":{{\"interFileDependencies\":false,\"workspaceDiagnostics\":false}},\"semanticTokensProvider\":{{\"legend\":{{\"tokenTypes\":[\"keyword\",\"macro\",\"function\",\"parameter\",\"variable\",\"type\",\"enumMember\"],\"tokenModifiers\":[\"declaration\",\"static\",\"readonly\"]}},\"full\":true}}}},\"serverInfo\":{{\"name\":\"mlangd-mla\",\"version\":\"{}\"}}}}",
            ver_e
        );
    }
    if eq(method, "shutdown") == 1 {
        return "null";
    }
    if eq(method, "textDocument/didOpen") == 1 {
        let _ = handle_did_open(payload);
        return "";
    }
    if eq(method, "textDocument/didChange") == 1 {
        let _ = handle_did_change(payload);
        return "";
    }
    if eq(method, "textDocument/didClose") == 1 {
        let _ = handle_did_close(payload);
        return "";
    }
    if eq(method, "textDocument/definition") == 1 {
        return handle_definition(payload);
    }
    if eq(method, "textDocument/references") == 1 {
        return handle_references(payload);
    }
    if eq(method, "textDocument/hover") == 1 {
        return handle_hover(payload);
    }
    if eq(method, "textDocument/completion") == 1 {
        return handle_completion(payload);
    }
    if eq(method, "textDocument/documentSymbol") == 1 {
        return handle_document_symbol(payload);
    }
    if eq(method, "textDocument/documentHighlight") == 1 {
        return handle_document_highlight(payload);
    }
    if eq(method, "textDocument/signatureHelp") == 1 {
        return handle_signature_help(payload);
    }
    if eq(method, "textDocument/prepareRename") == 1 {
        return handle_prepare_rename(payload);
    }
    if eq(method, "textDocument/rename") == 1 {
        return handle_rename(payload);
    }
    if eq(method, "textDocument/diagnostic") == 1 {
        return handle_diagnostic(payload);
    }
    if eq(method, "workspace/symbol") == 1 {
        return handle_workspace_symbol(payload);
    }

    if eq(method, "textDocument/implementation") == 1 { return handle_implementation(payload); }
    if eq(method, "textDocument/formatting") == 1 { return handle_formatting(payload); }
    if eq(method, "textDocument/rangeFormatting") == 1 { return handle_range_formatting(payload); }
    if eq(method, "textDocument/codeAction") == 1 { return handle_code_action(payload); }
    if eq(method, "textDocument/semanticTokens/full") == 1 { return handle_semantic_tokens_full(payload); }

    return "";
}

/// Dispatcher hook consumed by std::jsonrpc::run_stdio_loop.
fn __mlang_std_jsonrpc_runtime_dispatch(request_payload: str8) -> str8 {
    let id: i64 = extract_request_id(request_payload);
    let result_json: str8 = dispatch_result_json(request_payload);
    if id < 0 {
        log_write(log_level_verbose(), "notification handled");
        return String::new();
    }

    if len(result_json) > 0 {
        return make_result_response(id, result_json);
    }
    log_write(log_level_warn(), format!("method not found id={}", id));
    return make_error_response(id, -32601, "Method not found");
}

fn has_version_flag(args: list<str8>) -> bool {
    var seen_prog: bool = false;
    for arg in args {
        if seen_prog == false {
            seen_prog = true;
            continue;
        }
        if strcmp(arg, "--version") == 0 {
            return true;
        }
        if strcmp(arg, "-v") == 0 {
            return true;
        }
    }
    return false;
}

fn run_server_stdio_loop(frame_capacity: i64) -> Result<i32, str8> {
    let transport: StdioTransport = stdio();
    var frame = String::with_capacity(frame_capacity);
    for _i in 0..2147483647 {
        let rr: Result<i64, str8> = transport.read_frame(frame, frame_capacity);
        if rr.is_err() {
            let e: str8 = rr.unwrap_err();
            String::free(frame);
            if contains(e, "missing Content-Length header") == 1 {
                return Ok<i32, str8>(0);
            }
            return Err<i32, str8>(e);
        }

        let id: i64 = extract_request_id(frame);
        let result_json: str8 = dispatch_result_json(frame);
        if id < 0 {
            continue;
        }

        var response: str8 = String::new();
        if len(result_json) > 0 {
            response = make_result_response(id, result_json);
        } else {
            response = make_error_response(id, -32601, "Method not found");
        }

        let wr: Result<i32, str8> = transport.write_frame(response);
        String::free(response);
        if wr.is_err() {
            let ew: str8 = wr.unwrap_err();
            String::free(frame);
            return Err<i32, str8>(ew);
        }
    }
    String::free(frame);
    return Ok<i32, str8>(0);
}

fn main(argc: i32, args: list<str8>) -> i32 {
    if argc > 1 {
        if has_version_flag(args) {
            println!("mlangd-mla {}", version());
            return 0;
        }
    }
    if setup_logging(args) != 0 {
        return 1;
    }
    log_write(log_level_info(), format!("mlangd-mla {} starting stdio loop", version()));
    let r: Result<i32, str8> = run_server_stdio_loop(262144);
    if r.is_err() {
        log_write(log_level_error(), format!("stdio loop error: {}", r.unwrap_err()));
        if g_log_handle != 0 {
            let _ = __mlang_std_fs_close(g_log_handle);
        }
        return 1;
    }
    log_write(log_level_info(), "mlangd-mla stdio loop exited");
    if g_log_handle != 0 {
        let _ = __mlang_std_fs_close(g_log_handle);
    }
    return 0;
}
