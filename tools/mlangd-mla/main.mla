    if eq(label, "clear") == 1 {
        return "BitSet.clear() resets all stored bits to zero.";
    }
    if eq(label, "len") == 1 {
        return "BitSet.len() returns the logical bit length.";
    }
    if eq(label, "capacity") == 1 {
        return "BitSet.capacity() returns the reserved capacity in bits.";
