    if eq(label, "i32") == 1 {
        return "Signed 32-bit integer type for arithmetic and integer APIs.";
    }
    if eq(label, "i64") == 1 {
        return "Signed 64-bit integer type for larger integer values.";
    }
    if eq(label, "f32") == 1 {
        return "32-bit floating point type (single precision).";
    }
    if eq(label, "f64") == 1 {
        return "64-bit floating point type (f64 precision).";
    }
    if eq(label, "f32") == 1 {
        return "Alias for f32.";
    }
    if eq(label, "f64") == 1 {
        return "Alias for f64.";
    }
    if eq(label, "is_ok") == 1 {
        return "Result<T, E>.is_ok() returns true when the value is Ok.";
    }
    if eq(label, "is_err") == 1 {
        return "Result<T, E>.is_err() returns true when the value is Err.";
    }
    if eq(label, "unwrap") == 1 {
        return "Result<T, E>.unwrap() returns the Ok value and may panic on Err. Option<T>.unwrap() returns the Some value.";
    }
    if eq(label, "unwrap_err") == 1 {
        return "Result<T, E>.unwrap_err() returns the Err value.";
