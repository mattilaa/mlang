var g_session_ready: i32 = 0;
var g_session_handle: i64 = 0;
var g_uri_store_handle: i64 = 0;
var g_text_store_handle: i64 = 0;
var g_log_enabled: i32 = 0;
var g_log_level: i32 = 2;
var g_log_handle: i64 = 0;
var g_log_color: i32 = 0;

struct CompletionMeta {
    var detail: str8;
    var doc: str8;
};

fn log_level_error() -> i32 { return 0; }
fn log_level_warn() -> i32 { return 1; }
fn log_level_info() -> i32 { return 2; }
fn log_level_debug() -> i32 { return 3; }
fn log_level_verbose() -> i32 { return 4; }

fn log_level_name(level: i32) -> str8 {
    if level == log_level_error() { return "ERROR"; }
    if level == log_level_warn() { return "WARN"; }
    if level == log_level_info() { return "INFO"; }
    if level == log_level_debug() { return "DEBUG"; }
    if level == log_level_verbose() { return "VERBOSE"; }
    return "INFO";
}

fn parse_log_level(level_raw: str8) -> i32 {
    if strcmp(level_raw, "ERROR") == 0 {
        return log_level_error();
    }
    if strcmp(level_raw, "error") == 0 {
        return log_level_error();
    }
    if strcmp(level_raw, "WARN") == 0 {
        return log_level_warn();
    }
    if strcmp(level_raw, "warn") == 0 {
        return log_level_warn();
    }
    if strcmp(level_raw, "INFO") == 0 {
        return log_level_info();
    }
    if strcmp(level_raw, "info") == 0 {
        return log_level_info();
    }
    if strcmp(level_raw, "DEBUG") == 0 {
        return log_level_debug();
    }
    if strcmp(level_raw, "debug") == 0 {
        return log_level_debug();
    }
    if strcmp(level_raw, "VERBOSE") == 0 {
        return log_level_verbose();
    }
    if strcmp(level_raw, "verbose") == 0 {
        return log_level_verbose();
    }
    return -1;
}

fn should_log(level: i32) -> bool {
    if g_log_enabled == 0 { return false; }
    if g_log_handle == 0 { return false; }
    if level <= g_log_level { return true; }
    return false;
}

fn log_level_tag(level: i32) -> str8 {
    return __mlang_std_time_log_level_tag(level, g_log_color);
}

fn log_write(level: i32, message: str8) -> void {
    if should_log(level) == false {
        return;
    }
    let ts: str8 = __mlang_std_time_local_datetime();
    let tag: str8 = log_level_tag(level);
    let line: str8 = format!("{} {} {}", ts, tag, message);
    let _ = __mlang_std_fs_write(g_log_handle, line);
    let _ = __mlang_std_fs_write(g_log_handle, "\n");
}

fn log_path_for_dir(dir: str8) -> str8 {
    if len(dir) == 0 {
        return "/tmp/mlangd-mla.log";
    }
    if ends_with(dir, "/") == 1 {
        return concat(dir, "mlangd-mla.log");
    }
    return concat(dir, "/mlangd-mla.log");
}

fn setup_logging(args: list<str8>) -> i32 {
    var seen_prog: bool = false;
    var expect_level: bool = false;
    var expect_dir: bool = false;
    var enable_log: bool = false;
    var log_dir: str8 = "/tmp";
    var chosen_level: i32 = log_level_info();
    var use_color: bool = false;

    for arg in args {
        if seen_prog == false {
            seen_prog = true;
            continue;
        }
        if expect_level {
            let parsed_level: i32 = parse_log_level(arg);
            if parsed_level < 0 {
                eprintln!("mlangd-mla: invalid --log-level '{}'; expected DEBUG|INFO|ERROR|WARN|VERBOSE", arg);
                return 1;
            }
            chosen_level = parsed_level;
            enable_log = true;
            expect_level = false;
            continue;
        }
        if expect_dir {
            log_dir = format!("{}", arg);
            enable_log = true;
            expect_dir = false;
            continue;
        }
        if strcmp(arg, "--enable-log") == 0 {
            enable_log = true;
            continue;
        }
        if strcmp(arg, "--log-color") == 0 {
            enable_log = true;
            use_color = true;
            continue;
        }
        if strcmp(arg, "--log-colors") == 0 {
            enable_log = true;
            use_color = true;
            continue;
        }
        if strcmp(arg, "--log-level") == 0 {
            expect_level = true;
            continue;
        }
        if strcmp(arg, "--log-dir") == 0 {
            expect_dir = true;
            continue;
        }

        let arg_s: str8 = format!("{}", arg);
        if starts_with(arg_s, "--log-level=") == 1 {
            eprintln!("mlangd-mla: use '--log-level <LEVEL>' (space form), not --log-level=<LEVEL>");
            return 1;
        }
        if starts_with(arg_s, "--log-dir=") == 1 {
            eprintln!("mlangd-mla: use '--log-dir <DIR>' (space form), not --log-dir=<DIR>");
            return 1;
        }
        if starts_with(arg_s, "--log-color=") == 1 {
            eprintln!("mlangd-mla: use '--log-colors' (flag form), not --log-colors=<...>");
            return 1;
        }
        if starts_with(arg_s, "--log-colors=") == 1 {
            eprintln!("mlangd-mla: use '--log-colors' (flag form), not --log-colors=<...>");
            return 1;
        }
    }

    if expect_level {
        eprintln!("mlangd-mla: missing value after --log-level");
        return 1;
    }
    if expect_dir {
        eprintln!("mlangd-mla: missing value after --log-dir");
        return 1;
    }
    if enable_log == false {
        return 0;
    }

    let path: str8 = log_path_for_dir(log_dir);
    let handle: i64 = __mlang_std_fs_open_write(path);
    if handle == 0 {
        eprintln!("mlangd-mla: failed to open log file: {}", path);
        return 1;
    }

    g_log_handle = handle;
    g_log_level = chosen_level;
    g_log_enabled = 1;
    if use_color {
        g_log_color = 1;
    }
    log_write(log_level_info(), format!("logging enabled path={} level={} color={}", path, log_level_name(g_log_level), g_log_color));
    return 0;
}

fn current_session() -> SessionRef {
    return session_ref(g_session_handle);
}

fn ensure_session() -> i32 {
    if g_session_ready == 1 {
        return 0;
    }
    let sr: Result<i64, str8> = session_create_handle();
    if sr.is_err() {
        return 1;
    }
    let h: i64 = match sr {
        Ok(v) => v,
        Err(_e) => 0
    };
    g_session_handle = h;
    g_session_ready = 1;
    return 0;
}

fn ensure_uri_store() -> i32 {
    if g_uri_store_handle != 0 {
        return 0;
    }
    let h: i64 = uri_store_new();
    if h == 0 {
        return 1;
    }
    g_uri_store_handle = h;
    return 0;
}

fn ensure_text_store() -> i32 {
    if g_text_store_handle != 0 {
        return 0;
    }
    let h: i64 = text_store_new();
    if h == 0 {
        return 1;
    }
    g_text_store_handle = h;
    return 0;
}

fn make_result_response(id: i64, result_json: str8) -> str8 {
    let id_s: str8 = format!("{}", id);
    let p1: str8 = concat("{\"jsonrpc\":\"2.0\",\"id\":", id_s);
    let p2: str8 = concat(p1, ",\"result\":");
    let p3: str8 = concat(p2, result_json);
    let out: str8 = concat(p3, "}");
    return out;
}

fn make_error_response(id: i64, code: i32, message: str8) -> str8 {
    let id_s: str8 = format!("{}", id);
    let code_s: str8 = format!("{}", code);
    let p1: str8 = concat("{\"jsonrpc\":\"2.0\",\"id\":", id_s);
    let p2: str8 = concat(p1, ",\"error\":{\"code\":");
    let p3: str8 = concat(p2, code_s);
    let p4: str8 = concat(p3, ",\"message\":\"");
    let p5: str8 = concat(p4, message);
    let out: str8 = concat(p5, "\"}}");
    return out;
}

fn lsp_line(v: i32) -> i32 {
    if v > 0 {
        return v - 1;
    }
    return 0;
}

fn lsp_col(v: i32) -> i32 {
    if v > 0 {
        return v - 1;
    }
    return 0;
}

fn location_json(uri: str8, line1: i32, col1: i32) -> str8 {
    let euri: str8 = json_escape(uri);
    let out: str8 = format!(
        "{{\"uri\":\"{}\",\"range\":{{\"start\":{{\"line\":{},\"character\":{}}},\"end\":{{\"line\":{},\"character\":{}}}}}}}",
        euri, lsp_line(line1), lsp_col(col1), lsp_line(line1), lsp_col(col1)
    );
    return out;
}

fn range_json(line1: i32, col1: i32) -> str8 {
    return format!(
        "{{\"start\":{{\"line\":{},\"character\":{}}},\"end\":{{\"line\":{},\"character\":{}}}}}",
        lsp_line(line1), lsp_col(col1), lsp_line(line1), lsp_col(col1)
    );
}

fn is_ident_char(ch: str8) -> bool {
    if len(ch) != 1 { return false; }
    if contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", ch) == 1 {
        return true;
    }
    return false;
}

fn line_text_at(text: str8, line0: i64) -> str8 {
    if line0 < 0 { return String::new(); }
    let n: i64 = len(text);
    var cur: i64 = 0;
    var start: i64 = 0;
    var found_start: i32 = 0;
    for i in 0..n {
        if cur == line0 {
            start = i;
            found_start = 1;
            break;
        }
        let ch: str8 = sub(text, i, 1);
        if eq(ch, "\n") == 1 {
            cur = cur + 1;
        }
    }
    if found_start == 0 {
        if cur == line0 {
            start = n;
        } else {
            return String::new();
        }
    }
    var endi: i64 = start;
    var found_end: i32 = 0;
    for j in start..n {
        let ch: str8 = sub(text, j, 1);
        if eq(ch, "\n") == 1 { break; }
        endi = j + 1;
        found_end = 1;
    }
    if found_end == 0 {
        endi = start;
    }
    return sub(text, start, endi - start);
}

fn offset_to_line_col1(text: str8, off: i64) -> i64 {
    let n: i64 = len(text);
    var pos: i64 = off;
    if pos < 0 { pos = 0; }
    if pos > n { pos = n; }
    var line1: i64 = 1;
    var col1: i64 = 1;
    for i in 0..pos {
        let ch: str8 = sub(text, i, 1);
        if eq(ch, "\n") == 1 {
            line1 = line1 + 1;
            col1 = 1;
        } else {
            col1 = col1 + 1;
        }
    }
    return line1 * 1000000 + col1;
}

fn root_path_from_store() -> str8 {
    if ensure_text_store() != 0 { return String::new(); }
    let root_uri: str8 = text_store_get(g_text_store_handle, "__mlang_root_uri__");
    if len(root_uri) == 0 { return String::new(); }
    if starts_with(root_uri, "file://") == 1 {
        return sub(root_uri, 7, len(root_uri) - 7);
    }
    return root_uri;
}

fn path_to_file_uri(path: str8) -> str8 {
    if len(path) == 0 { return String::new(); }
    if starts_with(path, "file://") == 1 { return path; }
    return concat("file://", path);
}

fn file_uri_to_path(uri: str8) -> str8 {
    if len(uri) == 0 { return String::new(); }
    if starts_with(uri, "file://") == 1 {
        return sub(uri, 7, len(uri) - 7);
    }
    return uri;
}

fn text_for_uri(uri: str8) -> str8 {
    if len(uri) == 0 { return String::new(); }
    if ensure_text_store() == 0 {
        let cached: str8 = text_store_get(g_text_store_handle, uri);
        if len(cached) > 0 { return cached; }
    }
    let path: str8 = file_uri_to_path(uri);
    if len(path) == 0 { return String::new(); }
    let text_r: Result<str8, str8> = read_all_text(path);
    if text_r.is_err() { return String::new(); }
    return text_r.unwrap();
}

fn extern_fn_name_from_line(line_text: str8) -> str8 {
    let line_trim: str8 = trim_ascii_ws(line_text);
    if starts_with(line_trim, "extern fn ") == 0 { return String::new(); }
    let rest: str8 = sub(line_trim, 10, len(line_trim) - 10);
    let lp: i64 = find(rest, "(");
    if lp <= 0 { return String::new(); }
    return trim_ascii_ws(sub(rest, 0, lp));
}

fn extern_fn_name_at_uri_line(uri: str8, line1: i32) -> str8 {
    if line1 <= 0 { return String::new(); }
    let text: str8 = text_for_uri(uri);
    if len(text) == 0 { return String::new(); }
    let line_text: str8 = line_text_at(text, line1 - 1);
    return extern_fn_name_from_line(line_text);
}

fn extern_decl_location_in_text(path: str8, text: str8, name: str8) -> str8 {
    if len(path) == 0 { return String::new(); }
    if len(text) == 0 { return String::new(); }
    if len(name) == 0 { return String::new(); }
    return first_match_location(path, text, format!("extern fn {}(", name));
}

fn first_match_location(path: str8, text: str8, pattern: str8) -> str8 {
    let off: i64 = find(text, pattern);
    if off < 0 { return String::new(); }
    let packed: i64 = offset_to_line_col1(text, off);
    let line1: i32 = packed / 1000000;
    let col1: i32 = packed - (line1 * 1000000);
    return location_json(path_to_file_uri(path), line1, col1);
}

fn attribute_doc_location(line_text: str8) -> str8 {
    let root: str8 = root_path_from_store();
    if len(root) == 0 { return String::new(); }
    let doc_path: str8 = concat(root, "/docs/language_attributes.md");
    if file_exists(doc_path) != 1 { return String::new(); }
    let text_r: Result<str8, str8> = read_all_text(doc_path);
    if text_r.is_err() { return String::new(); }
    let text: str8 = text_r.unwrap();
    // Check longest forms first so #[inline] does not match inside #[inline(always)]
    if contains(line_text, "#[inline(always)]") == 1 {
        let loc: str8 = first_match_location(doc_path, text, "## `#[inline(always)]`");
        if len(loc) > 0 { return loc; }
    }
    if contains(line_text, "#[inline(never)]") == 1 {
        let loc: str8 = first_match_location(doc_path, text, "## `#[inline(never)]`");
        if len(loc) > 0 { return loc; }
    }
    if contains(line_text, "#[inline]") == 1 {
        let loc: str8 = first_match_location(doc_path, text, "## `#[inline]`");
        if len(loc) > 0 { return loc; }
    }
    if contains(line_text, "#[test]") == 1 {
        let loc: str8 = first_match_location(doc_path, text, "## `#[test]`");
        if len(loc) > 0 { return loc; }
    }
    if contains(line_text, "#[derive(Debug)]") == 1 {
        let loc: str8 = first_match_location(doc_path, text, "## `#[derive(Debug)]`");
        if len(loc) > 0 { return loc; }
    }
    return String::new();
}

fn runtime_builtin_location(word: str8) -> str8 {
    let root: str8 = root_path_from_store();
    if len(root) == 0 { return String::new(); }
    let docs_lang: str8 = concat(root, "/docs/language_reference.h");
    let docs_runtime: str8 = concat(root, "/docs/runtime_builtins.h");

    if file_exists(docs_lang) == 1 {
        let text_r: Result<str8, str8> = read_all_text(docs_lang);
        if text_r.is_ok() {
            let text: str8 = text_r.unwrap();
            let p1: str8 = first_match_location(docs_lang, text, word);
            if len(p1) > 0 { return p1; }
            let p2: str8 = first_match_location(docs_lang, text, format!("Mlang{}", word));
            if len(p2) > 0 { return p2; }
        }
    }

    if file_exists(docs_runtime) == 1 {
        let text_r2: Result<str8, str8> = read_all_text(docs_runtime);
        if text_r2.is_ok() {
            let text2: str8 = text_r2.unwrap();
            let p3: str8 = first_match_location(docs_runtime, text2, word);
            if len(p3) > 0 { return p3; }
            let p4: str8 = first_match_location(docs_runtime, text2, format!("mlang_{}", word));
            if len(p4) > 0 { return p4; }
        }
    }
    return String::new();
}

fn builtin_type_location(word: str8) -> str8 {
    if len(word) == 0 { return String::new(); }
    var lookup: str8 = word;
    if eq(lookup, "String") == 1 {
        lookup = "str8";
    }
    if eq(lookup, "string") == 1 {
        lookup = "str8";
    }
    if eq(lookup, "int") == 1 {
        lookup = "i32";
    }
    let root: str8 = root_path_from_store();
    let here: str8 = cwd();
    var p1: str8 = String::new();
    var p2: str8 = String::new();
    var p3: str8 = concat(here, "/stdlib/types.mla");
    var p4: str8 = concat(here, "/types.mla");
    if len(root) > 0 {
        p1 = concat(root, "/stdlib/types.mla");
        p2 = concat(root, "/types.mla");
    }

    var path: str8 = String::new();
    if len(path) == 0 {
        if len(p1) > 0 {
            if file_exists(p1) == 1 {
                path = p1;
            }
        }
    }
    if len(path) == 0 {
        if len(p2) > 0 {
            if file_exists(p2) == 1 {
                path = p2;
            }
        }
    }
    if len(path) == 0 {
        if file_exists(p3) == 1 {
            path = p3;
        }
    }
    if len(path) == 0 {
        if file_exists(p4) == 1 {
            path = p4;
        }
    }
    if len(path) == 0 { return String::new(); }

    let text_r: Result<str8, str8> = read_all_text(path);
    if text_r.is_err() { return String::new(); }
    let text: str8 = text_r.unwrap();
    let marker: str8 = format!("@builtin {}", lookup);
    return first_match_location(path, text, marker);
}

fn builtin_result_method_location(member: str8) -> str8 {
    if eq(member, "is_ok") != 1 {
        if eq(member, "is_err") != 1 {
            if eq(member, "unwrap") != 1 {
                if eq(member, "unwrap_err") != 1 {
                    return String::new();
                }
            }
        }
    }

    let root: str8 = root_path_from_store();
    let here: str8 = cwd();
    var p1: str8 = String::new();
    var p2: str8 = String::new();
    var p3: str8 = concat(here, "/stdlib/types.mla");
    var p4: str8 = concat(here, "/types.mla");
    if len(root) > 0 {
        p1 = concat(root, "/stdlib/types.mla");
        p2 = concat(root, "/types.mla");
    }

    var path: str8 = String::new();
    if len(path) == 0 {
        if len(p1) > 0 {
            if file_exists(p1) == 1 { path = p1; }
        }
    }
    if len(path) == 0 {
        if len(p2) > 0 {
            if file_exists(p2) == 1 { path = p2; }
        }
    }
    if len(path) == 0 {
        if file_exists(p3) == 1 { path = p3; }
    }
    if len(path) == 0 {
        if file_exists(p4) == 1 { path = p4; }
    }
    if len(path) == 0 { return String::new(); }

    // Builtin Result docs live in stdlib/types.mla around line 90.
    return location_json(path_to_file_uri(path), 90, 1);
}

fn string_intrinsic_location(member: str8) -> str8 {
    var target: str8 = String::new();
    if eq(member, "new") == 1 { target = "new"; }
    if eq(member, "with_capacity") == 1 { target = "with_capacity"; }
    if eq(member, "from") == 1 { target = "from"; }
    if eq(member, "free") == 1 { target = "free"; }
    if len(target) == 0 { return String::new(); }

    let root: str8 = root_path_from_store();
    var p1: str8 = String::new();
    var p2: str8 = String::new();
    if len(root) > 0 {
        p1 = concat(root, "/stdlib/std/strbuf.mla");
        p2 = concat(root, "/std/strbuf.mla");
    }

    var path: str8 = String::new();
    if len(p1) > 0 {
        if file_exists(p1) == 1 {
            path = p1;
        }
    }
    if len(path) == 0 {
        if len(p2) > 0 {
            if file_exists(p2) == 1 {
                path = p2;
            }
        }
    }
    if len(path) == 0 {
        let here: str8 = cwd();
        let p3: str8 = concat(here, "/stdlib/std/strbuf.mla");
        if file_exists(p3) == 1 {
            path = p3;
        }
    }
    if len(path) == 0 {
        // String::from is compiler intrinsic lowered via __mlang_std_strbuf_clone.
        if eq(target, "from") == 1 {
            let root2: str8 = root_path_from_store();
            let here2: str8 = cwd();
            var dpath: str8 = String::new();
            if len(root2) > 0 {
                let d1: str8 = concat(root2, "/stdlib/std/strbuf/detail.mla");
                if file_exists(d1) == 1 { dpath = d1; }
            }
            if len(dpath) == 0 {
                if len(root2) > 0 {
                    let d2: str8 = concat(root2, "/std/strbuf/detail.mla");
                    if file_exists(d2) == 1 { dpath = d2; }
                }
            }
            if len(dpath) == 0 {
                let d3: str8 = concat(here2, "/stdlib/std/strbuf/detail.mla");
                if file_exists(d3) == 1 { dpath = d3; }
            }
            if len(dpath) > 0 {
                let dtext_r: Result<str8, str8> = read_all_text(dpath);
                if dtext_r.is_ok() {
                    let dtext: str8 = dtext_r.unwrap();
                    let dloc: str8 = first_match_location(dpath, dtext, "extern fn __mlang_std_strbuf_clone(");
                    if len(dloc) > 0 { return dloc; }
                }
            }
        }
        return String::new();
    }

    let text_r: Result<str8, str8> = read_all_text(path);
    if text_r.is_err() { return String::new(); }
    let text: str8 = text_r.unwrap();
    let pat: str8 = format!("pub fn {}", target);
    let loc: str8 = first_match_location(path, text, pat);
    if len(loc) > 0 { return loc; }

    if eq(target, "from") == 1 {
        let root2: str8 = root_path_from_store();
        let here2: str8 = cwd();
        var dpath2: str8 = String::new();
        if len(root2) > 0 {
            let d1b: str8 = concat(root2, "/stdlib/std/strbuf/detail.mla");
            if file_exists(d1b) == 1 { dpath2 = d1b; }
        }
        if len(dpath2) == 0 {
            if len(root2) > 0 {
                let d2b: str8 = concat(root2, "/std/strbuf/detail.mla");
                if file_exists(d2b) == 1 { dpath2 = d2b; }
            }
        }
        if len(dpath2) == 0 {
            let d3b: str8 = concat(here2, "/stdlib/std/strbuf/detail.mla");
            if file_exists(d3b) == 1 { dpath2 = d3b; }
        }
        if len(dpath2) > 0 {
            let dtext_r2: Result<str8, str8> = read_all_text(dpath2);
            if dtext_r2.is_ok() {
                let dtext2: str8 = dtext_r2.unwrap();
                let dloc2: str8 = first_match_location(dpath2, dtext2, "extern fn __mlang_std_strbuf_clone(");
                if len(dloc2) > 0 { return dloc2; }
            }
        }
    }
    return String::new();
}

fn associated_type_method_location(query_text: str8, type_name: str8, method: str8) -> str8 {
    if len(query_text) == 0 { return String::new(); }
    if len(type_name) == 0 { return String::new(); }
    if len(method) == 0 { return String::new(); }

    let type_base: str8 = base_type_name(type_name);
    if eq(type_base, "TcpListener") == 1 || eq(type_base, "TcpStream") == 1 {
        let net_path: str8 = module_file_path("std::net");
        if len(net_path) > 0 {
            let net_text_r: Result<str8, str8> = read_all_text(net_path);
            if net_text_r.is_ok() {
                let net_text: str8 = net_text_r.unwrap();
                let net_loc: str8 = first_match_location(net_path, net_text, format!("fn {}(", method));
                if len(net_loc) > 0 { return net_loc; }
            }
        }
    }

    var type_mod: str8 = find_module_for_qualifier(query_text, type_base);
    if len(type_mod) == 0 {
        type_mod = module_for_type_in_scope(query_text, type_base);
    }
    if len(type_mod) == 0 { return String::new(); }

    let path: str8 = module_file_path(type_mod);
    if len(path) == 0 { return String::new(); }

    let text_r: Result<str8, str8> = read_all_text(path);
    if text_r.is_err() { return String::new(); }
    let text: str8 = text_r.unwrap();
    return first_match_location(path, text, format!("fn {}(", method));
}

fn std_net_method_location(method: str8) -> str8 {
    if len(method) == 0 { return String::new(); }
    let p: str8 = module_file_path("std::net");
    if len(p) == 0 { return String::new(); }
    let tr: Result<str8, str8> = read_all_text(p);
    if tr.is_err() { return String::new(); }
    let t: str8 = tr.unwrap();
    return first_match_location(p, t, format!("fn {}(", method));
}

fn thread_intrinsic_location(name: str8) -> str8 {
    if eq(name, "thread_spawn") == 0 &&
       eq(name, "thread_join") == 0 &&
       eq(name, "mutex_create") == 0 &&
       eq(name, "mutex_lock") == 0 &&
       eq(name, "mutex_unlock") == 0 &&
       eq(name, "mutex_destroy") == 0 &&
       eq(name, "atomic_i64_new") == 0 &&
       eq(name, "atomic_i64_load") == 0 &&
       eq(name, "atomic_i64_store") == 0 &&
       eq(name, "atomic_i64_add") == 0 &&
       eq(name, "atomic_i64_free") == 0 {
        return String::new();
    }

    let root: str8 = root_path_from_store();
    let here: str8 = cwd();
    var path: str8 = String::new();
    if len(root) > 0 {
        let p1: str8 = concat(root, "/stdlib/std/thread/detail.mla");
        if file_exists(p1) == 1 { path = p1; }
    }
    if len(path) == 0 {
        let p2: str8 = concat(here, "/stdlib/std/thread/detail.mla");
        if file_exists(p2) == 1 { path = p2; }
    }
    if len(path) == 0 { return String::new(); }

    let text_r: Result<str8, str8> = read_all_text(path);
    if text_r.is_err() { return String::new(); }
    let text: str8 = text_r.unwrap();
    return first_match_location(path, text, format!("extern fn {}(", name));
}

/// @brief Replace all "::" occurrences with "/" for module-to-path conversion.
fn colon_to_slash(s: str8) -> str8 {
    var result: str8 = String::new();
    var remaining: str8 = s;
    for i in 0..50 {
        let idx: i64 = find(remaining, "::");
        if idx < 0 { break; }
        result = concat(result, sub(remaining, 0, idx));
        result = concat(result, "/");
        let tail_len: i64 = len(remaining) - idx - 2;
        remaining = sub(remaining, idx + 2, tail_len);
    }
    result = concat(result, remaining);
    return result;
}

/// @brief Trim leading/trailing ASCII spaces and tabs.
fn trim_ascii_ws(s: str8) -> str8 {
    var start: i64 = 0;
    var end: i64 = len(s);
    for _i in 0..5000 {
        if start >= end { break; }
        let ch: str8 = sub(s, start, 1);
        if eq(ch, " ") == 1 || eq(ch, "\t") == 1 {
            start = start + 1;
        } else {
            break;
        }
    }
    for _j in 0..5000 {
        if end <= start { break; }
        let ch2: str8 = sub(s, end - 1, 1);
        if eq(ch2, " ") == 1 || eq(ch2, "\t") == 1 {
            end = end - 1;
        } else {
            break;
        }
    }
    if end <= start { return String::new(); }
    return sub(s, start, end - start);
}

/// @brief Resolve a module name (e.g. "std::thread") to a file:// URI at line 1.
/// Returns empty string when the file cannot be found.
fn module_file_location(module_name: str8) -> str8 {
    let modn: str8 = trim_ascii_ws(module_name);
    if len(modn) == 0 { return String::new(); }
    let rel_path: str8 = colon_to_slash(modn);
    let root: str8 = root_path_from_store();
    let here: str8 = cwd();
    var path: str8 = String::new();
    if len(root) > 0 {
        let p1: str8 = format!("{}/stdlib/{}.mla", root, rel_path);
        if file_exists(p1) == 1 { path = p1; }
    }
    if len(path) == 0 {
        if len(root) > 0 {
            let p2: str8 = format!("{}/{}.mla", root, rel_path);
            if file_exists(p2) == 1 { path = p2; }
        }
    }
    if len(path) == 0 {
        let p3: str8 = format!("{}/stdlib/{}.mla", here, rel_path);
        if file_exists(p3) == 1 { path = p3; }
    }
    if len(path) == 0 {
        let p4: str8 = format!("{}/{}.mla", here, rel_path);
        if file_exists(p4) == 1 { path = p4; }
    }
    if len(path) == 0 { return String::new(); }
    return location_json(path_to_file_uri(path), 1, 1);
}

fn module_file_path(module_name: str8) -> str8 {
    let modn: str8 = trim_ascii_ws(module_name);
    if len(modn) == 0 { return String::new(); }
    let rel_path: str8 = colon_to_slash(modn);
    let root: str8 = root_path_from_store();
    let here: str8 = cwd();
    var path: str8 = String::new();
    if len(root) > 0 {
        let p1: str8 = format!("{}/stdlib/{}.mla", root, rel_path);
        if file_exists(p1) == 1 { path = p1; }
    }
    if len(path) == 0 {
        if len(root) > 0 {
            let p2: str8 = format!("{}/{}.mla", root, rel_path);
            if file_exists(p2) == 1 { path = p2; }
        }
    }
    if len(path) == 0 {
        let p3: str8 = format!("{}/stdlib/{}.mla", here, rel_path);
        if file_exists(p3) == 1 { path = p3; }
    }
    if len(path) == 0 {
        let p4: str8 = format!("{}/{}.mla", here, rel_path);
        if file_exists(p4) == 1 { path = p4; }
    }
    return path;
}

/// @brief Extract module name from a "use mod::path::*;" or "use mod::path::Item;" line.
fn use_line_module_name(line_text: str8) -> str8 {
    let line: str8 = trim_ascii_ws(line_text);
    if starts_with(line, "use ") == 0 { return String::new(); }
    let rest0: str8 = sub(line, 4, len(line) - 4);
    var end: i64 = len(rest0);
    let semi: i64 = find(rest0, ";");
    if semi >= 0 { end = semi; }
    let rest: str8 = trim_ascii_ws(sub(rest0, 0, end));
    if ends_with(rest, "::*") == 1 {
        return sub(rest, 0, len(rest) - 3);
    }
    // Prefer full-path module imports ("use std::thread::detail;") when the
    // target module file exists.
    if len(module_file_location(rest)) > 0 {
        return rest;
    }
    let last_sep: i64 = rfind(rest, "::");
    if last_sep < 0 { return rest; }
    return sub(rest, 0, last_sep);
}

/// @brief Extract module name from a "mod std::thread;" line.
fn mod_line_module_name(line_text: str8) -> str8 {
    let line: str8 = trim_ascii_ws(line_text);
    if starts_with(line, "mod ") == 0 { return String::new(); }
    let rest0: str8 = sub(line, 4, len(line) - 4);
    let semi: i64 = find(rest0, ";");
    if semi >= 0 { return trim_ascii_ws(sub(rest0, 0, semi)); }
    return trim_ascii_ws(rest0);
}

/// @brief Given a bare module qualifier word (e.g. "thread" from "thread::join()"),
/// scan the file text for a matching use/mod declaration and return the full module
/// name (e.g. "std::thread"), or empty string if not found.
fn find_module_for_qualifier(text: str8, word: str8) -> str8 {
    if len(word) == 0 { return String::new(); }
    let n: i64 = len(text);
    var cur: i64 = 0;
    for _i in 0..5000 {
        if cur >= n { break; }
        let rem: str8 = sub(text, cur, n - cur);
        let nl: i64 = find(rem, "\n");
        var llen: i64 = len(rem);
        if nl >= 0 { llen = nl; }
        let line: str8 = sub(rem, 0, llen);
        cur = cur + llen + 1;
        var mod_name: str8 = String::new();
        let line_t: str8 = trim_ascii_ws(line);
        if starts_with(line_t, "use ") == 1 {
            // Resolve imported symbols, e.g.:
            //   use std::net::TcpListener;  => TcpListener -> std::net
            // Wildcard imports are intentionally not used for qualifier mapping
            // because they do not declare a concrete qualifier symbol.
            let rest0: str8 = sub(line_t, 4, len(line_t) - 4);
            var end: i64 = len(rest0);
            let semi: i64 = find(rest0, ";");
            if semi >= 0 { end = semi; }
            let rest: str8 = trim_ascii_ws(sub(rest0, 0, end));
            let use_sep: i64 = rfind(rest, "::");
            if use_sep >= 0 {
                let imported_name: str8 = sub(rest, use_sep + 2, len(rest) - use_sep - 2);
                if eq(imported_name, word) == 1 {
                    return sub(rest, 0, use_sep);
                }
            }
            mod_name = use_line_module_name(line_t);
        }
        if starts_with(line_t, "mod ") == 1 {
            mod_name = mod_line_module_name(line_t);
        }
        if len(mod_name) > 0 {
            let lsep: i64 = rfind(mod_name, "::");
            var last_part: str8 = mod_name;
            if lsep >= 0 {
                last_part = sub(mod_name, lsep + 2, len(mod_name) - lsep - 2);
            }
            if eq(last_part, word) == 1 { return mod_name; }
        }
    }
    return String::new();
}

fn module_for_type_in_scope(text: str8, type_name: str8) -> str8 {
    if len(text) == 0 { return String::new(); }
    if len(type_name) == 0 { return String::new(); }
    let n: i64 = line_count(text);
    for i in 0..n {
        let raw: str8 = line_text_at(text, i);
        let line_t: str8 = trim_ascii_ws(raw);
        var modn: str8 = String::new();
        if starts_with(line_t, "use ") == 1 {
            modn = use_line_module_name(line_t);
        }
        if starts_with(line_t, "mod ") == 1 {
            modn = mod_line_module_name(line_t);
        }
        if len(modn) == 0 { continue; }
        let p: str8 = module_file_path(modn);
        if len(p) == 0 { continue; }
        let tr: Result<str8, str8> = read_all_text(p);
        if tr.is_err() { continue; }
        let t: str8 = tr.unwrap();
        if contains(t, format!("impl {}", type_name)) == 1 { return modn; }
        if contains(t, format!("struct {}", type_name)) == 1 { return modn; }
        if contains(t, format!("enum {}", type_name)) == 1 { return modn; }
    }
    return String::new();
}

fn dot_call_receiver_name(line_text: str8, member: str8) -> str8 {
    if len(line_text) == 0 { return String::new(); }
    if len(member) == 0 { return String::new(); }
    let pat: str8 = format!(".{}(", member);
    let dot_at: i64 = find(line_text, pat);
    if dot_at <= 0 { return String::new(); }

    let left_end: i64 = dot_at;
    var start: i64 = left_end;
    for i in 0..left_end {
        let pos: i64 = left_end - i - 1;
        let ch: str8 = sub(line_text, pos, 1);
        if is_ident_char(ch) == 1 {
            start = pos;
            continue;
        }
        break;
    }
    if start >= left_end { return String::new(); }
    return sub(line_text, start, left_end - start);
}

fn static_call_receiver_name(line_text: str8, member: str8) -> str8 {
    if len(line_text) == 0 { return String::new(); }
    if len(member) == 0 { return String::new(); }
    let pat: str8 = format!("::{}(", member);
    let pos: i64 = find(line_text, pat);
    if pos <= 0 { return String::new(); }
    let left_end: i64 = pos;
    var start: i64 = left_end;
    for i in 0..left_end {
        let p: i64 = left_end - i - 1;
        let ch: str8 = sub(line_text, p, 1);
        if is_ident_char(ch) == 1 {
            start = p;
            continue;
        }
        break;
    }
    if start >= left_end { return String::new(); }
    return sub(line_text, start, left_end - start);
}

fn first_static_call_pair(line_text: str8) -> str8 {
    let lp: i64 = find(line_text, "(");
    if lp < 0 { return "::"; }
    let left: str8 = sub(line_text, 0, lp);
    let sep: i64 = rfind(left, "::");
    if sep <= 0 { return "::"; }
    let method: str8 = trim_ascii_ws(sub(left, sep + 2, len(left) - sep - 2));
    if len(method) == 0 { return "::"; }
    var qend: i64 = sep;
    for i in 0..sep {
        let p: i64 = sep - i - 1;
        let ch: str8 = sub(left, p, 1);
        if eq(ch, " ") == 1 || eq(ch, "\t") == 1 {
            qend = p;
            continue;
        }
        break;
    }
    var qstart: i64 = qend;
    let qend0: i64 = qend;
    for i in 0..qend0 {
        let p: i64 = qend0 - i - 1;
        let ch: str8 = sub(left, p, 1);
        if is_ident_char(ch) == 1 {
            qstart = p;
            continue;
        }
        break;
    }
    if qend <= qstart { return "::"; }
    let recv: str8 = sub(left, qstart, qend - qstart);
    if len(recv) == 0 { return "::"; }
    return format!("{}::{}", recv, method);
}

fn first_dot_call_pair(line_text: str8) -> str8 {
    let lp: i64 = find(line_text, "(");
    if lp < 0 { return "::"; }
    let left: str8 = sub(line_text, 0, lp);
    let dot: i64 = rfind(left, ".");
    if dot <= 0 { return "::"; }
    let method: str8 = trim_ascii_ws(sub(left, dot + 1, len(left) - dot - 1));
    if len(method) == 0 { return "::"; }
    var qend: i64 = dot;
    for i in 0..dot {
        let p: i64 = dot - i - 1;
        let ch: str8 = sub(left, p, 1);
        if eq(ch, " ") == 1 || eq(ch, "\t") == 1 {
            qend = p;
            continue;
        }
        break;
    }
    var qstart: i64 = qend;
    let qend0: i64 = qend;
    for i in 0..qend0 {
        let p: i64 = qend0 - i - 1;
        let ch: str8 = sub(left, p, 1);
        if is_ident_char(ch) == 1 {
            qstart = p;
            continue;
        }
        break;
    }
    if qend <= qstart { return "::"; }
    let recv: str8 = sub(left, qstart, qend - qstart);
    if len(recv) == 0 { return "::"; }
    return format!("{}::{}", recv, method);
}

fn local_binding_type(text: str8, name: str8) -> str8 {
    if len(text) == 0 { return String::new(); }
    if len(name) == 0 { return String::new(); }

    let n: i64 = line_count(text);
    for i in 0..n {
        let raw: str8 = line_text_at(text, i);
        let line: str8 = trim_ascii_ws(raw);
        if starts_with(line, "let ") == 0 {
            if starts_with(line, "var ") == 0 {
                continue;
            }
        }
        let rest: str8 = sub(line, 4, len(line) - 4);
        let c: i64 = find(rest, ":");
        if c < 0 { continue; }

        let lhs: str8 = trim_ascii_ws(sub(rest, 0, c));
        if eq(lhs, name) != 1 { continue; }

        var ty: str8 = trim_ascii_ws(sub(rest, c + 1, len(rest) - c - 1));
        let eqi: i64 = find(ty, "=");
        if eqi >= 0 {
            ty = trim_ascii_ws(sub(ty, 0, eqi));
        }
        return ty;
    }
    // Infer `let x = y.unwrap();` from `y: Result<T, E>`.
    for i in 0..n {
        let raw: str8 = line_text_at(text, i);
        let line: str8 = trim_ascii_ws(raw);
        if starts_with(line, "let ") == 0 {
            if starts_with(line, "var ") == 0 {
                continue;
            }
        }
        let rest: str8 = sub(line, 4, len(line) - 4);
        let eqi: i64 = find(rest, "=");
        if eqi < 0 { continue; }
        let lhs: str8 = trim_ascii_ws(sub(rest, 0, eqi));
        if eq(lhs, name) != 1 { continue; }
        let rhs: str8 = trim_ascii_ws(sub(rest, eqi + 1, len(rest) - eqi - 1));
        let uat: i64 = find(rhs, ".unwrap()");
        if uat <= 0 { continue; }
        let src: str8 = trim_ascii_ws(sub(rhs, 0, uat));
        if len(src) == 0 { continue; }
        if eq(src, name) == 1 { continue; }
        let src_ty: str8 = local_binding_type(text, src);
        if starts_with(src_ty, "Result<") == 1 {
            let inner: str8 = sub(src_ty, 7, len(src_ty) - 7);
            let comma: i64 = find(inner, ",");
            if comma > 0 {
                return trim_ascii_ws(sub(inner, 0, comma));
            }
        }
    }
    return String::new();
}

fn base_type_name(type_text: str8) -> str8 {
    let t: str8 = trim_ascii_ws(type_text);
    if len(t) == 0 { return String::new(); }
    let lt: i64 = find(t, "<");
    if lt > 0 {
        return trim_ascii_ws(sub(t, 0, lt));
    }
    return t;
}

/// @brief Resolve module import definition from a single source line.
fn module_import_location_from_line(line_text: str8) -> str8 {
    let line_trim: str8 = trim_ascii_ws(line_text);
    if starts_with(line_trim, "use ") == 1 {
        let use_mod: str8 = use_line_module_name(line_trim);
        if len(use_mod) > 0 {
            return module_file_location(use_mod);
        }
    }
    if starts_with(line_trim, "mod ") == 1 {
        let mod_n: str8 = mod_line_module_name(line_trim);
        if len(mod_n) > 0 {
            return module_file_location(mod_n);
        }
    }
    return String::new();
}

fn c_type_target(word: str8) -> str8 {
    if eq(word, "i8") == 1 { return "int8_t"; }
    if eq(word, "i16") == 1 { return "int16_t"; }
    if eq(word, "i32") == 1 { return "int32_t"; }
    if eq(word, "i64") == 1 { return "int64_t"; }
    if eq(word, "u8") == 1 { return "uint8_t"; }
    if eq(word, "u16") == 1 { return "uint16_t"; }
    if eq(word, "u32") == 1 { return "uint32_t"; }
    if eq(word, "u64") == 1 { return "uint64_t"; }
    if eq(word, "i32") == 1 { return "int32_t"; }
    if eq(word, "bool") == 1 { return "bool"; }
    if eq(word, "f32") == 1 { return "mlang_float"; }
    if eq(word, "f64") == 1 { return "mlang_double"; }
    if eq(word, "f32") == 1 { return "mlang_float"; }
    if eq(word, "f64") == 1 { return "mlang_double"; }
    if eq(word, "string") == 1 { return "mlang_string"; }
    if eq(word, "str8") == 1 { return "mlang_str8"; }
    if eq(word, "str16") == 1 { return "mlang_str16"; }
    return String::new();
}

fn symbol_location_in_c_file(path: str8, symbol: str8) -> str8 {
    if len(path) == 0 { return String::new(); }
    if file_exists(path) != 1 { return String::new(); }
    let text_r: Result<str8, str8> = read_all_text(path);
    if text_r.is_err() { return String::new(); }
    let text: str8 = text_r.unwrap();
    return first_match_location(path, text, symbol);
}

fn c_extern_binding_location(symbol: str8) -> str8 {
    if starts_with(symbol, "__mlang_") == 0 { return String::new(); }

    let root: str8 = root_path_from_store();
    let here: str8 = cwd();
    var loc: str8 = String::new();

    if starts_with(symbol, "__mlang_compiler_") == 1 {
        if len(root) > 0 {
            loc = symbol_location_in_c_file(concat(root, "/src/compiler_api.cpp"), symbol);
            if len(loc) > 0 { return loc; }
        }
        loc = symbol_location_in_c_file(concat(here, "/src/compiler_api.cpp"), symbol);
        if len(loc) > 0 { return loc; }
    }

    if starts_with(symbol, "__mlang_std_compiler_") == 1 {
        if len(root) > 0 {
            loc = symbol_location_in_c_file(concat(root, "/stdlib/src/std_compiler_api.cpp"), symbol);
            if len(loc) > 0 { return loc; }
        }
        loc = symbol_location_in_c_file(concat(here, "/stdlib/src/std_compiler_api.cpp"), symbol);
        if len(loc) > 0 { return loc; }
    }

    if starts_with(symbol, "__mlang_std_") == 1 {
        let rest: str8 = sub(symbol, 12, len(symbol) - 12);
        let us: i64 = find(rest, "_");
        var module_name: str8 = rest;
        if us >= 0 {
            module_name = sub(rest, 0, us);
        }
        if len(module_name) > 0 {
            if len(root) > 0 {
                loc = symbol_location_in_c_file(concat(root, format!("/stdlib/src/std_{}.c", module_name)), symbol);
                if len(loc) > 0 { return loc; }
                loc = symbol_location_in_c_file(concat(root, format!("/stdlib/src/std_{}.cpp", module_name)), symbol);
                if len(loc) > 0 { return loc; }
            }
            loc = symbol_location_in_c_file(concat(here, format!("/stdlib/src/std_{}.c", module_name)), symbol);
            if len(loc) > 0 { return loc; }
            loc = symbol_location_in_c_file(concat(here, format!("/stdlib/src/std_{}.cpp", module_name)), symbol);
            if len(loc) > 0 { return loc; }
        }
    }

    return String::new();
}

fn c_internals_location(word: str8) -> str8 {
    let extern_loc: str8 = c_extern_binding_location(word);
    if len(extern_loc) > 0 { return extern_loc; }

    let target: str8 = c_type_target(word);
    if len(target) == 0 { return String::new(); }

    let root: str8 = root_path_from_store();
    let here: str8 = cwd();
    var p1: str8 = String::new();
    var p2: str8 = String::new();
    var p3: str8 = String::new();
    var p4: str8 = String::new();
    var p5: str8 = String::new();
    var p6: str8 = String::new();
    if len(root) > 0 {
        p1 = concat(root, "/include/mlang_c_types.h");
        p2 = concat(root, "/docs/runtime_builtins.h");
        p5 = concat(root, "/mlang_c_types.h");
    }
    p3 = concat(here, "/include/mlang_c_types.h");
    p4 = concat(here, "/docs/runtime_builtins.h");
    p6 = concat(here, "/mlang_c_types.h");

    var path: str8 = String::new();
    if len(path) == 0 {
        if len(p1) > 0 {
            if file_exists(p1) == 1 {
                path = p1;
            }
        }
    }
    if len(path) == 0 {
        if len(p3) > 0 {
            if file_exists(p3) == 1 {
                path = p3;
            }
        }
    }
    if len(path) == 0 {
        if len(p5) > 0 {
            if file_exists(p5) == 1 {
                path = p5;
            }
        }
    }
    if len(path) == 0 {
        if len(p6) > 0 {
            if file_exists(p6) == 1 {
                path = p6;
            }
        }
    }
    if len(path) > 0 {
        let text_r: Result<str8, str8> = read_all_text(path);
        if text_r.is_ok() {
            let text: str8 = text_r.unwrap();
            let tloc: str8 = first_match_location(path, text, target);
            if len(tloc) > 0 { return tloc; }
        }
    }

    if starts_with(target, "mlang_") == 0 {
        var hname: str8 = "stdint.h";
        if eq(target, "bool") == 1 {
            hname = "stdbool.h";
        }
        var hp1: str8 = String::new();
        var hp2: str8 = String::new();
        var hp3: str8 = "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/include/";
        var hp4: str8 = "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/include/";
        var hp5: str8 = "/usr/include/";
        if len(root) > 0 {
            hp1 = concat(root, "/");
        }
        hp2 = concat(here, "/");

        var hpath: str8 = String::new();
        let c1: str8 = concat(hp1, hname);
        if file_exists(c1) == 1 { hpath = c1; }
        if len(hpath) == 0 {
            let c2: str8 = concat(hp2, hname);
            if file_exists(c2) == 1 { hpath = c2; }
        }
        if len(hpath) == 0 {
            let c3: str8 = concat(hp3, hname);
            if file_exists(c3) == 1 { hpath = c3; }
        }
        if len(hpath) == 0 {
            let c4: str8 = concat(hp4, hname);
            if file_exists(c4) == 1 { hpath = c4; }
        }
        if len(hpath) == 0 {
            let c5: str8 = concat(hp5, hname);
            if file_exists(c5) == 1 { hpath = c5; }
        }
        if len(hpath) > 0 {
            let htext_r: Result<str8, str8> = read_all_text(hpath);
            if htext_r.is_ok() {
                let htext: str8 = htext_r.unwrap();
                let hloc: str8 = first_match_location(hpath, htext, target);
                if len(hloc) > 0 { return hloc; }
            }
        }

        var srcp1: str8 = String::new();
        var srcp2: str8 = String::new();
        var srcp3: str8 = String::new();
        if len(root) > 0 {
            srcp1 = concat(root, "/stdlib/src/std_math.c");
            srcp2 = concat(root, "/stdlib/src/std_strbuf.c");
        }
        srcp3 = concat(here, "/stdlib/src/std_math.c");

        var spath: str8 = String::new();
        if len(srcp1) > 0 {
            if file_exists(srcp1) == 1 { spath = srcp1; }
        }
        if len(spath) == 0 {
            if len(srcp3) > 0 {
                if file_exists(srcp3) == 1 { spath = srcp3; }
            }
        }
        if len(spath) == 0 {
            if len(srcp2) > 0 {
                if file_exists(srcp2) == 1 { spath = srcp2; }
            }
        }
        if len(spath) > 0 {
            let stext_r: Result<str8, str8> = read_all_text(spath);
            if stext_r.is_ok() {
                let stext: str8 = stext_r.unwrap();
                let sloc: str8 = first_match_location(spath, stext, target);
                if len(sloc) > 0 { return sloc; }
            }
        }
        return String::new();
    }

    path = String::new();
    if len(path) == 0 {
        if len(p2) > 0 {
            if file_exists(p2) == 1 {
                path = p2;
            }
        }
    }
    if len(path) == 0 {
        if len(p4) > 0 {
            if file_exists(p4) == 1 {
                path = p4;
            }
        }
    }
    if len(path) > 0 {
        let text2_r: Result<str8, str8> = read_all_text(path);
        if text2_r.is_ok() {
            let text2: str8 = text2_r.unwrap();
            let tloc2: str8 = first_match_location(path, text2, target);
            if len(tloc2) > 0 { return tloc2; }
        }
    }
    return String::new();
}

fn is_known_c_stdlib_symbol(name: str8) -> i32 {
    if len(name) == 0 { return 0; }
    if eq(name, "fopen") == 1 { return 1; }
    if eq(name, "freopen") == 1 { return 1; }
    if eq(name, "fdopen") == 1 { return 1; }
    if eq(name, "fclose") == 1 { return 1; }
    if eq(name, "fflush") == 1 { return 1; }
    if eq(name, "fgets") == 1 { return 1; }
    if eq(name, "fputs") == 1 { return 1; }
    if eq(name, "fread") == 1 { return 1; }
    if eq(name, "fwrite") == 1 { return 1; }
    if eq(name, "fprintf") == 1 { return 1; }
    if eq(name, "printf") == 1 { return 1; }
    if eq(name, "snprintf") == 1 { return 1; }
    if eq(name, "sprintf") == 1 { return 1; }
    if eq(name, "scanf") == 1 { return 1; }
    if eq(name, "sscanf") == 1 { return 1; }
    if eq(name, "puts") == 1 { return 1; }
    if eq(name, "putchar") == 1 { return 1; }
    if eq(name, "getchar") == 1 { return 1; }
    if eq(name, "perror") == 1 { return 1; }
    if eq(name, "malloc") == 1 { return 1; }
    if eq(name, "calloc") == 1 { return 1; }
    if eq(name, "realloc") == 1 { return 1; }
    if eq(name, "free") == 1 { return 1; }
    if eq(name, "abort") == 1 { return 1; }
    if eq(name, "exit") == 1 { return 1; }
    if eq(name, "atoi") == 1 { return 1; }
    if eq(name, "atol") == 1 { return 1; }
    if eq(name, "atoll") == 1 { return 1; }
    if eq(name, "strtol") == 1 { return 1; }
    if eq(name, "strtoll") == 1 { return 1; }
    if eq(name, "strtoul") == 1 { return 1; }
    if eq(name, "strtoull") == 1 { return 1; }
    if eq(name, "strtod") == 1 { return 1; }
    if eq(name, "strtof") == 1 { return 1; }
    if eq(name, "strlen") == 1 { return 1; }
    if eq(name, "strcmp") == 1 { return 1; }
    if eq(name, "strncmp") == 1 { return 1; }
    if eq(name, "strcpy") == 1 { return 1; }
    if eq(name, "strncpy") == 1 { return 1; }
    if eq(name, "strcat") == 1 { return 1; }
    if eq(name, "strncat") == 1 { return 1; }
    if eq(name, "strchr") == 1 { return 1; }
    if eq(name, "strrchr") == 1 { return 1; }
    if eq(name, "strstr") == 1 { return 1; }
    if eq(name, "memcpy") == 1 { return 1; }
    if eq(name, "memmove") == 1 { return 1; }
    if eq(name, "memset") == 1 { return 1; }
    if eq(name, "memcmp") == 1 { return 1; }
    if eq(name, "open") == 1 { return 1; }
    if eq(name, "close") == 1 { return 1; }
    if eq(name, "read") == 1 { return 1; }
    if eq(name, "write") == 1 { return 1; }
    if eq(name, "lseek") == 1 { return 1; }
    if eq(name, "unlink") == 1 { return 1; }
    if eq(name, "stat") == 1 { return 1; }
    if eq(name, "fstat") == 1 { return 1; }
    if eq(name, "mkdir") == 1 { return 1; }
    if eq(name, "rmdir") == 1 { return 1; }
    if eq(name, "cos") == 1 { return 1; }
    if eq(name, "cosf") == 1 { return 1; }
    if eq(name, "cosl") == 1 { return 1; }
    if eq(name, "sin") == 1 { return 1; }
    if eq(name, "sinf") == 1 { return 1; }
    if eq(name, "sinl") == 1 { return 1; }
    if eq(name, "tan") == 1 { return 1; }
    if eq(name, "tanf") == 1 { return 1; }
    if eq(name, "tanl") == 1 { return 1; }
    if eq(name, "acos") == 1 { return 1; }
    if eq(name, "asin") == 1 { return 1; }
    if eq(name, "atan") == 1 { return 1; }
    if eq(name, "atan2") == 1 { return 1; }
    if eq(name, "sqrt") == 1 { return 1; }
    if eq(name, "sqrtf") == 1 { return 1; }
    if eq(name, "sqrtl") == 1 { return 1; }
    if eq(name, "pow") == 1 { return 1; }
    if eq(name, "powf") == 1 { return 1; }
    if eq(name, "powl") == 1 { return 1; }
    if eq(name, "exp") == 1 { return 1; }
    if eq(name, "log") == 1 { return 1; }
