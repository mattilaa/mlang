/// \file main.mla
/// \brief Native MLang implementation of package manager frontend/backend.
///
/// Usage:
///   mlang-pkg-mla [--backend <mlang_bin>] [--config <manifest>] <init|add|fetch|build|clean> [args...]
///
/// `--backend` selects the compiler binary used by `build` (default: `mlang`).
/// `--config` overrides the manifest path (default: `mlang.toml`).

/// \cond INTERNAL_IMPORTS
mod std::compiler;
mod std::fs;
mod std::process;
mod std::strbuf;

use std::compiler::version;
use std::fs::cwd;
use std::fs::file_exists;
use std::fs::read_all_text;
use std::fs::remove_tree;
use std::fs::write_all_text;
use std::process::Child;
use std::process::ChildStdout;
use std::process::ExitStatus;
use std::process::spawn;
use std::process::spawn_inherit;
use std::strbuf::contains;
use std::strbuf::ends_with;
use std::strbuf::eq;
use std::strbuf::find;
use std::strbuf::len;
use std::strbuf::rfind;
use std::strbuf::starts_with;
use std::strbuf::sub;
use std::strbuf::trim;
/// \endcond

struct KV {
    var key: str8;
    var value: str8;
};

struct DepSpec {
    var name: str8;
    var git: str8;
    var rev: str8;
    var tag: str8;
    var build: str8;
    var cmake_args: str8;
};

struct CDepSpec {
    var name: str8;
    var pkg_config: str8;
    var use_pkg_config: i32;
};

struct LinkFlags {
    var lib_dirs: list<str8>;
    var libs: list<str8>;
};

fn print_usage() -> void {
    println!("Usage:");
    println!("  mlang-pkg-mla [--backend <mlang_bin>] [--config <manifest>] <subcommand> [args...]");
    println!("");
    println!("Subcommands:");
    println!("  [--config FILE] init");
    println!("  [--config FILE] add <name> [--git URL] [--rev REV] [--tag TAG]");
    println!("  [--config FILE] add <name> [--pkg-config NAME] [--system]");
    println!("  [--config FILE] fetch [--build-dir DIR] [--deps-dir DIR] [--log-dir DIR] [--stdout-log FILE] [--stderr-log FILE] [--warn-log FILE] [--task-print-to-stdout-log]");
    println!("  [--config FILE] build [-O0|-O1|-O2|-O3] [--ninja] [--build-dir DIR] [--deps-dir DIR] [--log-dir DIR] [--stdout-log FILE] [--stderr-log FILE] [--warn-log FILE] [--task-print-to-stdout-log]");
    println!("  [--config FILE] run <task> [--build-dir DIR] [--deps-dir DIR] [--log-dir DIR] [--stdout-log FILE] [--stderr-log FILE] [--warn-log FILE] [--task-print-to-stdout-log]");
    println!("  [--config FILE] clean [--build-dir DIR] [--deps-dir DIR] [--log-dir DIR] [--stdout-log FILE] [--stderr-log FILE] [--warn-log FILE] [--task-print-to-stdout-log] [--deps]");
}

fn run_inherit(program: str8, args: list<str8>) -> i32 {
    println!("running {}", program);
    let cr: Result<Child, str8> = spawn_inherit(program, args);
    if cr.is_err() {
        println!("failed to spawn '{}': {}", program, cr.unwrap_err());
        return 1;
    }
    let child: Child = cr.unwrap();
    let wr: Result<ExitStatus, str8> = child.wait();
    if (wr.is_err()) {
        println!("wait failed for '{}': {}", program, wr.unwrap_err());
        child.close();
        return 1;
    }
    let st: ExitStatus = wr.unwrap();
    child.close();
    if (st.exited() != 1) {
        return 1;
    }
    return st.code();
}

fn run_capture_stdout(program: str8, args: list<str8>) -> Result<str8, str8> {
    let cr: Result<Child, str8> = spawn(program, args);
    if (cr.is_err()) {
        return Err<str8, str8>(format!("failed to spawn '{}': {}", program, cr.unwrap_err()));
    }
    let child: Child = cr.unwrap();

    let or: Result<ChildStdout, str8> = child.stdout();
    if (or.is_err()) {
        child.close();
        return Err<str8, str8>("failed to capture stdout");
    }
    let out: ChildStdout = or.unwrap();

    var buf: str8 = String::with_capacity(1024);
    var text: str8 = String::new();
    for _i in 0..4096 {
        let rr: Result<i64, str8> = out.read(buf, 1024);
        if (rr.is_err()) {
            out.close();
            child.close();
            String::free(buf);
            return Err<str8, str8>("failed to read child stdout");
        }
        let n: i64 = rr.unwrap();
        if (n <= 0) {
            break;
        }
        let chunk: str8 = sub(buf, 0, n);
        text = format!("{}{}", text, chunk);
    }
    out.close();
    String::free(buf);

    let wr: Result<ExitStatus, str8> = child.wait();
    if (wr.is_err()) {
        child.close();
        return Err<str8, str8>("wait failed");
    }
    let st: ExitStatus = wr.unwrap();
    child.close();
    if (st.success() != 1) {
        return Err<str8, str8>(format!("command exited with {}", st.code()));
    }
    return Ok<str8, str8>(text);
}

fn split_lines(content: str8) -> list<str8> {
    var out: list<str8> = [];
    var cur: str8 = String::new();
    let n: i64 = len(content);
    if (n == 0) {
        return out;
    }
    for i in 0..n {
        let ch: str8 = sub(content, i, 1);
        if (eq(ch, "\n") == 1) {
            out.push(cur);
            cur = String::new();
            continue;
        }
        if (eq(ch, "\r") == 1) {
            continue;
        }
        cur = format!("{}{}", cur, ch);
    }
    out.push(cur);
    return out;
}

fn join_lines(lines: list<str8>) -> str8 {
    var out: str8 = String::new();
    let n: i64 = lines.len();
    for i in 0..n {
        out = format!("{}{}", out, lines[i]);
        if (i + 1 < n) {
            out = format!("{}\n", out);
        }
    }
    return out;
}

fn basename(path: str8) -> str8 {
    let pos: i64 = rfind(path, "/");
    if (pos < 0) {
        return path;
    }
    let n: i64 = len(path);
    if (pos + 1 >= n) {
        return path;
    }
    return sub(path, pos + 1, n - pos - 1);
}

fn is_section_line(line: str8, section: str8) -> i32 {
    let t: str8 = trim(line);
    let expect: str8 = format!("[{}]", section);
    return eq(t, expect);
}

fn line_has_dep(line: str8, name: str8) -> i32 {
    let t: str8 = trim(line);
    if (len(t) == 0) { return 0; }
    if (starts_with(t, "#") == 1) { return 0; }
    if (starts_with(t, name) == 0) { return 0; }
    return find(t, "=") >= 0 ? 1 : 0;
}

fn add_dep_to_section(content: str8, section: str8, dep_name: str8, line: str8) -> Result<str8, str8> {
    let lines: list<str8> = split_lines(content);
    let n: i64 = lines.len();

    var section_start: i64 = -1;
    var section_end: i64 = n;
    for i in 0..n {
        if (is_section_line(lines[i], section) == 1) {
            section_start = i;
            for j in i + 1..n {
                let t: str8 = trim(lines[j]);
                if (len(t) > 0 && starts_with(t, "[") == 1) {
                    section_end = j;
                    break;
                }
            }
            break;
        }
    }

    if (section_start >= 0) {
        for i in section_start + 1..section_end {
            if (line_has_dep(lines[i], dep_name) == 1) {
                return Err<str8, str8>("Dependency already exists");
            }
        }
        var out_lines: list<str8> = [];
        for i in 0..n {
            if (i == section_end) {
                out_lines.push(line);
            }
            out_lines.push(lines[i]);
        }
        if (section_end == n) {
            out_lines.push(line);
        }
        return Ok<str8, str8>(join_lines(out_lines));
    }

    var out_lines2: list<str8> = [];
    for i in 0..n {
        let v: str8 = lines[i];
        if (i == 0 && len(v) == 0) {
            continue;
        }
        out_lines2.push(v);
    }
    out_lines2.push(format!("[{}]", section));
    out_lines2.push(line);
    return Ok<str8, str8>(join_lines(out_lines2));
}

fn find_toml_string(content: str8, key: str8) -> str8 {
    let needle: str8 = format!("{} = \"", key);
    let pos0: i64 = find(content, needle);
    if (pos0 < 0) {
        return "";
    }
    let pos: i64 = pos0 + len(needle);
    let n: i64 = len(content);
    if (pos >= n) {
        return "";
    }
    let tail: str8 = sub(content, pos, n - pos);
    let end_rel: i64 = find(tail, "\"");
    if (end_rel < 0) {
        return "";
    }
    return sub(content, pos, end_rel);
}

fn split_csv(input: str8) -> list<str8> {
    var out: list<str8> = [];
    var cur: str8 = String::new();
    var depth: i32 = 0;
    let n: i64 = len(input);
    for i in 0..n {
        let ch: str8 = sub(input, i, 1);
        if (eq(ch, "{") == 1) {
            depth = depth + 1;
        } else if ((eq(ch, "}") == 1)) {
            depth = depth - 1;
        }
        if (eq(ch, ",") == 1 && depth == 0) {
            let t: str8 = trim(cur);
            if (len(t) > 0) {
                out.push(t);
            }
            cur = String::new();
        } else {
            cur = format!("{}{}", cur, ch);
        }
    }
    let t2: str8 = trim(cur);
    if (len(t2) > 0) {
        out.push(t2);
    }
    return out;
}

fn split_semicolon(input: str8) -> list<str8> {
    var out: list<str8> = [];
    var cur: str8 = String::new();
    let n: i64 = len(input);
    for i in 0..n {
        let ch: str8 = sub(input, i, 1);
        if (eq(ch, ";") == 1) {
            let t: str8 = trim(cur);
            if (len(t) > 0) {
                out.push(t);
            }
            cur = String::new();
        } else {
            cur = format!("{}{}", cur, ch);
        }
    }
    let t2: str8 = trim(cur);
    if (len(t2) > 0) {
        out.push(t2);
    }
    return out;
}

fn unquote(v: str8) -> str8 {
    let t: str8 = trim(v);
    let n: i64 = len(t);
    if (n < 2) {
        return t;
    }
    let first: str8 = sub(t, 0, 1);
    let last: str8 = sub(t, n - 1, 1);
    if (eq(first, "\"") == 1 && eq(last, "\"") == 1) {
        return sub(t, 1, n - 2);
    }
    return t;
}

fn parse_inline_table(line: str8) -> list<KV> {
    var out: list<KV> = [];
    let l: i64 = find(line, "{");
    let r: i64 = rfind(line, "}");
    if (l < 0 || r < 0 || r <= l) {
        return out;
    }
    let inner: str8 = sub(line, l + 1, r - l - 1);
    let parts: list<str8> = split_csv(inner);
    for p in parts {
        let eqi: i64 = find(p, "=");
        if (eqi < 0) {
            continue;
        }
        let k: str8 = trim(sub(p, 0, eqi));
        let vraw: str8 = sub(p, eqi + 1, len(p) - eqi - 1);
        let v: str8 = unquote(vraw);
        out.push(KV { key: k, value: v });
    }
    return out;
}

fn kv_get(kvs: &list<KV>, key: str8) -> str8 {
    for kv in kvs {
        if (eq(kv.key, key) == 1) {
            return kv.value;
        }
    }
    return "";
}

fn parse_git_deps(content: str8) -> list<DepSpec> {
    var deps: list<DepSpec> = [];
    let lines: list<str8> = split_lines(content);
    var section: str8 = String::new();
    for line in lines {
        let t: str8 = trim(line);
        if (len(t) == 0 || starts_with(t, "#") == 1) {
            continue;
        }
        if (starts_with(t, "[") == 1 && ends_with(t, "]") == 1) {
            section = sub(t, 1, len(t) - 2);
            continue;
        }
        if (eq(section, "dependencies") == 0 && eq(section, "c-dependencies") == 0) {
            continue;
        }
        let eqi: i64 = find(t, "=");
        if (eqi < 0) {
            continue;
        }
        let name: str8 = trim(sub(t, 0, eqi));
        if (len(name) == 0) {
            continue;
        }
        if (contains(t, "{") != 1) {
            continue;
        }
        let kvs: list<KV> = parse_inline_table(t);
        let git: str8 = kv_get(kvs, "git");
        if (len(git) == 0) {
            continue;
        }
        var dep: DepSpec = DepSpec {
            name: name,
            git: git,
            rev: kv_get(kvs, "rev"),
            tag: kv_get(kvs, "tag"),
            build: kv_get(kvs, "build"),
            cmake_args: kv_get(kvs, "cmake_args")
        };
        if (len(dep.build) == 0) {
            dep.build = "cmake";
        }
        deps.push(dep);
    }
    return deps;
}

fn parse_c_deps(content: str8) -> list<CDepSpec> {
    var deps: list<CDepSpec> = [];
    let lines: list<str8> = split_lines(content);
    var section: str8 = String::new();
    for line in lines {
        let t: str8 = trim(line);
        if (len(t) == 0 || starts_with(t, "#") == 1) {
            continue;
        }
        if (starts_with(t, "[") == 1 && ends_with(t, "]") == 1) {
            section = sub(t, 1, len(t) - 2);
            continue;
        }
        if (eq(section, "c-dependencies") == 0) {
            continue;
        }
        let eqi: i64 = find(t, "=");
        if (eqi < 0) {
            continue;
        }
        let name: str8 = trim(sub(t, 0, eqi));
        if (len(name) == 0) {
            continue;
        }

        var dep: CDepSpec = CDepSpec {
            name: name,
            pkg_config: "",
            use_pkg_config: 0
        };

        if (contains(t, "{") == 1) {
            let kvs: list<KV> = parse_inline_table(t);
            let pc: str8 = kv_get(kvs, "pkg_config");
            if (len(pc) > 0) {
                dep.pkg_config = pc;
                dep.use_pkg_config = 1;
            } else {
                let sys: str8 = kv_get(kvs, "system");
                if (eq(sys, "true") == 1 || eq(sys, "1") == 1) {
                    dep.pkg_config = name;
                    dep.use_pkg_config = 1;
                }
            }
        } else {
            dep.pkg_config = name;
            dep.use_pkg_config = 1;
        }

        if (dep.use_pkg_config == 1) {
            deps.push(dep);
        }
    }
    return deps;
}

fn split_shell_tokens(input: str8) -> list<str8> {
    var out: list<str8> = [];
    var cur: str8 = String::new();
    var in_quotes: i32 = 0;
    var quote: str8 = "";
    let n: i64 = len(input);
    for i in 0..n {
        let ch: str8 = sub(input, i, 1);
        if (in_quotes == 1) {
            if (eq(ch, quote) == 1) {
                in_quotes = 0;
                continue;
            }
            cur = format!("{}{}", cur, ch);
            continue;
        }
        if (eq(ch, "\"") == 1 || eq(ch, "'") == 1) {
            in_quotes = 1;
            quote = ch;
            continue;
        }
        if (eq(ch, " ") == 1 || eq(ch, "\t") == 1 || eq(ch, "\n") == 1 || eq(ch, "\r") == 1) {
            if (len(cur) > 0) {
                out.push(cur);
                cur = String::new();
            }
            continue;
        }
        cur = format!("{}{}", cur, ch);
    }
    if (len(cur) > 0) {
        out.push(cur);
    }
    return out;
}

fn split_toml_array(input: str8) -> list<str8> {
    var out: list<str8> = [];
    var cur: str8 = String::new();
    var in_quotes: i32 = 0;
    let n: i64 = len(input);
    for i in 0..n {
        let ch: str8 = sub(input, i, 1);
        if (eq(ch, "\"") == 1) {
            if (in_quotes == 1) {
                in_quotes = 0;
            } else {
                in_quotes = 1;
            }
            cur = format!("{}{}", cur, ch);
            continue;
        }
        if (eq(ch, ",") == 1 && in_quotes == 0) {
            let item: str8 = trim(cur);
            if (len(item) > 0) {
                out.push(item);
            }
            cur = String::new();
            continue;
        }
        cur = format!("{}{}", cur, ch);
    }
    let tail: str8 = trim(cur);
    if (len(tail) > 0) {
        out.push(tail);
    }
    return out;
}

fn normalize_target_arch_name(arch: str8) -> str8 {
    if (eq(arch, "x86") == 1 || eq(arch, "i386") == 1 || eq(arch, "i686") == 1) {
        return "x86";
    }
    if (eq(arch, "x64") == 1 || eq(arch, "x86_64") == 1 || eq(arch, "amd64") == 1 || eq(arch, "x86-64") == 1) {
        return "x64";
    }
    if (eq(arch, "aarch64") == 1 || eq(arch, "arm64") == 1) {
        return "aarch64";
    }
    return "";
}

fn normalize_opt_level(opt: str8) -> str8 {
    let t: str8 = trim(opt);
    if (len(t) == 0) {
        return "";
    }
    if (eq(t, "O0") == 1) { return "-O0"; }
    if (eq(t, "O1") == 1) { return "-O1"; }
    if (eq(t, "O2") == 1) { return "-O2"; }
    if (eq(t, "O3") == 1) { return "-O3"; }
    if (eq(t, "-O0") == 1 || eq(t, "-O1") == 1 || eq(t, "-O2") == 1 || eq(t, "-O3") == 1) {
        return t;
    }
    return "";
}

fn parse_tool_mlang_string(content: str8, wanted_key: str8) -> str8 {
    let lines: list<str8> = split_lines(content);
    var section: str8 = String::new();
    for line in lines {
        let t: str8 = trim(line);
        if (len(t) == 0 || starts_with(t, "#") == 1) {
            continue;
        }
        if (starts_with(t, "[") == 1 && ends_with(t, "]") == 1) {
            section = sub(t, 1, len(t) - 2);
            continue;
        }
        if (eq(section, "tool.mlang") == 0) {
            continue;
        }

        let eqi: i64 = find(t, "=");
        if (eqi < 0) {
            continue;
        }
        let key: str8 = trim(sub(t, 0, eqi));
        let value: str8 = trim(sub(t, eqi + 1, len(t) - eqi - 1));
        if (eq(key, wanted_key) == 1) {
            let out: str8 = unquote(value);
            return format!("{}", out);
        }
    }
    return "";
}

fn parse_tool_mlang_list(content: str8, wanted_key: str8) -> list<str8> {
    var out: list<str8> = [];
    let lines: list<str8> = split_lines(content);
    var section: str8 = String::new();
    var found: i32 = 0;
    for line in lines {
        let t: str8 = trim(line);
        if (len(t) == 0 || starts_with(t, "#") == 1) {
            continue;
        }
        if (starts_with(t, "[") == 1 && ends_with(t, "]") == 1) {
            section = sub(t, 1, len(t) - 2);
            continue;
        }
        if (eq(section, "tool.mlang") == 0) {
            continue;
        }

        let eqi: i64 = find(t, "=");
        if (eqi < 0) {
            continue;
        }
        let key: str8 = trim(sub(t, 0, eqi));
        if (eq(key, wanted_key) == 0) {
            continue;
        }
        found = 1;
        let value: str8 = trim(sub(t, eqi + 1, len(t) - eqi - 1));
        if (len(value) == 0) {
            break;
        }
        if (starts_with(value, "[") == 1 && ends_with(value, "]") == 1) {
            let inner: str8 = sub(value, 1, len(value) - 2);
            let parts: list<str8> = split_toml_array(inner);
            for part in parts {
                let item: str8 = unquote(part);
                if (len(item) > 0) {
                    out.push(format!("{}", item));
                }
            }
            break;
        }
        let single: str8 = unquote(value);
        if (len(single) > 0) {
            out.push(format!("{}", single));
        }
        break;
    }
    if (found == 0) {
        return [];
    }
    return out;
}

fn manifest_uses_build_config(content: str8) -> i32 {
    if (contains(content, "[tool.mlang]") != 1) {
        return 0;
    }
    if (contains(content, "opt_level") == 1) { return 1; }
    if (contains(content, "target_arch") == 1) { return 1; }
    if (contains(content, "compiler_flags") == 1) { return 1; }
    if (contains(content, "linker_flags") == 1) { return 1; }
    if (contains(content, "lib_paths") == 1) { return 1; }
    if (contains(content, "libs") == 1) { return 1; }
    if (contains(content, "build_dir") == 1) { return 1; }
    if (contains(content, "deps_dir") == 1) { return 1; }
    return 0;
}

fn has_pkg_dir_override_args(argv: list<str8>, start_idx: i64) -> i32 {
    let n: i64 = argv.len();
    var i: i64 = start_idx;
    while (i < n) {
        let arg: str8 = argv[i];
        if (eq(arg, "--build-dir") == 1 || eq(arg, "--deps-dir") == 1 || eq(arg, "--deps") == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn delegate_pkg_to_cpp(backend: str8, sub: str8, argv: list<str8>, start_idx: i64) -> i32 {
    var delegated_args: list<str8> = [
        "MLANG_PKG_IMPL=cpp",
        "MLANG_FRONTEND_IMPL=cpp",
        backend,
        "pkg",
        sub
    ];
    let n: i64 = argv.len();
    var i: i64 = start_idx;
    while (i < n) {
        delegated_args.push(argv[i]);
        i = i + 1;
    }
    return run_inherit("env", delegated_args);
}

fn contains_string(items: list<str8>, needle: str8) -> i32 {
    for it in items {
        if (eq(it, needle) == 1) {
            return 1;
        }
    }
    return 0;
}

fn extract_lib_name(path: str8) -> str8 {
    let name: str8 = basename(path);
    if (starts_with(name, "lib") == 0) {
        return "";
    }
    if (ends_with(name, ".a") == 1 || ends_with(name, ".dylib") == 1 || ends_with(name, ".so") == 1) {
        let dot: i64 = rfind(name, ".");
        if (dot <= 3) {
            return "";
        }
        let stem: str8 = sub(name, 0, dot);
        if (starts_with(stem, "lib") == 0 || len(stem) <= 3) {
            return "";
        }
        return sub(stem, 3, len(stem) - 3);
    }
    let so_pos: i64 = find(name, ".so.");
    if (so_pos > 3) {
        return sub(name, 3, so_pos - 3);
    }
    return "";
}

fn collect_dep_link_flags(deps: list<DepSpec>, deps_dir: str8) -> LinkFlags {
    var lib_dirs: list<str8> = [];
    var libs: list<str8> = [];

    for dep in deps {
        let dep_path: str8 = format!("{}/{}", deps_dir, dep.name);
        let cand: list<str8> = [
            format!("{}/build/lib", dep_path),
            format!("{}/build", dep_path),
            format!("{}/lib", dep_path)
        ];
        for d in cand {
            if (file_exists(d) == 0) {
                continue;
            }
            if (contains_string(lib_dirs, d) == 0) {
                lib_dirs.push(d);
            }
            let fr: Result<str8, str8> =
                run_capture_stdout("find", [d, "-maxdepth", "1", "-type", "f"]);
            if (fr.is_err()) {
                continue;
            }
            let lines: list<str8> = split_lines(fr.unwrap());
            for p in lines {
                let path: str8 = trim(p);
                if (len(path) == 0) {
                    continue;
                }
                let lib_name: str8 = extract_lib_name(path);
                if (len(lib_name) == 0) {
                    continue;
                }
                if (contains_string(libs, lib_name) == 0) {
                    libs.push(lib_name);
                }
            }
        }
    }

    return LinkFlags { lib_dirs: lib_dirs, libs: libs };
}

fn fetch_git_dep(dep: DepSpec, deps_dir: str8) -> i32 {
    let path: str8 = format!("{}/{}", deps_dir, dep.name);
    if (file_exists(path) == 0) {
        let rc: i32 = run_inherit("git", ["clone", dep.git, path]);
        if (rc != 0) {
            return 1;
        }
    } else {
        let rc: i32 = run_inherit("git", ["-C", path, "fetch", "--all", "--tags"]);
        if (rc != 0) {
            return 1;
        }
    }

    if (len(dep.rev) > 0) {
        let rc: i32 = run_inherit("git", ["-C", path, "checkout", dep.rev]);
        if (rc != 0) {
            return 1;
        }
    } else if ((len(dep.tag) > 0)) {
        let target: str8 = format!("tags/{}", dep.tag);
        let rc: i32 = run_inherit("git", ["-C", path, "checkout", target]);
        if (rc != 0) {
            return 1;
        }
    }
    return 0;
}

fn build_git_dep(dep: DepSpec, deps_dir: str8, use_ninja: i32) -> i32 {
    let path: str8 = format!("{}/{}", deps_dir, dep.name);
    if (file_exists(path) == 0) {
        return 1;
    }

    if (eq(dep.build, "cmake") == 1) {
        let build_dir: str8 = format!("{}/build", path);
        var cfg_args: list<str8> = [];
        if (use_ninja == 1) {
            cfg_args.push("-G");
            cfg_args.push("Ninja");
        }
        cfg_args.push("-S");
        cfg_args.push(path);
        cfg_args.push("-B");
        cfg_args.push(build_dir);
        if (len(dep.cmake_args) > 0) {
            let args: list<str8> = split_semicolon(dep.cmake_args);
            for a in args {
                if (len(a) == 0) {
                    continue;
                }
                if (starts_with(a, "-") == 1) {
                    cfg_args.push(a);
                } else {
                    cfg_args.push(format!("-D{}", a));
                }
            }
        }
        if (run_inherit("cmake", cfg_args) != 0) {
            return 1;
        }
        return run_inherit("cmake", ["--build", build_dir]);
    }

    if (eq(dep.build, "meson") == 1) {
        let build_dir: str8 = format!("{}/build", path);
        if (file_exists(build_dir) == 0) {
            let rc_setup: i32 = run_inherit("meson", ["setup", build_dir, path]);
            if (rc_setup != 0) {
                return 1;
            }
        }
        return run_inherit("meson", ["compile", "-C", build_dir]);
    }

    if (eq(dep.build, "make") == 1) {
        return run_inherit("make", ["-C", path]);
    }

    println!("Unknown build system: {}", dep.build);
    return 1;
}

fn ensure_deps_dir() -> i32 {
    let rc1: i32 = run_inherit("mkdir", ["-p", "build"]);
    if (rc1 != 0) {
        return 1;
    }
    let rc2: i32 = run_inherit("mkdir", ["-p", "build/deps"]);
    if (rc2 != 0) {
        return 1;
    }
    return 0;
}

fn read_manifest(manifest_path: str8) -> Result<str8, str8> {
    if (file_exists(manifest_path) == 0) {
        return Err<str8, str8>("mlang.toml not found. Run 'mlang pkg init' first.");
    }
    let rr: Result<str8, str8> = read_all_text(manifest_path);
    if (rr.is_err()) {
        return Err<str8, str8>("Failed to read mlang.toml");
    }
    let content: str8 = rr.unwrap();
    if (len(content) == 0) {
        return Err<str8, str8>("Failed to read mlang.toml");
    }
    return Ok<str8, str8>(content);
}

fn run_init(manifest_path: str8) -> i32 {
    if (file_exists(manifest_path) == 1) {
        println!("mlang.toml already exists");
        return 1;
    }
    var name: str8 = basename(cwd());
    if (len(name) == 0) {
        name = "app";
    }
    let content: str8 = format!(
        "[package]\nname = \"{}\"\nversion = \"{}\"\nentry = \"src/main.mla\"\n\n[dependencies]\n\n[c-dependencies]\n",
        name,
        version()
    );
    let wr: Result<i32, str8> = write_all_text(manifest_path, content);
    if (wr.is_err()) {
        println!("Failed to write mlang.toml");
        return 1;
    }
    return 0;
}

fn run_add(argc: i32, argv: list<str8>, start_idx: i64, manifest_path: str8) -> i32 {
    if (start_idx + 1 >= argc) {
        println!("Usage: mlang-pkg-mla add <name> [--git URL] [--rev REV] [--tag TAG]");
        println!("       mlang-pkg-mla add <name> [--pkg-config NAME] [--system]");
        return 1;
    }

    let name: str8 = argv[start_idx + 1];
    var git_url: str8 = "";
    var rev: str8 = "";
    var tag: str8 = "";
    var pkg_config: str8 = "";
    var system_dep: i32 = 0;

    let n: i64 = argv.len();
    var i: i64 = start_idx + 2;
    while (i < n) {
        let arg: str8 = argv[i];
        if (eq(arg, "--git") == 1 && i + 1 < n) {
            git_url = argv[i + 1];
            i = i + 2;
            continue;
        }
        if (eq(arg, "--rev") == 1 && i + 1 < n) {
            rev = argv[i + 1];
            i = i + 2;
            continue;
        }
        if (eq(arg, "--tag") == 1 && i + 1 < n) {
            tag = argv[i + 1];
            i = i + 2;
            continue;
        }
        if (eq(arg, "--pkg-config") == 1 && i + 1 < n) {
            pkg_config = argv[i + 1];
            i = i + 2;
            continue;
        }
        if (eq(arg, "--system") == 1) {
            system_dep = 1;
            i = i + 1;
            continue;
        }
        println!("Unknown option: {}", arg);
        return 1;
    }

    let rr: Result<str8, str8> = read_manifest(manifest_path);
    if (rr.is_err()) {
        println!("{}", rr.unwrap_err());
        return 1;
    }
    let content: str8 = rr.unwrap();

    var section: str8 = "dependencies";
    var line: str8 = "";
    if (system_dep == 1 || len(pkg_config) > 0) {
        section = "c-dependencies";
        if (system_dep == 1) {
            line = format!("{} = {{ system = true }}", name);
        } else {
            line = format!("{} = {{ pkg_config = \"{}\" }}", name, pkg_config);
        }
    } else if ((len(git_url) > 0)) {
        line = format!("{} = {{ git = \"{}\"", name, git_url);
        if (len(rev) > 0) {
            line = format!("{}, rev = \"{}\"", line, rev);
        }
        if (len(tag) > 0) {
            line = format!("{}, tag = \"{}\"", line, tag);
        }
        line = format!("{} }}", line);
    } else {
        line = format!("{} = \"*\"", name);
    }

    let ar: Result<str8, str8> = add_dep_to_section(content, section, name, line);
    if (ar.is_err()) {
        println!("Dependency already exists: {}", name);
        return 1;
    }
    let wr: Result<i32, str8> = write_all_text(manifest_path, ar.unwrap());
    if (wr.is_err()) {
        println!("Failed to update mlang.toml");
        return 1;
    }
    return 0;
}

fn run_fetch(argv: list<str8>, start_idx: i64, manifest_path: str8, backend: str8) -> i32 {
    let rr: Result<str8, str8> = read_manifest(manifest_path);
    if (rr.is_err()) {
        println!("{}", rr.unwrap_err());
        return 1;
    }
    let content: str8 = rr.unwrap();
    if (manifest_uses_build_config(content) == 1 || has_pkg_dir_override_args(argv, start_idx + 1) == 1) {
        return delegate_pkg_to_cpp(backend, "fetch", argv, start_idx + 1);
    }
    let deps: list<DepSpec> = parse_git_deps(content);

    if (ensure_deps_dir() != 0) {
        return 1;
    }
    for dep in deps {
        if (fetch_git_dep(dep, "build/deps") != 0) {
            return 1;
        }
    }
    println!("Fetch completed.");
    return 0;
}

fn run_build(argc: i32, argv: list<str8>, start_idx: i64, manifest_path: str8, backend: str8) -> i32 {
    var opt_flag: str8 = "";
    var use_ninja: i32 = 0;
    let n: i64 = argv.len();
    var i: i64 = start_idx + 1;
    while (i < n) {
        let arg: str8 = argv[i];
        if (eq(arg, "-O0") == 1 || eq(arg, "-O1") == 1 || eq(arg, "-O2") == 1 || eq(arg, "-O3") == 1) {
            opt_flag = arg;
            i = i + 1;
            continue;
        }
        if (eq(arg, "--ninja") == 1) {
            use_ninja = 1;
            i = i + 1;
            continue;
        }
        println!("Unknown option for 'pkg build': {}", arg);
        println!("Usage: mlang-pkg-mla build [-O0|-O1|-O2|-O3] [--ninja]");
        return 1;
    }

    let rr: Result<str8, str8> = read_manifest(manifest_path);
    if (rr.is_err()) {
        println!("{}", rr.unwrap_err());
        return 1;
    }
    let content: str8 = rr.unwrap();
    if (manifest_uses_build_config(content) == 1 || has_pkg_dir_override_args(argv, start_idx + 1) == 1) {
        return delegate_pkg_to_cpp(backend, "build", argv, start_idx + 1);
    }
    let deps: list<DepSpec> = parse_git_deps(content);
    let cdeps: list<CDepSpec> = parse_c_deps(content);
    let opt_level_cfg: str8 = normalize_opt_level(parse_tool_mlang_string(content, "opt_level"));
    let target_arch_cfg: str8 = normalize_target_arch_name(parse_tool_mlang_string(content, "target_arch"));
    let cfg_compiler_flags: list<str8> = parse_tool_mlang_list(content, "compiler_flags");
    let cfg_linker_flags: list<str8> = parse_tool_mlang_list(content, "linker_flags");
    let cfg_lib_paths: list<str8> = parse_tool_mlang_list(content, "lib_paths");
    let cfg_libs: list<str8> = parse_tool_mlang_list(content, "libs");

    if (ensure_deps_dir() != 0) {
        return 1;
    }
    for dep in deps {
        if (fetch_git_dep(dep, "build/deps") != 0) {
            return 1;
        }
    }
    for dep in deps {
        if (build_git_dep(dep, "build/deps", use_ninja) != 0) {
            return 1;
        }
    }

    let link_flags: LinkFlags = collect_dep_link_flags(deps, "build/deps");

    var pkg_flags: list<str8> = [];
    for dep in cdeps {
        if (dep.use_pkg_config == 0 || len(dep.pkg_config) == 0) {
            continue;
        }
        let r: Result<str8, str8> =
            run_capture_stdout("pkg-config", ["--cflags", "--libs", dep.pkg_config]);
        if (r.is_err()) {
            println!("pkg-config failed for: {}", dep.pkg_config);
            return 1;
        }
        let tokens: list<str8> = split_shell_tokens(r.unwrap());
        for t in tokens {
            pkg_flags.push(t);
        }
    }

    var entry: str8 = "src/main.mla";
    let entry_cfg: str8 = find_toml_string(content, "entry");
    if (len(entry_cfg) > 0) {
        entry = entry_cfg;
    }
    var name: str8 = "app";
    let name_cfg: str8 = find_toml_string(content, "name");
    if (len(name_cfg) > 0) {
        name = name_cfg;
    }
    if (len(opt_flag) == 0 && len(opt_level_cfg) > 0) {
        opt_flag = opt_level_cfg;
    }

    if (run_inherit("mkdir", ["-p", "build"]) != 0) {
        return 1;
    }

    let output: str8 = format!("build/{}", name);
    var cmd_args: list<str8> = [entry, "-o", output];
    if (len(target_arch_cfg) > 0) {
        cmd_args.push("--target-arch");
        cmd_args.push(target_arch_cfg);
    }
    if (len(opt_flag) > 0) {
        cmd_args.push(opt_flag);
    }
    for f in cfg_compiler_flags {
        cmd_args.push(f);
    }
    let link_dirs: list<str8> = link_flags.lib_dirs;
    let link_libs: list<str8> = link_flags.libs;
    let pkg_flags_local: list<str8> = pkg_flags;

    for d in cfg_lib_paths {
        cmd_args.push(format!("-L{}", d));
    }
    for l in cfg_libs {
        cmd_args.push(format!("-l{}", l));
    }
    for d in link_dirs {
        cmd_args.push(format!("-L{}", d));
    }
    for l in link_libs {
        cmd_args.push(format!("-l{}", l));
    }
    for d in link_dirs {
        cmd_args.push(format!("-Wl,-rpath,{}", d));
    }
    for f in cfg_linker_flags {
        cmd_args.push(f);
    }
    for f in pkg_flags_local {
        cmd_args.push(f);
    }

    let rc: i32 = run_inherit(backend, cmd_args);
    if (rc != 0) {
        println!("Build failed.");
        return 1;
    }
    return 0;
}

fn run_clean(argv: list<str8>, start_idx: i64, manifest_path: str8, backend: str8) -> i32 {
    let rr: Result<str8, str8> = read_manifest(manifest_path);
    if (rr.is_ok()) {
        let content: str8 = rr.unwrap();
        if (manifest_uses_build_config(content) == 1 || has_pkg_dir_override_args(argv, start_idx + 1) == 1) {
            return delegate_pkg_to_cpp(backend, "clean", argv, start_idx + 1);
        }
    } else if (has_pkg_dir_override_args(argv, start_idx + 1) == 1) {
        return delegate_pkg_to_cpp(backend, "clean", argv, start_idx + 1);
    }

    let build_dir: str8 = "build";
    if (file_exists(build_dir) == 0) {
        println!("No artifacts to clean in {}", build_dir);
        return 0;
    }

    let rr: Result<i32, str8> = remove_tree(build_dir);
    if (rr.is_err()) {
        println!("Failed to clean {}", build_dir);
        return 1;
    }

    println!("Cleaned {}", build_dir);
    return 0;
}

fn main(argc: i32, args: list<str8>) -> i32 {
    var argv: list<str8> = [];
    for a in args {
        argv.push(format!("{}", a));
    }

    if (argc < 2) {
        print_usage();
        return 1;
    }

    var backend: str8 = "mlang";
    var manifest: str8 = "mlang.toml";
    var idx: i64 = 1;

    if (argv.len() > 1 && eq(argv[1], "--backend") == 1) {
        if (argv.len() < 4) {
            println!("--backend requires a value and subcommand");
            print_usage();
            return 1;
        }
        backend = argv[2];
        idx = 3;
    }

    if (idx >= argv.len()) {
        print_usage();
        return 1;
    }

    if (eq(argv[idx], "pkg") == 1) {
        idx = idx + 1;
    }
    if (idx >= argv.len()) {
        print_usage();
        return 1;
    }

    if (eq(argv[idx], "--config") == 1) {
        if (idx + 1 >= argv.len()) {
            println!("--config requires a manifest path");
            print_usage();
            return 1;
        }
        manifest = argv[idx + 1];
        idx = idx + 2;
    } else if (starts_with(argv[idx], "--config=") == 1) {
        manifest = sub(argv[idx], 9, len(argv[idx]) - 9);
        if (len(manifest) == 0) {
            println!("--config requires a manifest path");
            print_usage();
            return 1;
        }
        idx = idx + 1;
    }
    if (idx >= argv.len()) {
        print_usage();
        return 1;
    }

    let sub: str8 = argv[idx];
    if (eq(sub, "-h") == 1 || eq(sub, "--help") == 1) {
        print_usage();
        return 0;
    }

    if (eq(sub, "init") == 1) {
        return run_init(manifest);
    }
    if (eq(sub, "add") == 1) {
        return run_add(argc, argv, idx, manifest);
    }
    if (eq(sub, "fetch") == 1) {
        return run_fetch(argv, idx, manifest, backend);
    }
    if (eq(sub, "build") == 1) {
        return run_build(argc, argv, idx, manifest, backend);
    }
    if (eq(sub, "clean") == 1) {
        return run_clean(argv, idx, manifest, backend);
    }

    println!("Unknown pkg subcommand: {}", sub);
    print_usage();
    return 1;
}
