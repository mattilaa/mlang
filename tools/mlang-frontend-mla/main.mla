/// \file main.mla
/// \brief Incremental MLang port of the compiler frontend CLI.
///
/// This tool is a frontend wrapper that forwards compiler arguments to a
/// backend compiler binary (default: `mlang`).
///
/// Usage:
///   mlang-frontend-mla [--backend <mlang_bin>] [compiler args...]

/// \cond INTERNAL_IMPORTS
mod std::compiler;
mod std::fs;
mod std::process;
mod std::strbuf;

use std::compiler::version;
use std::fs::file_exists;
use std::fs::read_all_text;
use std::process::Child;
use std::process::ChildStdout;
use std::process::ExitStatus;
use std::process::spawn;
use std::process::spawn_inherit;
use std::strbuf::contains;
use std::strbuf::compare;
use std::strbuf::eq;
use std::strbuf::ends_with;
use std::strbuf::find;
use std::strbuf::len;
use std::strbuf::rfind;
use std::strbuf::starts_with;
use std::strbuf::sub;
use std::strbuf::trim;
/// \endcond

struct FrontendState {
    var backend: str8;
    var passthrough: list<str8>;
    var show_help: i32;
    var show_version: i32;
    var parse_error: str8;
};

fn print_usage(program: str8) -> void {
    println!("Usage: {} [--backend <mlang_bin>] [compiler args...]", program);
    println!("Version: {}", version());
    println!("");
    println!("Options:");
    println!("  -o <file>     Output file name (default: a.out)");
    println!("  -c            Compile to object file only (don't link)");
    println!("  -S            Emit assembly file");
    println!("  -emit-llvm    Emit LLVM IR file (.ll)");
    println!("  -emit-bc      Emit LLVM bitcode file (.bc)");
    println!("  --target-arch <arch>  Set target arch: x86, x64, aarch64");
    println!("  -O0           No optimization");
    println!("  -O1           Basic optimization");
    println!("  -O2           Standard optimization (default)");
    println!("  -O3           Aggressive optimization");
    println!("  --no-tests    Skip compiling #[test] functions");
    println!("  --tests       Compile and run #[test] for input path/file");
    println!("  -Wno-colon-if Suppress warning for plain if/else-if with ':'");
    println!("  -Wno-colon-while Suppress warning for plain while with ':'");
    println!("  -L <dir>      Add a library search path for linking");
    println!("  -l <name>     Link with library (e.g. -l m)");
    println!("  -Wl,<args>    Pass raw linker arguments");
    println!("  -v            Verbose output");
    println!("  --debug       Enable debug-only logging");
    println!("  --version     Show version and exit");
    println!("  -h, --help    Show this help message");
    println!("");
    println!("Package manager:");
    println!("  {} pkg init", program);
    println!("  {} pkg add <name> [--git URL] [--rev REV] [--tag TAG]", program);
    println!("  {} pkg add <name> --url URL [--archive tar.gz] [--strip-components N] [--subdir DIR]", program);
    println!("  {} pkg add <name> [--pkg-config NAME] [--system]", program);
    println!("  {} pkg add <name> [--git URL|--url URL] --add-lib [--project-dir DIR]", program);
    println!("  {} pkg fetch [--build-dir DIR] [--deps-dir DIR] [--log-dir DIR] [--stdout-log FILE] [--stderr-log FILE] [--warn-log FILE] [--task-print-to-stdout-log]", program);
    println!("  {} pkg build [-O0|-O1|-O2|-O3] [--ninja] [--build-dir DIR] [--deps-dir DIR] [--log-dir DIR] [--stdout-log FILE] [--stderr-log FILE] [--warn-log FILE] [--task-print-to-stdout-log]", program);
    println!("  {} pkg run <task> [--build-dir DIR] [--deps-dir DIR] [--log-dir DIR] [--stdout-log FILE] [--stderr-log FILE] [--warn-log FILE] [--task-print-to-stdout-log]", program);
    println!("  {} pkg clean [--build-dir DIR] [--deps-dir DIR] [--log-dir DIR] [--stdout-log FILE] [--stderr-log FILE] [--warn-log FILE] [--task-print-to-stdout-log] [--deps]", program);
    println!("");
    println!("Testing:");
    println!("  {} --tests [path]", program);
    println!("  {} test [path]", program);
    println!("  {} run tests", program);
    println!("");
    println!("Benchmarking:");
    println!("  {} bench [path]", program);
    println!("  {} bench [path] --bench-iters N --bench-warmup N", program);
    println!("");
    println!("Examples:");
    println!("  {} test.mla              # Compile to a.out", program);
    println!("  {} -o myprogram test.mla # Compile to myprogram", program);
    println!("  {} -S test.mla           # Emit assembly", program);
    println!("  {} -emit-llvm test.mla   # Emit LLVM IR", program);
    println!("");
    println!("Stdlib linking:");
    println!("  {} main.mla -L ~/.local/lib -lmlang_std", program);
    println!("  (or set MLANG_STDLIB_LIB_PATH=~/.local/lib)");
}

fn run_inherit(program: str8, args: list<str8>) -> i32 {
    let cr: Result<Child, str8> = spawn_inherit(program, args);
    if (cr.is_err()) {
        eprintln!("failed to spawn '{}': {}", program, cr.unwrap_err());
        return 1;
    }
    let child: Child = cr.unwrap();
    let wr: Result<ExitStatus, str8> = child.wait();
    if (wr.is_err()) {
        eprintln!("wait failed for '{}': {}", program, wr.unwrap_err());
        child.close();
        return 1;
    }
    let st: ExitStatus = wr.unwrap();
    child.close();
    if (st.exited() != 1) {
        return 1;
    }
    return st.code();
}

fn run_capture_stdout(program: str8, args: list<str8>) -> Result<str8, str8> {
    let cr: Result<Child, str8> = spawn(program, args);
    if (cr.is_err()) {
        return Err<str8, str8>(format!("failed to spawn '{}': {}", program, cr.unwrap_err()));
    }
    let child: Child = cr.unwrap();
    let or: Result<ChildStdout, str8> = child.stdout();
    if (or.is_err()) {
        child.close();
        return Err<str8, str8>("failed to capture stdout");
    }
    let out: ChildStdout = or.unwrap();

    var buf: str8 = String::with_capacity(4096);
    var text: str8 = String::new();
    for _i in 0..8192 {
        let rr: Result<i64, str8> = out.read(buf, 4096);
        if (rr.is_err()) {
            out.close();
            child.close();
            String::free(buf);
            return Err<str8, str8>("failed to read child stdout");
        }
        let n: i64 = rr.unwrap();
        if (n <= 0) {
            break;
        }
        text = format!("{}{}", text, sub(buf, 0, n));
    }
    out.close();
    String::free(buf);

    let wr: Result<ExitStatus, str8> = child.wait();
    if (wr.is_err()) {
        child.close();
        return Err<str8, str8>("wait failed");
    }
    let st: ExitStatus = wr.unwrap();
    child.close();
    if (st.success() != 1) {
        return Err<str8, str8>(format!("command exited with {}", st.code()));
    }
    return Ok<str8, str8>(text);
}

fn shell_quote(s: str8) -> str8 {
    var out: str8 = "'";
    let n: i64 = len(s);
    for i in 0..n {
        let ch: str8 = sub(s, i, 1);
        if eq(ch, "'") == 1 {
            out = concat(out, "'\\''");
        } else {
            out = concat(out, ch);
        }
    }
    out = concat(out, "'");
    return out;
}

fn build_shell_command(program: str8, args: list<str8>) -> str8 {
    var cmd: str8 = shell_quote(program);
    let n: i64 = args.len();
    for i in 0..n {
        cmd = concat(cmd, " ");
        cmd = concat(cmd, shell_quote(args[i]));
    }
    return cmd;
}

fn run_shell_inherit(cmd: str8) -> i32 {
    return run_inherit("/bin/sh", ["-c", cmd]);
}

fn split_lines(content: str8) -> list<str8> {
    var out: list<str8> = [];
    var cur: str8 = String::new();
    let n: i64 = len(content);
    if n == 0 { return out; }
    for i in 0..n {
        let ch: str8 = sub(content, i, 1);
        if eq(ch, "\n") == 1 {
            out.push(cur);
            cur = String::new();
            continue;
        }
        if eq(ch, "\r") == 1 {
            continue;
        }
        cur = concat(cur, ch);
    }
    if len(cur) > 0 {
        out.push(cur);
    }
    return out;
}

fn basename(path: str8) -> str8 {
    let p: i64 = rfind(path, "/");
    if p < 0 { return path; }
    let n: i64 = len(path);
    if p >= n - 1 { return path; }
    return sub(path, p + 1, n - p - 1);
}

fn parent_dir(path: str8) -> str8 {
    let p: i64 = rfind(path, "/");
    if p < 0 { return "."; }
    if p == 0 { return "/"; }
    return sub(path, 0, p);
}

fn join_path(base: str8, tail: str8) -> str8 {
    if len(base) == 0 {
        return tail;
    }
    if ends_with(base, "/") == 1 {
        return concat(base, tail);
    }
    return concat(concat(base, "/"), tail);
}

fn stdlib_lib_exists(dir: str8) -> i32 {
    if file_exists(concat(dir, "/libmlang_std.a")) == 1 { return 1; }
    if file_exists(concat(dir, "/libmlang_std.so")) == 1 { return 1; }
    if file_exists(concat(dir, "/libmlang_std.dylib")) == 1 { return 1; }
    return 0;
}

fn list_contains(values: list<str8>, needle: str8) -> i32 {
    for v in values {
        if eq(v, needle) == 1 {
            return 1;
        }
    }
    return 0;
}

fn split_env_paths(env: str8) -> list<str8> {
    var out: list<str8> = [];
    var cur: str8 = String::new();
    let n: i64 = len(env);
    for i in 0..n {
        let ch: str8 = sub(env, i, 1);
        if eq(ch, ":") == 1 {
            if len(trim(cur)) > 0 {
                out.push(cur);
            }
            cur = String::new();
            continue;
        }
        cur = concat(cur, ch);
    }
    if len(trim(cur)) > 0 {
        out.push(cur);
    }
    return out;
}

fn default_stdlib_paths() -> list<str8> {
    var out: list<str8> = [];
    let stdlib_path: str8 = getenv_value("MLANG_STDLIB_PATH");
    if len(stdlib_path) > 0 {
        let env_paths: list<str8> = split_env_paths(stdlib_path);
        for p in env_paths {
            if len(trim(p)) > 0 {
                out.push(p);
            }
        }
    }
    let src_dir: str8 = getenv_value("MLANG_STDLIB_SOURCE_DIR");
    if len(src_dir) > 0 {
        out.push(src_dir);
    }
    let xdg: str8 = getenv_value("XDG_DATA_HOME");
    if len(xdg) > 0 {
        out.push(concat(xdg, "/mlang/stdlib"));
    }
    let home: str8 = getenv_value("HOME");
    if len(home) > 0 {
        out.push(concat(home, "/.local/share/mlang/stdlib"));
    }
    let install_dir: str8 = getenv_value("MLANG_STDLIB_INSTALL_DIR");
    if len(install_dir) > 0 {
        out.push(install_dir);
    }
    out.push("/usr/local/share/mlang/stdlib");
    out.push("/usr/share/mlang/stdlib");
    return out;
}

fn extend_unique(dest: list<str8>, src: list<str8>) -> list<str8> {
    var out: list<str8> = [];
    for v in dest { out.push(v); }
    for v in src {
        if list_contains(out, v) == 0 {
            out.push(v);
        }
    }
    return out;
}

fn append_stdlib_paths(paths: list<str8>) -> list<str8> {
    return extend_unique(paths, default_stdlib_paths());
}

fn default_stdlib_lib_paths() -> list<str8> {
    var out: list<str8> = [];
    let lib_path: str8 = getenv_value("MLANG_STDLIB_LIB_PATH");
    if len(lib_path) > 0 {
        let env_lib_paths: list<str8> = split_env_paths(lib_path);
        for p in env_lib_paths {
            if len(trim(p)) > 0 {
                out.push(p);
            }
        }
    }
    let home: str8 = getenv_value("HOME");
    if len(home) > 0 {
        out.push(concat(home, "/.local/lib"));
        out.push(concat(home, "/.local/lib/mlang"));
    }
    let install_lib: str8 = getenv_value("MLANG_STDLIB_LIB_INSTALL_DIR");
    if len(install_lib) > 0 {
        out.push(install_lib);
    }
    out.push("/usr/local/lib");
    out.push("/usr/local/lib/mlang");
    out.push("/usr/lib");
    out.push("/usr/lib/mlang");
    return out;
}

fn ensure_stdlib_link_args(args: list<str8>, backend: str8) -> list<str8> {
    var out: list<str8> = [];
    var has_stdlib: i32 = 0;
    for a in args {
        if eq(a, "-lmlang_std") == 1 || eq(a, "-lmlang_stdlib") == 1 {
            has_stdlib = 1;
        }
        out.push(a);
    }
    if has_stdlib == 1 {
        return out;
    }

    var search_paths: list<str8> = [];
    let be_dir: str8 = parent_dir(backend);
    if len(trim(be_dir)) > 0 {
        search_paths.push(be_dir);
        search_paths.push(concat(be_dir, "/../lib"));
        search_paths.push(concat(be_dir, "/../"));
    }
    let stdlib_lib_paths: list<str8> = default_stdlib_lib_paths();
    for p in stdlib_lib_paths {
        search_paths.push(p);
    }

    var seen: list<str8> = [];
    var found: str8 = "";
    for p in search_paths {
        let trimmed: str8 = trim(p);
        if len(trimmed) == 0 { continue; }
        if list_contains(seen, trimmed) == 1 { continue; }
        seen.push(trimmed);
        if stdlib_lib_exists(trimmed) == 1 {
            found = trimmed;
            break;
        }
    }
    if len(found) == 0 {
        return out;
    }

    let link_dir_flag: str8 = format!("-L{}", found);
    if list_contains(out, link_dir_flag) == 0 {
        out.push(link_dir_flag);
    }
    out.push("-lmlang_std");
    if list_contains(out, "-lm") == 0 {
        out.push("-lm");
    }
    return out;
}

fn collect_dir_mla_files(path: str8) -> list<str8> {
    let cmd: str8 = format!("find {} -maxdepth 1 -type f -name '*.mla' | sort", shell_quote(path));
    let rr: Result<str8, str8> = run_capture_stdout("/bin/sh", ["-c", cmd]);
    if rr.is_err() {
        return [];
    }
    return split_lines(rr.unwrap());
}

fn path_is_directory(path: str8) -> i32 {
    let cmd: str8 = format!("test -d {}", shell_quote(path));
    let rc: i32 = run_inherit("/bin/sh", ["-c", cmd]);
    return rc == 0 ? 1 : 0;
}

fn file_mtime_ge(lhs: str8, rhs: str8) -> i32 {
    let qlhs: str8 = shell_quote(lhs);
    let qrhs: str8 = shell_quote(rhs);
    var cmd: str8 = concat("test -e ", qlhs);
    cmd = concat(cmd, " && test -e ");
    cmd = concat(cmd, qrhs);
    cmd = concat(cmd, " && ! test ");
    cmd = concat(cmd, qlhs);
    cmd = concat(cmd, " -ot ");
    cmd = concat(cmd, qrhs);
    let rc: i32 = run_inherit("/bin/sh", ["-c", cmd]);
    return rc == 0 ? 1 : 0;
}

fn abspath(path: str8) -> str8 {
    let trimmed: str8 = trim(path);
    if len(trimmed) == 0 { return String::new(); }
    var dir: str8 = trimmed;
    if path_is_directory(trimmed) == 0 {
        dir = parent_dir(trimmed);
    }
    if len(trim(dir)) == 0 { dir = "."; }
    let cmd: str8 = format!("cd {} && pwd", shell_quote(dir));
    let rr: Result<str8, str8> = run_capture_stdout("/bin/sh", ["-c", cmd]);
    if rr.is_err() {
        return dir;
    }
    return trim(rr.unwrap());
}

fn split_toml_array(input: str8) -> list<str8> {
    var out: list<str8> = [];
    var cur: str8 = String::new();
    var in_quotes: i32 = 0;
    let n: i64 = len(input);
    for i in 0..n {
        let ch: str8 = sub(input, i, 1);
        if eq(ch, "\"") == 1 {
            if in_quotes == 0 {
                in_quotes = 1;
            } else {
                in_quotes = 0;
            }
            cur = concat(cur, ch);
            continue;
        }
        if eq(ch, ",") == 1 && in_quotes == 0 {
            let trimmed: str8 = trim(cur);
            if len(trimmed) > 0 {
                out.push(trimmed);
            }
            cur = String::new();
            continue;
        }
        cur = concat(cur, ch);
    }
    let trimmed: str8 = trim(cur);
    if len(trimmed) > 0 {
        out.push(trimmed);
    }
    return out;
}

fn unquote(s: str8) -> str8 {
    let t: str8 = trim(s);
    let n: i64 = len(t);
    if n >= 2 && eq(sub(t, 0, 1), "\"") == 1 && eq(sub(t, n - 1, 1), "\"") == 1 {
        return sub(t, 1, n - 2);
    }
    return t;
}

fn parse_module_paths_from_toml(manifest: str8) -> list<str8> {
    let rr: Result<str8, str8> = read_all_text(manifest);
    if rr.is_err() {
        return [];
    }
    let lines: list<str8> = split_lines(rr.unwrap());
    var out: list<str8> = [];
    var section: str8 = String::new();
    for line in lines {
        let trimmed: str8 = trim(line);
        if len(trimmed) == 0 { continue; }
        if eq(sub(trimmed, 0, 1), "#") == 1 { continue; }
        if len(trimmed) >= 2 && eq(sub(trimmed, 0, 1), "[") == 1 && eq(sub(trimmed, len(trimmed) - 1, 1), "]") == 1 {
            section = sub(trimmed, 1, len(trimmed) - 2);
            continue;
        }
        if eq(section, "package") == 0 && eq(section, "tool.mlang") == 0 {
            continue;
        }
        let eq_idx: i64 = find(trimmed, "=");
        if eq_idx < 0 { continue; }
        let key: str8 = trim(sub(trimmed, 0, eq_idx));
        if eq(key, "module_paths") == 0 {
            continue;
        }
        let value: str8 = trim(sub(trimmed, eq_idx + 1, len(trimmed) - eq_idx - 1));
        if len(value) == 0 { continue; }
        if len(value) >= 2 && eq(sub(value, 0, 1), "[") == 1 && eq(sub(value, len(value) - 1, 1), "]") == 1 {
            let inner: str8 = sub(value, 1, len(value) - 2);
            let toml_parts: list<str8> = split_toml_array(inner);
            for part in toml_parts {
                let path: str8 = unquote(part);
                if len(path) > 0 {
                    out.push(path);
                }
            }
        } else {
            let path: str8 = unquote(value);
            if len(path) > 0 {
                out.push(path);
            }
        }
    }
    return out;
}

fn find_manifest_path(start_dir: str8) -> str8 {
    var cur: str8 = abspath(start_dir);
    if len(cur) == 0 {
        cur = ".";
    }
    while len(cur) > 0 {
        let candidate: str8 = join_path(cur, "mlang.toml");
        if file_exists(candidate) == 1 {
            return candidate;
        }
        let parent: str8 = parent_dir(cur);
        if eq(parent, cur) == 1 {
            break;
        }
        cur = parent;
    }
    return String::new();
}

fn getenv_value(name: str8) -> str8 {
    let rr: Result<str8, str8> = run_capture_stdout("/usr/bin/printenv", [name]);
    if rr.is_err() {
        return String::new();
    }
    return trim(rr.unwrap());
}

fn tiny_hash_u31(s: str8) -> i64 {
    var h: i64 = 216613626;
    let n: i64 = len(s);
    for i in 0..n {
        let ch: str8 = sub(s, i, 1);
        let v: i64 = find("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/_-.:", ch);
        let add: i64 = v >= 0 ? (v + 1) : 97;
        h = (h * 131 + add) % 2147483647;
    }
    if h < 0 {
        h = 0 - h;
    }
    return h;
}

fn tiny_hash_u31_alt(s: str8) -> i64 {
    var h: i64 = 16777619;
    let n: i64 = len(s);
    for i in 0..n {
        let ch: str8 = sub(s, i, 1);
        let v: i64 = find("9876543210ZYXWVUTSRQPONMLKJIHGFEDCBAzyxwvutsrqponmlkjihgfedcba:.-_/",
                          ch);
        let add: i64 = v >= 0 ? (v + 3) : 131;
        h = (h * 137 + add) % 2147483647;
    }
    if h < 0 {
        h = 0 - h;
    }
    return h;
}

fn pkg_frontend_bin_path(backend: str8, src: str8) -> str8 {
    let cache_key: str8 = getenv_value("MLANG_PKG_CACHE_KEY");
    let seed: str8 = format!("{}|{}|{}", backend, src, cache_key);
    let h1: i64 = tiny_hash_u31(seed);
    let h2: i64 = tiny_hash_u31_alt(seed);
    let bl: i64 = len(backend);
    let sl: i64 = len(src);
    return format!("/tmp/mlang-pkg-mla-{}-{}-{}-{}", h1, h2, bl, sl);
}

fn find_pkg_frontend_source(backend: str8) -> str8 {
    let c1: str8 = "tools/mlang-pkg-mla/main.mla";
    if file_exists(c1) == 1 { return c1; }
    let be_dir: str8 = parent_dir(backend);
    let c2: str8 = concat(be_dir, "/../tools/mlang-pkg-mla/main.mla");
    if file_exists(c2) == 1 { return c2; }
    let c3: str8 = concat(be_dir, "/tools/mlang-pkg-mla/main.mla");
    if file_exists(c3) == 1 { return c3; }
    return String::new();
}

fn run_pkg_frontend_mla(backend: str8, passthrough: list<str8>) -> i32 {
    let src: str8 = find_pkg_frontend_source(backend);
    if len(src) == 0 { return -1; }
    let tmp_bin: str8 = pkg_frontend_bin_path(backend, src);
    var need_compile: i32 = 1;
    if file_exists(tmp_bin) == 1 && file_mtime_ge(tmp_bin, src) == 1 {
        need_compile = 0;
    }
    if need_compile == 1 {
        let compile_base: list<str8> = [
            src,
            "-Wno-colon-if",
            "-Wno-colon-while",
            "-o", tmp_bin
        ];
        let compile_args: list<str8> = ensure_stdlib_link_args(compile_base, backend);
        let compile_cmd: str8 = build_shell_command(backend, compile_args);
        let compile_rc: i32 = run_shell_inherit(concat("MLANG_FRONTEND_IMPL=cpp ", compile_cmd));
        if compile_rc != 0 {
            return -1;
        }
    }
    var run_args: list<str8> = ["--backend", backend];
    let n: i64 = passthrough.len();
    for i in 0..n {
        run_args.push(passthrough[i]);
    }
    let run_cmd: str8 = build_shell_command(tmp_bin, run_args);
    return run_shell_inherit(concat("MLANG_FRONTEND_IMPL=cpp ", run_cmd));
}

fn backend_can_run_pkg_mla(backend: str8) -> i32 {
    let be_name: str8 = basename(backend);
    if contains(be_name, "mlang") == 1 {
        return 1;
    }
    return 0;
}

fn clone_args(args: list<str8>) -> list<str8> {
    var out: list<str8> = [];
    let n: i64 = args.len();
    for i in 0..n {
        out.push(args[i]);
    }
    return out;
}

fn is_test_suite_file(path: str8) -> i32 {
    let name: str8 = basename(path);
    if starts_with(name, "test_") == 1 { return 1; }
    if ends_with(name, "_tests.mla") == 1 { return 1; }
    return 0;
}

fn is_bench_suite_file(path: str8) -> i32 {
    let name: str8 = basename(path);
    return starts_with(name, "bench_");
}

fn is_digit_char(ch: str8) -> i32 {
    if eq(ch, "0") == 1 { return 1; }
    if eq(ch, "1") == 1 { return 1; }
    if eq(ch, "2") == 1 { return 1; }
    if eq(ch, "3") == 1 { return 1; }
    if eq(ch, "4") == 1 { return 1; }
    if eq(ch, "5") == 1 { return 1; }
    if eq(ch, "6") == 1 { return 1; }
    if eq(ch, "7") == 1 { return 1; }
    if eq(ch, "8") == 1 { return 1; }
    if eq(ch, "9") == 1 { return 1; }
    return 0;
}

fn is_signed_decimal(s: str8) -> i32 {
    let n: i64 = len(s);
    if n <= 0 { return 0; }
    var start: i64 = 0;
    let first: str8 = sub(s, 0, 1);
    if eq(first, "+") == 1 || eq(first, "-") == 1 {
        if n == 1 { return 0; }
        start = 1;
    }
    for i in start..n {
        if is_digit_char(sub(s, i, 1)) == 0 { return 0; }
    }
    return 1;
}

fn normalize_signed_decimal(s: str8) -> str8 {
    let n: i64 = len(s);
    if n <= 0 { return s; }
    let first: str8 = sub(s, 0, 1);
    var sign: str8 = String::new();
    var start: i64 = 0;
    if eq(first, "+") == 1 || eq(first, "-") == 1 {
        sign = first;
        start = 1;
    }
    while start < n {
        if eq(sub(s, start, 1), "0") == 1 {
            start = start + 1;
            continue;
        }
        break;
    }
    if start >= n {
        return "0";
    }
    let digits: str8 = sub(s, start, n - start);
    if eq(sign, "-") == 1 {
        return concat("-", digits);
    }
    return digits;
}

fn abs_decimal_leq(s_abs: str8, limit_abs: str8) -> i32 {
    let a_len: i64 = len(s_abs);
    let l_len: i64 = len(limit_abs);
    if a_len < l_len { return 1; }
    if a_len > l_len { return 0; }
    return compare(s_abs, limit_abs) <= 0;
}

fn fits_i32_decimal(s: str8) -> i32 {
    if eq(s, "0") == 1 { return 1; }
    if starts_with(s, "-") == 1 {
        let abs_s: str8 = sub(s, 1, len(s) - 1);
        return abs_decimal_leq(abs_s, "2147483648");
    }
    return abs_decimal_leq(s, "2147483647");
}

fn is_effective_zero_decimal(s: str8) -> i32 {
    let n: i64 = len(s);
    if n <= 0 { return 0; }
    var start: i64 = 0;
    let first: str8 = sub(s, 0, 1);
    if eq(first, "+") == 1 || eq(first, "-") == 1 {
        if n == 1 { return 0; }
        start = 1;
    }
    var saw_digit: i32 = 0;
    for i in start..n {
        let ch: str8 = sub(s, i, 1);
        if is_digit_char(ch) == 0 { return 0; }
        saw_digit = 1;
        if eq(ch, "0") == 0 { return 0; }
    }
    if saw_digit == 0 { return 0; }
    return 1;
}

fn normalize_bench_iters_value(v: str8) -> str8 {
    if starts_with(v, "-") == 1 || is_effective_zero_decimal(v) == 1 {
        return "1";
    }
    return v;
}

fn normalize_bench_warmup_value(v: str8) -> str8 {
    if starts_with(v, "-") == 1 {
        return "0";
    }
    return v;
}

fn option_takes_value(a: str8) -> i32 {
    if eq(a, "-o") == 1 { return 1; }
    if eq(a, "-L") == 1 { return 1; }
    if eq(a, "-l") == 1 { return 1; }
    if eq(a, "--target-arch") == 1 { return 1; }
    if eq(a, "--bench-iters") == 1 { return 1; }
    if eq(a, "--bench-warmup") == 1 { return 1; }
    return 0;
}

fn is_valid_target_arch(a: str8) -> i32 {
    if eq(a, "x86") == 1 { return 1; }
    if eq(a, "x64") == 1 { return 1; }
    if eq(a, "aarch64") == 1 { return 1; }
    if eq(a, "i386") == 1 { return 1; }
    if eq(a, "i686") == 1 { return 1; }
    if eq(a, "x86_64") == 1 { return 1; }
    if eq(a, "amd64") == 1 { return 1; }
    if eq(a, "arm64") == 1 { return 1; }
    return 0;
}

fn is_known_test_or_bench_flag(a: str8) -> i32 {
    if eq(a, "-c") == 1 { return 1; }
    if eq(a, "-S") == 1 { return 1; }
    if eq(a, "-emit-llvm") == 1 { return 1; }
    if eq(a, "-emit-bc") == 1 { return 1; }
    if eq(a, "-O0") == 1 { return 1; }
    if eq(a, "-O1") == 1 { return 1; }
    if eq(a, "-O2") == 1 { return 1; }
    if eq(a, "-O3") == 1 { return 1; }
    if eq(a, "-v") == 1 { return 1; }
    if eq(a, "--debug") == 1 { return 1; }
    if eq(a, "--no-tests") == 1 { return 1; }
    if eq(a, "--tests") == 1 { return 1; }
    if eq(a, "--target-arch") == 1 { return 1; }
    if eq(a, "-Wno-colon-if") == 1 { return 1; }
    if eq(a, "-Wno-colon-while") == 1 { return 1; }
    if starts_with(a, "-Wl,") == 1 && len(a) > 4 { return 1; }
    if starts_with(a, "-L") == 1 && len(a) > 2 { return 1; }
    if starts_with(a, "-l") == 1 && len(a) > 2 { return 1; }
    return 0;
}

fn is_test_or_bench_mode_only_flag(a: str8) -> i32 {
    if eq(a, "--no-run") == 1 { return 1; }
    if eq(a, "--bench-iters") == 1 { return 1; }
    if eq(a, "--bench-warmup") == 1 { return 1; }
    if starts_with(a, "--bench-iters=") == 1 { return 1; }
    if starts_with(a, "--bench-warmup=") == 1 { return 1; }
    return 0;
}

fn file_has_test_attr(path: str8) -> i32 {
    let rr: Result<str8, str8> = read_all_text(path);
    if rr.is_err() {
        return 0;
    }
    return contains(rr.unwrap(), "#[test]");
}

fn run_test_directory_mode(backend: str8, path: str8, benchmark_mode: i32, extra_args: list<str8>) -> i32 {
    let files_all: list<str8> = collect_dir_mla_files(path);
    var files: list<str8> = [];
    for f in files_all {
        if len(trim(f)) == 0 { continue; }
        let name: str8 = basename(f);
        if eq(name, "__mlang_test_root.mla") == 1 { continue; }
        if benchmark_mode == 1 {
            if is_bench_suite_file(f) == 0 { continue; }
            files.push(f);
        } else {
            if is_test_suite_file(f) == 0 { continue; }
            if file_has_test_attr(f) == 0 { continue; }
            files.push(f);
        }
    }

    if files.len() == 0 {
        if benchmark_mode == 1 {
            eprintln!("Error: No .mla benchmark files found in {}", path);
        } else {
            eprintln!("Error: No .mla test files found in {}", path);
        }
        return 1;
    }

    var fail_count: i32 = 0;
    for f in files {
        let suite_name: str8 = basename(f);
        println!("[SUITE] {}", suite_name);
        var cmd: list<str8> = [];
        if benchmark_mode == 1 {
            cmd.push("bench");
            cmd.push(f);
        } else {
            cmd.push("--tests");
            cmd.push(f);
        }
        for a in extra_args {
            cmd.push(a);
        }
        let rc: i32 = run_inherit(backend, cmd);
        if rc == 0 {
            println!("[SUITE PASS] {}", suite_name);
        } else {
            println!("[SUITE FAIL] {} rc={}", suite_name, rc);
            fail_count = fail_count + 1;
        }
    }
    if fail_count == 0 {
        return 0;
    }
    return 1;
}

fn sanitize_dir_suite_args(args: list<str8>, benchmark_mode: i32) -> list<str8> {
    var out: list<str8> = [];
    var bench_iters_v: str8 = String::new();
    var bench_warmup_v: str8 = String::new();
    var have_bench_iters: i32 = 0;
    var have_bench_warmup: i32 = 0;
    let n: i64 = args.len();
    var i: i64 = 0;
    while i < n {
        let a: str8 = args[i];
        if eq(a, "-L") == 1 || eq(a, "-l") == 1 || eq(a, "--target-arch") == 1 || eq(a, "--bench-iters") == 1 || eq(a, "--bench-warmup") == 1 {
            if i + 1 < n {
                if eq(a, "--bench-iters") == 1 || eq(a, "--bench-warmup") == 1 {
                    if benchmark_mode == 1 {
                        if eq(a, "--bench-iters") == 1 {
                            bench_iters_v = args[i + 1];
                            have_bench_iters = 1;
                        } else {
                            bench_warmup_v = args[i + 1];
                            have_bench_warmup = 1;
                        }
                    }
                } else if eq(a, "--target-arch") == 1 {
                    if is_valid_target_arch(args[i + 1]) == 0 {
                        eprintln!("Invalid value for --target-arch: {} (expected x86, x64, or aarch64)", args[i + 1]);
                        return [];
                    }
                    out.push(a);
                    out.push(args[i + 1]);
                } else {
                    out.push(a);
                    out.push(args[i + 1]);
                }
                i = i + 2;
                continue;
            }
            i = i + 1;
            continue;
        }
        if starts_with(a, "-Wl,") == 1 && len(a) > 4 {
            out.push(a);
            i = i + 1;
            continue;
        }
        if starts_with(a, "-L") == 1 && len(a) > 2 {
            out.push(a);
            i = i + 1;
            continue;
        }
        if starts_with(a, "-l") == 1 && len(a) > 2 {
            out.push(a);
            i = i + 1;
            continue;
        }
        if benchmark_mode == 0 {
            if eq(a, "--no-run") == 1 || eq(a, "-Wno-colon-if") == 1 || eq(a, "-Wno-colon-while") == 1 {
                out.push(a);
                i = i + 1;
                continue;
            }
        }
        i = i + 1;
    }
    if benchmark_mode == 1 {
        if have_bench_iters == 1 {
            out.push("--bench-iters");
            out.push(bench_iters_v);
        }
        if have_bench_warmup == 1 {
            out.push("--bench-warmup");
            out.push(bench_warmup_v);
        }
    }
    return out;
}

fn resolve_default_backend(program: str8) -> str8 {
    let trimmed: str8 = trim(program);
    if len(trimmed) > 0 {
        let dir: str8 = parent_dir(trimmed);
        if len(dir) > 0 {
            let sibling: str8 = concat(dir, "/mlang");
            if file_exists(sibling) == 1 {
                return sibling;
            }
            let parent: str8 = parent_dir(dir);
            if len(parent) > 0 {
                let parent_sibling: str8 = concat(parent, "/mlang");
                if file_exists(parent_sibling) == 1 {
                    return parent_sibling;
                }
            }
        }
    }
    if file_exists("build/mlang") == 1 {
        return "build/mlang";
    }
    return "mlang";
}

fn parse_options(argv: list<str8>) -> FrontendState {
    var out: FrontendState = FrontendState {
        backend: "mlang",
        passthrough: [],
        show_help: 0,
        show_version: 0,
        parse_error: ""
    };

    let n: i64 = argv.len();
    var i: i64 = 1;
    var passthrough_started: i32 = 0;
    while i < n {
        let arg: str8 = argv[i];
        if passthrough_started == 1 {
            out.passthrough.push(arg);
            i = i + 1;
            continue;
	        }
        if (eq(arg, "--backend") == 1) {
            if i + 1 >= n {
                out.parse_error = "missing value after --backend";
                return out;
            }
            let backend_value: str8 = argv[i + 1];
            if starts_with(backend_value, "-") == 1 {
                out.parse_error = "missing value after --backend";
                return out;
            }
            out.backend = backend_value;
            i = i + 2;
            continue;
        }
        if (eq(arg, "--help") == 1 || eq(arg, "-h") == 1) {
            out.show_help = 1;
            return out;
        }
        if (eq(arg, "--version") == 1) {
            out.show_version = 1;
            return out;
        }
        passthrough_started = 1;
        out.passthrough.push(arg);
        i = i + 1;
    }

    return out;
}

fn main(argc: i32, args: list<str8>) -> i32 {
    let _ = argc;
    var argv: list<str8> = [];
    for a in args {
        argv.push(format!("{}", a));
    }

    var program: str8 = "mlang-frontend-mla";
    if (argv.len() > 0) {
        program = argv[0];
    }

    var st: FrontendState = parse_options(argv);
    if eq(st.backend, "mlang") == 1 {
        st.backend = resolve_default_backend(program);
    }
    if (eq(st.parse_error, "") == 0) {
        eprintln!("{}: {}", program, st.parse_error);
        print_usage(program);
        return 2;
    }

    if (st.show_help == 1) {
        print_usage(program);
        return 0;
    }
    if (st.show_version == 1) {
        println!("mlang-frontend-mla {}", version());
        return 0;
    }
    let passthrough: list<str8> = st.passthrough;
    if (passthrough.len() == 0) {
        eprintln!("Error: No input file specified");
        print_usage(program);
        return 1;
    }
    let first: str8 = passthrough[0];
    if eq(first, "pkg") == 1 {
        let impl_val: str8 = getenv_value("MLANG_PKG_IMPL");
        let force_cpp: i32 = eq(impl_val, "cpp");
        var prefer_mla: i32 = 0;
        if len(impl_val) == 0 || eq(impl_val, "mla") == 1 {
            prefer_mla = 1;
        }
        if prefer_mla == 1 && force_cpp == 0 && backend_can_run_pkg_mla(st.backend) == 1 {
            var pkg_args: list<str8> = [];
            let pkg_n: i64 = passthrough.len();
            for pi in 0..pkg_n {
                pkg_args.push(passthrough[pi]);
            }
            let mla_rc: i32 = run_pkg_frontend_mla(st.backend, pkg_args);
            if mla_rc == 0 {
                return 0;
            }
        }
        var passthrough_args: list<str8> = [];
        let pass_n: i64 = passthrough.len();
        for pi in 0..pass_n {
            passthrough_args.push(passthrough[pi]);
        }
        return run_inherit(st.backend, passthrough_args);
    }

    var mode_test: i32 = 0;
    var mode_bench: i32 = 0;
    var idx: i64 = 0;
    if eq(first, "test") == 1 {
        mode_test = 1;
        idx = 1;
    } else if eq(first, "bench") == 1 {
        mode_test = 1;
        mode_bench = 1;
        idx = 1;
    } else if passthrough.len() >= 2 && eq(first, "run") == 1 && eq(passthrough[1], "tests") == 1 {
        mode_test = 1;
        idx = 2;
    } else if eq(first, "--tests") == 1 {
        mode_test = 1;
        idx = 1;
    }
    if mode_test == 0 {
        var compile_in: list<str8> = [];
        let compile_n: i64 = passthrough.len();
        var compile_test_mode: i32 = 0;
        var compile_test_short_circuit: i32 = 0;
        var saw_compile_input: i32 = 0;
        var saw_compile_help_or_version: i32 = 0;
        var has_no_colon_if: i32 = 0;
        var has_no_colon_while: i32 = 0;
        var ci: i64 = 0;
        while ci < compile_n {
            let ca: str8 = passthrough[ci];
            if eq(ca, "--tests") == 1 {
                compile_test_mode = 1;
                compile_in.push(ca);
                ci = ci + 1;
                continue;
            }
            if compile_test_short_circuit == 1 {
                compile_in.push(ca);
                ci = ci + 1;
                continue;
            }
            if compile_test_mode == 1 && (eq(ca, "--help") == 1 || eq(ca, "-h") == 1 || eq(ca, "--version") == 1) {
                compile_test_short_circuit = 1;
                compile_in.push(ca);
                ci = ci + 1;
                continue;
            }
            if compile_test_mode == 1 && (starts_with(ca, "--bench-iters=") == 1 || starts_with(ca, "--bench-warmup=") == 1) {
                eprintln!("Unknown option: {}", ca);
                let _ = run_inherit(st.backend, ["--help"]);
                return 1;
            }
            if compile_test_mode == 0 && is_test_or_bench_mode_only_flag(ca) == 1 {
                eprintln!("Unknown option: {}", ca);
                let _ = run_inherit(st.backend, ["--help"]);
                return 1;
            }
            if option_takes_value(ca) == 1 {
                compile_in.push(ca);
                if ci + 1 >= compile_n {
                    eprintln!("Unknown option: {}", ca);
                    let _ = run_inherit(st.backend, ["--help"]);
                    return 1;
                }
                let cv: str8 = passthrough[ci + 1];
                if compile_test_mode == 1 && eq(ca, "--bench-iters") == 1 {
                    if is_signed_decimal(cv) == 0 {
                        eprintln!("Invalid value for --bench-iters");
                        return 1;
                    }
                    let cv_norm: str8 = normalize_signed_decimal(cv);
                    if fits_i32_decimal(cv_norm) == 0 {
                        eprintln!("Invalid value for --bench-iters");
                        return 1;
                    }
                    compile_in.push(normalize_bench_iters_value(cv_norm));
                } else if compile_test_mode == 1 && eq(ca, "--bench-warmup") == 1 {
                    if is_signed_decimal(cv) == 0 {
                        eprintln!("Invalid value for --bench-warmup");
                        return 1;
                    }
                    let cv_norm: str8 = normalize_signed_decimal(cv);
                    if fits_i32_decimal(cv_norm) == 0 {
                        eprintln!("Invalid value for --bench-warmup");
                        return 1;
                    }
                    compile_in.push(normalize_bench_warmup_value(cv_norm));
                } else {
                    compile_in.push(cv);
                }
                ci = ci + 2;
                continue;
            }
            compile_in.push(ca);
            if eq(ca, "--help") == 1 || eq(ca, "-h") == 1 || eq(ca, "--version") == 1 {
                saw_compile_help_or_version = 1;
            }
            if eq(ca, "-Wno-colon-if") == 1 {
                has_no_colon_if = 1;
            }
            if eq(ca, "-Wno-colon-while") == 1 {
                has_no_colon_while = 1;
            }
            if starts_with(ca, "-") == 0 {
                saw_compile_input = 1;
            }
            ci = ci + 1;
        }
        if compile_test_mode == 0 && saw_compile_input == 0 && saw_compile_help_or_version == 0 {
            eprintln!("Error: No input file specified");
            print_usage(program);
            return 1;
        }
        if compile_test_mode == 1 {
            if has_no_colon_if == 0 {
                compile_in.push("-Wno-colon-if");
            }
            if has_no_colon_while == 0 {
                compile_in.push("-Wno-colon-while");
            }
        }
        let compile_args: list<str8> = ensure_stdlib_link_args(compile_in, st.backend);
        return run_inherit(st.backend, compile_args);
    }

    var input_path: str8 = "tests";
    var extra_args: list<str8> = [];
    var test_no_run: i32 = 0;
    var bench_no_run: i32 = 0;
    var bench_iters_value: str8 = String::new();
    var bench_warmup_value: str8 = String::new();
    var bench_iters_seen: i32 = 0;
    var bench_warmup_seen: i32 = 0;
    let n: i64 = passthrough.len();
    var i: i64 = idx;
	    while i < n {
        let a: str8 = passthrough[i];
        if eq(a, "--version") == 1 {
            return run_inherit(st.backend, ["--version"]);
        }
        if eq(a, "--help") == 1 || eq(a, "-h") == 1 {
            return run_inherit(st.backend, ["--help"]);
        }
        if option_takes_value(a) == 1 {
            if i + 1 >= n {
                eprintln!("Unknown option: {}", a);
                let _ = run_inherit(st.backend, ["--help"]);
                return 1;
            }
            let v: str8 = passthrough[i + 1];
            if eq(a, "--target-arch") == 1 {
                if is_valid_target_arch(v) == 0 {
                    eprintln!("Invalid value for --target-arch: {} (expected x86, x64, or aarch64)", v);
                    return 1;
                }
                extra_args.push(a);
                extra_args.push(v);
            } else if eq(a, "--bench-iters") == 1 {
                if is_signed_decimal(v) == 0 {
                    eprintln!("Invalid value for --bench-iters");
                    return 1;
                }
                let v_norm: str8 = normalize_signed_decimal(v);
                if fits_i32_decimal(v_norm) == 0 {
                    eprintln!("Invalid value for --bench-iters");
                    return 1;
                }
                bench_iters_value = normalize_bench_iters_value(v_norm);
                bench_iters_seen = 1;
            } else if eq(a, "--bench-warmup") == 1 {
                if is_signed_decimal(v) == 0 {
                    eprintln!("Invalid value for --bench-warmup");
                    return 1;
                }
                let v_norm: str8 = normalize_signed_decimal(v);
                if fits_i32_decimal(v_norm) == 0 {
                    eprintln!("Invalid value for --bench-warmup");
                    return 1;
                }
                bench_warmup_value = normalize_bench_warmup_value(v_norm);
                bench_warmup_seen = 1;
            } else {
                extra_args.push(a);
                extra_args.push(v);
            }
            i = i + 2;
            continue;
        }
        if eq(a, "--no-run") == 1 {
            if mode_bench == 0 {
                test_no_run = 1;
            } else {
                bench_no_run = 1;
            }
            i = i + 1;
            continue;
        }
        if eq(a, "--tests") == 1 {
            if mode_bench == 0 {
                test_no_run = 0;
            }
            i = i + 1;
            continue;
        }
        if starts_with(a, "-") == 0 {
            input_path = a;
            i = i + 1;
            continue;
        } else if is_known_test_or_bench_flag(a) == 1 {
            extra_args.push(a);
        } else {
            eprintln!("Unknown option: {}", a);
            let _ = run_inherit(st.backend, ["--help"]);
            return 1;
        }
        i = i + 1;
    }
    if bench_iters_seen == 1 {
        extra_args.push("--bench-iters");
        extra_args.push(bench_iters_value);
    }
    if bench_warmup_seen == 1 {
        extra_args.push("--bench-warmup");
        extra_args.push(bench_warmup_value);
    }
    var has_no_colon_if: i32 = 0;
    var has_no_colon_while: i32 = 0;
    var has_bench_iters: i32 = 0;
    var has_bench_warmup: i32 = 0;
    let ea_n: i64 = extra_args.len();
    for j in 0..ea_n {
        if eq(extra_args[j], "-Wno-colon-if") == 1 { has_no_colon_if = 1; }
        if eq(extra_args[j], "-Wno-colon-while") == 1 { has_no_colon_while = 1; }
        if eq(extra_args[j], "--bench-iters") == 1 { has_bench_iters = 1; }
        if eq(extra_args[j], "--bench-warmup") == 1 { has_bench_warmup = 1; }
    }
    if mode_bench == 0 {
        if has_no_colon_if == 0 { extra_args.push("-Wno-colon-if"); }
        if has_no_colon_while == 0 { extra_args.push("-Wno-colon-while"); }
        if test_no_run == 1 { extra_args.push("--no-run"); }
    }
    let input_is_dir: i32 = path_is_directory(input_path);
    if mode_bench == 1 && input_is_dir == 1 {
        if has_bench_iters == 0 {
            extra_args.push("--bench-iters");
            extra_args.push("100000");
        }
        if has_bench_warmup == 0 {
            extra_args.push("--bench-warmup");
            extra_args.push("10000");
        }
    }
    if input_is_dir == 1 {
        let suite_args: list<str8> = sanitize_dir_suite_args(extra_args, mode_bench);
        return run_test_directory_mode(st.backend, input_path, mode_bench, suite_args);
    }
    if mode_bench == 1 && bench_no_run == 1 {
        extra_args.push("--no-run");
    }

    var single: list<str8> = [];
    if mode_bench == 1 {
        single.push("bench");
        single.push(input_path);
    } else {
        single.push("--tests");
        single.push(input_path);
    }
    for a in extra_args {
        single.push(a);
    }
    return run_inherit(st.backend, single);
}
