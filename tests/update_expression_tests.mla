mod std::testing;

use std::testing::verify;
// Tests for prefix/postfix ++/-- (UpdateExpression)

#[test]
fn test_postfix_increment() {
    var x: i32 = 5;
    let old: i32 = x++;
    verify(!(old != 5));
    verify(!(x != 6));
    }

#[test]
fn test_postfix_decrement() {
    var x: i32 = 5;
    let old: i32 = x--;
    verify(!(old != 5));
    verify(!(x != 4));
    }

#[test]
fn test_prefix_increment() {
    var x: i32 = 5;
    let new_val: i32 = ++x;
    verify(!(new_val != 6));
    verify(!(x != 6));
    }

#[test]
fn test_prefix_decrement() {
    var x: i32 = 5;
    let new_val: i32 = --x;
    verify(!(new_val != 4));
    verify(!(x != 4));
    }

#[test]
fn test_increment_in_loop() {
    var sum: i32 = 0;
    var i: i32 = 0;
    while i < 5: {
        sum = sum + 1;
        i++;
    }
    verify(!(sum != 5));
    }

#[test]
fn test_decrement_in_loop() {
    var count: i32 = 0;
    var i: i32 = 5;
    while i > 0: {
        count = count + 1;
        i--;
    }
    verify(!(count != 5));
    }

#[test]
fn test_prefix_vs_postfix_distinction() {
    var a: i32 = 10;
    var b: i32 = 10;
    let post: i32 = a++;
    let pre: i32  = ++b;
    // post == 10 (old), a == 11; pre == 11 (new), b == 11
    verify(!(post != 10));
    verify(!(a != 11));
    verify(!(pre != 11));
    verify(!(b != 11));
    }

#[test]
fn test_increment_i64() {
    var x: i64 = 100;
    x++;
    verify(!(x != 101));
    }

trait Increment {
    fn increment(self: &mut Self) -> void;
}

trait Decrement {
    fn decrement(self: &mut Self) -> void;
}

struct Counter {
    var value: i32;
};

impl Increment for Counter {
    fn increment(self: &mut Self) -> void {
        self.value += 1;
    }
}

impl Decrement for Counter {
    fn decrement(self: &mut Self) -> void {
        self.value -= 1;
    }
}

#[test]
fn test_trait_increment_decrement_mut_self_void() {
    var c: Counter = Counter { value: 1 };

    let old: Counter = c++;
    verify(!(old.value != 1));
    verify(!(c.value != 2));

    let new_val: Counter = ++c;
    verify(!(new_val.value != 3));
    verify(!(c.value != 3));

    c--;
    verify(!(c.value != 2));
    --c;
    verify(!(c.value != 1));
    }

struct CounterByValue {
    var value: i32;
};

impl Increment for CounterByValue {
    fn increment(self: CounterByValue) -> CounterByValue {
        return CounterByValue { value: self.value + 1 };
    }
}

impl Decrement for CounterByValue {
    fn decrement(self: CounterByValue) -> CounterByValue {
        return CounterByValue { value: self.value - 1 };
    }
}

#[test]
fn test_trait_increment_decrement_self_return_self() {
    var c: CounterByValue = CounterByValue { value: 10 };

    let old: CounterByValue = c++;
    verify(!(old.value != 10));
    verify(!(c.value != 11));

    let new_val: CounterByValue = --c;
    verify(!(new_val.value != 10));
    verify(!(c.value != 10));
    }
