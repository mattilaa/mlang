mod std::testing;
mod std::ops;

use std::ops::*;
use std::testing::verify;

struct Pair {
    var a: i32;
    var b: i32;
};

struct PairU64 {
    var a: u64;
    var b: u64;
};

impl Add for Pair {
    fn add(self: &mut Self, other: Pair) -> Pair {
        return Pair { a: self.a + other.a, b: self.b + other.b };
    }
}

impl Sub for Pair {
    fn sub(self: &mut Self, other: Pair) -> Pair {
        return Pair { a: self.a - other.a, b: self.b - other.b };
    }
}

impl Mul for Pair {
    fn mul(self: &mut Self, other: Pair) -> Pair {
        return Pair { a: self.a * other.a, b: self.b * other.b };
    }
}

impl Div for Pair {
    fn div(self: &mut Self, other: Pair) -> Pair {
        return Pair { a: self.a / other.a, b: self.b / other.b };
    }
}

impl Rem for Pair {
    fn rem(self: &mut Self, other: Pair) -> Pair {
        return Pair { a: self.a % other.a, b: self.b % other.b };
    }
}

impl Neg for Pair {
    fn neg(self: &mut Self) -> Pair {
        return Pair { a: -self.a, b: -self.b };
    }
}

impl Add for PairU64 {
    fn add(self: &mut Self, other: PairU64) -> PairU64 {
        return PairU64 { a: self.a + other.a, b: self.b + other.b };
    }
}

impl Mul for PairU64 {
    fn mul(self: &mut Self, other: PairU64) -> PairU64 {
        return PairU64 { a: self.a * other.a, b: self.b * other.b };
    }
}

impl Rem for PairU64 {
    fn rem(self: &mut Self, other: PairU64) -> PairU64 {
        return PairU64 { a: self.a % other.a, b: self.b % other.b };
    }
}

#[test]
fn test_trait_add_sub_mul() {
    let x1: Pair = Pair { a: 2, b: 3 };
    let y1: Pair = Pair { a: 4, b: 5 };
    let s: Pair = x1 + y1;
    if s.a != 6: { verify(false); }
    if s.b != 8: { verify(false); }

    let y2: Pair = Pair { a: 4, b: 5 };
    let x2: Pair = Pair { a: 2, b: 3 };
    let d: Pair = y2 - x2;
    if d.a != 2: { verify(false); }
    if d.b != 2: { verify(false); }

    let x3: Pair = Pair { a: 2, b: 3 };
    let y3: Pair = Pair { a: 4, b: 5 };
    let m: Pair = x3 * y3;
    if m.a != 8: { verify(false); }
    if m.b != 15: { verify(false); }

    }

#[test]
fn test_trait_div_rem_neg() {
    let x1: Pair = Pair { a: 8, b: 11 };
    let y1: Pair = Pair { a: 2, b: 5 };
    let q: Pair = x1 / y1;
    if q.a != 4: { verify(false); }
    if q.b != 2: { verify(false); }

    let x2: Pair = Pair { a: 8, b: 11 };
    let y2: Pair = Pair { a: 2, b: 5 };
    let r: Pair = x2 % y2;
    if r.a != 0: { verify(false); }
    if r.b != 1: { verify(false); }

    let x3: Pair = Pair { a: 8, b: 11 };
    let n: Pair = -x3;
    if n.a != -8: { verify(false); }
    if n.b != -11: { verify(false); }

    }

#[test]
fn test_trait_u64_add_mul_rem() {
    let x: PairU64 = PairU64 { a: 10, b: 21 };
    let y: PairU64 = PairU64 { a: 3, b: 5 };

    let s: PairU64 = x + y;
    if s.a != 13: { verify(false); }
    if s.b != 26: { verify(false); }

    let x2: PairU64 = PairU64 { a: 10, b: 21 };
    let y2: PairU64 = PairU64 { a: 3, b: 5 };
    let m: PairU64 = x2 * y2;
    if m.a != 30: { verify(false); }
    if m.b != 105: { verify(false); }

    let x3: PairU64 = PairU64 { a: 10, b: 21 };
    let y3: PairU64 = PairU64 { a: 3, b: 5 };
    let r: PairU64 = x3 % y3;
    if r.a != 1: { verify(false); }
    if r.b != 1: { verify(false); }

    }
