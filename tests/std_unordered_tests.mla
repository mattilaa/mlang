mod std::testing;
mod std::unordered;
use std::unordered::HashMapI64I64;
use std::unordered::HashSetI64;
use std::unordered::QuickMapI64I64;
use std::unordered::QuickMapVecI64I64;
use std::testing::verify;

#[test]
fn test_hash_map_basic_insert_get_remove() {
    let m: HashMapI64I64 = HashMapI64I64::new();

    m.insert(10, 100);
    m.insert(20, 200);
    m.insert(10, 111);

    verify(!(m.len() != 2));
    verify(!(m.contains(10) == 0));
    verify(!(m.get_or(10, -1) != 111));
    verify(!(m.get_or(999, -1) != -1));

    verify(!(m.remove(20) == 0));
    verify(!(m.contains(20) != 0));
    verify(!(m.len() != 1));

    m.close();
    }

#[test]
fn test_hash_map_rehash_many_values() {
    let m: HashMapI64I64 = HashMapI64I64::new();

    for i in 0..300 {
        m.insert(i, i * 3);
    }

    verify(!(m.len() != 300));

    for i in 0..300 {
        verify(!(m.get_or(i, -1) != i * 3));
    }

    m.close();
    }

#[test]
fn test_hash_set_basic() {
    let s: HashSetI64 = HashSetI64::new();

    s.insert(7);
    s.insert(8);
    s.insert(7);

    verify(!(s.len() != 2));
    verify(!(s.contains(7) == 0));
    verify(!(s.contains(9) != 0));

    verify(!(s.remove(8) == 0));
    verify(!(s.contains(8) != 0));

    s.close();
    }

#[test]
fn test_quick_map_api() {
    let q: QuickMapI64I64 = QuickMapI64I64::new();

    q.set(1, 10);
    q.set(2, 20);
    q.set(1, 11);

    verify(!(q.len() != 2));
    verify(!(q.has(1) == 0));
    verify(!(q.get(1, -1) != 11));
    verify(!(q.get(99, -1) != -1));
    verify(!(q.del(2) == 0));
    verify(!(q.has(2) != 0));

    q.close();
    }

#[test]
fn test_quick_map_vec_api() {
    let q: QuickMapVecI64I64 = QuickMapVecI64I64::new();

    q.set(1, 10);
    q.set(2, 20);
    q.set(1, 11);

    verify(!(q.len() != 2));
    verify(!(q.has(1) == 0));
    verify(!(q.get(1, -1) != 11));
    verify(!(q.get(99, -1) != -1));
    verify(!(q.del(2) == 0));
    verify(!(q.has(2) != 0));

    q.close();
    }
