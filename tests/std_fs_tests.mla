mod std::testing;
mod std::fs;
mod std::strbuf;

use std::fs::BufReader;
use std::fs::File;
use std::fs::chdir;
use std::fs::cwd;
use std::fs::free_lines;
use std::strbuf::eq;
use std::strbuf::starts_with;
use std::testing::verify;

fn test_create_open_and_lines_impl() -> i32 {
    let path = "/tmp/mlang_std_fs_test.txt";

    let created: result<File, str8> = File::create(path);
    if created.is_err(): { return 1; }
    let wf: File = created.unwrap();
    let w1: result<i64, str8> = wf.write_line("alpha");
    if w1.is_err(): {
        wf.close();
        return 1;
    }
    let w2: result<i64, str8> = wf.write_line("beta");
    if w2.is_err(): {
        wf.close();
        return 1;
    }
    if wf.close() != 0: { return 1; }

    let opened: result<File, str8> = File::open(path);
    if opened.is_err(): { return 1; }
    let rf: File = opened.unwrap();

    let reader: BufReader = BufReader::new(rf);
    let lines: list<str8> = reader.lines();

    var count: i32 = 0;
    for line in lines {
        if count == 0: {
            if eq(line, "alpha") != 1: {
                free_lines(lines);
                return 1;
            }
        } else: {
            if count == 1: {
                if eq(line, "beta") != 1: {
                    free_lines(lines);
                    return 1;
                }
            }
        }
        count = count + 1;
    }

    free_lines(lines);
    return count == 2 ? 0 : 1;
}

#[test]
fn test_create_open_and_lines() {
    verify(test_create_open_and_lines_impl() == 0);
}

fn test_open_missing_file_is_err_impl() -> i32 {
    let missing: result<File, str8> = File::open("/tmp/mlang_std_fs_missing_no_such_file.txt");
    if missing.is_err(): {
        return 0;
    }
    return 1;
}

#[test]
fn test_open_missing_file_is_err() {
    verify(test_open_missing_file_is_err_impl() == 0);
}

fn test_chdir_updates_cwd_impl() -> i32 {
    let before: str8 = cwd();
    let parent: str8 = std::fs::parent_dir(before);
    if chdir(parent) != 0: {
        return 1;
    }
    let after: str8 = cwd();
    let restore_rc: i32 = chdir(before);
    if restore_rc != 0: {
        return 1;
    }
    if eq(after, parent) != 1 && starts_with(before, format!("{}/", after)) != 1: {
        return 1;
    }
    return 0;
}

#[test]
fn test_chdir_updates_cwd() {
    verify(test_chdir_updates_cwd_impl() == 0);
}
