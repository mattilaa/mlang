mod std::testing;
mod std::net;
mod std::strbuf;
mod std::thread;

use std::net::TcpListener;
use std::net::TcpStream;
use std::strbuf::eq;
use std::thread::join;
use std::testing::verify;

fn worker_echo_from_clone(stream_handle: i64) -> i32 {
    let s: TcpStream = TcpStream::from_handle(stream_handle);
    let w: Result<i64, string> = s.write("from-thread");
    s.close();
    if w.is_err(): {
        return 1;
    }
    return 0;
}

fn test_tcp_loopback_ping_pong_impl() -> i32 {
    let listener_r: Result<TcpListener, string> = TcpListener::bind("127.0.0.1", 0);
    if listener_r.is_err(): { return 0; }
    let listener: TcpListener = listener_r.unwrap();

    let port_r: Result<i64, string> = listener.local_port();
    if port_r.is_err(): {
        listener.close();
        return 0;
    }
    let port: i64 = port_r.unwrap();

    let client_r: Result<TcpStream, string> = TcpStream::connect("127.0.0.1", port);
    if client_r.is_err(): {
        listener.close();
        return 0;
    }
    let client: TcpStream = client_r.unwrap();

    let server_r: Result<TcpStream, string> = listener.accept();
    if server_r.is_err(): {
        client.close();
        listener.close();
        return 0;
    }
    let server: TcpStream = server_r.unwrap();

    let cw: Result<i64, string> = client.write("ping");
    if cw.is_err(): {
        server.close();
        client.close();
        listener.close();
        return 1;
    }

    var in1 = String::with_capacity(16);
    let sr: Result<i64, string> = server.read(in1, 16);
    if sr.is_err(): {
        String::free(in1);
        server.close();
        client.close();
        listener.close();
        return 1;
    }
    if eq(in1, "ping") != 1: {
        String::free(in1);
        server.close();
        client.close();
        listener.close();
        return 1;
    }
    String::free(in1);

    let sw: Result<i64, string> = server.write("pong");
    if sw.is_err(): {
        server.close();
        client.close();
        listener.close();
        return 1;
    }

    var in2 = String::with_capacity(16);
    let cr: Result<i64, string> = client.read(in2, 16);
    if cr.is_err(): {
        String::free(in2);
        server.close();
        client.close();
        listener.close();
        return 1;
    }
    let ok: i32 = eq(in2, "pong");
    String::free(in2);

    server.close();
    client.close();
    listener.close();
    return ok == 1 ? 0 : 1;
}

#[test]
fn test_tcp_loopback_ping_pong() {
    verify(test_tcp_loopback_ping_pong_impl() == 0);
}

fn test_tcp_stream_nonblocking_and_timeouts_impl() -> i32 {
    let listener_r: Result<TcpListener, string> = TcpListener::bind("127.0.0.1", 0);
    if listener_r.is_err(): { return 0; }
    let listener: TcpListener = listener_r.unwrap();

    let port_r: Result<i64, string> = listener.local_port();
    if port_r.is_err(): {
        listener.close();
        return 0;
    }
    let port: i64 = port_r.unwrap();

    let client_r: Result<TcpStream, string> = TcpStream::connect("127.0.0.1", port);
    if client_r.is_err(): {
        listener.close();
        return 0;
    }
    let client: TcpStream = client_r.unwrap();

    let server_r: Result<TcpStream, string> = listener.accept();
    if server_r.is_err(): {
        client.close();
        listener.close();
        return 0;
    }
    let server: TcpStream = server_r.unwrap();

    let nb: Result<i32, string> = client.set_nonblocking(1);
    if nb.is_err(): {
        server.close();
        client.close();
        listener.close();
        return 1;
    }
    let rt: Result<i32, string> = server.set_read_timeout_ms(200);
    if rt.is_err(): {
        server.close();
        client.close();
        listener.close();
        return 1;
    }
    let wt: Result<i32, string> = server.set_write_timeout_ms(200);
    if wt.is_err(): {
        server.close();
        client.close();
        listener.close();
        return 1;
    }

    server.close();
    client.close();
    listener.close();
    return 0;
}

#[test]
fn test_tcp_stream_nonblocking_and_timeouts() {
    verify(test_tcp_stream_nonblocking_and_timeouts_impl() == 0);
}

fn test_tcp_stream_try_clone_for_thread_handoff_impl() -> i32 {
    let listener_r: Result<TcpListener, string> = TcpListener::bind("127.0.0.1", 0);
    if listener_r.is_err(): { return 0; }
    let listener: TcpListener = listener_r.unwrap();

    let port_r: Result<i64, string> = listener.local_port();
    if port_r.is_err(): {
        listener.close();
        return 0;
    }
    let port: i64 = port_r.unwrap();

    let client_r: Result<TcpStream, string> = TcpStream::connect("127.0.0.1", port);
    if client_r.is_err(): {
        listener.close();
        return 0;
    }
    let client: TcpStream = client_r.unwrap();

    let server_r: Result<TcpStream, string> = listener.accept();
    if server_r.is_err(): {
        client.close();
        listener.close();
        return 0;
    }
    let server: TcpStream = server_r.unwrap();

    let clone_r: Result<TcpStream, string> = server.try_clone();
    if clone_r.is_err(): {
        server.close();
        client.close();
        listener.close();
        return 0;
    }
    let clone: TcpStream = clone_r.unwrap();

    let h: Handle<Thread> = thread_spawn(worker_echo_from_clone, clone.raw_handle());
    let join_rc: i32 = join(h);

    var buf = String::with_capacity(64);
    let r: Result<i64, string> = client.read(buf, 64);
    let same: i32 = eq(buf, "from-thread");
    String::free(buf);

    server.close();
    client.close();
    listener.close();

    if join_rc != 0: { return 1; }
    if r.is_err(): { return 1; }
    return same == 1 ? 0 : 1;
}

#[test]
fn test_tcp_stream_try_clone_for_thread_handoff() {
    verify(test_tcp_stream_try_clone_for_thread_handoff_impl() == 0);
}
