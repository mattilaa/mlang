mod std::testing;

use std::testing::verify;
enum Color {
    Red,
    Green,
    Blue
};

enum Status {
    Idle,
    Busy,
    Done
};

enum HttpMethod: str8 {
    Get = "GET",
    Post = "POST",
    Patch = "PATCH",
    Submit = HttpMethod::Post
};

enum HexColor: u32 {
    Red = 0x10,
    Green = 0x20,
    Blue = 0x2A
};

struct Outer {
    enum Inner {
        Low,
        High
    };
    var level: Outer::Inner;
};

fn color_code(c: Color) -> i32 {
    return match c {
        Color::Red => 1,
        Color::Green => 2,
        Color::Blue => 3,
        _ => 0
    };
}

fn status_score(s: Status) -> i32 {
    return match s {
        Status::Idle => 10,
        Status::Busy => 20,
        Status::Done => 30,
        _ => -1
    };
}

fn inner_score(v: Outer::Inner) -> i32 {
    return match v {
        Outer::Inner::Low => 100,
        Outer::Inner::High => 200,
        _ => 0
    };
}

fn method_rank(m: HttpMethod) -> i32 {
    return match m {
        HttpMethod::Get => 1,
        HttpMethod::Post => 2,
        HttpMethod::Patch => 3,
        HttpMethod::Submit => 4,
        _ => 0
    };
}

#[test]
fn test_enum_literal_and_match() {
    let c: Color = Color::Green;
    verify(color_code(c) == 2);
}

#[test]
fn test_enum_multiple_variants() {
    if status_score(Status::Idle) != 10: { verify(false); }
    if status_score(Status::Busy) != 20: { verify(false); }
    if status_score(Status::Done) != 30: { verify(false); }
    }

#[test]
fn test_option_enum_match_still_works() {
    let maybe: Option<Color> = Some<Color>(Color::Blue);
    let out: i32 = match maybe {
        Some(v) => color_code(v),
        None => 0
    };
    verify(out == 3);
}

#[test]
fn test_nested_enum_type_and_literal() {
    let v: Outer::Inner = Outer::Inner::High;
    verify(inner_score(v) == 200);
}

#[test]
fn test_nested_enum_struct_member() {
    let o: Outer = Outer { level: Outer::Inner::High };
    verify(inner_score(o.level) == 200);
}

#[test]
fn test_enum_iteration_runs_in_declaration_order() {
    var acc: i32 = 0;
    for s in Status {
        acc = acc * 10 + (status_score(s) / 10);
    }
    verify(acc == 123);
}

#[test]
fn test_enum_enumerate_exposes_index_and_value() {
    var idx_acc: i64 = 0;
    var value_acc: i32 = 0;
    for (i, s) in Status.enumerate() {
        idx_acc = idx_acc * 10 + i;
        value_acc = value_acc * 10 + (status_score(s) / 10);
    }
    verify(idx_acc == 12);
    verify(value_acc == 123);
}

#[test]
fn test_string_backed_enum_match_compare_and_assign() {
    var method: HttpMethod = HttpMethod::Get;
    verify(method == "GET");
    method = HttpMethod::Patch;
    verify(method == "PATCH");
    verify(method_rank(method) == 3);
}

#[test]
fn test_string_backed_enum_switch_and_iteration() {
    let method: HttpMethod = HttpMethod::Post;
    var text: str8 = "unset";
    switch method {
    case HttpMethod::Get: {
        text = "get";
    }
    case HttpMethod::Post: {
        text = "post";
    }
    case HttpMethod::Patch: {
        text = "patch";
    }
    default: {
        text = "other";
    }
    }
    verify(text == "post");

    var count: i64 = 0;
    for (i, m) in HttpMethod.enumerate() {
        if i == 0 { verify(m == "GET"); }
        if i == 1 { verify(m == "POST"); }
        if i == 2 { verify(m == "PATCH"); }
        if i == 3 { verify(m == "POST"); }
        count = count + 1;
    }
    verify(count == 4);
}

#[test]
fn test_hex_integer_literals_and_enum_values() {
    let mask: i64 = 0x2A;
    verify(mask == 42);

    let c: HexColor = HexColor::Blue;
    let v: i64 = match c {
        HexColor::Red => 0x10,
        HexColor::Green => 0x20,
        HexColor::Blue => 0x2A,
        _ => 0
    };
    verify(v == 42);
}
