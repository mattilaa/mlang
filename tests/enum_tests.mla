enum Color {
    Red,
    Green,
    Blue
};

enum Status {
    Idle,
    Busy,
    Done
};

struct Outer {
    enum Inner {
        Low,
        High
    };
    var level: Outer::Inner;
};

fn color_code(c: Color) -> i32 {
    return match c {
        Color::Red => 1,
        Color::Green => 2,
        Color::Blue => 3,
        _ => 0
    };
}

fn status_score(s: Status) -> i32 {
    return match s {
        Status::Idle => 10,
        Status::Busy => 20,
        Status::Done => 30,
        _ => -1
    };
}

fn inner_score(v: Outer::Inner) -> i32 {
    return match v {
        Outer::Inner::Low => 100,
        Outer::Inner::High => 200,
        _ => 0
    };
}

#[test]
fn test_enum_literal_and_match() -> i32 {
    let c: Color = Color::Green;
    return color_code(c) == 2 ? 0 : 1;
}

#[test]
fn test_enum_multiple_variants() -> i32 {
    if status_score(Status::Idle) != 10: { return 1; }
    if status_score(Status::Busy) != 20: { return 1; }
    if status_score(Status::Done) != 30: { return 1; }
    return 0;
}

#[test]
fn test_option_enum_match_still_works() -> i32 {
    let maybe: Option<Color> = Some<Color>(Color::Blue);
    let out: i32 = match maybe {
        Some(v) => color_code(v),
        None => 0
    };
    return out == 3 ? 0 : 1;
}

#[test]
fn test_nested_enum_type_and_literal() -> i32 {
    let v: Outer::Inner = Outer::Inner::High;
    return inner_score(v) == 200 ? 0 : 1;
}

#[test]
fn test_nested_enum_struct_member() -> i32 {
    let o: Outer = Outer { level: Outer::Inner::High };
    return inner_score(o.level) == 200 ? 0 : 1;
}
