mod std::testing;

use std::testing::verify_eq;
enum Color {
    Red,
    Green,
    Blue
};

enum Status {
    Idle,
    Busy,
    Done
};

enum HttpMethod: str8 {
    Get = "GET",
    Post = "POST",
    Patch = "PATCH",
    Submit = HttpMethod::Post
};

enum HexColor: u32 {
    Red = 0x10,
    Green = 0x20,
    Blue = 0x2A
};

struct Outer {
    enum Inner {
        Low,
        High
    };
    var level: Outer::Inner;
};

fn color_code(c: Color) -> i32 {
    return match c {
        Color::Red => 1,
        Color::Green => 2,
        Color::Blue => 3,
        _ => 0
    };
}

fn status_score(s: Status) -> i32 {
    return match s {
        Status::Idle => 10,
        Status::Busy => 20,
        Status::Done => 30,
        _ => -1
    };
}

fn inner_score(v: Outer::Inner) -> i32 {
    return match v {
        Outer::Inner::Low => 100,
        Outer::Inner::High => 200,
        _ => 0
    };
}

fn method_rank(m: HttpMethod) -> i32 {
    return match m {
        HttpMethod::Get => 1,
        HttpMethod::Post => 2,
        HttpMethod::Patch => 3,
        HttpMethod::Submit => 4,
        _ => 0
    };
}

#[test]
fn test_enum_literal_and_match() {
    let c: Color = Color::Green;
    verify_eq(2, color_code(c));
}

#[test]
fn test_enum_multiple_variants() {
    verify_eq(10, status_score(Status::Idle));
    verify_eq(20, status_score(Status::Busy));
    verify_eq(30, status_score(Status::Done));
}

#[test]
fn test_option_enum_match_still_works() {
    let maybe: Option<Color> = Some<Color>(Color::Blue);
    let out: i32 = match maybe {
        Some(v) => color_code(v),
        None => 0
    };
    verify_eq(3, out);
}

#[test]
fn test_nested_enum_type_and_literal() {
    let v: Outer::Inner = Outer::Inner::High;
    verify_eq(200, inner_score(v));
}

#[test]
fn test_nested_enum_struct_member() {
    let o: Outer = Outer { level: Outer::Inner::High };
    verify_eq(200, inner_score(o.level));
}

#[test]
fn test_enum_iteration_runs_in_declaration_order() {
    var acc: i32 = 0;
    for s in Status {
        acc = acc * 10 + (status_score(s) / 10);
    }
    verify_eq(123, acc);
}

#[test]
fn test_enum_enumerate_exposes_index_and_value() {
    var idx_acc: i64 = 0;
    var value_acc: i32 = 0;
    for (i, s) in Status.enumerate() {
        idx_acc = idx_acc * 10 + i;
        value_acc = value_acc * 10 + (status_score(s) / 10);
    }
    verify_eq(12, idx_acc);
    verify_eq(123, value_acc);
}

#[test]
fn test_string_backed_enum_match_compare_and_assign() {
    var method: HttpMethod = HttpMethod::Get;
    verify_eq(HttpMethod::Get, "GET");
    verify_eq("GET", method);
    method = HttpMethod::Patch;
    verify_eq("PATCH", method);
    verify_eq(3, method_rank(method));
}

#[test]
fn test_string_backed_enum_switch_and_iteration() {
    let method: HttpMethod = HttpMethod::Post;
    var text: str8 = "unset";
    switch method {
    case HttpMethod::Get: {
        text = "get";
    }
    case HttpMethod::Post: {
        text = "post";
    }
    case HttpMethod::Patch: {
        text = "patch";
    }
    default: {
        text = "other";
    }
    }
    verify_eq("post", text);

    var count: i64 = 0;
    for (i, m) in HttpMethod.enumerate() {
        if i == 0 { verify_eq("GET", m); }
        if i == 1 { verify_eq("POST", m); }
        if i == 2 { verify_eq("PATCH", m); }
        if i == 3 { verify_eq("POST", m); }
        count = count + 1;
    }
    verify_eq(4, count);
}

#[test]
fn test_hex_integer_literals_and_enum_values() {
    let mask: i64 = 0x2A;
    verify_eq(42, mask);

    let c: HexColor = HexColor::Blue;
    let v: i64 = match c {
        HexColor::Red => 0x10,
        HexColor::Green => 0x20,
        HexColor::Blue => 0x2A,
        _ => 0
    };
    verify_eq(42, v);
}
