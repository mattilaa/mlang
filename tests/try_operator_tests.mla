mod std::testing;
mod std::strbuf;
use std::strbuf::contains;
use std::testing::verify;

fn ok_num() -> result<i32, str8> {
    return Ok<i32, str8>(41);
}

fn err_num() -> result<i32, str8> {
    return Err<i32, str8>("boom");
}

fn add_one(x: i32) -> result<i32, str8> {
    return Ok<i32, str8>(x + 1);
}

fn chain_ok() -> result<i32, str8> {
    let a: i32 = ok_num()?;
    let b: i32 = add_one(a)?;
    return Ok<i32, str8>(b);
}

fn chain_err() -> result<i32, str8> {
    let a: i32 = err_num()?;
    return Ok<i32, str8>(a);
}

fn leaf_fail() -> result<i32, str8> {
    return Err<i32, str8>("boom");
}

fn mid_fail() -> result<i32, str8> {
    let v: i32 = leaf_fail()?;
    return Ok<i32, str8>(v);
}

fn top_fail() -> result<i32, str8> {
    let v: i32 = mid_fail()?;
    return Ok<i32, str8>(v);
}

#[test]
fn test_try_ok_path() {
    let r: result<i32, str8> = chain_ok();
    if r.is_err(): {
        verify(false);
    }
    verify(r.unwrap() == 42);
}

#[test]
fn test_try_err_propagation() {
    let r: result<i32, str8> = chain_err();
    verify(r.is_err());
}

#[test]
fn test_try_err_context_stack() {
    let r: result<i32, str8> = top_fail();
    if r.is_ok(): {
        verify(false);
    }
    let msg: str8 = r.unwrap_err();
    if contains(msg, "boom") == 0: {
        verify(false);
    }
    if contains(msg, "mid_fail") == 0: {
        verify(false);
    }
    if contains(msg, "top_fail") == 0: {
        verify(false);
    }
    }
