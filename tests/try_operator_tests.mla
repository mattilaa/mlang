mod std::strbuf;
use std::strbuf::contains;

fn ok_num() -> Result<i32, string> {
    return Ok<i32, string>(41);
}

fn err_num() -> Result<i32, string> {
    return Err<i32, string>("boom");
}

fn add_one(x: i32) -> Result<i32, string> {
    return Ok<i32, string>(x + 1);
}

fn chain_ok() -> Result<i32, string> {
    let a: i32 = ok_num()?;
    let b: i32 = add_one(a)?;
    return Ok<i32, string>(b);
}

fn chain_err() -> Result<i32, string> {
    let a: i32 = err_num()?;
    return Ok<i32, string>(a);
}

fn leaf_fail() -> Result<i32, string> {
    return Err<i32, string>("boom");
}

fn mid_fail() -> Result<i32, string> {
    let v: i32 = leaf_fail()?;
    return Ok<i32, string>(v);
}

fn top_fail() -> Result<i32, string> {
    let v: i32 = mid_fail()?;
    return Ok<i32, string>(v);
}

#[test]
fn test_try_ok_path() -> i32 {
    let r: Result<i32, string> = chain_ok();
    if r.is_err(): {
        return 1;
    }
    return r.unwrap() == 42 ? 0 : 1;
}

#[test]
fn test_try_err_propagation() -> i32 {
    let r: Result<i32, string> = chain_err();
    if r.is_err(): {
        return 0;
    }
    return 1;
}

#[test]
fn test_try_err_context_stack() -> i32 {
    let r: Result<i32, string> = top_fail();
    if r.is_ok(): {
        return 1;
    }
    let msg: string = r.unwrap_err();
    if contains(msg, "boom") == 0: {
        return 1;
    }
    if contains(msg, "mid_fail") == 0: {
        return 1;
    }
    if contains(msg, "top_fail") == 0: {
        return 1;
    }
    return 0;
}
