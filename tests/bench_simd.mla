/// \file bench_simd.mla
/// \brief SIMD vs scalar benchmark pairs for `mlang bench`.
///
/// Run with:
/// \code
///   ./build/mlang bench tests/bench_simd.mla --bench-iters 2000 --bench-warmup 200 -L ./build -lmlang_std
/// \endcode

mod std::bench;
mod std::bitset;
mod std::algorithm::fft;
mod std::simd;
mod std::testing;

use std::bench::clobber_memory;
use std::bench::do_not_optimize_i64;
use std::bitset::BitSet;
use std::simd::*;
use std::testing::verify;

fn make_i64_values(n: i64, offset: i64) -> list<i64> {
    var out: list<i64> = [];
    for i in 0..n {
        out.push((i % 97) + offset);
    }
    return out;
}

fn scalar_sum_i64(values: &list<i64>) -> i64 {
    var total: i64 = 0;
    for i in 0..values.len() {
        total = total + values[i];
    }
    return total;
}

fn scalar_add_i64(lhs: &list<i64>, rhs: &list<i64>) -> list<i64> {
    var out: list<i64> = [];
    for i in 0..lhs.len() {
        out.push(lhs[i] + rhs[i]);
    }
    return out;
}

fn make_complex_f32_values(n: i64) -> list<f32> {
    var out: list<f32> = [];
    for i in 0..n {
        if (i % 4) == 0 {
            out.push(1.0f);
        } else if (i % 4) == 1 {
            out.push(0.5f);
        } else if (i % 4) == 2 {
            out.push(0.25f);
        } else {
            out.push(0.125f);
        }
        out.push(0.0f);
    }
    return out;
}

fn make_complex_f32_gain(n: i64) -> list<f32> {
    var out: list<f32> = [];
    for _i in 0..n {
        out.push(0.5f);
        out.push(0.5f);
    }
    return out;
}

fn scalar_multiply_f32(lhs: &list<f32>, rhs: &list<f32>) -> list<f32> {
    var out: list<f32> = [];
    for i in 0..lhs.len() {
        out.push(lhs[i] * rhs[i]);
    }
    return out;
}

fn approx_f32(a: f32, b: f32, eps: f32) -> bool {
    var diff: f32 = a - b;
    if diff < 0.0f {
        diff = 0.0f - diff;
    }
    return diff <= eps;
}

fn make_bitset(n: i64) -> BitSet {
    let r: Result<BitSet, str8> = BitSet::new(n);
    verify(!r.is_err());
    let bits: BitSet = r.unwrap();
    verify(bits.resize(n, false) == 0);
    for i in 0..n {
        if (i % 3) == 0 || (i % 17) == 0 {
            verify(bits.set_fast(i, true) == 0);
        }
    }
    return bits;
}

fn scalar_count_ones(bits: BitSet) -> i64 {
    var total: i64 = 0;
    for i in 0..bits.len() {
        if bits.get_fast(i) == 1 {
            total = total + 1;
        }
    }
    return total;
}

#[test]
fn bench_scalar_sum_i64_1024x16() {
    let values: list<i64> = make_i64_values(1024, 1);
    var checksum: i64 = 0;
    for _repeat in 0..16 {
        checksum = checksum + scalar_sum_i64(values);
    }
    do_not_optimize_i64(checksum);
    clobber_memory();
    verify(checksum == 784240);
}

#[test]
fn bench_simd_sum_i64_1024x16() {
    let values: list<i64> = make_i64_values(1024, 1);
    var checksum: i64 = 0;
    for _repeat in 0..16 {
        checksum = checksum + sum(values);
    }
    do_not_optimize_i64(checksum);
    clobber_memory();
    verify(checksum == 784240);
}

#[test]
fn bench_scalar_add_i64_1024x8() {
    let lhs: list<i64> = make_i64_values(1024, 1);
    let rhs: list<i64> = make_i64_values(1024, 3);
    var checksum: i64 = 0;
    for _repeat in 0..8 {
        let out: list<i64> = scalar_add_i64(lhs, rhs);
        checksum = checksum + scalar_sum_i64(out);
    }
    do_not_optimize_i64(checksum);
    clobber_memory();
    verify(checksum == 800624);
}

#[test]
fn bench_simd_add_i64_1024x8() {
    let lhs: list<i64> = make_i64_values(1024, 1);
    let rhs: list<i64> = make_i64_values(1024, 3);
    var checksum: i64 = 0;
    for _repeat in 0..8 {
        let out: list<i64> = add(lhs, rhs);
        checksum = checksum + sum(out);
    }
    do_not_optimize_i64(checksum);
    clobber_memory();
    verify(checksum == 800624);
}

#[test]
fn bench_direct_fft_f32_pipeline_1024x8() {
    var data: list<f32> = make_complex_f32_values(1024);
    let gain: list<f32> = make_complex_f32_gain(1024);
    var checksum: i64 = 0;

    for _repeat in 0..8 {
        let scaled: list<f32> = scalar_multiply_f32(data, gain);
        let freq: list<f32> = std::algorithm::fft::forward_f32(scaled);
        verify(freq.len() == 2048);
        let restored: list<f32> = std::algorithm::fft::inverse_f32(freq);
        verify(restored.len() == 2048);
        data = restored;
        checksum = checksum + data.len();
    }

    do_not_optimize_i64(checksum);
    clobber_memory();
    verify(checksum == 16384);
    verify(approx_f32(data[0], 0.00390625f, 0.0005f));
}

#[test]
fn bench_simd_fft_f32_pipeline_1024x8() {
    var data: list<f32> = make_complex_f32_values(1024);
    let gain: list<f32> = make_complex_f32_gain(1024);
    var checksum: i64 = 0;

    for _repeat in 0..8 {
        let scaled: list<f32> = multiply(data, gain);
        let freq: list<f32> = fft_forward(scaled);
        verify(freq.len() == 2048);
        let restored: list<f32> = fft_inverse(freq);
        verify(restored.len() == 2048);
        data = restored;
        checksum = checksum + data.len();
    }

    do_not_optimize_i64(checksum);
    clobber_memory();
    verify(checksum == 16384);
    verify(approx_f32(data[0], 0.00390625f, 0.0005f));
}

#[test]
fn bench_scalar_bitset_count_ones_4096x8() {
    let bits: BitSet = make_bitset(4096);
    var checksum: i64 = 0;
    for _repeat in 0..8 {
        checksum = checksum + scalar_count_ones(bits);
    }
    do_not_optimize_i64(checksum);
    clobber_memory();
    verify(checksum == 12208);
    bits.close();
}

#[test]
fn bench_simd_bitset_count_ones_4096x8() {
    let bits: BitSet = make_bitset(4096);
    var checksum: i64 = 0;
    for _repeat in 0..8 {
        checksum = checksum + count_ones(bits);
    }
    do_not_optimize_i64(checksum);
    clobber_memory();
    verify(checksum == 12208);
    bits.close();
}
