mod std::testing;
mod std::json;
mod std::fs;
mod std::strbuf;

use std::fs::File;
use std::json::JsonDoc;
use std::json::JsonArrayIter;
use std::json::JsonObjectIter;
use std::json::JsonValue;
use std::strbuf::contains;
use std::strbuf::eq;
use std::testing::verify;

fn test_parse_and_navigate_impl() -> i32 {
    let doc_r: Result<JsonDoc, str8> = JsonDoc::parse("{\"a\":1,\"arr\":[10,20],\"s\":\"ok\"}");
    if doc_r.is_err(): { return 1; }
    let doc: JsonDoc = doc_r.unwrap();

    let root_r: Result<JsonValue, str8> = doc.root();
    if root_r.is_err(): {
        doc.free();
        return 1;
    }
    let root: JsonValue = root_r.unwrap();

    let a_r: Result<JsonValue, str8> = root.get("a");
    if a_r.is_err(): {
        root.free();
        doc.free();
        return 1;
    }
    let a: JsonValue = a_r.unwrap();
    let av: Result<i64, str8> = a.as_i64();
    if av.is_err(): {
        a.free();
        root.free();
        doc.free();
        return 1;
    }
    if av.unwrap() != 1: {
        a.free();
        root.free();
        doc.free();
        return 1;
    }
    a.free();

    let arr_r: Result<JsonValue, str8> = root.get("arr");
    if arr_r.is_err(): {
        root.free();
        doc.free();
        return 1;
    }
    let arr: JsonValue = arr_r.unwrap();
    let i1_r: Result<JsonValue, str8> = arr.index(1);
    if i1_r.is_err(): {
        arr.free();
        root.free();
        doc.free();
        return 1;
    }
    let i1: JsonValue = i1_r.unwrap();
    let iv: Result<i64, str8> = i1.as_i64();
    if iv.is_err(): {
        i1.free();
        arr.free();
        root.free();
        doc.free();
        return 1;
    }
    if iv.unwrap() != 20: {
        i1.free();
        arr.free();
        root.free();
        doc.free();
        return 1;
    }
    i1.free();
    arr.free();

    let s_r: Result<JsonValue, str8> = root.get("s");
    if s_r.is_err(): {
        root.free();
        doc.free();
        return 1;
    }
    let s: JsonValue = s_r.unwrap();
    let sv: Result<str8, str8> = s.as_string();
    if sv.is_err(): {
        s.free();
        root.free();
        doc.free();
        return 1;
    }
    if eq(sv.unwrap(), "ok") != 1: {
        s.free();
        root.free();
        doc.free();
        return 1;
    }
    s.free();

    root.free();
    doc.free();
    return 0;
}

#[test]
fn test_parse_and_navigate() {
    verify(test_parse_and_navigate_impl() == 0);
}

fn test_stringify_and_parse_error_impl() -> i32 {
    let bad: Result<JsonDoc, str8> = JsonDoc::parse("{\"a\":");
    if bad.is_err(): {
        let ok_flag: i32 = 0;
    } else: {
        return 1;
    }

    let ok: Result<JsonDoc, str8> = JsonDoc::parse("{\"x\":42}");
    if ok.is_err(): { return 1; }
    let doc: JsonDoc = ok.unwrap();
    let out: Result<str8, str8> = doc.stringify();
    if out.is_err(): {
        doc.free();
        return 1;
    }
    out.unwrap();
    doc.free();
    return 0;
}

#[test]
fn test_iterators_and_from_file() -> i32 {
    let path: str8 = "/tmp/mlang_std_json_iter_test.json";
    let create_r: Result<File, str8> = File::create(path);
    if create_r.is_err(): { return 1; }
    let f: File = create_r.unwrap();
    let w1: Result<i64, str8> = f.write("{\"a\":1,\"arr\":[10,20],\"name\":\"x\"}");
    if w1.is_err(): {
        f.close();
        return 1;
    }
    if f.close() != 0: { return 1; }

    let doc_r: Result<JsonDoc, str8> = JsonDoc::from_file(path);
    if doc_r.is_err(): { return 1; }
    let doc: JsonDoc = doc_r.unwrap();
    let root_r: Result<JsonValue, str8> = doc.root();
    if root_r.is_err(): {
        doc.free();
        return 1;
    }
    let root: JsonValue = root_r.unwrap();

    let obj_it_r: Result<JsonObjectIter, str8> = root.iter_object();
    if obj_it_r.is_err(): {
        root.free();
        doc.free();
        return 1;
    }
    var obj_it: JsonObjectIter = obj_it_r.unwrap();
    var saw_a: i32 = 0;
    var saw_arr: i32 = 0;
    if obj_it.has_next() == 1: {
        let key_r: Result<str8, str8> = obj_it.current_key();
        if key_r.is_err(): {
            root.free();
            doc.free();
            return 1;
        }
        let key: str8 = key_r.unwrap();
        if eq(key, "a") == 1: { saw_a = 1; }
        if eq(key, "arr") == 1: { saw_arr = 1; }
        String::free(key);

        let val_r: Result<JsonValue, str8> = obj_it.current_value();
        if val_r.is_err(): {
            root.free();
            doc.free();
            return 1;
        }
        let val: JsonValue = val_r.unwrap();
        val.free();

        obj_it = obj_it.advance();
    }
    if obj_it.has_next() == 1: {
        let key_r: Result<str8, str8> = obj_it.current_key();
        if key_r.is_err(): {
            root.free();
            doc.free();
            return 1;
        }
        let key: str8 = key_r.unwrap();
        if eq(key, "a") == 1: { saw_a = 1; }
        if eq(key, "arr") == 1: { saw_arr = 1; }
        String::free(key);

        let val_r: Result<JsonValue, str8> = obj_it.current_value();
        if val_r.is_err(): {
            root.free();
            doc.free();
            return 1;
        }
        let val: JsonValue = val_r.unwrap();
        val.free();

        obj_it = obj_it.advance();
    }
    if obj_it.has_next() == 1: {
        let key_r: Result<str8, str8> = obj_it.current_key();
        if key_r.is_err(): {
            root.free();
            doc.free();
            return 1;
        }
        let key: str8 = key_r.unwrap();
        if eq(key, "a") == 1: { saw_a = 1; }
        if eq(key, "arr") == 1: { saw_arr = 1; }
        String::free(key);

        let val_r: Result<JsonValue, str8> = obj_it.current_value();
        if val_r.is_err(): {
            root.free();
            doc.free();
            return 1;
        }
        let val: JsonValue = val_r.unwrap();
        val.free();

        obj_it = obj_it.advance();
    }
    if saw_a != 1: {
        root.free();
        doc.free();
        return 1;
    }
    if saw_arr != 1: {
        root.free();
        doc.free();
        return 1;
    }

    let arr_r: Result<JsonValue, str8> = root.get("arr");
    if arr_r.is_err(): {
        root.free();
        doc.free();
        return 1;
    }
    let arr: JsonValue = arr_r.unwrap();
    let arr_it_r: Result<JsonArrayIter, str8> = arr.iter_array();
    if arr_it_r.is_err(): {
        arr.free();
        root.free();
        doc.free();
        return 1;
    }
    var arr_it: JsonArrayIter = arr_it_r.unwrap();
    var sum: i64 = 0;
    if arr_it.has_next() == 1: {
        let item_r: Result<JsonValue, str8> = arr_it.current();
        if item_r.is_err(): {
            arr.free();
            root.free();
            doc.free();
            return 1;
        }
        let item: JsonValue = item_r.unwrap();
        let n_r: Result<i64, str8> = item.as_i64();
        if n_r.is_err(): {
            item.free();
            arr.free();
            root.free();
            doc.free();
            return 1;
        }
        sum = sum + n_r.unwrap();
        item.free();
        arr_it = arr_it.advance();
    }
    if arr_it.has_next() == 1: {
        let item_r: Result<JsonValue, str8> = arr_it.current();
        if item_r.is_err(): {
            arr.free();
            root.free();
            doc.free();
            return 1;
        }
        let item: JsonValue = item_r.unwrap();
        let n_r: Result<i64, str8> = item.as_i64();
        if n_r.is_err(): {
            item.free();
            arr.free();
            root.free();
            doc.free();
            return 1;
        }
        sum = sum + n_r.unwrap();
        item.free();
        arr_it = arr_it.advance();
    }

    arr.free();
    root.free();
    doc.free();
    return sum == 30 ? 0 : 1;
}

#[test]
fn test_stringify_and_parse_error() {
    verify(test_stringify_and_parse_error_impl() == 0);
}
