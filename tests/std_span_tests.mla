mod std::span;
mod std::vec;
mod std::testing;

use std::testing::verify;
use std::testing::verify_eq_i32;
use std::testing::verify_eq_i64;
use std::span::size;
use std::span::empty;
use std::span::first;
use std::span::last;
use std::span::subspan;

fn sum_span(values: Span<i32>) -> i32 {
    var total: i32 = 0;
    for i in 0..values.len() {
        total = total + values[i];
    }
    return total;
}

fn all_true(values: &span<bool>) -> bool {
    for i in 0..values.len() {
        if !values[i] {
            return false;
        }
    }
    return true;
}

#[test]
fn test_span_size_of_and_static_asserts() {
    let ints: Span<i32> = [1, 2, 3];
    let flags: span<bool> = [true, false];
    static_assert!(size_of(list<i32>) == 16);
    static_assert!(size_of(ints) == size_of(list<i32>));
    static_assert!(size_of(flags) == size_of(list<bool>));

    verify_eq_i64(size_of(ints), size_of(list<i32>));
    verify_eq_i64(size_of(flags), size_of(list<bool>));
    verify_eq_i64(16, size_of(ints));
}

#[test]
fn test_span_from_list_and_vec_alias() {
    let ints: list<i32> = [10, 20, 30, 40];
    let view: Span<i32> = ints;
    verify_eq_i32(4, i32(view.len()));
    verify_eq_i32(10, view[0]);
    verify_eq_i32(40, view[3]);
    verify_eq_i32(100, sum_span(view));

    let vec_values: Vec<i32> = vec![1, 2, 3, 4];
    let vec_view: span<i32> = vec_values;
    verify_eq_i32(10, sum_span(vec_view));
}

#[test]
fn test_span_from_array_like_fill_and_bool_view() {
    let filled: Span<i32> = [7; 4];
    verify_eq_i32(4, i32(filled.len()));
    verify_eq_i32(28, sum_span(filled));

    let flags: span<bool> = [true, true, true, true];
    verify(all_true(flags));
    verify_eq_i32(1, i32(flags[2]));
}

#[test]
fn test_span_size_and_copied_slices() {
    let values: Span<i32> = [10, 20, 30, 40];
    verify_eq_i64(4, size(values));
    verify(!empty(values));

    let prefix: Span<i32> = first(values, 2);
    verify_eq_i32(2, i32(prefix.len()));
    verify(prefix[0] == 10 && prefix[1] == 20);
    let oversized_prefix: Span<i32> = first(values, 99);
    verify_eq_i32(4, i32(oversized_prefix.len()));
    let negative_prefix: Span<i32> = first(values, -1);
    verify(empty(negative_prefix));

    let suffix: Span<i32> = last(values, 2);
    verify(suffix[0] == 30 && suffix[1] == 40);
    let oversized_suffix: Span<i32> = last(values, 99);
    verify_eq_i32(4, i32(oversized_suffix.len()));
    let negative_suffix: Span<i32> = last(values, -1);
    verify(empty(negative_suffix));

    let middle: Span<i32> = subspan(values, 1, 2);
    verify(middle.len() == 2 && middle[0] == 20 && middle[1] == 30);
    let rest: Span<i32> = subspan(values, 2, -1);
    verify(rest.len() == 2 && rest[0] == 30 && rest[1] == 40);
    let clamped: Span<i32> = subspan(values, 3, 99);
    verify(clamped.len() == 1 && clamped[0] == 40);
    let invalid: Span<i32> = subspan(values, 5, -1);
    verify(empty(invalid));

    let empty_values: Span<i32> = [];
    verify(empty(empty_values));
    let empty_prefix: Span<i32> = first(empty_values, 1);
    let empty_suffix: Span<i32> = last(empty_values, 1);
    let empty_rest: Span<i32> = subspan(empty_values, 0, -1);
    verify(empty_prefix.len() == 0);
    verify(empty_suffix.len() == 0);
    verify(empty_rest.len() == 0);
    verify(values[0] == 10 && values[3] == 40);
}
