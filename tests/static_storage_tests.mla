var g_counter: i32 = 0;

fn tick() -> i32 {
    static var local_hits: i32 = 0;
    g_counter = g_counter + 1;
    local_hits = local_hits + 1;
    return g_counter + local_hits;
}

#[test]
fn test_global_and_static_local_persist() -> i32 {
    let a: i32 = tick();
    let b: i32 = tick();
    if a != 2: { return 1; }
    if b != 4: { return 1; }
    if g_counter != 2: { return 1; }
    return 0;
}
