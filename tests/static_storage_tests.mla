mod std::testing;

use std::testing::verify;
var g_counter: i32 = 0;

fn tick() -> i32 {
    static var local_hits: i32 = 0;
    g_counter = g_counter + 1;
    local_hits = local_hits + 1;
    return g_counter + local_hits;
}

#[test]
fn test_global_and_static_local_persist() {
    let a: i32 = tick();
    let b: i32 = tick();
    if a != 2: { verify(false); }
    if b != 4: { verify(false); }
    if g_counter != 2: { verify(false); }
    }
