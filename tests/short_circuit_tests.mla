mod std::testing;

use std::testing::verify;

// `&&` and `||` must only evaluate their right operand when the left one does
// not already decide the result.
// The right operands below index past the end of the list; evaluating one
// aborts the test.

#[test]
fn and_skips_rhs_when_lhs_is_false() {
    let xs: list<i32> = [1];
    verify(!(xs.len() >= 2 && xs[1] == 0));
    verify(xs.len() == 1 && xs[0] == 1);
}

#[test]
fn or_skips_rhs_when_lhs_is_true() {
    let xs: list<i32> = [1];
    verify(xs.len() == 1 || xs[5] == 0);
    verify(!(xs.len() == 2 || xs[0] == 2));
}

#[test]
fn chained_and_guards_list_index() {
    let args: list<str8> = ["run"];
    // Evaluating args[1] here would abort with an out-of-bounds index.
    var matched: bool = args.len() >= 2 && args[0] == "run" && args[1] == "tests";
    verify(!matched);
    let two: list<str8> = ["run", "tests"];
    matched = two.len() >= 2 && two[0] == "run" && two[1] == "tests";
    verify(matched);
}

#[test]
fn else_if_and_while_conditions_short_circuit() {
    let xs: list<i32> = [3, 5, 7];
    var i: i64 = 0;
    while i < xs.len() && xs[i] != 42 {
        i = i + 1;
    }
    verify(i == 3);
    var branch: i32 = 0;
    if i == 0 {
        branch = 1;
    } else if i >= 10 && xs[i] == 0 {
        branch = 2;
    } else {
        branch = 3;
    }
    verify(branch == 3);
}
