mod std::testing;
mod std::bytes;
mod std::strbuf;

use std::bytes::*;
use std::strbuf::eq;
use std::testing::verify;

#[test]
fn test_bytes_append_get_set_and_string() {
    let br: result<Bytes, str8> = Bytes::new(2);
    if br.is_err() { verify(false); }
    let b: Bytes = br.unwrap();

    if b.append_byte(65) != 0 { verify(false); }
    if b.append_string("BC") != 2 { verify(false); }
    if b.len() != 3 { verify(false); }
    if b.get(0) != 65 { verify(false); }
    if b.get(2) != 67 { verify(false); }
    if b.set(1, 120) != 0 { verify(false); }

    let s: str8 = b.to_string();
    if eq(s, "AxC") != 1 { verify(false); }
    String::free(s);

    b.close();
    }

#[test]
fn test_bytes_hex_and_append_bytes() {
    let r1: result<Bytes, str8> = Bytes::new(0);
    if r1.is_err() { verify(false); }
    let a: Bytes = r1.unwrap();

    if a.append_byte(0) != 0 { verify(false); }
    if a.append_byte(255) != 0 { verify(false); }

    let r2: result<Bytes, str8> = Bytes::from_string("ok");
    if r2.is_err() { verify(false); }
    let b: Bytes = r2.unwrap();

    if a.append_bytes(b) != 2 { verify(false); }
    if a.len() != 4 { verify(false); }

    let hex: str8 = a.to_hex();
    if eq(hex, "00ff6f6b") != 1 { verify(false); }
    String::free(hex);

    b.close();
    a.close();
    }

#[test]
fn test_bytes_reserve_clear_and_bounds() {
    let r: result<Bytes, str8> = Bytes::new(1);
    if r.is_err() { verify(false); }
    let b: Bytes = r.unwrap();

    if b.reserve(128) != 0 { verify(false); }
    if b.capacity() < 128 { verify(false); }

    if b.append_string("hello") != 5 { verify(false); }
    if b.clear() != 0 { verify(false); }
    if b.len() != 0 { verify(false); }

    if b.get(0) != -1 { verify(false); }
    if b.append_byte(300) != -1 { verify(false); }

    b.close();
    }
