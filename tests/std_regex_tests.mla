mod std::testing;
mod std::regex;
mod std::strbuf;

use std::regex::Regex;
use std::regex::last_error;
use std::strbuf::eq;
use std::strbuf::free;
use std::strbuf::sub;
use std::testing::verify;

#[test]
fn test_regex_compile_and_is_match() {
    let rr: result<Regex, str8> = Regex::compile("h[ae]llo");
    if rr.is_err(): { verify(false); }
    let re: Regex = rr.unwrap();

    if re.is_match("hello") != 1: {
        verify(false);
    }
    if re.is_match("hallo") != 1: {
        verify(false);
    }
    if re.is_match("hullo") != 0: {
        verify(false);
    }

    re.close();
    }

#[test]
fn test_regex_find_offsets() {
    let rr: result<Regex, str8> = Regex::compile("[0-9]+");
    if rr.is_err(): { verify(false); }
    let re: Regex = rr.unwrap();

    let text: str8 = "abc123xyz";
    let s: i64 = re.find_start(text);
    let e: i64 = re.find_end(text);
    if s != 3 || e != 6: {
        verify(false);
    }

    let m: str8 = sub(text, s, e - s);
    let ok: i32 = eq(m, "123");
    free(m);
    re.close();
    verify(ok == 1);
}

#[test]
fn test_regex_capture_groups() {
    let rr: result<Regex, str8> = Regex::compile("([A-Za-z]+)-([0-9]+)");
    if rr.is_err(): { verify(false); }
    let re: Regex = rr.unwrap();

    let text: str8 = "user-42";
    let g1s: i64 = re.match_start(text, 1);
    let g1e: i64 = re.match_end(text, 1);
    let g2s: i64 = re.match_start(text, 2);
    let g2e: i64 = re.match_end(text, 2);
    if g1s != 0 || g1e != 4 || g2s != 5 || g2e != 7: {
        verify(false);
    }

    let name: str8 = sub(text, g1s, g1e - g1s);
    let id: str8 = sub(text, g2s, g2e - g2s);
    let ok_name: i32 = eq(name, "user");
    let ok_id: i32 = eq(id, "42");
    free(id);
    free(name);
    re.close();

    if ok_name != 1 || ok_id != 1: { verify(false); }
    }

#[test]
fn test_regex_compile_error_reports_message() {
    let rr: result<Regex, str8> = Regex::compile("([0-9]+");
    if rr.is_ok(): {
        let re: Regex = rr.unwrap();
        verify(false);
    }
    let err: str8 = rr.unwrap_err();
    if eq(err, "") == 1: { verify(false); }
    if eq(last_error(), "") == 1: { verify(false); }
    }
