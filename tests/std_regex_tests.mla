mod std::regex;
mod std::strbuf;

use std::regex::Regex;
use std::regex::last_error;
use std::strbuf::eq;
use std::strbuf::free;
use std::strbuf::sub;

#[test]
fn test_regex_compile_and_is_match() -> i32 {
    let rr: Result<Regex, string> = Regex::compile("h[ae]llo");
    if rr.is_err(): { return 1; }
    let re: Regex = rr.unwrap();

    if re.is_match("hello") != 1: {
        re.close();
        return 1;
    }
    if re.is_match("hallo") != 1: {
        re.close();
        return 1;
    }
    if re.is_match("hullo") != 0: {
        re.close();
        return 1;
    }

    re.close();
    return 0;
}

#[test]
fn test_regex_find_offsets() -> i32 {
    let rr: Result<Regex, string> = Regex::compile("[0-9]+");
    if rr.is_err(): { return 1; }
    let re: Regex = rr.unwrap();

    let text: string = "abc123xyz";
    let s: i64 = re.find_start(text);
    let e: i64 = re.find_end(text);
    if s != 3 || e != 6: {
        re.close();
        return 1;
    }

    let m: string = sub(text, s, e - s);
    let ok: i32 = eq(m, "123");
    free(m);
    re.close();
    return ok == 1 ? 0 : 1;
}

#[test]
fn test_regex_capture_groups() -> i32 {
    let rr: Result<Regex, string> = Regex::compile("([A-Za-z]+)-([0-9]+)");
    if rr.is_err(): { return 1; }
    let re: Regex = rr.unwrap();

    let text: string = "user-42";
    let g1s: i64 = re.match_start(text, 1);
    let g1e: i64 = re.match_end(text, 1);
    let g2s: i64 = re.match_start(text, 2);
    let g2e: i64 = re.match_end(text, 2);
    if g1s != 0 || g1e != 4 || g2s != 5 || g2e != 7: {
        re.close();
        return 1;
    }

    let name: string = sub(text, g1s, g1e - g1s);
    let id: string = sub(text, g2s, g2e - g2s);
    let ok_name: i32 = eq(name, "user");
    let ok_id: i32 = eq(id, "42");
    free(id);
    free(name);
    re.close();

    if ok_name != 1 || ok_id != 1: { return 1; }
    return 0;
}

#[test]
fn test_regex_compile_error_reports_message() -> i32 {
    let rr: Result<Regex, string> = Regex::compile("([0-9]+");
    if rr.is_ok(): {
        let re: Regex = rr.unwrap();
        re.close();
        return 1;
    }
    let err: string = rr.unwrap_err();
    if eq(err, "") == 1: { return 1; }
    if eq(last_error(), "") == 1: { return 1; }
    return 0;
}
