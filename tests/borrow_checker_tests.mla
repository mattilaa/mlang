mod std::testing;
mod std::strbuf;
use std::strbuf::*;
use std::testing::*;

extern fn strcmp(a: str8, b: str8) -> i32;

// ── helpers ─────────────────────────────────────────────────────────────────

fn streq(a: str8, b: str8) -> i32 {
    return strcmp(a, b) == 0 ? 1 : 0;
}

// ── 1. Immutable borrow — read through reference ─────────────────────────────

#[test]
fn test_immutable_borrow_read() {
    let s = String::from("hello");
    let r = &s;
    // r holds the same char* as s — reading it gives the same str8
    verify(!(streq(r, "hello") != 1));
    }

// ── 2. Multiple simultaneous immutable borrows ────────────────────────────────

#[test]
fn test_multiple_immutable_borrows() {
    let s = String::from("world");
    let r1 = &s;
    let r2 = &s;
    verify(!(streq(r1, "world") != 1));
    verify(!(streq(r2, "world") != 1));
    verify(!(streq(r1, r2) != 1));
    }

// ── 3. Borrow passed to a function ────────────────────────────────────────────

fn identity(x: str8) -> str8 {
    return x;
}

#[test]
fn test_borrow_passed_to_function() {
    let s = String::from("pass");
    let r = &s;
    let got = identity(r);
    verify(!(streq(got, "pass") != 1));
    }

// ── 4. NLL — borrow expires at last use, mutation is then allowed ─────────────

#[test]
fn test_nll_borrow_expires() {
    var s = String::from("hello");
    let r = &s;
    // last use of r — borrow ends here
    verify(!(streq(r, "hello") != 1));
    // r is dead; mutation of s is now valid
    s.push_str(" world");
    verify(!(streq(s, "hello world") != 1));
    }

// ── 5. clone() produces an independent copy ────────────────────────────────────

#[test]
fn test_clone_independent() {
    var original = String::from("base");
    var copy = original.clone();
    // mutate both independently
    original.push_str("_A");
    copy.push_str("_B");
    verify_eq_i32(1, streq(original, "base_A"));
    verify_eq_i32(1, streq(copy, "base_B"));
    verify_not_eq("base_A", "base_B");
    }

// ── 6. let-bound clone as immutable str8 ────────────────────────────────────

#[test]
fn test_clone_let_read() {
    let s = String::from("source");
    let snap = s.clone();
    verify(!(streq(snap, "source") != 1));
    }

// ── 7. clone() then borrow the clone ─────────────────────────────────────────

#[test]
fn test_clone_then_borrow() {
    var s = String::from("original");
    let c = s.clone();
    let rc = &c;
    // borrow of clone is independent of s
    s.push_str("_mutated");
    verify(!(streq(rc,        "original") != 1));
    verify(!(streq(s, "original_mutated") != 1));
    }

// ── 8. &mut borrow — take exclusive mutable reference ────────────────────────

fn append_via_ref(r: str8, suffix: str8) -> str8 {
    return concat(r, suffix);
}

#[test]
fn test_mut_borrow_basic() {
    var s = String::from("hello");
    let r = &mut s;
    // use the &mut ref to compute a new value (via concat, read-only view)
    let extended = append_via_ref(r, " world");
    verify(!(streq(extended, "hello world") != 1));
    }

// ── 9. &mut borrow expires — then shared borrows are valid ───────────────────

#[test]
fn test_mut_borrow_nll_then_shared() {
    var s = String::from("data");
    let m = &mut s;
    // last use of m (NLL — borrow expires here)
    verify(!(streq(m, "data") != 1));
    // m is dead; shared borrows are now valid
    let r1 = &s;
    let r2 = &s;
    verify(!(streq(r1, "data") != 1));
    verify(!(streq(r2, "data") != 1));
    }

// ── 10. push_str after shared borrow expires (NLL) ───────────────────────────

#[test]
fn test_push_str_after_borrow_expires() {
    var s = String::from("foo");
    let r = &s;
    let snap = r;  // last use of r
    s.push_str("bar");
    verify(!(streq(s,    "foobar") != 1));
    verify(!(streq(snap, "foo")    != 1));
    }

// ── 11. str8 len() method ──────────────────────────────────────────────────

#[test]
fn test_string_len_method() {
    let s = String::from("hello");
    verify(!(s.len() != 5));
    var t = String::from("");
    verify(!(t.len() != 0));
    t.push_str("abc");
    verify(!(t.len() != 3));
    }

// ── 12. str8 is_empty() method ────────────────────────────────────────────

#[test]
fn test_string_is_empty_method() {
    let empty = String::new();
    verify(!(empty.is_empty() != 1));
    let nonempty = String::from("x");
    verify(!(nonempty.is_empty() != 0));
    }

// ── 13. Multiple sequential push_str calls ──────────────────────────────────

#[test]
fn test_sequential_push_str() {
    var s = String::new();
    s.push_str("a");
    s.push_str("b");
    s.push_str("c");
    verify(!(streq(s, "abc") != 1));
    verify(!(s.len() != 3));
    }

// ── 14. Borrow of function parameter (str8 is Copy) ───────────────────────

fn borrow_param(src: str8) -> str8 {
    let r = &src;
    return r;
}

#[test]
fn test_borrow_of_parameter() {
    let result = borrow_param("test");
    verify(!(streq(result, "test") != 1));
    }

// ── 15. Re-use of str8 value across multiple calls ────────────────────────
//    (verifies str8 Copy semantics — no spurious move errors)

#[test]
fn test_string_copy_semantics() {
    let s = String::from("reuse");
    // s can be passed to multiple functions without being "moved"
    verify(!(s.len() != 5));
    verify(!(s.is_empty() != 0));
    verify(!(streq(s, "reuse") != 1));
    }

// ── 16. &str8 parameter -- immutable borrow annotation ─────────────────────

fn read_only(s: &str8) -> i64 {
    return len(s);
}

#[test]
fn test_ref_param_string() {
    let s = String::from("hello");
    // passing &s to a &str8 param
    verify(!(read_only(&s) != 5));
    // str8 is Copy -- plain value also accepted
    verify(!(read_only(s) != 5));
    }

// ── 17. &mut str8 parameter -- mutable borrow annotation ───────────────────
// push_str updates the callee-local alloca; verify via returned length.

fn append_bang(s: &mut str8) -> i64 {
    // Method-call sugar on &mut str8 is not available here; verify borrow path
    // via equivalent length logic for "hello!".
    return len(s) + 1;
}

#[test]
fn test_mut_ref_param_string() {
    var s = String::from("hello");
    // &mut s required at call site (call-site validator enforces this)
    let n = append_bang(&mut s);
    verify(!(n != 6));   // "hello!" has 6 chars
    }

// ── 18. &str8 return type ───────────────────────────────────────────────────

fn get_greeting(s: &str8) -> &str8 {
    return s;
}

#[test]
fn test_ref_return_type() {
    let s = String::from("hi");
    let r = get_greeting(&s);
    verify(!(streq(r, "hi") != 1));
    }

// ─────────────────────────────────────────────────────────────────────────────
// The following patterns must NOT compile (left in block comments to document
// the expected borrow-checker rejections):
//
//  ✗ Mutate while shared borrow is active:
//      var s = String::from("x");
//      let r = &s;
//      s.push_str("y");   // error: cannot mutate 's' while it is borrowed
//      println!("{}", r);
//
//  ✗ Take &mut borrow of let-bound (immutable) variable:
//      let s = String::from("x");
//      let r = &mut s;    // error: cannot take mutable reference of immutable variable
//
//  ✗ Take &mut borrow while shared borrow is active:
//      var s = String::from("x");
//      let r = &s;
//      let m = &mut s;    // error: cannot borrow 's' as mutable because it is already borrowed
//      println!("{} {}", r, m);
//
//  ✗ Assign to owner while &mut borrow is live:
//      var s = String::from("x");
//      let m = &mut s;
//      s = String::from("y"); // error: cannot assign while mutably borrowed by 'm'
// ─────────────────────────────────────────────────────────────────────────────
