mod std::bench;
mod std::testing;

use std::bench::clobber_memory;
use std::bench::do_not_optimize_i64;
use std::testing::verify;

#[test]
fn inline_asm_nonvolatile_identity() {
    var acc: i64 = 1;
    for i in 0..2048 {
        acc = asm(i64, "", acc);
        acc = acc + i;
    }
    do_not_optimize_i64(acc);
    clobber_memory();
    verify(acc > 0);
}

#[test]
fn inline_asm_volatile_barrier() {
    var acc: i64 = 1;
    for i in 0..2048 {
        asm volatile(void, "", acc);
        acc = acc + i;
    }
    do_not_optimize_i64(acc);
    clobber_memory();
    verify(acc > 0);
}

#[test]
fn bench_mul_plain_two_vars() {
    var lhs: i64 = 3;
    var rhs: i64 = 7;
    var acc: i64 = 0;

    for _i in 0..4096 {
        let product: i64 = lhs * rhs;
        acc = acc + product;
        lhs = lhs + 1;
        rhs = rhs + 3;
    }

    do_not_optimize_i64(acc);
    clobber_memory();
    verify(acc > 0);
}

#[test]
fn bench_mul_asm_two_vars() {
    var lhs: i64 = 3;
    var rhs: i64 = 7;
    var acc: i64 = 0;

    for _i in 0..4096 {
        let product: i64 = asm aarch64(i64, "mul $0, $1, $2", lhs, rhs);
        acc = acc + product;
        lhs = lhs + 1;
        rhs = rhs + 3;
    }

    do_not_optimize_i64(acc);
    clobber_memory();
    verify(acc > 0);
}

#[test]
fn bench_mul_asm_volatile_two_vars() {
    var lhs: i64 = 3;
    var rhs: i64 = 7;
    var acc: i64 = 0;

    for _i in 0..4096 {
        let product: i64 = asm volatile aarch64(i64, "mul $0, $1, $2", lhs, rhs);
        acc = acc + product;
        lhs = lhs + 1;
        rhs = rhs + 3;
    }

    do_not_optimize_i64(acc);
    clobber_memory();
    verify(acc > 0);
}
