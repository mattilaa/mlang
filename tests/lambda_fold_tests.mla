mod std::testing;

use std::testing::verify;
#[test]
fn test_lambda_with_typed_params() {
    var sum: i32 = 0;
    var add = |x: i32, y: i32| {
        sum = x + y;
    };
    add(4, 5);
    verify(sum == 9);
}

#[test]
fn test_lambda_capture_and_single_arg() {
    var base: i64 = 10;
    var bump = |delta: i64| {
        base += delta;
    };
    bump(7);
    bump(3);
    verify(base == 20);
}

#[test]
fn test_fold_sum_and_product() {
    let xs: list<i32> = [1, 2, 3, 4];
    let sum: i32 = (... + xs);
    if sum != 10: { verify(false); }

    let ys: list<i32> = [2, 3, 4];
    let prod: i32 = (ys * ...);
    verify(prod == 24);
}

#[test]
fn test_fold_boolean_ops() {
    let flags: list<bool> = [true, true, false];
    let all_true: bool = (... && flags);
    let any_true: bool = (... || flags);
    if all_true != false: { verify(false); }
    verify(any_true == true);
}

#[test]
fn test_fold_empty_identities() {
    let empty_i32: list<i32> = [];
    let z: i32 = (... + empty_i32);
    let o: i32 = (... * empty_i32);
    if z != 0 || o != 1: { verify(false); }

    let empty_b: list<bool> = [];
    let a: bool = (... && empty_b);
    let n: bool = (... || empty_b);
    if a != true: { verify(false); }
    verify(n == false);
}

#[test]
fn test_right_fold_ops_parse_and_evaluate() {
    let nums: list<i32> = [2, 3, 4];
    let prod: i32 = (nums * ...);
    let sum: i32 = (nums + ...);
    verify(prod == 24);
    verify(sum == 9);

    let flags: list<bool> = [true, true, false];
    let all_true: bool = (flags && ...);
    let any_true: bool = (flags || ...);
    verify(all_true == false);
    verify(any_true == true);
}
