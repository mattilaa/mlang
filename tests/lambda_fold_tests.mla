#[test]
fn test_lambda_with_typed_params() -> i32 {
    var sum: i32 = 0;
    var add = |x: i32, y: i32| {
        sum = x + y;
    };
    add(4, 5);
    return sum == 9 ? 0 : 1;
}

#[test]
fn test_lambda_capture_and_single_arg() -> i32 {
    var base: i64 = 10;
    var bump = |delta: i64| {
        base += delta;
    };
    bump(7);
    bump(3);
    return base == 20 ? 0 : 1;
}

#[test]
fn test_fold_sum_and_product() -> i32 {
    let xs: list<i32> = [1, 2, 3, 4];
    let sum: i32 = (... + xs);
    if sum != 10: { return 1; }

    let ys: list<i32> = [2, 3, 4];
    let prod: i32 = (ys * ...);
    return prod == 24 ? 0 : 1;
}

#[test]
fn test_fold_boolean_ops() -> i32 {
    let flags: list<bool> = [true, true, false];
    let all_true: bool = (... && flags);
    let any_true: bool = (... || flags);
    if all_true != false: { return 1; }
    return any_true == true ? 0 : 1;
}

#[test]
fn test_fold_empty_identities() -> i32 {
    let empty_i32: list<i32> = [];
    let z: i32 = (... + empty_i32);
    let o: i32 = (... * empty_i32);
    if z != 0 || o != 1: { return 1; }

    let empty_b: list<bool> = [];
    let a: bool = (... && empty_b);
    let n: bool = (... || empty_b);
    if a != true: { return 1; }
    return n == false ? 0 : 1;
}
