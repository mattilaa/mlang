fn atomic_i64_increment_worker(raw_handle: i64, iterations: i64) -> i32 {
    let counter: AtomicI64 = AtomicI64 { handle: raw_handle };
    var index: i64 = 0;
    while index < iterations {
        let incremented: result<i64, str8> = counter.fetch_add_with_order(1, AtomicOrder::Relaxed);
        if incremented.is_err() { return 1; }
        index = index + 1;
    }
    return 0;
}

fn atomic_i64_wait_worker(raw_handle: i64) -> i32 {
    let counter: AtomicI64 = AtomicI64 { handle: raw_handle };
    let waited: result<i32, str8> = counter.wait(0);
    if waited.is_err() { return 1; }
    let current: result<i64, str8> = counter.load();
    if current.is_err() { return 2; }
    return current.unwrap() == 1 ? 0 : 3;
}

fn atomic_i64_wait_for_one_worker(raw_handle: i64) -> i32 {
    let counter: AtomicI64 = AtomicI64 { handle: raw_handle };
    let waited: result<i32, str8> = counter.wait(1);
    if waited.is_err() { return 1; }
    let current: result<i64, str8> = counter.load();
    if current.is_err() { return 2; }
    return current.unwrap() == 2 ? 0 : 3;
}

fn latch_arrive_worker(raw_handle: i64) -> i32 {
    let latch: Latch = Latch { handle: raw_handle };
    let waited: result<i32, str8> = latch.arrive_and_wait();
    return waited.is_ok() ? 0 : 1;
}

fn barrier_phase_worker(raw_handle: i64, phases: i64) -> i32 {
    let barrier: Barrier = Barrier { handle: raw_handle };
    var phase_index: i64 = 0;
    while phase_index < phases {
        let token: result<i64, str8> = barrier.arrive();
        if token.is_err() { return 1; }
        let waited: result<i32, str8> = barrier.wait(token.unwrap());
        if waited.is_err() { return 1; }
        phase_index = phase_index + 1;
    }
    return 0;
}

fn barrier_drop_worker(raw_handle: i64) -> i32 {
    let barrier: Barrier = Barrier { handle: raw_handle };
    let phase: result<i64, str8> = barrier.arrive_and_drop();
    return phase.is_ok() ? 0 : 1;
}

fn semaphore_acquire_worker(raw_handle: i64) -> i32 {
    let semaphore: CountingSemaphore = CountingSemaphore { handle: raw_handle };
    let acquired: result<i32, str8> = semaphore.acquire();
    return acquired.is_ok() ? 0 : 1;
}

fn stop_token_worker(raw_handle: i64) -> i32 {
    let token: StopToken = StopToken { raw: raw_handle };
    while true {
        let requested: result<bool, str8> = token.stop_requested();
        if requested.is_err() { return 1; }
        if requested.unwrap() { return 0; }
    }
    return 1;
}

fn jthread_token_worker(token: StopToken) -> i32 {
    var status: i32 = 1;
    while true {
        let requested: result<bool, str8> = token.stop_requested();
        if requested.is_err() { break; }
        if requested.unwrap() {
            status = 0;
            break;
        }
    }
    token.close();
    return status;
}

fn jthread_natural_exit_worker(token: StopToken) -> i32 {
    token.close();
    return 0;
}

#[test]
fn test_jthread_cooperative_stop_and_join() {
    let created: result<StopSource, str8> = StopSource::new();
    verify(created.is_ok());
    if created.is_err() { return; }
    let source: StopSource = created.unwrap();
    let token_result: result<StopToken, str8> = source.token();
    verify(token_result.is_ok());
    if token_result.is_err() {
        source.close();
        return;
    }
    let token: StopToken = token_result.unwrap();
    let worker: std::thread::thread = thread::spawn(jthread_token_worker, token);
    let joined: jthread = jthread::from_parts(worker, source);
    verify(joined.close() == 0);
}

#[test]
fn test_jthread_join_without_stop() {
    let created: result<StopSource, str8> = StopSource::new();
    verify(created.is_ok());
    if created.is_err() { return; }
    let source: StopSource = created.unwrap();
    let token_result: result<StopToken, str8> = source.token();
    verify(token_result.is_ok());
    if token_result.is_err() {
        source.close();
        return;
    }
    let token: StopToken = token_result.unwrap();
    let worker: std::thread::thread = thread::spawn(jthread_natural_exit_worker, token);
    let owner: jthread = jthread::from_parts(worker, source);
    verify(owner.join() == 0);
}

fn test_mutex_lock_unlock_impl() -> i32 {
    let mr: result<mutex, str8> = mutex::new();
    if mr.is_err(): { return 1; }
    let m: mutex = mr.unwrap();
    let l: result<i32, str8> = m.lock();
    if l.is_err(): {
        m.close();
        return 1;
    }
    let u: result<i32, str8> = m.unlock();
    m.close();
    if u.is_err(): { return 1; }
    return 0;
}

#[test]
fn test_mutex_lock_unlock() {
    verify(test_mutex_lock_unlock_impl() == 0);
}

fn test_atomic_i64_operations_impl() -> i32 {
    let created: result<AtomicI64, str8> = AtomicI64::new(10);
    if created.is_err() { return 1; }
    let value: AtomicI64 = created.unwrap();
    if !value.is_valid() { return 1; }

    let initial: result<i64, str8> = value.load();
    let add_old: result<i64, str8> = value.fetch_add(5);
    let sub_old: result<i64, str8> = value.fetch_sub(2);
    let exchange_old: result<i64, str8> = value.exchange(20);
    let and_old: result<i64, str8> = value.fetch_and(6);
    let or_old: result<i64, str8> = value.fetch_or(8);
    let xor_old: result<i64, str8> = value.fetch_xor(3);
    if initial.is_err() || add_old.is_err() || sub_old.is_err() || exchange_old.is_err() ||
       and_old.is_err() || or_old.is_err() || xor_old.is_err() {
        value.close();
        return 1;
    }
    if initial.unwrap() != 10 || add_old.unwrap() != 10 || sub_old.unwrap() != 15 ||
       exchange_old.unwrap() != 13 || and_old.unwrap() != 20 || or_old.unwrap() != 4 ||
       xor_old.unwrap() != 12 {
        value.close();
        return 1;
    }

    let stored: result<i32, str8> = value.store_with_order(22, AtomicOrder::Relaxed);
    let loaded: result<i64, str8> = value.load_with_order(AtomicOrder::Acquire);
    var expected: i64 = 22;
    let matched: result<bool, str8> = value.compare_exchange(&expected, 99, AtomicOrder::AcqRel);
    var stale: i64 = 22;
    let rejected: result<bool, str8> = value.compare_exchange(&stale, 100, AtomicOrder::SeqCst);
    let invalid_store: result<i32, str8> = value.store_with_order(3, AtomicOrder::Acquire);
    let final_value: result<i64, str8> = value.load();
    value.close();

    if stored.is_err() || loaded.is_err() || matched.is_err() || rejected.is_err() ||
       invalid_store.is_ok() || final_value.is_err() { return 1; }
    if loaded.unwrap() != 22 || !matched.unwrap() || !rejected.is_ok() || rejected.unwrap() ||
       stale != 99 || final_value.unwrap() != 99 { return 1; }
    return 0;
}

#[test]
fn test_atomic_i64_operations() {
    verify(test_atomic_i64_operations_impl() == 0);
}

#[test]
fn test_atomic_flag_operations() {
    let created: result<AtomicFlag, str8> = AtomicFlag::new();
    verify(created.is_ok());
    if created.is_err() { return; }
    let flag: AtomicFlag = created.unwrap();
    let initially_set: result<bool, str8> =
        flag.test_and_set_with_order(AtomicOrder::Acquire);
    let already_set: result<bool, str8> = flag.test_and_set();
    let cleared: result<i32, str8> = flag.clear_with_order(AtomicOrder::Release);
    let after_clear: result<bool, str8> =
        flag.test_and_set_with_order(AtomicOrder::Acquire);
    let invalid_clear: result<i32, str8> =
        flag.clear_with_order(AtomicOrder::Acquire);
    let closed: i32 = flag.close();
    verify(initially_set.is_ok() && !initially_set.unwrap());
    verify(already_set.is_ok() && already_set.unwrap());
    verify(cleared.is_ok() && after_clear.is_ok() && !after_clear.unwrap());
    verify(invalid_clear.is_err() && closed == 0);
}

#[test]
fn test_atomic_i64_wait_notify() {
    let created: result<AtomicI64, str8> = AtomicI64::new(0);
    verify(created.is_ok());
    if created.is_err() { return; }
    let counter: AtomicI64 = created.unwrap();
    let worker: std::thread::thread =
        thread::spawn(atomic_i64_wait_worker, counter.handle);
    let worker2: std::thread::thread =
        thread::spawn(atomic_i64_wait_worker, counter.handle);
    let stored: result<i32, str8> = counter.store(1);
    let notified: result<i32, str8> = counter.notify_all();
    let worker_status: i32 = join(worker);
    let worker2_status: i32 = join(worker2);

    let one_worker: std::thread::thread =
        thread::spawn(atomic_i64_wait_for_one_worker, counter.handle);
    let stored_again: result<i32, str8> = counter.store(2);
    let notify_one: result<i32, str8> = counter.notify_one();
    let one_worker_status: i32 = join(one_worker);
    let invalid_order: result<i32, str8> =
        counter.wait_with_order(2, AtomicOrder::Release);
    let closed: i32 = counter.close();
    verify(stored.is_ok() && notified.is_ok() && worker_status == 0 &&
           worker2_status == 0);
    verify(stored_again.is_ok() && notify_one.is_ok() && one_worker_status == 0);
    verify(invalid_order.is_err() && closed == 0);
}

#[test]
fn test_atomic_i64_parallel_increment() {
    let created: result<AtomicI64, str8> = AtomicI64::new(0);
    verify(created.is_ok());
    if created.is_err() { return; }
    let counter: AtomicI64 = created.unwrap();
    let h1: std::thread::thread = thread::spawn(atomic_i64_increment_worker, counter.handle, 10000);
    let h2: std::thread::thread = thread::spawn(atomic_i64_increment_worker, counter.handle, 10000);
    let h3: std::thread::thread = thread::spawn(atomic_i64_increment_worker, counter.handle, 10000);
    let h4: std::thread::thread = thread::spawn(atomic_i64_increment_worker, counter.handle, 10000);
    let r1: i32 = join(h1);
    let r2: i32 = join(h2);
    let r3: i32 = join(h3);
    let r4: i32 = join(h4);
    let observed: result<i64, str8> = counter.load();
    counter.close();
    verify(r1 == 0 && r2 == 0 && r3 == 0 && r4 == 0);
    verify(observed.is_ok());
    if observed.is_ok() { verify(observed.unwrap() == 40000); }
}

#[test]
fn test_latch_count_down_and_wait() {
    let created: result<Latch, str8> = Latch::new(2);
    verify(created.is_ok());
    if created.is_err() { return; }
    let latch: Latch = created.unwrap();
    let initially_ready: result<bool, str8> = latch.try_wait();
    verify(initially_ready.is_ok());
    if initially_ready.is_ok() { verify(!initially_ready.unwrap()); }

    let h1: std::thread::thread = thread::spawn(latch_arrive_worker, latch.handle);
    let h2: std::thread::thread = thread::spawn(latch_arrive_worker, latch.handle);
    let r1: i32 = join(h1);
    let r2: i32 = join(h2);
    let ready: result<bool, str8> = latch.try_wait();
    let too_many: result<i32, str8> = latch.count_down();
    let bad_update: result<i32, str8> = latch.count_down_by(0);
    latch.close();

    verify(r1 == 0 && r2 == 0);
    verify(ready.is_ok());
    if ready.is_ok() { verify(ready.unwrap()); }
    verify(too_many.is_err());
    verify(bad_update.is_err());
}

#[test]
fn test_latch_zero_count_is_ready() {
    let created: result<Latch, str8> = Latch::new(0);
    verify(created.is_ok());
    if created.is_err() { return; }
    let latch: Latch = created.unwrap();
    let ready: result<bool, str8> = latch.try_wait();
    let waited: result<i32, str8> = latch.wait();
    latch.close();
    verify(ready.is_ok() && waited.is_ok());
    if ready.is_ok() { verify(ready.unwrap()); }
}

#[test]
fn test_barrier_multiple_phases() {
    let invalid_count: result<Barrier, str8> = Barrier::new(0);
    verify(invalid_count.is_err());
    let created: result<Barrier, str8> = Barrier::new(3);
    verify(created.is_ok());
    if created.is_err() { return; }
    let barrier: Barrier = created.unwrap();
    let invalid_future_phase: result<i32, str8> = barrier.wait(1);
    verify(invalid_future_phase.is_err());
    let phase_count: i64 = 12;
    let h1: std::thread::thread = thread::spawn(barrier_phase_worker, barrier.handle, phase_count);
    let h2: std::thread::thread = thread::spawn(barrier_phase_worker, barrier.handle, phase_count);
    var index: i64 = 0;
    var failed: bool = false;
    while index < phase_count {
        let waited: result<i32, str8> = barrier.arrive_and_wait();
        if waited.is_err() { failed = true; }
        index = index + 1;
    }
    let r1: i32 = join(h1);
    let r2: i32 = join(h2);
    barrier.close();
    verify(!failed && r1 == 0 && r2 == 0);
}

#[test]
fn test_barrier_arrive_and_drop_reduces_future_participants() {
    let created: result<Barrier, str8> = Barrier::new(2);
    verify(created.is_ok());
    if created.is_err() { return; }
    let barrier: Barrier = created.unwrap();
    let dropper: std::thread::thread = thread::spawn(barrier_drop_worker, barrier.handle);
    let first: result<i32, str8> = barrier.arrive_and_wait();
    // After the other participant drops, this thread is the only expected
    // participant in the following phase.
    let second: result<i32, str8> = barrier.arrive_and_wait();
    let dropped: i32 = join(dropper);
    barrier.close();
    verify(first.is_ok() && second.is_ok() && dropped == 0);
}

#[test]
fn test_counting_semaphore_permits_and_bounds() {
    let invalid: result<CountingSemaphore, str8> = CountingSemaphore::new(2, 1);
    verify(invalid.is_err());
    let created: result<CountingSemaphore, str8> = CountingSemaphore::new(0, 2);
    verify(created.is_ok());
    if created.is_err() { return; }
    let semaphore: CountingSemaphore = created.unwrap();
    let empty: result<bool, str8> = semaphore.try_acquire();
    let released: result<i32, str8> = semaphore.release_by(2);
    let first: result<bool, str8> = semaphore.try_acquire();
    let second: result<bool, str8> = semaphore.try_acquire();
    let still_empty: result<bool, str8> = semaphore.try_acquire();
    let too_many: result<i32, str8> = semaphore.release_by(3);
    let no_permits: result<i32, str8> = semaphore.release_by(0);
    semaphore.close();

    verify(empty.is_ok() && released.is_ok() && first.is_ok() && second.is_ok() && still_empty.is_ok());
    if empty.is_ok() { verify(!empty.unwrap()); }
    if first.is_ok() && second.is_ok() && still_empty.is_ok() {
        verify(first.unwrap() && second.unwrap() && !still_empty.unwrap());
    }
    verify(too_many.is_err() && no_permits.is_err());
}

#[test]
fn test_counting_semaphore_blocking_acquire() {
    let created: result<CountingSemaphore, str8> = CountingSemaphore::new(0, 1);
    verify(created.is_ok());
    if created.is_err() { return; }
    let semaphore: CountingSemaphore = created.unwrap();
    let worker: std::thread::thread = thread::spawn(semaphore_acquire_worker, semaphore.handle);
    let released: result<i32, str8> = semaphore.release();
    let status: i32 = join(worker);
    let available: result<bool, str8> = semaphore.try_acquire();
    semaphore.close();
    verify(released.is_ok() && status == 0 && available.is_ok());
    if available.is_ok() { verify(!available.unwrap()); }
}

#[test]
fn test_stop_source_and_retained_tokens() {
    let created: result<StopSource, str8> = StopSource::new();
    verify(created.is_ok());
    if created.is_err() { return; }
    let source: StopSource = created.unwrap();
    let source_clone_result: result<StopSource, str8> = source.clone();
    verify(source_clone_result.is_ok());
    if source_clone_result.is_err() { source.close(); return; }
    let source_clone: StopSource = source_clone_result.unwrap();
    let token_result: result<StopToken, str8> = source.token();
    verify(token_result.is_ok());
    if token_result.is_err() {
        source_clone.close();
        source.close();
        return;
    }
    let token: StopToken = token_result.unwrap();
    let clone_result: result<StopToken, str8> = token.clone();
    verify(clone_result.is_ok());
    if clone_result.is_err() {
        token.close();
        source_clone.close();
        source.close();
        return;
    }
    let clone: StopToken = clone_result.unwrap();
    let initially_requested: result<bool, str8> = token.stop_requested();
    let initially_possible: bool = token.stop_possible();
    let worker: std::thread::thread = thread::spawn(stop_token_worker, token.raw);
    let first_request: result<bool, str8> = source.request_stop();
    let repeated_request: result<bool, str8> = source_clone.request_stop();
    let source_closed: i32 = source.close();
    let still_possible: bool = token.stop_possible();
    let source_clone_closed: i32 = source_clone.close();
    let no_longer_possible: bool = token.stop_possible();
    let worker_status: i32 = join(worker);
    let token_observed: result<bool, str8> = token.stop_requested();
    let clone_observed: result<bool, str8> = clone.stop_requested();
    token.close();
    clone.close();

    verify(initially_requested.is_ok() && first_request.is_ok() && repeated_request.is_ok());
    if initially_requested.is_ok() { verify(!initially_requested.unwrap()); }
    if first_request.is_ok() { verify(first_request.unwrap()); }
    if repeated_request.is_ok() { verify(!repeated_request.unwrap()); }
    verify(initially_possible && still_possible && !no_longer_possible);
    verify(source_closed == 0 && source_clone_closed == 0 && worker_status == 0);
    verify(token_observed.is_ok() && clone_observed.is_ok());
    if token_observed.is_ok() && clone_observed.is_ok() {
        verify(token_observed.unwrap() && clone_observed.unwrap());
    }
}

fn test_condvar_wait_timeout_impl() -> i32 {
    let mr: result<mutex, str8> = mutex::new();
    let cr: result<Condvar, str8> = Condvar::new();
    if mr.is_err(): { return 1; }
    if cr.is_err(): { return 1; }
    let m: mutex = mr.unwrap();
    let c: Condvar = cr.unwrap();

    let l: result<i32, str8> = m.lock();
    if l.is_err(): {
        c.close();
        m.close();
        return 1;
    }
    let wr: result<i32, str8> = c.wait_timeout_ms(m, 20);
    let u: result<i32, str8> = m.unlock();
    c.close();
    m.close();
    if wr.is_err(): { return 1; }
    if u.is_err(): { return 1; }
    return wr.unwrap() == 1 ? 0 : 1;
}

#[test]
fn test_condvar_wait_timeout() {
    verify(test_condvar_wait_timeout_impl() == 0);
}

fn test_channel_send_recv_try_recv_impl() -> i32 {
    let cr: result<Channel, str8> = Channel::new(2);
    if cr.is_err(): { return 1; }
    let ch: Channel = cr.unwrap();

    let s1: result<i32, str8> = ch.send("hello-sync");
    if s1.is_err(): {
        ch.free();
        return 1;
    }

    var buf = String::with_capacity(128);
    let rr: result<i64, str8> = ch.recv(buf, 128);
    if rr.is_err(): {
        String::free(buf);
        ch.free();
        return 1;
    }
    let ok: i32 = contains(buf, "hello-sync") == 1 ? 1 : 0;

    let tr: result<i64, str8> = ch.try_recv(buf, 128);
    String::free(buf);
    ch.close();
    ch.free();
    if tr.is_err(): { return 1; }
    // empty non-closed try_recv uses -2
    if tr.unwrap() != -2: { return 1; }
    return ok == 1 ? 0 : 1;
}

#[test]
fn test_channel_send_recv_try_recv() {
    verify(test_channel_send_recv_try_recv_impl() == 0);
}

fn test_lock_free_queue_basic_impl() -> i32 {
    let qr: result<LockFreeQueue, str8> = LockFreeQueue::new(2);
    if qr.is_err(): { return 1; }
    let q: LockFreeQueue = qr.unwrap();

    let s1: result<i32, str8> = q.try_send("lfq-1");
    if s1.is_err() || s1.unwrap() != 0: {
        q.free();
        return 1;
    }
    let s2: result<i32, str8> = q.try_send("lfq-2");
    if s2.is_err() || s2.unwrap() != 0: {
        q.free();
        return 1;
    }
    let s3: result<i32, str8> = q.try_send("lfq-3");
    if s3.is_err() || s3.unwrap() != 1: {
        q.free();
        return 1;
    }

    var buf = String::with_capacity(64);
    let r1: result<i64, str8> = q.try_recv(buf, 64);
    let ok1: i32 = r1.is_ok() && r1.unwrap() > 0 && contains(buf, "lfq-1") == 1 ? 1 : 0;
    let r2: result<i64, str8> = q.try_recv(buf, 64);
    let ok2: i32 = r2.is_ok() && r2.unwrap() > 0 && contains(buf, "lfq-2") == 1 ? 1 : 0;
    let r3: result<i64, str8> = q.try_recv(buf, 64);
    let ok3: i32 = r3.is_ok() && r3.unwrap() == -2 ? 1 : 0;

    q.close();
    let r4: result<i64, str8> = q.try_recv(buf, 64);
    let ok4: i32 = r4.is_ok() && r4.unwrap() == 0 ? 1 : 0;
    String::free(buf);
    q.free();

    if ok1 == 0 || ok2 == 0 || ok3 == 0 || ok4 == 0: { return 1; }
    return 0;
}

#[test]
fn test_lock_free_queue_basic() {
    verify(test_lock_free_queue_basic_impl() == 0);
}
