mod std::testing;
mod std::sync;
mod std::strbuf;

use std::strbuf::contains;
use std::sync::Channel;
use std::sync::Condvar;
use std::sync::LockFreeQueue;
use std::sync::mutex;
use std::testing::verify;

fn test_mutex_lock_unlock_impl() -> i32 {
    let mr: result<mutex, str8> = mutex::new();
    if mr.is_err(): { return 1; }
    let m: mutex = mr.unwrap();
    let l: result<i32, str8> = m.lock();
    if l.is_err(): {
        m.close();
        return 1;
    }
    let u: result<i32, str8> = m.unlock();
    m.close();
    if u.is_err(): { return 1; }
    return 0;
}

#[test]
fn test_mutex_lock_unlock() {
    verify(test_mutex_lock_unlock_impl() == 0);
}

fn test_condvar_wait_timeout_impl() -> i32 {
    let mr: result<mutex, str8> = mutex::new();
    let cr: result<Condvar, str8> = Condvar::new();
    if mr.is_err(): { return 1; }
    if cr.is_err(): { return 1; }
    let m: mutex = mr.unwrap();
    let c: Condvar = cr.unwrap();

    let l: result<i32, str8> = m.lock();
    if l.is_err(): {
        c.close();
        m.close();
        return 1;
    }
    let wr: result<i32, str8> = c.wait_timeout_ms(m, 20);
    let u: result<i32, str8> = m.unlock();
    c.close();
    m.close();
    if wr.is_err(): { return 1; }
    if u.is_err(): { return 1; }
    return wr.unwrap() == 1 ? 0 : 1;
}

#[test]
fn test_condvar_wait_timeout() {
    verify(test_condvar_wait_timeout_impl() == 0);
}

fn test_channel_send_recv_try_recv_impl() -> i32 {
    let cr: result<Channel, str8> = Channel::new(2);
    if cr.is_err(): { return 1; }
    let ch: Channel = cr.unwrap();

    let s1: result<i32, str8> = ch.send("hello-sync");
    if s1.is_err(): {
        ch.free();
        return 1;
    }

    var buf = String::with_capacity(128);
    let rr: result<i64, str8> = ch.recv(buf, 128);
    if rr.is_err(): {
        String::free(buf);
        ch.free();
        return 1;
    }
    let ok: i32 = contains(buf, "hello-sync") == 1 ? 1 : 0;

    let tr: result<i64, str8> = ch.try_recv(buf, 128);
    String::free(buf);
    ch.close();
    ch.free();
    if tr.is_err(): { return 1; }
    // empty non-closed try_recv uses -2
    if tr.unwrap() != -2: { return 1; }
    return ok == 1 ? 0 : 1;
}

#[test]
fn test_channel_send_recv_try_recv() {
    verify(test_channel_send_recv_try_recv_impl() == 0);
}

fn test_lock_free_queue_basic_impl() -> i32 {
    let qr: result<LockFreeQueue, str8> = LockFreeQueue::new(2);
    if qr.is_err(): { return 1; }
    let q: LockFreeQueue = qr.unwrap();

    let s1: result<i32, str8> = q.try_send("lfq-1");
    if s1.is_err() || s1.unwrap() != 0: {
        q.free();
        return 1;
    }
    let s2: result<i32, str8> = q.try_send("lfq-2");
    if s2.is_err() || s2.unwrap() != 0: {
        q.free();
        return 1;
    }
    let s3: result<i32, str8> = q.try_send("lfq-3");
    if s3.is_err() || s3.unwrap() != 1: {
        q.free();
        return 1;
    }

    var buf = String::with_capacity(64);
    let r1: result<i64, str8> = q.try_recv(buf, 64);
    let ok1: i32 = r1.is_ok() && r1.unwrap() > 0 && contains(buf, "lfq-1") == 1 ? 1 : 0;
    let r2: result<i64, str8> = q.try_recv(buf, 64);
    let ok2: i32 = r2.is_ok() && r2.unwrap() > 0 && contains(buf, "lfq-2") == 1 ? 1 : 0;
    let r3: result<i64, str8> = q.try_recv(buf, 64);
    let ok3: i32 = r3.is_ok() && r3.unwrap() == -2 ? 1 : 0;

    q.close();
    let r4: result<i64, str8> = q.try_recv(buf, 64);
    let ok4: i32 = r4.is_ok() && r4.unwrap() == 0 ? 1 : 0;
    String::free(buf);
    q.free();

    if ok1 == 0 || ok2 == 0 || ok3 == 0 || ok4 == 0: { return 1; }
    return 0;
}

#[test]
fn test_lock_free_queue_basic() {
    verify(test_lock_free_queue_basic_impl() == 0);
}
