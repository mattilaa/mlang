mod std::testing;
mod std::strbuf;

use std::strbuf::eq;
use std::testing::verify;

#[test]
fn test_ternary_with_function_call_condition() {
    let s: str8 = "ok";
    verify(eq(s, "ok") == 1);
}

#[test]
fn test_ternary_false_branch() {
    let s: str8 = "bad";
    verify(!(eq(s, "ok") == 1));
}

#[test]
fn test_ternary_multiline() {
    let x: i32 = 5;
    let y: i32 = x > 3 ?
        7 :
        9;
    verify(y == 7);
}
