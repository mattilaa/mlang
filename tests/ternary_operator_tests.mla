mod std::testing;
mod std::strbuf;

use std::strbuf::eq;
use std::testing::verify;
use std::testing::verify_eq_i32;
use std::testing::verify_eq_i64;

struct TernaryObj {
    var id: i32;
};

fn choose_true() -> bool {
    return true;
}

fn make_obj_a() -> TernaryObj {
    return TernaryObj { id: 1 };
}

fn make_obj_b() -> TernaryObj {
    return TernaryObj { id: 2 };
}

#[test]
fn test_ternary_with_function_call_condition() {
    let s: str8 = "ok";
    verify(eq(s, "ok") == 1);
}

#[test]
fn test_ternary_false_branch() {
    let s: str8 = "bad";
    verify(!(eq(s, "ok") == 1));
}

#[test]
fn test_ternary_multiline() {
    let x: i32 = 5;
    let y: i32 = x > 3 ?
        7 :
        9;
    verify(y == 7);
}

#[test]
fn test_ternary_function_call_condition() {
    let y: i32 = choose_true() ? 11 : 22;
    verify_eq_i32(11, y);
}

#[test]
fn test_ternary_object_instantiation_branches() {
    let o: TernaryObj = choose_true() ? make_obj_a() : make_obj_b();
    verify_eq_i32(1, o.id);
}

#[test]
fn test_ternary_condition_with_logical_or_parenthesized() {
    let full_l: i32 = 0;
    let half_l: i32 = 1;
    let on_l: i32 = (full_l == 1 || half_l == 1) ? 1 : 0;
    verify_eq_i32(1, on_l);
}

#[test]
fn test_ternary_condition_with_logical_and_parenthesized() {
    let a: i32 = 2;
    let b: i32 = 3;
    let x: i32 = (a > 1 && b > 1) ? 10 : 20;
    verify_eq_i32(10, x);
}

#[test]
fn test_ternary_condition_nested_logical_parenthesized() {
    let full_r: i32 = 0;
    let half_r: i32 = 1;
    let someCondition: i32 = 0;
    let someOtherCondition: i32 = 1;
    let on_r: i32 = ((full_r == 1 || half_r == 1) || someCondition == 1) && someOtherCondition == 1 ? 1 : 0;
    verify_eq_i32(1, on_r);
}

// Parenthesized inner ternary expression must be accepted as the
// true-branch (or false-branch) of an outer ternary. Regression cover for
// the `(... ? ... : ...)` form, which previously could not appear inside
// another expression because the parenthesized-primary rule only accepted
// a bool-or-arithmetic expression, not a ternary.
#[test]
fn test_ternary_nested_parenthesized_true_branch() {
    let a: i64 = 0i64;
    let blink: i32 = 1;
    let face: i64 = a <= 0 ? (blink == 1 ? 1i64 : 6i64) : a;
    verify_eq_i64(1, face);
}

#[test]
fn test_typed_int_literal_in_list() {
    var dice: list<i64> = [3i64, 0i64];
    verify_eq_i64(3, dice[0]);
    verify_eq_i64(0, dice[1]);
}
