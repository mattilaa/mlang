mod std::io;

use std::io::*;

#[test]
fn test_stdout_lock_and_unlock() -> i32 {
    let lk: StdoutLock = lock(stdout());
    let rc = unlock(lk);
    let written = writeln_sync(stdout(), "std_io_lock_test");
    return rc == 0 ? 0 : 1;
}

#[test]
fn test_sync_write_releases_lock() -> i32 {
    let n = writeln_sync(stdout(), "std_io_sync_test");
    if n <= 0: { return 1; }
    let lk: StdoutLock = lock(stdout());
    let rc = unlock(lk);
    return rc == 0 ? 0 : 1;
}

fn lock_and_return() -> i32 {
    let out: Stdout = stdout();
    let lk: StdoutLock = lock(out);
    writeln_locked(lk, "std_io_raii_drop_test");
    // No explicit unlock. __drop(StdoutLock) should run on return.
    return 0;
}

#[test]
fn test_scope_exit_drop_unlocks() -> i32 {
    let out: Stdout = stdout();
    if lock_and_return() != 0: { return 1; }
    return try_lock(out) == 1 ? 0 : 1;
}

#[test]
fn test_stderr_and_flush() -> i32 {
    let n1: i64 = write(stderr(), "std_io_stderr_test");
    let n2: i64 = writeln(stderr(), "");
    let f: i32 = flush(stderr());
    if n1 <= 0: { return 1; }
    if n2 <= 0: { return 1; }
    return f == 0 ? 0 : 1;
}

#[test]
fn test_buffering_configuration() -> i32 {
    let rc1: i32 = set_stdout_buffering(buffering_line(), 1024);
    let rc2: i32 = set_stderr_buffering(buffering_unbuffered(), 0);
    let rc3: i32 = set_stdin_buffering(buffering_full(), 1024);
    if rc1 != 0: { return 1; }
    if rc2 != 0: { return 1; }
    return rc3 == 0 ? 0 : 1;
}

#[test]
fn test_nonblocking_stdin_read() -> i32 {
    let input: Stdin = stdin();
    var buf = String::with_capacity(64);
    let n: i64 = read_line_nonblocking(input, buf, 64);
    String::free(buf);
    // In CI/stdin-closed cases this can be -1; with no pending input it's 0.
    // If the process receives input, positive values are also valid.
    if n < -1: { return 1; }
    return 0;
}
