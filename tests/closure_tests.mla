mod std::testing;
// Tests for:
//   - Compound assignment operators (+=, -=, *=, /=, %=)
//   - Inline capturing closures (var f = || { ... }; f();)
//   - thread::spawn with closure literal (|| { ... })

mod std::thread;
use std::thread::*;
use std::testing::verify;

// ── Compound assignment ───────────────────────────────────────────────────────

#[test]
fn test_plus_assign() {
    var x: i32 = 10;
    x += 5;
    verify(!(x != 15));
    x += 0;
    verify(!(x != 15));
    x += -3;
    verify(!(x != 12));
    }

#[test]
fn test_minus_assign() {
    var x: i32 = 20;
    x -= 8;
    verify(!(x != 12));
    x -= 0;
    verify(!(x != 12));
    x -= -2;
    verify(!(x != 14));
    }

#[test]
fn test_multiply_assign() {
    var x: i32 = 3;
    x *= 4;
    verify(!(x != 12));
    x *= 1;
    verify(!(x != 12));
    x *= 0;
    verify(!(x != 0));
    }

#[test]
fn test_divide_assign() {
    var x: i32 = 100;
    x /= 4;
    verify(!(x != 25));
    x /= 5;
    verify(!(x != 5));
    x /= 1;
    verify(!(x != 5));
    }

#[test]
fn test_modulo_assign() {
    var x: i32 = 17;
    x %= 5;
    verify(!(x != 2));
    x %= 3;
    verify(!(x != 2));
    x %= 7;
    verify(!(x != 2));
    }

#[test]
fn test_compound_assign_chained() {
    var n: i32 = 1;
    n += 4;   // 5
    n *= 3;   // 15
    n -= 5;   // 10
    n /= 2;   // 5
    n %= 3;   // 2
    verify(!(n != 2));
    }

// ── Inline capturing closures ─────────────────────────────────────────────────

// Basic counter — the canonical use-case: closure mutates outer var.
#[test]
fn test_closure_counter() {
    var count: i32 = 0;
    var inc = || {
        count += 1;
    };
    inc();
    inc();
    inc();
    verify(!(count != 3));
    }

// Closure reads and writes the captured variable correctly each call.
#[test]
fn test_closure_value_after_calls() {
    var x: i32 = 10;
    var add5 = || {
        x += 5;
    };
    add5();
    verify(!(x != 15));
    add5();
    verify(!(x != 20));
    }

// Closure captures multiple outer variables.
#[test]
fn test_closure_multiple_captures() {
    var a: i32 = 0;
    var b: i32 = 100;
    var step = || {
        a += 1;
        b -= 10;
    };
    step();
    step();
    step();
    verify(!(a != 3));
    verify(!(b != 70));
    }

// Two independent closures over different variables.
#[test]
fn test_two_independent_closures() {
    var x: i32 = 0;
    var y: i32 = 0;
    var incX = || { x += 1; };
    var incY = || { y += 2; };
    incX();
    incX();
    incY();
    verify(!(x != 2));
    verify(!(y != 2));
    }

// let binding of a closure works the same as var.
#[test]
fn test_let_closure() {
    var total: i32 = 0;
    let add10 = || {
        total += 10;
    };
    add10();
    add10();
    verify(!(total != 20));
    }

// Closure called from inside an if block.
#[test]
fn test_closure_called_in_if() {
    var flag: bool = true;
    var counter: i32 = 0;
    var bump = || { counter += 1; };
    if flag: {
        bump();
        bump();
    }
    verify(!(counter != 2));
    }

// Closure called from inside a for loop.
#[test]
fn test_closure_called_in_loop() {
    var sum: i32 = 0;
    var acc = || { sum += 1; };
    for i in 0..5 {
        acc();
    }
    verify(!(sum != 5));
    }

// Closure body uses a compound assignment internally.
#[test]
fn test_closure_body_compound_assign() {
    var product: i32 = 1;
    var dbl = || { product *= 2; };
    dbl();
    dbl();
    dbl();
    verify(!(product != 8));
    }

// ── thread::spawn with closure literal ───────────────────────────────────────

// Spawn a no-op closure and join -- just verifies no crash / correct handle.
#[test]
fn test_thread_spawn_closure_basic() {
    let h: Handle<Thread> = thread_spawn(|| {
        var x: i32 = 1;
        x += 1;
    });
    join(h);
    }

// Spawn a closure containing a for loop.
#[test]
fn test_thread_spawn_closure_loop() {
    let h: Handle<Thread> = thread_spawn(|| {
        var s: i32 = 0;
        for i in 0..4 {
            s += 1;
        }
    });
    join(h);
    }

// thread_spawn intrinsic form also accepts a closure.
#[test]
fn test_thread_spawn_intrinsic_closure() {
    let h: Handle<Thread> = thread_spawn(|| {
        var dummy: i32 = 42;
        dummy *= 2;
    });
    join(h);
    }
