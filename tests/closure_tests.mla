// Tests for:
//   - Compound assignment operators (+=, -=, *=, /=, %=)
//   - Inline capturing closures (var f = || { ... }; f();)
//   - thread::spawn with closure literal (|| { ... })

mod std::thread;
use std::thread::*;

// ── Compound assignment ───────────────────────────────────────────────────────

#[test]
fn test_plus_assign() -> i32 {
    var x: i32 = 10;
    x += 5;
    if x != 15: { return 1; }
    x += 0;
    if x != 15: { return 1; }
    x += -3;
    if x != 12: { return 1; }
    return 0;
}

#[test]
fn test_minus_assign() -> i32 {
    var x: i32 = 20;
    x -= 8;
    if x != 12: { return 1; }
    x -= 0;
    if x != 12: { return 1; }
    x -= -2;
    if x != 14: { return 1; }
    return 0;
}

#[test]
fn test_multiply_assign() -> i32 {
    var x: i32 = 3;
    x *= 4;
    if x != 12: { return 1; }
    x *= 1;
    if x != 12: { return 1; }
    x *= 0;
    if x != 0: { return 1; }
    return 0;
}

#[test]
fn test_divide_assign() -> i32 {
    var x: i32 = 100;
    x /= 4;
    if x != 25: { return 1; }
    x /= 5;
    if x != 5: { return 1; }
    x /= 1;
    if x != 5: { return 1; }
    return 0;
}

#[test]
fn test_modulo_assign() -> i32 {
    var x: i32 = 17;
    x %= 5;
    if x != 2: { return 1; }
    x %= 3;
    if x != 2: { return 1; }
    x %= 7;
    if x != 2: { return 1; }
    return 0;
}

#[test]
fn test_compound_assign_chained() -> i32 {
    var n: i32 = 1;
    n += 4;   // 5
    n *= 3;   // 15
    n -= 5;   // 10
    n /= 2;   // 5
    n %= 3;   // 2
    if n != 2: { return 1; }
    return 0;
}

// ── Inline capturing closures ─────────────────────────────────────────────────

// Basic counter — the canonical use-case: closure mutates outer var.
#[test]
fn test_closure_counter() -> i32 {
    var count: i32 = 0;
    var inc = || {
        count += 1;
    };
    inc();
    inc();
    inc();
    if count != 3: { return 1; }
    return 0;
}

// Closure reads and writes the captured variable correctly each call.
#[test]
fn test_closure_value_after_calls() -> i32 {
    var x: i32 = 10;
    var add5 = || {
        x += 5;
    };
    add5();
    if x != 15: { return 1; }
    add5();
    if x != 20: { return 1; }
    return 0;
}

// Closure captures multiple outer variables.
#[test]
fn test_closure_multiple_captures() -> i32 {
    var a: i32 = 0;
    var b: i32 = 100;
    var step = || {
        a += 1;
        b -= 10;
    };
    step();
    step();
    step();
    if a != 3: { return 1; }
    if b != 70: { return 1; }
    return 0;
}

// Two independent closures over different variables.
#[test]
fn test_two_independent_closures() -> i32 {
    var x: i32 = 0;
    var y: i32 = 0;
    var incX = || { x += 1; };
    var incY = || { y += 2; };
    incX();
    incX();
    incY();
    if x != 2: { return 1; }
    if y != 2: { return 1; }
    return 0;
}

// let binding of a closure works the same as var.
#[test]
fn test_let_closure() -> i32 {
    var total: i32 = 0;
    let add10 = || {
        total += 10;
    };
    add10();
    add10();
    if total != 20: { return 1; }
    return 0;
}

// Closure called from inside an if block.
#[test]
fn test_closure_called_in_if() -> i32 {
    var flag: bool = true;
    var counter: i32 = 0;
    var bump = || { counter += 1; };
    if flag: {
        bump();
        bump();
    }
    if counter != 2: { return 1; }
    return 0;
}

// Closure called from inside a for loop.
#[test]
fn test_closure_called_in_loop() -> i32 {
    var sum: i32 = 0;
    var acc = || { sum += 1; };
    for i in 0..5 {
        acc();
    }
    if sum != 5: { return 1; }
    return 0;
}

// Closure body uses a compound assignment internally.
#[test]
fn test_closure_body_compound_assign() -> i32 {
    var product: i32 = 1;
    var dbl = || { product *= 2; };
    dbl();
    dbl();
    dbl();
    if product != 8: { return 1; }
    return 0;
}

// ── thread::spawn with closure literal ───────────────────────────────────────

// Spawn a no-op closure and join -- just verifies no crash / correct handle.
#[test]
fn test_thread_spawn_closure_basic() -> i32 {
    let h: Handle<Thread> = thread_spawn(|| {
        var x: i32 = 1;
        x += 1;
    });
    join(h);
    return 0;
}

// Spawn a closure containing a for loop.
#[test]
fn test_thread_spawn_closure_loop() -> i32 {
    let h: Handle<Thread> = thread_spawn(|| {
        var s: i32 = 0;
        for i in 0..4 {
            s += 1;
        }
    });
    join(h);
    return 0;
}

// thread_spawn intrinsic form also accepts a closure.
#[test]
fn test_thread_spawn_intrinsic_closure() -> i32 {
    let h: Handle<Thread> = thread_spawn(|| {
        var dummy: i32 = 42;
        dummy *= 2;
    });
    join(h);
    return 0;
}
