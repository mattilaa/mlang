#[test]
fn while_without_colon_runs() -> i32 {
    var i: i32 = 0;
    var sum: i32 = 0;
    while i < 5 {
        sum = sum + i;
        i = i + 1;
    }
    return sum == 10 ? 0 : 1;
}

#[test]
fn while_with_guard_runs() -> i32 {
    var i: i32 = 0;
    var j: i32 = 1;
    var count: i32 = 0;
    while i < 8: j > i && (8 == 8) {
        count = count + 1;
        i = i + 1;
        j = j + 1;
    }
    return count == 8 ? 0 : 1;
}

#[test]
fn while_with_redundant_colon_runs() -> i32 {
    var i: i32 = 0;
    while i < 3: {
        i = i + 1;
    }
    return i == 3 ? 0 : 1;
}
