mod std::testing;

use std::testing::verify;
#[test]
fn while_without_colon_runs() {
    var i: i32 = 0;
    var sum: i32 = 0;
    while i < 5 {
        sum = sum + i;
        i = i + 1;
    }
    verify(sum == 10);
}

#[test]
fn while_with_guard_runs() {
    var i: i32 = 0;
    var j: i32 = 1;
    var count: i32 = 0;
    while i < 8: j > i && (8 == 8) {
        count = count + 1;
        i = i + 1;
        j = j + 1;
    }
    verify(count == 8);
}

#[test]
fn while_with_redundant_colon_runs() {
    var i: i32 = 0;
    while i < 3: {
        i = i + 1;
    }
    verify(i == 3);
}
