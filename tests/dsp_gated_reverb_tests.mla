mod std::testing;
mod dsp::gated_reverb;
use dsp::gated_reverb::GatedVerb;
use dsp::gated_reverb::GatedVerbFrame;
use dsp::gated_reverb::GatedVerbType;
use std::testing::verify;

fn abs32(value: f32) -> f32 { return value < 0.0f ? -value : value; }

// A deterministic drum hit: a decaying square burst, loud for ~40 ms.
fn hit(i: i32) -> f32 {
    if i >= 4800 { return 0.0f; }
    let level: f32 = 0.8f * (1.0f - f32(i) / 4800.0f);
    return (i % 37) < 18 ? level : -level;
}

fn wet_only(kind: GatedVerbType) -> GatedVerb {
    var verb: GatedVerb = GatedVerb::new(48000.0f);
    verb.set_type(kind);
    verb.set_dry_db(-60.0f);
    verb.reset();
    return verb;
}

// Sum of |left| over [from, to) ms of one hit at 48 kHz through a wet-only
// reverb with the given settings.
fn window_energy(kind: GatedVerbType, hold_ms: f32, release_ms: f32, threshold_db: f32, reverb_db: f32,
                 from_ms: i32, to_ms: i32, total_ms: i32) -> f32 {
    var verb: GatedVerb = wet_only(kind);
    verb.set_hold_ms(hold_ms); verb.set_release_ms(release_ms);
    verb.set_threshold_db(threshold_db); verb.set_reverb_db(reverb_db); verb.reset();
    var sum: f32 = 0.0f;
    for i in 0..(total_ms * 48) {
        let frame: GatedVerbFrame = verb.process_stereo(hit(i), hit(i));
        if i >= from_ms * 48 && i < to_ms * 48 { sum = sum + abs32(frame.left()); }
    }
    return sum;
}

#[test]
fn test_gated_reverb_is_silent_without_input() {
    var verb: GatedVerb = wet_only(GatedVerbType::Room);
    for i in 0..48000 {
        let frame: GatedVerbFrame = verb.process_stereo(0.0f, 0.0f);
        verify(frame.left() == 0.0f && frame.right() == 0.0f);
    }
    verify(!verb.is_open());
}

#[test]
fn test_gated_reverb_holds_then_closes() {
    // Defaults: 8 ms pre-delay + 250 ms hold, then an 80 ms release.
    var verb: GatedVerb = wet_only(GatedVerbType::Room);
    var held: f32 = 0.0f;
    var after: f32 = 0.0f;
    for i in 0..(600 * 48) {
        let frame: GatedVerbFrame = verb.process_stereo(hit(i), hit(i));
        if i >= 100 * 48 && i < 250 * 48 { held = held + abs32(frame.left()); }
        if i >= 345 * 48 { after = after + abs32(frame.left()) + abs32(frame.right()); }
        if i == 200 * 48 { verify(verb.envelope() > 0.99f); }
    }
    verify(held > 100.0f);
    verify(after == 0.0f);
    verify(!verb.is_open());
}

#[test]
fn test_gated_reverb_hold_moves_the_release() {
    verify(window_energy(GatedVerbType::Room, 100.0f, 80.0f, -24.0f, 0.0f, 250, 350, 600) == 0.0f);
    verify(window_energy(GatedVerbType::Room, 400.0f, 80.0f, -24.0f, 0.0f, 250, 350, 600) > 50.0f);
}

#[test]
fn test_gated_reverb_release_length() {
    // Hold 100 ms: the gate is still partly open 150 ms into a 300 ms
    // release, but closed well before that with a 20 ms release.
    verify(window_energy(GatedVerbType::Room, 100.0f, 20.0f, -24.0f, 0.0f, 150, 250, 400) == 0.0f);
    verify(window_energy(GatedVerbType::Room, 100.0f, 300.0f, -24.0f, 0.0f, 150, 250, 400) > 5.0f);
}

#[test]
fn test_gated_reverb_threshold() {
    verify(window_energy(GatedVerbType::Room, 250.0f, 80.0f, -1.0f, 0.0f, 0, 400, 400) == 0.0f);
}

#[test]
fn test_gated_reverb_reverse_swells() {
    var verb: GatedVerb = wet_only(GatedVerbType::Reverse);
    verb.set_squash(0.0f);
    var early: f32 = 0.0f;
    var late: f32 = 0.0f;
    for i in 0..(300 * 48) {
        let frame: GatedVerbFrame = verb.process_stereo(hit(i), hit(i));
        if i >= 20 * 48 && i < 70 * 48 { early = early + abs32(frame.left()); }
        if i >= 200 * 48 && i < 250 * 48 { late = late + abs32(frame.left()); }
    }
    verify(late > 3.0f * early);
}

#[test]
fn test_gated_reverb_levels() {
    let a: f32 = window_energy(GatedVerbType::Plate, 250.0f, 80.0f, -24.0f, 0.0f, 50, 250, 300);
    let b: f32 = window_energy(GatedVerbType::Plate, 250.0f, 80.0f, -24.0f, -12.0f, 50, 250, 300);
    verify(b > a * 0.2f && b < a * 0.3f);

    // Reverb at its lowest never touches the dry signal before it arrives.
    var dry: GatedVerb = GatedVerb::new(48000.0f);
    dry.set_output_db(-6.0f); dry.reset();
    let frame: GatedVerbFrame = dry.process_stereo(0.5f, -0.25f);
    verify(abs32(frame.left() - 0.2505936f) < 0.0001f && abs32(frame.right() + 0.1252968f) < 0.0001f);
}

#[test]
fn test_gated_reverb_width_zero_is_mono() {
    var verb: GatedVerb = wet_only(GatedVerbType::Room);
    verb.set_width(0.0f);
    var spread: f32 = 0.0f;
    for i in 0..(300 * 48) {
        let frame: GatedVerbFrame = verb.process_stereo(hit(i), hit(i));
        spread = spread + abs32(frame.left() - frame.right());
    }
    verify(spread < 0.001f);
}

#[test]
fn test_gated_reverb_extremes_stay_finite() {
    var verb: GatedVerb = GatedVerb::new(8000.0f);
    verb.set_size(1.0f); verb.set_squash(1.0f); verb.set_reverb_db(12.0f); verb.set_output_db(12.0f);
    verb.set_threshold_db(-60.0f); verb.set_release_ms(5.0f); verb.set_tone_hz(16000.0f);
    for i in 0..40000 {
        let x: f32 = (i % 29) < 14 ? 4.0f : -4.0f;
        let frame: GatedVerbFrame = verb.process_stereo(x, -x);
        verify(frame.left() == frame.left() && abs32(frame.left()) < 1000.0f);
        verify(frame.right() == frame.right() && abs32(frame.right()) < 1000.0f);
    }
}
