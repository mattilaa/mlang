    delay.set_filter_resonance(1.0f);
    delay.set_damping(1.0f);
    var energy: f32 = 0.0f;
    for i in 0..24000 {
        let input: f32 = i == 0 ? 1.0f : 0.0f;
        let frame: DelayFrame = delay.process_stereo(input, input);
        verify(frame.left() == frame.left());
        verify(frame.right() == frame.right());
        energy = energy + frame.left() * frame.left() + frame.right() * frame.right();
    }
    verify(energy > 0.001f);
}

#[test]
fn test_dsp_resonant_feedback_below_unity_decays() {
    var delay: StereoDelay = StereoDelay::new(1000.0f, 100.0f);
    delay.set_delay_ms(4.0f);
    delay.set_feedback(0.94f);
    delay.set_mix(1.0f);
    delay.set_filter(FeedbackFilter::Lowpass);
    delay.set_filter_cutoff_hz(300.0f);
    delay.set_filter_resonance(0.95f);
    delay.set_damping(0.85f);
    var late_energy: f32 = 0.0f;
    for i in 0..4000 {
        let frame: DelayFrame = delay.process_stereo(i == 0 ? 0.5f : 0.0f, 0.0f);
        if i >= 3000 { late_energy = late_energy + frame.left() * frame.left(); }
    }
    verify(late_energy < 0.000001f);
}

#[test]
fn test_dsp_lowering_feedback_stops_resonant_self_oscillation() {
    var delay: StereoDelay = StereoDelay::new(1000.0f, 100.0f);
    delay.set_delay_ms(4.0f);
    delay.set_feedback(1.2f);
    delay.set_mix(1.0f);
    delay.set_filter(FeedbackFilter::Lowpass);
    delay.set_filter_cutoff_hz(300.0f);
    delay.set_filter_resonance(0.95f);
    delay.set_damping(0.85f);
    var late_energy: f32 = 0.0f;
    for i in 0..5000 {
        if i == 1000 { delay.set_feedback(0.5f); }
        let frame: DelayFrame = delay.process_stereo(i == 0 ? 0.5f : 0.0f, 0.0f);
        if i >= 4000 { late_energy = late_energy + frame.left() * frame.left(); }
    }
    verify(late_energy < 0.000001f);
}

#[test]
fn test_dsp_dub_feedback_self_oscillation_is_bounded() {
    var delay: StereoDelay = StereoDelay::new(1000.0f, 100.0f);
    delay.set_delay_ms(4.0f);
    delay.set_feedback(1.2f);
    delay.set_mix(1.0f);
    delay.set_filter(FeedbackFilter::None);
    var late_energy: f32 = 0.0f;
    for i in 0..5000 {
        let input: f32 = i == 0 ? 1.0f : 0.0f;
        let frame: DelayFrame = delay.process_stereo(input, input);
        verify(frame.left() == frame.left());
        verify(frame.left() > -2.0f && frame.left() < 2.0f);
        if i > 4000 { late_energy = late_energy + frame.left() * frame.left(); }
    }
    verify(late_energy > 0.01f);
}

#[test]
fn test_dsp_delay_reset_kills_regenerative_loop() {
    var delay: StereoDelay = StereoDelay::new(1000.0f, 100.0f);
    delay.set_delay_ms(4.0f);
    delay.set_feedback(1.2f);
    delay.set_mix(1.0f);
    delay.set_filter(FeedbackFilter::None);
    for i in 0..100 {
        let _ = delay.process_stereo(i == 0 ? 1.0f : 0.0f, 0.0f);
    }
    delay.reset();
    for i in 0..20 {
        let frame: DelayFrame = delay.process_stereo(0.0f, 0.0f);
        verify(approx_f32(frame.left(), 0.0f, 0.000001f));
        verify(approx_f32(frame.right(), 0.0f, 0.000001f));
    }
}

#[test]
fn test_dsp_delay_jitter_is_smooth_and_finite() {
    var exact: StereoDelay = StereoDelay::new(1000.0f, 20.0f);
    exact.set_delay_ms(10.0f);
    exact.set_mix(1.0f);
    exact.set_feedback(0.65f);
    exact.set_filter(FeedbackFilter::None);

    var analog: StereoDelay = StereoDelay::new(1000.0f, 20.0f);
    analog.set_delay_ms(10.0f);
    analog.set_jitter_ms(2.0f);
    analog.set_mix(1.0f);
    analog.set_feedback(0.65f);
    analog.set_filter(FeedbackFilter::None);

    var difference: f32 = 0.0f;
    for i in 0..800 {
        let input: f32 = i == 0 ? 1.0f : 0.0f;
        let exact_frame: DelayFrame = exact.process_stereo(input, input);
        let analog_frame: DelayFrame = analog.process_stereo(input, input);
        verify(analog_frame.left() == analog_frame.left());
        verify(analog_frame.right() == analog_frame.right());
        var delta: f32 = analog_frame.left() - exact_frame.left();
        if delta < 0.0f { delta = 0.0f - delta; }
        difference = difference + delta;
    }
    verify(difference > 0.0001f);
}

#[test]
fn test_dsp_reverb_dry_signal_and_reset() {
    var reverb: Reverb = Reverb::new(48000.0f);
    reverb.set_mix(0.0f);
    let first: StereoFrame = reverb.process_stereo(0.25f, -0.5f);
    verify(approx_f32(first.left(), 0.25f, 0.0001f));
    verify(approx_f32(first.right(), -0.5f, 0.0001f));
    reverb.reset();
    let silence: StereoFrame = reverb.process_stereo(0.0f, 0.0f);
    verify(approx_f32(silence.left(), 0.0f, 0.0001f));
    verify(approx_f32(silence.right(), 0.0f, 0.0001f));
}

#[test]
fn test_dsp_reverb_impulse_produces_finite_tail() {
    var reverb: Reverb = Reverb::new(48000.0f);
    reverb.set_mix(1.0f);
    reverb.set_predelay(0.0f);
    reverb.set_decay(0.65f);
    reverb.set_early_mix(0.5f);
    var energy: f32 = 0.0f;
    var stereo_difference: f32 = 0.0f;
    var i: i64 = 0;
    while i < 24000 {
        let input: f32 = i == 0 ? 1.0f : 0.0f;
        let frame: StereoFrame = reverb.process_stereo(input, input);
        verify(frame.left() == frame.left());
        verify(frame.right() == frame.right());
        energy = energy + frame.left() * frame.left() + frame.right() * frame.right();
        var difference: f32 = frame.left() - frame.right();
        if difference < 0.0f { difference = 0.0f - difference; }
        stereo_difference = stereo_difference + difference;
        i = i + 1;
    }
    verify(energy > 0.01f);
    verify(stereo_difference > 0.001f);
}

#[test]
fn test_dsp_reverb_types_and_gated_tail() {
    var reverb: Reverb = Reverb::new(48000.0f);
    reverb.set_type(ReverbType::Room);
    verify(reverb.get_type() == ReverbType::Room);
    reverb.set_type(ReverbType::Plate);
    verify(reverb.get_type() == ReverbType::Plate);
    reverb.set_type(ReverbType::Reverse);
    verify(reverb.get_type() == ReverbType::Reverse);
    reverb.set_type(ReverbType::NonlinearShort);
    verify(reverb.get_type() == ReverbType::NonlinearShort);
    reverb.set_type(ReverbType::NonlinearLong);
    verify(reverb.get_type() == ReverbType::NonlinearLong);

    reverb.set_type(ReverbType::Gated);
    reverb.set_mix(1.0f);
    reverb.set_predelay(0.0f);
    var energy: f32 = 0.0f;
    var last_left: f32 = 0.0f;
    var last_right: f32 = 0.0f;
    var i: i64 = 0;
    while i < 24000 {
        let input: f32 = i == 0 ? 1.0f : 0.0f;
        let frame: StereoFrame = reverb.process_stereo(input, input);
        last_left = frame.left();
        last_right = frame.right();
        energy = energy + last_left * last_left + last_right * last_right;
        i = i + 1;
    }
    verify(energy > 0.001f);
    verify(approx_f32(last_left, 0.0f, 0.0001f));
    verify(approx_f32(last_right, 0.0f, 0.0001f));
    verify(reverb.get_type() == ReverbType::Gated);
}

#[test]
fn test_dsp_reverb2_presets_are_finite() {
    var reverb: Reverb2 = Reverb2::new(8000.0f);
    reverb.set_mix(1.0f);
    var preset: i32 = 0;
    while preset < 9 {
        if preset == 0 { reverb.set_type(Reverb2Type::Hall); }
        else if preset == 1 { reverb.set_type(Reverb2Type::Room); }
        else if preset == 2 { reverb.set_type(Reverb2Type::Plate); }
        else if preset == 3 { reverb.set_type(Reverb2Type::Gated); }
        else if preset == 4 { reverb.set_type(Reverb2Type::Reverse); }
        else if preset == 5 { reverb.set_type(Reverb2Type::NonlinearShort); }
        else if preset == 6 { reverb.set_type(Reverb2Type::NonlinearLong); }
        else if preset == 7 { reverb.set_type(Reverb2Type::Custom); }
        else { reverb.set_type(Reverb2Type::InfiniteHall); }
        reverb.set_mix(1.0f);
        var i: i64 = 0;
        while i < 5000 {
            let input: f32 = i == 0 ? 0.8f : 0.0f;
            let frame: Reverb2Frame = reverb.process_stereo(input, input * 0.7f);
            verify(frame.left() == frame.left());
            verify(frame.right() == frame.right());
            verify(frame.left() < 4.0f && frame.left() > -4.0f);
            verify(frame.right() < 4.0f && frame.right() > -4.0f);
            i = i + 1;
        }
        preset = preset + 1;
    }
}

#[test]
fn test_dsp_reverb2_controllable_gate_closes_wet_tail() {
    var reverb: Reverb2 = Reverb2::new(8000.0f);
    reverb.set_type(Reverb2Type::Gated);
    reverb.set_mix(1.0f);
    reverb.set_predelay_ms(0.0f);
    reverb.set_gate(0.5f, 20.0f, 10.0f, 0.01f, 0.0f);
    var open_energy: f32 = 0.0f;
    var closed_energy: f32 = 0.0f;
    var i: i64 = 0;
    while i < 2400 {
        let input: f32 = i == 0 ? 1.0f : 0.0f;
        let frame: Reverb2Frame = reverb.process_stereo(input, input);
        if i >= 60 && i < 240 {
            open_energy = open_energy + frame.left() * frame.left() + frame.right() * frame.right();
        }
        if i >= 1200 {
            closed_energy = closed_energy + frame.left() * frame.left() + frame.right() * frame.right();
        }
        i = i + 1;
    }
    verify(open_energy > 0.0001f);
    verify(closed_energy < 0.000001f);
}

#[test]
fn test_dsp_reverb2_custom_and_infinite_hall() {
    var reverb: Reverb2 = Reverb2::new(8000.0f);
    reverb.set_type(Reverb2Type::Custom);
    reverb.set_size(0.82f);
    reverb.set_decay_seconds(7.5f);
    reverb.set_damping(0.22f);
    reverb.set_bass_multiplier(1.12f);
    reverb.set_diffusion(0.88f);
    reverb.set_input_bandwidth(0.90f);
    reverb.set_predelay_ms(5.0f);
    reverb.set_early_mix(0.12f);
    reverb.set_stereo_width(1.0f);
    reverb.set_modulation(0.6f, 0.2f);
    reverb.set_gain(0.9f);
    verify(reverb.get_type() == Reverb2Type::Custom);

    reverb.set_type(Reverb2Type::InfiniteHall);
    reverb.set_mix(1.0f);
    var late_energy: f32 = 0.0f;
    var i: i64 = 0;
    while i < 32000 {
        let input: f32 = i == 0 ? 0.7f : 0.0f;
        let frame: Reverb2Frame = reverb.process_stereo(input, input * 0.8f);
        if i >= 24000 {
            late_energy = late_energy + frame.left() * frame.left() + frame.right() * frame.right();
        }
        i = i + 1;
    }
    verify(reverb.get_type() == Reverb2Type::InfiniteHall);
    verify(late_energy > 0.000001f);
}

#[test]
fn test_dsp_smoothed_lowpass_parameter_ramp() {
    var filter: SmoothedLowpass = SmoothedLowpass::new(48000.0f, 200.0f, 0.0f);
    filter.set_target(2200.0f, 12.0f, 8);
    for i in 0..8 {
        let _ = filter.process(0.0f);
    }
    verify(approx_f32(filter.cutoff_hz(), 2200.0f, 0.001f));
    verify(approx_f32(filter.resonance_db(), 12.0f, 0.001f));
    verify(filter.remaining() == 0);
}
