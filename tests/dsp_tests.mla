fn approx_f32(a: f32, b: f32, eps: f32) -> bool {
    var diff: f32 = a - b;
    if diff < 0.0f {
        diff = 0.0f - diff;
    }
    return diff <= eps;
}

fn approx_f64(a: f64, b: f64, eps: f64) -> bool {
    var diff: f64 = a - b;
    if diff < 0.0 {
        diff = 0.0 - diff;
    }
    return diff <= eps;
}

#[test]
fn test_dsp_convolution_i64_modes() {
    let signal: list<i64> = [1, 2, 3];
    let kernel: list<i64> = [4, 5];

    let full: list<i64> = full_i64(signal, kernel);
    verify(full.len() == 4);
    verify(full[0] == 4);
    verify(full[1] == 13);
    verify(full[2] == 22);
    verify(full[3] == 15);

    let same: list<i64> = same_i64(signal, kernel);
    verify(same.len() == 3);
    verify(same[0] == 4);
    verify(same[1] == 13);
    verify(same[2] == 22);

    let valid: list<i64> = valid_i64(signal, kernel);
    verify(valid.len() == 2);
    verify(valid[0] == 13);
    verify(valid[1] == 22);

    let empty: list<i64> = [];
    let empty_full: list<i64> = full_i64(empty, kernel);
    let invalid_valid: list<i64> = valid_i64(kernel, signal);
    verify(empty_full.len() == 0);
    verify(invalid_valid.len() == 0);
}

#[test]
fn test_dsp_convolution_float_modes() {
    let signal32: list<f32> = [1.0f, 2.0f, 3.0f];
    let kernel32: list<f32> = [0.5f, 0.25f];
    let full32: list<f32> = full_f32(signal32, kernel32);
    let valid32: list<f32> = valid_f32(signal32, kernel32);
    verify(full32.len() == 4);
    verify(approx_f32(full32[0], 0.5f, 0.0001f));
    verify(approx_f32(full32[1], 1.25f, 0.0001f));
    verify(approx_f32(full32[2], 2.0f, 0.0001f));
    verify(approx_f32(full32[3], 0.75f, 0.0001f));
    verify(valid32.len() == 2);
    verify(approx_f32(valid32[0], 1.25f, 0.0001f));
    verify(approx_f32(valid32[1], 2.0f, 0.0001f));

    let signal64: list<f64> = [2.0, 4.0];
    let kernel64: list<f64> = [0.25, 0.5, 1.0];
    let full64: list<f64> = full_f64(signal64, kernel64);
    verify(full64.len() == 4);
    verify(approx_f64(full64[0], 0.5, 0.0000001));
    verify(approx_f64(full64[1], 2.0, 0.0000001));
    verify(approx_f64(full64[2], 4.0, 0.0000001));
    verify(approx_f64(full64[3], 4.0, 0.0000001));
}

#[test]
fn test_dsp_cubic_sampler_interpolation() {
    verify(approx_f32(nearest_interpolate_f32(1.0f, 2.0f, 0.25f), 1.0f, 0.0001f));
    verify(approx_f32(nearest_interpolate_f32(1.0f, 2.0f, 0.75f), 2.0f, 0.0001f));
    verify(approx_f32(linear_interpolate_f32(1.0f, 2.0f, 0.25f), 1.25f, 0.0001f));
    verify(approx_f32(hermite_interpolate_f32(0.0f, 1.0f, 2.0f, 3.0f, 0.5f), 1.5f, 0.0001f));
    verify(approx_f32(cubic_interpolate_f32(0.0f, 1.0f, 2.0f, 3.0f, 0.0f), 1.0f, 0.0001f));
    verify(approx_f32(cubic_interpolate_f32(0.0f, 1.0f, 2.0f, 3.0f, 0.5f), 1.5f, 0.0001f));
    verify(approx_f32(cubic_interpolate_f32(0.0f, 1.0f, 2.0f, 3.0f, 1.0f), 2.0f, 0.0001f));
    verify(approx_f32(
        cubic_interpolate_f32(-0.5f, 0.25f, 1.5f, 0.75f, 0.35f),
        hermite_interpolate_f32(-0.5f, 0.25f, 1.5f, 0.75f, 0.35f),
        0.0001f));
}

#[test]
fn test_dsp_bicubic_table_interpolation() {
    let values: list<f32> = [
        0.0f, 1.0f, 2.0f, 3.0f,
        4.0f, 5.0f, 6.0f, 7.0f,
        8.0f, 9.0f, 10.0f, 11.0f,
        12.0f, 13.0f, 14.0f, 15.0f
    ];
    verify(approx_f32(bicubic_interpolate_f32(values, 0.5f, 0.5f), 7.5f, 0.0001f));
    let too_short: list<f32> = [1.0f, 2.0f];
    verify(approx_f32(bicubic_interpolate_f32(too_short, 0.5f, 0.5f), 0.0f, 0.0001f));
}

#[test]
fn test_dsp_linear_ramp_reaches_exact_target() {
    var ramp: LinearRamp = LinearRamp::new(100.0f);
    ramp.set_target(200.0f, 4);
    verify(approx_f32(ramp.next(), 125.0f, 0.0001f));
    verify(approx_f32(ramp.next(), 150.0f, 0.0001f));
    verify(approx_f32(ramp.next(), 175.0f, 0.0001f));
    verify(approx_f32(ramp.next(), 200.0f, 0.0001f));
    verify(ramp.remaining() == 0);
}

#[test]
fn test_dsp_biquad_lowpass_and_highpass_dc() {
    var lowpass: Biquad = Biquad::new();
    lowpass.set_lowpass(1000.0f, 0.0f, 48000.0f);
    var low_output: f32 = 0.0f;
    for i in 0..4096 {
        low_output = lowpass.process(1.0f);
    }
    verify(approx_f32(low_output, 1.0f, 0.001f));

    var highpass: Biquad = Biquad::new();
    highpass.set_highpass(1000.0f, 0.0f, 48000.0f);
    var high_output: f32 = 0.0f;
    for i in 0..4096 {
        high_output = highpass.process(1.0f);
    }
    verify(approx_f32(high_output, 0.0f, 0.001f));

    var bandpass: Biquad = Biquad::new();
    bandpass.set_bandpass(1000.0f, 0.0f, 48000.0f);
    var band_output: f32 = 0.0f;
    for i in 0..4096 {
        band_output = bandpass.process(1.0f);
    }
    verify(approx_f32(band_output, 0.0f, 0.001f));
}

#[test]
fn test_dsp_24db_filter_dc_responses() {
    var lowpass: Lowpass24 = Lowpass24::new();
    lowpass.set_lowpass(1000.0f, 0.0f, 48000.0f);
    var low_output: f32 = 0.0f;

    var highpass: Highpass24 = Highpass24::new();
    highpass.set_highpass(1000.0f, 0.0f, 48000.0f);
    var high_output: f32 = 0.0f;

    var bandpass: Bandpass24 = Bandpass24::new();
    bandpass.set_bandpass(1000.0f, 0.0f, 48000.0f);
    var band_output: f32 = 0.0f;

    for i in 0..8192 {
        low_output = lowpass.process(1.0f);
        high_output = highpass.process(1.0f);
        band_output = bandpass.process(1.0f);
    }

    verify(approx_f32(low_output, 1.0f, 0.002f));
    verify(approx_f32(high_output, 0.0f, 0.002f));
    verify(approx_f32(band_output, 0.0f, 0.002f));
}

#[test]
fn test_dsp_moog_ladder_12db_18db_and_24db_dc() {
    var ladder12: MoogLadder = MoogLadder::new();
    ladder12.set_lowpass(1000.0f, 0.0f, 48000.0f);
    var output12: f32 = 0.0f;
    var ladder24: MoogLadder = MoogLadder::new();
    ladder24.set_lowpass(1000.0f, 0.0f, 48000.0f);
    var output24: f32 = 0.0f;
    var ladder18: MoogLadder = MoogLadder::new();
    ladder18.set_lowpass(1000.0f, 0.0f, 48000.0f);
    var output18: f32 = 0.0f;
    for i in 0..8192 {
        output12 = ladder12.process_12db(1.0f);
        output18 = ladder18.process_18db(1.0f);
        output24 = ladder24.process_24db(1.0f);
    }
    verify(approx_f32(output12, 1.0f, 0.002f));
    verify(approx_f32(output18, 1.0f, 0.002f));
    verify(approx_f32(output24, 1.0f, 0.002f));
    verify(approx_f32(ladder12.state_3(), 0.0f, 0.000001f));
    verify(approx_f32(ladder12.state_4(), 0.0f, 0.000001f));
    verify(approx_f32(ladder18.state_4(), 0.0f, 0.000001f));
}

#[test]
fn test_dsp_moog_ladder_bass_compensation() {
    var deep: MoogLadder = MoogLadder::new();
    deep.set_lowpass(1000.0f, 30.0f, 48000.0f);
    var uncompensated: MoogLadder = MoogLadder::new();
    uncompensated.set_bass_compensation(0.0f);
    uncompensated.set_lowpass(1000.0f, 30.0f, 48000.0f);
    var deep_output: f32 = 0.0f;
    var thin_output: f32 = 0.0f;
    for i in 0..16384 {
        deep_output = deep.process_24db(1.0f);
        thin_output = uncompensated.process_24db(1.0f);
    }
    verify(approx_f32(deep_output, 1.0f, 0.01f));
    verify(deep_output > thin_output * 3.0f);
}

#[test]
fn test_dsp_moog_ladder_resonant_sweep_stays_finite() {
    var ladder: MoogLadder = MoogLadder::new();
    var cutoff: LinearRamp = LinearRamp::new(80.0f);
    cutoff.set_target(16000.0f, 48000);
    var energy: f32 = 0.0f;
    for i in 0..48000 {
        ladder.set_lowpass(cutoff.next(), 30.0f, 48000.0f);
        let input: f32 = i == 0 ? 1.0f : 0.0f;
        let output: f32 = ladder.process_24db(input);
        verify(output == output);
        energy = energy + output * output;
    }
    verify(energy > 0.000001f);
}

#[test]
fn test_dsp_analog_distortion_bypass_and_silence() {
    var distortion: AnalogDistortion = AnalogDistortion::new(48000.0f);
    distortion.set_drive_db(24.0f);
    distortion.set_bias(0.2f);
    distortion.set_mix(0.0f);
    verify(approx_f32(distortion.process(0.25f), 0.25f, 0.000001f));
    distortion.set_mix(1.0f);
    distortion.reset();
    var silence: f32 = 1.0f;
    for i in 0..2048 {
        silence = distortion.process(0.0f);
    }
    verify(approx_f32(silence, 0.0f, 0.0001f));
}

#[test]
fn test_dsp_analog_distortion_is_asymmetric_and_finite() {
    var positive: AnalogDistortion = AnalogDistortion::new(48000.0f);
    positive.set_drive_db(18.0f);
    positive.set_bias(0.2f);
    positive.set_tone_hz(12000.0f, 48000.0f);
    let positive_output: f32 = positive.process(0.5f);

    var negative: AnalogDistortion = AnalogDistortion::new(48000.0f);
    negative.set_drive_db(18.0f);
    negative.set_bias(0.2f);
    negative.set_tone_hz(12000.0f, 48000.0f);
    let negative_output: f32 = negative.process(-0.5f);
    verify(positive_output == positive_output);
    verify(negative_output == negative_output);
    var negative_magnitude: f32 = negative_output < 0.0f ? -negative_output : negative_output;
    verify(!approx_f32(positive_output, negative_magnitude, 0.0001f));
}

#[test]
fn test_dsp_limiter_bounds_peak_and_links_stereo() {
    var limiter: StereoLimiter = StereoLimiter::new(8000.0f);
    limiter.set_threshold_db(-6.0f);
    limiter.set_ceiling_db(-0.3f);
    limiter.set_release_ms(50.0f);
    limiter.set_lookahead_ms(5.0f);
    var limited_left: f32 = 0.0f;
    var limited_right: f32 = 0.0f;
    var i: i64 = 0;
    while i < 48 {
        let left: f32 = i == 0 ? 1.0f : 0.0f;
        let right: f32 = i == 0 ? 0.25f : 0.0f;
        let frame: LimiterFrame = limiter.process_stereo(left, right);
        verify(frame.left() <= 0.967f && frame.left() >= -0.967f);
        verify(frame.right() <= 0.967f && frame.right() >= -0.967f);
        if i == 40 {
            limited_left = frame.left();
            limited_right = frame.right();
        }
        i = i + 1;
    }
    verify(limited_left > 0.95f);
    verify(approx_f32(limited_right / limited_left, 0.25f, 0.001f));
}

#[test]
fn test_dsp_limiter_release_recovers_smoothly() {
    var limiter: StereoLimiter = StereoLimiter::new(8000.0f);
    limiter.set_threshold_db(-12.0f);
    limiter.set_release_ms(50.0f);
    let _impulse: LimiterFrame = limiter.process_stereo(1.0f, 1.0f);
    let reduced: f32 = limiter.current_gain();
    var i: i64 = 0;
    while i < 1000 {
        let _frame: LimiterFrame = limiter.process_stereo(0.0f, 0.0f);
        i = i + 1;
    }
    let recovered: f32 = limiter.current_gain();
    verify(reduced < 0.3f);
    verify(recovered > reduced);
    verify(recovered < 1.000001f);
}

#[test]
fn test_dsp_forward_delay_impulse_repeats_in_place() {
    var delay: StereoDelay = StereoDelay::new(1000.0f, 100.0f);
    delay.set_delay_ms(4.0f);
    delay.set_mode(DelayMode::Forward);
    delay.set_feedback(0.5f);
    delay.set_mix(1.0f);
    delay.set_filter(FeedbackFilter::None);
    var first_echo: f32 = 0.0f;
    var second_echo: f32 = 0.0f;
    for i in 0..9 {
        let input: f32 = i == 0 ? 1.0f : 0.0f;
        let frame: DelayFrame = delay.process_stereo(input, 0.0f);
        if i == 4 { first_echo = frame.left(); }
        if i == 8 { second_echo = frame.left(); }
        verify(approx_f32(frame.right(), 0.0f, 0.000001f));
    }
    verify(approx_f32(first_echo, 1.0f, 0.000001f));
    verify(approx_f32(second_echo, 0.5f, 0.000001f));
}

#[test]
fn test_dsp_pingpong_delay_crosses_channels() {
    var delay: StereoDelay = StereoDelay::new(1000.0f, 100.0f);
    delay.set_delay_ms(4.0f);
    delay.set_mode(DelayMode::PingPong);
    delay.set_feedback(0.5f);
    delay.set_mix(1.0f);
    delay.set_filter(FeedbackFilter::Lowpass);
    delay.set_filter_cutoff_hz(450.0f);
    delay.set_damping(0.0f);
    var left_echo: f32 = 0.0f;
    var right_echo: f32 = 0.0f;
    for i in 0..9 {
        let input: f32 = i == 0 ? 1.0f : 0.0f;
        let frame: DelayFrame = delay.process_stereo(input, input);
        if i == 4 { left_echo = frame.left(); }
        if i == 8 { right_echo = frame.right(); }
    }
    verify(approx_f32(left_echo, 1.0f, 0.000001f));
    verify(approx_f32(right_echo, 0.5f, 0.000001f));
}

#[test]
fn test_dsp_delay_filters_first_wet_repeat() {
    var delay: StereoDelay = StereoDelay::new(1000.0f, 100.0f);
    delay.set_delay_ms(4.0f);
    delay.set_feedback(0.0f);
    delay.set_mix(1.0f);
    delay.set_filter(FeedbackFilter::Lowpass);
    delay.set_filter_cutoff_hz(100.0f);
    delay.set_damping(1.0f);
    var first_echo: f32 = 0.0f;
    for i in 0..6 {
        let frame: DelayFrame = delay.process_stereo(i == 0 ? 1.0f : 0.0f, 0.0f);
        if i == 4 { first_echo = frame.left(); }
    }
    verify(first_echo > 0.0f);
    verify(first_echo < 0.99f);
}

#[test]
fn test_dsp_delay_feedback_only_filter_preserves_first_repeat() {
    var delay: StereoDelay = StereoDelay::new(1000.0f, 100.0f);
    delay.set_delay_ms(4.0f);
    delay.set_feedback(0.5f);
    delay.set_mix(1.0f);
    delay.set_filter(FeedbackFilter::Lowpass);
    delay.set_filter_wet_output(false);
    delay.set_filter_cutoff_hz(100.0f);
    delay.set_damping(1.0f);
    var first_echo: f32 = 0.0f;
    var second_echo: f32 = 0.0f;
    for i in 0..9 {
        let frame: DelayFrame = delay.process_stereo(i == 0 ? 1.0f : 0.0f, 0.0f);
        if i == 4 { first_echo = frame.left(); }
        if i == 8 { second_echo = frame.left(); }
    }
    verify(approx_f32(first_echo, 1.0f, 0.000001f));
    verify(second_echo > 0.0f);
    verify(second_echo < 0.5f);
}

#[test]
fn test_dsp_delay_feedback_only_controls_color_regenerated_repeats() {
    var dark: StereoDelay = StereoDelay::new(1000.0f, 100.0f);
    dark.set_delay_ms(4.0f);
    dark.set_feedback(0.7f);
    dark.set_mix(1.0f);
    dark.set_filter(FeedbackFilter::Lowpass);
    dark.set_filter_wet_output(false);
    dark.set_filter_cutoff_hz(60.0f);
    dark.set_filter_resonance(0.1f);
    dark.set_damping(1.0f);

    var bright: StereoDelay = StereoDelay::new(1000.0f, 100.0f);
    bright.set_delay_ms(4.0f);
    bright.set_feedback(0.7f);
    bright.set_mix(1.0f);
    bright.set_filter(FeedbackFilter::Lowpass);
    bright.set_filter_wet_output(false);
    bright.set_filter_cutoff_hz(350.0f);
    bright.set_filter_resonance(0.9f);
    bright.set_damping(1.0f);

    var difference: f32 = 0.0f;
    for i in 0..40 {
        let input: f32 = i == 0 ? 0.5f : 0.0f;
        let dark_frame: DelayFrame = dark.process_stereo(input, 0.0f);
        let bright_frame: DelayFrame = bright.process_stereo(input, 0.0f);
        if i >= 8 {
            var delta: f32 = bright_frame.left() - dark_frame.left();
            if delta < 0.0f { delta = 0.0f - delta; }
            difference = difference + delta;
        }
    }
    verify(difference > 0.01f);
}

#[test]
fn test_dsp_delay_bandpass_filter_produces_wet_repeat() {
    var delay: StereoDelay = StereoDelay::new(1000.0f, 100.0f);
    delay.set_delay_ms(4.0f);
    delay.set_feedback(0.0f);
    delay.set_mix(1.0f);
    delay.set_filter(FeedbackFilter::Bandpass);
    delay.set_filter_cutoff_hz(120.0f);
    delay.set_filter_resonance(0.5f);
    delay.set_damping(1.0f);
    var energy: f32 = 0.0f;
    for i in 0..100 {
        let frame: DelayFrame = delay.process_stereo(i == 0 ? 0.5f : 0.0f, 0.0f);
        energy = energy + frame.left() * frame.left();
        verify(frame.left() == frame.left());
    }
    verify(energy > 0.0001f);
}

#[test]
fn test_dsp_delay_filter_type_crossfade_is_smooth() {
    var delay: StereoDelay = StereoDelay::new(1000.0f, 100.0f);
    delay.set_delay_ms(4.0f);
    delay.set_feedback(0.0f);
    delay.set_mix(1.0f);
    delay.set_filter(FeedbackFilter::Lowpass);
    delay.set_filter_cutoff_hz(100.0f);
    delay.set_filter_resonance(0.4f);
    delay.set_damping(1.0f);
    var before: f32 = 0.0f;
    for i in 0..100 {
        let before_frame: DelayFrame = delay.process_stereo(0.1f, 0.1f);
        before = before_frame.left();
    }
    delay.set_filter_target(FeedbackFilter::Bandpass, 20);
    let first_frame: DelayFrame = delay.process_stereo(0.1f, 0.1f);
    let first: f32 = first_frame.left();
    var first_delta: f32 = first - before;
    if first_delta < 0.0f { first_delta = 0.0f - first_delta; }
    verify(first_delta < 0.02f);
    for i in 0..30 {
        let frame: DelayFrame = delay.process_stereo(0.1f, 0.1f);
        verify(frame.left() == frame.left());
    }
    delay.set_filter_target(FeedbackFilter::Highpass, 20);
    for i in 0..30 {
        let frame: DelayFrame = delay.process_stereo(0.1f, 0.1f);
        verify(frame.left() == frame.left());
    }
    delay.set_filter_target(FeedbackFilter::Lowpass, 20);
    for i in 0..30 {
        let frame: DelayFrame = delay.process_stereo(0.1f, 0.1f);
        verify(frame.left() == frame.left());
    }
}

#[test]
fn test_dsp_delay_dry_wet_mix_ramp_is_sample_accurate() {
    var delay: StereoDelay = StereoDelay::new(1000.0f, 100.0f);
    delay.set_delay_ms(4.0f);
    delay.set_feedback(0.0f);
    delay.set_mix(0.0f);
    delay.set_filter(FeedbackFilter::None);
    let initial: DelayFrame = delay.process_stereo(1.0f, 0.0f);
    verify(approx_f32(initial.left(), 1.0f, 0.000001f));
    delay.set_mix_target(1.0f, 10);
    var echo: f32 = 0.0f;
    for i in 1..5 {
        let frame: DelayFrame = delay.process_stereo(0.0f, 0.0f);
        if i == 4 { echo = frame.left(); }
    }
    verify(approx_f32(echo, 0.4f, 0.0001f));
}

#[test]
fn test_dsp_delay_time_ramp_is_smooth_and_retargetable() {
    var delay: StereoDelay = StereoDelay::new(1000.0f, 100.0f);
    delay.set_delay_ms(10.0f);
    delay.set_feedback(0.0f);
    delay.set_mix(1.0f);
    delay.set_filter(FeedbackFilter::None);
    delay.set_delay_target_ms(30.0f, 20);
    var previous: f32 = 0.0f;
    for i in 0..10 {
        let input: f32 = f32(i) * 0.001f;
        let frame: DelayFrame = delay.process_stereo(input, input);
        previous = frame.left();
    }
    verify(approx_f32(delay.delay_ms(), 20.0f, 0.001f));
    delay.set_delay_target_ms(15.0f, 10);
    for i in 10..20 {
        let input: f32 = f32(i) * 0.001f;
        let frame: DelayFrame = delay.process_stereo(input, input);
        var jump: f32 = frame.left() - previous;
        if jump < 0.0f { jump = 0.0f - jump; }
        verify(jump < 0.01f);
        previous = frame.left();
    }
    verify(approx_f32(delay.delay_ms(), 15.0f, 0.001f));
}

#[test]
fn test_dsp_delay_jitter_depth_ramp_is_sample_accurate() {
    var delay: StereoDelay = StereoDelay::new(1000.0f, 100.0f);
    delay.set_delay_ms(20.0f);
    delay.set_jitter_ms(0.0f);
    delay.set_jitter_target_ms(4.0f, 20);
    for _i in 0..10 {
        let _ = delay.process_stereo(0.0f, 0.0f);
    }
    verify(approx_f32(delay.jitter_ms(), 2.0f, 0.001f));
    delay.set_jitter_target_ms(1.0f, 10);
    for _i in 0..10 {
        let frame: DelayFrame = delay.process_stereo(0.0f, 0.0f);
        verify(frame.left() == frame.left());
        verify(frame.right() == frame.right());
    }
    verify(approx_f32(delay.jitter_ms(), 1.0f, 0.001f));
}

#[test]
fn test_dsp_delay_damping_ramp_is_sample_accurate_and_retargetable() {
    var delay: StereoDelay = StereoDelay::new(1000.0f, 100.0f);
    delay.set_delay_ms(10.0f);
    delay.set_damping(0.0f);
    delay.set_damping_target(1.0f, 20);
    for _i in 0..10 {
        let _ = delay.process_stereo(0.0f, 0.0f);
    }
    verify(approx_f32(delay.damping_value(), 0.5f, 0.001f));
    delay.set_damping_target(0.25f, 10);
    for _i in 0..10 {
        let frame: DelayFrame = delay.process_stereo(0.0f, 0.0f);
        verify(frame.left() == frame.left());
        verify(frame.right() == frame.right());
    }
    verify(approx_f32(delay.damping_value(), 0.25f, 0.001f));
}

#[test]
fn test_dsp_delay_high_resonance_preserves_passband_gain() {
    var delay: StereoDelay = StereoDelay::new(1000.0f, 100.0f);
    delay.set_delay_ms(4.0f);
    delay.set_feedback(0.0f);
    delay.set_mix(1.0f);
    delay.set_filter(FeedbackFilter::Lowpass);
    delay.set_filter_cutoff_hz(300.0f);
    delay.set_filter_resonance(0.95f);
    delay.set_damping(1.0f);
    var impulse_sum: f32 = 0.0f;
    for i in 0..200 {
        let frame: DelayFrame = delay.process_stereo(i == 0 ? 0.01f : 0.0f, 0.0f);
        impulse_sum = impulse_sum + frame.left();
    }
    verify(impulse_sum > 0.0075f);
    verify(impulse_sum < 0.0125f);
}

#[test]
fn test_dsp_delay_cutoff_ramp_can_be_retargeted() {
    var delay: StereoDelay = StereoDelay::new(1000.0f, 100.0f);
    delay.set_delay_ms(4.0f);
    delay.set_feedback(0.7f);
    delay.set_mix(1.0f);
    delay.set_filter(FeedbackFilter::Lowpass);
    delay.set_filter_cutoff_hz(80.0f);
    delay.set_filter_cutoff_target_hz(400.0f, 100);
    var energy: f32 = 0.0f;
    for i in 0..240 {
        if i == 40 { delay.set_filter_cutoff_target_hz(120.0f, 80); }
        let input: f32 = i == 0 ? 1.0f : 0.0f;
        let frame: DelayFrame = delay.process_stereo(input, input);
        verify(frame.left() == frame.left());
        verify(frame.right() == frame.right());
        energy = energy + frame.left() * frame.left() + frame.right() * frame.right();
    }
    verify(energy > 0.0001f);
}

#[test]
fn test_dsp_delay_resonance_ramp_can_be_retargeted() {
    var delay: StereoDelay = StereoDelay::new(1000.0f, 100.0f);
    delay.set_delay_ms(4.0f);
    delay.set_feedback(0.85f);
    delay.set_mix(1.0f);
    delay.set_filter(FeedbackFilter::Lowpass);
    delay.set_filter_cutoff_hz(180.0f);
    delay.set_filter_resonance(0.1f);
    delay.set_filter_resonance_target(0.95f, 100);
    var energy: f32 = 0.0f;
    for i in 0..240 {
        if i == 40 { delay.set_filter_resonance_target(0.35f, 80); }
        let input: f32 = i == 0 ? 1.0f : 0.0f;
        let frame: DelayFrame = delay.process_stereo(input, input);
        verify(frame.left() == frame.left());
        verify(frame.right() == frame.right());
        energy = energy + frame.left() * frame.left() + frame.right() * frame.right();
    }
    verify(energy > 0.0001f);
}

#[test]
fn test_dsp_resonant_feedback_delay_stays_finite() {
    var delay: StereoDelay = StereoDelay::new(48000.0f, 100.0f);
    delay.set_delay_ms(7.0f);
    delay.set_feedback(0.98f);
    delay.set_mix(1.0f);
