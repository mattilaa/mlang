fn overwrite_first(values: &mut list<i32>) {
    values[0] = values[1];
}

#[test]
fn test_ranges_materialize_flat_set_for_list_algorithms() {
    let source: list<i32> = [4, 1, 4, 2];
    let set: FlatSet<i32> = to_flat_set(source);
    let values: list<i32> = to_list_from_flat_set(set);
    verify(values.len() == 3 && values[0] == 1 &&
           values[1] == 2 && values[2] == 4);
    verify(find(values, 2) == 1);
}

#[test]
fn test_ranges_materialize_flat_multiset_preserving_duplicates() {
    let source: list<i32> = [4, 1, 4, 2];
    let multiset: FlatMultiSet<i32> = to_flat_multiset(source);
    let values: list<i32> = to_list_from_flat_multiset(multiset);
    verify(values.len() == 4 && values[0] == 1 && values[1] == 2 &&
           values[2] == 4 && values[3] == 4);
}

#[test]
fn test_ranges_materialize_flat_map_entries_in_key_order() {
    var values: FlatMap<i32, i32> = FlatMap<i32, i32>::new();
    values.insert(2, 20);
    values.insert(1, 10);
    let entries: list<tuple<i32, i32>> = to_list_from_flat_map(values);
    let first: tuple<i32, i32> = entries[0];
    let second: tuple<i32, i32> = entries[1];
    verify(entries.len() == 2 && first.0 == 1 && first.1 == 10 &&
           second.0 == 2 && second.1 == 20);
}

#[test]
fn test_ranges_materialize_flat_multimap_entries_in_key_order() {
    var values: FlatMultiMap<i32, i32> = FlatMultiMap<i32, i32>::new();
    values.insert(2, 20);
    values.insert(1, 10);
    values.insert(2, 21);
    let entries: list<tuple<i32, i32>> = to_list_from_flat_multimap(values);
    let first: tuple<i32, i32> = entries[0];
    let second: tuple<i32, i32> = entries[1];
    let third: tuple<i32, i32> = entries[2];
    verify(entries.len() == 3 && first.0 == 1 && first.1 == 10 &&
           second.0 == 2 && second.1 == 20 &&
           third.0 == 2 && third.1 == 21);
}

#[test]
fn test_generic_to_flat_map_resolves_nested_receiver_types() {
    let pairs: list<tuple<i32, i32>> = [(2, 20), (1, 10), (2, 21)];
    let values: FlatMap<i32, i32> = to_flat_map(pairs);
    verify(values.len() == 2 && values.key_at(0) == 1 &&
           values.value_at(0) == 10 && values.key_at(1) == 2 &&
           values.value_at(1) == 21);
}

#[test]
fn test_ranges_materialize_builtin_map_entries() {
    let values: map<i32, i32> = {2: 20, 1: 10};
    let entries: list<tuple<i32, i32>> = to_list_from_map(values);
    var found_one: bool = false;
    var found_two: bool = false;
    for entry in entries {
        if entry.0 == 1 && entry.1 == 10 { found_one = true; }
        if entry.0 == 2 && entry.1 == 20 { found_two = true; }
    }
    verify(entries.len() == 2 && found_one && found_two);
}

#[test]
fn test_ranges_materialize_builtin_map_keys_and_values() {
    let values: map<i32, i32> = {2: 20, 1: 10};
    let keys: list<i32> = to_list_from_map_keys(values);
    let mapped_values: list<i32> = to_list_from_map_values(values);
    verify(keys.len() == 2 && contains(keys, 1) && contains(keys, 2));
    verify(mapped_values.len() == 2 && contains(mapped_values, 10) &&
           contains(mapped_values, 20));
}

#[test]
fn test_generic_range_algorithms_accept_fixed_arrays() {
    let fixed: array<i32, 4> = {4, 2, 6, 2};
    verify(find(fixed, 6) == 2 && count(fixed, 2) == 2);
    let doubled = |value: i32| { return value * 2; };
    let values: list<i32> = transform(fixed, doubled);
    verify(values.len() == 4 && values[0] == 8 && values[1] == 4 &&
           values[2] == 12 && values[3] == 4);

}

#[test]
fn test_ranges_concat_many() {
    let ranges: list<list<i32>> = [[1, 2], [], [3], [4, 5]];
    let flattened: list<i32> = concat_many(ranges);
    verify(flattened.len() == 5 && flattened[0] == 1 &&
           flattened[1] == 2 && flattened[2] == 3 &&
           flattened[3] == 4 && flattened[4] == 5);
    let empty: list<list<i32>> = [];
    let empty_flattened: list<i32> = concat_many(empty);
    verify(empty_flattened.len() == 0);
}

#[test]
fn test_ranges_concat_many_to_bounded_output() {
    let ranges: list<list<i32>> = [[1, 2], [], [3, 4]];
    var output: list<i32> = [-1, -1, -1];
    let written: i64 = concat_many_to(ranges, &mut output);
    verify(written == 3 && output[0] == 1 &&
           output[1] == 2 && output[2] == 3);
    let as_float = |value: i32| { return f64(value); };
    var projected_output: list<f64> = [-1.0, -1.0];
    let projected_written: i64 = concat_many_to_projected(
        ranges, &mut projected_output, as_float);
    verify(projected_written == 2 && projected_output[0] == 1.0 &&
           projected_output[1] == 2.0);
    var empty_output: list<i32> = [];
    verify(concat_many_to(ranges, &mut empty_output) == 0);
}

#[test]
fn test_ranges_to_list_converts_elements() {
    let source: list<i32> = [3, -2, 9];
    let copied: list<i32> = to_list(source);
    verify(copied.len() == 3 && copied[0] == 3 && copied[1] == -2 &&
           copied[2] == 9);
    let as_float = |value: i32| { return f64(value); };
    let converted: list<f64> = to_list_projected(source, as_float);
    verify(converted.len() == 3 && converted[0] == 3.0 &&
           converted[1] == -2.0 && converted[2] == 9.0);
    let nested: list<list<i32>> = [[1, 2], [], [3]];
    let converted_nested: list<list<f64>> =
        to_list_nested_projected(nested, as_float);
    let empty_row: list<f64> = converted_nested[1];
    verify(converted_nested.len() == 3 &&
           converted_nested[0][1] == 2.0 &&
           empty_row.len() == 0 &&
           converted_nested[2][0] == 3.0);

    let fixed: array<i32, 3> = {4, 6, 8};
    let copied_fixed: list<i32> = to_list(fixed);
    verify(copied_fixed.len() == 3 && copied_fixed[0] == 4 &&
           copied_fixed[2] == 8);
    let converted_fixed: list<f64> = to_list_projected(fixed, as_float);
    verify(converted_fixed.len() == 3 && converted_fixed[0] == 4.0 &&
           converted_fixed[2] == 8.0);

    let fixed_nested: array<array<i32, 2>, 2> = {{1, 2}, {3, 4}};
    let copied_fixed_nested: list<list<i32>> = to_list(fixed_nested);
    verify(copied_fixed_nested.len() == 2 &&
           copied_fixed_nested[0][1] == 2 &&
           copied_fixed_nested[1][0] == 3);
}

#[test]
fn test_ranges_split_by_equivalence_and_projection() {
    let values: list<i32> = [11, 2, 13, 4, 15];
    let delimiter: list<i64> = [3];
    let same_last_digit = |value: i32, key: i64| {
        return i64(value % 10) == key;
    };
    let parts: list<list<i32>> = split_by(values, delimiter, same_last_digit);
    let first: list<i32> = parts[0];
    let second: list<i32> = parts[1];
    verify(parts.len() == 2 && first.len() == 2 &&
           first[0] == 11 && first[1] == 2 &&
           second.len() == 2 && second[0] == 4 &&
           second[1] == 15);

    let trailing_match: list<i32> = [11, 2, 13];
    let trailing_parts: list<list<i32>> =
        split_by(trailing_match, delimiter, same_last_digit);
    let trailing_field: list<i32> = trailing_parts[1];
    verify(trailing_parts.len() == 2 && trailing_field.len() == 0);

    let project_tens = |value: i32| { return i64(value % 10); };
    let same_key = |value: i64, key: i64| { return value == key; };
    let projected_parts: list<list<i32>> = split_by_projected(
        values, delimiter, same_key, project_tens);
    let projected_first: list<i32> = projected_parts[0];
    let projected_second: list<i32> = projected_parts[1];
    verify(projected_parts.len() == 2 && projected_first[0] == 11 &&
           projected_second[0] == 4);
}

#[test]
fn test_ranges_join_transform_fuses_flatten_and_projection() {
    let values: list<list<i32>> = [[1, 2], [], [3, 4]];
    let widen = |value: i32| { return i64(value * 10); };
    let flattened: list<i64> = join_transform(values, widen);
    verify(flattened.len() == 4 && flattened[0] == 10 &&
           flattened[1] == 20 && flattened[2] == 30 &&
           flattened[3] == 40);

    var bounded: list<i64> = [0, 0, 0];
    verify(join_transform_to(values, &mut bounded, widen) == 3);
    verify(bounded[0] == 10 && bounded[1] == 20 && bounded[2] == 30);

    let empty: list<list<i32>> = [];
    let empty_result: list<i64> = join_transform(empty, widen);
    verify(empty_result.len() == 0);
}

#[test]
fn test_ranges_project_tuple_triple_elements() {
    let records: list<tuple<i32, i64, i32>> = [
        (1, 10, 100), (2, 20, 200), (3, 30, 300)];
    let first: list<i32> = elements_0(records);
    let second: list<i64> = elements_1(records);
    let third: list<i32> = elements_2(records);
    verify(first.len() == 3 && first[0] == 1 && first[2] == 3);
    verify(second.len() == 3 && second[0] == 10 && second[2] == 30);
    verify(third.len() == 3 && third[0] == 100 && third[2] == 300);
}

#[test]
fn test_ranges_project_tuple_quadruple_elements() {
    let records: list<tuple<i32, i64, i32, i64>> = [
        (1, 10, 100, 1000), (2, 20, 200, 2000)];
    let first: list<i32> = elements_0(records);
    let second: list<i64> = elements_1(records);
    let third: list<i32> = elements_2(records);
    let fourth: list<i64> = elements_3(records);
    verify(first[0] == 1 && first[1] == 2);
    verify(second[0] == 10 && second[1] == 20);
    verify(third[0] == 100 && third[1] == 200);
    verify(fourth[0] == 1000 && fourth[1] == 2000);
}

#[test]
fn test_ranges_project_tuple_eight_elements() {
    let records: list<tuple<i32, i64, i32, i64, i32, i64, i32, i64>> = [
        (1, 10, 100, 1000, 10000, 100000, 1000000, 10000000)];
    let fifth: list<i32> = elements_4(records);
    let sixth: list<i64> = elements_5(records);
    let seventh: list<i32> = elements_6(records);
    let eighth: list<i64> = elements_7(records);
    verify(fifth.len() == 1 && fifth[0] == 10000);
    verify(sixth.len() == 1 && sixth[0] == 100000);
    verify(seventh.len() == 1 && seventh[0] == 1000000);
    verify(eighth.len() == 1 && eighth[0] == 10000000);
}

#[test]
fn test_ranges_zip_longest_preserves_uneven_tails() {
    let left: list<i32> = [10, 20, 30];
    let right: list<i64> = [1];
    let zipped: list<tuple<option<i32>, option<i64>>> =
        zip_longest(left, right);
    let first: tuple<option<i32>, option<i64>> = zipped[0];
    let second: tuple<option<i32>, option<i64>> = zipped[1];
    let third: tuple<option<i32>, option<i64>> = zipped[2];
    let first_left: option<i32> = first.0;
    let first_right: option<i64> = first.1;
    let second_left: option<i32> = second.0;
    let second_right: option<i64> = second.1;
    let third_left: option<i32> = third.0;
    let third_right: option<i64> = third.1;
    verify(zipped.len() == 3 && first_left.unwrap() == 10 &&
           first_right.unwrap() == 1);
    verify(second_left.unwrap() == 20 && second_right.is_none());
    verify(third_left.unwrap() == 30 && third_right.is_none());

    var bounded: list<tuple<option<i32>, option<i64>>> = [
        (None<i32>(), None<i64>()), (None<i32>(), None<i64>())];
    verify(zip_longest_to(left, right, &mut bounded) == 2);
    let bounded_tail: tuple<option<i32>, option<i64>> = bounded[1];
    let bounded_left: option<i32> = bounded_tail.0;
    let bounded_right: option<i64> = bounded_tail.1;
    verify(bounded_left.unwrap() == 20 && bounded_right.is_none());
}

#[test]
fn test_ranges_zip_longest_many_accepts_runtime_arity() {
    let ranges: list<list<i32>> = [[1, 2], [10], [100, 200, 300]];
    let rows: list<list<option<i32>>> = zip_longest_many(ranges);
    let first: list<option<i32>> = rows[0];
    let second: list<option<i32>> = rows[1];
    let third: list<option<i32>> = rows[2];
    verify(rows.len() == 3 && first.len() == 3 &&
           first[0].unwrap() == 1 && first[1].unwrap() == 10 &&
           first[2].unwrap() == 100);
    verify(second[0].unwrap() == 2 && second[1].is_none() &&
           second[2].unwrap() == 200);
    verify(third[0].is_none() && third[1].is_none() &&
           third[2].unwrap() == 300);

    var bounded: list<list<option<i32>>> = [[], []];
    verify(zip_longest_many_to(ranges, &mut bounded) == 2);
    let bounded_second: list<option<i32>> = bounded[1];
    verify(bounded_second.len() == 3 && bounded_second[0].unwrap() == 2 &&
           bounded_second[1].is_none() && bounded_second[2].unwrap() == 200);

    let no_ranges: list<list<i32>> = [];
    let no_rows: list<list<option<i32>>> = zip_longest_many(no_ranges);
    verify(no_rows.len() == 0);
}

#[test]
fn test_ranges_zip_longest_transform_uses_fill_values() {
    let left: list<i32> = [10, 20, 30];
    let right: list<i64> = [1];
    let sum_filled = |first: i32, second: i64| {
        return i64(first) + second;
    };
    let missing_left: i32 = 0;
    let missing_right: i64 = -2;
    let sums: list<i64> = zip_longest_transform(
        left, right, missing_left, missing_right, sum_filled);
    verify(sums.len() == 3 && sums[0] == 11 &&
           sums[1] == 18 && sums[2] == 28);

    var bounded: list<i64> = [0, 0];
    verify(zip_longest_transform_to(
        left, right, &mut bounded, missing_left, missing_right,
        sum_filled) == 2);
    verify(bounded[0] == 11 && bounded[1] == 18);
}

#[test]
fn test_mutable_list_and_fixed_array_references() {
    var values: list<i32> = [4, 2];
    overwrite_first(&mut values);
    verify(values[0] == 2 && values[1] == 2);

    var fixed: array<i32, 2> = {7, 9};
    overwrite_first(&mut fixed);
    verify(fixed[0] == 9 && fixed[1] == 9);
}

#[test]
fn test_ranges_in_place_sort_on_mutable_list() {
    var values: list<i32> = [4, 1, 3, 2];
    let less = |left: i32, right: i32| { return left < right; };
    let identity = |value: i32| { return value; };
    sort_in_place_by_projected(&mut values, less, identity);
    verify(values[0] == 1 && values[1] == 2 &&
           values[2] == 3 && values[3] == 4);
}

#[test]
fn test_ranges_in_place_sort_with_default_comparator() {
    var values: list<i32> = [4, 1, 3, 2];
    sort_in_place(&mut values);
    verify(values[0] == 1 && values[1] == 2 &&
           values[2] == 3 && values[3] == 4);
}

#[test]
fn test_ranges_in_place_sort_accepts_fixed_array() {
    var values: array<i32, 4> = {4, 1, 3, 2};
    sort_in_place(&mut values);
    verify(values[0] == 1 && values[1] == 2 &&
           values[2] == 3 && values[3] == 4);
}

#[test]
fn test_ranges_mutable_heap_algorithms_accept_fixed_arrays() {
    var values: array<i32, 4> = {1, 4, 2, 3};
    make_heap_in_place(&mut values);
    verify(values[0] == 4);
}

#[test]
fn test_ranges_in_place_heap_algorithms() {
    var values: list<i32> = [1, 4, 2, 3];
    let less = |left: i32, right: i32| { return left < right; };
    let identity = |value: i32| { return value; };
    make_heap_in_place_by_projected(&mut values, less, identity);
    verify(values[0] == 4);
    pop_heap_in_place_by_projected(&mut values, less, identity);
    verify(values[3] == 4);
}

#[test]
fn test_ranges_in_place_heap_with_default_comparator() {
    var values: list<i32> = [1, 4, 2, 3];
    make_heap_in_place(&mut values);
    verify(values[0] == 4);
}

#[test]
fn test_ranges_partial_sort_in_place_on_mutable_list() {
    var values: list<i32> = [6, 1, 5, 2, 4, 3];
    let less = |left: i32, right: i32| { return left < right; };
    let identity = |value: i32| { return value; };
    partial_sort_in_place_by_projected(&mut values, 3, less, identity);
    verify(values[0] == 1 && values[1] == 2 && values[2] == 3);
}

#[test]
fn test_ranges_default_mutable_stable_and_partial_sort() {
    var values: list<i32> = [4, 1, 3, 2];
    stable_sort_in_place(&mut values);
    verify(values[0] == 1 && values[3] == 4);

    var prefix: list<i32> = [6, 1, 5, 2, 4, 3];
    partial_sort_in_place(&mut prefix, 3);
    verify(prefix[0] == 1 && prefix[1] == 2 && prefix[2] == 3);
}

#[test]
fn test_ranges_default_mutable_push_heap() {
    var heap: list<i32> = [4, 3, 2, 1];
    push_heap_in_place(&mut heap);
    verify(heap[0] == 4);
}

#[test]
fn test_ranges_default_mutable_pop_heap() {
    var heap: list<i32> = [4, 3, 2, 1];
    pop_heap_in_place(&mut heap);
    verify(heap[3] == 4);
}

#[test]
fn test_ranges_default_mutable_sort_heap() {
    var heap: list<i32> = [4, 3, 2, 1];
    sort_heap_in_place(&mut heap);
    verify(heap[0] == 1 && heap[3] == 4);
}

#[test]
fn test_ranges_default_mutable_nth_element() {
    var selected: list<i32> = [4, 1, 3, 2];
    verify(nth_element_in_place(&mut selected, 2) == 2);
    verify(selected[2] == 3);
}

#[test]
fn test_ranges_default_mutable_permutation_overloads() {
    var forward: list<i32> = [1, 2, 3];
    verify(next_permutation_in_place(&mut forward));
    verify(forward[0] == 1 && forward[1] == 3 && forward[2] == 2);
    verify(prev_permutation_in_place(&mut forward));
    verify(forward[0] == 1 && forward[1] == 2 && forward[2] == 3);
}
