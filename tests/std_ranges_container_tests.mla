mod std::testing;
mod std::algorithm::ranges;
mod std::flat_set;
mod std::flat_multiset;
mod std::flat_map;
mod std::flat_multimap;

use std::testing::verify;
use std::algorithm::ranges::find;
use std::algorithm::ranges::to_flat_set;
use std::algorithm::ranges::to_flat_multiset;
use std::algorithm::ranges::to_flat_map;
use std::algorithm::ranges::to_list_from_flat_set;
use std::algorithm::ranges::to_list_from_flat_multiset;
use std::algorithm::ranges::to_list_from_flat_map;
use std::algorithm::ranges::to_list_from_flat_multimap;
use std::flat_set::FlatSet;
use std::flat_multiset::FlatMultiSet;
use std::flat_map::FlatMap;
use std::flat_multimap::FlatMultiMap;

#[test]
fn test_ranges_materialize_flat_set_for_list_algorithms() {
    let source: list<i32> = [4, 1, 4, 2];
    let set: FlatSet<i32> = to_flat_set(source);
    let values: list<i32> = to_list_from_flat_set(set);
    verify(values.len() == 3 && values[0] == 1 &&
           values[1] == 2 && values[2] == 4);
    verify(find(values, 2) == 1);
}

#[test]
fn test_ranges_materialize_flat_multiset_preserving_duplicates() {
    let source: list<i32> = [4, 1, 4, 2];
    let multiset: FlatMultiSet<i32> = to_flat_multiset(source);
    let values: list<i32> = to_list_from_flat_multiset(multiset);
    verify(values.len() == 4 && values[0] == 1 && values[1] == 2 &&
           values[2] == 4 && values[3] == 4);
}

#[test]
fn test_ranges_materialize_flat_map_entries_in_key_order() {
    var values: FlatMap<i32, i32> = FlatMap<i32, i32>::new();
    values.insert(2, 20);
    values.insert(1, 10);
    let entries: list<tuple<i32, i32>> = to_list_from_flat_map(values);
    let first: tuple<i32, i32> = entries[0];
    let second: tuple<i32, i32> = entries[1];
    verify(entries.len() == 2 && first.0 == 1 && first.1 == 10 &&
           second.0 == 2 && second.1 == 20);
}

#[test]
fn test_ranges_materialize_flat_multimap_entries_in_key_order() {
    var values: FlatMultiMap<i32, i32> = FlatMultiMap<i32, i32>::new();
    values.insert(2, 20);
    values.insert(1, 10);
    values.insert(2, 21);
    let entries: list<tuple<i32, i32>> = to_list_from_flat_multimap(values);
    let first: tuple<i32, i32> = entries[0];
    let second: tuple<i32, i32> = entries[1];
    let third: tuple<i32, i32> = entries[2];
    verify(entries.len() == 3 && first.0 == 1 && first.1 == 10 &&
           second.0 == 2 && second.1 == 20 &&
           third.0 == 2 && third.1 == 21);
}

#[test]
fn test_generic_to_flat_map_resolves_nested_receiver_types() {
    let pairs: list<tuple<i32, i32>> = [(2, 20), (1, 10), (2, 21)];
    let values: FlatMap<i32, i32> = to_flat_map(pairs);
    verify(values.len() == 2 && values.key_at(0) == 1 &&
           values.value_at(0) == 10 && values.key_at(1) == 2 &&
           values.value_at(1) == 21);
}
