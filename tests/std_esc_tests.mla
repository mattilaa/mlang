mod std::testing;
mod std::esc;
mod std::strbuf;
mod std::term;

use std::esc::bg;
use std::esc::bold_off;
use std::esc::bold_on;
use std::esc::cmd_clear_screen;
use std::esc::cmd_hide;
use std::esc::cmd_home;
use std::esc::cmd_show;
use std::esc::color_blue;
use std::esc::color_red;
use std::esc::cursor;
use std::esc::cursor_move;
use std::esc::dir_right;
use std::esc::dir_up;
use std::esc::fg;
use std::esc::reset;
use std::term::supports_ansi;
use std::strbuf::find;
use std::strbuf::len;
use std::testing::verify;

#[test]
fn test_esc_fg_bg_codes() {
    if supports_ansi() == 1: {
        if find(fg(color_red()), "[31m") != 1: { verify(false); }
        if find(bg(color_blue()), "[44m") != 1: { verify(false); }
    } else {
        if len(fg(color_red())) != 0: { verify(false); }
        if len(bg(color_blue())) != 0: { verify(false); }
    }
    }

#[test]
fn test_esc_style_codes() {
    if supports_ansi() == 1: {
        if find(bold_on(), "[1m") != 1: { verify(false); }
        if find(bold_off(), "[22m") != 1: { verify(false); }
    } else {
        if len(bold_on()) != 0: { verify(false); }
        if len(bold_off()) != 0: { verify(false); }
    }
    }

#[test]
fn test_esc_cursor_commands() {
    let home: string = cursor(cmd_home());
    let hide: string = cursor(cmd_hide());
    let show: string = cursor(cmd_show());
    let clear: string = cursor(cmd_clear_screen());
    if supports_ansi() == 1: {
        if find(home, "[H") != 1: { verify(false); }
        if find(hide, "[?25l") != 1: { verify(false); }
        if find(show, "[?25h") != 1: { verify(false); }
        if find(clear, "[2J") != 1: { verify(false); }
    } else {
        if len(home) != 0: { verify(false); }
        if len(hide) != 0: { verify(false); }
        if len(show) != 0: { verify(false); }
        if len(clear) != 0: { verify(false); }
    }
    }

#[test]
fn test_esc_cursor_move_and_reset() {
    if supports_ansi() == 1: {
        if find(cursor_move(dir_up(), 3), "[3A") != 1: { verify(false); }
        if find(cursor_move(dir_right(), 12), "[12C") != 1: { verify(false); }
        let rs: string = reset();
        if find(rs, "[0m") != 1: { verify(false); }
        if len(rs) < 4: { verify(false); }
    } else {
        if len(cursor_move(dir_up(), 3)) != 0: { verify(false); }
        if len(cursor_move(dir_right(), 12)) != 0: { verify(false); }
        if len(reset()) != 0: { verify(false); }
    }
    }
