mod std::testing;
mod std::esc;
mod std::strbuf;
mod std::term;

use std::esc::bg;
use std::esc::bold_off;
use std::esc::bold_on;
use std::esc::cmd_clear_screen;
use std::esc::cmd_hide;
use std::esc::cmd_home;
use std::esc::cmd_show;
use std::esc::color_blue;
use std::esc::color_red;
use std::esc::cursor;
use std::esc::cursor_move;
use std::esc::dir_right;
use std::esc::dir_up;
use std::esc::fg;
use std::esc::reset;
use std::term::supports_ansi;
use std::strbuf::find;
use std::strbuf::len;
use std::testing::verify;

#[test]
fn test_esc_fg_bg_codes() {
    if supports_ansi() == 1: {
        verify(!(find(fg(color_red()), "[31m") != 1));
        verify(!(find(bg(color_blue()), "[44m") != 1));
    } else {
        verify(!(len(fg(color_red())) != 0));
        verify(!(len(bg(color_blue())) != 0));
    }
    }

#[test]
fn test_esc_style_codes() {
    if supports_ansi() == 1: {
        verify(!(find(bold_on(), "[1m") != 1));
        verify(!(find(bold_off(), "[22m") != 1));
    } else {
        verify(!(len(bold_on()) != 0));
        verify(!(len(bold_off()) != 0));
    }
    }

#[test]
fn test_esc_cursor_commands() {
    let home: str8 = cursor(cmd_home());
    let hide: str8 = cursor(cmd_hide());
    let show: str8 = cursor(cmd_show());
    let clear: str8 = cursor(cmd_clear_screen());
    if supports_ansi() == 1: {
        verify(!(find(home, "[H") != 1));
        verify(!(find(hide, "[?25l") != 1));
        verify(!(find(show, "[?25h") != 1));
        verify(!(find(clear, "[2J") != 1));
    } else {
        verify(!(len(home) != 0));
        verify(!(len(hide) != 0));
        verify(!(len(show) != 0));
        verify(!(len(clear) != 0));
    }
    }

#[test]
fn test_esc_cursor_move_and_reset() {
    if supports_ansi() == 1: {
        verify(!(find(cursor_move(dir_up(), 3), "[3A") != 1));
        verify(!(find(cursor_move(dir_right(), 12), "[12C") != 1));
        let rs: str8 = reset();
        verify(!(find(rs, "[0m") != 1));
        verify(!(len(rs) < 4));
    } else {
        verify(!(len(cursor_move(dir_up(), 3)) != 0));
        verify(!(len(cursor_move(dir_right(), 12)) != 0));
        verify(!(len(reset()) != 0));
    }
    }
