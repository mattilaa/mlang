mod std::testing;
mod tui_demo::midi_controller;
use std::testing::verify;
use tui_demo::midi_controller::*;
use std::sync::SpscQueue;
use std::thread::*;
use std::audio::controller::AudioController;
use std::audio::PcmBlock;

#[test]
fn midi_stream_decoder() {
    var decoder: MidiDecoder = MidiDecoder {};
    decoder.feed(146, 10); decoder.feed(60, 10);
    let realtime: MidiInputEvent = decoder.feed(248, 10); verify(realtime.kind == 3);
    let on: MidiInputEvent = decoder.feed(100, 10);
    verify(on.kind == 1 && on.channel == 2 && on.note == 60 && on.velocity == 100);
    decoder.feed(61, 11);
    let off: MidiInputEvent = decoder.feed(0, 11); verify(off.kind == 2 && off.note == 61);
    decoder.feed(130, 12); decoder.feed(60, 12);
    let explicit_off: MidiInputEvent = decoder.feed(64, 12); verify(explicit_off.kind == 2);
    decoder.feed(240, 13); decoder.feed(60, 13);
    let sysex: MidiInputEvent = decoder.feed(100, 13); verify(sysex.kind == 0);
    decoder.feed(247, 13);
    let orphan: MidiInputEvent = decoder.feed(60, 13); verify(orphan.kind == 0);
    decoder.feed(192, 14);
    let program: MidiInputEvent = decoder.feed(5, 14); verify(program.kind == 3);
}

#[test]
fn midi_recording_keeps_quick_note_on() {
    let queue: SpscQueue<MidiInputEvent> = SpscQueue<MidiInputEvent>::new(8);
    var controller: MidiController = MidiController { queue_handle: queue.handle };
    verify(queue.try_push(MidiInputEvent { kind: 1, note: 60, velocity: 87 }));
    verify(queue.try_push(MidiInputEvent { kind: 2, note: 60 }));
    controller.poll(1);
    verify(controller.last_velocity == 0 && controller.note_events.len() == 2);
    let note: MidiInputEvent = controller.note_events[0]; verify(note.note == 60 && note.velocity == 87);
    controller.poll(2); verify(controller.note_events.len() == 0);
    controller.release();
}

fn midi_test_producer(handle: i64) -> i32 {
    let queue: SpscQueue<MidiInputEvent> = SpscQueue<MidiInputEvent> { handle: handle };
    if !queue.try_push(MidiInputEvent { kind: 4 }) { return 1; }
    if !queue.try_push(MidiInputEvent { kind: 1, channel: 3, note: 67, velocity: 110, received_ms: 100 }) { return 2; }
    return 0;
}

#[test]
fn midi_worker_dispatch() {
    let queue: SpscQueue<MidiInputEvent> = SpscQueue<MidiInputEvent>::new(4);
    verify(queue.is_valid());
    var controller: MidiController = MidiController { queue_handle: queue.handle };
    let producer: thread = thread::spawn(midi_test_producer, queue.handle);
    verify(join(producer) == 0);
    verify(controller.poll(100));
    verify(controller.connected && controller.last_note == 67 && controller.last_velocity == 110 && controller.last_channel == 3);
    verify(!controller.poll(250));
    controller.dispatch(MidiInputEvent { kind: 2, channel: 2, note: 67 });
    verify(controller.last_velocity == 110);
    controller.dispatch(MidiInputEvent { kind: 2, channel: 3, note: 67 });
    verify(controller.last_velocity == 0);
    controller.release(); controller.release();
}

#[test]
fn midi_live_controls_and_velocity() {
    var decoder: MidiDecoder = MidiDecoder {};
    decoder.feed(179, 10); decoder.feed(1, 10); decoder.feed(248, 10);
    let modulation: MidiInputEvent = decoder.feed(32, 10);
    verify(modulation.kind == 6 && modulation.channel == 3 && modulation.note == 1 && modulation.velocity == 32);
    decoder.feed(1, 11); let running: MidiInputEvent = decoder.feed(96, 11);
    verify(running.kind == 6 && running.velocity == 96);
    decoder.feed(227, 12); decoder.feed(0, 12); let bend: MidiInputEvent = decoder.feed(64, 12);
    verify(bend.kind == 7 && bend.channel == 3 && bend.note == 129 && bend.velocity == 8192);
    decoder.feed(147, 13); decoder.feed(60, 13); let soft: MidiInputEvent = decoder.feed(32, 13);
    decoder.feed(61, 14); let hard: MidiInputEvent = decoder.feed(96, 14);
    verify(soft.kind == 1 && soft.velocity == 32 && hard.kind == 1 && hard.velocity == 96);
    decoder.feed(61, 15); let off: MidiInputEvent = decoder.feed(0, 15); verify(off.kind == 2);
    var dispatch: MidiController = MidiController {};
    dispatch.dispatch(soft); verify(dispatch.last_velocity == 32);
    dispatch.dispatch(modulation); verify(dispatch.last_velocity == 32 && dispatch.activity_until == 160);
    dispatch.dispatch(hard); verify(dispatch.last_velocity == 96);
    dispatch.dispatch(off); verify(dispatch.last_velocity == 0);
    dispatch.release();
}

#[test]
fn midi_decoded_velocity_reaches_audio() {
    let opened: result<AudioController, str8> = AudioController::new(48000, 128);
    let audio: AudioController = opened.unwrap();
    let allocated: result<PcmBlock, str8> = PcmBlock::new(1024); let block: PcmBlock = allocated.unwrap();
    verify(audio.midi_target(0, 0) == 0);
    var decoder: MidiDecoder = MidiDecoder {};
    decoder.feed(144, 1); decoder.feed(60, 1); let soft: MidiInputEvent = decoder.feed(32, 1);
    verify(soft.send_audio(audio) == 0); verify(audio.process(block, 1024) == 0);
    let first: f32 = block.left(900);
    decoder.feed(60, 2); let hard: MidiInputEvent = decoder.feed(96, 2);
    verify(hard.send_audio(audio) == 0); verify(audio.process(block, 1024) == 0);
    let difference: f32 = block.left(900) - first * 3.0f;
    verify(first != 0.0f && difference > -0.000001f && difference < 0.000001f);
    decoder.feed(60, 3); let off: MidiInputEvent = decoder.feed(0, 3);
    verify(off.send_audio(audio) == 0); verify(audio.process(block, 1024) == 0);
    verify(block.left(900) == 0.0f);
    block.close(); audio.close();
}

#[test]
fn midi_bounded_queue_and_loss() {
    let queue: SpscQueue<MidiInputEvent> = SpscQueue<MidiInputEvent>::new(1);
    verify(queue.try_push(MidiInputEvent { kind: 1, note: 60, velocity: 100 }));
    verify(!queue.try_push(MidiInputEvent { kind: 2, note: 60 }));
    var controller: MidiController = MidiController { queue_handle: queue.handle };
    controller.dropped = atomic_new(1);
    controller.poll(100);
    verify(controller.lost_events == 1 && controller.last_note == -1 && controller.last_velocity == 0);
    controller.release();
}
