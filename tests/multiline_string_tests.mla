mod std::testing;

use std::testing::verify;

extern fn strcmp(a: str8, b: str8) -> i32;

#[test]
fn test_multiline_string_preserves_newlines() {
    let msg: str8 = "Hello
world";
    verify(strcmp(msg, "Hello\nworld") == 0);
}

#[test]
fn test_multiline_string_preserves_indented_rows() {
    let asm_text: str8 = "mov $0, $1
    add $0, $0, $2
ret";
    verify(strcmp(asm_text, "mov $0, $1\n    add $0, $0, $2\nret") == 0);
}
