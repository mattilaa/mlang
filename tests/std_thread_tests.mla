mod std::testing;
mod std::sync;
mod std::thread;

use std::sync::mutex;
use std::thread::*;
use std::testing::verify;

fn worker(id: i64) -> i32 {
    return id == 7 ? 0 : 1;
}

struct AtomicPropertySlot {
    @property(atomic)
    var value: i64;
};

struct PairStamp {
    var left: i64;
    var right: i64;
};

struct MutexPropertySlot {
    @property(mutex)
    var stamp: PairStamp;
};

struct RecursiveMutexPropertySlot {
    @property(mutex, recursive)
    var value: i64;
};

fn shared_atomic_property_slot(next: i64, write: i32) -> i64 {
    static var slot: AtomicPropertySlot = AtomicPropertySlot { value: 0 };
    if write != 0 {
        slot.setValue(next);
    }
    return slot.getValue();
}

fn atomic_property_pattern(id: i64) -> i64 {
    if id == 0: { return 1111111111111111111; }
    if id == 1: { return 2222222222222222222; }
    if id == 2: { return 3333333333333333333; }
    return 4444444444444444444;
}

fn is_valid_atomic_property_value(value: i64) -> i32 {
    if value == 0 { return 1; }
    if value == 1111111111111111111 { return 1; }
    if value == 2222222222222222222 { return 1; }
    if value == 3333333333333333333 { return 1; }
    if value == 4444444444444444444 { return 1; }
    return 0;
}

fn atomic_property_writer(id: i64, iterations: i64) -> i32 {
    let value: i64 = atomic_property_pattern(id);
    var i: i64 = 0;
    while i < iterations {
        let observed: i64 = shared_atomic_property_slot(value, 1);
        if is_valid_atomic_property_value(observed) == 0: { return 1; }
        i = i + 1;
    }
    return 0;
}

fn mutex_property_stamp(id: i64) -> PairStamp {
    return PairStamp {
        left: id * 1000 + 7,
        right: id * 10000 + 17
    };
}

fn pair_stamp_eq(a: PairStamp, b: PairStamp) -> i32 {
    return a.left == b.left && a.right == b.right ? 1 : 0;
}

fn is_valid_mutex_stamp(value: PairStamp) -> i32 {
    if value.left == 0 && value.right == 0 { return 1; }
    if pair_stamp_eq(value, mutex_property_stamp(0)) != 0 { return 1; }
    if pair_stamp_eq(value, mutex_property_stamp(1)) != 0 { return 1; }
    if pair_stamp_eq(value, mutex_property_stamp(2)) != 0 { return 1; }
    if pair_stamp_eq(value, mutex_property_stamp(3)) != 0 { return 1; }
    return 0;
}

fn shared_mutex_property_slot(next: PairStamp, write: i32) -> PairStamp {
    static var slot: MutexPropertySlot = MutexPropertySlot {
        stamp: PairStamp { left: 0, right: 0 }
    };
    if write != 0 {
        slot.setStamp(next);
    }
    return slot.getStamp();
}

fn mutex_property_writer(id: i64, iterations: i64) -> i32 {
    var i: i64 = 0;
    while i < iterations {
        shared_mutex_property_slot(mutex_property_stamp(id), 1);
        let observed: PairStamp = shared_mutex_property_slot(
            PairStamp { left: 0, right: 0 }, 0);
        if is_valid_mutex_stamp(observed) == 0: { return 1; }
        i = i + 1;
    }
    return 0;
}

fn mutex_property_reader(iterations: i64) -> i32 {
    var i: i64 = 0;
    while i < iterations {
        let observed: PairStamp = shared_mutex_property_slot(
            PairStamp { left: 0, right: 0 }, 0);
        if is_valid_mutex_stamp(observed) == 0: { return 1; }
        i = i + 1;
    }
    return 0;
}

fn recursive_mutex_property_slot(next: i64, write: i32) -> i64 {
    static var slot: RecursiveMutexPropertySlot =
        RecursiveMutexPropertySlot { value: 0 };
    if write != 0 {
        slot.setValue(next);
    }
    return slot.getValue();
}

#[test]
fn test_thread_join_helper() {
    let h: std::thread::thread = thread::spawn(worker, 7);
    let status: i32 = join(h);
    verify(status == 0);
}

#[test]
fn test_mutex_atomic_helpers() {
    let mr: result<mutex, str8> = mutex::new();
    verify(mr.is_ok());
    let mtx: mutex = mr.unwrap();
    let lock_r: result<i32, str8> = mtx.lock();
    verify(lock_r.is_ok());
    let unlock_r: result<i32, str8> = mtx.unlock();
    verify(unlock_r.is_ok());
    verify(mtx.close() == 0);

    let c: std::thread::atomic64 = atomic_new(5);
    let old: i64 = atomic_add_value(c, 3);
    let now: i64 = atomic_load_value(c);
    atomic_free_handle(c);

    if old != 5: { verify(false); }
    if now != 8: { verify(false); }
    }

#[test]
fn test_atomic_property_accessors() {
    let before: i64 = shared_atomic_property_slot(0, 0);
    verify(before == 0);

    let after_set: i64 = shared_atomic_property_slot(99, 1);
    let after_get: i64 = shared_atomic_property_slot(0, 0);
    verify(after_set == 99);
    verify(after_get == 99);
}

#[test]
fn test_atomic_property_parallel_writers() {
    let _ = shared_atomic_property_slot(0, 1);

    let h1: std::thread::thread = thread::spawn(atomic_property_writer, 0, 20000);
    let h2: std::thread::thread = thread::spawn(atomic_property_writer, 1, 20000);
    let h3: std::thread::thread = thread::spawn(atomic_property_writer, 2, 20000);
    let h4: std::thread::thread = thread::spawn(atomic_property_writer, 3, 20000);

    let rc1: i32 = join(h1);
    let rc2: i32 = join(h2);
    let rc3: i32 = join(h3);
    let rc4: i32 = join(h4);
    let final_value: i64 = shared_atomic_property_slot(0, 0);

    verify(rc1 == 0);
    verify(rc2 == 0);
    verify(rc3 == 0);
    verify(rc4 == 0);
    verify(is_valid_atomic_property_value(final_value) == 1);
}

#[test]
fn test_mutex_property_accessors() {
    let before: PairStamp = shared_mutex_property_slot(
        PairStamp { left: 0, right: 0 }, 0);
    verify(before.left == 0);
    verify(before.right == 0);

    let _ = shared_mutex_property_slot(mutex_property_stamp(9), 1);
    let observed: PairStamp = shared_mutex_property_slot(
        PairStamp { left: 0, right: 0 }, 0);
    verify(pair_stamp_eq(mutex_property_stamp(9), observed) == 1);
}

#[test]
fn test_mutex_property_parallel_writers() {
    let _ = shared_mutex_property_slot(PairStamp { left: 0, right: 0 }, 1);

    let h1: std::thread::thread = thread::spawn(mutex_property_writer, 0, 15000);
    let h2: std::thread::thread = thread::spawn(mutex_property_writer, 1, 15000);
    let h3: std::thread::thread = thread::spawn(mutex_property_writer, 2, 15000);
    let h4: std::thread::thread = thread::spawn(mutex_property_writer, 3, 15000);
    let hr: std::thread::thread = thread::spawn(mutex_property_reader, 30000);

    let rc1: i32 = join(h1);
    let rc2: i32 = join(h2);
    let rc3: i32 = join(h3);
    let rc4: i32 = join(h4);
    let rcr: i32 = join(hr);
    let final_value: PairStamp = shared_mutex_property_slot(
        PairStamp { left: 0, right: 0 }, 0);

    verify(rc1 == 0);
    verify(rc2 == 0);
    verify(rc3 == 0);
    verify(rc4 == 0);
    verify(rcr == 0);
    verify(is_valid_mutex_stamp(final_value) == 1);
}

#[test]
fn test_recursive_mutex_property_accessors() {
    let before: i64 = recursive_mutex_property_slot(0, 0);
    verify(before == 0);
    let after: i64 = recursive_mutex_property_slot(123, 1);
    verify(after == 123);
    verify(recursive_mutex_property_slot(0, 0) == 123);
}

#[test]
fn test_mutex_property_struct_copy_after_lock_init() {
    var original: MutexPropertySlot = MutexPropertySlot {
        stamp: mutex_property_stamp(5)
    };

    let initialized: PairStamp = original.getStamp();
    verify(pair_stamp_eq(initialized, mutex_property_stamp(5)) == 1);

    var copied: MutexPropertySlot = original;
    let copied_before: PairStamp = copied.getStamp();
    verify(pair_stamp_eq(copied_before, mutex_property_stamp(5)) == 1);

    copied.setStamp(mutex_property_stamp(6));

    let original_after: PairStamp = original.getStamp();
    let copied_after: PairStamp = copied.getStamp();
    verify(pair_stamp_eq(original_after, mutex_property_stamp(5)) == 1);
    verify(pair_stamp_eq(copied_after, mutex_property_stamp(6)) == 1);
}
