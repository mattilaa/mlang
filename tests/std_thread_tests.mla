mod std::thread;

use std::thread::*;

fn worker(id: i64) -> i32 {
    return id == 7 ? 0 : 1;
}

#[test]
fn test_thread_join_helper() -> i32 {
    let h: Handle<Thread> = thread_spawn(worker, 7);
    let status: i32 = join(h);
    return status == 0 ? 0 : 1;
}

#[test]
fn test_mutex_atomic_helpers() -> i32 {
    let mtx: Handle<Mutex> = mutex_new();
    if mutex_lock_handle(mtx) != 0: { return 1; }
    if mutex_unlock_handle(mtx) != 0: { return 1; }
    if mutex_free(mtx) != 0: { return 1; }

    let c: Handle<Atomic64> = atomic_new(5);
    let old: i64 = atomic_add_value(c, 3);
    let now: i64 = atomic_load_value(c);
    atomic_free_handle(c);

    if old != 5: { return 1; }
    if now != 8: { return 1; }
    return 0;
}

