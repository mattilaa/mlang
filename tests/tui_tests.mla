#[test]
fn tui_layout_alignment() {
    var layout: Layout = Layout { axis: Axis::Horizontal, gap: 2,
        alignment: Alignment::Center, sizes: [Size::fixed(4), Size::fixed(4)] };
    var parts: list<Rect> = layout.split(Rect::new(3, 5, 20, 20));
    let first: Rect = parts[0]; let second: Rect = parts[1];
    verify(first.x == 8 && second.x == 14);
    layout.axis = Axis::Vertical; layout.alignment = Alignment::End;
    parts = layout.split(Rect::new(3, 5, 20, 20));
    let bottom: Rect = parts[1]; verify(bottom.y == 21 && bottom.height == 4);
    layout.alignment = Alignment::Center;
    parts = layout.split(Rect::new(3, 5, 20, 20));
    let middle: Rect = parts[0]; verify(middle.y == 10);
    layout.sizes = [Size::flex(1), Size::fixed(4)];
    parts = layout.split(Rect::new(3, 5, 20, 20));
    let flexible: Rect = parts[0]; verify(flexible.y == 5 && flexible.height == 14);
}

#[test]
fn tui_base_dialog_and_push_button() {
    var dialog: Dialog = Dialog::new("Question", 40, 15);
    let viewport: Rect = Rect::new(0, 0, 80, 24);
    let content: Rect = dialog.content_rect(viewport);
    let row: Rect = dialog.button_row(viewport);
    let buttons: list<Rect> = dialog.button_rects(viewport);
    let left: Rect = buttons[0]; let right: Rect = buttons[1];
    verify(content.y + content.height == row.y && row.height == 4);
    verify(left.x - row.x == (row.width - left.width - right.width - 2) / 2);
    let surface: Surface = Surface::new(80, 24);
    let theme: Theme = Theme::dark_blue();
    let button: PushButton = PushButton { label: "OK", action: 7 };
    surface.fill(viewport, Cell { glyph: 88, foreground: theme.foreground, background: theme.panel });
    button.paint(surface, left, theme, true, false);
    let raised: Cell = surface.cell(left.x, left.y);
    let shadow: Cell = surface.cell(left.x + left.width - 1, left.y + 1);
    verify(raised.glyph == 0x250C && raised.foreground == theme.accent);
    verify(shadow.glyph == 88 && shadow.background == darken(theme.panel, theme.shadow_percent));
    surface.fill(viewport, Cell { glyph: 32, foreground: theme.foreground, background: theme.panel });
    button.paint(surface, left, theme, true, true);
    let depressed: Cell = surface.cell(left.x + 1, left.y + 1);
    let old_corner: Cell = surface.cell(left.x, left.y);
    verify(depressed.glyph == 0x250C && old_corner.glyph == 32);
    surface.release();
}

#[test]
fn tui_question_custom_buttons() {
    var question: QuestionDialog = QuestionDialog::new("Confirm", "Continue?");
    question.buttons = [PushButton { label: "Unavailable", action: 8, enabled: false },
        PushButton { label: "Proceed", action: 42 }, PushButton { label: "Later", action: 43 },
        PushButton { label: "Cancel", action: 2 }];
    question.open(); verify(question.button_selected == 1);
    question.on_event(decode_input("l")); verify(question.button_selected == 2);
    question.on_event(decode_input("h")); verify(question.button_selected == 1);
    question.button_selected = 3;
    let small: Rect = Rect::new(0, 0, 24, 14);
    let row: Rect = question.button_row(small);
    let rectangles: list<Rect> = question.button_rects(small);
    let visible: Rect = rectangles[3];
    verify(visible.width == 11 && visible.x + visible.width == row.x + row.width);
    for rectangle in rectangles {
        verify(rectangle.width == 0 || (rectangle.x >= row.x && rectangle.x + rectangle.width <= row.x + row.width));
    }
    question.button_selected = 1;
    question.on_event(decode_input("\r"));
    verify(question.active && question.pressed_button == 1 && question.result == 0);
    for _i in 0..9 { question.tick(); verify(question.active); }
    question.tick(); verify(!question.active && question.result == 42);
    question.open(); question.on_event(InputEvent { kind: InputKind::Menu, key: Key::Escape });
    verify(!question.active && question.result == 2);
    question.buttons = []; question.open(); question.on_event(decode_input("\r"));
    verify(question.button_selected == -1 && question.pressed_button == -1);
}

#[test]
fn tui_file_dialog_focus_and_path_entry() {
    var dialog: OpenSessionDialog = OpenSessionDialog::new();
    let viewport: Rect = Rect::new(0, 0, 80, 24);
    // Save choosers edit a suggested filename, so they start in the path field.
    dialog.save_mode = true;
    dialog.open("tests/fixtures/tui_dialog");
    verify(dialog.focus.selected == 0);
    // Browsing starts in the directory list instead.
    dialog.save_mode = false;
    dialog.open("tests/fixtures/tui_dialog");
    verify(dialog.focus.selected == 1);
    // Ctrl+U from the list clears the path field and moves focus there.
    dialog.on_event(decode_input("\x15"), viewport);
    verify(dialog.focus.selected == 0 && dialog.path_field.text == "");
    // A leading "/" also jumps there, keeping the typed character.
    dialog.open("tests/fixtures/tui_dialog");
    verify(dialog.focus.selected == 1);
    dialog.on_event(decode_input("/"), viewport);
    verify(dialog.focus.selected == 0 && dialog.path_field.text == "/");
    // Plain letters still navigate the tree rather than typing a path.
    dialog.open("tests/fixtures/tui_dialog");
    dialog.on_event(decode_input("k"), viewport);
    verify(dialog.focus.selected == 1);
    dialog.release();
}

#[test]
fn tui_file_dialog_multi_select() {
    var dialog: OpenSessionDialog = OpenSessionDialog::new();
    let viewport: Rect = Rect::new(0, 0, 80, 24);
    dialog.multi_select = true;
    dialog.open("tests/fixtures/tui_dialog");
    dialog.focus.selected = 2; dialog.file_selected = 0;
    verify(dialog.files.len() == 2);
    // Space marks the file under the cursor and steps to the next one.
    dialog.on_event(decode_input(" "), viewport);
    verify(dialog.marked.len() == 1 && dialog.file_selected == 1);
    dialog.on_event(decode_input(" "), viewport);
    verify(dialog.marked.len() == 2 && dialog.file_selected == 1);
    // Space again on the same file unmarks it.
    dialog.on_event(decode_input(" "), viewport);
    verify(dialog.marked.len() == 1);
    // Enter opens every marked file, not the one under the cursor.
    dialog.on_event(decode_input("\r"), viewport);
    verify(dialog.accepted && !dialog.active);
    verify(dialog.accepted_paths.len() == 1 && dialog.accepted_path == dialog.accepted_paths[0]);
    verify(ends_with(dialog.accepted_path, "alpha.session") == 1);
    // Marks do not survive reopening.
    dialog.open("tests/fixtures/tui_dialog");
    verify(dialog.marked.len() == 0 && dialog.accepted_paths.len() == 0);
    // Two marked files are both accepted, in marking order.
    dialog.focus.selected = 2; dialog.file_selected = 0;
    dialog.on_event(decode_input(" "), viewport);
    dialog.on_event(decode_input(" "), viewport);
    dialog.on_event(decode_input("\r"), viewport);
    verify(dialog.accepted_paths.len() == 2);
    verify(ends_with(dialog.accepted_paths[0], "alpha.session") == 1);
    dialog.release();
}

#[test]
fn tui_file_dialog_multi_select_is_opt_in() {
    var dialog: OpenSessionDialog = OpenSessionDialog::new();
    let viewport: Rect = Rect::new(0, 0, 80, 24);
    // Session/preset choosers never mark: they open exactly one file.
    dialog.open("tests/fixtures/tui_dialog");
    dialog.focus.selected = 2; dialog.file_selected = 0;
    dialog.on_event(decode_input(" "), viewport);
    verify(dialog.marked.len() == 0 && dialog.file_selected == 0);
    // Neither do save choosers, even where multi-open is allowed.
    dialog.multi_select = true; dialog.save_mode = true;
    dialog.open("tests/fixtures/tui_dialog");
    dialog.focus.selected = 2; dialog.file_selected = 0;
    dialog.on_event(decode_input(" "), viewport);
    verify(dialog.marked.len() == 0);
    dialog.release();
}

#[test]
fn tui_file_dialog_marked_rows_are_brighter() {
    var dialog: OpenSessionDialog = OpenSessionDialog::new();
    let bounds: Rect = Rect::new(0, 0, 80, 24);
    let theme: Theme = Theme::dark_blue();
    dialog.multi_select = true;
    dialog.open("tests/fixtures/tui_dialog");
    dialog.focus.selected = 2; dialog.file_selected = 0;
    dialog.on_event(decode_input(" "), bounds); // mark row 0, cursor moves to row 1
    let surface: Surface = Surface::new(80, 24);
    dialog.paint(surface, bounds, theme);
    let panes: list<Pane> = dialog.panes(bounds);
    let files: Pane = panes[2];
    let marked: Cell = surface.cell(files.bounds.x + 1, files.bounds.y + 1);
    let cursor: Cell = surface.cell(files.bounds.x + 1, files.bounds.y + 2);
    verify(marked.background == lighten(theme.panel, 26));
    verify(cursor.background == theme.selection);
    verify(marked.background != theme.panel && marked.background != theme.selection);
    surface.release(); dialog.release();
}

#[test]
fn tui_file_dialog_shared_buttons() {
    var dialog: OpenSessionDialog = OpenSessionDialog::new();
    let viewport: Rect = Rect::new(0, 0, 80, 24);
    dialog.open("tests/fixtures/tui_dialog");
    // Browsing starts in the directory tree; the buttons sit below it.
    verify(dialog.focus.selected == 1);
    dialog.on_event(decode_input("\x1b[108;6u"), viewport);
    verify(dialog.focus.selected == 2);
    dialog.on_event(decode_input("\x1b[106;6u"), viewport);
    verify(dialog.focus.selected == 3);
    dialog.on_event(decode_input("\r"), viewport);
    // Navigation cannot change an activation already in progress.
    dialog.on_event(decode_input("l"), viewport);
    for _i in 0..10 { dialog.tick(); }
    verify(dialog.accepted && !dialog.active);
    dialog.open("tests/fixtures/tui_dialog"); dialog.focus.selected = 3;
    dialog.on_event(decode_input("l"), viewport);
    dialog.on_event(decode_input("\r"), viewport);
    verify(dialog.active && dialog.pressed_button == 1);
    for _i in 0..10 { dialog.tick(); }
    verify(!dialog.active && !dialog.accepted && dialog.result == 2);
    dialog.release();
}
use tui::textfield::TextField;

#[test]
fn tui_path_text_editing() {
    var field_editor: TextField = TextField::new("");
    let letters: list<i32> = [113, 104, 106, 107, 108, 32, 120];
    var decoder: InputDecoder = InputDecoder::new();
    for code in letters { field_editor.on_event(decoder.feed(code)); }
    verify(field_editor.text == "qhjkl x"); // q/hjkl are text, not commands
    field_editor.on_event(decoder.feed(127));
    verify(field_editor.text == "qhjkl ");
    field_editor.on_event(decode_input("\x1b[H"));
    field_editor.on_event(decoder.feed(65));
    verify(field_editor.text == "Aqhjkl ");
    field_editor.on_event(decode_input("\x1b[3~"));
    verify(field_editor.text == "Ahjkl ");
    field_editor.on_event(decoder.feed(21));
    verify(field_editor.text == "");
    field_editor.on_event(decode_input("\x1b[233u"));
    verify(field_editor.text == "é");
    field_editor.on_event(decoder.feed(127));
    verify(field_editor.text == "");
    field_editor.release();
}

#[test]
fn tui_open_session_directory_tree() {
    var dialog: OpenSessionDialog = OpenSessionDialog::new();
    dialog.open("tests/fixtures/tui_dialog");
    // Browsing opens focused on the directory tree.
    verify(dialog.active && !dialog.accepted && dialog.focus.selected == 1);
    verify(dialog.files.len() == 2);
    verify(dialog.files[0] == "alpha.session");
    verify(dialog.nodes.len() == 3);
    dialog.select_directory(2); // branch
    verify(dialog.files.len() == 1 && dialog.files[0] == "child.session");
    dialog.expand_selected();
    verify(dialog.nodes.len() == 4);
    dialog.select_directory(3); // nested
    verify(dialog.files.len() == 1 && dialog.files[0] == "leaf.session");
    dialog.collapse_selected(); // unopened node -> its parent
    verify(dialog.tree_selected == 2 && dialog.files[0] == "child.session");
    dialog.collapse_selected();
    verify(dialog.nodes.len() == 3);
    dialog.release();
}

#[test]
fn tui_open_session_path_validation_and_acceptance() {
    var dialog: OpenSessionDialog = OpenSessionDialog::new();
    dialog.open("tests/fixtures/tui_dialog");
    dialog.path_field.set_text("does-not-exist.session");
    dialog.submit_path();
    verify(dialog.active && !dialog.accepted);
    verify(dialog.files.len() == 2);
    dialog.path_field.set_text("branch");
    dialog.submit_path();
    verify(dialog.active && dialog.files.len() == 1 && dialog.files[0] == "child.session");
    dialog.path_field.set_text("child.session");
    dialog.submit_path();
    verify(dialog.accepted && !dialog.active);
    dialog.open("tests/fixtures/tui_dialog");
    verify(!dialog.accepted && dialog.accepted_path == "");
    dialog.cancel();
    verify(!dialog.active && !dialog.accepted);
    dialog.release();
}

#[test]
fn tui_dialog_focus_and_rendering() {
    var dialog: OpenSessionDialog = OpenSessionDialog::new();
    dialog.open("tests/fixtures/tui_dialog");
    let bounds: Rect = Rect::new(0, 0, 80, 24);
    let panes: list<Pane> = dialog.panes(bounds);
    let path: Pane = panes[0]; let tree: Pane = panes[1]; let files: Pane = panes[2];
    verify(path.bounds.height == 1 && tree.bounds.y == path.bounds.y + 1);
    verify(files.bounds.x > tree.bounds.x && tree.bounds.y == files.bounds.y);
    // Browsing starts in the tree; move up to the path row first.
    verify(dialog.focus.selected == 1);
    dialog.on_event(decode_input("\x1b[107;6u"), bounds);
    verify(dialog.focus.selected == 0);
    dialog.on_event(decode_input("\x1b[106;6u"), bounds); // path -> files (nearest center)
    verify(dialog.focus.selected == 2);
    dialog.on_event(decode_input("\x1b[104;6u"), bounds);
    verify(dialog.focus.selected == 1);
    dialog.on_event(decode_input("\x1b[108;6u"), bounds);
    verify(dialog.focus.selected == 2);
    dialog.on_event(decode_input("\x1b[107;6u"), bounds);
    verify(dialog.focus.selected == 0);
    let surface: Surface = Surface::new(80, 24);
    let theme: Theme = Theme::dark_blue();
    surface.fill(bounds, Cell { glyph: 88, foreground: theme.foreground, background: theme.panel });
    dialog.paint(surface, bounds, theme);
    let area: Rect = dialog.bounds(bounds);
    let title: Cell = surface.cell(area.x + 2, area.y);
    verify(title.glyph == 79); // Open session, on the upper border
    let first_line: Cell = surface.cell(path.bounds.x, path.bounds.y);
    verify(first_line.glyph == 80); // Path: is uppermost inside line
    let shadow: Cell = surface.cell(area.x + area.width, area.y + 1);
    verify(shadow.glyph == 88 && shadow.foreground == darken(theme.foreground, theme.shadow_percent));
    dialog.on_event(InputEvent { kind: InputKind::Menu, key: Key::Escape }, bounds);
    verify(!dialog.active);
    surface.release(); dialog.release();
}

fn focus_panes() -> list<Pane> {
    return [Pane { id: 10, bounds: Rect::new(0, 1, 20, 20) },
            Pane { id: 20, bounds: Rect::new(21, 1, 40, 12) },
            Pane { id: 30, bounds: Rect::new(21, 14, 40, 7) }];
}

#[test]
fn tui_directional_pane_focus() {
    let panes: list<Pane> = focus_panes();
    var focus: PaneFocus = PaneFocus::new(10);
    focus.navigate(Key::Right, panes);
    verify(focus.is_active(20));
    focus.navigate(Key::Down, panes);
    verify(focus.is_active(30));
    focus.navigate(Key::Down, panes);
    verify(focus.is_active(30)); // no wrap at the bottom
    focus.navigate(Key::Up, panes);
    verify(focus.is_active(20));
    focus.navigate(Key::Left, panes);
    verify(focus.is_active(10));
    focus.navigate(Key::Left, panes);
    verify(focus.is_active(10));
}

#[test]
fn tui_menu_preserves_pane_focus() {
    let panes: list<Pane> = focus_panes();
    var focus: PaneFocus = PaneFocus::new(30);
    var menus: MenuBar = test_menus();
    let exits: list<Key> = [Key::Escape, Key::Toggle, Key::Enter];
    for exit_key in exits {
        menus.open(0);
        focus.set_menu_active(menus.active >= 0);
        verify(!focus.is_active(30) && focus.selected == 30);
        focus.navigate(Key::Up, panes);
        verify(focus.selected == 30); // menu owns input while open
        menus.on_key(exit_key);
        focus.set_menu_active(menus.active >= 0);
        verify(focus.is_active(30));
    }
}

#[test]
fn tui_focus_resize_and_highlight() {
    var focus: PaneFocus = PaneFocus::new(30);
    let reordered: list<Pane> = [Pane { id: 30, bounds: Rect::new(0, 0, 10, 5) },
        Pane { id: 10, bounds: Rect::new(11, 0, 10, 5) }];
    focus.reconcile(reordered);
    verify(focus.selected == 30);
    let collapsed: list<Pane> = [Pane { id: 30, bounds: Rect::new(0, 0, 0, 0) },
        Pane { id: 10, bounds: Rect::new(0, 0, 10, 5) }];
    focus.reconcile(collapsed);
    verify(focus.selected == 10);
    let theme: Theme = Theme::dark_blue();
    let surface: Surface = Surface::new(20, 5);
    let panel: Panel = Panel { title: " Pane " };
    panel.paint_focused(surface, Rect::new(0, 0, 10, 5), theme, true);
    panel.paint_focused(surface, Rect::new(10, 0, 10, 5), theme, false);
    let active: Cell = surface.cell(0, 1);
    let inactive: Cell = surface.cell(10, 1);
    verify(active.foreground == theme.accent && inactive.foreground == theme.border);
    verify(active.glyph == inactive.glyph && active.glyph == 0x2502);
    surface.release();
    let empty: list<Pane> = [];
    focus.reconcile(empty);
    verify(focus.selected == -1);
}

fn decode_input(text: str8) -> InputEvent {
    var decoder: InputDecoder = InputDecoder::new();
    let result: result<Bytes, str8> = Bytes::from_string(text);
    let bytes: Bytes = result.unwrap();
    var event: InputEvent = InputEvent { kind: InputKind::None, key: Key::Escape };
    for i in 0..bytes.len() { event = decoder.feed(bytes.get(i)); }
    bytes.close();
    return event;
}

#[test]
fn tui_modified_keyboard_protocols() {
    let left: InputEvent = decode_input("\x1b[104;6u");
    let down: InputEvent = decode_input("\x1b[106;6u");
    let up: InputEvent = decode_input("\x1b[107;6u");
    let right: InputEvent = decode_input("\x1b[108;6u");
    verify(left.kind == InputKind::Pane && left.key == Key::Left);
    verify(down.kind == InputKind::Pane && down.key == Key::Down);
    verify(up.kind == InputKind::Pane && up.key == Key::Up);
    verify(right.kind == InputKind::Pane && right.key == Key::Right);
    let xterm: InputEvent = decode_input("\x1b[27;6;72~");
    verify(xterm.kind == InputKind::Pane && xterm.key == Key::Left);
    let repeated: InputEvent = decode_input("\x1b[108:76;6:2u");
    verify(repeated.kind == InputKind::Pane && repeated.key == Key::Right);
    let released: InputEvent = decode_input("\x1b[108;6:3u");
    verify(released.kind == InputKind::None);
    let plain_ctrl: InputEvent = decode_input("\x1b[108;5u");
    verify(plain_ctrl.kind == InputKind::None);
    let backspace: InputEvent = decode_input("\x08");
    let enter: InputEvent = decode_input("\n");
    verify(backspace.kind == InputKind::Edit && backspace.key == Key::Backspace);
    verify(enter.kind == InputKind::Menu && enter.key == Key::Enter);
    let arrow: InputEvent = decode_input("\x1b[A");
    verify(arrow.kind == InputKind::Menu && arrow.key == Key::Up);
}

#[test]
fn tui_partial_and_invalid_keyboard_packets() {
    var decoder: InputDecoder = InputDecoder::new();
    decoder.feed(27);
    verify(decoder.pending());
    let escape: InputEvent = decoder.expire();
    verify(escape.kind == InputKind::Menu && escape.key == Key::Escape);
    decoder.feed(27); decoder.feed(91); decoder.feed(49);
    let truncated: InputEvent = decoder.expire();
    verify(truncated.kind == InputKind::None && !decoder.pending());
    let excessive: InputEvent = decode_input("\x1b[999999999999999999999999999999999999;6u");
    verify(excessive.kind == InputKind::None);
    let response: InputEvent = decode_input("\x1b[?1u");
    verify(response.kind == InputKind::None);
    let quit: InputEvent = decoder.feed(113);
    verify(quit.kind == InputKind::Quit);
}

#[test]
fn tui_surface_shadow_preserves_glyph() {
    let surface: Surface = Surface::new(4, 3);
    verify(surface.is_valid());
    surface.put(2, 1, Cell { glyph: 0x2500, foreground: 0xC0A080, background: 0x204060 });
    surface.shadow(Rect::new(2, 1, 4, 5), 50);
    let cell: Cell = surface.cell(2, 1);
    verify(cell.glyph == 0x2500);
    verify(cell.foreground == 0x605040);
    verify(cell.background == 0x102030);
    surface.release();
}

#[test]
fn tui_nested_layout() {
    let viewport: Viewport = Viewport { bounds: Rect::new(0, 0, 40, 12), has_menu: true };
    let layout: Layout = Layout { axis: Axis::Horizontal, gap: 1,
        sizes: [Size::fixed(10), Size::flex(1), Size::flex(2)] };
    let parts: list<Rect> = layout.split(viewport.content());
    verify(parts.len() == 3);
    let first: Rect = parts[0];
    let middle: Rect = parts[1];
    let last: Rect = parts[2];
    verify(first.width == 10 && first.y == 1 && first.height == 11);
    verify(last.x + last.width == 40);
    verify(middle.width == 9 && last.width == 19);
    let nested: Layout = Layout { axis: Axis::Vertical, gap: 1,
        sizes: [Size::flex(1), Size::flex(1)] };
    let children: list<Rect> = nested.split(last);
    let upper: Rect = children[0];
    let lower: Rect = children[1];
    verify(upper.x == last.x && upper.width == last.width && upper.height == 5);
    verify(lower.y == upper.y + upper.height + 1 && lower.y + lower.height == 12);
}

#[test]
fn tui_menu_scroll_and_disabled_only() {
    var menus: MenuBar = test_menus();
    menus.open(0);
    menus.on_key(Key::Up);
    let surface: Surface = Surface::new(20, 4);
    menus.paint(surface, surface.bounds(), Theme::dark_blue());
    let visible: Cell = surface.cell(2, 2);
    verify(visible.glyph == 81); // Quit is scrolled into the only visible row.
    surface.release();
    var disabled: MenuBar = MenuBar::new([
        Menu { title: "Empty", items: [] },
        Menu { title: "Disabled", items: [MenuItem { label: "No", action: 1, enabled: false }] }
    ]);
    disabled.open(0);
    verify(disabled.selected == -1 && disabled.on_key(Key::Enter) == 0);
    disabled.on_key(Key::Right);
    verify(disabled.active == 1 && disabled.selected == -1);
    verify(disabled.on_key(Key::Enter) == 0);
}

fn test_menus() -> MenuBar {
    return MenuBar::new([
        Menu { title: "File", items: [
            MenuItem { label: "Open", action: 1, enabled: true },
            MenuItem { label: "Save", action: 2, enabled: false },
            MenuItem { label: "Quit", action: 3, enabled: true }] },
        Menu { title: "Edit", items: [MenuItem { label: "Undo", action: 4, enabled: true }] }
    ]);
}

fn cascade_menus() -> MenuBar {
    return MenuBar::new([Menu { title: "File", items: [
        MenuItem { label: "Open", action: 1, enabled: true },
        MenuItem::submenu("Recent", [
            MenuItem { label: "Disabled", action: 2, enabled: false },
            MenuItem::submenu("Templates", [
                MenuItem { label: "Ambient", action: 42, enabled: true },
                MenuItem { label: "Dance", action: 43, enabled: true }
            ]),
            MenuItem { label: "Session", action: 44, enabled: true }
        ])
    ] }]);
}

#[test]
fn tui_cascading_menu_stack() {
    var menus: MenuBar = cascade_menus();
    menus.open(0);
    menus.on_key(Key::Down);
    verify(menus.selected == 1);
    menus.on_key(Key::Right);
    verify(menus.depth() == 1 && menus.selected == 1 && menus.active == 0);
    menus.on_key(Key::Right);
    verify(menus.depth() == 2 && menus.selected == 0);
    menus.on_key(Key::Down);
    verify(menus.selected == 1);
    menus.on_key(Key::Left);
    verify(menus.depth() == 1 && menus.selected == 1);
    menus.on_key(Key::Left);
    verify(menus.depth() == 0 && menus.selected == 1);
    menus.on_key(Key::Enter);
    menus.on_key(Key::Enter);
    verify(menus.depth() == 2);
    verify(menus.on_key(Key::Enter) == 42);
    verify(menus.active == -1 && menus.depth() == 0);
    menus.open(0);
    menus.on_key(Key::Down);
    menus.on_key(Key::Right);
    menus.on_key(Key::Right);
    var focus: PaneFocus = PaneFocus::new(30);
    focus.set_menu_active(menus.active >= 0);
    menus.on_key(Key::Escape);
    focus.set_menu_active(menus.active >= 0);
    verify(menus.active == -1 && menus.selected == -1 && menus.depth() == 0);
    verify(focus.is_active(30));
    menus.open(0);
    verify(menus.depth() == 0 && menus.selected == 0);
}

#[test]
fn tui_cascading_menu_geometry_and_layers() {
    var menus: MenuBar = cascade_menus();
    menus.open(0);
    menus.on_key(Key::Down);
    let bounds: Rect = Rect::new(0, 0, 80, 24);
    let root: Rect = menus.popup_rect(bounds);
    let theme: Theme = Theme::dark_blue();
    let surface: Surface = Surface::new(80, 24);
    surface.fill(bounds, Cell { glyph: 88, foreground: theme.foreground, background: theme.panel });
    menus.paint(surface, bounds, theme);
    let indicator: Cell = surface.cell(root.x + root.width - 3, root.y + 2);
    verify(indicator.glyph == 62);
    menus.on_key(Key::Right);
    let child: Rect = menus.popup_rect_at(bounds, 1);
    verify(child.x == root.x + root.width && child.y == root.y + 1);
    menus.on_key(Key::Right);
    let grandchild: Rect = menus.popup_rect_at(bounds, 2);
    verify(grandchild.x == child.x + child.width);
    surface.fill(bounds, Cell { glyph: 88, foreground: theme.foreground, background: theme.panel });
    menus.paint(surface, bounds, theme);
    let parent_corner: Cell = surface.cell(root.x, root.y);
    let child_corner: Cell = surface.cell(child.x, child.y);
    let top_corner: Cell = surface.cell(grandchild.x, grandchild.y);
    verify(parent_corner.glyph == 0x250C && child_corner.glyph == 0x250C && top_corner.glyph == 0x250C);
    let shadow: Cell = surface.cell(grandchild.x + grandchild.width, grandchild.y + 1);
    verify(shadow.glyph == 88 && shadow.foreground == darken(theme.foreground, theme.shadow_percent));
    menus.on_key(Key::Left);
    surface.fill(bounds, Cell { glyph: 88, foreground: theme.foreground, background: theme.panel });
    menus.paint(surface, bounds, theme);
    let restored: Cell = surface.cell(grandchild.x + grandchild.width, grandchild.y + 1);
    verify(restored.glyph == 88 && restored.foreground == theme.foreground);
    surface.release();
}

#[test]
fn tui_cascading_menu_edges_and_disabled_branches() {
    var menus: MenuBar = MenuBar::new([
        Menu { title: "Long heading", items: [] },
        Menu { title: "File", items: [MenuItem::submenu("Recent", [
            MenuItem { label: "Open", action: 1, enabled: true }
        ])] }
    ]);
    menus.open(1); menus.on_key(Key::Right);
    let bounds: Rect = Rect::new(0, 0, 32, 6);
    let parent: Rect = menus.popup_rect(bounds);
    let child: Rect = menus.popup_rect_at(bounds, 1);
    verify(child.x + child.width == parent.x); // flips to the left
    for width in 0..20 {
        for height in 0..8 {
            let small: Rect = Rect::new(3, 4, i32(width), i32(height));
            let popup: Rect = menus.popup_rect_at(small, 1);
            verify(popup.x >= small.x && popup.x + popup.width <= small.x + small.width);
            verify(popup.y >= small.y && popup.y + popup.height <= small.y + small.height);
        }
    }
    var disabled: MenuBar = MenuBar::new([Menu { title: "File", items: [
        MenuItem { label: "Unavailable", action: 0, enabled: false,
            children: [MenuItem { label: "Child", action: 1, enabled: true }] },
        MenuItem { label: "Enabled", action: 2, enabled: true }
    ] }]);
    disabled.open(0);
    verify(disabled.selected == 1);
    disabled.on_key(Key::Right);
    verify(disabled.depth() == 0);
}

#[test]
fn tui_menu_navigation_and_actions() {
    var menus: MenuBar = test_menus();
    verify(menus.active == -1);
    menus.on_key(Key::Toggle);
    verify(menus.active == 0 && menus.selected == 0);
    menus.on_key(Key::Down);
    verify(menus.selected == 2);
    menus.on_key(Key::Down);
    verify(menus.selected == 0);
    menus.on_key(Key::Up);
    verify(menus.selected == 2);
    verify(menus.on_key(Key::Enter) == 3);
    verify(menus.active == -1);
    menus.open(0);
    menus.on_key(Key::Right);
    verify(menus.active == 1 && menus.selected == 0);
    menus.on_key(Key::Left);
    verify(menus.active == 0);
    menus.on_key(Key::Escape);
    verify(menus.active == -1);
}

#[test]
fn tui_menu_layers_and_shadow() {
    let theme: Theme = Theme::dark_blue();
    let surface: Surface = Surface::new(30, 10);
    var menus: MenuBar = test_menus();
    let bounds: Rect = surface.bounds();
    let viewport: Viewport = menus.viewport(bounds);
    let content_before: Rect = viewport.content();
    surface.fill(bounds, Cell { glyph: 88, foreground: theme.foreground, background: theme.panel });
    menus.open(0);
    let popup: Rect = menus.popup_rect(bounds);
    menus.paint(surface, bounds, theme);
    let corner: Cell = surface.cell(popup.x, popup.y);
    verify(corner.glyph == 0x250C);
    let shadow: Cell = surface.cell(popup.x + popup.width, popup.y + 1);
    verify(shadow.glyph == 88);
    verify(shadow.foreground == darken(theme.foreground, theme.shadow_percent));
    verify(shadow.background == darken(theme.panel, theme.shadow_percent));
    let outside: Cell = surface.cell(29, 9);
    verify(outside.glyph == 88 && outside.foreground == theme.foreground);
    let bar: Cell = surface.cell(29, 0);
    verify(bar.background == theme.menu_background);
    // Repaint from application state to remove overlay and shadow on dismissal.
    menus.dismiss();
    surface.fill(bounds, Cell { glyph: 88, foreground: theme.foreground, background: theme.panel });
    menus.paint(surface, bounds, theme);
    let restored: Cell = surface.cell(popup.x + popup.width, popup.y + 1);
    verify(restored.glyph == 88 && restored.foreground == theme.foreground);
    let after: Viewport = menus.viewport(bounds);
    let content_after: Rect = after.content();
    verify(content_before.y == content_after.y && content_before.height == content_after.height);
    surface.release();
}

#[test]
fn tui_small_and_empty_viewports() {
    var empty: MenuBar = MenuBar::new([]);
    let viewport: Viewport = empty.viewport(Rect::new(4, 5, 7, 8));
    let content: Rect = viewport.content();
    verify(content.y == 5 && content.height == 8);
    verify(empty.on_key(Key::Toggle) == 0 && empty.active == -1);
    let layout: Layout = Layout { axis: Axis::Vertical, gap: 2,
        sizes: [Size::fixed(8), Size::flex(1), Size::fixed(5)] };
    for height in 0..8 {
        let area: Rect = Rect::new(0, 0, 3, i32(height));
        let parts: list<Rect> = layout.split(area);
        for part in parts { verify(part.y >= 0 && part.y + part.height <= height); }
    }
    var menus: MenuBar = test_menus();
    menus.open(1);
    let theme: Theme = Theme::dark_blue();
    for width in 0..8 {
        let surface: Surface = Surface::new(i32(width), 2);
        let area: Rect = surface.bounds();
        menus.paint(surface, area, theme);
        let popup: Rect = menus.popup_rect(area);
        verify(popup.x >= 0 && popup.x + popup.width <= width);
        surface.release();
    }
}

#[test]
fn tui_unicode_clipping_and_boxes() {
    let surface: Surface = Surface::new(8, 4);
    let theme: Theme = Theme::dark_blue();
    let panel: Panel = Panel { title: "" };
    panel.paint(surface, surface.bounds(), theme);
    let corner: Cell = surface.cell(0, 0);
    verify(corner.glyph == 0x250C);
    surface.text(Rect::new(1, 1, 3, 1), "é─AB", theme.foreground, theme.panel);
    let latin: Cell = surface.cell(1, 1);
    let box: Cell = surface.cell(2, 1);
    let end: Cell = surface.cell(3, 1);
    let untouched: Cell = surface.cell(4, 1);
    verify(latin.glyph == 233 && box.glyph == 0x2500 && end.glyph == 65);
    verify(untouched.glyph == 32);
    surface.text(Rect::new(1, 2, 3, 1), "\x1b界Z", theme.foreground, theme.panel);
    let control: Cell = surface.cell(1, 2);
    verify(control.glyph == 63);
    let snapshot: str8 = surface.encode(false);
    verify(len(snapshot) > 32);
    free(snapshot);
    surface.release();
}
mod tui_demo::sample_editor;
mod tui_demo::piano_dialog;
use tui_demo::sample_editor::*;
use tui_demo::piano_dialog::*;

fn test_clip(frames: i64, value: f32) -> AudioClip {
    var samples: list<f32> = [];
    for i in 0..frames { samples.push(value * f32(i + 1) / f32(frames)); }
    let made: result<AudioClip, str8> = AudioClip::from_pcm("edit-test.wav", samples, 1, 8000, 120);
    return made.unwrap();
}

#[test]
fn tui_sample_edit_primitives() {
    let pcm: list<f32> = [0.1f, -0.1f, 0.2f, -0.2f, 0.3f, -0.3f, 0.4f, -0.4f];
    let cropped: list<f32> = pcm_crop(pcm, 2, 1, 3);
    verify(cropped.len() == 4 && cropped[0] == 0.2f && cropped[3] == -0.3f);
    let deleted: list<f32> = pcm_delete(pcm, 2, 1, 3);
    verify(deleted.len() == 4 && deleted[2] == 0.4f && deleted[3] == -0.4f);
    // Channel order within a frame survives reversing a range.
    let reversed: list<f32> = pcm_reverse(pcm, 2, 0, 2);
    verify(reversed[0] == 0.2f && reversed[1] == -0.2f && reversed[2] == 0.1f && reversed[6] == 0.4f);
    let faded_in: list<f32> = pcm_scale(pcm, 2, 0, 4, 1.0f, 1);
    verify(faded_in[0] == 0.0f && faded_in[7] == -0.4f);
    let faded_out: list<f32> = pcm_scale(pcm, 2, 0, 4, 1.0f, 2);
    verify(faded_out[0] == 0.1f && faded_out[6] == 0.0f);
    // Gain hard-clips so sessions (which require -1..1) can always be saved.
    let loud: list<f32> = pcm_scale(pcm, 2, 0, 4, 4.0f, 0);
    verify(loud[6] == 1.0f && loud[7] == -1.0f && loud[0] == 0.4f);
    verify(pcm_peak(pcm, 2, 0, 4) == 0.4f && pcm_peak(pcm, 2, 0, 1) == 0.1f);
    // Out-of-range frames clamp instead of failing.
    let clamped: list<f32> = pcm_crop(pcm, 2, -5, 99); verify(clamped.len() == 8);
}

#[test]
fn tui_sample_editor_edits_undo_and_limits() {
    let source: AudioClip = test_clip(4000, 0.5f);
    var editor: SampleEditor = SampleEditor {};
    editor.open(source, 0);
    verify(editor.active && !editor.modified);
    verify(!editor.edit(116)); // crop needs a narrower selection
    verify(!editor.edit(120)); // cannot delete everything
    verify(editor.edit(110));  // normalize whole sample
    verify(editor.modified && editor.clip.frames == 4000 && editor.clip.samples[3999] == 1.0f);
    verify(source.samples[3999] == 0.5f); // the session copy is untouched
    editor.view.sel_start = 1000; editor.view.sel_end = 3000;
    verify(editor.edit(116));
    verify(editor.clip.frames == 2000 && editor.clip.peaks.len() == (2000 + editor.clip.frames_per_row - 1) / editor.clip.frames_per_row);
    verify(editor.clip.detail_peaks.len() == editor.clip.peaks.len() * 4);
    editor.view.sel_start = 0; editor.view.sel_end = 500;
    verify(editor.edit(115));
    verify(editor.clip.samples[10] == 0.0f && editor.clip.samples[600] != 0.0f);
    verify(editor.edit(117) && editor.clip.samples[10] != 0.0f); // undo silence
    verify(editor.edit(117) && editor.clip.frames == 4000);     // undo crop
    verify(editor.edit(117) && !editor.modified);                // undo normalize
    verify(!editor.edit(117));
    // Undo depth is bounded.
    for _i in 0..20 { editor.edit(45); }
    verify(editor.history.len() == 16);
    let taken: AudioClip = editor.take();
    verify(!editor.active && taken.frames == 4000);
    taken.release(); source.release();
}

#[test]
fn tui_replace_sample_updates_all_placements() {
    var library: PatternLibrary = PatternLibrary::new();
    let area: Rect = Rect::new(0, 0, 120, 20);
    library.table.create_track_kind(false, true, area);
    let clip: AudioClip = test_clip(8000, 0.25f);
    library.audio.samples.push(clip);
    library.audio.view.items.push(ListItem { id: 1, label: clone("1 edit-test.wav") });
    library.table.selected_row = 2;
    verify(library.table.insert_audio(clip, area));
    library.table.selected_row = 20;
    verify(library.table.insert_audio(clip, area));
    var editor: SampleEditor = SampleEditor {};
    let stored_clip: AudioClip = library.audio.samples[0]; editor.open(stored_clip, 0);
    editor.view.sel_start = 0; editor.view.sel_end = 3000;
    verify(editor.edit(116));
    verify(library.replace_sample(0, editor.take()) == 2);
    let track: SequenceTrack = library.table.tracks[library.table.tracks.len() - 1];
    let first: AudioInstance = track.instances[0]; let second: AudioInstance = track.instances[1];
    verify(first.clip.frames == 3000 && second.clip.frames == 3000 && first.length_ticks == 0);
    let stored: AudioClip = library.audio.samples[0]; verify(stored.frames == 3000);
    // The edited session still round-trips: placements resolve to the sample.
    let directory: str8 = clone("/private/tmp/mlacker-edit-test-XXXXXX"); mkdtemp(directory);
    let path: str8 = format!("{}/edited.mlack", directory);
    var audio: AudioSystem = AudioSystem {}; var codec: SessionCodec = SessionCodec {};
    verify(codec.save(path, library, SessionView {}, audio));
    let loaded: result<SessionData, str8> = SessionCodec::load(path); verify(loaded.is_ok());
    var restored: SessionData = loaded.unwrap();
    let sample: AudioClip = restored.library.audio.samples[0]; verify(sample.frames == 3000);
    restored.release();
    let spare: AudioClip = test_clip(10, 0.1f); verify(library.replace_sample(5, spare) == -1);
    library.release(); std::fs::remove_tree(directory); free(path); free(directory);
}

#[test]
fn tui_audio_library_add_clip_reuses_identical_samples() {
    var audio: AudioLibrary = AudioLibrary {};
    verify(audio.add_clip(test_clip(100, 0.5f)) == 0);
    verify(audio.add_clip(test_clip(100, 0.5f)) == 0);
    verify(audio.add_clip(test_clip(100, 0.25f)) == 1);
    verify(audio.samples.len() == 2 && audio.view.items.len() == 2);
    audio.release();
}

#[test]
fn tui_piano_dialog_picks_pad_keys() {
    verify(piano_note_name(60) == "C-4" && piano_note_name(37) == "C#2");
    verify(piano_is_black(37) && !piano_is_black(36) && !piano_is_black(40) && piano_is_black(46));
    var piano: PianoDialog = PianoDialog::new();
    // Pads 1 and 2 loaded: the cursor starts on the first empty pad.
    piano.open("Pick", 36, 16, 3, [clone("kick.wav"), clone("snare.wav")], "inserts");
    verify(piano.active && piano.key == 38 && piano.pad() == 2);
    verify(piano.is_loaded(0) && piano.is_loaded(1) && !piano.is_loaded(2));
    piano.on_event(InputEvent { kind: InputKind::Menu, key: Key::Left, code: 104 });
    piano.on_event(InputEvent { kind: InputKind::Menu, key: Key::Left, code: 104 });
    piano.on_event(InputEvent { kind: InputKind::Menu, key: Key::Left, code: 104 });
    verify(piano.key == 36); // clamped to the pad range
    piano.on_event(InputEvent { kind: InputKind::Menu, key: Key::Up, code: 107 });
    verify(piano.key == 48);
    piano.on_event(InputEvent { kind: InputKind::Menu, key: Key::Up, code: 107 });
    verify(piano.key == 51);
    // Delete only clears a loaded pad.
    piano.on_event(InputEvent { kind: InputKind::Edit, key: Key::Delete });
    verify(piano.active);
    piano.on_event(InputEvent { kind: InputKind::Menu, key: Key::Down, code: 106 });
    piano.on_event(InputEvent { kind: InputKind::Menu, key: Key::Down, code: 106 });
    verify(piano.key == 36);
    piano.on_event(InputEvent { kind: InputKind::Edit, key: Key::Delete });
    verify(!piano.active && piano.result == 3 && piano.pad() == 0);
    piano.open("Pick", 36, 16, 0, [], "inserts");
    piano.on_event(InputEvent { kind: InputKind::Menu, key: Key::Right, code: 108 });
    piano.on_event(InputEvent { kind: InputKind::Menu, key: Key::Enter, code: 13 });
    verify(!piano.active && piano.result == 1 && piano.pad() == 1);
    // The keyboard paints: selected key darker gray, dots on loaded pads.
    piano.open("Pick", 36, 16, 1, [clone("kick.wav")], "inserts");
    let surface: Surface = Surface::new(100, 30);
    piano.paint(surface, surface.bounds(), Theme::dark_blue());
    var selected: i32 = 0; var dots: i32 = 0; var black: i32 = 0;
    for y in 0..30 { for x in 0..100 {
        let cell: Cell = surface.cell(i32(x), i32(y));
        if cell.background == 0x5f5f5f { selected = selected + 1; }
        if cell.glyph == 0x25cf { dots = dots + 1; }
        if cell.background == 0x0c0c0c { black = black + 1; }
    } }
    // Cursor on the first empty pad, C#2: a 2x2 black key.
    verify(selected == 4 && dots == 1 && black > 0);
    piano.on_event(InputEvent { kind: InputKind::Menu, key: Key::Left, code: 104 });
    piano.paint(surface, surface.bounds(), Theme::dark_blue());
    selected = 0;
    for y in 0..30 { for x in 0..100 { let cell: Cell = surface.cell(i32(x), i32(y)); if cell.background == 0x5f5f5f { selected = selected + 1; } } }
    verify(selected == 10); // C-2: a 3x4 white key minus the C# key over its top-right corner
    surface.release(); piano.release();
}

#[test]
fn tui_piano_dialog_black_keys_sit_between_their_notes() {
    var piano: PianoDialog = PianoDialog::new();
    // Pads 1-15 loaded, so the cursor sits on pad 16 (D#3) outside the first octave.
    piano.open("Pick", 36, 16, 32767, [], "inserts");
    verify(piano.key == 51);
    let surface: Surface = Surface::new(100, 30);
    piano.paint(surface, surface.bounds(), Theme::dark_blue());
    // Top row of the keyboard: the first row holding an in-range white key.
    var top: i32 = -1; var left: i32 = -1;
    for y in 0..30 {
        for x in 0..100 {
            let cell: Cell = surface.cell(i32(x), i32(y));
            if cell.background == 0xf2f2f2 && top < 0 { top = i32(y); left = i32(x); }
        }
    }
    verify(top >= 0);
    // One octave from C-2, three columns per white key: C# over C|D, D# over
    // D|E, no key over E|F, then F#, G#, A# over their boundaries.
    var row: str8 = clone("");
    for col in 0..21 {
        let cell: Cell = surface.cell(left + i32(col), top);
        let next: str8 = format!("{}{}", row, cell.background == 0x0c0c0c ? "B" : "W");
        free(row); row = next;
    }
    verify(row == "WWBBWBBWWWWBBWBBWBBWW");
    // The lower half is all white keys; separators start each key.
    let separator: Cell = surface.cell(left + 3, top + 3);
    verify(separator.glyph == 0x2502 && separator.background == 0xf2f2f2);
    let label: Cell = surface.cell(left, top + 4);
    verify(label.glyph == 67); // "C-2" under the C key
    free(row); surface.release(); piano.release();
}

#[test]
fn tui_input_menu_and_pane_keys() {
    // F1 opens the menu bar (SS3 and CSI spellings); Tab is left for panes.
    let ss3: InputEvent = decode_input("\x1bOP");
    verify(ss3.kind == InputKind::Menu && ss3.key == Key::Function1);
    let csi: InputEvent = decode_input("\x1b[11~");
    verify(csi.kind == InputKind::Menu && csi.key == Key::Function1);
    let tab: InputEvent = decode_input("\t");
    verify(tab.kind == InputKind::Menu && tab.key == Key::Toggle && tab.modifiers == 1);
    // Shift+Tab cycles panes backwards.
    let back: InputEvent = decode_input("\x1b[Z");
    verify(back.kind == InputKind::Menu && back.key == Key::Toggle && back.modifiers == 2);
    verify(back.code == 9);
}

#[test]
fn tui_input_shift_tab_spellings() {
    // Every spelling a terminal may use for Shift+Tab reaches pane cycling.
    let csi_z: InputEvent = decode_input("\x1b[Z");
    verify(csi_z.kind == InputKind::Menu && csi_z.key == Key::Toggle && csi_z.modifiers == 2);
    // kitty keyboard protocol: modified Tab as CSI 9;2u.
    let kitty: InputEvent = decode_input("\x1b[9;2u");
    verify(kitty.kind == InputKind::Menu && kitty.key == Key::Toggle && kitty.modifiers == 2 && kitty.code == 9);
    // modifyOtherKeys: CSI 27;2;9~.
    let other: InputEvent = decode_input("\x1b[27;2;9~");
    verify(other.kind == InputKind::Menu && other.key == Key::Toggle && other.modifiers == 2);
    // Plain Tab still cycles forwards, and Ctrl+Tab is not pane navigation.
    let plain: InputEvent = decode_input("\t");
    verify(plain.kind == InputKind::Menu && plain.key == Key::Toggle && plain.modifiers == 1);
    let ctrl: InputEvent = decode_input("\x1b[9;5u");
    verify(ctrl.kind == InputKind::None);
}

#[test]
fn tui_input_shift_backspace() {
    // Shift+Backspace removes a library item; it must not decode as text.
    let kitty: InputEvent = decode_input("\x1b[127;2u");
    verify(kitty.kind == InputKind::Edit && kitty.key == Key::Backspace && kitty.modifiers == 2);
    let other: InputEvent = decode_input("\x1b[27;2;127~");
    verify(other.kind == InputKind::Edit && other.key == Key::Backspace && other.modifiers == 2);
    // Plain Backspace still edits, and Shift+letter is still text.
    let plain: InputEvent = decode_input("\x7f");
    verify(plain.kind == InputKind::Edit && plain.key == Key::Backspace && plain.modifiers == 1);
    let letter: InputEvent = decode_input("\x1b[97;2u");
    verify(letter.kind == InputKind::Text && letter.code == 97);
}

#[test]
fn tui_remove_sample_drops_its_clips() {
    var library: PatternLibrary = PatternLibrary::new();
    let area: Rect = Rect::new(0, 0, 120, 20);
    library.table.create_track_kind(false, true, area);
    let kick: AudioClip = test_clip(4000, 0.25f);
    let snare: AudioClip = test_clip(2000, 0.5f);
    library.audio.samples.push(kick);
    library.audio.view.items.push(ListItem { id: 1, label: clone("1 edit-test.wav") });
    verify(library.audio.add_clip(snare.copy()) == 1);
    library.table.selected_row = 0;
    verify(library.table.insert_audio(kick, area));
    library.table.selected_row = 12;
    verify(library.table.insert_audio(kick, area));
    verify(library.sample_usage(0) == 2 && library.sample_usage(1) == 0);
    // Removing the sample takes its placements with it and renumbers the list.
    verify(library.remove_sample(0, area) == 2);
    verify(library.audio.samples.len() == 1 && library.audio.view.items.len() == 1);
    let remaining: AudioClip = library.audio.samples[0];
    verify(remaining.frames == 2000);
    let track: SequenceTrack = library.table.tracks[library.table.tracks.len() - 1];
    verify(track.instances.len() == 0);
    verify(library.remove_sample(5, area) == -1);
    snare.release(); library.release();
}

#[test]
fn tui_remove_instrument_tracks_or_keep_them() {
    var library: PatternLibrary = PatternLibrary::new();
    let area: Rect = Rect::new(0, 0, 120, 20);
    library.table.create_instrument_track(1, area);
    library.table.create_instrument_track(1, area);
    library.table.create_instrument_track(2, area);
    verify(library.instrument_usage(1) == 2 && library.instrument_usage(2) == 1);
    let before: i64 = library.table.tracks.len();
    // Keeping the tracks only clears their assignment.
    library.table.detach_instrument(2);
    verify(library.instrument_usage(2) == 0 && library.table.tracks.len() == before);
    // Removing takes the tracks that played it.
    verify(library.remove_tracks_using_instrument(1, area) == 2);
    verify(library.instrument_usage(1) == 0 && library.table.tracks.len() == before - 2);
    library.release();
}

fn song_test_library() -> PatternLibrary {
    // Two patterns that both play instrument 1 with the same notes, and two
    // song rows to place them in.
    var library: PatternLibrary = PatternLibrary::empty();
    let area: Rect = Rect::new(0, 0, 120, 20);
    library.table.create_instrument_track(1, area);
    library.table.set_cell(0, 1, clone("C-2")); library.table.set_cell(0, 2, clone("100"));
    library.table.set_cell(4, 1, clone("D-2")); library.table.set_cell(4, 2, clone("100"));
    library.add(true);                       // clone -> pattern 2, song row 1
    library.matrix_insert_row(0, true);       // a second song row
    library.set_song_at(0, 0, 1); library.set_song_at(1, 0, 2);
    return library;
}

#[test]
fn tui_song_matrix_lanes_and_rows() {
    var library: PatternLibrary = song_test_library();
    let area: Rect = Rect::new(0, 0, 120, 20);
    verify(library.song.len() == 2 && library.song_lanes() == 1);
    verify(library.song_at(0, 0) == 1 && library.song_at(1, 0) == 2);
    // Lane 2 of row 0 runs parallel to lane 1.
    verify(library.set_song_at(0, 1, 2));
    verify(library.song_lanes() == 2 && library.song_at(0, 1) == 2 && library.song_at(1, 1) == 0);
    // Any cell can be emptied, lane 1 included; unused lanes disappear.
    verify(library.set_song_at(0, 0, 0) && library.song_at(0, 0) == 0);
    verify(library.set_song_at(0, 0, 1));
    verify(library.set_song_at(0, 1, 0) && library.song_lanes() == 1);
    // Inserting a song row keeps the lanes aligned with it.
    verify(library.set_song_at(1, 1, 2));
    verify(library.matrix_insert_row(0, true));
    verify(library.song.len() == 3 && library.song_at(2, 1) == 2 && library.song_at(1, 1) == 0);
    // Out-of-range cells are refused, and lane 16 does not exist.
    verify(!library.set_song_at(9, 1, 2) && !library.set_song_at(0, 16, 2));
    library.release();
}

#[test]
fn tui_song_matrix_detects_note_clashes() {
    var library: PatternLibrary = song_test_library();
    // The clone shares instrument 1 and both notes.
    verify(library.clashing_notes(1, 2) == 2);
    verify(library.song_row_clashes(0, 1, 2) == 2);
    // A pattern never clashes with itself, and an empty row is quiet.
    verify(library.clashing_notes(1, 1) == 0);
    verify(library.song_row_clashes(1, 1, 1) == 0 || library.song_at(1, 0) == 2);
    library.release();
}

#[test]
fn tui_song_matrix_split_moves_notes_to_their_own_line() {
    var library: PatternLibrary = song_test_library();
    let area: Rect = Rect::new(0, 0, 120, 20);
    verify(library.set_song_at(0, 1, 2));
    // Splitting the newcomer gives its clashing track its own note line.
    verify(library.split_song_clashes(0, 1, 2, area) == 1);
    let entry: PatternEntry = library.patterns[library.index_of(2)];
    let index: i32 = i32(entry.data.tracks.len()) - 1;
    let track: SequenceTrack = entry.data.tracks[index];
    verify(track.note_lines == 2);
    verify(ends_with(track.name, " - 2") == 1);
    // The notes moved off the first line, so the two patterns no longer drive
    // the instrument through the same one.
    let row: TableRow = entry.data.rows[0];
    let start: i32 = entry.data.track_start(index);
    verify(row.cells[start] == "" && row.cells[start + 4] == "C-2" && row.cells[start + 5] == "100");
    // Splitting again renames to " - 3" rather than stacking suffixes.
    verify(library.set_song_at(0, 2, 2));
    library.split_song_clashes(0, 2, 2, area);
    let again: PatternEntry = library.patterns[library.index_of(2)];
    let renamed: SequenceTrack = again.data.tracks[index];
    verify(ends_with(renamed.name, " - 3") == 1 && !ends_with(renamed.name, "2 - 3"));
    library.release();
}

#[test]
fn tui_song_matrix_survives_a_session_round_trip() {
    // Plain patterns: an instrument assignment would need a loaded plugin.
    var library: PatternLibrary = PatternLibrary::empty();
    let area: Rect = Rect::new(0, 0, 120, 20);
    library.table.create_track_kind(false, false, area);
    library.add(true);
    library.matrix_insert_row(0, true);
    verify(library.song.len() == 2);
    verify(library.set_song_at(0, 1, 1) && library.set_song_at(1, 2, 2));
    verify(library.song_lanes() == 3);
    let directory: str8 = clone("/private/tmp/mlacker-matrix-test-XXXXXX"); mkdtemp(directory);
    let path: str8 = format!("{}/matrix.mlack", directory);
    var audio: AudioSystem = AudioSystem {}; var codec: SessionCodec = SessionCodec {};
    verify(codec.save(path, library, SessionView {}, audio));
    let loaded: result<SessionData, str8> = SessionCodec::load(path); verify(loaded.is_ok());
    var restored: SessionData = loaded.unwrap();
    verify(restored.library.song_lanes() == 3);
    verify(restored.library.song_at(0, 1) == 1 && restored.library.song_at(1, 2) == 2);
    verify(restored.library.song_at(1, 1) == 0 && restored.library.song_at(0, 2) == 0);
    restored.release();
    library.release(); std::fs::remove_tree(directory); free(path); free(directory);
}

mod tui_demo::song_matrix;
use tui_demo::song_matrix::SongMatrix;

#[test]
fn tui_song_matrix_keys() {
    var matrix: SongMatrix = SongMatrix { visible: true };
    // Navigation is clamped to the grid; lane 3 is the spare empty one.
    verify(matrix.on_event(decode_input("j"), 2, 3) == 0 && matrix.row == 1);
    verify(matrix.on_event(decode_input("j"), 2, 3) == 0 && matrix.row == 1);
    verify(matrix.on_event(decode_input("l"), 2, 3) == 0 && matrix.lane == 1);
    verify(matrix.on_event(decode_input("k"), 2, 3) == 0 && matrix.row == 0);
    verify(matrix.on_event(decode_input("h"), 2, 3) == 0 && matrix.lane == 0);
    // Enter picks a pattern, Backspace clears the cell.
    verify(matrix.on_event(decode_input("\r"), 2, 3) == 1);
    verify(matrix.on_event(decode_input("\x7f"), 2, 3) == 2);
    // o/O insert whole rows; Ctrl+O/Ctrl+Shift+O shift this lane only.
    verify(matrix.on_event(decode_input("o"), 2, 3) == 3);
    verify(matrix.on_event(decode_input("O"), 2, 3) == 4);
    verify(matrix.on_event(decode_input("\x1b[111;5u"), 2, 3) == 5);
    verify(matrix.on_event(decode_input("\x1b[79;5u"), 2, 3) == 6);
    // y copies, p pastes.
    verify(matrix.on_event(decode_input("y"), 2, 3) == 8);
    verify(matrix.on_event(decode_input("p"), 2, 3) == 9);
    // dd removes a row: the first d only arms the chord.
    verify(matrix.on_event(decode_input("d"), 2, 3) == 0 && matrix.delete_pending);
    verify(matrix.on_event(decode_input("d"), 2, 3) == 7 && !matrix.delete_pending);
    // Any other key cancels a pending d.
    verify(matrix.on_event(decode_input("d"), 2, 3) == 0);
    verify(matrix.on_event(decode_input("j"), 2, 3) == 0 && !matrix.delete_pending);
    verify(matrix.on_event(decode_input("d"), 2, 3) == 0 && matrix.delete_pending);
}

#[test]
fn tui_pattern_view_shows_instrument_under_track_name() {
    var table: SequenceTable = SequenceTable::new();
    let area: Rect = Rect::new(0, 0, 120, 20);
    let plain: i32 = table.header_height();
    // A MIDI-only pattern keeps the two-line header.
    table.instrument_labels(AudioController {});
    verify(!table.group_subtitles && table.header_height() == plain);
    // An instrument track adds the line, showing the slot number.
    table.create_instrument_track(0, area);
    table.instrument_labels(AudioController {});
    verify(table.group_subtitles && table.header_height() == plain + 1);
    let group: TableGroup = table.groups[table.groups.len() - 1];
    verify(group.subtitle == "- unassigned -");
    table.assign_instrument(7);
    table.instrument_labels(AudioController {});
    let assigned: TableGroup = table.groups[table.groups.len() - 1];
    verify(starts_with(assigned.subtitle, "007 ") == 1);
    // Tracks that play no instrument keep an empty line under their name.
    let first: TableGroup = table.groups[0];
    verify(first.subtitle == "");
    table.release();
}

#[test]
fn tui_song_matrix_merges_a_row_for_playback() {
    var library: PatternLibrary = song_test_library();
    let area: Rect = Rect::new(0, 0, 120, 20);
    // Row 0 holds pattern 1; add pattern 2 beside it.
    verify(library.set_song_at(0, 1, 2));
    let one: PatternEntry = library.patterns[library.index_of(1)];
    let tracks: i64 = one.data.tracks.len();
    var merged: SequenceTable = library.merge_song_row(0, area);
    // Both patterns' tracks play together.
    verify(merged.tracks.len() == tracks * 2);
    let appended: SequenceTrack = merged.tracks[merged.tracks.len() - 1];
    verify(appended.instrument && appended.instrument_id == 1);
    // The appended notes came across.
    let row: TableRow = merged.rows[0];
    let start: i32 = merged.track_start(i32(merged.tracks.len()) - 1);
    verify(row.cells[start] == "C-2" && row.cells[start + 1] == "100");
    merged.release();
    // An empty row merges to an empty table, and playback skips it.
    verify(library.matrix_insert_row(0, false));
    var blank: SequenceTable = library.merge_song_row(0, area);
    verify(blank.rows.len() == 0);
    blank.release();
    // next_song_row skips empty rows and wraps.
    verify(library.next_song_row(0) == 1);
    verify(library.next_song_row(i32(library.song.len()) - 1) == 1);
    library.release();
}

#[test]
fn tui_song_matrix_marks_the_playing_row() {
    var library: PatternLibrary = song_test_library();
    var matrix: SongMatrix = SongMatrix { visible: true };
    let bounds: Rect = Rect::new(0, 0, 60, 12);
    let theme: Theme = Theme::dark_blue();
    let surface: Surface = Surface::new(60, 12);
    matrix.paint(surface, bounds, theme, library, true, 1);
    // Row 2 plays: its cells sit brighter than the idle row above.
    var playing_bg: i32 = 0; var idle_bg: i32 = 0;
    for y in 0..12 {
        // Lane 2, away from the cursor cell in lane 1.
        let cell: Cell = surface.cell(20, i32(y));
        let tens: Cell = surface.cell(1, i32(y));
        let ones: Cell = surface.cell(3, i32(y));
        if tens.glyph == 48 && ones.glyph == 50 { playing_bg = cell.background; }
        if tens.glyph == 48 && ones.glyph == 49 { idle_bg = cell.background; }
    }
    verify(playing_bg != 0 && idle_bg != 0 && playing_bg != idle_bg);
    verify(playing_bg == lighten(theme.panel, 36) && idle_bg == theme.panel);
    surface.release(); library.release();
}
