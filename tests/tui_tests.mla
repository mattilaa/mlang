#[test]
fn tui_samples_reach_master() {
    var table: SequenceTable = SequenceTable::new();
    let area: Rect = Rect::new(0, 0, 120, 20);
    table.create_track_kind(false, true, area);
    var clip: AudioClip = AudioClip { source: clone("embedded.wav"), channels: 2, sample_rate: 8000, frames: 4000, frames_per_row: 1000 };
    for _i in 0..4000 { clip.samples.push(0.5f); clip.samples.push(0.25f); }
    for _i in 0..4 { clip.peaks.push(WavePeak { left: 500, right: 250 }); }
    table.selected_row = 1; verify_eq(true, table.insert_audio(clip, area));
    let opened: result<AudioController, str8> = AudioController::new(8000, 128);
    var audio: AudioSystem = AudioSystem {}; audio.output = opened.unwrap();
    let allocated: result<PcmBlock, str8> = PcmBlock::new(1024); let block: PcmBlock = allocated.unwrap();
    audio.sync_volumes(table);
    verify_eq(true, audio.sample_playback(table, 0, true, 120));
    verify(audio.output.process(block, 1024) == 0); verify(audio.output.master_peak(0) == 0);
    verify(audio.sample_playback(table, 15000, true, 120));
    verify(audio.output.process(block, 1024) == 0);
    verify_eq_i32(125, audio.output.master_peak(0)); verify_eq_i32(63, audio.output.master_peak(1));
    verify(audio.sample_playback(table, 16000, false, 120));
    audio.output.process(block, 1024); verify_eq(0.0f, block.left(1023));
    // Starting inside a placed sample seeks into embedded PCM, without reading its path.
    verify(audio.sample_playback(table, 45000, true, 120));
    audio.output.process(block, 1024); verify_eq(0.125f, block.left(100));
    audio.output.process(block, 1024); verify_eq(0.0f, block.left(1023));
    verify(audio.sample_playback(table, 45000, false, 120));
    // Explicit source-frame offset and duration are enforced by the audio renderer.
    verify(audio.output.play_sample(0, 3, 3990, 5) == 0);
    audio.output.process(block, 1024); verify_eq(true, block.left(1) > 0.0f); verify_eq(0.0f, block.left(5));
    // Every audio track contributes, not just the selected one.
    table.create_track_kind(false, true, area);
    table.selected_row = 1; verify(table.insert_audio(clip, area));
    audio.sync_volumes(table);
    verify(audio.sample_playback(table, 15000, true, 120));
    audio.output.process(block, 1024);
    verify_eq_i32(250, audio.output.master_peak(0)); verify_eq_i32(125, audio.output.master_peak(1));
    verify(audio.sample_playback(table, 16000, false, 120));
    block.close(); audio.release(); table.release(); clip.release();
}
extern fn mkdtemp(path: str8) -> str8;

#[test]
fn tui_session_roundtrip() {
    let directory: str8 = clone("/private/tmp/mlacker-session-test-XXXXXX"); mkdtemp(directory);
    let path: str8 = format!("{}/roundtrip.mlack", directory);
    var library: PatternLibrary = PatternLibrary::new();
    var audio: AudioSystem = AudioSystem {}; var codec: SessionCodec = SessionCodec {};
    let area: Rect = Rect::new(0, 0, 120, 20);
    library.table.track_action(80, area);
    library.table.create_track_kind(false, true, area);
    var clip: AudioClip = AudioClip { source: clone("embedded-test.wav"), channels: 1, sample_rate: 8000, frames: 80, frames_per_row: 10 };
    for _i in 0..80 { clip.samples.push(0.5f); }
    for _i in 0..8 { clip.peaks.push(WavePeak { left: 500, right: 500, left_body: 500, right_body: 500 }); }
    for _i in 0..32 { clip.detail_peaks.push(WavePeak { left: 500, right: 500 }); }
    library.audio.samples.push(clip); library.table.selected_row = 7;
    verify(library.table.insert_audio(clip, area));
    library.table.group_detail_rows = 4; library.table.selected_group_detail = 2;
    let view: SessionView = SessionView { bpm: 147, beats: 7, unit: 8, pane: 1, sidebar: 1, mixer: true, meter_fps: 120, sample_zoom: 4, row: 7 };
    verify(codec.save(path, library, view, audio));
    let loaded: result<SessionData, str8> = SessionCodec::load(path); verify(loaded.is_ok());
    var restored: SessionData = loaded.unwrap();
    verify(restored.library.table.group_detail_rows == 4 && restored.library.table.selected_group_detail == 2);
    verify(restored.view.bpm == 147 && restored.view.beats == 7 && restored.view.sample_zoom == 4 && restored.view.meter_fps == 120);
    verify(restored.library.patterns.len() == 3 && restored.library.song.len() == 4);
    verify(restored.library.table.tracks.len() == 4 && restored.library.table.selected_row == 7);
    let track: SequenceTrack = restored.library.table.tracks[3];
    let placement: AudioInstance = track.instances[0]; verify(placement.start_row == 7 && placement.clip.frames == 80);
    verify(placement.clip.samples[20] == 0.5f && restored.library.audio.samples.len() == 1);
    let midi: SequenceTrack = restored.library.table.tracks[0]; verify(midi.note_lines == 2);
    restored.release();
    // A rejected save must not truncate the previous valid session.
    verify(!codec.save(path, library, SessionView { bpm: 0 }, audio));
    let retained: result<SessionData, str8> = SessionCodec::load(path); verify(retained.is_ok());
    var valid: SessionData = retained.unwrap(); valid.release();
    library.release();
    let removed: result<i32, str8> = std::fs::remove_tree(directory); verify(removed.is_ok()); free(path); free(directory);
}

#[test]
fn tui_session_empty_and_bad_file() {
    var library: PatternLibrary = PatternLibrary::empty(); var audio: AudioSystem = AudioSystem {}; var codec: SessionCodec = SessionCodec {};
    verify(library.table.tracks.len() == 0 && library.song.len() == 0 && library.audio.samples.len() == 0);
    let directory: str8 = clone("/private/tmp/mlacker-empty-test-XXXXXX"); mkdtemp(directory);
    let path: str8 = format!("{}/empty.mlack", directory);
    verify(codec.save(path, library, SessionView {}, audio));
    let loaded: result<SessionData, str8> = SessionCodec::load(path); verify(loaded.is_ok());
    var restored: SessionData = loaded.unwrap(); verify(restored.library.table.tracks.len() == 0); restored.release();
    std::fs::write_all_text(path, "not a session file and deliberately too short or malformed");
    let invalid: result<SessionData, str8> = SessionCodec::load(path); verify(invalid.is_err());
    library.release(); std::fs::remove_tree(directory); free(path); free(directory);
}
