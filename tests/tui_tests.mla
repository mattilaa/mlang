fn slider_valid(slider: Slider, text: str8) -> bool { let value: result<f64, str8> = slider.parse(text); return value.is_ok(); }
fn slider_value(slider: Slider, text: str8) -> f64 { let value: result<f64, str8> = slider.parse(text); return value.unwrap(); }

#[test]
fn tui_slider_validation() {
    var slider: Slider = Slider::new("Velocity", 0.0, 127.0, 100.0, "i32");
    verify(slider_valid(slider, "0")); verify(slider_valid(slider, "127"));
    verify(!slider_valid(slider, "128")); verify(!slider_valid(slider, "-1"));
    verify(!slider_valid(slider, "1.5")); verify(!slider_valid(slider, "12x"));
    slider.value_type = "f64"; slider.maximum = 1.0;
    let quarter: f64 = slider_value(slider, "0.25"); verify(quarter > 0.249999 && quarter < 0.250001);
    let half: f64 = slider_value(slider, ".5"); verify(half > 0.499999 && half < 0.500001);
    verify(!slider_valid(slider, "NaN")); verify(!slider_valid(slider, "inf"));
    verify(!slider_valid(slider, "1e9")); verify(!slider_valid(slider, ""));
    slider.value_type = "str8"; verify(!slider_valid(slider, "0"));
    slider.value_type = "u32"; slider.maximum = 4294967296.0;
    verify(slider_valid(slider, "4294967295")); verify(!slider_valid(slider, "4294967296"));
    slider.minimum = 10.0; slider.maximum = 1.0; verify(!slider_valid(slider, "5"));
    slider.minimum = f64(-2147483649); slider.maximum = f64(2147483648); slider.value_type = "i32";
    verify(slider_valid(slider, "2147483647")); verify(!slider_valid(slider, "2147483648"));
    verify(slider_valid(slider, "-2147483648")); verify(!slider_valid(slider, "-2147483649"));
    slider.release();
}

#[test]
fn tui_slider_keyboard() {
    var slider: Slider = Slider::new("Mode", 0.0, 3.0, 2.0, "i32"); slider.step = 1.0;
    verify(slider.on_event(decode_input("J"))); verify(slider.value == 1.0);
    verify(slider.on_event(decode_input("K"))); verify(slider.value == 2.0);
    verify(slider.on_event(decode_input("\x1b[107;2u"))); verify(slider.value == 3.0);
    verify(!slider.on_event(decode_input("K"))); verify(slider.value == 3.0);
    slider.on_event(decode_input("\r")); verify(slider.editing);
    slider.editor.set_text("9"); verify(!slider.on_event(decode_input("\r")));
    verify(slider.editing && slider.value == 3.0 && slider.error != "");
    slider.editor.set_text("1"); verify(slider.on_event(decode_input("\r")));
    verify(!slider.editing && slider.value == 1.0);
    slider.read_only = true; verify(!slider.on_event(decode_input("K"))); verify(slider.value == 1.0);
    slider.on_event(decode_input("\r")); verify(!slider.editing);
    slider.release();
}

#[test]
fn tui_instrument_editor_navigation() {
    var editor: InstrumentEditor = InstrumentEditor { active: true };
    for i in 0..40 { editor.sliders.push(Slider::new("Parameter", 0.0, 1.0, 0.5, "f64")); }
    let area: Rect = Rect::new(0, 0, 54, 20);
    let output: AudioController = AudioController {};
    editor.on_event(decode_input("L"), output, area); verify(editor.selected == 0); verify(!editor.learning);
    editor.on_event(decode_input("\x1b[108;2u"), output, area); verify(editor.selected == 0); verify(!editor.learning);
    editor.on_event(decode_input("l"), output, area); verify(editor.selected == 4);
    editor.on_event(decode_input("j"), output, area); verify(editor.selected == 5);
    editor.on_event(decode_input("k"), output, area); verify(editor.selected == 4);
    editor.on_event(decode_input("h"), output, area); verify(editor.selected == 0);
    editor.selected = 39;
    let surface: Surface = Surface::new(54, 20);
    editor.paint(surface, area, Theme::dark_blue()); verify(editor.scroll > 0);
    editor.on_event(decode_input("\r"), output, area);
    editor.on_event(decode_input("h"), output, area); verify(editor.selected == 39);
    // Entered text stays in the slider, never reaching the pattern navigator.
    let selected: Slider = editor.sliders[39]; verify(selected.editing);
    surface.release(); editor.release();
}

#[test]
fn tui_midi_learn_filename() {
    let suggested: str8 = SessionCodec::learn_suggestion("Synth/A:B\\C\n");
    verify(suggested == "Synth_A_B_C_ - "); free(suggested);
}

#[test]
fn tui_aux_send_pattern_independence() {
    var library: PatternLibrary = PatternLibrary::new();
    let initial: SequenceTrack = library.table.tracks[0]; verify(initial.send_level(0) == 0);
    verify(!library.table.set_send(-1, 0, 50));
    verify(!library.table.set_send(0, 8, 50));
    verify(!library.table.set_send(0, 0, 101));
    verify(!library.table.set_send(0, 0, -1));
    verify(library.table.set_send(0, 0, 50));
    verify(library.table.set_send(0, 7, 100));
    library.add(true);
    let copied: SequenceTrack = library.table.tracks[0];
    verify(copied.send_level(0) == 50 && copied.send_level(7) == 100);
    verify(library.table.set_send(0, 0, 25));
    library.select(1);
    let original: SequenceTrack = library.table.tracks[0];
    verify(original.send_level(0) == 50 && original.send_level(7) == 100);
    library.select(2);
    let other: SequenceTrack = library.table.tracks[0]; verify(other.send_level(0) == 0);
    library.release();
}

#[test]
fn tui_pattern_insert_header() {
    var table: SequenceTable = SequenceTable::new(); let area: Rect = Rect::new(0, 0, 80, 16);
    let row: i32 = table.selected_row;
    table.insert_event(decode_input("f"), area); verify(table.header_height() == 6);
    verify(table.selected_group_detail == 0);
    table.insert_event(decode_input("j"), area); table.insert_event(decode_input("j"), area);
    table.insert_event(decode_input("j"), area); table.insert_event(decode_input("j"), area);
    verify(table.selected_group_detail == 3 && table.selected_row == row);
    table.insert_event(decode_input("l"), area); verify(table.active_track() == 1);
    verify(table.insert_event(decode_input("\r"), area) == 115);
    verify(table.insert_event(decode_input("\x7f"), area) == 116);
    table.set_insert(1, 3, 7);
    var copy: SequenceTable = table.copy_pattern();
    table.set_insert(1, 3, 0);
    let copied: SequenceTrack = copy.tracks[1]; verify(copied.insert_id(3) == 7);
    table.insert_labels(AudioController {});
    let surface: Surface = Surface::new(80, 16); table.paint(surface, area, Theme::dark_blue());
    let column: Cell = surface.cell(0, 5); verify(column.glyph == 82); // ROW below four inserts
    table.insert_event(decode_input("f"), area); verify(table.header_height() == 2 && table.selected_group_detail == -1);
    surface.release(); copy.release(); table.release();
}

#[test]
fn tui_mixer_fx_zoom() {
    var table: SequenceTable = SequenceTable::new();
    var mixer: Mixer = Mixer { effect_volumes: [100, 100, 100, 100] };
    verify(mixer.send_navigation(decode_input("z"), 0)); verify(mixer.expanded_track(0));
    verify_eq_i32(26, mixer.track_width(false, 0)); verify_eq_i32(6, mixer.track_width(false, 1));
    verify(mixer.send_navigation(decode_input("l"), 0)); verify(mixer.selected_send == 0);
    let track: SequenceTrack = table.tracks[0];
    verify_eq_i32(1, mixer.send_value(decode_input("K"), track));
    verify(table.set_send(0, 0, 100));
    let full: SequenceTrack = table.tracks[0]; verify_eq_i32(-1, mixer.send_value(decode_input("K"), full));
    let lower: SequenceTrack = table.tracks[0]; verify_eq_i32(99, mixer.send_value(decode_input("J"), lower));
    verify(mixer.send_navigation(decode_input("l"), 0));
    verify(mixer.send_navigation(decode_input("l"), 0));
    verify(mixer.send_navigation(decode_input("l"), 0)); verify(mixer.selected_send == 3);
    let surface: Surface = Surface::new(40, 12);
    mixer.paint(surface, Rect::new(0, 0, 40, 12), Theme::dark_blue(), table.tracks, 0);
    // Narrow track bank scrolls FX controls without displacing Master.
    let label: Cell = surface.cell(13, 0); verify_eq_i32(52, label.glyph); // FX4
    let percent: Cell = surface.cell(12, 11); verify_eq_i32(37, percent.glyph);
    let master: Cell = surface.cell(34, 0); verify_eq_i32(77, master.glyph);
    verify(!mixer.send_navigation(decode_input("l"), 0)); verify(mixer.selected_send == -1);
    verify(mixer.send_navigation(decode_input("z"), 1));
    verify(mixer.expanded_track(0) && mixer.expanded_track(1));
    verify(mixer.send_navigation(decode_input("z"), 0)); verify(!mixer.expanded_track(0));
    verify(mixer.expanded_track(1));
    mixer.bus_focus = true; verify(!mixer.send_navigation(decode_input("z"), 1));
    surface.release(); table.release();
}

#[test]
fn tui_mixer_faders_and_recording() {
    let area: Rect = Rect::new(0, 0, 120, 20);
    var table: SequenceTable = SequenceTable::new();
    table.clear_row();
    verify(!table.record_note(60, 87));
    verify(table.mixer_event(decode_input("J"), area));
    let quieter: SequenceTrack = table.tracks[0]; verify(quieter.volume == 99);
    verify(table.mixer_event(decode_input("\x1b[107;2u"), area));
    verify(!table.mixer_event(decode_input("K"), area));
    verify(table.mixer_event(decode_input("R"), area));
    verify(table.record_note(60, 87));
    let first: TableRow = table.rows[0];
    verify(first.cells[1] == "C-4" && first.cells[2] == "87" && first.cells[3] == "1.00" && first.cells[4] == "0.00");
    verify(!table.record_note(61, 0));
    table.note_line_action(80, area); // A new selected note line, still same track.
    verify(table.record_note(67, 113));
    let chord: TableRow = table.rows[0]; verify(chord.cells[1] == "C-4" && chord.cells[5] == "G-4" && chord.cells[6] == "113");
    verify(table.mixer_event(decode_input("\x1b[114;2u"), area));
    verify(!table.record_note(69, 100));
    verify(table.mixer_event(decode_input("l"), area)); verify(table.active_track() == 1);
    let surface: Surface = Surface::new(12, 12);
    var slider: Slider = Slider { minimum: 0.0, maximum: 100.0, value: 100.0, value_type: "i32" };
    slider.paint_vertical(surface, Rect::new(0, 0, 3, 10), Theme::dark_blue(), false);
    let top: Cell = surface.cell(1, 0); let value: Cell = surface.cell(0, 9);
    verify(top.glyph == 0x2501 && value.glyph == 49);
    slider.value = 0.0; slider.paint_vertical(surface, Rect::new(0, 0, 3, 10), Theme::dark_blue(), false);
    let bottom: Cell = surface.cell(1, 8); verify(bottom.glyph == 0x2501);
    table.selected_column = 1; table.mixer_event(decode_input("R"), area);
    let mixer: Mixer = Mixer {};
    mixer.paint(surface, Rect::new(0, 0, 12, 12), Theme::dark_blue(), table.tracks, 0);
    let armed: Cell = surface.cell(4, 0); verify(armed.glyph == 82 && armed.foreground == 0xFFFFFF && armed.background == 0xC02030);
    table.release(); surface.release();
}

#[test]
fn tui_remove_instrument_detaches_patterns() {
    var library: PatternLibrary = PatternLibrary::new();
    let area: Rect = Rect::new(0, 0, 100, 20);
    library.table.create_instrument_track(7, area);
    library.add_instrument(7, "Test"); library.add_instrument(8, "Other");
    library.table.assign_instrument(7); library.add(true);
    library.remove_instrument(7, area);
    let tracks: list<SequenceTrack> = library.table.tracks;
    for track in tracks { verify(track.instrument_id != 7); }
    let patterns: list<PatternEntry> = library.patterns;
    for pattern in patterns {
        let saved: list<SequenceTrack> = pattern.data.tracks;
        for track in saved { verify(track.instrument_id != 7); }
    }
    verify(library.instruments.items.len() == 1);
    let kept: ListItem = library.instruments.items[0]; verify(kept.id == 8);
    library.release();
}
