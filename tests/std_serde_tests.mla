mod std::testing;
mod std::serde;
mod std::bitset;
mod std::strbuf;

use std::bitset::BitSet;
use std::serde::Binary;
use std::serde::BinarySerde;
use std::serde::Reader;
use std::strbuf::eq;
use std::testing::verify;
use std::testing::verify_eq;
use std::testing::verify_eq_i32;

struct DemoPacket {
    var id: i32;
    var name: string;
    var enabled: bool;
    var score: i64;
};

struct EnvelopeMeta {
    var version: i32;
    var tag: string;
};

struct SensorSample {
    var ts_ns: i64;
    var value: f64;
    var ok: bool;
};

struct MultiNestedPacket {
    var meta: EnvelopeMeta;
    var primary: SensorSample;
    var backup: SensorSample;
    var retries: i32;
    var note: string;
};

struct EngineFlags {
    var safe_mode: bool;
    var armed: bool;
};

struct ControlBlock {
    var flags: EngineFlags;
    var gain: i32;
};

struct DeepNestedPacket {
    var id: i64;
    var ctrl: ControlBlock;
    var sample: SensorSample;
    var label: string;
};

struct VecBucket {
    var bins: list<i32>;
    var marks: list<bool>;
};

struct VecEnvelope {
    var title: string;
    var offsets: list<i64>;
    var nested: VecBucket;
};

impl BinarySerde for EnvelopeMeta {
    fn serialize(self: &mut Self, out_handle: i64) -> Result<i32, string> {
        let out: Binary = Binary { handle: out_handle };
        let w1: Result<i32, string> = out.write_i32(self.version);
        if w1.is_err() { return Err<i32, string>(w1.unwrap_err()); }
        let w2: Result<i32, string> = out.write_string(self.tag);
        if w2.is_err() { return Err<i32, string>(w2.unwrap_err()); }
        return Ok<i32, string>(0);
    }

    fn deserialize(self: &mut Self, input_handle: i64) -> Result<i32, string> {
        let input: Reader = Reader { handle: input_handle };
        let r1: Result<i32, string> = input.read_i32();
        if r1.is_err() { return Err<i32, string>(r1.unwrap_err()); }
        self.version = r1.unwrap();
        let r2: Result<string, string> = input.read_string();
        if r2.is_err() { return Err<i32, string>(r2.unwrap_err()); }
        self.tag = r2.unwrap();
        return Ok<i32, string>(0);
    }
}

impl BinarySerde for SensorSample {
    fn serialize(self: &mut Self, out_handle: i64) -> Result<i32, string> {
        let out: Binary = Binary { handle: out_handle };
        let w1: Result<i32, string> = out.write_i64(self.ts_ns);
        if w1.is_err() { return Err<i32, string>(w1.unwrap_err()); }
        let w2: Result<i32, string> = out.write_f64(self.value);
        if w2.is_err() { return Err<i32, string>(w2.unwrap_err()); }
        let w3: Result<i32, string> = out.write_bool(self.ok);
        if w3.is_err() { return Err<i32, string>(w3.unwrap_err()); }
        return Ok<i32, string>(0);
    }

    fn deserialize(self: &mut Self, input_handle: i64) -> Result<i32, string> {
        let input: Reader = Reader { handle: input_handle };
        let r1: Result<i64, string> = input.read_i64();
        if r1.is_err() { return Err<i32, string>(r1.unwrap_err()); }
        self.ts_ns = r1.unwrap();
        let r2: Result<f64, string> = input.read_f64();
        if r2.is_err() { return Err<i32, string>(r2.unwrap_err()); }
        self.value = r2.unwrap();
        let r3: Result<bool, string> = input.read_bool();
        if r3.is_err() { return Err<i32, string>(r3.unwrap_err()); }
        self.ok = r3.unwrap();
        return Ok<i32, string>(0);
    }
}

impl BinarySerde for EngineFlags {
    fn serialize(self: &mut Self, out_handle: i64) -> Result<i32, string> {
        let out: Binary = Binary { handle: out_handle };
        let w1: Result<i32, string> = out.write_bool(self.safe_mode);
        if w1.is_err() { return Err<i32, string>(w1.unwrap_err()); }
        let w2: Result<i32, string> = out.write_bool(self.armed);
        if w2.is_err() { return Err<i32, string>(w2.unwrap_err()); }
        return Ok<i32, string>(0);
    }

    fn deserialize(self: &mut Self, input_handle: i64) -> Result<i32, string> {
        let input: Reader = Reader { handle: input_handle };
        let r1: Result<bool, string> = input.read_bool();
        if r1.is_err() { return Err<i32, string>(r1.unwrap_err()); }
        self.safe_mode = r1.unwrap();
        let r2: Result<bool, string> = input.read_bool();
        if r2.is_err() { return Err<i32, string>(r2.unwrap_err()); }
        self.armed = r2.unwrap();
        return Ok<i32, string>(0);
    }
}

impl BinarySerde for ControlBlock {
    fn serialize(self: &mut Self, out_handle: i64) -> Result<i32, string> {
        let r1: Result<i32, string> = self.flags.serialize(out_handle);
        if r1.is_err() { return Err<i32, string>(r1.unwrap_err()); }

        let out: Binary = Binary { handle: out_handle };
        let r2: Result<i32, string> = out.write_i32(self.gain);
        if r2.is_err() { return Err<i32, string>(r2.unwrap_err()); }
        return Ok<i32, string>(0);
    }

    fn deserialize(self: &mut Self, input_handle: i64) -> Result<i32, string> {
        let r1: Result<i32, string> = self.flags.deserialize(input_handle);
        if r1.is_err() { return Err<i32, string>(r1.unwrap_err()); }

        let input: Reader = Reader { handle: input_handle };
        let r2: Result<i32, string> = input.read_i32();
        if r2.is_err() { return Err<i32, string>(r2.unwrap_err()); }
        self.gain = r2.unwrap();
        return Ok<i32, string>(0);
    }
}

impl BinarySerde for DemoPacket {
    fn serialize(self: &mut Self, out_handle: i64) -> Result<i32, string> {
        let out: Binary = Binary { handle: out_handle };
        let w1: Result<i32, string> = out.write_i32(self.id);
        if w1.is_err() { return Err<i32, string>(w1.unwrap_err()); }

        let w2: Result<i32, string> = out.write_string(self.name);
        if w2.is_err() { return Err<i32, string>(w2.unwrap_err()); }

        let w3: Result<i32, string> = out.write_bool(self.enabled);
        if w3.is_err() { return Err<i32, string>(w3.unwrap_err()); }

        let w4: Result<i32, string> = out.write_i64(self.score);
        if w4.is_err() { return Err<i32, string>(w4.unwrap_err()); }

        return Ok<i32, string>(0);
    }

    fn deserialize(self: &mut Self, input_handle: i64) -> Result<i32, string> {
        let input: Reader = Reader { handle: input_handle };
        let r1: Result<i32, string> = input.read_i32();
        if r1.is_err() { return Err<i32, string>(r1.unwrap_err()); }
        self.id = r1.unwrap();

        let r2: Result<string, string> = input.read_string();
        if r2.is_err() { return Err<i32, string>(r2.unwrap_err()); }
        self.name = r2.unwrap();

        let r3: Result<bool, string> = input.read_bool();
        if r3.is_err() { return Err<i32, string>(r3.unwrap_err()); }
        self.enabled = r3.unwrap();

        let r4: Result<i64, string> = input.read_i64();
        if r4.is_err() { return Err<i32, string>(r4.unwrap_err()); }
        self.score = r4.unwrap();

        return Ok<i32, string>(0);
    }
}

impl BinarySerde for DeepNestedPacket {
    fn serialize(self: &mut Self, out_handle: i64) -> Result<i32, string> {
        let out: Binary = Binary { handle: out_handle };
        let r1: Result<i32, string> = out.write_i64(self.id);
        if r1.is_err() { return Err<i32, string>(r1.unwrap_err()); }

        let r2: Result<i32, string> = self.ctrl.serialize(out_handle);
        if r2.is_err() { return Err<i32, string>(r2.unwrap_err()); }

        let r3: Result<i32, string> = self.sample.serialize(out_handle);
        if r3.is_err() { return Err<i32, string>(r3.unwrap_err()); }

        let r4: Result<i32, string> = out.write_string(self.label);
        if r4.is_err() { return Err<i32, string>(r4.unwrap_err()); }
        return Ok<i32, string>(0);
    }

    fn deserialize(self: &mut Self, input_handle: i64) -> Result<i32, string> {
        let input: Reader = Reader { handle: input_handle };
        let r1: Result<i64, string> = input.read_i64();
        if r1.is_err() { return Err<i32, string>(r1.unwrap_err()); }
        self.id = r1.unwrap();

        let r2: Result<i32, string> = self.ctrl.deserialize(input_handle);
        if r2.is_err() { return Err<i32, string>(r2.unwrap_err()); }

        let r3: Result<i32, string> = self.sample.deserialize(input_handle);
        if r3.is_err() { return Err<i32, string>(r3.unwrap_err()); }

        let r4: Result<string, string> = input.read_string();
        if r4.is_err() { return Err<i32, string>(r4.unwrap_err()); }
        self.label = r4.unwrap();
        return Ok<i32, string>(0);
    }
}

impl BinarySerde for MultiNestedPacket {
    fn serialize(self: &mut Self, out_handle: i64) -> Result<i32, string> {
        let r1: Result<i32, string> = self.meta.serialize(out_handle);
        if r1.is_err() { return Err<i32, string>(r1.unwrap_err()); }

        let r2: Result<i32, string> = self.primary.serialize(out_handle);
        if r2.is_err() { return Err<i32, string>(r2.unwrap_err()); }

        let r3: Result<i32, string> = self.backup.serialize(out_handle);
        if r3.is_err() { return Err<i32, string>(r3.unwrap_err()); }

        let out: Binary = Binary { handle: out_handle };
        let r4: Result<i32, string> = out.write_i32(self.retries);
        if r4.is_err() { return Err<i32, string>(r4.unwrap_err()); }
        let r5: Result<i32, string> = out.write_string(self.note);
        if r5.is_err() { return Err<i32, string>(r5.unwrap_err()); }

        return Ok<i32, string>(0);
    }

    fn deserialize(self: &mut Self, input_handle: i64) -> Result<i32, string> {
        let r1: Result<i32, string> = self.meta.deserialize(input_handle);
        if r1.is_err() { return Err<i32, string>(r1.unwrap_err()); }

        let r2: Result<i32, string> = self.primary.deserialize(input_handle);
        if r2.is_err() { return Err<i32, string>(r2.unwrap_err()); }

        let r3: Result<i32, string> = self.backup.deserialize(input_handle);
        if r3.is_err() { return Err<i32, string>(r3.unwrap_err()); }

        let input: Reader = Reader { handle: input_handle };
        let r4: Result<i32, string> = input.read_i32();
        if r4.is_err() { return Err<i32, string>(r4.unwrap_err()); }
        self.retries = r4.unwrap();
        let r5: Result<string, string> = input.read_string();
        if r5.is_err() { return Err<i32, string>(r5.unwrap_err()); }
        self.note = r5.unwrap();

        return Ok<i32, string>(0);
    }
}

impl BinarySerde for VecBucket {
    fn serialize(self: &mut Self, out_handle: i64) -> Result<i32, string> {
        let out: Binary = Binary { handle: out_handle };
        let w1: Result<i32, string> = out.write_list_i32(self.bins);
        if w1.is_err() { return Err<i32, string>(w1.unwrap_err()); }
        let w2: Result<i32, string> = out.write_list_bool(self.marks);
        if w2.is_err() { return Err<i32, string>(w2.unwrap_err()); }
        return Ok<i32, string>(0);
    }

    fn deserialize(self: &mut Self, input_handle: i64) -> Result<i32, string> {
        let input: Reader = Reader { handle: input_handle };
        let b1: Result<list<i32>, string> = input.read_list_i32();
        if b1.is_err() { return Err<i32, string>(b1.unwrap_err()); }
        self.bins = b1.unwrap();

        let b2: Result<list<bool>, string> = input.read_list_bool();
        if b2.is_err() { return Err<i32, string>(b2.unwrap_err()); }
        self.marks = b2.unwrap();
        return Ok<i32, string>(0);
    }
}

impl BinarySerde for VecEnvelope {
    fn serialize(self: &mut Self, out_handle: i64) -> Result<i32, string> {
        let out: Binary = Binary { handle: out_handle };
        let w1: Result<i32, string> = out.write_string(self.title);
        if w1.is_err() { return Err<i32, string>(w1.unwrap_err()); }
        let w2: Result<i32, string> = out.write_list_i64(self.offsets);
        if w2.is_err() { return Err<i32, string>(w2.unwrap_err()); }
        let w3: Result<i32, string> = self.nested.serialize(out_handle);
        if w3.is_err() { return Err<i32, string>(w3.unwrap_err()); }
        return Ok<i32, string>(0);
    }

    fn deserialize(self: &mut Self, input_handle: i64) -> Result<i32, string> {
        let input: Reader = Reader { handle: input_handle };
        let r1: Result<string, string> = input.read_string();
        if r1.is_err() { return Err<i32, string>(r1.unwrap_err()); }
        self.title = r1.unwrap();

        let r2: Result<list<i64>, string> = input.read_list_i64();
        if r2.is_err() { return Err<i32, string>(r2.unwrap_err()); }
        self.offsets = r2.unwrap();

        let r3: Result<i32, string> = self.nested.deserialize(input_handle);
        if r3.is_err() { return Err<i32, string>(r3.unwrap_err()); }
        return Ok<i32, string>(0);
    }
}

#[test]
fn test_serde_primitive_roundtrip() {
    let br: Result<Binary, string> = Binary::new(0);
    verify(!br.is_err());
    let b: Binary = br.unwrap();

    let w1: Result<i32, string> = b.write_u8(255);
    verify(!w1.is_err());
    let w2: Result<i32, string> = b.write_bool(true);
    verify(!w2.is_err());
    let w3: Result<i32, string> = b.write_i32(-12345);
    verify(!w3.is_err());
    let w4: Result<i32, string> = b.write_i64(1234567890123);
    verify(!w4.is_err());
    let w5: Result<i32, string> = b.write_f32(1.5f);
    verify(!w5.is_err());
    let w6: Result<i32, string> = b.write_f64(2.25);
    verify(!w6.is_err());
    let w7: Result<i32, string> = b.write_string("hello-serde");
    verify(!w7.is_err());

    let expected_len: i64 = 45;
    verify_eq(expected_len, b.len());

    let rr: Result<Reader, string> = b.to_reader();
    verify(!rr.is_err());
    let r: Reader = rr.unwrap();

    let ur: Result<i32, string> = r.read_u8();
    verify(!ur.is_err());
    let u: i32 = ur.unwrap();

    let bor: Result<bool, string> = r.read_bool();
    verify(!bor.is_err());
    let bo: bool = bor.unwrap();

    let i32r: Result<i32, string> = r.read_i32();
    verify(!i32r.is_err());
    let i32v: i32 = i32r.unwrap();

    let i64r: Result<i64, string> = r.read_i64();
    verify(!i64r.is_err());
    let i64v: i64 = i64r.unwrap();

    let f32r: Result<f32, string> = r.read_f32();
    verify(!f32r.is_err());
    let f32v: f32 = f32r.unwrap();

    let f64r: Result<f64, string> = r.read_f64();
    verify(!f64r.is_err());
    let f64v: f64 = f64r.unwrap();

    let sr: Result<string, string> = r.read_string();
    verify(!sr.is_err());
    let s: string = sr.unwrap();

    verify_eq_i32(255, u);
    verify(bo == true);
    verify_eq_i32(-12345, i32v);
    let expected_i64v: i64 = 1234567890123;
    verify_eq(expected_i64v, i64v);
    verify(f32v == 1.5f);
    verify(f64v == 2.25);
    verify(eq(s, "hello-serde") == 1);
    String::free(s);

    let zero_i64: i64 = 0;
    verify_eq(zero_i64, r.remaining());

    let eof_read: Result<i32, string> = r.read_u8();
    verify(eof_read.is_err());

    r.close();
    b.close();
}

#[test]
fn test_serde_custom_trait_roundtrip() {
    let br: Result<Binary, string> = Binary::new(64);
    verify(!br.is_err());
    let b: Binary = br.unwrap();

    var src: DemoPacket = DemoPacket {
        id: 42,
        name: "tracker",
        enabled: true,
        score: 987654321
    };

    let sw: Result<i32, string> = src.serialize(b.raw_handle());
    verify(!sw.is_err());

    let rr: Result<Reader, string> = b.to_reader();
    verify(!rr.is_err());
    let r: Reader = rr.unwrap();

    var dst: DemoPacket = DemoPacket {
        id: 0,
        name: "",
        enabled: false,
        score: 0
    };

    let dr: Result<i32, string> = dst.deserialize(r.raw_handle());
    verify(!dr.is_err());

    verify_eq_i32(42, dst.id);
    verify(eq(dst.name, "tracker") == 1);
    verify(dst.enabled == true);
    let expected_score: i64 = 987654321;
    verify_eq(expected_score, dst.score);

    String::free(dst.name);
    r.close();
    b.close();
}

#[test]
fn test_serde_file_roundtrip() {
    let path: string = "/tmp/mlang_std_serde_roundtrip.bin";

    let br: Result<Binary, string> = Binary::new(16);
    verify(!br.is_err());
    let b: Binary = br.unwrap();

    let w1: Result<i32, string> = b.write_i32(77);
    verify(!w1.is_err());
    let w2: Result<i32, string> = b.write_string("file-io");
    verify(!w2.is_err());
    let wf: Result<i32, string> = b.write_file(path);
    verify(!wf.is_err());

    let br2: Result<Binary, string> = Binary::from_file(path);
    verify(!br2.is_err());
    let b2: Binary = br2.unwrap();

    let rr: Result<Reader, string> = b2.to_reader();
    verify(!rr.is_err());
    let r: Reader = rr.unwrap();

    let i32r: Result<i32, string> = r.read_i32();
    verify(!i32r.is_err());
    verify_eq_i32(77, i32r.unwrap());

    let sr: Result<string, string> = r.read_string();
    verify(!sr.is_err());
    let s: string = sr.unwrap();
    verify(eq(s, "file-io") == 1);
    String::free(s);

    r.close();
    b2.close();
    b.close();
}

#[test]
fn test_serde_multi_nested_struct_roundtrip() {
    let br: Result<Binary, string> = Binary::new(128);
    verify(!br.is_err());
    let b: Binary = br.unwrap();

    var src: MultiNestedPacket = MultiNestedPacket {
        meta: EnvelopeMeta {
            version: 3,
            tag: "mixbus-A"
        },
        primary: SensorSample {
            ts_ns: 1711111111,
            value: 0.875,
            ok: true
        },
        backup: SensorSample {
            ts_ns: 1711112222,
            value: -0.125,
            ok: false
        },
        retries: 2,
        note: "nested-serde-ok"
    };

    let sw: Result<i32, string> = src.serialize(b.raw_handle());
    verify(!sw.is_err());

    let rr: Result<Reader, string> = b.to_reader();
    verify(!rr.is_err());
    let r: Reader = rr.unwrap();

    var dst: MultiNestedPacket = MultiNestedPacket {
        meta: EnvelopeMeta {
            version: 0,
            tag: ""
        },
        primary: SensorSample {
            ts_ns: 0,
            value: 0.0,
            ok: false
        },
        backup: SensorSample {
            ts_ns: 0,
            value: 0.0,
            ok: false
        },
        retries: 0,
        note: ""
    };

    let dr: Result<i32, string> = dst.deserialize(r.raw_handle());
    verify(!dr.is_err());

    verify_eq_i32(3, dst.meta.version);
    verify(eq(dst.meta.tag, "mixbus-A") == 1);
    verify_eq(1711111111, dst.primary.ts_ns);
    verify(dst.primary.value == 0.875);
    verify(dst.primary.ok == true);
    verify_eq(1711112222, dst.backup.ts_ns);
    verify(dst.backup.value == -0.125);
    verify(dst.backup.ok == false);
    verify_eq_i32(2, dst.retries);
    verify(eq(dst.note, "nested-serde-ok") == 1);

    String::free(dst.meta.tag);
    String::free(dst.note);
    r.close();
    b.close();
}

#[test]
fn test_serde_three_level_nested_struct_roundtrip() {
    let br: Result<Binary, string> = Binary::new(128);
    verify(!br.is_err());
    let b: Binary = br.unwrap();

    var src: DeepNestedPacket = DeepNestedPacket {
        id: 9001,
        ctrl: ControlBlock {
            flags: EngineFlags {
                safe_mode: true,
                armed: false
            },
            gain: 87
        },
        sample: SensorSample {
            ts_ns: 1712223334,
            value: 0.5,
            ok: true
        },
        label: "three-level-ok"
    };

    let sw: Result<i32, string> = src.serialize(b.raw_handle());
    verify(!sw.is_err());

    let rr: Result<Reader, string> = b.to_reader();
    verify(!rr.is_err());
    let r: Reader = rr.unwrap();

    var dst: DeepNestedPacket = DeepNestedPacket {
        id: 0,
        ctrl: ControlBlock {
            flags: EngineFlags {
                safe_mode: false,
                armed: false
            },
            gain: 0
        },
        sample: SensorSample {
            ts_ns: 0,
            value: 0.0,
            ok: false
        },
        label: ""
    };

    let dr: Result<i32, string> = dst.deserialize(r.raw_handle());
    verify(!dr.is_err());

    verify_eq(9001, dst.id);
    verify(dst.ctrl.flags.safe_mode == true);
    verify(dst.ctrl.flags.armed == false);
    verify_eq_i32(87, dst.ctrl.gain);
    verify_eq(1712223334, dst.sample.ts_ns);
    verify(dst.sample.value == 0.5);
    verify(dst.sample.ok == true);
    verify(eq(dst.label, "three-level-ok") == 1);

    String::free(dst.label);
    r.close();
    b.close();
}

#[test]
fn test_serde_nested_struct_with_vectors_roundtrip() {
    let br: Result<Binary, string> = Binary::new(128);
    verify(!br.is_err());
    let b: Binary = br.unwrap();

    var src: VecEnvelope = VecEnvelope {
        title: "vec-envelope",
        offsets: [10, 20, 30, 40],
        nested: VecBucket {
            bins: [3, 1, 4, 1, 5, 9],
            marks: [true, false, true, false, true, true]
        }
    };

    let sw: Result<i32, string> = src.serialize(b.raw_handle());
    verify(!sw.is_err());

    let rr: Result<Reader, string> = b.to_reader();
    verify(!rr.is_err());
    let r: Reader = rr.unwrap();

    var dst: VecEnvelope = VecEnvelope {
        title: "",
        offsets: [],
        nested: VecBucket {
            bins: [],
            marks: []
        }
    };

    let dr: Result<i32, string> = dst.deserialize(r.raw_handle());
    verify(!dr.is_err());

    verify(eq(dst.title, "vec-envelope") == 1);
    verify_eq(4, dst.offsets.len());
    verify_eq(6, dst.nested.bins.len());
    verify_eq(6, dst.nested.marks.len());

    String::free(dst.title);
    r.close();
    b.close();
}

#[test]
fn test_serde_read_list_result_roundtrip() {
    let br: Result<Binary, string> = Binary::new(64);
    verify(!br.is_err());
    let b: Binary = br.unwrap();

    let w: Result<i32, string> = b.write_list_i64([11, 22, 33, 44]);
    verify(!w.is_err());

    let rr: Result<Reader, string> = b.to_reader();
    verify(!rr.is_err());
    let r: Reader = rr.unwrap();

    let vals_r: Result<list<i64>, string> = r.read_list_i64();
    verify(!vals_r.is_err());
    let vals: list<i64> = vals_r.unwrap();
    verify_eq(4, vals.len());
    verify_eq(11, vals[0]);
    verify_eq(44, vals[3]);

    r.close();
    b.close();
}

#[test]
fn test_serde_bitset_roundtrip() {
    let br: Result<Binary, string> = Binary::new(32);
    verify(!br.is_err());
    let b: Binary = br.unwrap();

    let bsr: Result<BitSet, string> = BitSet::new(0);
    verify(!bsr.is_err());
    let bs: BitSet = bsr.unwrap();
    verify(bs.resize(11, false) == 0);
    verify(bs.set(0, true) == 0);
    verify(bs.set(5, true) == 0);
    verify(bs.set(10, true) == 0);

    let w: Result<i32, string> = b.write_bitset(bs.raw_handle(), bs.len());
    verify(!w.is_err());

    let rr: Result<Reader, string> = b.to_reader();
    verify(!rr.is_err());
    let r: Reader = rr.unwrap();

    let out_r: Result<BitSet, string> = r.read_bitset();
    verify(!out_r.is_err());
    let out: BitSet = out_r.unwrap();

    verify_eq(11, out.len());
    verify_eq(3, out.count_ones());
    let v0: Result<bool, string> = out.get(0);
    let v5: Result<bool, string> = out.get(5);
    let v10: Result<bool, string> = out.get(10);
    verify(!v0.is_err() && v0.unwrap());
    verify(!v5.is_err() && v5.unwrap());
    verify(!v10.is_err() && v10.unwrap());

    out.close();
    r.close();
    bs.close();
    b.close();
}
