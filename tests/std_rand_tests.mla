mod std::rand;

use std::rand::next_f64;
use std::rand::next_u64;
use std::rand::range_f64;
use std::rand::range_i64;
use std::rand::seed;

#[test]
fn test_seed_reproducibility_u64() -> i32 {
    seed(42);
    let a: u64 = next_u64();
    seed(42);
    let b: u64 = next_u64();
    return a == b ? 0 : 1;
}

#[test]
fn test_range_i64_bounds() -> i32 {
    seed(99);
    for _i in 0..1000 {
        let v: i64 = range_i64(-7, 13);
        if v < -7 || v > 13 {
            return 1;
        }
    }
    return 0;
}

#[test]
fn test_range_i64_swapped_bounds() -> i32 {
    seed(77);
    for _i in 0..300 {
        let v: i64 = range_i64(20, 10);
        if v < 10 || v > 20 {
            return 1;
        }
    }
    return 0;
}

#[test]
fn test_next_f64_unit_interval() -> i32 {
    seed(1234);
    for _i in 0..500 {
        let x: f64 = next_f64();
        if x < 0.0 || x >= 1.0 {
            return 1;
        }
    }
    return 0;
}

#[test]
fn test_range_f64_bounds() -> i32 {
    seed(1001);
    for _i in 0..500 {
        let x: f64 = range_f64(2.5, 4.5);
        if x < 2.5 || x > 4.5 {
            return 1;
        }
    }
    return 0;
}
