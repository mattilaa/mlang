mod std::testing;

use std::testing::verify;
fn source(v: i32) -> i32 { return v; }

#[test]
fn test_if_let_typed_block_complex_guard() {
    let outer: i32 = 12;
    var seen: i32 = 0;
    if let i: i32 = source(7): (i >= 0 && i < 10) || ((i > 20 && i < 30) || (i > 50 && i < 100)): {
        seen = i;
    }
    else: {
        verify(false);
    }
    if seen != 7: { verify(false); }
    if outer != 12: { verify(false); }
    }

#[test]
fn test_if_let_typed_single_statement() {
    var seen: i32 = 0;
    if let i: i32 = source(3): i == 3: seen = i;
    else: seen = 99;
    if seen != 3: { verify(false); }
    }

#[test]
fn test_if_let_untyped_block() {
    let outer: i32 = 44;
    var seen: i32 = 0;
    if let i = source(6): (i >= 0 && i < 10): {
        seen = i;
    }
    else: {
        verify(false);
    }
    if seen != 6: { verify(false); }
    if outer != 44: { verify(false); }
    }

#[test]
fn test_if_let_untyped_single_statement() {
    var seen: i32 = 0;
    if let i = source(8): i == 8: seen = i;
    else: seen = 77;
    if seen != 8: { verify(false); }
    }

#[test]
fn test_if_var_typed_block_mutable_shadow() {
    let outer: i32 = 5;
    var seen: i32 = 0;
    if var i: i32 = source(1): i == 1: {
        i = 15;
        seen = i;
    }
    else: {
        verify(false);
    }
    if seen != 15: { verify(false); }
    if outer != 5: { verify(false); }
    }

#[test]
fn test_if_var_typed_single_statement() {
    var seen: i32 = 0;
    if var i: i32 = source(2): i == 2: seen = i;
    else: seen = 66;
    if seen != 2: { verify(false); }
    }

#[test]
fn test_if_var_untyped_block() {
    let outer: i32 = 9;
    var seen: i32 = 0;
    if var i = source(4): i == 4: {
        i = 11;
        seen = i;
    }
    else: {
        verify(false);
    }
    if seen != 11: { verify(false); }
    if outer != 9: { verify(false); }
    }

#[test]
fn test_if_var_untyped_single_statement() {
    var seen: i32 = 0;
    if var i = source(9): i == 9: seen = i;
    else: seen = 55;
    if seen != 9: { verify(false); }
    }

#[test]
fn test_else_if_chain_let_and_var_combinations() {
    let outer: i32 = 12;
    var branch: i32 = 0;
    if let i: i32 = source(40): (i >= 0 && i < 10): {
        branch = 1;
    }
    else if let i = source(18): (i > 20 && i < 30): {
        branch = 2;
    }
    else if var i: i32 = source(25): (i > 20 && i < 30) || (i > 50 && i < 100): {
        i = 42;
        branch = i;
    }
    else if var i = source(60): (i > 50 && i < 100): {
        branch = 4;
    }
    else: {
        verify(false);
    }
    if branch != 42: { verify(false); }
    if outer != 12: { verify(false); }
    }

#[test]
fn test_if_else_if_else_block_without_colon() {
    let x: i32 = 2;
    var branch: i32 = 0;
    if x == 1 {
        branch = 1;
    } else if x == 2 {
        branch = 2;
    } else {
        branch = 3;
    }
    if branch != 2: { verify(false); }
    }

#[test]
fn test_nested_no_colon_if_blocks() {
    let x: i32 = 3;
    let y: i32 = 9;
    var seen: i32 = 0;
    if x > 0 {
        if y > 5 {
            seen = 1;
        } else {
            seen = 2;
        }
    } else {
        seen = 3;
    }
    if seen != 1: { verify(false); }
    }

#[test]
fn test_if_let_eq_initializer_with_complex_guard_block() {
    let outer: i32 = 1;
    let j: i32 = 11;
    var seen: i32 = 0;

    if let i == source(1): ((i < 0 && i > -30) || (j > 3 && j < 15)) {
        seen = i;
    } else {
        verify(false);
    }

    if seen != 1: { verify(false); }
    if outer != 1: { verify(false); }
    }

#[test]
fn test_else_if_let_eq_initializer_with_complex_guard_block() {
    let j: i32 = 11;
    var seen: i32 = 0;

    if j < 0 {
        seen = 1;
    } else if let i == source(5): ((i > 1 && i < 8) || (j > 3 && j < 15)) {
        seen = i;
    } else {
        verify(false);
    }

    if seen != 5: { verify(false); }
    }
