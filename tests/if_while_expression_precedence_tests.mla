mod std::testing;

use std::testing::verify;
#[test]
fn if_additive_relational_without_parens() {
    let i: i32 = 2;
    let n: i32 = 3;
    verify(i + 1 >= n);
}

#[test]
fn while_additive_relational_without_parens() {
    var i: i32 = 0;
    var loops: i32 = 0;
    while i + 1 < 5 {
        loops = loops + 1;
        i = i + 1;
    }
    verify(loops == 4);
}

#[test]
fn if_with_complex_nested_guard_expression() {
    let i: i32 = 25;
    if i >= 0: (i >= 0 && i < 10) || ((i > 20 && i < 30) || (i > 50 && i < 100)) {
    } else {
        verify(false);
    }
}

fn some_val() -> i32 {
    return 1;
}

#[test]
fn if_let_eq_with_complex_guard_expression() {
    let j: i32 = 4;
    if let i == some_val(): ((i < 0 && i > -30) || (j > 3 && j < 5)) {
    } else {
        verify(false);
    }
}

#[test]
fn if_bitwise_and_logical_guard_without_parens() {
    let x: i32 = 5;
    let y: i32 = 10;
    var matched: bool = false;
    if x & 1 && y == 10 {
        matched = true;
    }
    verify(matched);
}

#[test]
fn while_bitwise_and_logical_guard_without_parens() {
    var x: i32 = 5;
    var y: i32 = 10;
    var loops: i32 = 0;

    while x & 1 && y == 10 {
        loops = loops + 1;
        x = x + 1;
    }

    verify(loops == 1);
}

#[test]
fn if_colon_block_with_logical_or_condition() {
    let x: i32 = 0;
    let y: i32 = 1;
    var matched: bool = false;

    if x != 0 || y != 0: {
        matched = true;
    }

    verify(matched);
}

#[test]
fn else_if_colon_block_with_logical_or_condition() {
    let x: i32 = 0;
    let y: i32 = 1;
    var branch: i32 = 0;

    if x != 0: {
        branch = 1;
    } else if x != 0 || y != 0: {
        branch = 2;
    } else {
        branch = 3;
    }

    verify(branch == 2);
}

#[test]
fn if_full_bitwise_precedence_in_brace_condition() {
    let permissions: u8 = 0b0110;
    var matched: bool = false;

    if (permissions & 0b0010) != 0 && ((permissions ^ 0b0100) == 0b0010) && ((permissions | 0b0001) == 0b0111) && ((permissions >> 1) == 0b0011) && ((0b0011 << 1) == permissions) {
        matched = true;
    }

    verify(matched);
}
