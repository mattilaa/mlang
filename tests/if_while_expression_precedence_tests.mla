#[test]
fn if_additive_relational_without_parens() -> i32 {
    let i: i32 = 2;
    let n: i32 = 3;
    if i + 1 >= n {
        return 0;
    }
    return 1;
}

#[test]
fn while_additive_relational_without_parens() -> i32 {
    var i: i32 = 0;
    var loops: i32 = 0;
    while i + 1 < 5 {
        loops = loops + 1;
        i = i + 1;
    }
    return loops == 4 ? 0 : 1;
}

#[test]
fn if_with_complex_nested_guard_expression() -> i32 {
    let i: i32 = 25;
    if i >= 0: (i >= 0 && i < 10) || ((i > 20 && i < 30) || (i > 50 && i < 100)) {
        return 0;
    }
    return 1;
}

fn some_val() -> i32 {
    return 1;
}

#[test]
fn if_let_eq_with_complex_guard_expression() -> i32 {
    let j: i32 = 4;
    if let i == some_val(): ((i < 0 && i > -30) || (j > 3 && j < 5)) {
        return 0;
    }
    return 1;
}
