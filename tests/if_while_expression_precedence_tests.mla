mod std::testing;
mod std::fs;

use std::testing::verify;
use std::fs::write_all_text;
#[test]
fn if_additive_relational_without_parens() {
    let i: i32 = 2;
    let n: i32 = 3;
    verify(i + 1 >= n);
}

#[test]
fn while_additive_relational_without_parens() {
    var i: i32 = 0;
    var loops: i32 = 0;
    while i + 1 < 5 {
        loops = loops + 1;
        i = i + 1;
    }
    verify(loops == 4);
}

#[test]
fn if_with_complex_nested_guard_expression() {
    let i: i32 = 25;
    if i >= 0: (i >= 0 && i < 10) || ((i > 20 && i < 30) || (i > 50 && i < 100)) {
    } else {
        verify(false);
    }
}

fn some_val() -> i32 {
    return 1;
}

#[test]
fn if_let_eq_with_complex_guard_expression() {
    let j: i32 = 4;
    if let i == some_val(): ((i < 0 && i > -30) || (j > 3 && j < 5)) {
    } else {
        verify(false);
    }
}

#[test]
fn if_condition_allows_method_chain_on_function_call_result() {
    let src_path: str8 = "/tmp/mlang_if_condition_method_chain_plain.mla";
    let src: str8 = "ok";
    if write_all_text(src_path, src).is_err() {
        verify(false);
    }
    verify(true);
}
