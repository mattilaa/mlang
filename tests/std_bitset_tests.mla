mod std::testing;
mod std::bitset;

use std::bitset::BitSet;
use std::testing::verify;
use std::testing::verify_eq;

#[test]
fn test_bitset_set_get_toggle_and_count() {
    let r: result<BitSet, str8> = BitSet::new(8);
    verify(!r.is_err());
    let bs: BitSet = r.unwrap();
    verify(bs.resize(8, false) == 0);

    verify(bs.set(0, true) == 0);
    verify(bs.set(3, true) == 0);
    verify(bs.set(7, true) == 0);
    verify_eq(3, bs.count_ones());

    let b0: result<bool, str8> = bs.get(0);
    let b1: result<bool, str8> = bs.get(1);
    let b3: result<bool, str8> = bs.get(3);
    verify(!b0.is_err() && b0.unwrap());
    verify(!b1.is_err() && !b1.unwrap());
    verify(!b3.is_err() && b3.unwrap());

    verify(bs.toggle(3) == 0);
    let b3b: result<bool, str8> = bs.get(3);
    verify(!b3b.is_err() && !b3b.unwrap());
    verify_eq(2, bs.count_ones());
    verify_eq(2, bs.count());
    verify(bs.any());
    verify(!bs.none());
    verify(!bs.all());

    bs.close();
}

#[test]
fn test_bitset_standard_queries_empty_and_full() {
    let r: result<BitSet, str8> = BitSet::new(0);
    verify(!r.is_err());
    let bits: BitSet = r.unwrap();
    verify(bits.none());
    verify(!bits.any());
    verify(bits.all());
    verify_eq(0, bits.count());

    verify(bits.resize(4, true) == 0);
    verify(bits.all() && bits.any());
    verify_eq(4, bits.count());

    verify(bits.set(2, false) == 0);
    verify(!bits.all() && bits.any() && !bits.none());
    verify_eq(3, bits.count());

    verify(bits.set(0, false) == 0);
    verify(bits.set(1, false) == 0);
    verify(bits.set(3, false) == 0);
    verify(bits.none() && !bits.any());
    bits.close();
}

#[test]
fn test_bitset_bulk_set_reset_and_flip() {
    let r: result<BitSet, str8> = BitSet::new(67);
    verify(!r.is_err());
    let bits: BitSet = r.unwrap();
    verify(bits.resize(67, false) == 0);

    verify(bits.set_all() == 0);
    verify(bits.len() == 67 && bits.all() && bits.count() == 67);
    verify(bits.flip_all() == 0);
    verify(bits.none() && bits.count() == 0);

    verify(bits.set(66, true) == 0);
    verify(bits.reset() == 0);
    verify(bits.len() == 67 && bits.none());
    bits.close();
}

#[test]
fn test_bitset_shifts_across_word_boundaries() {
    let r: result<BitSet, str8> = BitSet::new(130);
    verify(!r.is_err());
    let bits: BitSet = r.unwrap();
    verify(bits.resize(130, false) == 0);
    verify(bits.set(0, true) == 0);
    verify(bits.set(63, true) == 0);
    verify(bits.set(64, true) == 0);
    verify(bits.set(129, true) == 0);

    verify(bits.shift_left(1) == 0);
    verify(bits.get_fast(0) == 0);
    verify(bits.get_fast(1) == 1);
    verify(bits.get_fast(64) == 1);
    verify(bits.get_fast(65) == 1);
    verify(bits.get_fast(129) == 0);
    verify(bits.count() == 3);

    verify(bits.shift_right(1) == 0);
    verify(bits.get_fast(0) == 1);
    verify(bits.get_fast(63) == 1);
    verify(bits.get_fast(64) == 1);
    verify(bits.count() == 3);

    verify(bits.reset() == 0);
    verify(bits.set(0, true) == 0);
    verify(bits.set(63, true) == 0);
    verify(bits.set(64, true) == 0);
    verify(bits.shift_left(64) == 0);
    verify(bits.get_fast(0) == 0);
    verify(bits.get_fast(64) == 1);
    verify(bits.get_fast(127) == 1);
    verify(bits.get_fast(128) == 1);
    verify(bits.shift_right(64) == 0);
    verify(bits.get_fast(0) == 1);
    verify(bits.get_fast(63) == 1);
    verify(bits.get_fast(64) == 1);

    verify(bits.shift_left(130) == 0);
    verify(bits.none());
    verify(bits.set(3, true) == 0);
    verify(bits.shift_left(-1) == -1);
    verify(bits.shift_right(-1) == -1);
    verify(bits.get_fast(3) == 1);
    bits.close();
}

#[test]
fn test_bitset_push_pop_resize_and_bounds() {
    let r: result<BitSet, str8> = BitSet::new(0);
    verify(!r.is_err());
    let bs: BitSet = r.unwrap();

    verify(bs.push(true) == 0);
    verify(bs.push(false) == 0);
    verify(bs.push(true) == 0);
    verify_eq(3, bs.len());

    let p1: result<bool, str8> = bs.pop();
    let p2: result<bool, str8> = bs.pop();
    verify(!p1.is_err() && p1.unwrap());
    verify(!p2.is_err() && !p2.unwrap());
    verify_eq(1, bs.len());

    verify(bs.resize(10, true) == 0);
    verify_eq(10, bs.len());
    let b9: result<bool, str8> = bs.get(9);
    verify(!b9.is_err() && b9.unwrap());

    let oob: result<bool, str8> = bs.get(20);
    verify(oob.is_err());

    bs.close();
}

#[test]
fn test_bitset_bitwise_ops() {
    let ar: result<BitSet, str8> = BitSet::new(8);
    let br: result<BitSet, str8> = BitSet::new(8);
    verify(!ar.is_err());
    verify(!br.is_err());
    let a: BitSet = ar.unwrap();
    let b: BitSet = br.unwrap();

    verify(a.resize(8, false) == 0);
    verify(b.resize(8, false) == 0);
    verify(a.set(0, true) == 0);
    verify(a.set(2, true) == 0);
    verify(a.set(4, true) == 0);
    verify(b.set(2, true) == 0);
    verify(b.set(3, true) == 0);
    verify(b.set(4, true) == 0);

    verify(a.and_eq(b.raw_handle()) == 0);
    verify_eq(2, a.count_ones());
    let a2: result<bool, str8> = a.get(2);
    let a4: result<bool, str8> = a.get(4);
    verify(!a2.is_err() && a2.unwrap());
    verify(!a4.is_err() && a4.unwrap());

    verify(a.not_eq() == 0);
    verify_eq(6, a.count_ones());

    verify(a.xor_eq(b.raw_handle()) == 0);
    verify_eq(7, a.count_ones());

    a.close();
    b.close();
}
