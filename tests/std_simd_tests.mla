mod std::testing;
mod std::simd;
mod std::bitset;

use std::bitset::BitSet;
use std::testing::verify;
use std::simd::*;

fn approx_f32(a: f32, b: f32, eps: f32) -> bool {
    var diff: f32 = a - b;
    if diff < 0.0f: {
        diff = 0.0f - diff;
    }
    return diff <= eps;
}

fn approx_f64(a: f64, b: f64, eps: f64) -> bool {
    var diff: f64 = a - b;
    if diff < 0.0: {
        diff = 0.0 - diff;
    }
    return diff <= eps;
}

#[test]
fn test_simd_i32_ops() {
    let a: list<i32> = [1, 2, 3, 4, 5];
    let b: list<i32> = [10, 20, 30, 40, 50];

    let added: list<i32> = add(a, b);
    let subbed: list<i32> = subtract(b, a);
    let multiplied: list<i32> = multiply(a, b);

    verify(added.len() == 5);
    verify(added[0] == 11);
    verify(added[4] == 55);
    verify(subbed[1] == 18);
    verify(multiplied[2] == 90);
    verify(sum(a) == 15);
    verify(product(a) == 120);

    let running: list<i32> = prefix_sum(a);
    verify(running.len() == 5);
    verify(running[0] == 1);
    verify(running[4] == 15);

    let mixed: list<i32> = [4, 0 - 2, 0, 9];
    verify(min(mixed) == 0 - 2);
    verify(max(mixed) == 9);
    verify(any_nonzero(mixed));
    verify(!all_nonzero(mixed));
}

#[test]
fn test_simd_i64_ops() {
    let a: list<i64> = [1, 2, 3, 4];
    let b: list<i64> = [5, 6, 7, 8];

    let added: list<i64> = add(a, b);
    let subbed: list<i64> = subtract(b, a);
    let multiplied: list<i64> = multiply(a, b);

    verify(added[3] == 12);
    verify(subbed[0] == 4);
    verify(multiplied[3] == 32);
    verify(sum(b) == 26);
    verify(product(a) == 24);

    let running: list<i64> = prefix_sum(b);
    verify(running[0] == 5);
    verify(running[3] == 26);

    let mixed: list<i64> = [0, 40, 0 - 5, 9];
    verify(min(mixed) == 0 - 5);
    verify(max(mixed) == 40);
    verify(any_nonzero(mixed));
    verify(!all_nonzero(mixed));
}

#[test]
fn test_simd_i32_bitwise_ops() {
    let a: list<i32> = [1, 2, 3, 12];
    let b: list<i32> = [3, 1, 5, 10];

    let anded: list<i32> = bit_and(a, b);
    let ored: list<i32> = bit_or(a, b);
    let xored: list<i32> = bit_xor(a, b);
    let inverted: list<i32> = bit_not(a);
    let left: list<i32> = shift_left(a, 2);
    let right: list<i32> = shift_right(left, 1);
    let bad_shift: list<i32> = shift_left(a, 0 - 1);

    verify(anded[0] == 1);
    verify(anded[1] == 0);
    verify(ored[2] == 7);
    verify(xored[3] == 6);
    verify(inverted[0] == 0 - 2);
    verify(left[2] == 12);
    verify(right[3] == 24);
    verify(bad_shift.len() == 0);
}

#[test]
fn test_simd_i64_bitwise_ops() {
    let a: list<i64> = [1, 2, 3, 12];
    let b: list<i64> = [3, 1, 5, 10];

    let anded: list<i64> = bit_and(a, b);
    let ored: list<i64> = bit_or(a, b);
    let xored: list<i64> = bit_xor(a, b);
    let inverted: list<i64> = bit_not(a);
    let left: list<i64> = shift_left(a, 3);
    let right: list<i64> = shift_right(left, 2);

    verify(anded[0] == 1);
    verify(anded[1] == 0);
    verify(ored[2] == 7);
    verify(xored[3] == 6);
    verify(inverted[0] == 0 - 2);
    verify(left[2] == 24);
    verify(right[3] == 24);
}

#[test]
fn test_simd_f32_ops() {
    let eps: f32 = 0.0001f;
    let a: list<f32> = [1.0f, 2.5f, 3.0f];
    let b: list<f32> = [4.0f, 1.5f, 2.0f];

    let added: list<f32> = add(a, b);
    let subbed: list<f32> = subtract(a, b);
    let multiplied: list<f32> = multiply(a, b);

    verify(approx_f32(added[1], 4.0f, eps));
    verify(approx_f32(subbed[0], 0.0f - 3.0f, eps));
    verify(approx_f32(multiplied[2], 6.0f, eps));
    verify(approx_f32(sum(a), 6.5f, eps));
    verify(approx_f32(product(a), 7.5f, eps));

    let running: list<f32> = prefix_sum(a);
    verify(approx_f32(running[0], 1.0f, eps));
    verify(approx_f32(running[2], 6.5f, eps));

    let mixed: list<f32> = [2.0f, 0.0f - 4.5f, 0.0f, 8.0f];
    verify(approx_f32(min(mixed), 0.0f - 4.5f, eps));
    verify(approx_f32(max(mixed), 8.0f, eps));
    verify(any_nonzero(mixed));
    verify(!all_nonzero(mixed));
}

#[test]
fn test_simd_f64_ops_and_length_mismatch() {
    let eps: f64 = 0.0000001;
    let a: list<f64> = [1.0, 2.0, 3.0, 4.0];
    let b: list<f64> = [0.5, 1.5, 2.5, 3.5];
    let short: list<f64> = [1.0];

    let added: list<f64> = add(a, b);
    let subbed: list<f64> = subtract(a, b);
    let multiplied: list<f64> = multiply(a, b);
    let mismatch: list<f64> = add(a, short);

    verify(approx_f64(added[3], 7.5, eps));
    verify(approx_f64(subbed[0], 0.5, eps));
    verify(approx_f64(multiplied[2], 7.5, eps));
    verify(approx_f64(sum(b), 8.0, eps));
    verify(approx_f64(product(a), 24.0, eps));
    verify(mismatch.len() == 0);

    let running: list<f64> = prefix_sum(b);
    verify(approx_f64(running[0], 0.5, eps));
    verify(approx_f64(running[3], 8.0, eps));

    let mixed: list<f64> = [0.0, 12.0, 0.0 - 2.0, 5.0];
    verify(approx_f64(min(mixed), 0.0 - 2.0, eps));
    verify(approx_f64(max(mixed), 12.0, eps));
    verify(any_nonzero(mixed));
    verify(!all_nonzero(mixed));
}

#[test]
fn test_simd_boolean_reductions() {
    let all_flags: list<bool> = [true, true, true];
    let mixed_flags: list<bool> = [true, false, true];
    let empty_flags: list<bool> = [];
    let zeros: list<i32> = [0, 0, 0];
    let nonzeros: list<i32> = [1, 2, 3];
    let empty_numbers: list<i32> = [];

    verify(any(all_flags));
    verify(all(all_flags));
    verify(any(mixed_flags));
    verify(!all(mixed_flags));
    verify(!any(empty_flags));
    verify(all(empty_flags));
    verify(!any_nonzero(zeros));
    verify(all_nonzero(nonzeros));
    verify(!any_nonzero(empty_numbers));
    verify(all_nonzero(empty_numbers));
}

#[test]
fn test_simd_bitset_ops_and_reductions() {
    let ar: Result<BitSet, str8> = BitSet::new(130);
    let br: Result<BitSet, str8> = BitSet::new(130);
    verify(!ar.is_err());
    verify(!br.is_err());

    let a: BitSet = ar.unwrap();
    let b: BitSet = br.unwrap();
    verify(a.resize(130, false) == 0);
    verify(b.resize(130, false) == 0);

    verify(a.set(0, true) == 0);
    verify(a.set(64, true) == 0);
    verify(a.set(129, true) == 0);
    verify(b.set(64, true) == 0);
    verify(b.set(65, true) == 0);
    verify(b.set(129, true) == 0);

    verify(any(a));
    verify(!all(a));
    verify(count_ones(a) == 3);

    verify(bit_and_eq(a, b) == 0);
    verify(count_ones(a) == 2);
    verify(a.get_fast(64) == 1);
    verify(a.get_fast(129) == 1);
    verify(a.get_fast(0) == 0);

    verify(bit_xor_eq(a, b) == 0);
    verify(count_ones(a) == 1);
    verify(a.get_fast(65) == 1);

    verify(bit_or_eq(a, b) == 0);
    verify(count_ones(a) == 3);

    verify(bit_not_eq(a) == 0);
    verify(count_ones(a) == 127);
    let after_not_64: Result<bool, str8> = a.get(64);
    let after_not_65: Result<bool, str8> = a.get(65);
    let after_not_129: Result<bool, str8> = a.get(129);
    verify(!after_not_64.is_err() && !after_not_64.unwrap());
    verify(!after_not_65.is_err() && !after_not_65.unwrap());
    verify(!after_not_129.is_err() && !after_not_129.unwrap());
    verify(any(a));
    verify(!all(a));

    verify(a.set(64, true) == 0);
    verify(a.set(65, true) == 0);
    verify(a.set(129, true) == 0);
    verify(all(a));

    a.close();
    b.close();
}
