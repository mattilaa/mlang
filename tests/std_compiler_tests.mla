    let o: Result<i32, str8> = s.open_document(uri, "mlang", src, 1);
    if o.is_err(): { return 1; }

    let safe1_r: Result<i32, str8> = s.rename_is_safe(uri, 3, 19, "gamma");
    if safe1_r.is_err(): { return 1; }
    if safe1_r.unwrap() != 1: { return 1; }

    let safe2_r: Result<i32, str8> = s.rename_is_safe(uri, 3, 19, "beta");
    if safe2_r.is_err(): { return 1; }
    if safe2_r.unwrap() != 0: { return 1; }

    let _ = s.destroy();
    return 0;
}

#[test]
fn test_compiler_semantic_cache_api() -> i32 {
    let sr: Result<Session, str8> = session_create();
    if sr.is_err(): { return 1; }
    let s: Session = sr.unwrap();

    let util_uri: str8 = "file:///ws/lib/cache_api_util.mla";
    let main_uri: str8 = "file:///ws/cache_api_main.mla";
    let util_src: str8 = "fn util_cache() -> i32 { return 5; }";
    let main_src: str8 = "use lib::cache_api_util::util_cache;\nfn main() -> i32 { return util_cache(); }";

    let o1: Result<i32, str8> = s.open_document(util_uri, "mlang", util_src, 1);
    if o1.is_err(): { return 1; }
    let o2: Result<i32, str8> = s.open_document(main_uri, "mlang", main_src, 1);
    if o2.is_err(): { return 1; }

    let warm_r: Result<i32, str8> = s.semantic_cache_warm(main_uri);
    if warm_r.is_err(): { return 1; }

    let def_r: Result<DefinitionLocation, str8> = s.definition(main_uri, 2, 27);
    if def_r.is_err(): { return 1; }
    let def: DefinitionLocation = def_r.unwrap();
    if contains(def.name, "util_cache") == 0: { return 1; }

    let clr_r: Result<i32, str8> = s.semantic_cache_clear();
    if clr_r.is_err(): { return 1; }

    let def2_r: Result<DefinitionLocation, str8> = s.definition(main_uri, 2, 27);
    if def2_r.is_err(): { return 1; }
    let def2: DefinitionLocation = def2_r.unwrap();
    if contains(def2.name, "util_cache") == 0: { return 1; }

    let _ = s.destroy();
    return 0;
}

#[test]
fn test_compiler_symbol_typed_metadata() -> i32 {
    let sr: Result<Session, str8> = session_create();
    if sr.is_err(): { return 1; }
    let s: Session = sr.unwrap();

    let uri: str8 = "mem://typed_symbol_meta.mla";
    let src: str8 = "fn helper(x: i32) -> i32 { return x; }\nfn main() -> i32 {\n  let alpha: i32 = helper(1);\n  return alpha;\n}";
    let o: Result<i32, str8> = s.open_document(uri, "mlang", src, 1);
    if o.is_err(): { return 1; }

    let cr: Result<i32, str8> = s.document_symbol_count(uri);
    if cr.is_err(): { return 1; }
    let count: i32 = cr.unwrap();
    if count <= 0: { return 1; }

    var saw_helper_signature: i32 = 0;
    var saw_alpha_type: i32 = 0;
    for i in 0..count {
        let sym_r: Result<DocumentSymbol, str8> = s.document_symbol_get(uri, i);
        if sym_r.is_err(): { return 1; }
        let sym: DocumentSymbol = sym_r.unwrap();
        if contains(sym.name, "helper") == 1: {
            if contains(sym.signature, "helper") == 1: {
                saw_helper_signature = 1;
            }
        }
        if contains(sym.name, "alpha") == 1: {
            if contains(sym.type_info, "i32") == 1: {
                saw_alpha_type = 1;
            }
        }
    }

    if saw_helper_signature != 1: { return 1; }
    if saw_alpha_type != 1: { return 1; }
    let _ = s.destroy();
    return 0;
}

#[test]
fn test_compiler_resolve_symbol_overload_metadata() -> i32 {
    let sr: Result<Session, str8> = session_create();
    if sr.is_err(): { return 1; }
    let s: Session = sr.unwrap();

    let uri: str8 = "mem://resolve_overload_meta.mla";
    let src: str8 = "fn foo(x: i32) -> i32 { return x; }\nfn foo(x: i64) -> i64 { return x; }\nfn main() -> i32 {\n  let y: i32 = foo(1);\n  return y;\n}";
    let o: Result<i32, str8> = s.open_document(uri, "mlang", src, 1);
    if o.is_err(): { return 1; }

    let rr: Result<ResolvedSymbol, str8> = s.resolve_symbol(uri, 4, 16);
    if rr.is_err(): { return 1; }
    let rs: ResolvedSymbol = rr.unwrap();
    if contains(rs.name, "foo") == 0: { return 1; }
    if rs.overload_count < 2: { return 1; }
    if rs.kind != 1: { return 1; }
    if rs.from_current_document != 1: { return 1; }
    if contains(rs.signature, "foo") == 0: { return 1; }

    let _ = s.destroy();
    return 0;
}

#[test]
fn test_compiler_resolve_struct_member_self_access() -> i32 {
    let sr: Result<Session, str8> = session_create();
    if sr.is_err(): { return 1; }
    let s: Session = sr.unwrap();

    let uri: str8 = "mem://resolve_self_field.mla";
    let src: str8 = "struct Counter { var value: i32; };\nimpl Counter {\n  fn increment(self: Counter) -> Counter {\n    return Counter { value: self.value + 1 };\n  }\n}\nfn main() -> i32 {\n  let c: Counter = Counter { value: 1 };\n  let n: Counter = c.increment();\n  return n.value;\n}";
    let o: Result<i32, str8> = s.open_document(uri, "mlang", src, 1);
    if o.is_err(): { return 1; }

    var resolved_col: i32 = 0;
    var rs: ResolvedSymbol = ResolvedSymbol {
        id: String::new(),
        name: String::new(),
        uri: String::new(),
        type_info: String::new(),
        signature: String::new(),
        kind: 0,
        line: 0,
        column: 0,
        overload_count: 0,
        from_current_document: 0
    };
    for c in 30..40 {
        let rr: Result<ResolvedSymbol, str8> = s.resolve_symbol(uri, 4, c);
        if rr.is_err(): { continue; }
        let candidate: ResolvedSymbol = rr.unwrap();
        if contains(candidate.signature, "field Counter::value") == 1: {
            resolved_col = c;
            rs = candidate;
            break;
        }
    }
    if resolved_col == 0: { return 1; }
    if rs.kind != 2: { return 1; }
    if contains(rs.name, "value") == 0: { return 1; }

    let dr: Result<DefinitionLocation, str8> = s.definition(uri, 4, resolved_col);
    if dr.is_err(): { return 1; }
    let def: DefinitionLocation = dr.unwrap();
    if contains(def.name, "value") == 0: { return 1; }
    if def.line <= 0: { return 1; }

    let _ = s.destroy();
    return 0;
}

#[test]
fn test_compiler_definition_struct_member_self_access() -> i32 {
    let sr: Result<Session, str8> = session_create();
    if sr.is_err(): { return 1; }
    let s: Session = sr.unwrap();

    let uri: str8 = "mem://member_definition_self.mla";
    let src: str8 = "struct Counter {\n  var value: i32;\n  fn inc(self: Counter) -> Counter {\n    return Counter { value: self.value + 1 };\n  }\n};";

    let od: Result<i32, str8> = s.open_document(uri, "mlang", src, 1);
    if od.is_err(): { return 1; }

    // Cursor on "value" in "self.value".
    let dr: Result<DefinitionLocation, str8> = s.definition(uri, 4, 34);
    if dr.is_err(): { return 1; }
    let d: DefinitionLocation = dr.unwrap();

    if contains(d.name, "value") == 0: { return 1; }
    if d.line != 2: { return 1; }
    if d.column <= 0: { return 1; }

    let _ = s.destroy();
    return 0;
}

#[test]
fn test_compiler_definition_method_params_and_member_access() -> i32 {
    let sr: Result<Session, str8> = session_create();
    if sr.is_err(): { return 1; }
    let s: Session = sr.unwrap();

    let uri: str8 = "mem://method_params_member_access.mla";
    let src: str8 = "struct Counter {\n  var value: i32;\n  pub fn add(self: Counter, amount: i32) -> Counter {\n    return Counter { value: self.value + amount };\n  }\n};";

    let od: Result<i32, str8> = s.open_document(uri, "mlang", src, 1);
    if od.is_err(): { return 1; }

    // Cursor on "value" in "self.value" should resolve to the struct field.
    let value_dr: Result<DefinitionLocation, str8> = s.definition(uri, 4, 34);
    if value_dr.is_err(): { return 1; }
    let value_def: DefinitionLocation = value_dr.unwrap();
    if contains(value_def.name, "value") == 0: { return 1; }
    if value_def.line != 2: { return 1; }

    // Cursor on "amount" usage should resolve to parameter declaration.
    let amount_dr: Result<DefinitionLocation, str8> = s.definition(uri, 4, 42);
    if amount_dr.is_err(): { return 1; }
    let amount_def: DefinitionLocation = amount_dr.unwrap();
    if contains(amount_def.name, "amount") == 0: { return 1; }
    if amount_def.line != 3: { return 1; }

    // Cursor on "self" usage should resolve to method parameter declaration.
    let self_dr: Result<DefinitionLocation, str8> = s.definition(uri, 4, 29);
    if self_dr.is_err(): { return 1; }
    let self_def: DefinitionLocation = self_dr.unwrap();
    if contains(self_def.name, "self") == 0: { return 1; }
    if self_def.line != 3: { return 1; }

    let _ = s.destroy();
    return 0;
}

#[test]
fn test_compiler_definition_prefers_member_object_symbol() -> i32 {
    let sr: Result<Session, str8> = session_create();
    if sr.is_err(): { return 1; }
    let s: Session = sr.unwrap();

    let uri: str8 = "mem://member_object_definition_prefer_lhs.mla";
    let src: str8 = "trait Summary {\n    fn summarize(&self) -> str8;\n}\n\nstruct SocialPost {\n    var username: str8;\n    var content: str8;\n    var reply: bool;\n    var repost: bool;\n};\n\nimpl Summary for SocialPost {\n    fn summarize(&self) -> str8 {\n        return format!(\"{}: {}\", self.username, self.content);\n    }\n}\n\nfn main() -> i32 {\n    let post: SocialPost = SocialPost {\n        username: \"alice\",\n        content: \"Hello from traits\",\n        reply: false,\n        repost: false\n    };\n\n    println!(\"{}\", post.summarize());\n    return 0;\n}\n";

    let od: Result<i32, str8> = s.open_document(uri, "mlang", src, 1);
    if od.is_err(): { return 1; }

    // Cursor on "post" in "post.summarize()" should resolve to local variable.
    let post_dr: Result<DefinitionLocation, str8> = s.definition(uri, 26, 20);
    if post_dr.is_err(): { return 1; }
    let post_def: DefinitionLocation = post_dr.unwrap();
    if contains(post_def.name, "post") == 0: { return 1; }
    if post_def.line != 19: { return 1; }

    // Cursor on "summarize" should still resolve to the method declaration.
    let method_dr: Result<DefinitionLocation, str8> = s.definition(uri, 26, 27);
    if method_dr.is_err(): { return 1; }
    let method_def: DefinitionLocation = method_dr.unwrap();
    if contains(method_def.name, "summarize") == 0: { return 1; }

    let _ = s.destroy();
    return 0;
}

#[test]
fn test_compiler_syntax_diag_get() {
    verify(test_compiler_syntax_diag_get_impl() == 0);
}

fn read_child_stdout_all(out: ChildStdout) -> str8 {
    var buf: str8 = String::with_capacity(8192);
    let rr: Result<i64, str8> = out.read(buf, 8192);
    if rr.is_err(): { return ""; }
    let _ = out.close();
    return buf;
}

fn read_child_stderr_all(err: ChildStderr) -> str8 {
    var buf: str8 = String::with_capacity(8192);
    let rr: Result<i64, str8> = err.read(buf, 8192);
    if rr.is_err(): { return ""; }
    let _ = err.close();
    return buf;
}

fn run_compiler_capture(args: list<str8>) -> i32 {
    let cr: Result<Child, str8> = spawn("./build/mlang", args);
    if cr.is_err(): { return -1; }
    let child: Child = cr.unwrap();
    let status_r: Result<ExitStatus, str8> = child.wait();
    let _ = child.close();
    if status_r.is_err(): { return -1; }
    let status: ExitStatus = status_r.unwrap();
    return status.code();
}

#[test]
fn test_compiler_test_output_uses_robot_style_progress_format() -> i32 {
    let src_path: str8 = "/tmp/mlang_test_output_format_case.mla";
    let src: str8 = "mod std::testing;\nuse std::testing::verify_true;\n\n#[test]\nfn test_output_format_uses_progress_and_timestamp() {\n    verify_true(true);\n}\n";
    let wr: Result<i32, str8> = write_all_text(src_path, src);
    if wr.is_err(): { return 1; }

    let args: list<str8> = ["--tests", src_path, "-L", "build", "-lmlang_std"];
    let cr: Result<Child, str8> = spawn("./build/mlang", args);
    if cr.is_err(): { return 1; }
    let child: Child = cr.unwrap();

    let out_r: Result<ChildStdout, str8> = child.stdout();
    if out_r.is_err(): { return 1; }
    let out: ChildStdout = out_r.unwrap();
    let err_r: Result<ChildStderr, str8> = child.stderr();
    if err_r.is_err(): { return 1; }
    let err: ChildStderr = err_r.unwrap();

    let status_r: Result<ExitStatus, str8> = child.wait();
    if status_r.is_err(): { return 1; }
    let status: ExitStatus = status_r.unwrap();
    let stdout_text: str8 = read_child_stdout_all(out);
    let stderr_text: str8 = read_child_stderr_all(err);
    let _ = child.close();

    if status.code() != 0: { return 1; }
    if contains(stdout_text, "[1/1]") == 0: { return 1; }
    if contains(stdout_text, "[PASS] mlang_test_output_format_case.output format uses progress and timestamp") == 0: { return 1; }
    if contains(stdout_text, "[SUMMARY] total=1 pass=1 fail=0") == 0: { return 1; }
    if contains(stderr_text, "[  FAILED  ]") == 1: { return 1; }
    return 0;
}

#[test]
fn test_compiler_test_output_preserves_failing_keyword_details() -> i32 {
    let src_path: str8 = "/tmp/mlang_test_output_failure_case.mla";
    let src: str8 = "mod std::testing;\nuse std::testing::verify_eq_i32;\n\n#[test]\nfn test_failure_shows_keyword_details() {\n    verify_eq_i32(1, 2);\n}\n";
    let wr: Result<i32, str8> = write_all_text(src_path, src);
    if wr.is_err(): { return 1; }

    let args: list<str8> = ["--tests", src_path, "-L", "build", "-lmlang_std"];
    let cr: Result<Child, str8> = spawn("./build/mlang", args);
    if cr.is_err(): { return 1; }
    let child: Child = cr.unwrap();

    let out_r: Result<ChildStdout, str8> = child.stdout();
    if out_r.is_err(): { return 1; }
    let out: ChildStdout = out_r.unwrap();
    let err_r: Result<ChildStderr, str8> = child.stderr();
    if err_r.is_err(): { return 1; }
    let err: ChildStderr = err_r.unwrap();

    let status_r: Result<ExitStatus, str8> = child.wait();
    if status_r.is_err(): { return 1; }
    let status: ExitStatus = status_r.unwrap();
    let stdout_text: str8 = read_child_stdout_all(out);
    let stderr_text: str8 = read_child_stderr_all(err);
    let _ = child.close();

    if status.code() == 0: { return 1; }
    if contains(stdout_text, "[1/1]") == 0: { return 1; }
    if contains(stdout_text, "[FAIL] mlang_test_output_failure_case.failure shows keyword details") == 0: { return 1; }
    if contains(stderr_text, "verify_eq(i32): expected=1 actual=2") == 0: { return 1; }
    return 0;
}

#[test]
fn test_compiler_inline_asm_emit_llvm_nonvolatile_has_no_sideeffect() -> i32 {
    let src_path: str8 = "/tmp/mlang_inline_asm_nonvolatile_emit.mla";
    let ll_path: str8 = "/tmp/mlang_inline_asm_nonvolatile_emit.ll";
    let src: str8 = "fn main() -> i32 {\n    let value: i64 = 9;\n    let copy: i64 = asm(i64, \"\", value);\n    if copy != 9 { return 1; }\n    return 0;\n}\n";
    let wr: Result<i32, str8> = write_all_text(src_path, src);
    if wr.is_err() { return 1; }

    let rc: i32 = run_compiler_capture(["-emit-llvm", src_path, "-o", ll_path, "-L", "build", "-lmlang_std"]);
    if rc != 0 { return 1; }

    let text_r: Result<str8, str8> = read_all_text(ll_path);
    if text_r.is_err() { return 1; }
    let text: str8 = text_r.unwrap();
    if contains(text, "call i64 asm") == 0 { return 1; }
    if contains(text, "sideeffect") == 1 { return 1; }
    return 0;
}

#[test]
fn test_compiler_inline_asm_emit_llvm_volatile_uses_sideeffect() -> i32 {
    let src_path: str8 = "/tmp/mlang_inline_asm_volatile_emit.mla";
    let ll_path: str8 = "/tmp/mlang_inline_asm_volatile_emit.ll";
    let src: str8 = "fn main() -> i32 {\n    let value: i64 = 9;\n    asm volatile(void, \"\", value);\n    return 0;\n}\n";
    let wr: Result<i32, str8> = write_all_text(src_path, src);
    if wr.is_err() { return 1; }

    let rc: i32 = run_compiler_capture(["-emit-llvm", src_path, "-o", ll_path, "-L", "build", "-lmlang_std"]);
    if rc != 0 { return 1; }

    let text_r: Result<str8, str8> = read_all_text(ll_path);
    if text_r.is_err() { return 1; }
    let text: str8 = text_r.unwrap();
    if contains(text, "call void asm sideeffect") == 0 { return 1; }
    return 0;
}
