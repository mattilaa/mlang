    return 0;
}

#[test]
fn test_compiler_trait_default_method_inherited_when_omitted() -> i32 {
    if mkdir_p("/tmp/mlang_trait_default_method_inherited").is_err(): { return 1; }
    let src_path: str8 = "/tmp/mlang_trait_default_method_inherited/main.mla";
    let src: str8 = "trait Greeter {\n  fn name(self: Self) -> str8;\n  fn greet(self: Self) -> str8 {\n    return self.name();\n  }\n}\npub struct F { var who: str8; };\nimpl Greeter for F {\n  fn name(self: F) -> str8 { return self.who; }\n}\nfn main() -> i32 {\n  let f: F = F { who: \"x\" };\n  println!(\"{}\", f.greet());\n  return 0;\n}\n";
    let wr: Result<i32, str8> = write_all_text(src_path, src);
    if wr.is_err(): { return 1; }
    let rc: i32 = run_compiler_capture(["-c", src_path, "-L", "build", "-lmlang_std"]);
    return rc == 0 ? 0 : 1;
}

