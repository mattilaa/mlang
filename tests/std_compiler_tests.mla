#[test]
fn test_compiler_super_trait_requires_super_impl() -> i32 {
    if mkdir_p("/tmp/mlang_super_trait_missing").is_err(): { return 1; }
    let src_path: str8 = "/tmp/mlang_super_trait_missing/main.mla";
    let src: str8 = "trait Display {\n  fn show(self: Self) -> str8;\n}\ntrait Loud: Display {\n  fn shout(self: Self) -> str8;\n}\npub struct W { var t: str8; };\nimpl Loud for W {\n  fn shout(self: W) -> str8 { return self.t; }\n}\nfn main() -> i32 { return 0; }\n";
    let wr: Result<i32, str8> = write_all_text(src_path, src);
    if wr.is_err(): { return 1; }
    let run: CompilerRunCapture =
        run_compiler_capture_stdout_stderr(["-c", src_path, "-L", "build", "-lmlang_std"]);
    if run.rc == 0 { return 1; }
    return contains(run.stderr_text, "trait 'Loud' for struct 'W' requires struct to also implement super-trait 'Display'") == 1 ? 0 : 1;
}

