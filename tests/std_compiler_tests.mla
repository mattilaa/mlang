#[test]
fn test_compiler_stable_symbol_id_and_references() -> i32 {
    let sr: Result<Session, str8> = session_create();
    if sr.is_err(): { return 1; }
    let s: Session = sr.unwrap();

    let util_uri: str8 = "file:///ws/lib/id_refs_util.mla";
    let main_uri: str8 = "file:///ws/id_refs_main.mla";
    let util_src: str8 = "fn util_ref() -> i32 { return 9; }";
    let main_src: str8 = "use lib::id_refs_util::util_ref;\nfn main() -> i32 {\n  let a: i32 = util_ref();\n  let b: i32 = util_ref();\n  return a + b;\n}";

    let o1: Result<i32, str8> = s.open_document(util_uri, "mlang", util_src, 1);
    if o1.is_err(): { return 1; }
    let o2: Result<i32, str8> = s.open_document(main_uri, "mlang", main_src, 1);
    if o2.is_err(): { return 1; }

    let def_r: Result<DefinitionLocation, str8> = s.definition(main_uri, 3, 17);
    if def_r.is_err(): { return 1; }
    let def: DefinitionLocation = def_r.unwrap();
    if contains(def.id, "sym_") == 0: { return 1; }

    let rc_r: Result<i32, str8> = s.references_count(main_uri, 3, 17);
    if rc_r.is_err(): { return 1; }
    let rc: i32 = rc_r.unwrap();
    if rc < 3: { return 1; }

    var found_util_def: i32 = 0;
    for i in 0..rc {
        let rr: Result<ReferenceLocation, str8> = s.reference_get(main_uri, 3, 17, i);
        if rr.is_err(): { return 1; }
        let r: ReferenceLocation = rr.unwrap();
        if contains(r.uri, "id_refs_util.mla") == 1: {
            if r.line == 1: {
                found_util_def = 1;
            }
        }
    }
    if found_util_def != 1: { return 1; }

    let _ = s.destroy();
    return 0;
}

