    let lib_src: str8 = "trait Summary {\n  fn summarize(self: Self) -> str8;\n}\npub struct Post { var title: str8; };\nimpl Summary for Post {\n  fn summarize(self: Post) -> str8 {\n    return self.title;\n  }\n}\npub struct Holder<T: Summary> {\n  var value: T;\n};\nimpl<T: Summary> Holder {\n  pub fn new(value: T) -> Holder<T> {\n    return Holder<T> { value: value };\n  }\n  pub fn summary(self: Holder<T>) -> str8 {\n    return self.value.summarize();\n  }\n}\n";
    let main_src: str8 = "mod lib::summary;\nuse lib::summary::Post;\nuse lib::summary::Holder;\nfn main() -> i32 {\n  let post: Post = Post { title: \"ok\" };\n  let holder: Holder<Post> = lib::summary::Holder<Post>::new(post);\n  let text: str8 = holder.summary();\n  return text == \"ok\" ? 0 : 1;\n}\n";
    let wr1: Result<i32, str8> = write_all_text(lib_path, lib_src);
    if wr1.is_err(): { return 1; }
    let wr2: Result<i32, str8> = write_all_text(main_path, main_src);
    if wr2.is_err(): { return 1; }
    let rc: i32 = run_compiler_capture(["-c", main_path, "-L", "build", "-lmlang_std"]);
    return rc == 0 ? 0 : 1;
}

#[test]
fn test_compiler_dyn_trait_object_method_call_allowed() -> i32 {
    if mkdir_p("/tmp/mlang_dyn_trait_object_call_ok/lib").is_err(): { return 1; }
    let lib_path: str8 = "/tmp/mlang_dyn_trait_object_call_ok/lib/summary.mla";
    let main_path: str8 = "/tmp/mlang_dyn_trait_object_call_ok/main.mla";
    let bin_path: str8 = "/tmp/mlang_dyn_trait_object_call_ok/dyn_trait_object_bin";
    let lib_src: str8 = "trait Summary {\n  fn score(self: Self) -> i32;\n}\npub struct Post { var score_value: i32; };\nimpl Summary for Post {\n  fn score(self: Post) -> i32 {\n    return self.score_value;\n  }\n}\npub fn wrap(item: dyn Summary) -> dyn Summary {\n  return item;\n}\npub fn show_score(item: dyn Summary) -> i32 {\n  return item.score();\n}\n";
    let main_src: str8 = "mod lib::summary;\nfn main() -> i32 {\n  return 0;\n}\n";
    let wr1: Result<i32, str8> = write_all_text(lib_path, lib_src);
    if wr1.is_err(): { return 1; }
    let wr2: Result<i32, str8> = write_all_text(main_path, main_src);
    if wr2.is_err(): { return 1; }

    let build: CompilerRunCapture =
        run_compiler_capture_stdout_stderr(["-o", bin_path, main_path, "-L", "build", "-lmlang_std"]);
    if build.rc != 0 { return 1; }

    let run_cr: Result<Child, str8> = spawn(bin_path, []);
    if run_cr.is_err(): { return 1; }
    let child: Child = run_cr.unwrap();
    let out_r: Result<ChildStdout, str8> = child.stdout();
    if out_r.is_err(): { return 1; }
    let out: ChildStdout = out_r.unwrap();
    let err_r: Result<ChildStderr, str8> = child.stderr();
    if err_r.is_err(): { return 1; }
    let err: ChildStderr = err_r.unwrap();
    let status_r: Result<ExitStatus, str8> = child.wait();
    if status_r.is_err(): { return 1; }
    let status: ExitStatus = status_r.unwrap();
    let stdout_text: str8 = read_child_stdout_all(out);
    let stderr_text: str8 = read_child_stderr_all(err);
    let _ = child.close();

    if status.code() != 0 { return 1; }
    if contains(stdout_text, "trait object dispatch") == 0 { return 1; }
    if stderr_text != "" { return 1; }
    return 0;
}

