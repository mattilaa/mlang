fn test_compiler_open_change_close_impl() -> i32 {
    let sr: Result<Session, str8> = session_create();
    if sr.is_err(): { return 1; }
    let s: Session = sr.unwrap();

    let uri: str8 = "mem://open_change_close.mla";
    let src1: str8 = "fn main() -> i32 { return 0; }";
    let src2: str8 = "fn main() -> i32 { return 1; }";

    let o: Result<i32, str8> = s.open_document(uri, "mlang", src1, 1);
    if o.is_err(): { return 1; }

    let c: Result<i32, str8> = s.change_document(uri, src2, 2);
    if c.is_err(): { return 1; }

    let cl: Result<i32, str8> = s.close_document(uri);
    if cl.is_err(): { return 1; }

    let d: Result<i32, str8> = s.destroy();
    if d.is_err(): { return 1; }
    return 0;
}

#[test]
fn test_compiler_open_change_close() {
    verify(test_compiler_open_change_close_impl() == 0);
}

fn test_compiler_main_without_explicit_return_type_defaults_i32_impl() -> i32 {
    let sr: Result<Session, str8> = session_create();
    if sr.is_err(): { return 1; }
    let s: Session = sr.unwrap();

    let uri: str8 = "mem://main_no_arrow_defaults_i32.mla";
    let src: str8 = "fn main() {\n  let i: i32 = 1;\n  if i == 1 {\n    println!(\"hello\");\n  }\n}";
    let od: Result<i32, str8> = s.open_document(uri, "mlang", src, 1);
    if od.is_err(): { return 1; }

    let cr: Result<i32, str8> = s.syntax_diagnostic_count(uri);
    if cr.is_err(): { return 1; }
    if cr.unwrap() != 0: { return 1; }

    let _ = s.destroy();
    return 0;
}

#[test]
fn test_compiler_main_without_explicit_return_type_defaults_i32() {
    verify(test_compiler_main_without_explicit_return_type_defaults_i32_impl() == 0);
}

fn test_compiler_syntax_diag_get_impl() -> i32 {
    let sr: Result<Session, str8> = session_create();
    if sr.is_err(): { return 1; }
    let s: Session = sr.unwrap();

    let uri: str8 = "mem://diag_get.mla";
    let src: str8 = "fn main() -> i32 { if (1 > 0) { return 0; ";
    let od: Result<i32, str8> = s.open_document(uri, "mlang", src, 1);
    if od.is_err(): { return 1; }

    let cr: Result<i32, str8> = s.syntax_diagnostic_count(uri);
    if cr.is_err(): { return 1; }
    let count: i32 = cr.unwrap();
    if count <= 0: { return 1; }

    let dr: Result<SyntaxDiagnostic, str8> = s.syntax_diagnostic_get(uri, 0);
    if dr.is_err(): { return 1; }
    let d: SyntaxDiagnostic = dr.unwrap();
    if d.line <= 0: { return 1; }
    if d.column <= 0: { return 1; }
    if contains(d.message, "unclosed delimiter") == 0: { return 1; }

    let _ = s.destroy();
    return 0;
}

#[test]
fn test_compiler_hover_and_completion() -> i32 {
    let sr: Result<Session, str8> = session_create();
    if sr.is_err(): { return 1; }
    let s: Session = sr.unwrap();

    let uri: str8 = "mem://hover_completion.mla";
    let src: str8 = "fn helper() -> i32 { return 1; }\nfn main() -> i32 {\n  let alpha: i32 = helper();\n  let al: i32 = alpha;\n  return alpha;\n}";

    let od: Result<i32, str8> = s.open_document(uri, "mlang", src, 1);
    if od.is_err(): { return 1; }

    let hr: Result<str8, str8> = s.hover(uri, 3, 8);
    if hr.is_err(): { return 1; }
    let h: str8 = hr.unwrap();
    if contains(h, "alpha") == 0: { return 1; }

    let ccr: Result<i32, str8> = s.completion_count(uri, 4, 9);
    if ccr.is_err(): { return 1; }
    let cc: i32 = ccr.unwrap();
    if cc <= 0: { return 1; }

    var mut_found: i32 = 0;
    for i in 0..cc {
        let ir: Result<str8, str8> = s.completion_get(uri, 4, 9, i);
        if ir.is_err(): { return 1; }
        let item: str8 = ir.unwrap();
        if contains(item, "alpha") == 1: {
            mut_found = 1;
        }
    }
    if mut_found != 1: { return 1; }

    let _ = s.destroy();
    return 0;
}

#[test]
fn test_compiler_property_accessor_completion_docs() -> i32 {
    let sr: Result<Session, str8> = session_create();
    if sr.is_err(): { return 1; }
    let s: Session = sr.unwrap();

    let uri: str8 = "mem://property_completion_docs.mla";
    let src: str8 = "struct Device {\n  /// @brief Battery percentage exposed through property accessors.\n  @property var value: i32;\n};\nfn main() -> i32 {\n  var d: Device = Device { value: 1 };\n  let current: i32 = d.getValue();\n  d.setValue(2);\n  return current;\n}";

    let od: Result<i32, str8> = s.open_document(uri, "mlang", src, 1);
    if od.is_err(): { return 1; }

    let sym_cr: Result<i32, str8> = s.document_symbol_count(uri);
    if sym_cr.is_err(): { return 1; }
    let sym_count: i32 = sym_cr.unwrap();
    if sym_count <= 0: { return 1; }

    var saw_get_doc: i32 = 0;
    var saw_set_doc: i32 = 0;
    for i in 0..sym_count {
        let sym_r: Result<DocumentSymbol, str8> = s.document_symbol_get(uri, i);
        if sym_r.is_err(): { return 1; }
        let sym: DocumentSymbol = sym_r.unwrap();
        if contains(sym.name, "getValue") == 1 {
            if contains(sym.documentation, "Battery percentage exposed through property accessors.") == 1 {
                saw_get_doc = 1;
            }
        }
        if contains(sym.name, "setValue") == 1 {
            if contains(sym.documentation, "Battery percentage exposed through property accessors.") == 1 {
                saw_set_doc = 1;
            }
        }
    }

    if saw_get_doc != 1: { return 1; }
    if saw_set_doc != 1: { return 1; }

    let _ = s.destroy();
    return 0;
}

