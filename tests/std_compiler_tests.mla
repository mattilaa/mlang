#[test]
fn test_compiler_multiple_trait_bounds_satisfied() -> i32 {
    if mkdir_p("/tmp/mlang_multi_bound_ok").is_err(): { return 1; }
    let src_path: str8 = "/tmp/mlang_multi_bound_ok/main.mla";
    let src: str8 = "trait A { fn a(self: Self) -> i32; }\ntrait B { fn b(self: Self) -> i32; }\npub struct X { var v: i32; };\nimpl A for X { fn a(self: X) -> i32 { return self.v; } }\nimpl B for X { fn b(self: X) -> i32 { return self.v; } }\npub struct Box<T: A + B> { var inner: T; };\nimpl<T: A + B> Box {\n  pub fn new(inner: T) -> Box<T> { return Box<T> { inner: inner }; }\n}\nfn main() -> i32 {\n  let x: X = X { v: 1 };\n  let b: Box<X> = Box<X>::new(x);\n  return 0;\n}\n";
    let wr: Result<i32, str8> = write_all_text(src_path, src);
    if wr.is_err(): { return 1; }
    let rc: i32 = run_compiler_capture(["-c", src_path, "-L", "build", "-lmlang_std"]);
    return rc == 0 ? 0 : 1;
}

#[test]
fn test_compiler_multiple_trait_bounds_partial_match_rejected() -> i32 {
    if mkdir_p("/tmp/mlang_multi_bound_partial").is_err(): { return 1; }
    let src_path: str8 = "/tmp/mlang_multi_bound_partial/main.mla";
    let src: str8 = "trait A { fn a(self: Self) -> i32; }\ntrait B { fn b(self: Self) -> i32; }\npub struct X { var v: i32; };\nimpl A for X { fn a(self: X) -> i32 { return self.v; } }\npub struct Box<T: A + B> { var inner: T; };\nimpl<T: A + B> Box {\n  pub fn new(inner: T) -> Box<T> { return Box<T> { inner: inner }; }\n}\nfn main() -> i32 {\n  let x: X = X { v: 1 };\n  let b: Box<X> = Box<X>::new(x);\n  return 0;\n}\n";
    let wr: Result<i32, str8> = write_all_text(src_path, src);
    if wr.is_err(): { return 1; }
    let run: CompilerRunCapture =
        run_compiler_capture_stdout_stderr(["-c", src_path, "-L", "build", "-lmlang_std"]);
    if run.rc == 0 { return 1; }
    return contains(run.stderr_text, "must implement trait 'B'") == 1 ? 0 : 1;
}
