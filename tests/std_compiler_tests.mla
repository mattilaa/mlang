#[test]
fn test_compiler_instance_method_called_as_associated_function_rejected() -> i32 {
    if mkdir_p("/tmp/mlang_instance_method_called_as_associated").is_err(): { return 1; }
    let src_path: str8 = "/tmp/mlang_instance_method_called_as_associated/main.mla";
    let src: str8 = "pub struct Counter { var value: i32; };\nimpl Counter {\n  pub fn inc(self: Counter) -> Counter {\n    return Counter { value: self.value + 1 };\n  }\n}\nfn main() -> i32 {\n  let c: Counter = Counter::inc(1);\n  return c.value;\n}\n";
    let wr: Result<i32, str8> = write_all_text(src_path, src);
    if wr.is_err(): { return 1; }
    let run: CompilerRunCapture =
        run_compiler_capture_stdout_stderr(["-c", src_path, "-L", "build", "-lmlang_std"]);
    if run.rc == 0 { return 1; }
    return contains(run.stderr_text, "instance method 'Counter::inc' must be called on a value") == 1 ? 0 : 1;
}

