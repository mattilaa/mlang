#[test]
fn test_compiler_document_symbols_and_definition() -> i32 {
    let sr: Result<Session, str8> = session_create();
    if sr.is_err(): { return 1; }
    let s: Session = sr.unwrap();

    let uri: str8 = "mem://symbols_definition.mla";
    let src: str8 = "mod std::io;\nstruct Box { var value: i32; };\nfn helper() -> i32 { return 1; }\nfn main() -> i32 {\n  let alpha: i32 = helper();\n  return alpha;\n}";
    let od: Result<i32, str8> = s.open_document(uri, "mlang", src, 1);
    if od.is_err(): { return 1; }

    let cr: Result<i32, str8> = s.document_symbol_count(uri);
    if cr.is_err(): { return 1; }
    let count: i32 = cr.unwrap();
    if count <= 0: { return 1; }

    var saw_main: i32 = 0;
    var saw_alpha: i32 = 0;
    for i in 0..count {
        let sym_r: Result<DocumentSymbol, str8> = s.document_symbol_get(uri, i);
        if sym_r.is_err(): { return 1; }
        let sym: DocumentSymbol = sym_r.unwrap();
        if contains(sym.name, "main") == 1: {
            saw_main = 1;
        }
        if contains(sym.name, "alpha") == 1: {
            saw_alpha = 1;
        }
    }
    if saw_main != 1: { return 1; }
    if saw_alpha != 1: { return 1; }

    let def_r: Result<DefinitionLocation, str8> = s.definition(uri, 6, 11);
    if def_r.is_err(): { return 1; }
    let def: DefinitionLocation = def_r.unwrap();
    if contains(def.name, "alpha") == 0: { return 1; }
    if def.line != 5: { return 1; }
    if contains(def.uri, "symbols_definition.mla") == 0: { return 1; }

    let _ = s.destroy();
    return 0;
}

