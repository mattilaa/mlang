mod std::testing;
mod std::ascii;
mod std::strbuf;
use std::ascii::AsciiKey;
use std::ascii::UnicodeBoxGlyph;
use std::ascii::ascii_box_fallback;
use std::ascii::ascii_density_glyph;
use std::ascii::unicode_box_glyph;
use std::ascii::unicode_density_glyph;
use std::strbuf::eq;
use std::testing::verify;

#[test]
fn test_ascii_key_basic_values() {
    verify(!(std::ascii::AsciiKey::Nul != 0));
    verify(!(std::ascii::AsciiKey::Esc != 27));
    verify(!(std::ascii::AsciiKey::Space != 32));
    verify(!(std::ascii::AsciiKey::Digit0 != 48));
    verify(!(std::ascii::AsciiKey::UpperA != 65));
    verify(!(std::ascii::AsciiKey::LowerA != 97));
    verify(!(std::ascii::AsciiKey::Del != 127));
    }

#[test]
fn test_ascii_key_ranges() {
    verify(!(std::ascii::AsciiKey::Digit9 < std::ascii::AsciiKey::Digit0));
    verify(!(std::ascii::AsciiKey::UpperZ < std::ascii::AsciiKey::UpperA));
    verify(!(std::ascii::AsciiKey::LowerZ < std::ascii::AsciiKey::LowerA));
    }

#[test]
fn test_unicode_box_codepoints() {
    verify(!(UnicodeBoxGlyph::LightHorizontal != 9472));
    verify(!(UnicodeBoxGlyph::LightVertical != 9474));
    verify(!(UnicodeBoxGlyph::LightDownRight != 9484));
    verify(!(UnicodeBoxGlyph::DoubleVerticalHorizontal != 9580));
    verify(!(UnicodeBoxGlyph::FullBlock != 9608));
    verify(!(UnicodeBoxGlyph::CheckMark != 10003));
    }

#[test]
fn test_unicode_box_glyph_mapping() {
    verify(!(eq(unicode_box_glyph(UnicodeBoxGlyph::LightHorizontal), "─") != 1));
    verify(!(eq(unicode_box_glyph(UnicodeBoxGlyph::LightVertical), "│") != 1));
    verify(!(eq(unicode_box_glyph(UnicodeBoxGlyph::LightDownRight), "┌") != 1));
    verify(!(eq(unicode_box_glyph(UnicodeBoxGlyph::FullBlock), "█") != 1));
    verify(!(eq(unicode_box_glyph(UnicodeBoxGlyph::RightArrow), "→") != 1));
    verify(!(eq(unicode_box_glyph(UnicodeBoxGlyph::CheckMark), "✓") != 1));
    }

#[test]
fn test_ascii_fallback_mapping() {
    verify(!(eq(ascii_box_fallback(UnicodeBoxGlyph::LightHorizontal), "-") != 1));
    verify(!(eq(ascii_box_fallback(UnicodeBoxGlyph::LightVertical), "|") != 1));
    verify(!(eq(ascii_box_fallback(UnicodeBoxGlyph::LightDownRight), "+") != 1));
    verify(!(eq(ascii_box_fallback(UnicodeBoxGlyph::FullBlock), "#") != 1));
    verify(!(eq(ascii_box_fallback(UnicodeBoxGlyph::LeftArrow), "<") != 1));
    verify(!(eq(ascii_box_fallback(UnicodeBoxGlyph::CheckMark), "v") != 1));
    }

#[test]
fn test_density_glyph_mapping() {
    verify(!(eq(unicode_density_glyph(0, 100), " ") != 1));
    verify(!(eq(unicode_density_glyph(10, 100), "▁") != 1));
    verify(!(eq(unicode_density_glyph(50, 100), "▅") != 1));
    verify(!(eq(unicode_density_glyph(100, 100), "█") != 1));
    verify(!(eq(ascii_density_glyph(0, 100), " ") != 1));
    verify(!(eq(ascii_density_glyph(20, 100), ":") != 1));
    verify(!(eq(ascii_density_glyph(100, 100), "#") != 1));
    }
