mod std::strbuf;
mod dsp::fft;
mod std::testing;
use std::strbuf::eq;
use std::strbuf::len as str_len;
use std::strbuf as sb;
use std::testing::verify_eq;
use std::testing::verify_eq_i32;
use std::testing::verify_false;
use std::testing::verify_true;

#[test]
fn test_main_default_return_works() {
    let x: i32 = 1;
    verify_eq_i32(1, x);
}

#[test]
fn test_if_else_flow_works() {
    let x: i32 = 2;
    verify_eq_i32(2, x);
}

#[test]
fn test_basic_list_and_map_types() {
    let ids: list<i32> = [7, 8, 9];
    verify_eq(3, ids.len());

    let scores: map<str8, i32> = {"Alice": 95, "Bob": 87};
    verify_eq(2, scores.len());
    verify_eq_i32(95, scores["Alice"]);
}

struct TestInnerState {
    var values: list<i64>;
};

struct TestOuterState {
    var inner: TestInnerState;
};

struct ToolbarTitle {
    let title: str8 = "";
    let height: i32 = 0;
};

struct ScreenLayout {
    let header: ToolbarTitle = ToolbarTitle { title: "", height: 0 };
    let body_width: i32 = 0;
};

#[test]
fn test_struct_field_list_mutation_methods() {
    var st: TestInnerState = TestInnerState { values: [] };
    st.values.push(7);
    st.values.push(9);
    verify_eq(2, st.values.len());
    verify_eq(9, st.values.pop());
    verify_eq(1, st.values.len());
    st.values.clear();
    verify_true(st.values.is_empty());
    verify_false(st.values.len() > 0);
}

#[test]
fn test_nested_struct_field_list_mutation_methods() {
    var st: TestOuterState = TestOuterState {
        inner: TestInnerState { values: [] }
    };
    st.inner.values.push(11);
    st.inner.values.push(22);
    verify_eq(2, st.inner.values.len());
    verify_eq(22, st.inner.values.pop());
    verify_eq(1, st.inner.values.len());
}

#[test]
fn test_typed_struct_init_accepts_contextual_nested_object_literal() {
    let view: ScreenLayout{
        header.title: "Main",
        header.height: 48,
        body_width: 900
    };

    verify_true(eq(view.header.title, "Main") == 1);
    verify_eq_i32(48, view.header.height);
    verify_eq_i32(900, view.body_width);
}

struct ParseStateLike {
    var passthrough: list<str8>;
    var backend: str8;
};

struct LoopRow {
    var tag: str8;
    var value: i32;
};

#[test]
fn test_struct_state_with_string_list_field_push_pattern() {
    var st: ParseStateLike = ParseStateLike {
        passthrough: [],
        backend: "mlang"
    };
    st.passthrough.push("--version");
    st.passthrough.push("--help");
    verify_eq(2, st.passthrough.len());
    verify_true(eq(st.passthrough.pop(), "--help") == 1);
    verify_true(eq(st.passthrough.pop(), "--version") == 1);
}

#[test]
fn test_condition_allows_indexed_or_chain() {
    let out: list<i64> = [1, 0, 2, 0, 3, 0, 4, 0];
    verify_true(out[0] == 1 && out[2] == 2 && out[4] == 3 && out[6] == 4);
}

#[test]
fn test_use_item_alias_resolves() {
    verify_eq(3, str_len("abc"));
}

#[test]
fn test_use_module_alias_resolves() {
    verify_eq(4, sb::len("abcd"));
}

#[test]
fn test_qualified_module_function_call_in_expression() {
    let data: list<i64> = [1, 0, 0, 0, 0, 0, 0, 0];
    let probe: list<i64> = dsp::fft::forward(data);
    verify_true(probe.len() > 0);
    let out: list<i64> = dsp::fft::inverse(
        dsp::fft::forward([1, 0, 0, 0, 0, 0, 0, 0])
    );
    verify_true(out.len() > 0);
}

#[test]
fn test_for_in_list_of_struct_with_str8_traversal() {
    var rows: list<LoopRow> = [];
    rows.push(LoopRow { tag: "a", value: 10 });
    rows.push(LoopRow { tag: "b", value: 20 });
    rows.push(LoopRow { tag: "c", value: 30 });

    var seen: i32 = 0;
    var sum: i32 = 0;
    for row in rows {
        if eq(row.tag, "a") == 1 || eq(row.tag, "b") == 1 || eq(row.tag, "c") == 1 {
            seen = seen + 1;
        }
        sum = sum + row.value;
    }

    verify_eq_i32(3, seen);
    verify_eq_i32(60, sum);
}

#[test]
fn test_list_of_struct_index_expression_returns_struct_value() {
    var rows: list<LoopRow> = [];
    rows.push(LoopRow { tag: "first", value: 17 });
    rows.push(LoopRow { tag: "second", value: 29 });

    let row: LoopRow = rows[1];
    verify_true(eq(row.tag, "second") == 1);
    verify_eq_i32(29, row.value);
}

#[test]
fn test_nested_function_basic_call() {
    fn add_local(a: i32, b: i32) -> i32 {
        return a + b;
    }
    let v: i32 = add_local(5, 7);
    verify_eq_i32(12, v);
}

#[test]
fn test_nested_function_two_levels() {
    fn outer_sum(a: i32, b: i32) -> i32 {
        fn inner_twice(v: i32) -> i32 {
            return v * 2;
        }
        return inner_twice(a + b);
    }
    verify_eq_i32(10, outer_sum(2, 3));
    verify_eq_i32(18, outer_sum(4, 5));
}

#[test]
fn test_nested_function_recursive() {
    fn local_fact(n: i32) -> i32 {
        if n <= 1 {
            return 1;
        }
        return n * local_fact(n - 1);
    }
    verify_eq_i32(1, local_fact(1));
    verify_eq_i32(120, local_fact(5));
}

#[test]
fn test_nested_function_name_shadowing_behavior() {
    let value: i32 = 7;
    fn bump(value: i32) -> i32 {
        // Parameter name intentionally shadows the outer variable name.
        return value + 1;
    }
    verify_eq_i32(11, bump(10));
    verify_eq_i32(7, value);
}

#[test]
fn test_nested_function_complex_composition() {
    fn normalize(v: i32) -> i32 {
        fn abs_local(x: i32) -> i32 {
            return x < 0 ? -x : x;
        }
        fn clamp10(x: i32) -> i32 {
            if x < 0 {
                return 0;
            }
            if x > 10 {
                return 10;
            }
            return x;
        }
        return clamp10(abs_local(v));
    }

    verify_eq_i32(4, normalize(-4));
    verify_eq_i32(3, normalize(3));
    verify_eq_i32(10, normalize(24));
}
