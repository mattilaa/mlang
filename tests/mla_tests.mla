mod std::strbuf;
mod std::algorithm::fft;
mod std::testing;
use std::strbuf::eq;
use std::testing::verify;

#[test]
fn test_main_default_return_works() {
    let x: i32 = 1;
    verify(x == 1);
}

#[test]
fn test_if_else_flow_works() {
    let x: i32 = 2;
    verify(x == 2);
}

#[test]
fn test_basic_list_and_map_types() {
    let ids: list<i32> = [7, 8, 9];
    verify(ids.len() == 3);

    let scores: map<str8, i32> = {"Alice": 95, "Bob": 87};
    verify(scores.len() == 2);
    verify(scores["Alice"] == 95);
}

struct TestInnerState {
    var values: list<i64>;
};

struct TestOuterState {
    var inner: TestInnerState;
};

#[test]
fn test_struct_field_list_mutation_methods() {
    var st: TestInnerState = TestInnerState { values: [] };
    st.values.push(7);
    st.values.push(9);
    verify(st.values.len() == 2);
    verify(st.values.pop() == 9);
    verify(st.values.len() == 1);
    st.values.clear();
    verify(st.values.is_empty());
}

#[test]
fn test_nested_struct_field_list_mutation_methods() {
    var st: TestOuterState = TestOuterState {
        inner: TestInnerState { values: [] }
    };
    st.inner.values.push(11);
    st.inner.values.push(22);
    verify(st.inner.values.len() == 2);
    verify(st.inner.values.pop() == 22);
    verify(st.inner.values.len() == 1);
}

struct ParseStateLike {
    var passthrough: list<str8>;
    var backend: str8;
};

#[test]
fn test_struct_state_with_string_list_field_push_pattern() {
    var st: ParseStateLike = ParseStateLike {
        passthrough: [],
        backend: "mlang"
    };
    st.passthrough.push("--version");
    st.passthrough.push("--help");
    verify(st.passthrough.len() == 2);
    verify(eq(st.passthrough.pop(), "--help") == 1);
    verify(eq(st.passthrough.pop(), "--version") == 1);
}

#[test]
fn test_condition_allows_indexed_or_chain() {
    let out: list<i64> = [1, 0, 2, 0, 3, 0, 4, 0];
    verify(out[0] == 1 && out[2] == 2 && out[4] == 3 && out[6] == 4);
}

#[test]
fn test_qualified_module_function_call_in_expression() {
    let data: list<i64> = [1, 0, 0, 0, 0, 0, 0, 0];
    let probe: list<i64> = std::algorithm::fft::forward(data);
    verify(probe.len() > 0);
    let out: list<i64> = std::algorithm::fft::inverse(
        std::algorithm::fft::forward([1, 0, 0, 0, 0, 0, 0, 0])
    );
    verify(out.len() > 0);
}
