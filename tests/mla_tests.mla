#[test]
fn test_main_default_return_works() -> i32 {
    let x: i32 = 1;
    if x != 1 { return 1; }
    return 0;
}

#[test]
fn test_if_else_flow_works() -> i32 {
    let x: i32 = 2;
    if x == 1 {
        return 1;
    } else if x == 2 {
        return 0;
    } else {
        return 1;
    }
}

#[test]
fn test_basic_list_and_map_types() -> i32 {
    let ids: list<i32> = [7, 8, 9];
    if ids.len() != 3 { return 1; }

    let scores: map<string, i32> = {"Alice": 95, "Bob": 87};
    if scores.len() != 2 { return 1; }
    return scores["Alice"] == 95 ? 0 : 1;
}
