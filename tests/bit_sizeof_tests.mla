struct Lamp {
    var state: bit;
    var ready: bool;
};

struct DeviceFlags {
    var rx: bit;
    var tx: bit;
    var ready: bool;
};

struct DeviceFlags2 {
    var first: bit;
    var second: bit;
    var enabled: bool;
};

struct PackedByteFlags {
    var b0: bit;
    var b1: bit;
    var b2: bit;
    var b3: bit;
    var b4: bit;
    var b5: bit;
    var b6: bit;
    var b7: bit;
};

struct MixedPackedFlags {
    var b0: bit;
    var b1: bit;
    var b2: bit;
    var b3: bit;
    var b4: bit;
    var b5: bit;
    var ready: bool;
};

#[test]
fn test_bit_values_and_struct_field_updates() {
    var state: bit = 0;
    verify_eq_i32(0, i32(state));
    state = 1;
    verify_eq_i32(1, i32(state));
    state = OFF();
    verify_eq_i32(0, i32(state));
    state = ON();
    verify_eq_i32(1, i32(state));

    var lamp: Lamp = Lamp {
        state: OFF(),
        ready: true
    };
    verify_eq_i32(0, i32(lamp.state));
    lamp.state = 1;
    verify_eq_i32(1, i32(lamp.state));
    lamp.state = OFF();
    verify_eq_i32(0, i32(lamp.state));
}

#[test]
fn test_cpp20_unsigned_bit_utilities() {
    let zero: u64 = 0;
    let one: u64 = 1;
    let two: u64 = 2;
    let twelve: u64 = 12;
    let one_twenty_eight: u64 = 128;
    let two_fifty_five: u64 = 255;
    let two_fifty_six: u64 = 256;
    verify_eq_i64(0, popcount_u64(zero));
    verify_eq_i64(8, popcount_u64(two_fifty_five));
    verify(has_single_bit_u64(one));
    verify(has_single_bit_u64(two_fifty_six));
    verify(!has_single_bit_u64(zero));
    verify(!has_single_bit_u64(twelve));
    verify_eq_i64(0, bit_width_u64(zero));
    verify_eq_i64(8, bit_width_u64(two_fifty_five));
    verify_eq_i64(64, countl_zero_u64(zero));
    verify_eq_i64(63, countl_zero_u64(one));
    verify_eq_i64(64, countr_zero_u64(zero));
    verify_eq_i64(8, countr_zero_u64(two_fifty_six));
    verify_eq_i64(0, countl_one_u64(zero));
    verify_eq_i64(8, countr_one_u64(two_fifty_five));
    verify(bit_floor_u64(two_fifty_five) == one_twenty_eight);
    verify(bit_floor_u64(zero) == zero);
    verify(bit_ceil_u64(zero) == one);
    verify(bit_ceil_u64(one_twenty_eight) == one_twenty_eight);
    verify(bit_ceil_u64(two_fifty_five) == two_fifty_six);
    verify(rotl_u64(one, 1) == two);
    verify(rotr_u64(two, 1) == one);
    verify(rotl_u64(two, -1) == one);
}

#[test]
fn test_cpp20_unsigned_bit_utilities_u8_u16_u32() {
    let u8_zero: u8 = 0;
    let u8_one: u8 = 1;
    let u8_ones: u8 = 255;
    let u8_value: u8 = 144;
    verify(popcount_u8(u8_value) == 2);
    verify(!has_single_bit_u8(u8_value) && has_single_bit_u8(u8_one));
    verify(bit_width_u8(u8_value) == 8);
    verify(countl_zero_u8(u8_zero) == 8 && countr_zero_u8(u8_zero) == 8);
    verify(countl_one_u8(u8_ones) == 8 && countr_one_u8(15) == 4);
    verify(bit_floor_u8(129) == 128 && bit_ceil_u8(129) == 0);
    verify(rotl_u8(u8_one, 9) == 2 && rotr_u8(u8_one, -1) == 2);

    let u16_value: u16 = 256;
    verify(popcount_u16(u16_value) == 1 && has_single_bit_u16(u16_value));
    verify(bit_width_u16(u16_value) == 9);
    verify(countl_zero_u16(u16_value) == 7 && countr_zero_u16(u16_value) == 8);
    verify(countl_one_u16(65535) == 16 && countr_one_u16(15) == 4);
    verify(bit_floor_u16(513) == 512 && bit_ceil_u16(513) == 1024);
    verify(rotl_u16(u16_value, 16) == u16_value);
    verify(rotr_u16(1, -1) == 2);

    let u32_top: u32 = 2147483648;
    verify(popcount_u32(u32_top) == 1 && has_single_bit_u32(u32_top));
    verify(bit_width_u32(u32_top) == 32);
    verify(countl_zero_u32(u32_top) == 0 && countr_zero_u32(u32_top) == 31);
    verify(countl_one_u32(u32_top) == 1 && countr_one_u32(15) == 4);
    verify(bit_floor_u32(u32_top) == u32_top);
    verify(bit_ceil_u32(2147483649) == 0);
    verify(rotl_u32(1, 33) == 2 && rotr_u32(1, -1) == 2);
}

#[test]
fn test_cpp23_byteswap_u64() {
    let value: u64 = 72623859790382856;
    let swapped: u64 = 578437695752307201;
    verify(byteswap_u64(value) == swapped);
    verify(byteswap_u64(swapped) == value);
}

#[test]
fn test_cpp23_byteswap_unsigned_widths() {
    let v32: u32 = 16909060;
    let r32: u32 = 67305985;
    let v16: u16 = 4660;
    let r16: u16 = 13330;
    let v8: u8 = 171;
    verify(byteswap_u32(v32) == r32);
    verify(byteswap_u32(r32) == v32);
    verify(byteswap_u16(v16) == r16);
    verify(byteswap_u16(r16) == v16);
    verify(byteswap_u8(v8) == v8);
}

#[test]
fn test_cpp20_bit_cast_float_integer_pairs() {
    let one_f32: f32 = 1.0f;
    let one_f32_bits: u32 = 1065353216;
    let one_f64: f64 = 1.0;
    let one_f64_bits: u64 = 4607182418800017408;

    verify(bit_cast_u32_from_f32(one_f32) == one_f32_bits);
    verify(bit_cast_f32_from_u32(one_f32_bits) == one_f32);
    verify(bit_cast_u64_from_f64(one_f64) == one_f64_bits);
    verify(bit_cast_f64_from_u64(one_f64_bits) == one_f64);
}

#[test]
fn test_cpp20_bit_cast_signed_unsigned_pairs() {
    let negative_i32: i32 = -1;
    let all_ones_u32: u32 = 4294967295;
    let bits_i32: u32 = bit_cast_u32_from_i32(negative_i32);
    verify(bits_i32 == all_ones_u32);
    verify(bit_cast_i32_from_u32(bits_i32) == negative_i32);

    let negative_i64: i64 = -1;
    let bits_i64: u64 = bit_cast_u64_from_i64(negative_i64);
    verify(bits_i64 > 9223372036854775807);
    verify(bit_cast_i64_from_u64(bits_i64) == negative_i64);
}

#[test]
fn test_size_of_builtin_and_container_sizes() {
    verify_eq_i64(1, size_of(bool));
    verify_eq_i64(1, size_of(bit));
    verify_eq_i64(1, size_of(u8));
    verify_eq_i64(2, size_of(u16));
    verify_eq_i64(8, size_of(i64));
    verify(size_of(Lamp) >= 2);

    let count: i64 = 7;
    let lamp: Lamp = Lamp { state: ON(), ready: false };
    verify_eq_i64(8, size_of(count));
    verify_eq_i64(size_of(Lamp), size_of(lamp));

    let bools: list<bool> = [true, false, true, false];
    let ints: list<i32> = [1, 2, 3, 4];
    verify_eq_i64(16, size_of(bools));
    verify_eq_i64(16, size_of(ints));
    verify_eq_i64(size_of(list<bool>), size_of(list<i32>));

    let fixed: array<i32, 6> = {1, 2, 3, 4, 5, 6};
    verify_eq_i64(24, size_of(array<i32, 6>));
    verify_eq_i64(24, size_of(fixed));
    static_assert!(size_of(array<i32, 6>) == 24);
    static_assert!(size_of(fixed) == size_of(array<i32, 6>));
}

#[test]
fn test_packed_bit_struct_size_of_is_two_bytes() {
    verify_eq_i64(2, size_of(DeviceFlags));
    verify_eq_i64(2, size_of(DeviceFlags2));

    let a: DeviceFlags = DeviceFlags { rx: ON(), tx: OFF(), ready: true };
    let b: DeviceFlags2 = DeviceFlags2 { first: OFF(), second: ON(), enabled: false };
    verify_eq_i64(2, size_of(a));
    verify_eq_i64(2, size_of(b));

    verify_eq_i32(1, i32(a.rx));
    verify_eq_i32(0, i32(a.tx));
    verify(a.ready);
    verify_eq_i32(0, i32(b.first));
    verify_eq_i32(1, i32(b.second));
    verify(!b.enabled);
}

#[test]
fn test_eight_bits_pack_into_one_byte() {
    verify_eq_i64(1, size_of(PackedByteFlags));

    var bits: PackedByteFlags = PackedByteFlags {
        b0: ON(),
        b1: OFF(),
        b2: ON(),
        b3: OFF(),
        b4: ON(),
        b5: OFF(),
        b6: ON(),
        b7: OFF()
    };
    verify_eq_i64(1, size_of(bits));

    verify_eq_i32(1, i32(bits.b0));
    verify_eq_i32(0, i32(bits.b1));
    verify_eq_i32(1, i32(bits.b2));
    verify_eq_i32(0, i32(bits.b3));
    verify_eq_i32(1, i32(bits.b4));
    verify_eq_i32(0, i32(bits.b5));
    verify_eq_i32(1, i32(bits.b6));
    verify_eq_i32(0, i32(bits.b7));

    bits.b1 = ON();
    bits.b3 = ON();
    bits.b5 = ON();
    bits.b7 = ON();

    verify_eq_i32(1, i32(bits.b0));
    verify_eq_i32(1, i32(bits.b1));
    verify_eq_i32(1, i32(bits.b2));
    verify_eq_i32(1, i32(bits.b3));
    verify_eq_i32(1, i32(bits.b4));
    verify_eq_i32(1, i32(bits.b5));
    verify_eq_i32(1, i32(bits.b6));
    verify_eq_i32(1, i32(bits.b7));
}

#[test]
fn test_six_bits_and_one_bool_take_two_bytes() {
    verify_eq_i64(2, size_of(MixedPackedFlags));

    var flags: MixedPackedFlags = MixedPackedFlags {
        b0: ON(),
        b1: OFF(),
        b2: ON(),
        b3: OFF(),
        b4: ON(),
        b5: OFF(),
        ready: true
    };
    verify_eq_i64(2, size_of(flags));

    verify_eq_i32(1, i32(flags.b0));
    verify_eq_i32(0, i32(flags.b1));
    verify_eq_i32(1, i32(flags.b2));
    verify_eq_i32(0, i32(flags.b3));
    verify_eq_i32(1, i32(flags.b4));
    verify_eq_i32(0, i32(flags.b5));
    verify(flags.ready);

    flags.b1 = ON();
    flags.b3 = ON();
    flags.b5 = ON();
    flags.ready = false;

    verify_eq_i32(1, i32(flags.b0));
    verify_eq_i32(1, i32(flags.b1));
    verify_eq_i32(1, i32(flags.b2));
    verify_eq_i32(1, i32(flags.b3));
    verify_eq_i32(1, i32(flags.b4));
    verify_eq_i32(1, i32(flags.b5));
    verify(!flags.ready);
}

#[test]
fn test_bitset_len_tracks_bits_not_bools_as_bytes() {
    let r: result<BitSet, str8> = BitSet::new(0);
    verify(!r.is_err());
    let bs: BitSet = r.unwrap();

    verify(bs.push(true) == 0);
    verify(bs.push(false) == 0);
    verify(bs.push(true) == 0);
    verify(bs.push(false) == 0);
    verify_eq_i64(4, bs.len());

    verify(bs.push(true) == 0);
    verify(bs.push(false) == 0);
    verify(bs.push(true) == 0);
    verify(bs.push(false) == 0);
    verify_eq_i64(8, bs.len());

    verify(bs.resize(16, false) == 0);
    verify_eq_i64(16, bs.len());

    bs.close();
}

struct PaddedLayout {
    var small: i32;
    var wide: f64;
    var flag: bool;
    var count: i64;
    var level: f32;
};

// size_of uses the target's alignment: 8-byte i64/f64 fields are padded to
// 8 bytes on 64-bit targets, so allocations sized with it hold the value.
#[test]
fn test_size_of_includes_target_padding() {
    verify_eq_i64(size_of(PaddedLayout), 40);
    let value: PaddedLayout = PaddedLayout {};
    verify_eq_i64(size_of(value), 40);
}
