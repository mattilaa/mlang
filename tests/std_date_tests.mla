mod std::testing;
mod std::date;
mod std::strbuf;

use std::date::DateTime;
use std::date::format_date;
use std::date::format_iso8601;
use std::date::format_time;
use std::date::now;
use std::strbuf::eq;
use std::strbuf::len;
use std::testing::verify;

#[test]
fn test_now_components_in_valid_ranges() {
    let dt: DateTime = now();
    if dt.year < 1970: { verify(false); }
    if dt.month < 1: { verify(false); }
    if dt.month > 12: { verify(false); }
    if dt.day < 1: { verify(false); }
    if dt.day > 31: { verify(false); }
    if dt.hour < 0: { verify(false); }
    if dt.hour > 23: { verify(false); }
    if dt.minute < 0: { verify(false); }
    if dt.minute > 59: { verify(false); }
    if dt.second < 0: { verify(false); }
    if dt.second > 60: { verify(false); }
    }

#[test]
fn test_format_date_shape() {
    let dt: DateTime = DateTime {
        year: 2026, month: 2, day: 9, hour: 21, minute: 11, second: 6
    };
    let s: string = format_date(dt);
    if len(s) != 10: { verify(false); }
    verify(eq(s, "02/09/2026") == 1);
}

#[test]
fn test_format_time_shape() {
    let dt: DateTime = DateTime {
        year: 2026, month: 2, day: 9, hour: 3, minute: 4, second: 5
    };
    let s: string = format_time(dt);
    if len(s) != 8: { verify(false); }
    verify(eq(s, "03:04:05") == 1);
}

#[test]
fn test_format_iso8601_shape() {
    let dt: DateTime = DateTime {
        year: 2026, month: 12, day: 31, hour: 23, minute: 59, second: 58
    };
    let s: string = format_iso8601(dt);
    if len(s) != 19: { verify(false); }
    verify(eq(s, "2026-12-31T23:59:58") == 1);
}
