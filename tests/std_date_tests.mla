#[test]
fn test_now_components_in_valid_ranges() {
    let dt: DateTime = now();
    verify(!(dt.year < 1970));
    verify(!(dt.month < 1));
    verify(!(dt.month > 12));
    verify(!(dt.day < 1));
    verify(!(dt.day > 31));
    verify(!(dt.hour < 0));
    verify(!(dt.hour > 23));
    verify(!(dt.minute < 0));
    verify(!(dt.minute > 59));
    verify(!(dt.second < 0));
    verify(!(dt.second > 60));
    }

#[test]
fn test_format_date_shape() {
    let dt: DateTime = DateTime {
        year: 2026, month: 2, day: 9, hour: 21, minute: 11, second: 6
    };
    let s: str8 = format_date(dt);
    verify(!(len(s) != 10));
    verify(eq(s, "02/09/2026") == 1);
}

#[test]
fn test_format_time_shape() {
    let dt: DateTime = DateTime {
        year: 2026, month: 2, day: 9, hour: 3, minute: 4, second: 5
    };
    let s: str8 = format_time(dt);
    verify(!(len(s) != 8));
    verify(eq(s, "03:04:05") == 1);
}

#[test]
fn test_format_iso8601_shape() {
    let dt: DateTime = DateTime {
        year: 2026, month: 12, day: 31, hour: 23, minute: 59, second: 58
    };
    let s: str8 = format_iso8601(dt);
    verify(!(len(s) != 19));
    verify(eq(s, "2026-12-31T23:59:58") == 1);
}

#[test]
fn test_unix_epoch_utc_roundtrip() {
    let dt: DateTime = from_unix_utc(0);
    verify(dt.year == 1970);
    verify(dt.month == 1);
    verify(dt.day == 1);
    verify(dt.hour == 0);
    verify(dt.minute == 0);
    verify(dt.second == 0);
    verify(to_unix_utc(dt) == 0);
    verify(eq(format_iso8601_offset(dt, utc()), "1970-01-01T00:00:00Z") == 1);
}

#[test]
fn test_civil_calendar_and_sys_days() {
    verify(is_leap_year(2000));
    verify(!is_leap_year(1900));
    verify(!is_leap_year(2100));
    verify(is_leap_year(0));
    verify(is_leap_year(2024));
    verify(!is_leap_year(2023));
    verify(days_in_month(2024, 2) == 29);
    verify(days_in_month(2023, 2) == 28);
    verify(days_in_month(2024, 13) == 0);
    verify(is_valid_civil_date(2024, 2, 29));
    verify(!is_valid_civil_date(1900, 2, 29));
    verify(!is_valid_civil_date(2024, 4, 31));

    let epoch_days: option<i64> = to_sys_days(1970, 1, 1);
    verify(epoch_days.is_some() && epoch_days.unwrap() == 0);
    verify(to_sys_days(1900, 2, 29).is_none());
    verify(to_sys_days(2024, 2, 29).unwrap() == 19782);
    let year_zero_leap_day: i64 = to_sys_days(0, 2, 29).unwrap();
    verify(weekday_from_sys_days(0) == 4);
    verify(weekday_from_sys_days(2) == 6);
    verify(weekday_from_sys_days(-1) == 3);
    verify(weekday_from_sys_days(-4) == 0);

    let leap_day: CivilDate = from_sys_days(19782).unwrap();
    verify(leap_day.year == 2024 && leap_day.month == 2 &&
           leap_day.day == 29);
    let before_epoch: CivilDate = from_sys_days(-1).unwrap();
    verify(before_epoch.year == 1969 && before_epoch.month == 12 &&
           before_epoch.day == 31);
    let year_zero_date: CivilDate = from_sys_days(year_zero_leap_day).unwrap();
    verify(year_zero_date.year == 0 && year_zero_date.month == 2 &&
           year_zero_date.day == 29);
}

#[test]
fn test_civil_date_day_arithmetic() {
    let leap_day: CivilDate = CivilDate { year: 2024, month: 2, day: 29 };
    let following: CivilDate = add_civil_days(leap_day, 1).unwrap();
    verify(following.year == 2024 && following.month == 3 &&
           following.day == 1);
    let preceding: CivilDate = add_civil_days(leap_day, -1).unwrap();
    verify(preceding.year == 2024 && preceding.month == 2 &&
           preceding.day == 28);

    let epoch: CivilDate = CivilDate { year: 1970, month: 1, day: 1 };
    let before_epoch: CivilDate = add_civil_days(epoch, -1).unwrap();
    verify(before_epoch.year == 1969 && before_epoch.month == 12 &&
           before_epoch.day == 31);
    verify(days_between(before_epoch, epoch).unwrap() == 1);
    verify(days_between(epoch, before_epoch).unwrap() == -1);

    let invalid: CivilDate = CivilDate { year: 2023, month: 2, day: 29 };
    verify(add_civil_days(invalid, 0).is_none());
    verify(days_between(invalid, epoch).is_none());

    let last_supported: CivilDate = CivilDate {
        year: 2147483647, month: 12, day: 31
    };
    let first_supported: CivilDate = CivilDate {
        year: -2147483648, month: 1, day: 1
    };
    verify(add_civil_days(last_supported, 1).is_none());
    verify(add_civil_days(first_supported, -1).is_none());
}

#[test]
fn test_civil_date_month_arithmetic() {
    let middle_of_month: CivilDate =
        CivilDate { year: 2024, month: 1, day: 15 };
    let next_month: CivilDate = add_civil_months(middle_of_month, 1).unwrap();
    verify(next_month.year == 2024 && next_month.month == 2 &&
           next_month.day == 15);
    let previous_year: CivilDate = add_civil_months(middle_of_month, -13).unwrap();
    verify(previous_year.year == 2022 && previous_year.month == 12 &&
           previous_year.day == 15);

    let month_end: CivilDate = CivilDate { year: 2024, month: 1, day: 31 };
    let invalid_february: CivilDate = add_civil_months(month_end, 1).unwrap();
    verify(invalid_february.year == 2024 && invalid_february.month == 2 &&
           invalid_february.day == 31);
    verify(!is_valid_civil_date(invalid_february.year,
                                invalid_february.month,
                                invalid_february.day));
    let leap_day: CivilDate = CivilDate { year: 2024, month: 2, day: 29 };
    let next_year: CivilDate = add_civil_months(leap_day, 12).unwrap();
    verify(next_year.year == 2025 && next_year.month == 2 &&
           next_year.day == 29);
    verify(!is_valid_civil_date(next_year.year, next_year.month, next_year.day));

    let invalid: CivilDate = CivilDate { year: 2023, month: 2, day: 29 };
    verify(add_civil_months(invalid, 1).is_none());
    let max_date: CivilDate = CivilDate {
        year: 2147483647, month: 12, day: 31
    };
    let min_date: CivilDate = CivilDate {
        year: -2147483648, month: 1, day: 1
    };
    verify(add_civil_months(max_date, 1).is_none());
    verify(add_civil_months(min_date, -1).is_none());
}

#[test]
fn test_year_month_value_and_arithmetic() {
    let january: YearMonth = make_year_month(2024, 1).unwrap();
    verify(is_valid_year_month(january));

    let previous: YearMonth = add_year_month_months(january, -1).unwrap();
    verify(previous.year == 2023 && previous.month == 12);
    let next_year_zero: YearMonth = add_year_month_months(
        YearMonth { year: 0, month: 1 }, -1).unwrap();
    verify(next_year_zero.year == -1 && next_year_zero.month == 12);
    let normalized: YearMonth = add_year_month_months(
        YearMonth { year: 2023, month: 11 }, 15).unwrap();
    verify(normalized.year == 2025 && normalized.month == 2);

    let leap_month: YearMonth = YearMonth { year: 2024, month: 2 };
    let first: CivilDate = year_month_first_day(leap_month).unwrap();
    let last: CivilDate = year_month_last_day(leap_month).unwrap();
    verify(first.year == 2024 && first.month == 2 && first.day == 1);
    verify(last.year == 2024 && last.month == 2 && last.day == 29);

    let shifted_year: YearMonth = add_year_month_years(leap_month, -4).unwrap();
    verify(shifted_year.year == 2020 && shifted_year.month == 2);
    let max_month: YearMonth = YearMonth { year: 2147483647, month: 12 };
    let min_month: YearMonth = YearMonth { year: -2147483648, month: 1 };
    verify(add_year_month_months(max_month, 1).is_none());
    verify(add_year_month_months(min_month, -1).is_none());
    verify(add_year_month_months(january, 9223372036854775807).is_none());
    verify(add_year_month_months(january, -9223372036854775807 - 1).is_none());
    verify(add_year_month_years(max_month, 1).is_none());
    verify(add_year_month_years(january, 9223372036854775807).is_none());
    verify(add_year_month_years(january, -9223372036854775807 - 1).is_none());
    verify(!is_valid_year_month(YearMonth { year: 2024, month: 13 }));
    verify(make_year_month(2024, 0).is_none());
    verify(year_month_first_day(YearMonth { year: 2024, month: 13 }).is_none());
}

#[test]
fn test_recurring_month_day_calendar_values() {
    let leap_day_option: option<MonthDay> = make_month_day(2, 29);
    verify(leap_day_option.is_some());
    let leap_day: MonthDay = leap_day_option.unwrap();
    verify(is_valid_month_day(leap_day));
    let leap_date: CivilDate = resolve_month_day(leap_day, 2024).unwrap();
    verify(leap_date.year == 2024 && leap_date.month == 2 && leap_date.day == 29);
    verify(resolve_month_day(leap_day, 2023).is_none());

    let christmas: MonthDay = make_month_day(12, 25).unwrap();
    let date: CivilDate = resolve_month_day(christmas, 2025).unwrap();
    verify(date.year == 2025 && date.month == 12 && date.day == 25);
    verify(make_month_day(2, 30).is_none());
    verify(make_month_day(13, 1).is_none());
    verify(!is_valid_month_day(MonthDay { month: 0, day: 1 }));

    let february_last_option: option<MonthDayLast> = make_month_day_last(2);
    verify(february_last_option.is_some());
    let february_last: CivilDate =
        resolve_month_day_last(february_last_option.unwrap(), 2024).unwrap();
    verify(february_last.year == 2024 && february_last.month == 2 &&
           february_last.day == 29);
    let common_february_last: CivilDate =
        resolve_month_day_last(MonthDayLast { month: 2 }, 2023).unwrap();
    verify(common_february_last.day == 28);
    verify(make_month_day_last(0).is_none());
    verify(resolve_month_day_last(MonthDayLast { month: 13 }, 2024).is_none());
}

#[test]
fn test_typed_month_conversion_and_arithmetic() {
    verify(is_valid_month(Month::January));
    verify(is_valid_month(Month::December));
    verify(month_number(Month::January) == 1);
    verify(month_number(Month::December) == 12);
    verify(month_from_number(0).is_none());
    verify(month_from_number(13).is_none());
    verify(month_from_number(2).unwrap() == Month::February);

    verify(add_months_to_month(Month::December, 1).unwrap() == Month::January);
    verify(add_months_to_month(Month::January, -1).unwrap() == Month::December);
    verify(add_months_to_month(Month::March, 24).unwrap() == Month::March);
    let huge_positive: Month = add_months_to_month(
        Month::January, 9223372036854775807).unwrap();
    let huge_negative: Month = add_months_to_month(
        Month::January, -9223372036854775807 - 1).unwrap();
    verify(month_number(huge_positive) >= 1 && month_number(huge_positive) <= 12);
    verify(month_number(huge_negative) >= 1 && month_number(huge_negative) <= 12);

    verify(month_days(Month::February, 2024) == 29);
    verify(month_days(Month::February, 2023) == 28);
}

#[test]
fn test_typed_chrono_year_values() {
    verify(!is_valid_year(-32768));
    verify(is_valid_year(-32767));
    verify(is_valid_year(0));
    verify(is_valid_year(32767));
    verify(!is_valid_year(32768));
    verify(make_year(-32768).is_none());
    verify(make_year(32768).is_none());

    let leap: Year = make_year(2000).unwrap();
    let common: Year = make_year(1900).unwrap();
    let year_zero: Year = make_year(0).unwrap();
    verify(year_number(leap) == 2000);
    verify(year_is_leap(leap));
    verify(!year_is_leap(common));
    verify(year_is_leap(year_zero));
    verify(days_in_year(leap) == 366);
    verify(days_in_year(common) == 365);

    verify(year_number(add_years(leap, -4).unwrap()) == 1996);
    verify(add_years(make_year(32767).unwrap(), 1).is_none());
    verify(add_years(make_year(-32767).unwrap(), -1).is_none());
    verify(add_years(leap, 9223372036854775807).is_none());
    verify(add_years(leap, -9223372036854775807 - 1).is_none());

    let february: YearMonth = make_year_month_from_parts(
        leap, Month::February).unwrap();
    verify(february.year == 2000 && february.month == 2);
    verify(make_year_month_from_parts(
        Year { value: 50000 }, Month::February).is_none());
}

#[test]
fn test_typed_chrono_day_values() {
    verify(make_day(0).is_none());
    verify(make_day(32).is_none());
    let first: Day = make_day(1).unwrap();
    let last: Day = make_day(31).unwrap();
    verify(is_valid_day(first) && day_number(first) == 1);
    verify(is_valid_day(last) && day_number(last) == 31);

    let wraps_to_zero: Day = add_days_to_day(last, 1);
    verify(day_number(wraps_to_zero) == 0 && !is_valid_day(wraps_to_zero));
    verify(day_number(add_days_to_day(first, -1)) == 0);
    verify(day_number(add_days_to_day(first, 9223372036854775807)) == 0);
    verify(day_number(add_days_to_day(first, -9223372036854775807 - 1)) == 1);

    let year: Year = make_year(2024).unwrap();
    let february: Month = Month::February;
    let leap_date: CivilDate = make_civil_date_from_parts(
        year, february, make_day(29).unwrap()).unwrap();
    verify(leap_date.year == 2024 && leap_date.month == 2 &&
           leap_date.day == 29);
    verify(make_civil_date_from_parts(
        make_year(2023).unwrap(), february, make_day(29).unwrap()).is_none());
    verify(make_civil_date_from_parts(
        year, Month::April, make_day(31).unwrap()).is_none());
}

#[test]
fn test_year_month_day_last_values() {
    let leap_year: Year = make_year(2024).unwrap();
    let common_year: Year = make_year(2023).unwrap();
    let february: Month = Month::February;
    let leap_last: YearMonthDayLast = make_year_month_day_last(
        leap_year, february).unwrap();
    let leap_day: Day = year_month_day_last_day(leap_last).unwrap();
    verify(day_number(leap_day) == 29);
    let leap_date: YearMonthDay = resolve_year_month_day_last(leap_last).unwrap();
    verify(leap_date.year == 2024 && leap_date.month == 2 &&
           leap_date.day == 29);

    let common_last: YearMonthDayLast = make_year_month_day_last(
        common_year, february).unwrap();
    verify(day_number(year_month_day_last_day(common_last).unwrap()) == 28);
    verify(resolve_year_month_day_last(common_last).unwrap().day == 28);
    let april: YearMonthDayLast = make_year_month_day_last(
        leap_year, Month::April).unwrap();
    verify(resolve_year_month_day_last(april).unwrap().day == 30);
    verify(make_year_month_day_last(leap_year, Month::February).is_some());
    verify(year_month_day_last_day(YearMonthDayLast {
        year: Year { value: 50000 }, month: february
    }).is_none());
}

#[test]
fn test_civil_date_year_arithmetic() {
    let leap_day: CivilDate = CivilDate { year: 2024, month: 2, day: 29 };
    let common_year: CivilDate = add_civil_years(leap_day, 1).unwrap();
    verify(common_year.year == 2025 && common_year.month == 2 &&
           common_year.day == 29);
    verify(!is_valid_civil_date(common_year.year, common_year.month,
                                common_year.day));
    let leap_year: CivilDate = add_civil_years(leap_day, -4).unwrap();
    verify(leap_year.year == 2020 &&
           is_valid_civil_date(leap_year.year, leap_year.month, leap_year.day));

    let invalid: CivilDate = CivilDate { year: 2023, month: 2, day: 29 };
    verify(add_civil_years(invalid, 1).is_none());
    let max_date: CivilDate = CivilDate {
        year: 2147483647, month: 12, day: 31
    };
    let min_date: CivilDate = CivilDate {
        year: -2147483648, month: 1, day: 1
    };
    verify(add_civil_years(max_date, 1).is_none());
    verify(add_civil_years(min_date, -1).is_none());
}

#[test]
fn test_typed_weekday_encodings_and_arithmetic() {
    verify(weekday_from_c_encoding(-1).is_none());
    verify(weekday_from_c_encoding(7).is_none());
    verify(weekday_from_iso_encoding(0).is_none());
    verify(weekday_from_iso_encoding(8).is_none());
    verify(weekday_from_c_encoding(0).unwrap() == Weekday::Sunday);
    verify(weekday_from_iso_encoding(1).unwrap() == Weekday::Monday);
    verify(weekday_from_iso_encoding(7).unwrap() == Weekday::Sunday);
    verify(weekday_c_encoding(Weekday::Saturday) == 6);
    verify(weekday_iso_encoding(Weekday::Sunday) == 7);

    let epoch: CivilDate = CivilDate { year: 1970, month: 1, day: 1 };
    verify(weekday_of(epoch).unwrap() == Weekday::Thursday);
    verify(weekday_from_sys_days_typed(-1) == Weekday::Wednesday);
    let invalid: CivilDate = CivilDate { year: 2023, month: 2, day: 29 };
    verify(weekday_of(invalid).is_none());

    verify(add_weekdays(Weekday::Friday, 9) == Weekday::Sunday);
    verify(add_weekdays(Weekday::Monday, -2) == Weekday::Saturday);
    verify(add_weekdays(Weekday::Sunday, 0) == Weekday::Sunday);
    verify(add_weekdays(Weekday::Wednesday, 9223372036854775807) ==
           Weekday::Wednesday);
}

#[test]
fn test_civil_weekday_of_month() {
    let second_tuesday: CivilDate = nth_weekday_of_month(2024, 7, 2, 2).unwrap();
    verify(second_tuesday.year == 2024 && second_tuesday.month == 7 &&
           second_tuesday.day == 9);
    let last_friday: CivilDate = last_weekday_of_month(2024, 7, 5).unwrap();
    verify(last_friday.day == 26);

    let fifth_thursday: CivilDate =
        nth_weekday_of_month(2024, 2, 4, 5).unwrap();
    verify(fifth_thursday.day == 29);
    verify(nth_weekday_of_month(2021, 2, 1, 5).is_none());
    let leap_february_last_sunday: CivilDate =
        last_weekday_of_month(2024, 2, 0).unwrap();
    verify(leap_february_last_sunday.day == 25);

    verify(nth_weekday_of_month(2024, 13, 1, 1).is_none());
    verify(nth_weekday_of_month(2024, 1, 7, 1).is_none());
    verify(nth_weekday_of_month(2024, 1, 1, 0).is_none());
    verify(last_weekday_of_month(2024, 1, -1).is_none());
}

#[test]
fn test_typed_year_month_weekday_calendar_values() {
    let second_tuesday_option: option<YearMonthWeekday> =
        make_year_month_weekday(2024, 7, Weekday::Tuesday, 2);
    verify(second_tuesday_option.is_some());
    let second_tuesday: CivilDate =
        resolve_year_month_weekday(second_tuesday_option.unwrap()).unwrap();
    verify(second_tuesday.year == 2024 && second_tuesday.month == 7 &&
           second_tuesday.day == 9);

    let absent_fifth: option<YearMonthWeekday> =
        make_year_month_weekday(2021, 2, Weekday::Monday, 5);
    verify(absent_fifth.is_some());
    verify(resolve_year_month_weekday(absent_fifth.unwrap()).is_none());
    verify(make_year_month_weekday(2024, 13, Weekday::Monday, 1).is_none());
    verify(make_year_month_weekday(2024, 2, Weekday::Monday, 0).is_none());

    let final_friday_option: option<YearMonthWeekdayLast> =
        make_year_month_weekday_last(2024, 7, Weekday::Friday);
    verify(final_friday_option.is_some());
    let final_friday: CivilDate = resolve_year_month_weekday_last(
        final_friday_option.unwrap()).unwrap();
    verify(final_friday.year == 2024 && final_friday.month == 7 &&
           final_friday.day == 26);
    verify(make_year_month_weekday_last(2024, 0, Weekday::Friday).is_none());
}

#[test]
fn test_iso_week_date_conversion() {
    let new_year_eve: CivilDate = CivilDate {
        year: 2020, month: 12, day: 31
    };
    let iso_new_year_eve: IsoWeekDate =
        to_iso_week_date(new_year_eve).unwrap();
    verify(iso_new_year_eve.year == 2020 && iso_new_year_eve.week == 53 &&
           iso_new_year_eve.weekday == 4);

    let friday: CivilDate = CivilDate { year: 2021, month: 1, day: 1 };
    let iso_friday: IsoWeekDate = to_iso_week_date(friday).unwrap();
    verify(iso_friday.year == 2020 && iso_friday.week == 53 &&
           iso_friday.weekday == 5);
    let round_trip: CivilDate = from_iso_week_date(iso_friday).unwrap();
    verify(round_trip.year == 2021 && round_trip.month == 1 &&
           round_trip.day == 1);

    let first_monday: IsoWeekDate = IsoWeekDate {
        year: 2021, week: 1, weekday: 1
    };
    let monday: CivilDate = from_iso_week_date(first_monday).unwrap();
    verify(monday.year == 2021 && monday.month == 1 && monday.day == 4);
    let invalid_week: IsoWeekDate = IsoWeekDate {
        year: 2021, week: 53, weekday: 1
    };
    let invalid_weekday: IsoWeekDate = IsoWeekDate {
        year: 2024, week: 1, weekday: 0
    };
    verify(from_iso_week_date(invalid_week).is_none());
    verify(from_iso_week_date(invalid_weekday).is_none());
    let invalid_civil: CivilDate = CivilDate {
        year: 2023, month: 2, day: 29
    };
    verify(to_iso_week_date(invalid_civil).is_none());
}

#[test]
fn test_unix_leap_day_utc_roundtrip() {
    let dt: DateTime = from_unix_utc(1709164800);
    verify(eq(format_iso8601(dt), "2024-02-29T00:00:00") == 1);
    verify(to_unix_utc(dt) == 1709164800);
}

#[test]
fn test_fixed_timezone_offset_conversion() {
    let plus_two: UtcOffset = offset_hours_minutes(2, 0);
    let local_dt: DateTime = from_unix(0, plus_two);
    verify(eq(format_iso8601_offset(local_dt, plus_two), "1970-01-01T02:00:00+02:00") == 1);
    verify(to_unix(local_dt, plus_two) == 0);

    let minus_five_thirty: UtcOffset = offset_hours_minutes(0 - 5, 30);
    let west_dt: DateTime = from_unix(0, minus_five_thirty);
    verify(eq(format_iso8601_offset(west_dt, minus_five_thirty), "1969-12-31T18:30:00-05:30") == 1);
    verify(to_unix(west_dt, minus_five_thirty) == 0);
}

#[test]
fn test_offset_seconds_and_formatting() {
    verify(eq(format_offset(offset_seconds(0)), "Z") == 1);
    verify(eq(format_offset(offset_seconds(19800)), "+05:30") == 1);
    verify(eq(format_offset(offset_seconds(0 - 12600)), "-03:30") == 1);
}

#[test]
fn test_local_timezone_matches_fixed_offset_at_timestamp() {
    let timestamp: i64 = 1704067200;
    let local_offset: UtcOffset = local_offset_at(timestamp);
    let local_dt: DateTime = from_unix_local(timestamp);
    let offset_dt: DateTime = from_unix(timestamp, local_offset);

    verify(local_dt.year == offset_dt.year);
    verify(local_dt.month == offset_dt.month);
    verify(local_dt.day == offset_dt.day);
    verify(local_dt.hour == offset_dt.hour);
    verify(local_dt.minute == offset_dt.minute);
    verify(local_dt.second == offset_dt.second);
    verify(to_unix(local_dt, local_offset) == timestamp);
}

#[test]
fn test_named_timezone_utc_roundtrip() {
    let zr: result<TimeZone, str8> = load_timezone("UTC");
    verify(!zr.is_err());
    let z: TimeZone = zr.unwrap();
    let dt: DateTime = from_unix_tz(0, z);
    verify(eq(format_iso8601(dt), "1970-01-01T00:00:00") == 1);
    verify(eq(format_offset(timezone_offset_at(z, 0)), "Z") == 1);
    verify(to_unix_tz(dt, z) == 0);
}

#[test]
fn test_named_timezone_iana_when_available() {
    let hr: result<TimeZone, str8> = load_timezone("Europe/Helsinki");
    if hr.is_err() {
        verify(true);
        return;
    }

    let helsinki: TimeZone = hr.unwrap();
    let winter: DateTime = from_unix_tz(1704067200, helsinki);
    let summer: DateTime = from_unix_tz(1719792000, helsinki);

    verify(eq(format_iso8601_offset(winter, timezone_offset_at(helsinki, 1704067200)), "2024-01-01T02:00:00+02:00") == 1);
    verify(eq(format_iso8601_offset(summer, timezone_offset_at(helsinki, 1719792000)), "2024-07-01T03:00:00+03:00") == 1);
    verify(to_unix_tz(winter, helsinki) == 1704067200);
    verify(to_unix_tz(summer, helsinki) == 1719792000);
}
