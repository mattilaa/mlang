#[test]
fn test_now_components_in_valid_ranges() {
    let dt: DateTime = now();
    verify(!(dt.year < 1970));
    verify(!(dt.month < 1));
    verify(!(dt.month > 12));
    verify(!(dt.day < 1));
    verify(!(dt.day > 31));
    verify(!(dt.hour < 0));
    verify(!(dt.hour > 23));
    verify(!(dt.minute < 0));
    verify(!(dt.minute > 59));
    verify(!(dt.second < 0));
    verify(!(dt.second > 60));
    }

#[test]
fn test_format_date_shape() {
    let dt: DateTime = DateTime {
        year: 2026, month: 2, day: 9, hour: 21, minute: 11, second: 6
    };
    let s: str8 = format_date(dt);
    verify(!(len(s) != 10));
    verify(eq(s, "02/09/2026") == 1);
}

#[test]
fn test_format_time_shape() {
    let dt: DateTime = DateTime {
        year: 2026, month: 2, day: 9, hour: 3, minute: 4, second: 5
    };
    let s: str8 = format_time(dt);
    verify(!(len(s) != 8));
    verify(eq(s, "03:04:05") == 1);
}

#[test]
fn test_format_iso8601_shape() {
    let dt: DateTime = DateTime {
        year: 2026, month: 12, day: 31, hour: 23, minute: 59, second: 58
    };
    let s: str8 = format_iso8601(dt);
    verify(!(len(s) != 19));
    verify(eq(s, "2026-12-31T23:59:58") == 1);
}

#[test]
fn test_unix_epoch_utc_roundtrip() {
    let dt: DateTime = from_unix_utc(0);
    verify(dt.year == 1970);
    verify(dt.month == 1);
    verify(dt.day == 1);
    verify(dt.hour == 0);
    verify(dt.minute == 0);
    verify(dt.second == 0);
    verify(to_unix_utc(dt) == 0);
    verify(eq(format_iso8601_offset(dt, utc()), "1970-01-01T00:00:00Z") == 1);
}

#[test]
fn test_civil_calendar_and_sys_days() {
    verify(is_leap_year(2000));
    verify(!is_leap_year(1900));
    verify(!is_leap_year(2100));
    verify(is_leap_year(0));
    verify(is_leap_year(2024));
    verify(!is_leap_year(2023));
    verify(days_in_month(2024, 2) == 29);
    verify(days_in_month(2023, 2) == 28);
    verify(days_in_month(2024, 13) == 0);
    verify(is_valid_civil_date(2024, 2, 29));
    verify(!is_valid_civil_date(1900, 2, 29));
    verify(!is_valid_civil_date(2024, 4, 31));

    let epoch_days: option<i64> = to_sys_days(1970, 1, 1);
    verify(epoch_days.is_some() && epoch_days.unwrap() == 0);
    verify(to_sys_days(1900, 2, 29).is_none());
    verify(to_sys_days(2024, 2, 29).unwrap() == 19782);
    let year_zero_leap_day: i64 = to_sys_days(0, 2, 29).unwrap();
    verify(weekday_from_sys_days(0) == 4);
    verify(weekday_from_sys_days(2) == 6);
    verify(weekday_from_sys_days(-1) == 3);
    verify(weekday_from_sys_days(-4) == 0);

    let leap_day: CivilDate = from_sys_days(19782).unwrap();
    verify(leap_day.year == 2024 && leap_day.month == 2 &&
           leap_day.day == 29);
    let before_epoch: CivilDate = from_sys_days(-1).unwrap();
    verify(before_epoch.year == 1969 && before_epoch.month == 12 &&
           before_epoch.day == 31);
    let year_zero_date: CivilDate = from_sys_days(year_zero_leap_day).unwrap();
    verify(year_zero_date.year == 0 && year_zero_date.month == 2 &&
           year_zero_date.day == 29);
}

#[test]
fn test_civil_date_day_arithmetic() {
    let leap_day: CivilDate = CivilDate { year: 2024, month: 2, day: 29 };
    let following: CivilDate = add_civil_days(leap_day, 1).unwrap();
    verify(following.year == 2024 && following.month == 3 &&
           following.day == 1);
    let preceding: CivilDate = add_civil_days(leap_day, -1).unwrap();
    verify(preceding.year == 2024 && preceding.month == 2 &&
           preceding.day == 28);

    let epoch: CivilDate = CivilDate { year: 1970, month: 1, day: 1 };
    let before_epoch: CivilDate = add_civil_days(epoch, -1).unwrap();
    verify(before_epoch.year == 1969 && before_epoch.month == 12 &&
           before_epoch.day == 31);
    verify(days_between(before_epoch, epoch).unwrap() == 1);
    verify(days_between(epoch, before_epoch).unwrap() == -1);

    let invalid: CivilDate = CivilDate { year: 2023, month: 2, day: 29 };
    verify(add_civil_days(invalid, 0).is_none());
    verify(days_between(invalid, epoch).is_none());

    let last_supported: CivilDate = CivilDate {
        year: 2147483647, month: 12, day: 31
    };
    let first_supported: CivilDate = CivilDate {
        year: -2147483648, month: 1, day: 1
    };
    verify(add_civil_days(last_supported, 1).is_none());
    verify(add_civil_days(first_supported, -1).is_none());
}

#[test]
fn test_civil_date_month_arithmetic() {
    let middle_of_month: CivilDate =
        CivilDate { year: 2024, month: 1, day: 15 };
    let next_month: CivilDate = add_civil_months(middle_of_month, 1).unwrap();
    verify(next_month.year == 2024 && next_month.month == 2 &&
           next_month.day == 15);
    let previous_year: CivilDate = add_civil_months(middle_of_month, -13).unwrap();
    verify(previous_year.year == 2022 && previous_year.month == 12 &&
           previous_year.day == 15);

    let month_end: CivilDate = CivilDate { year: 2024, month: 1, day: 31 };
    let invalid_february: CivilDate = add_civil_months(month_end, 1).unwrap();
    verify(invalid_february.year == 2024 && invalid_february.month == 2 &&
           invalid_february.day == 31);
    verify(!is_valid_civil_date(invalid_february.year,
                                invalid_february.month,
                                invalid_february.day));
    let leap_day: CivilDate = CivilDate { year: 2024, month: 2, day: 29 };
    let next_year: CivilDate = add_civil_months(leap_day, 12).unwrap();
    verify(next_year.year == 2025 && next_year.month == 2 &&
           next_year.day == 29);
    verify(!is_valid_civil_date(next_year.year, next_year.month, next_year.day));

    let invalid: CivilDate = CivilDate { year: 2023, month: 2, day: 29 };
    verify(add_civil_months(invalid, 1).is_none());
    let max_date: CivilDate = CivilDate {
        year: 2147483647, month: 12, day: 31
    };
    let min_date: CivilDate = CivilDate {
        year: -2147483648, month: 1, day: 1
    };
    verify(add_civil_months(max_date, 1).is_none());
    verify(add_civil_months(min_date, -1).is_none());
}

#[test]
fn test_civil_weekday_of_month() {
    let second_tuesday: CivilDate = nth_weekday_of_month(2024, 7, 2, 2).unwrap();
    verify(second_tuesday.year == 2024 && second_tuesday.month == 7 &&
           second_tuesday.day == 9);
    let last_friday: CivilDate = last_weekday_of_month(2024, 7, 5).unwrap();
    verify(last_friday.day == 26);

    let fifth_thursday: CivilDate =
        nth_weekday_of_month(2024, 2, 4, 5).unwrap();
    verify(fifth_thursday.day == 29);
    verify(nth_weekday_of_month(2021, 2, 1, 5).is_none());
    let leap_february_last_sunday: CivilDate =
        last_weekday_of_month(2024, 2, 0).unwrap();
    verify(leap_february_last_sunday.day == 25);

    verify(nth_weekday_of_month(2024, 13, 1, 1).is_none());
    verify(nth_weekday_of_month(2024, 1, 7, 1).is_none());
    verify(nth_weekday_of_month(2024, 1, 1, 0).is_none());
    verify(last_weekday_of_month(2024, 1, -1).is_none());
}

#[test]
fn test_unix_leap_day_utc_roundtrip() {
    let dt: DateTime = from_unix_utc(1709164800);
    verify(eq(format_iso8601(dt), "2024-02-29T00:00:00") == 1);
    verify(to_unix_utc(dt) == 1709164800);
}

#[test]
fn test_fixed_timezone_offset_conversion() {
    let plus_two: UtcOffset = offset_hours_minutes(2, 0);
    let local_dt: DateTime = from_unix(0, plus_two);
    verify(eq(format_iso8601_offset(local_dt, plus_two), "1970-01-01T02:00:00+02:00") == 1);
    verify(to_unix(local_dt, plus_two) == 0);

    let minus_five_thirty: UtcOffset = offset_hours_minutes(0 - 5, 30);
    let west_dt: DateTime = from_unix(0, minus_five_thirty);
    verify(eq(format_iso8601_offset(west_dt, minus_five_thirty), "1969-12-31T18:30:00-05:30") == 1);
    verify(to_unix(west_dt, minus_five_thirty) == 0);
}

#[test]
fn test_offset_seconds_and_formatting() {
    verify(eq(format_offset(offset_seconds(0)), "Z") == 1);
    verify(eq(format_offset(offset_seconds(19800)), "+05:30") == 1);
    verify(eq(format_offset(offset_seconds(0 - 12600)), "-03:30") == 1);
}

#[test]
fn test_local_timezone_matches_fixed_offset_at_timestamp() {
    let timestamp: i64 = 1704067200;
    let local_offset: UtcOffset = local_offset_at(timestamp);
    let local_dt: DateTime = from_unix_local(timestamp);
    let offset_dt: DateTime = from_unix(timestamp, local_offset);

    verify(local_dt.year == offset_dt.year);
    verify(local_dt.month == offset_dt.month);
    verify(local_dt.day == offset_dt.day);
    verify(local_dt.hour == offset_dt.hour);
    verify(local_dt.minute == offset_dt.minute);
    verify(local_dt.second == offset_dt.second);
    verify(to_unix(local_dt, local_offset) == timestamp);
}

#[test]
fn test_named_timezone_utc_roundtrip() {
    let zr: result<TimeZone, str8> = load_timezone("UTC");
    verify(!zr.is_err());
    let z: TimeZone = zr.unwrap();
    let dt: DateTime = from_unix_tz(0, z);
    verify(eq(format_iso8601(dt), "1970-01-01T00:00:00") == 1);
    verify(eq(format_offset(timezone_offset_at(z, 0)), "Z") == 1);
    verify(to_unix_tz(dt, z) == 0);
}

#[test]
fn test_named_timezone_iana_when_available() {
    let hr: result<TimeZone, str8> = load_timezone("Europe/Helsinki");
    if hr.is_err() {
        verify(true);
        return;
    }

    let helsinki: TimeZone = hr.unwrap();
    let winter: DateTime = from_unix_tz(1704067200, helsinki);
    let summer: DateTime = from_unix_tz(1719792000, helsinki);

    verify(eq(format_iso8601_offset(winter, timezone_offset_at(helsinki, 1704067200)), "2024-01-01T02:00:00+02:00") == 1);
    verify(eq(format_iso8601_offset(summer, timezone_offset_at(helsinki, 1719792000)), "2024-07-01T03:00:00+03:00") == 1);
    verify(to_unix_tz(winter, helsinki) == 1704067200);
    verify(to_unix_tz(summer, helsinki) == 1719792000);
}
