mod std::chrono;
mod std::testing;

use std::chrono::Duration;
use std::chrono::DurationUnit;
use std::chrono::DurationOrder;
use std::chrono::make_duration;
use std::chrono::duration_cast;
use std::chrono::duration_floor;
use std::chrono::duration_ceil;
use std::chrono::duration_round;
use std::chrono::duration_add;
use std::chrono::duration_subtract;
use std::chrono::duration_compare;
use std::testing::verify;
use std::testing::verify_eq_i64;

#[test]
fn test_chrono_duration_casts_and_truncation() {
    let ninety_seconds: option<Duration> =
        make_duration(90, DurationUnit::Second);
    verify(ninety_seconds.is_some());
    let seconds: Duration = ninety_seconds.unwrap();

    let milliseconds: option<Duration> =
        duration_cast(seconds, DurationUnit::Millisecond);
    verify(milliseconds.is_some());
    verify_eq_i64(90000, milliseconds.unwrap().count);

    let fractional_minute: option<Duration> =
        duration_cast(milliseconds.unwrap(), DurationUnit::Minute);
    verify(fractional_minute.is_some());
    verify_eq_i64(1, fractional_minute.unwrap().count);

    let negative: Duration = make_duration(-90001, DurationUnit::Millisecond)
        .unwrap();
    let negative_minutes: option<Duration> =
        duration_cast(negative, DurationUnit::Minute);
    verify(negative_minutes.is_some());
    verify_eq_i64(-1, negative_minutes.unwrap().count);

    let microseconds: option<Duration> =
        duration_cast(make_duration(4, DurationUnit::Millisecond).unwrap(),
                      DurationUnit::Microsecond);
    verify(microseconds.is_some());
    verify_eq_i64(4000, microseconds.unwrap().count);
}

#[test]
fn test_chrono_duration_arithmetic_uses_requested_unit() {
    let ninety_seconds: Duration =
        make_duration(90, DurationUnit::Second).unwrap();
    let two_minutes: Duration = make_duration(2, DurationUnit::Minute).unwrap();
    let total: option<Duration> =
        duration_add(ninety_seconds, two_minutes, DurationUnit::Second);
    verify(total.is_some());
    verify_eq_i64(210, total.unwrap().count);
    verify(total.unwrap().unit == DurationUnit::Second);

    let difference: option<Duration> =
        duration_subtract(two_minutes, ninety_seconds,
                          DurationUnit::Millisecond);
    verify(difference.is_some());
    verify_eq_i64(30000, difference.unwrap().count);
    verify(difference.unwrap().unit == DurationUnit::Millisecond);
}

#[test]
fn test_chrono_duration_reports_overflow() {
    let largest_milliseconds: Duration = make_duration(
        9223372036854775807, DurationUnit::Millisecond).unwrap();
    verify(duration_cast(largest_milliseconds,
                         DurationUnit::Nanosecond).is_none());

    let largest_seconds: Duration = make_duration(
        9223372036854775807, DurationUnit::Second).unwrap();
    let one_second: Duration = make_duration(1, DurationUnit::Second).unwrap();
    verify(duration_add(largest_seconds, one_second,
                        DurationUnit::Second).is_none());

    let smallest: Duration = make_duration(
        -9223372036854775807 - 1, DurationUnit::Second).unwrap();
    verify(duration_subtract(smallest, one_second,
                             DurationUnit::Second).is_none());
}

#[test]
fn test_chrono_duration_comparison_across_units() {
    let minute: Duration = make_duration(1, DurationUnit::Minute).unwrap();
    let sixty_seconds: Duration = make_duration(60, DurationUnit::Second).unwrap();
    let ninety_seconds: Duration = make_duration(90, DurationUnit::Second).unwrap();
    let less: option<DurationOrder> = duration_compare(minute, ninety_seconds);
    let equal: option<DurationOrder> =
        duration_compare(minute, sixty_seconds);
    let greater: option<DurationOrder> =
        duration_compare(ninety_seconds, minute);
    verify(less.is_some() && less.unwrap() == DurationOrder::Less);
    verify(equal.is_some() && equal.unwrap() == DurationOrder::Equivalent);
    verify(greater.is_some() && greater.unwrap() == DurationOrder::Greater);

    let negative_milliseconds: Duration =
        make_duration(-59000, DurationUnit::Millisecond).unwrap();
    let negative_minute: Duration =
        make_duration(-1, DurationUnit::Minute).unwrap();
    let negative_order: option<DurationOrder> =
        duration_compare(negative_milliseconds, negative_minute);
    verify(negative_order.is_some() &&
           negative_order.unwrap() == DurationOrder::Greater);

    let largest_nanoseconds: Duration = make_duration(
        9223372036854775807, DurationUnit::Nanosecond).unwrap();
    let largest_weeks: Duration = make_duration(
        9223372036854775807, DurationUnit::Week).unwrap();
    let extreme: option<DurationOrder> =
        duration_compare(largest_nanoseconds, largest_weeks);
    verify(extreme.is_some() && extreme.unwrap() == DurationOrder::Less);

    let smallest_nanoseconds: Duration = make_duration(
        -9223372036854775807 - 1, DurationUnit::Nanosecond).unwrap();
    let smallest_weeks: Duration = make_duration(
        -9223372036854775807 - 1, DurationUnit::Week).unwrap();
    let negative_extreme: option<DurationOrder> =
        duration_compare(smallest_nanoseconds, smallest_weeks);
    verify(negative_extreme.is_some() &&
           negative_extreme.unwrap() == DurationOrder::Greater);
}

#[test]
fn test_chrono_duration_rounding() {
    let positive: Duration = make_duration(90001, DurationUnit::Millisecond)
        .unwrap();
    let negative: Duration = make_duration(-90001, DurationUnit::Millisecond)
        .unwrap();
    let floor_positive: option<Duration> =
        duration_floor(positive, DurationUnit::Minute);
    let ceil_positive: option<Duration> =
        duration_ceil(positive, DurationUnit::Minute);
    let floor_negative: option<Duration> =
        duration_floor(negative, DurationUnit::Minute);
    let ceil_negative: option<Duration> =
        duration_ceil(negative, DurationUnit::Minute);
    verify(floor_positive.unwrap().count == 1);
    verify(ceil_positive.unwrap().count == 2);
    verify(floor_negative.unwrap().count == -2);
    verify(ceil_negative.unwrap().count == -1);

    let one_half: Duration = make_duration(90, DurationUnit::Second).unwrap();
    let two_half: Duration = make_duration(150, DurationUnit::Second).unwrap();
    let negative_one_half: Duration =
        make_duration(-90, DurationUnit::Second).unwrap();
    let negative_two_half: Duration =
        make_duration(-150, DurationUnit::Second).unwrap();
    verify(duration_round(one_half, DurationUnit::Minute).unwrap().count == 2);
    verify(duration_round(two_half, DurationUnit::Minute).unwrap().count == 2);
    verify(duration_round(negative_one_half, DurationUnit::Minute)
               .unwrap().count == -2);
    verify(duration_round(negative_two_half, DurationUnit::Minute)
               .unwrap().count == -2);

    let largest_subsecond: Duration = make_duration(
        9223372036854775807, DurationUnit::Nanosecond).unwrap();
    verify(duration_ceil(largest_subsecond, DurationUnit::Week).is_some());
    let min_value: Duration = make_duration(
        -9223372036854775807 - 1, DurationUnit::Nanosecond).unwrap();
    verify(duration_floor(min_value, DurationUnit::Week).is_some());
}
