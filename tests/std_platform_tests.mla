mod std::platform;
mod std::testing;

use std::platform::*;
use std::testing::verify_eq;
use std::testing::verify_true;

[windows]
fn region_selected_platform_name() -> str8 {
    return "windows";
}
[/windows]

[posix]
fn region_selected_platform_name() -> str8 {
    return "posix";
}
[/posix]

#[test]
fn test_platform_macros_and_helpers_are_consistent() {
    static_assert!(windows!() || posix!());
    static_assert!(!(windows!() && posix!()));
    static_assert!(!(linux!() && macos!()));
    static_assert!(!linux!() || posix!());
    static_assert!(!macos!() || posix!());
    static_assert!(!(x64!() && aarch64!()));

    verify_eq(windows!(), is_windows());
    verify_eq(posix!(), is_posix());
    verify_eq(linux!(), is_linux());
    verify_eq(macos!(), is_macos());
    verify_eq(x64!(), is_x64());
    verify_eq(aarch64!(), is_aarch64());
}

#[test]
fn test_platform_family_name_matches_flags() {
    let fam: str8 = family();
    if windows!() {
        verify_eq(fam, "windows");
    } else if macos!() {
        verify_eq(fam, "macos");
        verify_true(posix!());
    } else if linux!() {
        verify_eq(fam, "linux");
        verify_true(posix!());
    } else if posix!() {
        verify_eq(fam, "posix");
    } else {
        verify_eq(fam, "unknown");
    }
}

#[test]
fn test_platform_arch_name_matches_flags() {
    let name: str8 = arch();
    if aarch64!() {
        verify_eq(name, "aarch64");
    } else if x64!() {
        verify_eq(name, "x64");
    } else {
        verify_eq(name, "unknown");
    }
}

#[test]
fn test_platform_regions_select_only_matching_code() {
    if macos!() {
        verify_eq(region_selected_platform_name(), "posix");
    } else if linux!() {
        verify_eq(region_selected_platform_name(), "posix");
    } else if windows!() {
        verify_eq(region_selected_platform_name(), "windows");
    }
}
