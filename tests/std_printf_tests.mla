mod std::testing;
mod std::printf;
mod std::strbuf;

use std::printf::printf;
use std::printf::eprintf;
use std::printf::fprintf;
use std::strbuf::len;
use std::strbuf::eq;
use std::strbuf::contains;
use std::strbuf::starts_with;
use std::strbuf::ends_with;
use std::testing::verify;

// -- printf ---------------------------------------------------------------

#[test]
fn test_printf_plain() {
    printf("test_printf_plain\n");
    }

#[test]
fn test_printf_format_i32() {
    let s: str8 = format!("val={}\n", 42);
    verify(!(contains(s, "val=42") != 1));
    printf(s);
    }

#[test]
fn test_printf_format_multi_args() {
    let s: str8 = format!("a={} b={} c={}\n", 1, 2, 3);
    verify(!(contains(s, "a=1") != 1));
    verify(!(contains(s, "b=2") != 1));
    verify(!(contains(s, "c=3") != 1));
    printf(s);
    }

#[test]
fn test_printf_format_string_arg() {
    let name: str8 = "world";
    let s: str8 = format!("hello {}\n", name);
    verify(!(contains(s, "hello world") != 1));
    printf(s);
    }

#[test]
fn test_printf_format_bool() {
    let s_true: str8 = format!("flag={}\n", true);
    let s_false: str8 = format!("flag={}\n", false);
    // bools print as 1 / 0
    verify(!(contains(s_true,  "flag=1") != 1));
    verify(!(contains(s_false, "flag=0") != 1));
    printf(s_true);
    printf(s_false);
    }

#[test]
fn test_printf_negative_number() {
    let s: str8 = format!("neg={}\n", -99);
    verify(!(contains(s, "neg=-99") != 1));
    printf(s);
    }

#[test]
fn test_printf_i64_large() {
    let big: i64 = 1000000;
    let s: str8 = format!("big={}\n", big);
    verify(!(contains(s, "big=1000000") != 1));
    printf(s);
    }

#[test]
fn test_printf_empty_string() {
    // must not crash on empty input
    printf("");
    }

#[test]
fn test_printf_newline_only() {
    printf("\n");
    }

#[test]
fn test_printf_sequence() {
    printf("seq_line1\n");
    printf("seq_line2\n");
    printf("seq_line3\n");
    }

#[test]
fn test_printf_no_trailing_newline() {
    // printf does not append a newline -- verify format str8 has no \n
    let s: str8 = format!("no-nl-{}", 7);
    verify(!(ends_with(s, "\n") == 1));
    printf(s);
    printf("\n");   // emit newline separately so output stays clean
    }

// -- format str8 correctness --------------------------------------------

#[test]
fn test_format_string_length() {
    let s: str8 = format!("abc={}", 123);
    // "abc=123" is 7 characters
    verify(!(len(s) != 7));
    printf(s);
    printf("\n");
    }

#[test]
fn test_format_string_eq() {
    let s: str8 = format!("{}", 0);
    verify(!(eq(s, "0") != 1));
    printf(s);
    printf("\n");
    }

#[test]
fn test_format_starts_and_ends() {
    let s: str8 = format!("start-{}-end", 42);
    verify(!(starts_with(s, "start-") != 1));
    verify(!(ends_with(s, "-end") != 1));
    printf(s);
    printf("\n");
    }

#[test]
fn test_format_center_named_width() {
    let inner_width: i64 = 6;
    let s: str8 = format!("|{:^width$}|", "xy", width=inner_width);
    verify(!(eq(s, "|  xy  |") != 1));
    printf(s);
    printf("\n");
    }

// -- eprintf --------------------------------------------------------------

#[test]
fn test_eprintf_plain() {
    eprintf("test_eprintf_plain\n");
    }

#[test]
fn test_eprintf_format() {
    let s: str8 = format!("error code={}\n", 404);
    verify(!(contains(s, "error code=404") != 1));
    eprintf(s);
    }

#[test]
fn test_eprintf_empty() {
    eprintf("");
    }

// -- fprintf --------------------------------------------------------------

#[test]
fn test_fprintf_fd1_stdout() {
    let s: str8 = format!("fprintf fd={}\n", 1);
    fprintf(1, s);
    }

#[test]
fn test_fprintf_fd2_stderr() {
    let s: str8 = format!("fprintf fd={}\n", 2);
    fprintf(2, s);
    }

#[test]
fn test_fprintf_empty() {
    fprintf(1, "");
    fprintf(2, "");
    }
