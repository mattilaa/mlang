/// \file test_sample.mla
/// \brief Unit test example for \c mlang \c test.
///
/// Demonstrates basic \c #[test] functions using \c std::testing::verify.
/// Run with:
/// \code
///   mlang test tests/test_sample.mla -L ~/.local/lib/mlang -lmlang_std
///   mlang test tests/test_sample.mla --filter "addition" -L ~/.local/lib/mlang -lmlang_std
/// \endcode

mod std::testing;

use std::testing::verify;
// Sample tests for `mlang test`

#[test]
fn test_addition() {
    let x: i32 = 2 + 2;
    verify(x == 4);
}

#[test]
fn test_result_ok() {
    let r: result<i32, str8> = Ok<i32, str8>(123);
    verify(r.is_ok());
}
