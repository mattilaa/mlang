// Sample tests for `mlang test`

#[test]
fn test_addition() -> i32 {
    let x: i32 = 2 + 2;
    if x == 4: {
        return 0;
    }
    return 1;
}

#[test]
fn test_result_ok() -> i32 {
    let r: Result<i32, string> = Ok<i32, string>(123);
    if r.is_ok(): {
        return 0;
    }
    return 1;
}
