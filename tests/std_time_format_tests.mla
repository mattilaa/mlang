mod std::testing;
mod std::strbuf;
mod std::time;

use std::strbuf::contains;
use std::strbuf::eq;
use std::strbuf::len;
use std::strbuf::sub;
use std::time::format_local;
use std::time::local_datetime;
use std::time::local_datetime_ms;
use std::time::local_datetime_ns;
use std::testing::verify;

#[test]
fn test_local_datetime_shape() {
    let s: string = local_datetime();
    verify(!(len(s) != 19));
    verify(!(contains(s, ":") != 1));
    verify(!(contains(s, "/") != 1));
    }

#[test]
fn test_local_datetime_ms_shape() {
    let s: string = local_datetime_ms();
    verify(!(len(s) != 23));
    verify(!(contains(s, ".") != 1));
    }

#[test]
fn test_local_datetime_ns_shape() {
    let s: string = local_datetime_ns();
    verify(!(len(s) != 29));
    verify(!(contains(s, ".") != 1));
    }

#[test]
fn test_format_local_custom_pattern_shape() {
    let fmt: str8 = "DD/MM/YYYY:HH:MM:SS.MS";
    let s: string = format_local(fmt);
    verify(!(len(s) != 23));
    verify(!(eq(sub(s, 2, 1), "/") != 1));
    verify(!(eq(sub(s, 5, 1), "/") != 1));
    verify(!(eq(sub(s, 10, 1), ":") != 1));
    verify(!(eq(sub(s, 13, 1), ":") != 1));
    verify(!(eq(sub(s, 16, 1), ":") != 1));
    verify(!(eq(sub(s, 19, 1), ".") != 1));
    }
