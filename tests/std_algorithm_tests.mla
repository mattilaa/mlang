    let repeated: list<i32> = repeat_range(seven, 4);
    verify_eq_i32(7, repeated[0]);
    verify_eq_i32(7, repeated[3]);
}

#[test]
fn test_algorithm_ranges_repeat_nonpositive_count() {
    let nine: i32 = 9;
    let none: list<i32> = repeat_range(nine, 0);
    let negative: list<i32> = repeat_range(nine, -3);
    verify(none.len() == 0 && negative.len() == 0);
}

#[test]
fn test_algorithm_ranges_single_view() {
    let value: i32 = 42;
    let one: list<i32> = single_range(value);
    verify(one.len() == 1 && one[0] == value);
}

#[test]
fn test_algorithm_ranges_generic_unique_transforms() {
    let repeats: list<i32> = [1, 1, 2, 2, 3, 1, 1, 4];
    let adjacent: list<i32> = unique(repeats);
    verify(adjacent.len() == 5);
    verify(adjacent[0] == 1 && adjacent[1] == 2 && adjacent[2] == 3);
    verify(adjacent[3] == 1 && adjacent[4] == 4);
    let stable: list<i32> = unique_stable(repeats);
    verify(stable.len() == 4);
    verify(stable[0] == 1 && stable[1] == 2 && stable[2] == 3 && stable[3] == 4);
}

#[test]
fn test_algorithm_ranges_generic_clamp_transform() {
