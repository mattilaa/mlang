mod std::algorithm::fuzzy;
mod std::algorithm::fft;
mod std::algorithm::order;
mod std::algorithm::rand;
mod std::algorithm::regex;
mod std::strbuf;

use std::algorithm::fuzzy::best_index;
use std::algorithm::fuzzy::filter_indices;
use std::algorithm::fuzzy::is_match;
use std::algorithm::fuzzy::score;
use std::algorithm::fft::forward;
use std::algorithm::fft::inverse;
use std::algorithm::fft::is_power_of_two;
use std::algorithm::order::binary_search_i64;
use std::algorithm::order::is_sorted_i64;
use std::algorithm::order::lower_bound_i64;
use std::algorithm::order::reverse_i64;
use std::algorithm::order::sort_i64;
use std::algorithm::order::unique_sorted_i64;
use std::algorithm::order::upper_bound_i64;
use std::algorithm::rand::next_u64;
use std::algorithm::rand::range_i64;
use std::algorithm::rand::seed;
use std::algorithm::regex::Regex;
use std::strbuf::eq;
use std::strbuf::free;
use std::strbuf::sub;

#[test]
fn test_algorithm_fuzzy_match_and_score() -> i32 {
    if is_match("tracker_ui_demo.mla", "trui") != 1 { return 1; }
    if is_match("tracker_ui_demo.mla", "tuiz") != 0 { return 1; }
    if score("tracker_ui_demo.mla", "trui") < 0 { return 1; }
    return 0;
}

#[test]
fn test_algorithm_fuzzy_ranked_indices() -> i32 {
    let items: list<string> = [
        "stdlib/std/fs.mla",
        "examples/esc_widgets/tracker_ui_demo.mla",
        "tools/mlangd-mla/main.mla"
    ];
    let ranked: list<i64> = filter_indices(items, "escwid");
    if ranked.len() <= 0 { return 1; }
    return ranked[0] == 1 ? 0 : 1;
}

#[test]
fn test_algorithm_fuzzy_best_index() -> i32 {
    let items: list<string> = ["abc", "axbyc", "zzz"];
    let best: i64 = best_index(items, "abc");
    if best != 0 { return 1; }
    let none: i64 = best_index(items, "qqq");
    return none == -1 ? 0 : 1;
}

#[test]
fn test_algorithm_fft_namespace_roundtrip() -> i32 {
    if !is_power_of_two(8) {
        return 1;
    }
    if is_power_of_two(6) {
        return 1;
    }

    let data: list<i64> = [1, 0, 2, 0, 3, 0, 4, 0];
    let freq: list<i64> = forward(data);
    if freq.len() == 0 { return 1; }
    let out: list<i64> = inverse(freq);
    if out.len() == 0 { return 1; }
    for i in 0..4 {
        let base: i64 = i * 2;
        let re: i64 = out[base];
        let im: i64 = out[base + 1];
        if re != (i + 1) { return 1; }
        if im != 0 { return 1; }
    }
    return 0;
}

#[test]
fn test_algorithm_order_sort_and_reverse() -> i32 {
    let data: list<i64> = [5, 1, 3, 3, 2];
    let sorted: list<i64> = sort_i64(data);
    if is_sorted_i64(sorted) != 1 { return 1; }
    if sorted.len() != 5 { return 1; }
    if sorted[0] != 1 { return 1; }
    if sorted[1] != 2 { return 1; }
    if sorted[2] != 3 { return 1; }
    if sorted[3] != 3 { return 1; }
    if sorted[4] != 5 { return 1; }

    let rev: list<i64> = reverse_i64(sorted);
    if rev[0] != 5 { return 1; }
    if rev[4] != 1 { return 1; }
    return 0;
}

#[test]
fn test_algorithm_order_bounds_and_binary_search() -> i32 {
    let data: list<i64> = [1, 2, 3, 3, 5, 8];
    if lower_bound_i64(data, 0) != 0 { return 1; }
    if lower_bound_i64(data, 3) != 2 { return 1; }
    if lower_bound_i64(data, 4) != 4 { return 1; }
    if upper_bound_i64(data, 3) != 4 { return 1; }
    if upper_bound_i64(data, 8) != 6 { return 1; }
    if binary_search_i64(data, 5) != 1 { return 1; }
    if binary_search_i64(data, 6) != 0 { return 1; }
    return 0;
}

#[test]
fn test_algorithm_order_unique_sorted() -> i32 {
    let data: list<i64> = [1, 1, 2, 2, 2, 7, 9, 9];
    let uniq: list<i64> = unique_sorted_i64(data);
    if uniq.len() != 4 { return 1; }
    if uniq[0] != 1 { return 1; }
    if uniq[1] != 2 { return 1; }
    if uniq[2] != 7 { return 1; }
    if uniq[3] != 9 { return 1; }
    return 0;
}

#[test]
fn test_algorithm_rand_namespace_reproducible() -> i32 {
    seed(123);
    let a: u64 = next_u64();
    seed(123);
    let b: u64 = next_u64();
    if a != b { return 1; }
    for _i in 0..200 {
        let v: i64 = range_i64(10, 20);
        if v < 10 || v > 20 { return 1; }
    }
    return 0;
}

#[test]
fn test_algorithm_regex_namespace_basic() -> i32 {
    let rr: Result<Regex, string> = Regex::compile("([A-Za-z]+)-([0-9]+)");
    if rr.is_err(): { return 1; }
    let re: Regex = rr.unwrap();
    let text: string = "user-42";
    let s: i64 = re.find_start(text);
    let e: i64 = re.find_end(text);
    if s != 0 || e != 7: {
        re.close();
        return 1;
    }
    let m: string = sub(text, s, e - s);
    let ok: i32 = eq(m, "user-42");
    free(m);
    re.close();
    return ok == 1 ? 0 : 1;
}
