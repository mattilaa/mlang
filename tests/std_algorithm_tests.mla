#[test]
fn test_algorithm_ranges_projected_lookup_family() {
    let values: list<i32> = [11, 21, 29, 31, 34];
    let candidates: list<i32> = [28, 43];
    let absent: list<i32> = [48];
    let empty: list<i32> = [];
    let project_tens = |value: i32| { return value / 10; };

    verify(find_last_projected(values, 3, project_tens) == 4);
    verify(find_last_projected(values, 8, project_tens) == -1);
    verify(adjacent_find_projected(values, project_tens) == 1);
    verify(adjacent_find_projected(absent, project_tens) == -1);
    verify(adjacent_find_projected(empty, project_tens) == -1);
    verify(find_first_of_projected(
        values, candidates, project_tens, project_tens) == 1);
    verify(find_first_of_projected(
        values, absent, project_tens, project_tens) == -1);
    verify(find_first_of_projected(
        values, empty, project_tens, project_tens) == -1);
}

#[test]
fn test_algorithm_ranges_generic_includes() {
    let range: list<i32> = [1, 2, 2, 4, 7];
    let present: list<i64> = [2, 4, 7];
    let too_many: list<i32> = [2, 2, 2];
    let unordered: list<i32> = [4, 2];
    let empty: list<i32> = [];
    verify(includes(range, present));
    verify(!includes(range, too_many));
    verify(includes(range, empty));
    verify(!includes(empty, present));
    verify(!includes(range, unordered));
}

#[test]
fn test_algorithm_ranges_includes_by_comparator() {
    let range: list<i32> = [9, 7, 7, 3, 1];
    let subset: list<i32> = [7, 3];
    let too_many: list<i32> = [7, 7, 7];
    let empty: list<i32> = [];
    let greater = |a: i32, b: i32| { return a > b; };
    verify(includes_by(range, subset, greater));
    verify(!includes_by(range, too_many, greater));
    verify(includes_by(range, empty, greater));
}

#[test]
fn test_algorithm_ranges_includes_projected() {
    let range: list<i32> = [11, 21, 22, 41];
    let subset: list<i32> = [19, 28];
    let too_many: list<i32> = [12, 29, 27, 28];
    let absent: list<i32> = [18, 39];
    let empty: list<i32> = [];
    let project_tens = |value: i32| { return value / 10; };

    verify(includes_projected(range, subset, project_tens, project_tens));
    verify(!includes_projected(range, too_many, project_tens, project_tens));
    verify(!includes_projected(range, absent, project_tens, project_tens));
    verify(includes_projected(range, empty, project_tens, project_tens));
    verify(range[0] == 11 && range[2] == 22);
}

#[test]
fn test_algorithm_ranges_generic_size_empty_equal() {
    let numbers: list<i32> = [2, 4, 6];
    let same_values: list<i32> = [2, 4, 6];
    let different_values: list<i32> = [2, 4, 7];
    let no_values: list<i32> = [];

    verify(size(numbers) == 3);
    verify(empty(numbers) == false);
    verify(empty(no_values));
    verify(equal(numbers, same_values));
    verify(equal(numbers, different_values) == false);
    verify(equal(numbers, no_values) == false);
    let mixed_numbers: list<i64> = [2, 4, 6];
    verify(equal(numbers, mixed_numbers));

    let equal_prefix: tuple<i64, i64> = mismatch(numbers, mixed_numbers);
    verify(equal_prefix.0 == 3 && equal_prefix.1 == 3);
    let differing: list<i64> = [2, 9, 6, 8];
    let first_difference: tuple<i64, i64> = mismatch(numbers, differing);
    verify(first_difference.0 == 1 && first_difference.1 == 1);
    let shorter: list<i32> = [2, 4];
    let end_of_shorter: tuple<i64, i64> = mismatch(numbers, shorter);
    verify(end_of_shorter.0 == 2 && end_of_shorter.1 == 2);
}

#[test]
fn test_algorithm_ranges_equal_by_equivalence() {
    let left: list<i32> = [11, 12, 23];
    let same_keys: list<i32> = [19, 10, 29];
    let different_keys: list<i32> = [19, 20, 29];
    let shorter: list<i32> = [19, 10];
    let by_tens = |a: i32, b: i32| { return a / 10 == b / 10; };

    verify(equal_by(left, same_keys, by_tens));
    verify(!equal_by(left, different_keys, by_tens));
    verify(!equal_by(left, shorter, by_tens));

    let mismatch_indices: tuple<i64, i64> = mismatch_by(left, same_keys, by_tens);
    verify(mismatch_indices.0 == 3 && mismatch_indices.1 == 3);
    let mismatch_at_one: tuple<i64, i64> = mismatch_by(left, different_keys, by_tens);
    verify(mismatch_at_one.0 == 1 && mismatch_at_one.1 == 1);
}

#[test]
fn test_algorithm_ranges_equal_and_mismatch_by_projected() {
    let left: list<i32> = [11, 12, 23];
    let same_keys: list<i64> = [19, 10, 29];
    let different_keys: list<i64> = [19, 20, 29];
    let shorter: list<i64> = [19, 10];
    let identity = |value: i32| { return value; };
    let identity_wide = |value: i64| { return i32(value); };
    let same_decade = |a: i32, b: i32| { return a / 10 == b / 10; };

    verify(equal_by_projected(
        left, same_keys, same_decade, identity, identity_wide));
    verify(!equal_by_projected(
        left, different_keys, same_decade, identity, identity_wide));
    verify(!equal_by_projected(
        left, shorter, same_decade, identity, identity_wide));
    let end: tuple<i64, i64> = mismatch_by_projected(
        left, same_keys, same_decade, identity, identity_wide);
    let first_difference: tuple<i64, i64> = mismatch_by_projected(
        left, different_keys, same_decade, identity, identity_wide);
    let short_end: tuple<i64, i64> = mismatch_by_projected(
        left, shorter, same_decade, identity, identity_wide);
    verify(end.0 == 3 && end.1 == 3);
    verify(first_difference.0 == 1 && first_difference.1 == 1);
    verify(short_end.0 == 2 && short_end.1 == 2);
}

#[test]
fn test_algorithm_ranges_generic_is_permutation() {
    let values: list<i32> = [1, 2, 2, 3];
    let reordered: list<i32> = [3, 2, 1, 2];
    let wrong_counts: list<i32> = [3, 3, 1, 2];
    let different_size: list<i32> = [1, 2, 3];
    let mixed_width: list<i64> = [2, 3, 2, 1];

    verify(is_permutation(values, reordered));
    verify(is_permutation(values, mixed_width));
    verify(is_permutation(values, wrong_counts) == false);
    verify(is_permutation(values, different_size) == false);
}

#[test]
fn test_algorithm_ranges_projected_comparisons() {
    let left: list<i32> = [11, 21, 32, 43];
    let equal_keys: list<i32> = [19, 28, 38, 47];
    let mismatch_keys: list<i32> = [19, 38, 47];
    let project_left = |value: i32| { return value / 10; };
    let project_right = |value: i32| { return value / 10; };

    verify(equal_projected(left, equal_keys, project_left, project_right));
    let no_mismatch: tuple<i64, i64> = mismatch_projected(
        left, equal_keys, project_left, project_right);
    verify(no_mismatch.0 == 4 && no_mismatch.1 == 4);
    let mismatch_at_one: tuple<i64, i64> = mismatch_projected(
        left, mismatch_keys, project_left, project_right);
    verify(mismatch_at_one.0 == 1 && mismatch_at_one.1 == 1);

    let perm_left: list<i32> = [11, 21, 32, 14];
    let perm_right: list<i32> = [19, 13, 28, 35];
    verify(is_permutation_projected(
        perm_left, perm_right, project_left, project_right));
    let wrong_counts: list<i32> = [19, 13, 28, 46];
    verify(!is_permutation_projected(
        perm_left, wrong_counts, project_left, project_right));

    let less_tens = |a: i32, b: i32| { return a / 10 < b / 10; };
    let identity = |value: i32| { return value; };
    let identity_wide = |value: i64| { return i32(value); };
    let comparator_perm_left: list<i32> = [11, 19, 22, 25];
    let comparator_perm_right: list<i64> = [12, 28, 18, 29];
    verify(is_permutation_by_projected(
        comparator_perm_left, comparator_perm_right, less_tens,
        identity, identity_wide));
    let wrong_comparator_perm: list<i64> = [12, 18, 14, 29];
    verify(!is_permutation_by_projected(
        comparator_perm_left, wrong_comparator_perm, less_tens,
        identity, identity_wide));

    let prefix: list<i32> = [19, 28];
    let wrong_prefix: list<i32> = [19, 39];
    let suffix: list<i32> = [31, 44];
    verify(starts_with_projected(left, prefix, project_left, project_right));
    verify(!starts_with_projected(
        left, wrong_prefix, project_left, project_right));
    verify(ends_with_projected(left, suffix, project_left, project_right));
}

#[test]
fn test_algorithm_ranges_is_permutation_by_equivalence() {
    let values: list<i32> = [11, 12, 12, 23];
    let reordered: list<i32> = [19, 10, 29, 12];
    let wrong_counts: list<i32> = [19, 20, 29, 12];
    let different_size: list<i32> = [19, 10, 29];
    let by_tens = |a: i32, b: i32| { return a / 10 == b / 10; };

    verify(is_permutation_by(values, reordered, by_tens));
    verify(!is_permutation_by(values, wrong_counts, by_tens));
    verify(!is_permutation_by(values, different_size, by_tens));
}

#[test]
fn test_algorithm_ranges_predicate_comparisons_heterogeneous() {
    let same_decade = |left: i32, right: i64| {
        return left / 10 == right / 10;
    };
    let left: list<i32> = [11, 22, 23, 14];
    let equal_right: list<i64> = [19, 29, 21, 10];
    let unequal_right: list<i64> = [19, 29, 31, 10];
    verify(equal_by(left, equal_right, same_decade));
    verify(!equal_by(left, unequal_right, same_decade));

}

#[test]
fn test_algorithm_ranges_generic_starts_with() {
    let values: list<i32> = [3, 5, 8, 13];
    let prefix: list<i32> = [3, 5];
    let mismatch: list<i32> = [3, 6];
    let too_long: list<i32> = [3, 5, 8, 13, 21];
