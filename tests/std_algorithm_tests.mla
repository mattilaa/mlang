mod std::testing;
mod std::algorithm::fuzzy;
mod std::algorithm::fft;
mod std::algorithm::numeric;
mod std::algorithm::order;
mod std::algorithm::rand;
mod std::algorithm::regex;
mod std::strbuf;

use std::algorithm::fuzzy::best_index;
use std::algorithm::fuzzy::filter_indices;
use std::algorithm::fuzzy::is_match;
use std::algorithm::fuzzy::score;
use std::algorithm::fft::forward;
use std::algorithm::fft::inverse;
use std::algorithm::fft::is_power_of_two;
use std::algorithm::numeric::accumulate_i64;
use std::algorithm::numeric::adjacent_difference_i64;
use std::algorithm::numeric::inner_product_i64;
use std::algorithm::numeric::partial_sum_i64;
use std::algorithm::order::binary_search_i64;
use std::algorithm::order::is_sorted_i64;
use std::algorithm::order::lower_bound_i64;
use std::algorithm::order::reverse_i64;
use std::algorithm::order::sort_i64;
use std::algorithm::order::unique_sorted_i64;
use std::algorithm::order::upper_bound_i64;
use std::algorithm::rand::next_u64;
use std::algorithm::rand::range_i64;
use std::algorithm::rand::seed;
use std::algorithm::regex::Regex;
use std::strbuf::eq;
use std::strbuf::free;
use std::strbuf::sub;
use std::testing::verify;

#[test]
fn test_algorithm_fuzzy_match_and_score() {
    if is_match("tracker_ui_demo.mla", "trui") != 1 { verify(false); }
    if is_match("tracker_ui_demo.mla", "tuiz") != 0 { verify(false); }
    if score("tracker_ui_demo.mla", "trui") < 0 { verify(false); }
    }

#[test]
fn test_algorithm_fuzzy_ranked_indices() {
    let items: list<string> = [
        "stdlib/std/fs.mla",
        "examples/esc_widgets/tracker_ui_demo.mla",
        "tools/mlangd-mla/main.mla"
    ];
    let ranked: list<i64> = filter_indices(items, "escwid");
    if ranked.len() <= 0 { verify(false); }
    verify(ranked[0] == 1);
}

#[test]
fn test_algorithm_fuzzy_best_index() {
    let items: list<string> = ["abc", "axbyc", "zzz"];
    let best: i64 = best_index(items, "abc");
    if best != 0 { verify(false); }
    let none: i64 = best_index(items, "qqq");
    verify(none == -1);
}

#[test]
fn test_algorithm_fft_namespace_roundtrip() {
    if !is_power_of_two(8) {
        verify(false);
    }
    if is_power_of_two(6) {
        verify(false);
    }

    let data: list<i64> = [1, 0, 2, 0, 3, 0, 4, 0];
    let freq: list<i64> = forward(data);
    if freq.len() == 0 { verify(false); }
    let out: list<i64> = inverse(freq);
    if out.len() == 0 { verify(false); }
    for i in 0..4 {
        let base: i64 = i * 2;
        let re: i64 = out[base];
        let im: i64 = out[base + 1];
        if re != (i + 1) { verify(false); }
        if im != 0 { verify(false); }
    }
    }

#[test]
fn test_algorithm_order_sort_and_reverse() {
    let data: list<i64> = [5, 1, 3, 3, 2];
    let sorted: list<i64> = sort_i64(data);
    if is_sorted_i64(sorted) != 1 { verify(false); }
    if sorted.len() != 5 { verify(false); }
    if sorted[0] != 1 { verify(false); }
    if sorted[1] != 2 { verify(false); }
    if sorted[2] != 3 { verify(false); }
    if sorted[3] != 3 { verify(false); }
    if sorted[4] != 5 { verify(false); }

    let rev: list<i64> = reverse_i64(sorted);
    if rev[0] != 5 { verify(false); }
    if rev[4] != 1 { verify(false); }
    }

#[test]
fn test_algorithm_order_bounds_and_binary_search() {
    let data: list<i64> = [1, 2, 3, 3, 5, 8];
    if lower_bound_i64(data, 0) != 0 { verify(false); }
    if lower_bound_i64(data, 3) != 2 { verify(false); }
    if lower_bound_i64(data, 4) != 4 { verify(false); }
    if upper_bound_i64(data, 3) != 4 { verify(false); }
    if upper_bound_i64(data, 8) != 6 { verify(false); }
    if binary_search_i64(data, 5) != 1 { verify(false); }
    if binary_search_i64(data, 6) != 0 { verify(false); }
    }

#[test]
fn test_algorithm_order_unique_sorted() {
    let data: list<i64> = [1, 1, 2, 2, 2, 7, 9, 9];
    let uniq: list<i64> = unique_sorted_i64(data);
    if uniq.len() != 4 { verify(false); }
    if uniq[0] != 1 { verify(false); }
    if uniq[1] != 2 { verify(false); }
    if uniq[2] != 7 { verify(false); }
    if uniq[3] != 9 { verify(false); }
    }

#[test]
fn test_algorithm_numeric_accumulate_and_inner_product() {
    let a: list<i64> = [1, 2, 3, 4];
    let b: list<i64> = [10, 20, 30];
    if accumulate_i64(a, 0) != 10 { verify(false); }
    if accumulate_i64(a, 5) != 15 { verify(false); }
    if inner_product_i64(a, b, 7) != (7 + 10 + 40 + 90) { verify(false); }
    }

#[test]
fn test_algorithm_numeric_partial_sum_and_adjacent_difference() {
    let data: list<i64> = [2, 3, 5];
    let ps: list<i64> = partial_sum_i64(data, 10);
    if ps.len() != 3 { verify(false); }
    if ps[0] != 12 { verify(false); }
    if ps[1] != 15 { verify(false); }
    if ps[2] != 20 { verify(false); }

    let ad: list<i64> = adjacent_difference_i64(ps, 10);
    if ad.len() != 3 { verify(false); }
    if ad[0] != 2 { verify(false); }
    if ad[1] != 3 { verify(false); }
    if ad[2] != 5 { verify(false); }
    }

#[test]
fn test_algorithm_rand_namespace_reproducible() {
    seed(123);
    let a: u64 = next_u64();
    seed(123);
    let b: u64 = next_u64();
    if a != b { verify(false); }
    for _i in 0..200 {
        let v: i64 = range_i64(10, 20);
        if v < 10 || v > 20 { verify(false); }
    }
    }

#[test]
fn test_algorithm_regex_namespace_basic() {
    let rr: Result<Regex, string> = Regex::compile("([A-Za-z]+)-([0-9]+)");
    if rr.is_err(): { verify(false); }
    let re: Regex = rr.unwrap();
    let text: string = "user-42";
    let s: i64 = re.find_start(text);
    let e: i64 = re.find_end(text);
    if s != 0 || e != 7: {
        verify(false);
    }
    let m: string = sub(text, s, e - s);
    let ok: i32 = eq(m, "user-42");
    free(m);
    re.close();
    verify(ok == 1);
}
