#[test]
fn test_algorithm_ranges_generic_unique_transforms() {
    let repeats: list<i32> = [1, 1, 2, 2, 3, 1, 1, 4];
    let adjacent: list<i32> = unique(repeats);
    verify(adjacent.len() == 5);
    verify(adjacent[0] == 1 && adjacent[1] == 2 && adjacent[2] == 3);
    verify(adjacent[3] == 1 && adjacent[4] == 4);
    let copied: list<i32> = unique_copy(repeats);
    verify(copied.len() == 5 && copied[0] == 1 && copied[4] == 4);
    let stable: list<i32> = unique_stable(repeats);
    verify(stable.len() == 4);
    verify(stable[0] == 1 && stable[1] == 2 && stable[2] == 3 && stable[3] == 4);
}

#[test]
fn test_algorithm_ranges_unique_by_projected() {
    let values: list<i32> = [11, 31, 22, 42, 51, 71];
    let project_tens = |value: i32| { return value / 10; };
    let same_parity = |left: i32, right: i32| {
        return left % 2 == right % 2;
    };
    let distinct_runs: list<i32> = unique_by_projected(
        values, same_parity, project_tens);
    verify(distinct_runs.len() == 3);
    verify(distinct_runs[0] == 11 && distinct_runs[1] == 22 &&
           distinct_runs[2] == 51);

    let copied_runs: list<i32> = unique_copy_by_projected(
        values, same_parity, project_tens);
    verify(copied_runs.len() == 3 && copied_runs[0] == 11 &&
           copied_runs[1] == 22 && copied_runs[2] == 51);
    verify(values.len() == 6 && values[0] == 11 && values[5] == 71);

    let empty: list<i32> = [];
    let empty_runs: list<i32> = unique_by_projected(
        empty, same_parity, project_tens);
    verify(empty_runs.len() == 0);
}

