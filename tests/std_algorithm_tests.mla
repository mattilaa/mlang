#[test]
fn test_algorithm_fuzzy_match_and_score() {
    verify(is_match("tracker_ui_demo.mla", "trui") == 1);
    verify(is_match("tracker_ui_demo.mla", "tuiz") == 0);
    verify(score("tracker_ui_demo.mla", "trui") >= 0);
}

#[test]
fn test_algorithm_fuzzy_ranked_indices() {
    let items: list<str8> = [
        "stdlib/std/fs.mla",
        "examples/esc_widgets/tracker_ui_demo.mla",
        "tools/mlangd-mla/main.mla"
    ];
    let ranked: list<i64> = filter_indices(items, "escwid");
    verify(ranked.len() > 0);
    verify(ranked[0] == 1);
}

#[test]
fn test_algorithm_fuzzy_best_index() {
    let items: list<str8> = ["abc", "axbyc", "zzz"];
    let best: i64 = best_index(items, "abc");
    verify(best == 0);
    let none: i64 = best_index(items, "qqq");
    verify(none == -1);
}

#[test]
fn test_algorithm_fft_namespace_roundtrip() {
    verify(is_power_of_two(8));
    verify(!is_power_of_two(6));

    let data: list<i64> = [1, 0, 2, 0, 3, 0, 4, 0];
    let freq: list<i64> = forward(data);
    verify(freq.len() > 0);
    let out: list<i64> = inverse(freq);
    verify(out.len() > 0);
    for i in 0..4 {
        let base: i64 = i * 2;
        let re: i64 = out[base];
        let im: i64 = out[base + 1];
        verify(re == (i + 1));
        verify(im == 0);
    }
}

#[test]
fn test_algorithm_order_sort_and_reverse() {
    let data: list<i64> = [5, 1, 3, 3, 2];
    let sorted: list<i64> = sort_i64(data);
    verify(is_sorted_i64(sorted) == 1);
    verify(sorted.len() == 5);
    verify(sorted[0] == 1);
    verify(sorted[1] == 2);
    verify(sorted[2] == 3);
    verify(sorted[3] == 3);
    verify(sorted[4] == 5);

    let rev: list<i64> = reverse_i64(sorted);
    verify(rev[0] == 5);
    verify(rev[4] == 1);
}

#[test]
fn test_algorithm_order_bounds_and_binary_search() {
    let data: list<i64> = [1, 2, 3, 3, 5, 8];
    verify(lower_bound_i64(data, 0) == 0);
    verify(lower_bound_i64(data, 3) == 2);
    verify(lower_bound_i64(data, 4) == 4);
    verify(upper_bound_i64(data, 3) == 4);
    verify(upper_bound_i64(data, 8) == 6);
    verify(binary_search_i64(data, 5) == 1);
    verify(binary_search_i64(data, 6) == 0);
}

#[test]
fn test_algorithm_order_unique_sorted() {
    let data: list<i64> = [1, 1, 2, 2, 2, 7, 9, 9];
    let uniq: list<i64> = unique_sorted_i64(data);
    verify(uniq.len() == 4);
    verify(uniq[0] == 1);
    verify(uniq[1] == 2);
    verify(uniq[2] == 7);
    verify(uniq[3] == 9);
}

#[test]
fn test_algorithm_ranges_unique_variants() {
    let data: list<i64> = [1, 1, 2, 2, 3, 1, 1, 4, 4];
    let adj: list<i64> = unique_i64(data);
    verify(adj.len() == 5);
    verify(adj[0] == 1 && adj[1] == 2 && adj[2] == 3 && adj[3] == 1 && adj[4] == 4);

    let stable: list<i64> = unique_stable_i64(data);
    verify(stable.len() == 4);
    verify(stable[0] == 1 && stable[1] == 2 && stable[2] == 3 && stable[3] == 4);
}

#[test]
fn test_algorithm_ranges_generic_find_count_contains() {
    let numbers: list<i32> = [3, 4, 4, 8];
    verify(find(numbers, 4) == 1);
    verify(find(numbers, 9) == -1);
    verify(count(numbers, 4) == 2);
    verify(contains(numbers, 8));
    verify(contains(numbers, 9) == false);

    let words: list<str8> = ["mango", "pear", "mango"];
    verify(find(words, "pear") == 1);
    verify(find_last(words, "mango") == 2);
    verify(count(words, "mango") == 2);
    verify(contains(words, "plum") == false);
    verify(find_last(words, "plum") == -1);
}

#[test]
fn test_algorithm_ranges_generic_adjacent_find() {
    let values: list<i32> = [4, 7, 7, 9, 9];
    verify(adjacent_find(values) == 1);
    let no_match: list<str8> = ["a", "b", "c"];
    let one: list<i32> = [5];
    let empty: list<i32> = [];
    let repeated: list<str8> = ["x", "y", "y"];
    verify(adjacent_find(no_match) == -1);
    verify(adjacent_find(one) == -1 && adjacent_find(empty) == -1);
    verify(adjacent_find(repeated) == 1);
}

#[test]
fn test_algorithm_ranges_generic_find_first_of() {
    let values: list<i32> = [8, 6, 4, 2];
    let candidates: list<i64> = [2, 6];
    verify(find_first_of(values, candidates) == 1);
    let none: list<i64> = [11, 13];
    let empty: list<i32> = [];
    verify(find_first_of(values, none) == -1);
    verify(find_first_of(empty, candidates) == -1);
}

#[test]
fn test_algorithm_ranges_generic_includes() {
    let range: list<i32> = [1, 2, 2, 4, 7];
    let present: list<i64> = [2, 4, 7];
    let too_many: list<i32> = [2, 2, 2];
    let unordered: list<i32> = [4, 2];
    let empty: list<i32> = [];
    verify(includes(range, present));
    verify(!includes(range, too_many));
    verify(includes(range, empty));
    verify(!includes(empty, present));
    verify(!includes(range, unordered));
}

#[test]
fn test_algorithm_ranges_includes_by_comparator() {
    let range: list<i32> = [9, 7, 7, 3, 1];
    let subset: list<i32> = [7, 3];
    let too_many: list<i32> = [7, 7, 7];
    let empty: list<i32> = [];
    let greater = |a: i32, b: i32| { return a > b; };
    verify(includes_by(range, subset, greater));
    verify(!includes_by(range, too_many, greater));
    verify(includes_by(range, empty, greater));
}

#[test]
fn test_algorithm_ranges_generic_size_empty_equal() {
    let numbers: list<i32> = [2, 4, 6];
    let same_values: list<i32> = [2, 4, 6];
    let different_values: list<i32> = [2, 4, 7];
    let no_values: list<i32> = [];

    verify(size(numbers) == 3);
    verify(empty(numbers) == false);
    verify(empty(no_values));
    verify(equal(numbers, same_values));
    verify(equal(numbers, different_values) == false);
    verify(equal(numbers, no_values) == false);
    let mixed_numbers: list<i64> = [2, 4, 6];
    verify(equal(numbers, mixed_numbers));
}

#[test]
fn test_algorithm_ranges_equal_by_equivalence() {
    let left: list<i32> = [11, 12, 23];
    let same_keys: list<i32> = [19, 10, 29];
    let different_keys: list<i32> = [19, 20, 29];
    let shorter: list<i32> = [19, 10];
    let by_tens = |a: i32, b: i32| { return a / 10 == b / 10; };

    verify(equal_by(left, same_keys, by_tens));
    verify(!equal_by(left, different_keys, by_tens));
    verify(!equal_by(left, shorter, by_tens));
}

#[test]
fn test_algorithm_ranges_generic_is_permutation() {
    let values: list<i32> = [1, 2, 2, 3];
    let reordered: list<i32> = [3, 2, 1, 2];
    let wrong_counts: list<i32> = [3, 3, 1, 2];
    let different_size: list<i32> = [1, 2, 3];
    let mixed_width: list<i64> = [2, 3, 2, 1];

    verify(is_permutation(values, reordered));
    verify(is_permutation(values, mixed_width));
    verify(is_permutation(values, wrong_counts) == false);
    verify(is_permutation(values, different_size) == false);
}

#[test]
fn test_algorithm_ranges_is_permutation_by_equivalence() {
    let values: list<i32> = [11, 12, 12, 23];
    let reordered: list<i32> = [19, 10, 29, 12];
    let wrong_counts: list<i32> = [19, 20, 29, 12];
    let different_size: list<i32> = [19, 10, 29];
    let by_tens = |a: i32, b: i32| { return a / 10 == b / 10; };

    verify(is_permutation_by(values, reordered, by_tens));
    verify(!is_permutation_by(values, wrong_counts, by_tens));
    verify(!is_permutation_by(values, different_size, by_tens));
}

#[test]
fn test_algorithm_ranges_generic_starts_with() {
    let values: list<i32> = [3, 5, 8, 13];
    let prefix: list<i32> = [3, 5];
    let mismatch: list<i32> = [3, 6];
    let too_long: list<i32> = [3, 5, 8, 13, 21];
    let empty: list<i32> = [];

    verify(starts_with(values, prefix));
    verify(starts_with(values, mismatch) == false);
    verify(starts_with(values, too_long) == false);
    verify(starts_with(values, empty));
    let mixed_prefix: list<i64> = [3, 5, 8];
    verify(starts_with(values, mixed_prefix));
}

#[test]
fn test_algorithm_ranges_generic_search_subrange() {
    let values: list<i32> = [4, 7, 4, 7, 9];
    let pattern: list<i32> = [4, 7];
    let mixed_pattern: list<i64> = [7, 9];
    let later: list<i32> = [7, 9];
    let absent: list<i32> = [9, 7];
    let too_long: list<i32> = [4, 7, 4, 7, 9, 10];
    let empty: list<i32> = [];

    verify(search(values, pattern) == 0);
    verify(search(values, later) == 3);
    verify(search(values, mixed_pattern) == 3);
    verify(search(values, absent) == -1);
    verify(search(values, too_long) == -1);
    verify(search(values, empty) == 0);
    verify(contains_subrange(values, later));
    verify(contains_subrange(values, absent) == false);
    verify(contains_subrange(values, empty));
}

#[test]
fn test_algorithm_ranges_generic_find_end() {
    let data: list<i32> = [1, 2, 1, 2, 1];
    let pattern: list<i64> = [1, 2, 1];
    let missing: list<i32> = [2, 2];
    let empty: list<i32> = [];
    verify(find_end(data, pattern) == 2);
    verify(find_end(data, missing) == -1);
    verify(find_end(data, empty) == 5);
}

#[test]
fn test_algorithm_ranges_generic_ends_with() {
    let values: list<i32> = [3, 5, 8, 13];
    let suffix: list<i32> = [8, 13];
    let mismatch: list<i32> = [8, 12];
    let too_long: list<i32> = [1, 3, 5, 8, 13];
    let empty: list<i32> = [];

    verify(ends_with(values, suffix));
    verify(ends_with(values, mismatch) == false);
    verify(ends_with(values, too_long) == false);
    verify(ends_with(values, empty));
    let mixed_suffix: list<i64> = [8, 13];
    verify(ends_with(values, mixed_suffix));
}

#[test]
fn test_algorithm_ranges_generic_lexicographical_compare() {
    let first: list<i32> = [1, 2, 9];
    let before: list<i32> = [1, 3];
    let after: list<i32> = [1, 2, 9, 0];
    let equal_values: list<i32> = [1, 2, 9];
    let empty: list<i32> = [];

    verify(lexicographical_compare(first, before));
    verify(lexicographical_compare(first, after));
    verify(lexicographical_compare(first, equal_values) == false);
    verify(lexicographical_compare(empty, first));
    verify(lexicographical_compare(first, empty) == false);
    let mixed: list<i64> = [1, 2, 10];
    verify(lexicographical_compare(first, mixed));
    verify(lexicographical_compare(mixed, first) == false);
}

#[test]
fn test_algorithm_ranges_lexicographical_compare_by() {
    let first: list<i32> = [9, 7];
    let before: list<i32> = [9, 6];
    let after: list<i32> = [9, 8];
    let extended: list<i32> = [9, 7, 3];
    let greater = |a: i32, b: i32| { return a > b; };
    verify(lexicographical_compare_by(first, before, greater));
    verify(!lexicographical_compare_by(first, after, greater));
    verify(lexicographical_compare_by(first, extended, greater));
    verify(!lexicographical_compare_by(extended, first, greater));

    let equivalent: list<i32> = [9, 7];
    verify(!lexicographical_compare_by(first, equivalent, greater));
}

#[test]
fn test_algorithm_ranges_generic_is_sorted() {
    let sorted: list<i32> = [1, 2, 2, 9];
    let unsorted: list<i32> = [1, 4, 3, 9];
    let empty: list<i32> = [];
    let one: list<str8> = ["only"];

    verify(is_sorted(sorted));
    verify(is_sorted(unsorted) == false);
    verify(is_sorted(empty));
    verify(is_sorted(one));
}

#[test]
fn test_algorithm_ranges_generic_is_sorted_until() {
    let sorted_values: list<i32> = [1, 2, 2, 5];
    let unsorted_values: list<i32> = [1, 4, 3, 8];
    let empty: list<i32> = [];
    let one: list<i32> = [9];
    verify(is_sorted_until(sorted_values) == 4);
    verify(is_sorted_until(unsorted_values) == 2);
    verify(is_sorted_until(empty) == 0);
    verify(is_sorted_until(one) == 1);
}

#[test]
fn test_algorithm_ranges_generic_heap_queries() {
    let heap: list<i32> = [9, 7, 8, 2, 3, 1];
    let invalid: list<i32> = [9, 7, 8, 10, 2];
    let empty: list<i32> = [];
    let one: list<i32> = [4];
    verify(is_heap(heap) && is_heap_until(heap) == 6);
    verify(!is_heap(invalid) && is_heap_until(invalid) == 3);
    verify(is_heap(empty) && is_heap_until(empty) == 0);
    verify(is_heap(one) && is_heap_until(one) == 1);
}

#[test]
fn test_algorithm_ranges_comparator_heap_queries() {
    let min_heap: list<i32> = [1, 3, 2, 9, 8, 4];
    let invalid: list<i32> = [1, 5, 2, 3];
    let empty: list<i32> = [];
    let one: list<i32> = [4];
    let greater = |a: i32, b: i32| { return a > b; };
    verify(is_heap_by(min_heap, greater));
    verify(is_heap_until_by(min_heap, greater) == 6);
    verify(!is_heap_by(invalid, greater));
    verify(is_heap_until_by(invalid, greater) == 3);
    verify(is_heap_by(empty, greater));
    verify(is_heap_until_by(empty, greater) == 0);
    verify(is_heap_by(one, greater) && is_heap_until_by(one, greater) == 1);
}

#[test]
fn test_algorithm_ranges_generic_merged() {
    let left: list<i32> = [1, 3, 3, 8];
    let right: list<i32> = [2, 3, 7];
    let result: list<i32> = merged(left, right);
    verify(result.len() == 7);
    verify(result[0] == 1 && result[1] == 2 && result[2] == 3);
    verify(result[3] == 3 && result[4] == 3 && result[5] == 7 && result[6] == 8);
    verify(left[0] == 1 && right[0] == 2);
    let empty: list<i32> = [];
    let one_side: list<i32> = merged(empty, right);
    verify(one_side.len() == 3 && one_side[2] == 7);
}

#[test]
fn test_algorithm_ranges_generic_union_sorted() {
    let left: list<i32> = [1, 2, 2, 5];
    let right: list<i32> = [2, 3, 5, 5];
    let result: list<i32> = union_sorted(left, right);
    verify(result.len() == 6);
    verify(result[0] == 1 && result[1] == 2 && result[2] == 2);
    verify(result[3] == 3 && result[4] == 5 && result[5] == 5);
}

#[test]
fn test_algorithm_ranges_generic_intersection_sorted() {
    let left: list<i32> = [1, 2, 2, 2, 5, 7];
    let right: list<i32> = [2, 2, 3, 5, 5];
    let result: list<i32> = intersection_sorted(left, right);
    verify(result.len() == 3);
    verify(result[0] == 2 && result[1] == 2 && result[2] == 5);
    let empty: list<i32> = [];
    let none: list<i32> = intersection_sorted(left, empty);
    verify(none.len() == 0);
}

#[test]
fn test_algorithm_ranges_generic_difference_sorted() {
    let left: list<i32> = [1, 2, 2, 2, 4, 6];
    let right: list<i32> = [2, 3, 6, 6];
    let result: list<i32> = difference_sorted(left, right);
    verify(result.len() == 4);
    verify(result[0] == 1 && result[1] == 2 && result[2] == 2 && result[3] == 4);
    let empty: list<i32> = [];
    let unchanged: list<i32> = difference_sorted(left, empty);
    verify(unchanged.len() == left.len() && unchanged[2] == 2);
}

#[test]
fn test_algorithm_ranges_generic_symmetric_difference_sorted() {
    let left: list<i32> = [1, 2, 2, 2, 5];
    let right: list<i32> = [2, 2, 3, 5, 5];
    let result: list<i32> = symmetric_difference_sorted(left, right);
    verify(result.len() == 4);
    verify(result[0] == 1 && result[1] == 2 && result[2] == 3 && result[3] == 5);
    let empty: list<i32> = [];
    let unchanged: list<i32> = symmetric_difference_sorted(left, empty);
    verify(unchanged.len() == left.len() && unchanged[2] == 2);
}

#[test]
fn test_algorithm_ranges_generic_lower_bound() {
    let values: list<i32> = [1, 3, 3, 7, 9];
    verify(lower_bound(values, 0) == 0);
    verify(lower_bound(values, 3) == 1);
    verify(lower_bound(values, 4) == 3);
    verify(lower_bound(values, 12) == 5);

    let words: list<str8> = ["ant", "bee", "bee", "fox"];
    verify(lower_bound(words, "bee") == 1);
    verify(lower_bound(words, "cat") == 3);
}

#[test]
fn test_algorithm_ranges_generic_upper_bound() {
    let values: list<i32> = [1, 3, 3, 7, 9];
    verify(upper_bound(values, 0) == 0);
    verify(upper_bound(values, 3) == 3);
    verify(upper_bound(values, 4) == 3);
    verify(upper_bound(values, 12) == 5);

    let words: list<str8> = ["ant", "bee", "bee", "fox"];
    verify(upper_bound(words, "bee") == 3);
    verify(upper_bound(words, "cat") == 3);
}

#[test]
fn test_algorithm_ranges_generic_binary_search() {
    let values: list<i32> = [1, 3, 3, 7, 9];
    verify(binary_search(values, 1));
    verify(binary_search(values, 3));
    verify(binary_search(values, 8) == false);

    let words: list<str8> = ["ant", "bee", "fox"];
    verify(binary_search(words, "bee"));
    verify(binary_search(words, "cat") == false);
}

#[test]
fn test_algorithm_ranges_comparator_order_queries() {
    let descending: list<i32> = [9, 7, 7, 3, 1];
    let broken: list<i32> = [9, 7, 8, 3];
    let empty: list<i32> = [];
    let greater = |left: i32, right: i32| { return left > right; };

    verify(is_sorted_by(descending, greater));
    verify(!is_sorted_by(broken, greater));
    verify(is_sorted_until_by(descending, greater) == 5);
    verify(is_sorted_until_by(broken, greater) == 2);
    verify(is_sorted_by(empty, greater));
    verify(is_sorted_until_by(empty, greater) == 0);

    verify(lower_bound_by(descending, 7, greater) == 1);
    verify(upper_bound_by(descending, 7, greater) == 3);
    verify(lower_bound_by(descending, 10, greater) == 0);
    verify(upper_bound_by(descending, 0, greater) == 5);
    verify(binary_search_by(descending, 7, greater));
    verify(!binary_search_by(descending, 8, greater));
    verify(lower_bound_by(empty, 4, greater) == 0);
    verify(upper_bound_by(empty, 4, greater) == 0);
    verify(!binary_search_by(empty, 4, greater));
}

#[test]
fn test_algorithm_ranges_comparator_merged() {
    let left: list<i32> = [9, 7, 7, 3, 1];
    let right: list<i32> = [8, 7, 4, 3, 3];
    let greater = |a: i32, b: i32| { return a > b; };

    let merged_values: list<i32> = merged_by(left, right, greater);
    verify(merged_values.len() == 10);
    verify(merged_values[0] == 9 && merged_values[1] == 8);
    verify(merged_values[2] == 7 && merged_values[3] == 7 &&
           merged_values[4] == 7);
    verify(merged_values[5] == 4 && merged_values[6] == 3);
    verify(merged_values[7] == 3 && merged_values[8] == 3);
    verify(merged_values[9] == 1);
}

#[test]
fn test_algorithm_ranges_comparator_union_sorted() {
    let left: list<i32> = [9, 7, 7, 3, 1];
    let right: list<i32> = [8, 7, 4, 3, 3];
    let greater = |a: i32, b: i32| { return a > b; };
    let union_values: list<i32> = union_sorted_by(left, right, greater);
    verify(union_values.len() == 8);
    verify(union_values[0] == 9 && union_values[1] == 8);
    verify(union_values[2] == 7 && union_values[3] == 7);
    verify(union_values[4] == 4 && union_values[5] == 3);
    verify(union_values[6] == 3 && union_values[7] == 1);
}

#[test]
fn test_algorithm_ranges_comparator_intersection_sorted() {
    let left: list<i32> = [9, 7, 7, 3, 1];
    let right: list<i32> = [8, 7, 4, 3, 3];
    let greater = |a: i32, b: i32| { return a > b; };
    let intersection_values: list<i32> = intersection_sorted_by(left, right, greater);
    verify(intersection_values.len() == 2);
    verify(intersection_values[0] == 7 && intersection_values[1] == 3);
}

#[test]
fn test_algorithm_ranges_comparator_difference_sorted() {
    let left: list<i32> = [9, 7, 7, 3, 1];
    let right: list<i32> = [8, 7, 4, 3, 3];
    let greater = |a: i32, b: i32| { return a > b; };
    let difference_values: list<i32> = difference_sorted_by(left, right, greater);
    verify(difference_values.len() == 3);
    verify(difference_values[0] == 9 && difference_values[1] == 7 &&
           difference_values[2] == 1);
}

#[test]
fn test_algorithm_ranges_comparator_symmetric_difference_sorted() {
    let left: list<i32> = [9, 7, 7, 3, 1];
    let right: list<i32> = [8, 7, 4, 3, 3];
    let greater = |a: i32, b: i32| { return a > b; };
    let symmetric_values: list<i32> = symmetric_difference_sorted_by(left, right, greater);
    verify(symmetric_values.len() == 6);
    verify(symmetric_values[0] == 9 && symmetric_values[1] == 8);
    verify(symmetric_values[2] == 7 && symmetric_values[3] == 4);
    verify(symmetric_values[4] == 3 && symmetric_values[5] == 1);
}

#[test]
fn test_algorithm_ranges_generic_sorted_copy() {
    let values: list<i32> = [5, 1, 3, 1, 9, -2];
    let result: list<i32> = sorted(values);
    verify(result.len() == 6);
    verify(result[0] == -2 && result[1] == 1 && result[2] == 1);
    verify(result[3] == 3 && result[4] == 5 && result[5] == 9);
    verify(values[0] == 5 && values[5] == -2);

    let words: list<str8> = ["fox", "ant", "bee", "ant"];
    let ordered: list<str8> = sorted(words);
    verify(ordered.len() == 4);
    verify(ordered[0] == "ant" && ordered[1] == "ant");
    verify(ordered[2] == "bee" && ordered[3] == "fox");
}

#[test]
fn test_algorithm_ranges_sorted_by_comparator() {
    let values: list<i32> = [2, 5, 1, 5, 9];
    let greater = |a: i32, b: i32| { return a > b; };
    let descending: list<i32> = sorted_by(values, greater);
    verify(descending.len() == 5);
    verify(descending[0] == 9 && descending[1] == 5);
    verify(descending[2] == 5 && descending[3] == 2 && descending[4] == 1);
    verify(values[0] == 2 && values[4] == 9);

    let grouped: list<i32> = [21, 22, 12, 11, 3];
    let by_tens = |a: i32, b: i32| { return a / 10 < b / 10; };
    let stable: list<i32> = sorted_by(grouped, by_tens);
    verify(stable[0] == 3 && stable[1] == 12 && stable[2] == 11);
    verify(stable[3] == 21 && stable[4] == 22);

    let empty: list<i32> = [];
    let empty_sorted: list<i32> = sorted_by(empty, greater);
    verify(empty_sorted.len() == 0);
    let one: list<i32> = [7];
    let one_sorted: list<i32> = sorted_by(one, greater);
    verify(one_sorted[0] == 7);
}

#[test]
fn test_algorithm_ranges_generic_reversed_copy() {
    let values: list<i32> = [1, 2, 3, 4];
    let backwards: list<i32> = reversed(values);
    verify(backwards.len() == 4);
    verify(backwards[0] == 4 && backwards[1] == 3);
    verify(backwards[2] == 2 && backwards[3] == 1);
    verify(values[0] == 1 && values[3] == 4);

    let empty: list<str8> = [];
    let empty_reversed: list<str8> = reversed(empty);
    verify(empty_reversed.len() == 0);
}

#[test]
fn test_algorithm_ranges_generic_rotate_left_copy() {
    let values: list<i32> = [1, 2, 3, 4];
    let left: list<i32> = rotate_left(values, 2);
    verify(left[0] == 3 && left[1] == 4 && left[2] == 1 && left[3] == 2);

    let right: list<i32> = rotate_left(values, -1);
    verify(right[0] == 4 && right[1] == 1 && right[2] == 2 && right[3] == 3);

    let unchanged: list<i32> = rotate_left(values, 8);
    verify(unchanged[0] == 1 && unchanged[3] == 4);
    let empty: list<i32> = [];
    let empty_rotated: list<i32> = rotate_left(empty, 1);
    verify(empty_rotated.len() == 0);
}

#[test]
fn test_algorithm_ranges_generic_chunked() {
    let data: list<i32> = [1, 2, 3, 4, 5];
    let groups: list<list<i32>> = chunked(data, 2);
    verify(groups.len() == 3);
    let first: list<i32> = groups[0];
    let second: list<i32> = groups[1];
    let final: list<i32> = groups[2];
    verify(first.len() == 2 && first[0] == 1 && first[1] == 2);
    verify(second.len() == 2 && second[0] == 3 && second[1] == 4);
    verify(final.len() == 1 && final[0] == 5);
    let invalid_size: list<list<i32>> = chunked(data, 0);
    let large_size: list<list<i32>> = chunked(data, 9);
    verify(invalid_size.len() == 0);
    verify(large_size.len() == 1);
}

#[test]
fn test_algorithm_ranges_generic_windows() {
    let data: list<i32> = [2, 4, 6, 8];
    let result: list<list<i32>> = windows(data, 3);
    verify(result.len() == 2);
    let first: list<i32> = result[0];
    let second: list<i32> = result[1];
    verify(first.len() == 3 && first[0] == 2 && first[2] == 6);
    verify(second.len() == 3 && second[0] == 4 && second[2] == 8);
    let zero: list<list<i32>> = windows(data, 0);
    let too_wide: list<list<i32>> = windows(data, 5);
    verify(zero.len() == 0 && too_wide.len() == 0);
}

#[test]
fn test_algorithm_ranges_generic_strided() {
    let data: list<i32> = [10, 20, 30, 40, 50];
    let result: list<i32> = strided(data, 2);
    verify(result.len() == 3);
    verify(result[0] == 10 && result[1] == 30 && result[2] == 50);
    let invalid: list<i32> = strided(data, 0);
    verify(invalid.len() == 0);
    let words: list<str8> = ["a", "b", "c"];
    let selected: list<str8> = strided(words, 2);
    verify(selected.len() == 2 && selected[0] == "a" && selected[1] == "c");
}

#[test]
fn test_algorithm_ranges_generic_joined() {
    let nested: list<list<i32>> = [[1, 2], [], [3], [4, 5]];
    let flattened: list<i32> = joined(nested);
    verify(flattened.len() == 5);
    verify(flattened[0] == 1 && flattened[1] == 2);
    verify(flattened[2] == 3 && flattened[3] == 4 && flattened[4] == 5);
    let no_lists: list<list<i32>> = [];
    let empty_flattened: list<i32> = joined(no_lists);
    verify(empty_flattened.len() == 0);
}

#[test]
fn test_algorithm_ranges_generic_concat() {
    let left: list<i32> = [1, 2];
    let right: list<i32> = [3, 4, 5];
    let result: list<i32> = concat(left, right);
    verify(result.len() == 5);
    verify(result[0] == 1 && result[1] == 2);
    verify(result[2] == 3 && result[4] == 5);
    let empty: list<i32> = [];
    let one_side: list<i32> = concat(empty, right);
    verify(one_side.len() == 3 && one_side[0] == 3);
}

#[test]
fn test_algorithm_ranges_zip() {
    let numbers: list<i32> = [4, 5, 6];
    let words: list<str8> = ["four", "five"];
    let pairs: list<tuple<i32, str8>> = zip(numbers, words);
    verify(pairs.len() == 2);

    let first: tuple<i32, str8> = pairs[0];
    let second: tuple<i32, str8> = pairs[1];
    verify(first.0 == 4);
    verify(second.0 == 5);
    verify(numbers.len() == 3 && words.len() == 2);

    let offsets: list<i32> = [40, 50];
    let numeric_pairs: list<tuple<i32, i32>> = zip(numbers, offsets);
    let numeric_pair = numeric_pairs[1];
    verify(numeric_pair.0 == 5 && numeric_pair.1 == 50);

    let empty: list<i32> = [];
    let no_pairs: list<tuple<i32, str8>> = zip(empty, words);
    verify(no_pairs.len() == 0);
}

#[test]
fn test_algorithm_ranges_generic_replace() {
    let values: list<i32> = [1, 2, 2, 3, 2];
    let updated: list<i32> = replace(values, 2, 9);
    verify(updated.len() == 5);
    verify(updated[0] == 1 && updated[1] == 9 && updated[2] == 9);
    verify(updated[3] == 3 && updated[4] == 9);
    verify(values[1] == 2 && values[4] == 2);
    let words: list<str8> = ["red", "blue", "red"];
    let renamed: list<str8> = replace(words, "red", "green");
    verify(renamed[0] == "green" && renamed[1] == "blue");
}


#[test]
fn test_algorithm_ranges_predicate_queries() {
    let flags: list<bool> = [true, true, false];
    let all_flags: bool = all_of(flags);
    let any_flags: bool = any_of(flags);
    let no_flags: bool = none_of(flags);
    let empty: list<bool> = [];
    let empty_all: bool = all_of(empty);
    let empty_any: bool = any_of(empty);
    let empty_none: bool = none_of(empty);
    verify(!all_flags && any_flags && !no_flags);
    verify(empty_all && !empty_any && empty_none);
}

#[test]
fn test_algorithm_ranges_generic_element_extrema() {
    let values: list<i32> = [8, -3, 11, 11, 4];
    let empty: list<i32> = [];
    verify(min_element_index(values) == 1);
    verify(max_element_index(values) == 2);
    verify(min_element_index(empty) == -1);
    verify(max_element_index(empty) == -1);
}

#[test]
fn test_algorithm_ranges_generic_element_values() {
    let values: list<i32> = [8, -3, 11, 11, 4];
    verify(min_element_value(values) == -3);
    verify(max_element_value(values) == 11);
    let words: list<str8> = ["pear", "apple", "plum"];
    verify(min_element_value(words) == "apple");
    verify(max_element_value(words) == "plum");
}

#[test]
fn test_algorithm_ranges_comparator_element_extrema() {
    let values: list<i32> = [22, 11, 21, 12, 3];
    let empty: list<i32> = [];
    let by_tens = |a: i32, b: i32| { return a / 10 < b / 10; };
    verify(min_element_index_by(values, by_tens) == 4);
    verify(max_element_index_by(values, by_tens) == 0);
    verify(min_element_value_by(values, by_tens) == 3);
    verify(max_element_value_by(values, by_tens) == 22);
    verify(min_element_index_by(empty, by_tens) == -1);
    verify(max_element_index_by(empty, by_tens) == -1);

    let tied: list<i32> = [12, 11, 19];
    verify(min_element_index_by(tied, by_tens) == 0);
    verify(max_element_index_by(tied, by_tens) == 0);
    verify(min_element_value_by(tied, by_tens) == 12);
    verify(max_element_value_by(tied, by_tens) == 12);

    let descending = |a: i32, b: i32| { return a > b; };
    verify(min_element_index_by(values, descending) == 0);
    verify(max_element_index_by(values, descending) == 4);
}

#[test]
fn test_algorithm_ranges_generic_sequence_transforms() {
    let data: list<i32> = [5, 6, 6, 7, 8, 6];
    let removed: list<i32> = remove(data, 6);
    verify(removed.len() == 3);
    verify(removed[0] == 5 && removed[1] == 7 && removed[2] == 8);

    let prefix: list<i32> = take(data, 3);
    verify(prefix.len() == 3 && prefix[0] == 5 && prefix[2] == 6);
    let suffix: list<i32> = drop(data, 4);
    verify(suffix.len() == 2 && suffix[0] == 8 && suffix[1] == 6);
    let none_taken: list<i32> = take(data, -2);
    let all_dropped: list<i32> = drop(data, 99);
    verify(none_taken.len() == 0 && all_dropped.len() == 0);
}

#[test]
fn test_algorithm_ranges_iota() {
    let values: list<i64> = iota(-2, 3);
    verify(values.len() == 5);
    verify(values[0] == -2 && values[1] == -1 && values[2] == 0);
    verify(values[3] == 1 && values[4] == 2);

    let empty: list<i64> = iota(4, 4);
    let reversed: list<i64> = iota(5, 1);
    verify(empty.len() == 0 && reversed.len() == 0);
}

#[test]
fn test_algorithm_ranges_generic_unique_transforms() {
    let repeats: list<i32> = [1, 1, 2, 2, 3, 1, 1, 4];
    let adjacent: list<i32> = unique(repeats);
    verify(adjacent.len() == 5);
    verify(adjacent[0] == 1 && adjacent[1] == 2 && adjacent[2] == 3);
    verify(adjacent[3] == 1 && adjacent[4] == 4);
    let stable: list<i32> = unique_stable(repeats);
    verify(stable.len() == 4);
    verify(stable[0] == 1 && stable[1] == 2 && stable[2] == 3 && stable[3] == 4);
}

#[test]
fn test_algorithm_ranges_generic_clamp_transform() {
    let low: i32 = 0;
    let high: i32 = 10;
    let values: list<i32> = [-5, 0, 3, 15];
    let limited: list<i32> = clamp(values, low, high);
    verify(limited.len() == 4);
    verify(limited[0] == 0 && limited[1] == 0 && limited[2] == 3 && limited[3] == 10);
}

#[test]
fn test_algorithm_ranges_generic_string_transforms() {
    let words: list<str8> = ["pear", "mango", "pear"];
    let distinct_words: list<str8> = unique_stable(words);
    verify(distinct_words.len() == 2);
    verify(distinct_words[0] == "pear" && distinct_words[1] == "mango");
}

#[test]
fn test_algorithm_ranges_generic_string_remove() {
    let words: list<str8> = ["pear", "mango", "pear"];
    let no_mango: list<str8> = remove(words, "mango");
    verify(no_mango.len() == 2 && no_mango[0] == "pear" && no_mango[1] == "pear");
}

#[test]
fn test_algorithm_ranges_find_count_contains_remove_take_drop() {
    let data: list<i64> = [5, 6, 6, 7, 8, 6];
    verify(find_i64(data, 6) == 1);
    verify(find_i64(data, 42) == -1);
    verify(count_i64(data, 6) == 3);
    verify(contains_i64(data, 8) == 1);
    verify(contains_i64(data, 9) == 0);

    let removed: list<i64> = remove_i64(data, 6);
    verify(removed.len() == 3);
    verify(removed[0] == 5 && removed[1] == 7 && removed[2] == 8);

    let take3: list<i64> = take_i64(data, 3);
    verify(take3.len() == 3 && take3[0] == 5 && take3[1] == 6 && take3[2] == 6);

    let drop4: list<i64> = drop_i64(data, 4);
    verify(drop4.len() == 2 && drop4[0] == 8 && drop4[1] == 6);
}

#[test]
fn test_algorithm_ranges_clamp() {
    let data: list<i64> = [-5, 0, 3, 10, 15, 100];
    let clamped: list<i64> = clamp_i64(data, 0, 10);
    verify(clamped.len() == 6);
    verify(clamped[0] == 0);
    verify(clamped[1] == 0);
    verify(clamped[2] == 3);
    verify(clamped[3] == 10);
    verify(clamped[4] == 10);
    verify(clamped[5] == 10);

    let empty: list<i64> = [];
    let ce: list<i64> = clamp_i64(empty, 0, 5);
    verify(ce.len() == 0);

    let single: list<i64> = [42];
    let cs: list<i64> = clamp_i64(single, 50, 100);
    verify(cs.len() == 1 && cs[0] == 50);
}

#[test]
fn test_algorithm_ranges_clamp_by_comparator() {
    let values: list<i32> = [4, 11, 35, 22];
    let low: i32 = 30;
    let high: i32 = 10;
    let greater = |a: i32, b: i32| { return a > b; };
    let bounded: list<i32> = clamp_by(values, low, high, greater);
    verify(bounded.len() == 4);
    verify(bounded[0] == 10 && bounded[1] == 11);
    verify(bounded[2] == 30 && bounded[3] == 22);
    verify(values[0] == 4 && values[2] == 35);

    let empty: list<i32> = [];
    let no_values: list<i32> = clamp_by(empty, low, high, greater);
    verify(no_values.len() == 0);
}

#[test]
fn test_algorithm_numeric_accumulate_and_inner_product() {
    let a: list<i64> = [1, 2, 3, 4];
    let b: list<i64> = [10, 20, 30];
    verify(accumulate_i64(a, 0) == 10);
    verify(accumulate_i64(a, 5) == 15);
    verify(inner_product_i64(a, b, 7) == (7 + 10 + 40 + 90));
}

#[test]
fn test_algorithm_numeric_generic_accumulate() {
    let values: list<i32> = [2, 3, 5];
    let initial: i64 = 10;
    let sum: i64 = accumulate(values, initial);
    verify(sum == 20);
    let zero_initial: i64 = 0;
    verify(accumulate(values, zero_initial) == 10);
}

#[test]
fn test_algorithm_numeric_folds() {
    let values: list<i32> = [1, 2, 3];
    let encode_left = |acc: i32, value: i32| { return acc * 10 + value; };
    let encode_right = |value: i32, acc: i32| { return value + acc * 10; };
    verify(fold_left(values, 4, encode_left) == 4123);
    verify(fold_right(values, 4, encode_right) == 4321);

    let empty: list<i32> = [];
    verify(fold_left(empty, 17, encode_left) == 17);
    verify(fold_right(empty, 23, encode_right) == 23);

    let subtract = |acc: i32, value: i32| { return acc - value; };
    verify(fold_left(values, 20, subtract) == 14);
}

#[test]
fn test_algorithm_numeric_transform_reduce() {
    let values: list<i32> = [1, 2, 3];
    let add = |acc: i32, value: i32| { return acc + value; };
    let square = |value: i32| { return value * value; };
    verify(transform_reduce(values, 0, add, square) == 14);

    let left: list<i32> = [1, 2, 3];
    let right: list<i32> = [4, 5];
    let multiply = |a: i32, b: i32| { return a * b; };
    verify(transform_reduce(left, right, 7, add, multiply) == 21);

    let empty: list<i32> = [];
    verify(transform_reduce(empty, 9, add, square) == 9);
    verify(transform_reduce(left, empty, 13, add, multiply) == 13);
}

#[test]
fn test_algorithm_numeric_scans() {
    let values: list<i32> = [1, 2, 3, 4];
    let add = |acc: i32, value: i32| { return acc + value; };
    let inclusive: list<i32> = inclusive_scan(values, add);
    verify(inclusive.len() == 4);
    verify(inclusive[0] == 1 && inclusive[1] == 3);
    verify(inclusive[2] == 6 && inclusive[3] == 10);

    let initial: i32 = 10;
    let exclusive: list<i32> = exclusive_scan(values, initial, add);
    verify(exclusive.len() == 4);
    verify(exclusive[0] == 10 && exclusive[1] == 11);
    verify(exclusive[2] == 13 && exclusive[3] == 16);

    let subtract = |acc: i32, value: i32| { return acc - value; };
    let ordered_input: list<i32> = [20, 3, 2];
    let ordered: list<i32> = inclusive_scan(ordered_input, subtract);
    verify(ordered[0] == 20 && ordered[1] == 17 && ordered[2] == 15);

    let empty: list<i32> = [];
    let empty_initial: i32 = 7;
    let empty_inclusive: list<i32> = inclusive_scan(empty, add);
    let empty_exclusive: list<i32> = exclusive_scan(empty, empty_initial, add);
    verify(empty_inclusive.len() == 0 && empty_exclusive.len() == 0);
    let one: list<i32> = [8];
    let one_inclusive: list<i32> = inclusive_scan(one, add);
    let one_exclusive: list<i32> = exclusive_scan(one, empty_initial, add);
    verify(one_inclusive[0] == 8 && one_exclusive[0] == 7);
}

#[test]
fn test_algorithm_numeric_generic_inner_product() {
    let left: list<i32> = [1, 2, 3, 4];
    let right: list<i32> = [10, 20, 30];
    let initial: i64 = 7;
    verify(inner_product(left, right, initial) == 147);

    let empty: list<i32> = [];
    verify(inner_product(left, empty, initial) == initial);
}

#[test]
fn test_algorithm_numeric_partial_sum_and_adjacent_difference() {
    let data: list<i64> = [2, 3, 5];
    let ps: list<i64> = partial_sum_i64(data, 10);
    verify(ps.len() == 3);
    verify(ps[0] == 12);
    verify(ps[1] == 15);
    verify(ps[2] == 20);

    let ad: list<i64> = adjacent_difference_i64(ps, 10);
    verify(ad.len() == 3);
    verify(ad[0] == 2);
    verify(ad[1] == 3);
    verify(ad[2] == 5);
}

#[test]
fn test_algorithm_numeric_generic_partial_sum_and_adjacent_difference() {
    let data: list<i32> = [2, 3, 5];
    let init: i32 = 10;
    let prefix: list<i32> = partial_sum(data, init);
    verify(prefix.len() == 3);
    verify(prefix[0] == 12 && prefix[1] == 15 && prefix[2] == 20);

    let differences: list<i32> = adjacent_difference(prefix, init);
    verify(differences.len() == 3);
    verify(differences[0] == 2 && differences[1] == 3 && differences[2] == 5);

    let empty: list<i32> = [];
    let empty_prefix: list<i32> = partial_sum(empty, init);
    let empty_diff: list<i32> = adjacent_difference(empty, init);
    verify(empty_prefix.len() == 0 && empty_diff.len() == 0);
}

#[test]
fn test_algorithm_rand_namespace_reproducible() {
    seed(123);
    let a: u64 = next_u64();
    seed(123);
    let b: u64 = next_u64();
    verify(a == b);
    for _i in 0..200 {
        let v: i64 = range_i64(10, 20);
        verify(v >= 10 && v <= 20);
    }
}

#[test]
fn test_algorithm_regex_namespace_basic() {
    let rr: result<Regex, str8> = Regex::compile("([A-Za-z]+)-([0-9]+)");
    verify(rr.is_err() == false);
    let re: Regex = rr.unwrap();
    let text: str8 = "user-42";
    let s: i64 = re.find_start(text);
    let e: i64 = re.find_end(text);
    verify(s == 0 && e == 7);
    let m: str8 = sub(text, s, e - s);
    let ok: i32 = eq(m, "user-42");
    free(m);
    re.close();
    verify(ok == 1);
}

#[test]
fn test_algorithm_genetic_random_genome_reproducible() {
    seed(123456);
    let g1: list<i64> = random_genome_i64(8, -3, 3);
    seed(123456);
    let g2: list<i64> = random_genome_i64(8, -3, 3);
    verify(g1.len() == 8);
    verify(g2.len() == 8);
    for i in 0..8 {
        verify(g1[i] == g2[i]);
        verify(g1[i] >= -3 && g1[i] <= 3);
    }
}

#[test]
fn test_algorithm_genetic_crossover_and_mutation_edges() {
    let a: list<i64> = [1, 2, 3, 4];
    let b: list<i64> = [9, 8, 7, 6];
    let c0: list<i64> = crossover_one_point_i64(a, b, 0);
    let c2: list<i64> = crossover_one_point_i64(a, b, 2);
    let c9: list<i64> = crossover_one_point_i64(a, b, 9);
    verify(c0[0] == 9 && c0[1] == 8 && c0[2] == 7 && c0[3] == 6);
    verify(c2[0] == 1 && c2[1] == 2 && c2[2] == 7 && c2[3] == 6);
    verify(c9[0] == 1 && c9[1] == 2 && c9[2] == 3 && c9[3] == 4);

    seed(99);
    let m0: list<i64> = mutate_genome_i64(a, 0, 0, 10);
    let an: i64 = a.len();
    for i in 0..an {
        verify(m0[i] == a[i]);
    }
    seed(99);
    let m1: list<i64> = mutate_genome_i64(a, 1000, 0, 10);
    verify(m1.len() == a.len());
    let m1n: i64 = m1.len();
    for i in 0..m1n {
        verify(m1[i] >= 0 && m1[i] <= 10);
    }
}

#[test]
fn test_algorithm_genetic_selection() {
    let fit: list<i64> = [10, 30, 20, 5];
    verify(argmax_i64(fit) == 1);

    seed(7);
    for _i in 0..64 {
        let idx: i64 = tournament_select_index_i64(fit, 3);
        verify(idx >= 0 && idx < fit.len());
    }
}

#[test]
fn test_algorithm_genetic_population_access_helpers() {
    let population: list<i64> = [
        1, 2, 3,
        4, 5, 6,
        7, 8, 9
    ];

    let genome: list<i64> = genome_at_i64(population, 3, 1);
    verify(genome.len() == 3);
    verify(genome[0] == 4 && genome[1] == 5 && genome[2] == 6);
    let missing_genome: list<i64> = genome_at_i64(population, 3, 3);
    verify(missing_genome.len() == 0);

    let replacement: list<i64> = [10, 11, 12];
    let replaced: list<i64> = replace_genome_i64(population, 3, 1, replacement);
    verify(replaced.len() == 9);
    verify(replaced[0] == 1 && replaced[1] == 2 && replaced[2] == 3);
    verify(replaced[3] == 10 && replaced[4] == 11 && replaced[5] == 12);
    verify(replaced[6] == 7 && replaced[7] == 8 && replaced[8] == 9);

    let bad_replacement: list<i64> = [1, 2];
    let rejected_replacement: list<i64> = replace_genome_i64(population, 3, 1, bad_replacement);
    verify(rejected_replacement.len() == 0);
}

#[test]
fn test_algorithm_genetic_population_reproduction() {
    seed(4242);
    let pop_size: i64 = 6;
    let gene_count: i64 = 5;
    let pop: list<i64> = random_population_i64(pop_size, gene_count, 0, 9);
    verify(pop.len() == pop_size * gene_count);
    for i in 0..6 {
        for j in 0..5 {
            let idx: i64 = i * gene_count + j;
            verify(pop[idx] >= 0 && pop[idx] <= 9);
        }
    }

    let fit: list<i64> = [10, 30, 20, 5, 1, 12];
    let next: list<i64> =
        reproduce_next_population_i64(pop, pop_size, gene_count, fit, 150, 0, 9, 3);
    verify(next.len() == pop_size * gene_count);
    for i in 0..6 {
        for j in 0..5 {
            let idx: i64 = i * gene_count + j;
            verify(next[idx] >= 0 && next[idx] <= 9);
        }
    }
}

#[test]
fn test_algorithm_ranges_predicate_algorithms() {
    let values: list<i32> = [-4, -1, 0, 2, 5, 8];
    let is_even = |value: i32| {
        return value % 2 == 0;
    };
    let less_than_ten = |value: i32| { return value < 10; };
    let is_five = |value: i32| { return value == 5; };
    let above_ten = |value: i32| { return value > 10; };

    verify(find_if(values, is_even) == 0);
    verify(count_if(values, is_even) == 4);
    verify(all_of(values, less_than_ten));
    verify(any_of(values, is_five));
    verify(none_of(values, above_ten));

    let threshold: i32 = 3;
    let above_threshold = |value: i32| {
        return value > threshold;
    };
    let selected: list<i32> = filter(values, above_threshold);
    verify(selected.len() == 2);
    verify(selected[0] == 5 && selected[1] == 8);
    verify(values.len() == 6);

    let no_values: list<i32> = [];
    verify(find_if(no_values, is_even) == -1);
    verify(count_if(no_values, is_even) == 0);
    let no_selected: list<i32> = filter(no_values, is_even);
    verify(no_selected.len() == 0);
    verify(all_of(no_values, is_even));
    verify(!any_of(no_values, is_even));
    verify(none_of(no_values, is_even));
}


#[test]
fn test_algorithm_ranges_partition_algorithms() {
    let values: list<i32> = [1, 3, 5, 2, 4, 6];
    let is_odd = |value: i32| { return value % 2 == 1; };
    let is_even = |value: i32| { return value % 2 == 0; };
    verify(is_partitioned(values, is_odd));
    verify(!is_partitioned(values, is_even));
    verify(partition_point(values, is_odd) == 3);

    let rearranged: list<i32> = stable_partition(values, is_odd);
    verify(rearranged.len() == 6);
    verify(rearranged[0] == 1 && rearranged[1] == 3 && rearranged[2] == 5);
    verify(rearranged[3] == 2 && rearranged[4] == 4 && rearranged[5] == 6);
    verify(values[0] == 1 && values[1] == 3 && values[2] == 5);

    let no_values: list<i32> = [];
    verify(is_partitioned(no_values, is_odd));
    verify(partition_point(no_values, is_odd) == 0);
    let empty_partition: list<i32> = stable_partition(no_values, is_odd);
    verify(empty_partition.len() == 0);

    let all_match: list<i32> = [1, 3, 5];
    verify(partition_point(all_match, is_odd) == all_match.len());
    let none_match: list<i32> = [2, 4, 6];
    verify(partition_point(none_match, is_odd) == 0);
}

#[test]
fn test_algorithm_ranges_predicate_removal_and_unique() {
    let values: list<i32> = [-3, -1, 0, 2, 4];
    let is_nonnegative = |value: i32| { return value >= 0; };
    let is_negative = |value: i32| { return value < 0; };
    verify(find_if_not(values, is_nonnegative) == 0);
    verify(find_if_not(values, is_negative) == 2);

    let kept: list<i32> = remove_if(values, is_negative);
    verify(kept.len() == 3);
    verify(kept[0] == 0 && kept[1] == 2 && kept[2] == 4);
    let replacement: i32 = 9;
    let replaced: list<i32> = replace_if(values, is_negative, replacement);
    verify(replaced.len() == 5);
    verify(replaced[0] == 9 && replaced[1] == 9 && replaced[2] == 0);
    verify(values[0] == -3 && values[1] == -1);

    let runs: list<i32> = [11, 21, 22, 32, 33, 43];
    let same_last_digit = |left: i32, right: i32| {
        return left % 10 == right % 10;
    };
    let compacted: list<i32> = unique_by(runs, same_last_digit);
    verify(compacted.len() == 3);
    verify(compacted[0] == 11 && compacted[1] == 22 && compacted[2] == 33);

    let empty: list<i32> = [];
    let empty_kept: list<i32> = remove_if(empty, is_negative);
    let empty_replaced: list<i32> =
        replace_if(empty, is_negative, replacement);
    let empty_unique: list<i32> = unique_by(empty, same_last_digit);
    verify(find_if_not(empty, is_nonnegative) == -1);
    verify(empty_kept.len() == 0 && empty_replaced.len() == 0);
    verify(empty_unique.len() == 0);
}
