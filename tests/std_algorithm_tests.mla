#[test]
fn test_algorithm_ranges_search_n_by_equivalence() {
    let by_tens = |left: i32, right: i32| { return left / 10 == right / 10; };
    let grouped: list<i32> = [11, 12, 21, 22, 23];
    let key_nineteen: i32 = 19;
    let key_twenty_nine: i32 = 29;
    verify(search_n_by(grouped, 2, key_nineteen, by_tens) == 0);
    verify(search_n_by(grouped, 3, key_twenty_nine, by_tens) == 2);
    verify(search_n_by(grouped, 4, key_twenty_nine, by_tens) == -1);
}

