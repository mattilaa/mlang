#[test]
fn test_algorithm_ranges_clamp_by_projected() {
    let values: list<i32> = [11, 20, 29, 40, 51];
    let low: i32 = 40;
    let high: i32 = 20;
    let greater = |a: i32, b: i32| { return a > b; };
    let project_tens = |value: i32| { return value / 10; };
    let bounded: list<i32> = clamp_by_projected(
        values, low, high, greater, project_tens);
    verify(bounded.len() == 5 && bounded[0] == 20 &&
           bounded[1] == 20 && bounded[2] == 29 &&
           bounded[3] == 40 && bounded[4] == 40);
    verify(values[0] == 11 && values[4] == 51);

    let empty: list<i32> = [];
    let empty_bounded: list<i32> = clamp_by_projected(
        empty, low, high, greater, project_tens);
    verify(empty_bounded.len() == 0);
}

#[test]
fn test_algorithm_numeric_accumulate_and_inner_product() {
    let a: list<i64> = [1, 2, 3, 4];
    let b: list<i64> = [10, 20, 30];
    verify(accumulate_i64(a, 0) == 10);
    verify(accumulate_i64(a, 5) == 15);
    verify(inner_product_i64(a, b, 7) == (7 + 10 + 40 + 90));
}

#[test]
fn test_cpp20_integral_midpoint() {
    verify_eq(5, midpoint_i64(4, 6));
    verify_eq(4, midpoint_i64(5, 2));
    verify_eq(3, midpoint_i64(2, 5));
    verify_eq(-3, midpoint_i64(-3, -2));
    verify_eq(-2, midpoint_i64(-2, -3));

    let minimum: i64 = 0 - 9223372036854775807 - 1;
    let maximum: i64 = 9223372036854775807;
    verify_eq(-1, midpoint_i64(minimum, maximum));
    verify_eq(0, midpoint_i64(maximum, minimum));
    verify_eq(minimum, midpoint_i64(minimum, minimum));
    verify_eq(maximum, midpoint_i64(maximum, maximum));

    let unsigned_maximum: u64 = numeric_limits<u64>::max();
    verify_eq(3, narrow_cast<i64>(midpoint_u64(2, 5)));
    verify_eq(4, narrow_cast<i64>(midpoint_u64(5, 2)));
    verify_eq(9223372036854775807, narrow_cast<i64>(midpoint_u64(0, unsigned_maximum)));
    verify_eq(0 - 9223372036854775807 - 1,
             narrow_cast<i64>(midpoint_u64(unsigned_maximum, 0)));
    verify_eq(-1, narrow_cast<i64>(midpoint_u64(unsigned_maximum, unsigned_maximum)));
}

#[test]
fn test_cpp20_floating_midpoint() {
    verify(midpoint_f32(4.0f, 6.0f) == 5.0f);
    verify(midpoint_f32(-4.0f, 6.0f) == 1.0f);
    verify(midpoint_f32(6.0f, 4.0f) == 5.0f);
    verify(midpoint_f32(300000000000000000000000000000000000000.0f,
                        300000000000000000000000000000000000000.0f) ==
           300000000000000000000000000000000000000.0f);
    verify(midpoint_f32(300000000000000000000000000000000000000.0f,
                        200000000000000000000000000000000000000.0f) >
           200000000000000000000000000000000000000.0f);

    verify(midpoint_f64(4.0, 6.0) == 5.0);
    verify(midpoint_f64(-4.0, 6.0) == 1.0);
    verify(midpoint_f64(6.0, 4.0) == 5.0);
    verify(midpoint_f64(10000000000000000000.0,
                        10000000000000000000.0) == 10000000000000000000.0);
}

#[test]
fn test_cpp20_narrow_integer_midpoint() {
    verify(midpoint_i8(-128, 127) == -1);
    verify(midpoint_i8(127, -128) == 0);
    verify(midpoint_i16(-32768, 32767) == -1);
    verify(midpoint_i16(32767, -32768) == 0);
    verify(midpoint_i32(-2147483648, 2147483647) == -1);
    verify(midpoint_i32(2147483647, -2147483648) == 0);

    verify(midpoint_u8(0, 255) == 127);
    verify(midpoint_u8(255, 0) == 128);
    verify(midpoint_u16(0, 65535) == 32767);
    verify(midpoint_u16(65535, 0) == 32768);
    verify(midpoint_u32(0, 4294967295) == 2147483647);
    verify(midpoint_u32(4294967295, 0) == 2147483648);
}


#[test]
fn test_algorithm_numeric_generic_accumulate() {
    let values: list<i32> = [2, 3, 5];
    let initial: i64 = 10;
    let sum: i64 = accumulate(values, initial);
    verify(sum == 20);
    let zero_initial: i64 = 0;
    verify(accumulate(values, zero_initial) == 10);

    let subtract = |acc: i64, value: i32| { return acc - value; };
    let initial_difference: i64 = 20;
    verify(accumulate_by(values, initial_difference, subtract) == 10);
    verify(accumulate(values, initial_difference, subtract) == 10);
    let empty: list<i32> = [];
    verify(accumulate_by(empty, initial_difference, subtract) == 20);
    verify(accumulate(empty, initial_difference, subtract) == 20);

    verify(reduce(values, initial) == 20);
    let multiply = |acc: i64, value: i32| { return acc * value; };
    let reduce_initial: i64 = 1;
    verify(reduce(values, reduce_initial, multiply) == 30);
    verify(reduce(empty, reduce_initial, multiply) == 1);
}

#[test]
fn test_algorithm_numeric_folds() {
    let values: list<i32> = [1, 2, 3];
    let encode_left = |acc: i32, value: i32| { return acc * 10 + value; };
    let encode_right = |value: i32, acc: i32| { return value + acc * 10; };
    verify(fold_left(values, 4, encode_left) == 4123);
    verify(fold_right(values, 4, encode_right) == 4321);

    let empty: list<i32> = [];
    verify(fold_left(empty, 17, encode_left) == 17);
    verify(fold_right(empty, 23, encode_right) == 23);

    let subtract = |acc: i32, value: i32| { return acc - value; };
    verify(fold_left(values, 20, subtract) == 14);
}

#[test]
fn test_algorithm_numeric_folds_without_initial_value() {
    let values: list<i32> = [1, 2, 3];
    let encode_left = |acc: i32, value: i32| { return acc * 10 + value; };
    let encode_right = |value: i32, acc: i32| { return value + acc * 10; };
    let left: option<i32> = fold_left_first(values, encode_left);
    let right: option<i32> = fold_right_last(values, encode_right);
    let left_value: i32 = match left {
        Some(value) => value,
        None => 0
    };
    let right_value: i32 = match right {
        Some(value) => value,
        None => 0
    };
    verify(left_value == 123 && right_value == 321);

    let empty: list<i32> = [];
    let empty_left: option<i32> = fold_left_first(empty, encode_left);
    let empty_right: option<i32> = fold_right_last(empty, encode_right);
    verify(empty_left.is_none() && empty_right.is_none());
}

#[test]
fn test_algorithm_ranges_folds() {
    let values: list<i32> = [1, 2, 3];
    let encode_left = |acc: i32, value: i32| { return acc * 10 + value; };
    let encode_right = |value: i32, acc: i32| { return value + acc * 10; };
    verify(ranges_fold_left(values, 4, encode_left) == 4123);
    verify(ranges_fold_right(values, 4, encode_right) == 4321);
    let with_iter: tuple<i64, i32> = ranges_fold_left_with_iter(values, 4, encode_left);
    verify(with_iter.0 == 3 && with_iter.1 == 4123);
    let right_with_iter: tuple<i64, i32> =
        ranges_fold_right_with_iter(values, 4, encode_right);
    verify(right_with_iter.0 == 3 && right_with_iter.1 == 4321);

    let add_to_i64 = |acc: i64, value: i32| { return acc + value; };
    let heterogeneous: i64 = ranges_fold_left(values, 10, add_to_i64);
    verify(heterogeneous == 16);

    let left: option<i32> = ranges_fold_left_first(values, encode_left);
    let right: option<i32> = ranges_fold_right_last(values, encode_right);
    let left_with_iter: option<tuple<i64, i32>> =
        ranges_fold_left_first_with_iter(values, encode_left);
    verify(left_with_iter.is_some());
    let left_result: tuple<i64, i32> = left_with_iter.unwrap();
    verify(left_result.0 == 3 && left_result.1 == 123);
    let encode_wide = |acc: i64, value: i32| { return acc * 10 + value; };
    let wide_with_iter: option<tuple<i64, i64>> =
        ranges_fold_left_first_with_iter(values, encode_wide);
    verify(wide_with_iter.is_some());
    let wide_result: tuple<i64, i64> = wide_with_iter.unwrap();
    verify(wide_result.0 == 3 && wide_result.1 == 123);
    let left_value: i32 = match left { Some(value) => value, None => 0 };
    let right_value: i32 = match right { Some(value) => value, None => 0 };
    verify(left_value == 123 && right_value == 321);

    let empty: list<i32> = [];
    verify(ranges_fold_left(empty, 17, encode_left) == 17);
    verify(ranges_fold_right(empty, 23, encode_right) == 23);
    let empty_with_iter: tuple<i64, i32> = ranges_fold_left_with_iter(empty, 29, encode_left);
    verify(empty_with_iter.0 == 0 && empty_with_iter.1 == 29);
    let empty_right_with_iter: tuple<i64, i32> =
        ranges_fold_right_with_iter(empty, 31, encode_right);
    verify(empty_right_with_iter.0 == 0 && empty_right_with_iter.1 == 31);
    verify(ranges_fold_left_first(empty, encode_left).is_none());
    verify(ranges_fold_left_first_with_iter(empty, encode_left).is_none());
    verify(ranges_fold_right_last(empty, encode_right).is_none());

    let singleton: list<i32> = [7];
    let singleton_result: option<tuple<i64, i32>> =
        ranges_fold_left_first_with_iter(singleton, encode_left);
    verify(singleton_result.is_some());
    let singleton_fold: tuple<i64, i32> = singleton_result.unwrap();
    verify(singleton_fold.0 == 1 && singleton_fold.1 == 7);
}

#[test]
fn test_algorithm_numeric_transform_reduce() {
    let values: list<i32> = [1, 2, 3];
    let add = |acc: i32, value: i32| { return acc + value; };
    let square = |value: i32| { return value * value; };
    verify(transform_reduce(values, 0, add, square) == 14);

    let left: list<i32> = [1, 2, 3];
    let right: list<i32> = [4, 5];
    let multiply = |a: i32, b: i32| { return a * b; };
    verify(transform_reduce(left, right, 7, add, multiply) == 21);

    let empty: list<i32> = [];
    verify(transform_reduce(empty, 9, add, square) == 9);
    verify(transform_reduce(left, empty, 13, add, multiply) == 13);
}

#[test]
fn test_algorithm_numeric_scans() {
    let values: list<i32> = [1, 2, 3, 4];
    let add = |acc: i32, value: i32| { return acc + value; };
    let inclusive: list<i32> = inclusive_scan(values, add);
    verify(inclusive.len() == 4);
    verify(inclusive[0] == 1 && inclusive[1] == 3);
    verify(inclusive[2] == 6 && inclusive[3] == 10);

    let add_wide = |acc: f64, value: i32| { return acc + f64(value); };
    let seeded: list<f64> = inclusive_scan(values, 0.5, add_wide);
    verify(seeded.len() == 4);
    verify(seeded[0] == 1.5 && seeded[1] == 3.5);
    verify(seeded[2] == 6.5 && seeded[3] == 10.5);

    let initial: i32 = 10;
    let exclusive: list<i32> = exclusive_scan(values, initial, add);
    verify(exclusive.len() == 4);
    verify(exclusive[0] == 10 && exclusive[1] == 11);
    verify(exclusive[2] == 13 && exclusive[3] == 16);

    let subtract = |acc: i32, value: i32| { return acc - value; };
    let ordered_input: list<i32> = [20, 3, 2];
    let ordered: list<i32> = inclusive_scan(ordered_input, subtract);
    verify(ordered[0] == 20 && ordered[1] == 17 && ordered[2] == 15);

    let empty: list<i32> = [];
    let empty_initial: i32 = 7;
    let empty_inclusive: list<i32> = inclusive_scan(empty, add);
    let empty_seeded: list<f64> = inclusive_scan(empty, 0.5, add_wide);
    let empty_exclusive: list<i32> = exclusive_scan(empty, empty_initial, add);
    verify(empty_inclusive.len() == 0 && empty_seeded.len() == 0 &&
           empty_exclusive.len() == 0);
    let one: list<i32> = [8];
    let one_inclusive: list<i32> = inclusive_scan(one, add);
    let one_exclusive: list<i32> = exclusive_scan(one, empty_initial, add);
    verify(one_inclusive[0] == 8 && one_exclusive[0] == 7);

    let add_wide = |acc: f64, value: i32| { return acc + f64(value); };
    let wide_initial: f64 = 0.5;
    let wide_exclusive: list<f64> = exclusive_scan(values, wide_initial, add_wide);
    verify(wide_exclusive.len() == 4);
    verify(wide_exclusive[0] == 0.5 && wide_exclusive[1] == 1.5);
    verify(wide_exclusive[2] == 3.5 && wide_exclusive[3] == 6.5);
}

#[test]
fn test_algorithm_numeric_transform_scans() {
    let values: list<i32> = [2, 4, 6];
    let project = |value: i32| { return f64(value) / 2.0; };
    let add = |acc: f64, value: f64| { return acc + value; };

    let inclusive: list<f64> = transform_inclusive_scan(values, add, project);
    verify(inclusive.len() == 3);
    verify(inclusive[0] == 1.0 && inclusive[1] == 3.0 && inclusive[2] == 6.0);

    let seeded: list<f64> = transform_inclusive_scan(values, 0.5, add, project);
    verify(seeded.len() == 3);
    verify(seeded[0] == 1.5 && seeded[1] == 3.5 && seeded[2] == 6.5);

    let exclusive: list<f64> = transform_exclusive_scan(values, 1.0, add, project);
    verify(exclusive.len() == 3);
    verify(exclusive[0] == 1.0 && exclusive[1] == 2.0 && exclusive[2] == 4.0);

    let empty: list<i32> = [];
    let empty_inclusive: list<f64> = transform_inclusive_scan(empty, add, project);
    let empty_seeded: list<f64> = transform_inclusive_scan(empty, 0.5, add, project);
    let empty_exclusive: list<f64> = transform_exclusive_scan(empty, 1.0, add, project);
    verify(empty_inclusive.len() == 0);
    verify(empty_seeded.len() == 0 && empty_exclusive.len() == 0);
}

#[test]
fn test_algorithm_numeric_generic_inner_product() {
    let left: list<i32> = [1, 2, 3, 4];
    let right: list<i32> = [10, 20, 30];
    let initial: i64 = 7;
    verify(inner_product(left, right, initial) == 147);

    let empty: list<i32> = [];
    verify(inner_product(left, empty, initial) == initial);

    let wide_right: list<i64> = [10, 20, 30];
    verify(inner_product(left, wide_right, initial) == 147);

    let pair_term = |a: i32, b: i64| { return a + b; };
    let decimal_fold = |acc: i64, term: i64| { return acc * 10 + term; };
    verify(inner_product_by(left, wide_right, 0, decimal_fold, pair_term) ==
           1353);
    verify(inner_product(left, wide_right, 0, decimal_fold, pair_term) ==
           1353);
    let empty_wide: list<i64> = [];
    verify(inner_product_by(left, empty_wide, 17, decimal_fold, pair_term) == 17);
}

#[test]
fn test_algorithm_numeric_partial_sum_and_adjacent_difference() {
    let data: list<i64> = [2, 3, 5];
    let ps: list<i64> = partial_sum_i64(data, 10);
    verify(ps.len() == 3);
    verify(ps[0] == 12);
    verify(ps[1] == 15);
    verify(ps[2] == 20);

    let ad: list<i64> = adjacent_difference_i64(ps, 10);
    verify(ad.len() == 3);
    verify(ad[0] == 2);
    verify(ad[1] == 3);
    verify(ad[2] == 5);
}

#[test]
fn test_algorithm_numeric_generic_partial_sum_and_adjacent_difference() {
    let data: list<i32> = [2, 3, 5];
    let init: i32 = 10;
    let prefix: list<i32> = partial_sum(data, init);
    verify(prefix.len() == 3);
    verify(prefix[0] == 12 && prefix[1] == 15 && prefix[2] == 20);

    let differences: list<i32> = adjacent_difference(prefix, init);
    verify(differences.len() == 3);
    verify(differences[0] == 2 && differences[1] == 3 && differences[2] == 5);

    let empty: list<i32> = [];
    let empty_prefix: list<i32> = partial_sum(empty, init);
    let empty_diff: list<i32> = adjacent_difference(empty, init);
    verify(empty_prefix.len() == 0 && empty_diff.len() == 0);
}

#[test]
fn test_algorithm_numeric_custom_partial_and_adjacent_operations() {
    let values: list<i32> = [10, 3, 2, 8];
    let subtract = |left: i32, right: i32| { return left - right; };
    let prefixes: list<i32> = partial_sum_by(values, subtract);
    verify(prefixes.len() == 4 && prefixes[0] == 10 && prefixes[1] == 7 &&
           prefixes[2] == 5 && prefixes[3] == -3);
    let differences: list<i32> = adjacent_difference_by(values, subtract);
    verify(differences.len() == 4 && differences[0] == 10 &&
           differences[1] == -7 && differences[2] == -1 &&
           differences[3] == 6);

    let empty: list<i32> = [];
    let empty_prefixes: list<i32> = partial_sum_by(empty, subtract);
    let empty_differences: list<i32> = adjacent_difference_by(empty, subtract);
    verify(empty_prefixes.len() == 0 && empty_differences.len() == 0);
    let singleton: list<i32> = [42];
    let one_prefix: list<i32> = partial_sum_by(singleton, subtract);
    let one_difference: list<i32> = adjacent_difference_by(singleton, subtract);
    verify(one_prefix.len() == 1 && one_prefix[0] == 42 &&
           one_difference.len() == 1 && one_difference[0] == 42);
}

#[test]
fn test_algorithm_rand_namespace_reproducible() {
    seed(123);
    let a: u64 = next_u64();
    seed(123);
    let b: u64 = next_u64();
    verify(a == b);
    for _i in 0..200 {
        let v: i64 = range_i64(10, 20);
        verify(v >= 10 && v <= 20);
    }
}

#[test]
fn test_algorithm_regex_namespace_basic() {
    let rr: result<Regex, str8> = Regex::compile("([A-Za-z]+)-([0-9]+)");
    verify(rr.is_err() == false);
    let re: Regex = rr.unwrap();
    let text: str8 = "user-42";
    let s: i64 = re.find_start(text);
    let e: i64 = re.find_end(text);
    verify(s == 0 && e == 7);
    let m: str8 = sub(text, s, e - s);
    let ok: i32 = eq(m, "user-42");
    free(m);
    re.close();
    verify(ok == 1);
}

#[test]
fn test_algorithm_genetic_random_genome_reproducible() {
    seed(123456);
    let g1: list<i64> = random_genome_i64(8, -3, 3);
    seed(123456);
    let g2: list<i64> = random_genome_i64(8, -3, 3);
    verify(g1.len() == 8);
    verify(g2.len() == 8);
    for i in 0..8 {
        verify(g1[i] == g2[i]);
        verify(g1[i] >= -3 && g1[i] <= 3);
    }
}

#[test]
fn test_algorithm_genetic_crossover_and_mutation_edges() {
    let a: list<i64> = [1, 2, 3, 4];
    let b: list<i64> = [9, 8, 7, 6];
    let c0: list<i64> = crossover_one_point_i64(a, b, 0);
    let c2: list<i64> = crossover_one_point_i64(a, b, 2);
    let c9: list<i64> = crossover_one_point_i64(a, b, 9);
    verify(c0[0] == 9 && c0[1] == 8 && c0[2] == 7 && c0[3] == 6);
    verify(c2[0] == 1 && c2[1] == 2 && c2[2] == 7 && c2[3] == 6);
    verify(c9[0] == 1 && c9[1] == 2 && c9[2] == 3 && c9[3] == 4);

    seed(99);
    let m0: list<i64> = mutate_genome_i64(a, 0, 0, 10);
    let an: i64 = a.len();
    for i in 0..an {
        verify(m0[i] == a[i]);
    }
    seed(99);
    let m1: list<i64> = mutate_genome_i64(a, 1000, 0, 10);
    verify(m1.len() == a.len());
    let m1n: i64 = m1.len();
    for i in 0..m1n {
        verify(m1[i] >= 0 && m1[i] <= 10);
    }
}

#[test]
fn test_algorithm_genetic_selection() {
    let fit: list<i64> = [10, 30, 20, 5];
    verify(argmax_i64(fit) == 1);

    seed(7);
    for _i in 0..64 {
        let idx: i64 = tournament_select_index_i64(fit, 3);
        verify(idx >= 0 && idx < fit.len());
    }
}

#[test]
fn test_algorithm_genetic_population_access_helpers() {
    let population: list<i64> = [
        1, 2, 3,
        4, 5, 6,
        7, 8, 9
    ];

    let genome: list<i64> = genome_at_i64(population, 3, 1);
    verify(genome.len() == 3);
    verify(genome[0] == 4 && genome[1] == 5 && genome[2] == 6);
    let missing_genome: list<i64> = genome_at_i64(population, 3, 3);
    verify(missing_genome.len() == 0);

    let replacement: list<i64> = [10, 11, 12];
    let replaced: list<i64> = replace_genome_i64(population, 3, 1, replacement);
    verify(replaced.len() == 9);
    verify(replaced[0] == 1 && replaced[1] == 2 && replaced[2] == 3);
    verify(replaced[3] == 10 && replaced[4] == 11 && replaced[5] == 12);
    verify(replaced[6] == 7 && replaced[7] == 8 && replaced[8] == 9);

    let bad_replacement: list<i64> = [1, 2];
    let rejected_replacement: list<i64> = replace_genome_i64(population, 3, 1, bad_replacement);
    verify(rejected_replacement.len() == 0);
}

#[test]
fn test_algorithm_genetic_population_reproduction() {
    seed(4242);
    let pop_size: i64 = 6;
    let gene_count: i64 = 5;
    let pop: list<i64> = random_population_i64(pop_size, gene_count, 0, 9);
    verify(pop.len() == pop_size * gene_count);
    for i in 0..6 {
        for j in 0..5 {
            let idx: i64 = i * gene_count + j;
            verify(pop[idx] >= 0 && pop[idx] <= 9);
        }
    }

    let fit: list<i64> = [10, 30, 20, 5, 1, 12];
    let next: list<i64> =
        reproduce_next_population_i64(pop, pop_size, gene_count, fit, 150, 0, 9, 3);
    verify(next.len() == pop_size * gene_count);
    for i in 0..6 {
        for j in 0..5 {
            let idx: i64 = i * gene_count + j;
            verify(next[idx] >= 0 && next[idx] <= 9);
        }
    }
}

#[test]
fn test_algorithm_ranges_predicate_algorithms() {
    let values: list<i32> = [-4, -1, 0, 2, 5, 8];
    let is_even = |value: i32| {
        return value % 2 == 0;
    };
    let less_than_ten = |value: i32| { return value < 10; };
    let is_five = |value: i32| { return value == 5; };
    let above_ten = |value: i32| { return value > 10; };

    verify(find_if(values, is_even) == 0);
    verify(find_last_if(values, is_even) == 5);
    verify(find_last_if_not(values, is_even) == 4);
    verify(count_if(values, is_even) == 4);
    verify(all_of(values, less_than_ten));
    verify(any_of(values, is_five));
    verify(none_of(values, above_ten));

    let threshold: i32 = 3;
    let above_threshold = |value: i32| {
        return value > threshold;
    };
    let selected: list<i32> = filter(values, above_threshold);
    verify(selected.len() == 2);
    verify(selected[0] == 5 && selected[1] == 8);
    verify(values.len() == 6);

    let no_values: list<i32> = [];
    verify(find_if(no_values, is_even) == -1);
    verify(find_last_if(no_values, is_even) == -1);
    verify(find_last_if_not(no_values, is_even) == -1);
    verify(count_if(no_values, is_even) == 0);
    let no_selected: list<i32> = filter(no_values, is_even);
    verify(no_selected.len() == 0);
    verify(all_of(no_values, is_even));
    verify(!any_of(no_values, is_even));
    verify(none_of(no_values, is_even));
}

#[test]
fn test_algorithm_ranges_projected_predicate_queries() {
    let values: list<i32> = [11, 21, 32, 39, 44];
    let project_tens = |value: i32| { return value / 10; };
    let is_even = |key: i32| { return key % 2 == 0; };
    let below_four = |key: i32| { return key < 4; };
    let above_nine = |key: i32| { return key > 9; };

    verify(!all_of_projected(values, is_even, project_tens));
    verify(any_of_projected(values, is_even, project_tens));
    verify(!none_of_projected(values, is_even, project_tens));
    verify(find_if_projected(values, is_even, project_tens) == 1);
    verify(find_if_not_projected(values, below_four, project_tens) == 4);
    verify(count_if_projected(values, is_even, project_tens) == 2);
    verify(find_if_projected(values, above_nine, project_tens) == -1);

    let empty: list<i32> = [];
    verify(all_of_projected(empty, is_even, project_tens));
    verify(!any_of_projected(empty, is_even, project_tens));
    verify(none_of_projected(empty, is_even, project_tens));
    verify(find_if_projected(empty, is_even, project_tens) == -1);
    verify(find_if_not_projected(empty, is_even, project_tens) == -1);
    verify(count_if_projected(empty, is_even, project_tens) == 0);
}

#[test]
fn test_algorithm_ranges_projected_reverse_predicate_search() {
    let values: list<i32> = [11, 22, 29, 31, 44];
    let project_tens = |value: i32| { return value / 10; };
    let is_even = |key: i32| { return key % 2 == 0; };
    let below_four = |key: i32| { return key < 4; };

    verify(find_last_if_projected(values, is_even, project_tens) == 4);
    verify(find_last_if_not_projected(values, below_four, project_tens) == 4);
    verify(find_last_if_projected(values, below_four, project_tens) == 3);

    let empty: list<i32> = [];
    verify(find_last_if_projected(empty, is_even, project_tens) == -1);
    verify(find_last_if_not_projected(empty, below_four, project_tens) == -1);
}

#[test]
fn test_algorithm_ranges_for_each() {
    let values: list<i32> = [2, 3, 5];
    var total: i32 = 0;
    let add_to_total = |value: i32| {
        total = total + value;
    };
    for_each(values, add_to_total);
    verify(total == 10);

    let empty: list<i32> = [];
    for_each(empty, add_to_total);
    verify(total == 10);
}

#[test]
fn test_algorithm_ranges_for_each_n() {
    let values: list<i32> = [3, 5, 7, 11];
    var sum: i32 = 0;
    var calls: i32 = 0;
    let collect = |value: i32| {
        sum = sum + value;
        calls = calls + 1;
    };

    for_each_n(values, 2, collect);
    verify(sum == 8 && calls == 2);
    for_each_n(values, 99, collect);
    verify(sum == 34 && calls == 6);
    for_each_n(values, 0, collect);
    for_each_n(values, -2, collect);
    verify(sum == 34 && calls == 6);
    verify(values[0] == 3 && values[3] == 11);
}

#[test]
fn test_algorithm_ranges_for_each_n_returns_consumed_count() {
    let values: list<i32> = [3, 5, 7, 11];
    var total: i32 = 0;
    let collect = |value: i32| { total = total + value; };

    let first: i64 = for_each_n_count(values, 2, collect);
    verify(first == 2 && total == 8);
    let all: i64 = for_each_n_count(values, 99, collect);
    verify(all == 4 && total == 34);
    let none: i64 = for_each_n_count(values, -1, collect);
    verify(none == 0 && total == 34);

    let tens = |value: i32| { return value / 10; };
    var projected_total: i32 = 0;
    let collect_key = |key: i32| { projected_total = projected_total + key; };
    let projected: i64 =
        for_each_n_projected_count(values, 3, collect_key, tens);
    verify(projected == 3 && projected_total == 0);
    let projected_all: i64 =
        for_each_n_projected_count(values, 99, collect_key, tens);
    verify(projected_all == 4 && projected_total == 1);
}

#[test]
fn test_algorithm_ranges_projected_for_each() {
    let values: list<i32> = [11, 21, 32];
    let project_tens = |value: i32| { return value / 10; };
    var total: i32 = 0;
    let add_key = |key: i32| { total = total + key; };

    for_each_projected(values, add_key, project_tens);
    verify(total == 6);
    total = 0;
    for_each_n_projected(values, 2, add_key, project_tens);
    verify(total == 3);
    total = 0;
    for_each_n_projected(values, 8, add_key, project_tens);
    verify(total == 6);
    total = 0;
    for_each_n_projected(values, -1, add_key, project_tens);
    verify(total == 0);
    verify(values[0] == 11 && values[2] == 32);
}

#[test]
fn test_algorithm_ranges_generate_n() {
    var next_value: i32 = 0;
    let next = || {
        next_value = next_value + 1;
        return next_value;
    };
    let generated: list<i32> = generate_n(4, next);
    verify(generated.len() == 4);
    verify(generated[0] == 1 && generated[1] == 2);
    verify(generated[2] == 3 && generated[3] == 4);
    verify(next_value == 4);

    let empty: list<i32> = generate_n(0, next);
    let negative: list<i32> = generate_n(-3, next);
    verify(empty.len() == 0 && negative.len() == 0);
    verify(next_value == 4);
}

#[test]
fn test_algorithm_ranges_generate_shape() {
    var next_value: i32 = 10;
    let next = || {
        next_value = next_value + 1;
        return next_value;
    };
    let shape: list<bool> = [true, false, true];
    let generated: list<i32> = generate(shape, next);
    verify(generated.len() == 3 && generated[0] == 11 &&
           generated[1] == 12 && generated[2] == 13);
    verify(next_value == 13 && shape[0] && !shape[1] && shape[2]);

    let empty: list<i32> = [];
    let no_values: list<i32> = generate(empty, next);
    verify(no_values.len() == 0 && next_value == 13);
}

#[test]
fn test_algorithm_ranges_fill_copy() {
    let shape: list<i32> = [1, 2, 3, 4];
    let fill_value: i32 = 9;
    let filled: list<i32> = fill(shape, fill_value);
    verify(filled.len() == 4 && filled[0] == 9 && filled[1] == 9 &&
           filled[2] == 9 && filled[3] == 9);
    verify(shape[0] == 1 && shape[3] == 4);

    let empty: list<i32> = [];
    let no_values: list<i32> = fill(empty, fill_value);
    verify(no_values.len() == 0);

    let counted: list<i32> = fill_n(3, fill_value);
    verify(counted.len() == 3 && counted[0] == 9 && counted[2] == 9);
    let zero_count: list<i32> = fill_n(0, fill_value);
    let negative_count: list<i32> = fill_n(-2, fill_value);
    verify(zero_count.len() == 0 && negative_count.len() == 0);
}

#[test]
fn test_algorithm_ranges_copy_n() {
    let values: list<i32> = [4, 8, 15];
    let complete: list<i32> = ranges_copy(values);
    verify(complete.len() == 3 && complete[0] == 4 && complete[2] == 15);
    complete.push(16);
    verify(complete.len() == 4 && values.len() == 3);

    let prefix: list<i32> = copy_n(values, 2);
    verify(prefix.len() == 2 && prefix[0] == 4 && prefix[1] == 8);
    let counted_prefix: tuple<i64, list<i32>> =
        copy_n_with_count(values, 2);
    let counted_prefix_values: list<i32> = counted_prefix.1;
    verify(counted_prefix.0 == 2 && counted_prefix_values.len() == 2 &&
           counted_prefix_values[1] == 8);

    let all_values: list<i32> = copy_n(values, 10);
    verify(all_values.len() == 3 && all_values[2] == 15);
    let counted_all: tuple<i64, list<i32>> =
        copy_n_with_count(values, 10);
    let counted_all_values: list<i32> = counted_all.1;
    verify(counted_all.0 == 3 && counted_all_values[2] == 15);
    let no_values: list<i32> = copy_n(values, -2);
    verify(no_values.len() == 0);
    let counted_none: tuple<i64, list<i32>> =
        copy_n_with_count(values, -2);
    let counted_none_values: list<i32> = counted_none.1;
    verify(counted_none.0 == 0 && counted_none_values.len() == 0);
    let empty: list<i32> = [];
    let empty_copy: list<i32> = ranges_copy(empty);
    verify(empty_copy.len() == 0);
}

#[test]
fn test_algorithm_ranges_swap_ranges_copy() {
    let left: list<i32> = [1, 2, 3, 4];
    let right: list<i32> = [8, 9];
    let swapped: tuple<list<i32>, list<i32>> = swap_ranges(left, right);
    let new_left: list<i32> = swapped.0;
    let new_right: list<i32> = swapped.1;
    verify(new_left.len() == 4 && new_left[0] == 8 &&
           new_left[1] == 9 && new_left[2] == 3 && new_left[3] == 4);
    verify(new_right.len() == 2 && new_right[0] == 1 && new_right[1] == 2);
    verify(left[0] == 1 && left[3] == 4 && right[0] == 8 && right[1] == 9);

    let empty: list<i32> = [];
    let swapped_empty: tuple<list<i32>, list<i32>> = swap_ranges(empty, right);
    let empty_left: list<i32> = swapped_empty.0;
    let unchanged_right: list<i32> = swapped_empty.1;
    verify(empty_left.len() == 0 && unchanged_right.len() == right.len());
    verify(unchanged_right[0] == 8 && unchanged_right[1] == 9);
}

#[test]
fn test_algorithm_ranges_sample_without_replacement() {
    let values: list<i32> = [1, 2, 3, 4, 5, 6];
    let choose_last = |bound: i64| { return bound - 1; };
    let sampled: list<i32> = ranges_sample(values, 3, choose_last);
    verify(sampled.len() == 3);
    verify(sampled[0] == 4 && sampled[1] == 5 && sampled[2] == 6);
    verify(values.len() == 6 && values[0] == 1 && values[5] == 6);

    let all: list<i32> = ranges_sample(values, 20, choose_last);
    verify(all.len() == values.len());
    for i in 0..values.len() {
        verify(all[i] == values[i]);
    }

    let empty_sample: list<i32> = ranges_sample(values, 0, choose_last);
    let negative_sample: list<i32> = ranges_sample(values, -2, choose_last);
    verify(empty_sample.len() == 0 && negative_sample.len() == 0);
    let empty: list<i32> = [];
    let sampled_empty: list<i32> = ranges_sample(empty, 3, choose_last);
    verify(sampled_empty.len() == 0);

    let records: list<AlgorithmRangeItem> = [
        AlgorithmRangeItem { key: 1, payload: 10 },
        AlgorithmRangeItem { key: 2, payload: 20 },
        AlgorithmRangeItem { key: 3, payload: 30 },
        AlgorithmRangeItem { key: 4, payload: 40 }
    ];
    let sampled_records: list<AlgorithmRangeItem> =
        ranges_sample(records, 2, choose_last);
    let first_record: AlgorithmRangeItem = sampled_records[0];
    let second_record: AlgorithmRangeItem = sampled_records[1];
    verify(sampled_records.len() == 2 && first_record.key == 3 &&
           first_record.payload == 30 && second_record.key == 4 &&
           second_record.payload == 40);
}

#[test]
fn test_algorithm_ranges_shuffle_copy() {
    let values: list<i32> = [1, 2, 3, 4];
    let choose_last = |bound: i64| { return bound - 1; };
    let shuffled: list<i32> = ranges_shuffle(values, choose_last);
    verify(shuffled.len() == 4);
    verify(shuffled[0] == 4 && shuffled[1] == 3 &&
           shuffled[2] == 2 && shuffled[3] == 1);
    verify(values[0] == 1 && values[3] == 4);

    let empty: list<i32> = [];
    let shuffled_empty: list<i32> = ranges_shuffle(empty, choose_last);
    verify(shuffled_empty.len() == 0);
    let singleton: list<i32> = [8];
    let shuffled_singleton: list<i32> = ranges_shuffle(singleton, choose_last);
    verify(shuffled_singleton.len() == 1 && shuffled_singleton[0] == 8);
}


#[test]
fn test_algorithm_ranges_partition_algorithms() {
    let values: list<i32> = [1, 3, 5, 2, 4, 6];
    let is_odd = |value: i32| { return value % 2 == 1; };
    let is_even = |value: i32| { return value % 2 == 0; };
    verify(is_partitioned(values, is_odd));
    verify(!is_partitioned(values, is_even));
    verify(partition_point(values, is_odd) == 3);

    let rearranged: list<i32> = stable_partition(values, is_odd);
    verify(rearranged.len() == 6);
    verify(rearranged[0] == 1 && rearranged[1] == 3 && rearranged[2] == 5);
    verify(rearranged[3] == 2 && rearranged[4] == 4 && rearranged[5] == 6);
    verify(values[0] == 1 && values[1] == 3 && values[2] == 5);

    let partitioned: tuple<list<i32>, i64> = ranges_partition(values, is_odd);
    let partitioned_values: list<i32> = partitioned.0;
    verify(partitioned.1 == 3 && partitioned_values.len() == 6);
    verify(partitioned_values[0] == 1 && partitioned_values[1] == 3 &&
           partitioned_values[2] == 5 && partitioned_values[3] == 2 &&
           partitioned_values[4] == 4 && partitioned_values[5] == 6);
    verify(values[0] == 1 && values[1] == 3 && values[2] == 5);

    var predicate_calls: i64 = 0;
    let counted_odd = |value: i32| {
        predicate_calls = predicate_calls + 1;
        return value % 2 == 1;
    };
    let counted_partition: tuple<list<i32>, i64> =
        ranges_partition(values, counted_odd);
    verify(counted_partition.1 == 3 && predicate_calls == values.len());

    let copies: tuple<list<i32>, list<i32>> = partition_copy(values, is_odd);
    let odds: list<i32> = copies.0;
    let evens: list<i32> = copies.1;
    verify(odds.len() == 3 && odds[0] == 1 && odds[1] == 3 && odds[2] == 5);
    verify(evens.len() == 3 && evens[0] == 2 && evens[1] == 4 && evens[2] == 6);

    let no_values: list<i32> = [];
    verify(is_partitioned(no_values, is_odd));
    verify(partition_point(no_values, is_odd) == 0);
    let empty_partition: list<i32> = stable_partition(no_values, is_odd);
    verify(empty_partition.len() == 0);
    let empty_copy: tuple<list<i32>, i64> = ranges_partition(no_values, is_odd);
    let empty_values: list<i32> = empty_copy.0;
    verify(empty_values.len() == 0 && empty_copy.1 == 0);

    let all_match: list<i32> = [1, 3, 5];
    verify(partition_point(all_match, is_odd) == all_match.len());
    let none_match: list<i32> = [2, 4, 6];
    verify(partition_point(none_match, is_odd) == 0);

    let large: list<i64> = iota(0, 1024);
    var calls: i32 = 0;
    let below_midpoint = |value: i64| {
        calls = calls + 1;
        return value < 512;
    };
    verify(partition_point(large, below_midpoint) == 512);
    verify(calls <= 11);
}

#[test]
fn test_algorithm_ranges_projected_partition_algorithms() {
    let values: list<i32> = [11, 21, 29, 31, 34, 42];
    let project_tens = |value: i32| { return value / 10; };
    let below_three = |key: i32| { return key < 3; };

    verify(is_partitioned_projected(values, below_three, project_tens));
    verify(partition_point_projected(values, below_three, project_tens) == 3);
    let selected: list<i32> = copy_if_projected(
        values, below_three, project_tens);
    verify(selected.len() == 3 && selected[0] == 11 &&
           selected[1] == 21 && selected[2] == 29);

    let stable: list<i32> = stable_partition_projected(
        values, below_three, project_tens);
    verify(stable.len() == 6 && stable[0] == 11 && stable[1] == 21 &&
           stable[2] == 29 && stable[3] == 31 && stable[4] == 34 &&
           stable[5] == 42);
    let split: tuple<list<i32>, i64> = partition_projected(
        values, below_three, project_tens);
    let split_values: list<i32> = split.0;
    verify(split.1 == 3 && split_values[0] == 11 && split_values[2] == 29 &&
           split_values[3] == 31 && split_values[5] == 42);
    let groups: tuple<list<i32>, list<i32>> = partition_copy_projected(
        values, below_three, project_tens);
    let matches: list<i32> = groups.0;
    let nonmatches: list<i32> = groups.1;
    verify(matches.len() == 3 && matches[2] == 29);
    verify(nonmatches.len() == 3 && nonmatches[0] == 31 &&
           nonmatches[2] == 42);

    let invalid: list<i32> = [11, 31, 21];
    verify(!is_partitioned_projected(invalid, below_three, project_tens));
    let empty: list<i32> = [];
    verify(is_partitioned_projected(empty, below_three, project_tens));
    verify(partition_point_projected(empty, below_three, project_tens) == 0);
}

#[test]
fn test_algorithm_ranges_predicate_removal_and_unique() {
    let values: list<i32> = [-3, -1, 0, 2, 4];
    let is_nonnegative = |value: i32| { return value >= 0; };
    let is_negative = |value: i32| { return value < 0; };
    verify(find_if_not(values, is_nonnegative) == 0);
    verify(find_if_not(values, is_negative) == 2);

    let kept: list<i32> = remove_if(values, is_negative);
    verify(kept.len() == 3);
    verify(kept[0] == 0 && kept[1] == 2 && kept[2] == 4);
    let replacement: i32 = 9;
    let replaced: list<i32> = replace_if(values, is_negative, replacement);
    verify(replaced.len() == 5);
    verify(replaced[0] == 9 && replaced[1] == 9 && replaced[2] == 0);
    verify(values[0] == -3 && values[1] == -1);

    let runs: list<i32> = [11, 21, 22, 32, 33, 43];
    let same_last_digit = |left: i32, right: i32| {
        return left % 10 == right % 10;
    };
    let compacted: list<i32> = unique_by(runs, same_last_digit);
    verify(compacted.len() == 3);
    verify(compacted[0] == 11 && compacted[1] == 22 && compacted[2] == 33);
    let copied_runs: list<i32> = unique_copy_by(runs, same_last_digit);
    verify(copied_runs.len() == 3 && copied_runs[0] == 11 &&
           copied_runs[1] == 22 && copied_runs[2] == 33);

    let empty: list<i32> = [];
    let empty_kept: list<i32> = remove_if(empty, is_negative);
    let empty_replaced: list<i32> =
        replace_if(empty, is_negative, replacement);
    let empty_unique: list<i32> = unique_by(empty, same_last_digit);
    verify(find_if_not(empty, is_nonnegative) == -1);
    verify(empty_kept.len() == 0 && empty_replaced.len() == 0);
    verify(empty_unique.len() == 0);
}

#[test]
fn test_algorithm_ranges_unique_projected() {
    let values: list<i32> = [11, 12, 21, 22, 22, 31, 44];
    let project_tens = |value: i32| { return value / 10; };
    let unique_keys: list<i32> = unique_projected(values, project_tens);
    verify(unique_keys.len() == 4);
    verify(unique_keys[0] == 11 && unique_keys[1] == 21 &&
           unique_keys[2] == 31 && unique_keys[3] == 44);
    let copied: list<i32> = unique_copy_projected(values, project_tens);
    verify(copied.len() == 4 && copied[0] == 11 && copied[1] == 21 &&
           copied[2] == 31 && copied[3] == 44);
    verify(values.len() == 7 && values[1] == 12);

    let empty: list<i32> = [];
    let empty_unique: list<i32> = unique_projected(empty, project_tens);
    let empty_copy: list<i32> = unique_copy_projected(empty, project_tens);
    verify(empty_unique.len() == 0 && empty_copy.len() == 0);
}
