struct AlgorithmRangeItem {
    var key: i32;
    var payload: i32;
};

#[test]
fn test_algorithm_fuzzy_match_and_score() {
    verify(is_match("tracker_ui_demo.mla", "trui") == 1);
    verify(is_match("tracker_ui_demo.mla", "tuiz") == 0);
    verify(score("tracker_ui_demo.mla", "trui") >= 0);
}

#[test]
fn test_algorithm_fuzzy_ranked_indices() {
    let items: list<str8> = [
        "stdlib/std/fs.mla",
        "examples/esc_widgets/tracker_ui_demo.mla",
        "tools/mlangd-mla/main.mla"
    ];
    let ranked: list<i64> = filter_indices(items, "escwid");
    verify(ranked.len() > 0);
    verify(ranked[0] == 1);
}

#[test]
fn test_algorithm_fuzzy_best_index() {
    let items: list<str8> = ["abc", "axbyc", "zzz"];
    let best: i64 = best_index(items, "abc");
    verify(best == 0);
    let none: i64 = best_index(items, "qqq");
    verify(none == -1);
}

#[test]
fn test_algorithm_fft_namespace_roundtrip() {
    verify(is_power_of_two(8));
    verify(!is_power_of_two(6));

    let data: list<i64> = [1, 0, 2, 0, 3, 0, 4, 0];
    let freq: list<i64> = forward(data);
    verify(freq.len() > 0);
    let out: list<i64> = inverse(freq);
    verify(out.len() > 0);
    for i in 0..4 {
        let base: i64 = i * 2;
        let re: i64 = out[base];
        let im: i64 = out[base + 1];
        verify(re == (i + 1));
        verify(im == 0);
    }
}

#[test]
fn test_algorithm_order_sort_and_reverse() {
    let data: list<i64> = [5, 1, 3, 3, 2];
    let sorted: list<i64> = sort_i64(data);
    verify(is_sorted_i64(sorted) == 1);
    verify(sorted.len() == 5);
    verify(sorted[0] == 1);
    verify(sorted[1] == 2);
    verify(sorted[2] == 3);
    verify(sorted[3] == 3);
    verify(sorted[4] == 5);

    let rev: list<i64> = reverse_i64(sorted);
    verify(rev[0] == 5);
    verify(rev[4] == 1);
}

#[test]
fn test_algorithm_order_bounds_and_binary_search() {
    let data: list<i64> = [1, 2, 3, 3, 5, 8];
    verify(lower_bound_i64(data, 0) == 0);
    verify(lower_bound_i64(data, 3) == 2);
    verify(lower_bound_i64(data, 4) == 4);
    verify(upper_bound_i64(data, 3) == 4);
    verify(upper_bound_i64(data, 8) == 6);
    verify(binary_search_i64(data, 5) == 1);
    verify(binary_search_i64(data, 6) == 0);
}

#[test]
fn test_algorithm_order_unique_sorted() {
    let data: list<i64> = [1, 1, 2, 2, 2, 7, 9, 9];
    let uniq: list<i64> = unique_sorted_i64(data);
    verify(uniq.len() == 4);
    verify(uniq[0] == 1);
    verify(uniq[1] == 2);
    verify(uniq[2] == 7);
    verify(uniq[3] == 9);
}

#[test]
fn test_algorithm_ranges_unique_variants() {
    let data: list<i64> = [1, 1, 2, 2, 3, 1, 1, 4, 4];
    let adj: list<i64> = unique_i64(data);
    verify(adj.len() == 5);
    verify(adj[0] == 1 && adj[1] == 2 && adj[2] == 3 && adj[3] == 1 && adj[4] == 4);

    let stable: list<i64> = unique_stable_i64(data);
    verify(stable.len() == 4);
    verify(stable[0] == 1 && stable[1] == 2 && stable[2] == 3 && stable[3] == 4);
}

#[test]
fn test_algorithm_ranges_rotate_at_middle() {
    let values: list<i32> = [1, 2, 3, 4, 5];
    let rotated: list<i32> = rotate(values, 2);
    verify(rotated.len() == 5 && rotated[0] == 3 && rotated[1] == 4 &&
           rotated[2] == 5 && rotated[3] == 1 && rotated[4] == 2);
    let unchanged: list<i32> = rotate(values, 0);
    verify(unchanged[0] == 1 && unchanged[4] == 5);
    let end: list<i32> = rotate(values, 5);
    verify(end[0] == 1 && end[4] == 5);
    let low: list<i32> = rotate(values, -8);
    let high: list<i32> = rotate(values, 99);
    verify(low[0] == 1 && high[4] == 5);
    let empty: list<i32> = [];
    let empty_rotated: list<i32> = rotate(empty, 3);
    verify(empty_rotated.len() == 0);

    let copied: list<i32> = rotate_copy(values, 2);
    verify(copied.len() == 5 && copied[0] == 3 && copied[1] == 4 &&
           copied[2] == 5 && copied[3] == 1 && copied[4] == 2);
    let copied_end: list<i32> = rotate_copy(values, 5);
    verify(copied_end[0] == 1 && copied_end[4] == 5);
}

#[test]
fn test_algorithm_ranges_shift_algorithms() {
    let values: list<i32> = [1, 2, 3, 4, 5];
    let left: list<i32> = shift_left(values, 2);
    let right: list<i32> = shift_right(values, 2);
    verify(left.len() == 3 && left[0] == 3 && left[1] == 4 && left[2] == 5);
    verify(right.len() == 3 && right[0] == 1 && right[1] == 2 && right[2] == 3);

    let left_noop: list<i32> = shift_left(values, -1);
    let right_noop: list<i32> = shift_right(values, 0);
    verify(left_noop.len() == 5 && right_noop.len() == 5);
    let left_empty: list<i32> = shift_left(values, 5);
    let right_empty: list<i32> = shift_right(values, 8);
    verify(left_empty.len() == 0 && right_empty.len() == 0);
    let empty: list<i32> = [];
    let shifted_empty: list<i32> = shift_left(empty, 1);
    verify(shifted_empty.len() == 0);
}

#[test]
fn test_algorithm_ranges_generic_find_count_contains() {
    let numbers: list<i32> = [3, 4, 4, 8];
    verify(find(numbers, 4) == 1);
    verify(find(numbers, 9) == -1);
    verify(count(numbers, 4) == 2);
    verify(contains(numbers, 8));
    verify(contains(numbers, 9) == false);

    let words: list<str8> = ["mango", "pear", "mango"];
    verify(find(words, "pear") == 1);
    verify(find_last(words, "mango") == 2);
    verify(count(words, "mango") == 2);
    verify(contains(words, "plum") == false);
    verify(find_last(words, "plum") == -1);
}

#[test]
fn test_algorithm_ranges_find_last_by_equivalence() {
    let values: list<i32> = [11, 22, 29, 31, 42];
    let same_decade = |item: i32, key: i32| { return item / 10 == key / 10; };
    verify(find_last_by(values, 20, same_decade) == 2);
    verify(find_last_by(values, 90, same_decade) == -1);
    let empty: list<i32> = [];
    verify(find_last_by(empty, 20, same_decade) == -1);
}

#[test]
fn test_algorithm_ranges_find_last_by_projected_heterogeneous_key() {
    let values: list<i32> = [11, 22, 29, 31, 42];
    let same_decade = |item: i32, key: i32| { return item == key; };
    let project_tens = |item: i32| { return item / 10; };
    verify(find_last_by_projected(values, 2, same_decade, project_tens) == 2);
    verify(find_last_by_projected(values, 9, same_decade, project_tens) == -1);
    let empty: list<i32> = [];
    verify(find_last_by_projected(empty, 2, same_decade, project_tens) == -1);
}

#[test]
fn test_algorithm_ranges_equivalence_lookup_and_removal() {
    let values: list<i32> = [11, 22, 29, 31, 42];
    let same_decade = |item: i32, key: i32| { return item / 10 == key / 10; };
    verify(find_by(values, 20, same_decade) == 1);
    verify(count_by(values, 20, same_decade) == 2);
    verify(contains_by(values, 40, same_decade));
    verify(!contains_by(values, 90, same_decade));

    let removed: list<i32> = remove_by(values, 20, same_decade);
    let removed_copy: list<i32> = remove_copy_by(values, 20, same_decade);
    verify(removed.len() == 3 && removed[0] == 11 &&
           removed[1] == 31 && removed[2] == 42);
    verify(removed_copy.len() == 3 && removed_copy[0] == 11 &&
           removed_copy[2] == 42);
    verify(values.len() == 5 && values[1] == 22 && values[2] == 29);

    let empty: list<i32> = [];
    verify(find_by(empty, 20, same_decade) == -1);
    verify(count_by(empty, 20, same_decade) == 0);
    let empty_removed: list<i32> = remove_by(empty, 20, same_decade);
    verify(empty_removed.len() == 0);
}

#[test]
fn test_algorithm_ranges_projected_equivalence_lookup_and_removal() {
    let values: list<i32> = [11, 22, 29, 31, 42];
    let project_tens = |value: i32| { return value / 10; };
    let same_residue = |left: i32, right: i32| {
        return left % 3 == right % 3;
    };
    verify(find_by_projected(values, 5, same_residue, project_tens) == 1);
    verify(count_by_projected(values, 5, same_residue, project_tens) == 2);
    verify(contains_by_projected(values, 8, same_residue, project_tens));
    verify(contains_by_projected(values, 9, same_residue, project_tens));

    let removed: list<i32> = remove_by_projected(
        values, 5, same_residue, project_tens);
    let removed_copy: list<i32> = remove_copy_by_projected(
        values, 5, same_residue, project_tens);
    verify(removed.len() == 3 && removed[0] == 11 && removed[1] == 31 &&
           removed[2] == 42);
    verify(removed_copy.len() == 3 && removed_copy[0] == 11 &&
           removed_copy[1] == 31 && removed_copy[2] == 42);
    verify(values.len() == 5 && values[1] == 22 && values[4] == 42);
    let empty: list<i32> = [];
    verify(!contains_by_projected(empty, 9, same_residue, project_tens));
    verify(find_by_projected(empty, 9, same_residue, project_tens) == -1);
}

#[test]
fn test_algorithm_ranges_generic_adjacent_find() {
    let values: list<i32> = [4, 7, 7, 9, 9];
    verify(adjacent_find(values) == 1);
    let no_match: list<str8> = ["a", "b", "c"];
    let one: list<i32> = [5];
    let empty: list<i32> = [];
    let repeated: list<str8> = ["x", "y", "y"];
    verify(adjacent_find(no_match) == -1);
    verify(adjacent_find(one) == -1 && adjacent_find(empty) == -1);
    verify(adjacent_find(repeated) == 1);
}

#[test]
fn test_algorithm_ranges_adjacent_find_by_equivalence() {
    let grouped: list<i32> = [11, 22, 29, 31];
    let separated: list<i32> = [11, 22, 31];
    let one: list<i32> = [12];
    let empty: list<i32> = [];
    let by_tens = |a: i32, b: i32| { return a / 10 == b / 10; };

    verify(adjacent_find_by(grouped, by_tens) == 1);
    verify(adjacent_find_by(separated, by_tens) == -1);
    verify(adjacent_find_by(one, by_tens) == -1);
    verify(adjacent_find_by(empty, by_tens) == -1);
}

