#[test]
fn test_algorithm_numeric_folds() {
    let values: list<i32> = [1, 2, 3];
    let encode_left = |acc: i32, value: i32| { return acc * 10 + value; };
    let encode_right = |value: i32, acc: i32| { return value + acc * 10; };
    verify(fold_left(values, 4, encode_left) == 4123);
    verify(fold_right(values, 4, encode_right) == 4321);

    let empty: list<i32> = [];
    verify(fold_left(empty, 17, encode_left) == 17);
    verify(fold_right(empty, 23, encode_right) == 23);

    let subtract = |acc: i32, value: i32| { return acc - value; };
    verify(fold_left(values, 20, subtract) == 14);
}

#[test]
fn test_algorithm_numeric_folds_without_initial_value() {
    let values: list<i32> = [1, 2, 3];
    let encode_left = |acc: i32, value: i32| { return acc * 10 + value; };
    let encode_right = |value: i32, acc: i32| { return value + acc * 10; };
    let left: option<i32> = fold_left_first(values, encode_left);
    let right: option<i32> = fold_right_last(values, encode_right);
    let left_value: i32 = match left {
        Some(value) => value,
        None => 0
    };
    let right_value: i32 = match right {
        Some(value) => value,
        None => 0
    };
    verify(left_value == 123 && right_value == 321);

    let empty: list<i32> = [];
    let empty_left: option<i32> = fold_left_first(empty, encode_left);
    let empty_right: option<i32> = fold_right_last(empty, encode_right);
    verify(empty_left.is_none() && empty_right.is_none());
}

#[test]
fn test_algorithm_ranges_folds() {
    let values: list<i32> = [1, 2, 3];
    let encode_left = |acc: i32, value: i32| { return acc * 10 + value; };
    let encode_right = |value: i32, acc: i32| { return value + acc * 10; };
    verify(ranges_fold_left(values, 4, encode_left) == 4123);
    verify(ranges_fold_right(values, 4, encode_right) == 4321);
    let with_iter: tuple<i64, i32> = ranges_fold_left_with_iter(values, 4, encode_left);
    verify(with_iter.0 == 3 && with_iter.1 == 4123);

    let add_to_i64 = |acc: i64, value: i32| { return acc + value; };
    let heterogeneous: i64 = ranges_fold_left(values, 10, add_to_i64);
    verify(heterogeneous == 16);

    let left: option<i32> = ranges_fold_left_first(values, encode_left);
    let right: option<i32> = ranges_fold_right_last(values, encode_right);
    let left_value: i32 = match left { Some(value) => value, None => 0 };
    let right_value: i32 = match right { Some(value) => value, None => 0 };
    verify(left_value == 123 && right_value == 321);

    let empty: list<i32> = [];
    verify(ranges_fold_left(empty, 17, encode_left) == 17);
    verify(ranges_fold_right(empty, 23, encode_right) == 23);
    let empty_with_iter: tuple<i64, i32> = ranges_fold_left_with_iter(empty, 29, encode_left);
    verify(empty_with_iter.0 == 0 && empty_with_iter.1 == 29);
    verify(ranges_fold_left_first(empty, encode_left).is_none());
    verify(ranges_fold_right_last(empty, encode_right).is_none());
}

#[test]
fn test_algorithm_numeric_transform_reduce() {
    let values: list<i32> = [1, 2, 3];
    let add = |acc: i32, value: i32| { return acc + value; };
    let square = |value: i32| { return value * value; };
    verify(transform_reduce(values, 0, add, square) == 14);

    let left: list<i32> = [1, 2, 3];
    let right: list<i32> = [4, 5];
    let multiply = |a: i32, b: i32| { return a * b; };
    verify(transform_reduce(left, right, 7, add, multiply) == 21);

    let empty: list<i32> = [];
    verify(transform_reduce(empty, 9, add, square) == 9);
    verify(transform_reduce(left, empty, 13, add, multiply) == 13);
}

#[test]
fn test_algorithm_numeric_scans() {
    let values: list<i32> = [1, 2, 3, 4];
    let add = |acc: i32, value: i32| { return acc + value; };
    let inclusive: list<i32> = inclusive_scan(values, add);
    verify(inclusive.len() == 4);
    verify(inclusive[0] == 1 && inclusive[1] == 3);
    verify(inclusive[2] == 6 && inclusive[3] == 10);

    let initial: i32 = 10;
    let exclusive: list<i32> = exclusive_scan(values, initial, add);
    verify(exclusive.len() == 4);
    verify(exclusive[0] == 10 && exclusive[1] == 11);
    verify(exclusive[2] == 13 && exclusive[3] == 16);

    let subtract = |acc: i32, value: i32| { return acc - value; };
    let ordered_input: list<i32> = [20, 3, 2];
    let ordered: list<i32> = inclusive_scan(ordered_input, subtract);
    verify(ordered[0] == 20 && ordered[1] == 17 && ordered[2] == 15);

    let empty: list<i32> = [];
    let empty_initial: i32 = 7;
    let empty_inclusive: list<i32> = inclusive_scan(empty, add);
    let empty_exclusive: list<i32> = exclusive_scan(empty, empty_initial, add);
    verify(empty_inclusive.len() == 0 && empty_exclusive.len() == 0);
    let one: list<i32> = [8];
    let one_inclusive: list<i32> = inclusive_scan(one, add);
    let one_exclusive: list<i32> = exclusive_scan(one, empty_initial, add);
    verify(one_inclusive[0] == 8 && one_exclusive[0] == 7);

    let add_wide = |acc: f64, value: i32| { return acc + f64(value); };
    let wide_initial: f64 = 0.5;
    let wide_exclusive: list<f64> = exclusive_scan(values, wide_initial, add_wide);
    verify(wide_exclusive.len() == 4);
    verify(wide_exclusive[0] == 0.5 && wide_exclusive[1] == 1.5);
    verify(wide_exclusive[2] == 3.5 && wide_exclusive[3] == 6.5);
}

#[test]
fn test_algorithm_numeric_transform_scans() {
    let values: list<i32> = [2, 4, 6];
    let project = |value: i32| { return f64(value) / 2.0; };
    let add = |acc: f64, value: f64| { return acc + value; };

    let inclusive: list<f64> = transform_inclusive_scan(values, add, project);
    verify(inclusive.len() == 3);
    verify(inclusive[0] == 1.0 && inclusive[1] == 3.0 && inclusive[2] == 6.0);

    let seeded: list<f64> = transform_inclusive_scan(values, 0.5, add, project);
    verify(seeded.len() == 3);
    verify(seeded[0] == 1.5 && seeded[1] == 3.5 && seeded[2] == 6.5);

    let exclusive: list<f64> = transform_exclusive_scan(values, 1.0, add, project);
    verify(exclusive.len() == 3);
    verify(exclusive[0] == 1.0 && exclusive[1] == 2.0 && exclusive[2] == 4.0);

    let empty: list<i32> = [];
    let empty_inclusive: list<f64> = transform_inclusive_scan(empty, add, project);
    let empty_seeded: list<f64> = transform_inclusive_scan(empty, 0.5, add, project);
    let empty_exclusive: list<f64> = transform_exclusive_scan(empty, 1.0, add, project);
    verify(empty_inclusive.len() == 0);
    verify(empty_seeded.len() == 0 && empty_exclusive.len() == 0);
}

