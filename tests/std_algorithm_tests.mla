#[test]
fn test_algorithm_ranges_comparator_symmetric_difference_sorted() {
    let left: list<i32> = [9, 7, 7, 3, 1];
    let right: list<i32> = [8, 7, 4, 3, 3];
    let greater = |a: i32, b: i32| { return a > b; };
    let symmetric_values: list<i32> = symmetric_difference_sorted_by(left, right, greater);
    verify(symmetric_values.len() == 6);
    verify(symmetric_values[0] == 9 && symmetric_values[1] == 8);
    verify(symmetric_values[2] == 7 && symmetric_values[3] == 4);
    verify(symmetric_values[4] == 3 && symmetric_values[5] == 1);
}

#[test]
fn test_algorithm_ranges_generic_sorted_copy() {
    let values: list<i32> = [5, 1, 3, 1, 9, -2];
    let result: list<i32> = sorted(values);
    verify(result.len() == 6);
    verify(result[0] == -2 && result[1] == 1 && result[2] == 1);
    verify(result[3] == 3 && result[4] == 5 && result[5] == 9);
    verify(values[0] == 5 && values[5] == -2);

    let words: list<str8> = ["fox", "ant", "bee", "ant"];
    let ordered: list<str8> = sorted(words);
    verify(ordered.len() == 4);
    verify(ordered[0] == "ant" && ordered[1] == "ant");
    verify(ordered[2] == "bee" && ordered[3] == "fox");
}

#[test]
fn test_algorithm_ranges_sorted_by_comparator() {
    let values: list<i32> = [2, 5, 1, 5, 9];
    let greater = |a: i32, b: i32| { return a > b; };
    let descending: list<i32> = sorted_by(values, greater);
    verify(descending.len() == 5);
    verify(descending[0] == 9 && descending[1] == 5);
    verify(descending[2] == 5 && descending[3] == 2 && descending[4] == 1);
    verify(values[0] == 2 && values[4] == 9);

    let grouped: list<i32> = [21, 22, 12, 11, 3];
    let by_tens = |a: i32, b: i32| { return a / 10 < b / 10; };
    let stable: list<i32> = sorted_by(grouped, by_tens);
    verify(stable[0] == 3 && stable[1] == 12 && stable[2] == 11);
    verify(stable[3] == 21 && stable[4] == 22);

    let empty: list<i32> = [];
    let empty_sorted: list<i32> = sorted_by(empty, greater);
    verify(empty_sorted.len() == 0);
    let one: list<i32> = [7];
    let one_sorted: list<i32> = sorted_by(one, greater);
    verify(one_sorted[0] == 7);
}

#[test]
fn test_algorithm_ranges_permutations() {
    let ascending: list<i32> = [1, 2, 3];
    let next: tuple<bool, list<i32>> = next_permutation(ascending);
    let next_values: list<i32> = next.1;
    verify(next.0 && next_values[0] == 1 && next_values[1] == 3 && next_values[2] == 2);

    let previous: tuple<bool, list<i32>> = prev_permutation(ascending);
    let previous_values: list<i32> = previous.1;
    verify(!previous.0 && previous_values[0] == 3 && previous_values[1] == 2 && previous_values[2] == 1);

    let descending: list<i32> = [3, 2, 1];
    let wrapped: tuple<bool, list<i32>> = next_permutation(descending);
    let wrapped_values: list<i32> = wrapped.1;
    verify(!wrapped.0 && wrapped_values[0] == 1 && wrapped_values[1] == 2 && wrapped_values[2] == 3);

    let duplicate_values: list<i32> = [1, 2, 2];
    let duplicate_next: tuple<bool, list<i32>> = next_permutation(duplicate_values);
    let duplicate_result: list<i32> = duplicate_next.1;
    verify(duplicate_next.0 && duplicate_result[0] == 2 && duplicate_result[1] == 1 && duplicate_result[2] == 2);

    let greater = |left: i32, right: i32| { return left > right; };
    let custom_next: tuple<bool, list<i32>> = next_permutation_by(descending, greater);
    let custom_values: list<i32> = custom_next.1;
    verify(custom_next.0 && custom_values[0] == 3 && custom_values[1] == 1 && custom_values[2] == 2);
    let custom_previous: tuple<bool, list<i32>> = prev_permutation_by(descending, greater);
    let custom_wrapped: list<i32> = custom_previous.1;
    verify(!custom_previous.0 && custom_wrapped[0] == 1 && custom_wrapped[2] == 3);

    verify(ascending[0] == 1 && ascending[2] == 3);
}

#[test]
fn test_algorithm_ranges_generic_reversed_copy() {
    let values: list<i32> = [1, 2, 3, 4];
    let backwards: list<i32> = reversed(values);
    verify(backwards.len() == 4);
    verify(backwards[0] == 4 && backwards[1] == 3);
    verify(backwards[2] == 2 && backwards[3] == 1);
    verify(values[0] == 1 && values[3] == 4);

    let empty: list<str8> = [];
    let empty_reversed: list<str8> = reversed(empty);
    verify(empty_reversed.len() == 0);
}

#[test]
fn test_algorithm_ranges_generic_rotate_left_copy() {
    let values: list<i32> = [1, 2, 3, 4];
    let left: list<i32> = rotate_left(values, 2);
    verify(left[0] == 3 && left[1] == 4 && left[2] == 1 && left[3] == 2);

    let right: list<i32> = rotate_left(values, -1);
    verify(right[0] == 4 && right[1] == 1 && right[2] == 2 && right[3] == 3);

    let unchanged: list<i32> = rotate_left(values, 8);
    verify(unchanged[0] == 1 && unchanged[3] == 4);
    let empty: list<i32> = [];
    let empty_rotated: list<i32> = rotate_left(empty, 1);
    verify(empty_rotated.len() == 0);
}

#[test]
fn test_algorithm_ranges_generic_chunked() {
    let data: list<i32> = [1, 2, 3, 4, 5];
    let groups: list<list<i32>> = chunked(data, 2);
    verify(groups.len() == 3);
    let first: list<i32> = groups[0];
    let second: list<i32> = groups[1];
    let final: list<i32> = groups[2];
    verify(first.len() == 2 && first[0] == 1 && first[1] == 2);
    verify(second.len() == 2 && second[0] == 3 && second[1] == 4);
    verify(final.len() == 1 && final[0] == 5);
    let invalid_size: list<list<i32>> = chunked(data, 0);
    let large_size: list<list<i32>> = chunked(data, 9);
    verify(invalid_size.len() == 0);
    verify(large_size.len() == 1);
}

#[test]
fn test_algorithm_ranges_generic_windows() {
    let data: list<i32> = [2, 4, 6, 8];
    let result: list<list<i32>> = windows(data, 3);
    verify(result.len() == 2);
    let first: list<i32> = result[0];
    let second: list<i32> = result[1];
    verify(first.len() == 3 && first[0] == 2 && first[2] == 6);
    verify(second.len() == 3 && second[0] == 4 && second[2] == 8);
    let zero: list<list<i32>> = windows(data, 0);
    let too_wide: list<list<i32>> = windows(data, 5);
    verify(zero.len() == 0 && too_wide.len() == 0);
}

#[test]
fn test_algorithm_ranges_generic_strided() {
    let data: list<i32> = [10, 20, 30, 40, 50];
    let result: list<i32> = strided(data, 2);
    verify(result.len() == 3);
    verify(result[0] == 10 && result[1] == 30 && result[2] == 50);
    let invalid: list<i32> = strided(data, 0);
    verify(invalid.len() == 0);
    let words: list<str8> = ["a", "b", "c"];
    let selected: list<str8> = strided(words, 2);
    verify(selected.len() == 2 && selected[0] == "a" && selected[1] == "c");
}

#[test]
fn test_algorithm_ranges_generic_joined() {
    let nested: list<list<i32>> = [[1, 2], [], [3], [4, 5]];
    let flattened: list<i32> = joined(nested);
    verify(flattened.len() == 5);
    verify(flattened[0] == 1 && flattened[1] == 2);
    verify(flattened[2] == 3 && flattened[3] == 4 && flattened[4] == 5);
    let no_lists: list<list<i32>> = [];
    let empty_flattened: list<i32> = joined(no_lists);
    verify(empty_flattened.len() == 0);
}

#[test]
fn test_algorithm_ranges_generic_joined_with() {
    let nested: list<list<i32>> = [[1, 2], [], [3], [4, 5]];
    let separator: list<i32> = [0, 0];
    let flattened: list<i32> = joined_with(nested, separator);
    verify(flattened.len() == 11);
    verify(flattened[0] == 1 && flattened[1] == 2);
    verify(flattened[2] == 0 && flattened[3] == 0);
    verify(flattened[4] == 0 && flattened[5] == 0);
    verify(flattened[6] == 3 && flattened[7] == 0);
    verify(flattened[8] == 0 && flattened[9] == 4 && flattened[10] == 5);
    verify(nested[0][0] == 1 && nested[3][1] == 5);

    let no_lists: list<list<i32>> = [];
    let no_flattened: list<i32> = joined_with(no_lists, separator);
    verify(no_flattened.len() == 0);
    let one_list: list<list<i32>> = [[7]];
    let single: list<i32> = joined_with(one_list, separator);
    verify(single.len() == 1 && single[0] == 7);
    let empty_separator: list<i32> = [];
    let without_separator: list<i32> = joined_with(nested, empty_separator);
    verify(without_separator.len() == 5);
    verify(without_separator[2] == 3 && without_separator[4] == 5);
}

#[test]
fn test_algorithm_ranges_generic_split() {
    let values: list<i32> = [1, 0, 0, 2, 0];
    let delimiter: list<i64> = [0];
    let fields: list<list<i32>> = split(values, delimiter);
    verify(fields.len() == 4);
    let field0: list<i32> = fields[0];
    let field1: list<i32> = fields[1];
    let field2: list<i32> = fields[2];
    let field3: list<i32> = fields[3];
    verify(field0.len() == 1 && field0[0] == 1);
    verify(field1.len() == 0);
    verify(field2.len() == 1 && field2[0] == 2);
    verify(field3.len() == 0);

    let pair_delimiter: list<i32> = [0, 0];
    let pair_split: list<list<i32>> = split(values, pair_delimiter);
    verify(pair_split.len() == 2);
    let pair0: list<i32> = pair_split[0];
    let pair1: list<i32> = pair_split[1];
    verify(pair0.len() == 1 && pair0[0] == 1);
    verify(pair1.len() == 2);
    verify(pair1[0] == 2 && pair1[1] == 0);

    let leading: list<i32> = [0, 7];
    let leading_split: list<list<i32>> = split(leading, delimiter);
    let leading0: list<i32> = leading_split[0];
    let leading1: list<i32> = leading_split[1];
    verify(leading_split.len() == 2 && leading0.len() == 0);
    verify(leading1.len() == 1 && leading1[0] == 7);

    let empty: list<i32> = [];
    let no_fields: list<list<i32>> = split(empty, delimiter);
    verify(no_fields.len() == 0);
    let empty_delimiter: list<i32> = [];
    let unsplit: list<list<i32>> = split(values, empty_delimiter);
    let single_field: list<i32> = unsplit[0];
    verify(unsplit.len() == 1 && single_field.len() == values.len());
    verify(single_field[0] == 1 && single_field[4] == 0);
    verify(values[0] == 1 && values[4] == 0);
}

#[test]
fn test_algorithm_ranges_generic_concat() {
    let left: list<i32> = [1, 2];
    let right: list<i32> = [3, 4, 5];
    let result: list<i32> = concat(left, right);
    verify(result.len() == 5);
    verify(result[0] == 1 && result[1] == 2);
    verify(result[2] == 3 && result[4] == 5);
    let empty: list<i32> = [];
    let one_side: list<i32> = concat(empty, right);
    verify(one_side.len() == 3 && one_side[0] == 3);
}

#[test]
fn test_algorithm_ranges_zip() {
    let numbers: list<i32> = [4, 5, 6];
    let words: list<str8> = ["four", "five"];
    let pairs: list<tuple<i32, str8>> = zip(numbers, words);
    verify(pairs.len() == 2);

    let first: tuple<i32, str8> = pairs[0];
    let second: tuple<i32, str8> = pairs[1];
    verify(first.0 == 4);
    verify(second.0 == 5);
    verify(numbers.len() == 3 && words.len() == 2);

    let offsets: list<i32> = [40, 50];
    let numeric_pairs: list<tuple<i32, i32>> = zip(numbers, offsets);
    let numeric_pair = numeric_pairs[1];
    verify(numeric_pair.0 == 5 && numeric_pair.1 == 50);

    let empty: list<i32> = [];
    let no_pairs: list<tuple<i32, str8>> = zip(empty, words);
    verify(no_pairs.len() == 0);
}

#[test]
fn test_algorithm_ranges_zip_three_ranges() {
    let numbers: list<i32> = [1, 2, 3];
    let wide_numbers: list<i64> = [10, 20];
    let flags: list<bool> = [true, false, true, false];
    let triples: list<tuple<i32, i64, bool>> = zip(numbers, wide_numbers, flags);
    verify(triples.len() == 2);
    let first: tuple<i32, i64, bool> = triples[0];
    let second: tuple<i32, i64, bool> = triples[1];
    verify(first.0 == 1 && first.1 == 10 && first.2);
    verify(second.0 == 2 && second.1 == 20 && !second.2);
    verify(numbers.len() == 3 && wide_numbers.len() == 2 && flags.len() == 4);

    let empty: list<i32> = [];
    let no_triples: list<tuple<i32, i64, bool>> = zip(empty, wide_numbers, flags);
    verify(no_triples.len() == 0);
}

#[test]
fn test_algorithm_ranges_enumerate() {
    let values: list<i32> = [7, 3, 9];
    let indexed: list<tuple<i64, i32>> = enumerate(values);
    verify(indexed.len() == 3);
    let first = indexed[0];
    let middle = indexed[1];
    let last = indexed[2];
    verify(first.0 == 0 && first.1 == 7);
    verify(middle.0 == 1 && middle.1 == 3);
    verify(last.0 == 2 && last.1 == 9);
    verify(values[0] == 7 && values[2] == 9);

    let empty: list<i32> = [];
    let no_items: list<tuple<i64, i32>> = enumerate(empty);
    verify(no_items.len() == 0);
}

#[test]
fn test_algorithm_ranges_cartesian_product() {
    let left: list<i32> = [2, 4];
    let right: list<i32> = [7, 9, 11];
    let pairs: list<tuple<i32, i32>> = cartesian_product(left, right);
    verify(pairs.len() == 6);

    let first = pairs[0];
    let second = pairs[1];
    let third = pairs[2];
    let fourth = pairs[3];
    let last = pairs[5];
    verify(first.0 == 2 && first.1 == 7);
    verify(second.0 == 2 && second.1 == 9);
    verify(third.0 == 2 && third.1 == 11);
    verify(fourth.0 == 4 && fourth.1 == 7);
    verify(last.0 == 4 && last.1 == 11);

    let empty: list<i32> = [];
    let no_pairs: list<tuple<i32, i32>> = cartesian_product(left, empty);
    verify(no_pairs.len() == 0);
}

#[test]
fn test_algorithm_ranges_tuple_keys_and_values() {
    let numbers: list<i32> = [4, 8, 15];
    let offsets: list<i64> = [40, 80, 150];
    let pairs: list<tuple<i32, i64>> = zip(numbers, offsets);

    let selected_keys: list<i32> = keys(pairs);
    let selected_values: list<i64> = values(pairs);
    verify(selected_keys.len() == 3 && selected_keys[0] == 4);
    verify(selected_keys[1] == 8 && selected_keys[2] == 15);
    verify(selected_values.len() == 3);
    verify(selected_values[0] == 40 && selected_values[2] == 150);
    let original_pair: tuple<i32, i64> = pairs[1];
    verify(original_pair.0 == 8 && original_pair.1 == 80);

    let words: list<str8> = ["four", "eight"];
    let word_pairs: list<tuple<i32, str8>> = zip(numbers, words);
    let projected_words: list<str8> = values(word_pairs);
    verify(eq(projected_words[0], "four") == 1);
    verify(eq(projected_words[1], "eight") == 1);

    let empty_pairs: list<tuple<i32, i64>> = [];
    let no_keys: list<i32> = keys(empty_pairs);
    let no_values: list<i64> = values(empty_pairs);
    verify(no_keys.len() == 0 && no_values.len() == 0);
}

#[test]
fn test_algorithm_ranges_pairwise() {
    let values: list<i32> = [4, 6, 9];
    let pairs: list<tuple<i32, i32>> = pairwise(values);
    verify(pairs.len() == 2);
    let first = pairs[0];
    let second = pairs[1];
    verify(first.0 == 4 && first.1 == 6);
    verify(second.0 == 6 && second.1 == 9);

    let singleton: list<i32> = [7];
    let no_pairs: list<tuple<i32, i32>> = pairwise(singleton);
    verify(no_pairs.len() == 0);

    let sum_as_double = |left: i32, right: i32| {
        return f64(left + right);
    };
    let adjacent_sums: list<f64> = adjacent_transform(values, sum_as_double);
    verify(adjacent_sums.len() == 2);
    verify(adjacent_sums[0] == 10.0 && adjacent_sums[1] == 15.0);
}

#[test]
fn test_algorithm_ranges_generic_replace() {
    let values: list<i32> = [1, 2, 2, 3, 2];
    let updated: list<i32> = replace(values, 2, 9);
    verify(updated.len() == 5);
    verify(updated[0] == 1 && updated[1] == 9 && updated[2] == 9);
    verify(updated[3] == 3 && updated[4] == 9);
    verify(values[1] == 2 && values[4] == 2);
    let words: list<str8> = ["red", "blue", "red"];
    let renamed: list<str8> = replace(words, "red", "green");
    verify(renamed[0] == "green" && renamed[1] == "blue");
}

#[test]
fn test_algorithm_ranges_copy_remove_replace_copy() {
    let values: list<i32> = [1, 2, 3, 2, 4];
    let is_even = |value: i32| { return value % 2 == 0; };

    let selected: list<i32> = copy_if(values, is_even);
    verify(selected.len() == 3);
    verify(selected[0] == 2 && selected[1] == 2 && selected[2] == 4);

    let without_two: list<i32> = remove_copy(values, 2);
    verify(without_two.len() == 3);
    verify(without_two[0] == 1 && without_two[1] == 3 && without_two[2] == 4);

    let without_evens: list<i32> = remove_copy_if(values, is_even);
    verify(without_evens.len() == 2);
    verify(without_evens[0] == 1 && without_evens[1] == 3);

    let replaced: list<i32> = replace_copy(values, 2, 9);
    verify(replaced.len() == 5);
    verify(replaced[0] == 1 && replaced[1] == 9 && replaced[2] == 3);
    verify(replaced[3] == 9 && replaced[4] == 4);

    let replaced_evens: list<i32> = replace_copy_if(values, is_even, 0);
    verify(replaced_evens.len() == 5);
    verify(replaced_evens[0] == 1 && replaced_evens[1] == 0);
    verify(replaced_evens[2] == 3 && replaced_evens[3] == 0);
    verify(replaced_evens[4] == 0);
    verify(values[0] == 1 && values[1] == 2 && values[4] == 4);

    let empty: list<i32> = [];
    let empty_selected: list<i32> = copy_if(empty, is_even);
    let empty_without_value: list<i32> = remove_copy(empty, 2);
    let empty_without_predicate: list<i32> = remove_copy_if(empty, is_even);
    let empty_replaced: list<i32> = replace_copy(empty, 2, 9);
    let empty_replaced_if: list<i32> = replace_copy_if(empty, is_even, 0);
    verify(empty_selected.len() == 0);
    verify(empty_without_value.len() == 0);
    verify(empty_without_predicate.len() == 0);
    verify(empty_replaced.len() == 0);
    verify(empty_replaced_if.len() == 0);
}


#[test]
fn test_algorithm_ranges_predicate_queries() {
    let flags: list<bool> = [true, true, false];
    let all_flags: bool = all_of(flags);
    let any_flags: bool = any_of(flags);
    let no_flags: bool = none_of(flags);
    let empty: list<bool> = [];
    let empty_all: bool = all_of(empty);
    let empty_any: bool = any_of(empty);
    let empty_none: bool = none_of(empty);
    verify(!all_flags && any_flags && !no_flags);
    verify(empty_all && !empty_any && empty_none);
}

#[test]
fn test_algorithm_ranges_generic_element_extrema() {
    let values: list<i32> = [8, -3, 11, 11, 4];
    let empty: list<i32> = [];
    verify(min_element_index(values) == 1);
    verify(max_element_index(values) == 2);
    verify(min_element_index(empty) == -1);
    verify(max_element_index(empty) == -1);
    let extrema: tuple<i64, i64> = minmax_element_index(values);
    let no_extrema: tuple<i64, i64> = minmax_element_index(empty);
    verify(extrema.0 == 1 && extrema.1 == 3);
    verify(no_extrema.0 == -1 && no_extrema.1 == -1);
}

#[test]
fn test_algorithm_ranges_generic_element_values() {
    let values: list<i32> = [8, -3, 11, 11, 4];
    verify(min_element_value(values) == -3);
    verify(max_element_value(values) == 11);
    let words: list<str8> = ["pear", "apple", "plum"];
    verify(min_element_value(words) == "apple");
    verify(max_element_value(words) == "plum");
}

#[test]
fn test_algorithm_ranges_comparator_element_extrema() {
    let values: list<i32> = [22, 11, 21, 12, 3];
    let empty: list<i32> = [];
    let by_tens = |a: i32, b: i32| { return a / 10 < b / 10; };
    verify(min_element_index_by(values, by_tens) == 4);
    verify(max_element_index_by(values, by_tens) == 0);
    verify(min_element_value_by(values, by_tens) == 3);
    verify(max_element_value_by(values, by_tens) == 22);
    verify(min_element_index_by(empty, by_tens) == -1);
    verify(max_element_index_by(empty, by_tens) == -1);
    let by_tens_extrema: tuple<i64, i64> =
        minmax_element_index_by(values, by_tens);
    verify(by_tens_extrema.0 == 4 && by_tens_extrema.1 == 2);

    let tied: list<i32> = [12, 11, 19];
    verify(min_element_index_by(tied, by_tens) == 0);
    verify(max_element_index_by(tied, by_tens) == 0);
    let tied_extrema: tuple<i64, i64> =
        minmax_element_index_by(tied, by_tens);
    verify(tied_extrema.0 == 0 && tied_extrema.1 == 2);
    verify(min_element_value_by(tied, by_tens) == 12);
    verify(max_element_value_by(tied, by_tens) == 12);

    let descending = |a: i32, b: i32| { return a > b; };
    verify(min_element_index_by(values, descending) == 0);
    verify(max_element_index_by(values, descending) == 4);
}

#[test]
fn test_algorithm_ranges_generic_sequence_transforms() {
    let data: list<i32> = [5, 6, 6, 7, 8, 6];
    let removed: list<i32> = remove(data, 6);
    verify(removed.len() == 3);
    verify(removed[0] == 5 && removed[1] == 7 && removed[2] == 8);

    let prefix: list<i32> = take(data, 3);
    verify(prefix.len() == 3 && prefix[0] == 5 && prefix[2] == 6);
    let suffix: list<i32> = drop(data, 4);
    verify(suffix.len() == 2 && suffix[0] == 8 && suffix[1] == 6);
    let none_taken: list<i32> = take(data, -2);
    let all_dropped: list<i32> = drop(data, 99);
    verify(none_taken.len() == 0 && all_dropped.len() == 0);
}

#[test]
fn test_algorithm_ranges_take_drop_while() {
    let values: list<i32> = [1, 2, 3, 0, 4];
    let below_three = |value: i32| { return value < 3; };
    let prefix: list<i32> = take_while(values, below_three);
    let suffix: list<i32> = drop_while(values, below_three);
    verify(prefix.len() == 2 && prefix[0] == 1 && prefix[1] == 2);
    verify(suffix.len() == 3 && suffix[0] == 3 && suffix[1] == 0 && suffix[2] == 4);
    verify(values.len() == 5 && values[0] == 1 && values[4] == 4);

    let starts_rejected: list<i32> = [3, 1, 2];
    let empty_prefix: list<i32> = take_while(starts_rejected, below_three);
    let unchanged: list<i32> = drop_while(starts_rejected, below_three);
    verify(empty_prefix.len() == 0);
    verify(unchanged.len() == 3 && unchanged[0] == 3 && unchanged[2] == 2);

    let empty: list<i32> = [];
    let empty_prefix2: list<i32> = take_while(empty, below_three);
    let empty_suffix2: list<i32> = drop_while(empty, below_three);
    verify(empty_prefix2.len() == 0 && empty_suffix2.len() == 0);
}

#[test]
fn test_algorithm_ranges_transform_changes_element_type() {
    let values: list<i32> = [1, 3, 2];
    let to_double = |value: i32| { return f64(value); };
    let converted: list<f64> = transform(values, to_double);
    verify(converted.len() == 3);
    verify(converted[0] == 1.0 && converted[1] == 3.0 && converted[2] == 2.0);

    let add_one = |value: i32| { return value + 1; };
    let incremented: list<i32> = transform(values, add_one);
    verify(incremented.len() == 3);
    verify(incremented[0] == 2 && incremented[1] == 4 && incremented[2] == 3);
}

#[test]
fn test_algorithm_ranges_zip_transform() {
    let counts: list<i32> = [10, 20, 30];
    let offsets: list<f64> = [0.5, 1.5];
    let combine = |count: i32, offset: f64| {
        return f64(count) + offset;
    };
    let combined: list<f64> = zip_transform(counts, offsets, combine);
    verify(combined.len() == 2);
    verify(combined[0] == 10.5 && combined[1] == 21.5);
}

#[test]
fn test_algorithm_ranges_zip_transform_three_inputs() {
    let first: list<i32> = [1, 2, 3];
    let second: list<i64> = [10, 20];
    let third: list<i32> = [100, 200, 300, 400];
    let sum_three = |a: i32, b: i64, c: i32| { return a + i32(b) + c; };
    let sums: list<i32> = zip_transform(first, second, third, sum_three);
    verify(sums.len() == 2);
    verify(sums[0] == 111 && sums[1] == 222);
    verify(first.len() == 3 && second.len() == 2 && third.len() == 4);

    let empty: list<i32> = [];
    let no_sums: list<i32> = zip_transform(first, second, empty, sum_three);
    verify(no_sums.len() == 0);
}

#[test]
fn test_algorithm_ranges_chunk_by() {
    let values: list<i32> = [1, 2, 5, 6, 7, 10];
    let consecutive = |left: i32, right: i32| { return right == left + 1; };
    let groups: list<list<i32>> = chunk_by(values, consecutive);
    verify(groups.len() == 3);
    let first_group: list<i32> = groups[0];
    let middle_group: list<i32> = groups[1];
    let last_group: list<i32> = groups[2];
    verify(first_group.len() == 2 && first_group[0] == 1 && first_group[1] == 2);
    verify(middle_group.len() == 3 && middle_group[0] == 5 && middle_group[2] == 7);
    verify(last_group.len() == 1 && last_group[0] == 10);

    let empty: list<i32> = [];
    let no_groups: list<list<i32>> = chunk_by(empty, consecutive);
    verify(no_groups.len() == 0);
}

#[test]
fn test_algorithm_ranges_iota() {
    let values: list<i64> = iota(-2, 3);
    verify(values.len() == 5);
    verify(values[0] == -2 && values[1] == -1 && values[2] == 0);
    verify(values[3] == 1 && values[4] == 2);

    let empty: list<i64> = iota(4, 4);
    let reversed: list<i64> = iota(5, 1);
    verify(empty.len() == 0 && reversed.len() == 0);

    let stepped: list<i64> = iota_by(1, 10, 3);
    verify(stepped.len() == 3);
    verify(stepped[0] == 1 && stepped[1] == 4 && stepped[2] == 7);

    let descending: list<i64> = iota_by(9, 0, -2);
    verify(descending.len() == 5);
    verify(descending[0] == 9 && descending[1] == 7 &&
           descending[2] == 5 && descending[3] == 3 && descending[4] == 1);

    let zero_step: list<i64> = iota_by(1, 10, 0);
    let wrong_direction: list<i64> = iota_by(1, 10, -1);
    verify(zero_step.len() == 0 && wrong_direction.len() == 0);

    let near_max: list<i64> = iota_by(9223372036854775806,
                                      9223372036854775807, 4);
    verify(near_max.len() == 1 && near_max[0] == 9223372036854775806);

}

#[test]
fn test_algorithm_ranges_repeat_len() {
    let seven: i32 = 7;
    let repeated: list<i32> = repeat_range(seven, 4);
    verify(repeated.len() == 4);
}

