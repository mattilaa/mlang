#[test]
fn test_algorithm_ranges_subrange_search_by_edges() {
    let data: list<i32> = [11, 22, 23, 34, 21, 29];
    let absent: list<i32> = [45, 44];
    let too_long: list<i32> = [11, 22, 23, 34, 21, 29, 30];
    let empty: list<i32> = [];
    let by_tens = |a: i32, b: i32| { return a / 10 == b / 10; };
    verify(search_by(data, absent, by_tens) == -1);
    verify(find_end_by(data, absent, by_tens) == -1);
    verify(search_by(data, too_long, by_tens) == -1);
    verify(search_by(data, empty, by_tens) == 0);
    verify(find_end_by(data, empty, by_tens) == data.len());
}

#[test]
fn test_algorithm_ranges_contains_subrange_by() {
    let values: list<i32> = [11, 22, 34, 45, 58];
    let matching: list<i32> = [29, 38];
    let absent: list<i32> = [19, 39];
    let empty: list<i32> = [];
    let same_decade = |value: i32, candidate: i32| {
        return value / 10 == candidate / 10;
    };

    verify(contains_subrange_by(values, matching, same_decade));
    verify(!contains_subrange_by(values, absent, same_decade));
    verify(contains_subrange_by(values, empty, same_decade));
    verify(contains_subrange_by(empty, empty, same_decade));
}

#[test]
fn test_algorithm_ranges_subrange_search_by_projected() {
    let data: list<i32> = [11, 22, 23, 34, 21, 29];
    let pattern: list<i64> = [20, 29];
    let absent: list<i64> = [45, 44];
    let too_long: list<i64> = [11, 22, 23, 34, 21, 29, 30];
    let empty: list<i64> = [];
    let identity = |value: i32| { return value; };
    let narrow = |value: i64| { return i32(value); };
    let same_decade = |left: i32, right: i32| {
        return left / 10 == right / 10;
    };

    verify(search_by_projected(data, pattern, same_decade,
                               identity, narrow) == 1);
    verify(find_end_by_projected(data, pattern, same_decade,
                                 identity, narrow) == 4);
    verify(contains_subrange_by_projected(
        data, pattern, same_decade, identity, narrow));
    verify(search_by_projected(data, absent, same_decade,
                               identity, narrow) == -1);
    verify(find_end_by_projected(data, too_long, same_decade,
                                 identity, narrow) == -1);
    verify(!contains_subrange_by_projected(
        data, absent, same_decade, identity, narrow));
    verify(search_by_projected(data, empty, same_decade,
                               identity, narrow) == 0);
    verify(find_end_by_projected(data, empty, same_decade,
                                 identity, narrow) == data.len());
    verify(contains_subrange_by_projected(
        empty, empty, same_decade, identity, narrow));
    verify(data[0] == 11 && data[5] == 29);
}

