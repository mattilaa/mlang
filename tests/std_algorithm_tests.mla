}

#[test]
fn test_algorithm_ranges_generic_search_subrange() {
    let values: list<i32> = [4, 7, 4, 7, 9];
    let pattern: list<i32> = [4, 7];
    let mixed_pattern: list<i64> = [7, 9];
    let later: list<i32> = [7, 9];
    let absent: list<i32> = [9, 7];
    let too_long: list<i32> = [4, 7, 4, 7, 9, 10];
    let empty: list<i32> = [];

    verify(search(values, pattern) == 0);
    verify(search(values, later) == 3);
    verify(search(values, mixed_pattern) == 3);
    verify(search(values, absent) == -1);
    verify(search(values, too_long) == -1);
    verify(search(values, empty) == 0);
    verify(contains_subrange(values, later));
    verify(contains_subrange(values, absent) == false);
    verify(contains_subrange(values, empty));
}

#[test]
fn test_algorithm_ranges_generic_find_end() {
    let data: list<i32> = [1, 2, 1, 2, 1];
    let pattern: list<i64> = [1, 2, 1];
    let missing: list<i32> = [2, 2];
    let empty: list<i32> = [];
    verify(find_end(data, pattern) == 2);
    verify(find_end(data, missing) == -1);
    verify(find_end(data, empty) == 5);
}

#[test]
fn test_algorithm_ranges_projected_pattern_search() {
    let data: list<i32> = [11, 22, 19, 28, 31, 14, 26];
    let pattern: list<i32> = [15, 29];
    let one_key: list<i32> = [18];
    let absent: list<i32> = [18, 49];
    let empty: list<i32> = [];
    let project_tens = |value: i32| { return value / 10; };

    verify(search_projected(data, pattern, project_tens, project_tens) == 0);
    verify(find_end_projected(data, pattern, project_tens, project_tens) == 5);
    verify(contains_subrange_projected(
        data, pattern, project_tens, project_tens));
    verify(find_end_projected(data, one_key, project_tens, project_tens) == 5);
    verify(search_projected(data, absent, project_tens, project_tens) == -1);
    verify(!contains_subrange_projected(
        data, absent, project_tens, project_tens));
    verify(search_projected(data, empty, project_tens, project_tens) == 0);
    verify(find_end_projected(data, empty, project_tens, project_tens) == 7);
    verify(contains_subrange_projected(
        empty, empty, project_tens, project_tens));
}

