#[test]
fn test_algorithm_ranges_find_first_of_by_heterogeneous_predicate() {
    let values: list<i32> = [11, 22, 23, 34];
    let candidates: list<i64> = [19, 20];
    let absent: list<i64> = [49, 58];
    let empty: list<i64> = [];
