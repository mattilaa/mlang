#[test]
fn test_algorithm_ranges_find_count_contains_remove_take_drop() {
    let data: list<i64> = [5, 6, 6, 7, 8, 6];
    verify(find_i64(data, 6) == 1);
    verify(find_i64(data, 42) == -1);
    verify(count_i64(data, 6) == 3);
    verify(contains_i64(data, 8) == 1);
    verify(contains_i64(data, 9) == 0);

    let removed: list<i64> = remove_i64(data, 6);
    verify(removed.len() == 3);
    verify(removed[0] == 5 && removed[1] == 7 && removed[2] == 8);

    let take3: list<i64> = take_i64(data, 3);
    verify(take3.len() == 3 && take3[0] == 5 && take3[1] == 6 && take3[2] == 6);

    let drop4: list<i64> = drop_i64(data, 4);
    verify(drop4.len() == 2 && drop4[0] == 8 && drop4[1] == 6);

    let last_three: list<i64> = take_last(data, 3);
    verify(last_three.len() == 3 && last_three[0] == 7 &&
           last_three[2] == 6);
    let without_last_two: list<i64> = drop_last(data, 2);
    verify(without_last_two.len() == 4 && without_last_two[0] == 5 &&
           without_last_two[3] == 7);
    let all_tail: list<i64> = take_last(data, 99);
    let none_left: list<i64> = drop_last(data, 99);
    let no_tail: list<i64> = take_last(data, 0);
    let all_kept: list<i64> = drop_last(data, -2);
    verify(all_tail.len() == 6 && none_left.len() == 0 && no_tail.len() == 0);
    verify(all_kept.len() == 6 && all_kept[5] == 6);

    let middle: list<i64> = subrange(data, 1, 4);
    verify(middle.len() == 3 && middle[0] == 6 && middle[2] == 7);
    let clamped: list<i64> = subrange(data, -3, 99);
    verify(clamped.len() == 6 && clamped[0] == 5 && clamped[5] == 6);
    let reversed_bounds: list<i64> = subrange(data, 5, 2);
    let after_end: list<i64> = subrange(data, 99, 120);
    verify(reversed_bounds.len() == 0 && after_end.len() == 0);
}

#[test]
fn test_algorithm_ranges_projected_lookup() {
    let values: list<i32> = [13, 14, 27, 31, 19];
    let project_tens = |value: i32| { return value / 10; };
    verify(find_projected(values, 2, project_tens) == 2);
    verify(find_projected(values, 9, project_tens) == -1);
    verify(count_projected(values, 1, project_tens) == 3);
    verify(contains_projected(values, 3, project_tens));
    verify(!contains_projected(values, 4, project_tens));
}

#[test]
fn test_algorithm_ranges_clamp() {
    let data: list<i64> = [-5, 0, 3, 10, 15, 100];
    let clamped: list<i64> = clamp_i64(data, 0, 10);
    verify(clamped.len() == 6);
    verify(clamped[0] == 0);
    verify(clamped[1] == 0);
    verify(clamped[2] == 3);
    verify(clamped[3] == 10);
    verify(clamped[4] == 10);
    verify(clamped[5] == 10);

    let empty: list<i64> = [];
    let ce: list<i64> = clamp_i64(empty, 0, 5);
    verify(ce.len() == 0);

    let single: list<i64> = [42];
