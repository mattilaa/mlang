    verify(search_n(empty, 0, 0) == 0);
}

#[test]
fn test_algorithm_ranges_search_n_projected() {
    let values: list<i32> = [11, 12, 21, 22, 23, 31];
    let project_tens = |value: i32| { return value / 10; };
    verify(search_n_projected(values, 3, 2, project_tens) == 2);
    verify(search_n_projected(values, 4, 2, project_tens) == -1);
    verify(search_n_projected(values, 1, 3, project_tens) == 5);
    verify(search_n_projected(values, 0, 9, project_tens) == 0);
    verify(search_n_projected(values, -2, 9, project_tens) == 0);
    let empty: list<i32> = [];
    verify(search_n_projected(empty, 1, 1, project_tens) == -1);
    verify(search_n_projected(empty, 0, 1, project_tens) == 0);
}

#[test]
fn test_algorithm_ranges_search_n_by_projected() {
    let values: list<i32> = [11, 12, 19, 21, 22, 23, 34];
    let empty: list<i32> = [];
    let project_tens = |value: i32| { return value / 10; };
    let same_key = |key: i32, value: i32| { return key == value; };
    verify(search_n_by_projected(
        values, 3, 2, same_key, project_tens) == 3);
    verify(search_n_by_projected(
        values, 4, 2, same_key, project_tens) == -1);
    verify(search_n_by_projected(
        values, 1, 3, same_key, project_tens) == 6);
    verify(search_n_by_projected(
        values, 0, 9, same_key, project_tens) == 0);
    verify(search_n_by_projected(
        values, -2, 9, same_key, project_tens) == 0);
    verify(search_n_by_projected(
        empty, 1, 1, same_key, project_tens) == -1);
    verify(values[0] == 11 && values[6] == 34);
}

#[test]
fn test_algorithm_ranges_generic_ends_with() {
    let values: list<i32> = [3, 5, 8, 13];
    let suffix: list<i32> = [8, 13];
    let mismatch: list<i32> = [8, 12];
    let too_long: list<i32> = [1, 3, 5, 8, 13];
    let empty: list<i32> = [];

    verify(ends_with(values, suffix));
    verify(ends_with(values, mismatch) == false);
    verify(ends_with(values, too_long) == false);
    verify(ends_with(values, empty));
    let mixed_suffix: list<i64> = [8, 13];
    verify(ends_with(values, mixed_suffix));
}

#[test]
fn test_algorithm_ranges_starts_ends_with_by_predicate() {
    let values: list<i32> = [21, 25, 31, 38];
    let same_decade = |left: i32, right: i32| {
        return left / 10 == right / 10;
    };
    let prefix: list<i32> = [29, 20];
    let wrong_prefix: list<i32> = [17];
    let suffix: list<i32> = [30, 39];
    let wrong_suffix: list<i32> = [30, 49];
    let too_long: list<i32> = [10, 20, 30, 40, 50];
    let empty: list<i32> = [];

    verify(starts_with_by(values, prefix, same_decade));
    verify(!starts_with_by(values, wrong_prefix, same_decade));
    verify(!starts_with_by(values, too_long, same_decade));
    verify(starts_with_by(values, empty, same_decade));

    verify(ends_with_by(values, suffix, same_decade));
    verify(!ends_with_by(values, wrong_suffix, same_decade));
    verify(!ends_with_by(values, too_long, same_decade));
    verify(ends_with_by(values, empty, same_decade));
}

#[test]
fn test_algorithm_ranges_predicate_searches_by_projected() {
    let identity = |value: i32| { return value; };
    let narrow = |value: i64| { return i32(value); };
    let same_decade = |left: i32, right: i32| {
        return left / 10 == right / 10;
    };

    let adjacent: list<i32> = [11, 19, 22, 29];
    let separated: list<i32> = [11, 22, 31];
    let one: list<i32> = [12];
    let empty: list<i32> = [];
    verify(adjacent_find_by_projected(
        adjacent, same_decade, identity) == 0);
    verify(adjacent_find_by_projected(
        separated, same_decade, identity) == -1);
    verify(adjacent_find_by_projected(one, same_decade, identity) == -1);
    verify(adjacent_find_by_projected(empty, same_decade, identity) == -1);

    let values: list<i32> = [11, 22, 23, 34];
    let candidates: list<i64> = [29, 20];
    let absent: list<i64> = [49, 58];
    let none: list<i64> = [];
    verify(find_first_of_by_projected(
        values, candidates, same_decade, identity, narrow) == 1);
    verify(find_first_of_by_projected(
        values, absent, same_decade, identity, narrow) == -1);
    verify(find_first_of_by_projected(
        values, none, same_decade, identity, narrow) == -1);

    let sequence: list<i32> = [21, 25, 31, 38];
    let prefix: list<i64> = [29, 20];
    let wrong_prefix: list<i64> = [17];
    let suffix: list<i64> = [30, 39];
    let wrong_suffix: list<i64> = [30, 49];
    let too_long: list<i64> = [10, 20, 30, 40, 50];
    verify(starts_with_by_projected(
        sequence, prefix, same_decade, identity, narrow));
    verify(!starts_with_by_projected(
        sequence, wrong_prefix, same_decade, identity, narrow));
    verify(!starts_with_by_projected(
        sequence, too_long, same_decade, identity, narrow));
    verify(starts_with_by_projected(
        sequence, none, same_decade, identity, narrow));
    verify(ends_with_by_projected(
        sequence, suffix, same_decade, identity, narrow));
    verify(!ends_with_by_projected(
        sequence, wrong_suffix, same_decade, identity, narrow));
    verify(!ends_with_by_projected(
        sequence, too_long, same_decade, identity, narrow));
    verify(ends_with_by_projected(
        sequence, none, same_decade, identity, narrow));
}

#[test]
fn test_algorithm_ranges_generic_lexicographical_compare() {
    let first: list<i32> = [1, 2, 9];
    let before: list<i32> = [1, 3];
    let after: list<i32> = [1, 2, 9, 0];
    let equal_values: list<i32> = [1, 2, 9];
    let empty: list<i32> = [];

    verify(lexicographical_compare(first, before));
    verify(lexicographical_compare(first, after));
    verify(lexicographical_compare(first, equal_values) == false);
    verify(lexicographical_compare(empty, first));
    verify(lexicographical_compare(first, empty) == false);
    let mixed: list<i64> = [1, 2, 10];
    verify(lexicographical_compare(first, mixed));
    verify(lexicographical_compare(mixed, first) == false);
}

#[test]
fn test_algorithm_ranges_lexicographical_compare_projected() {
    let left: list<i32> = [21, 39, 52];
    let before: list<i32> = [29, 40, 50];
    let same_keys: list<i32> = [28, 31, 59];
    let extended: list<i32> = [29, 40, 50, 60];
    let project_tens = |value: i32| { return value / 10; };

    verify(lexicographical_compare_projected(
        left, before, project_tens, project_tens));
    verify(!lexicographical_compare_projected(
        before, left, project_tens, project_tens));
    verify(!lexicographical_compare_projected(
        left, same_keys, project_tens, project_tens));
    verify(lexicographical_compare_projected(
        left, extended, project_tens, project_tens));
}

#[test]
fn test_algorithm_ranges_lexicographical_compare_by() {
    let first: list<i32> = [9, 7];
    let before: list<i32> = [9, 6];
    let after: list<i32> = [9, 8];
    let extended: list<i32> = [9, 7, 3];
    let greater = |a: i32, b: i32| { return a > b; };
    verify(lexicographical_compare_by(first, before, greater));
    verify(!lexicographical_compare_by(first, after, greater));
    verify(lexicographical_compare_by(first, extended, greater));
    verify(!lexicographical_compare_by(extended, first, greater));

    let equivalent: list<i32> = [9, 7];
    verify(!lexicographical_compare_by(first, equivalent, greater));
}

#[test]
fn test_algorithm_ranges_lexicographical_compare_by_projected() {
    let left: list<i32> = [39, 11];
    let right: list<i64> = [29, 21];
    let project_left = |value: i32| { return value / 10; };
    let project_right = |value: i64| { return i32(value / 10); };
    let greater = |a: i32, b: i32| { return a > b; };
    verify(lexicographical_compare_by_projected(
        left, right, greater, project_left, project_right));
    verify(!lexicographical_compare_by_projected(
        right, left, greater, project_right, project_left));

    let prefix: list<i32> = [29];
    let extended: list<i64> = [20, 19];
    verify(lexicographical_compare_by_projected(
        prefix, extended, greater, project_left, project_right));
    verify(!lexicographical_compare_by_projected(
        extended, prefix, greater, project_right, project_left));
}

#[test]
fn test_algorithm_ranges_generic_is_sorted() {
    let sorted: list<i32> = [1, 2, 2, 9];
    let unsorted: list<i32> = [1, 4, 3, 9];
    let empty: list<i32> = [];
    let one: list<str8> = ["only"];

    verify(is_sorted(sorted));
    verify(is_sorted(unsorted) == false);
    verify(is_sorted(empty));
    verify(is_sorted(one));
}

#[test]
fn test_algorithm_ranges_generic_is_sorted_until() {
    let sorted_values: list<i32> = [1, 2, 2, 5];
    let unsorted_values: list<i32> = [1, 4, 3, 8];
    let empty: list<i32> = [];
    let one: list<i32> = [9];
    verify(is_sorted_until(sorted_values) == 4);
    verify(is_sorted_until(unsorted_values) == 2);
    verify(is_sorted_until(empty) == 0);
    verify(is_sorted_until(one) == 1);
}

#[test]
fn test_algorithm_ranges_generic_heap_queries() {
    let heap: list<i32> = [9, 7, 8, 2, 3, 1];
    let invalid: list<i32> = [9, 7, 8, 10, 2];
    let empty: list<i32> = [];
    let one: list<i32> = [4];
    verify(is_heap(heap) && is_heap_until(heap) == 6);
    verify(!is_heap(invalid) && is_heap_until(invalid) == 3);
    verify(is_heap(empty) && is_heap_until(empty) == 0);
    verify(is_heap(one) && is_heap_until(one) == 1);
}

#[test]
fn test_algorithm_ranges_comparator_heap_queries() {
    let min_heap: list<i32> = [1, 3, 2, 9, 8, 4];
    let invalid: list<i32> = [1, 5, 2, 3];
    let empty: list<i32> = [];
    let one: list<i32> = [4];
    let greater = |a: i32, b: i32| { return a > b; };
    verify(is_heap_by(min_heap, greater));
    verify(is_heap_until_by(min_heap, greater) == 6);
    verify(!is_heap_by(invalid, greater));
    verify(is_heap_until_by(invalid, greater) == 3);
    verify(is_heap_by(empty, greater));
    verify(is_heap_until_by(empty, greater) == 0);
    verify(is_heap_by(one, greater) && is_heap_until_by(one, greater) == 1);
}

#[test]
fn test_algorithm_ranges_heap_algorithms() {
    let values: list<i32> = [3, 1, 8, 4, 2];
    let heap: list<i32> = make_heap(values);
    verify(is_heap(heap) && heap[0] == 8);
    verify(values[0] == 3 && values[2] == 8);

    var appended: list<i32> = take(heap, heap.len());
    appended.push(10);
    let pushed: list<i32> = push_heap(appended);
    verify(is_heap(pushed) && pushed[0] == 10);

    let popped: list<i32> = pop_heap(pushed);
    let popped_prefix: list<i32> = take(popped, popped.len() - 1);
    verify(popped[popped.len() - 1] == 10 && is_heap(popped_prefix));
    let ordered: list<i32> = sort_heap(heap);
    verify(ordered.len() == 5 && ordered[0] == 1 && ordered[4] == 8);

    let greater = |a: i32, b: i32| { return a > b; };
    let min_heap: list<i32> = make_heap_by(values, greater);
    verify(is_heap_by(min_heap, greater) && min_heap[0] == 1);
    var min_appended: list<i32> = take(min_heap, min_heap.len());
    min_appended.push(0);
    let min_pushed: list<i32> = push_heap_by(min_appended, greater);
    verify(is_heap_by(min_pushed, greater) && min_pushed[0] == 0);
    let min_popped: list<i32> = pop_heap_by(min_pushed, greater);
    verify(min_popped[min_popped.len() - 1] == 0);
    let descending: list<i32> = sort_heap_by(min_heap, greater);
    verify(descending[0] == 8 && descending[4] == 1);

    let empty: list<i32> = [];
    let empty_heap: list<i32> = make_heap(empty);
    let empty_pushed: list<i32> = push_heap(empty);
    let empty_popped: list<i32> = pop_heap(empty);
    let empty_sorted: list<i32> = sort_heap(empty);
    verify(empty_heap.len() == 0 && empty_pushed.len() == 0);
    verify(empty_popped.len() == 0 && empty_sorted.len() == 0);
}

#[test]
fn test_algorithm_ranges_partial_sort() {
    let values: list<i32> = [9, 1, 7, 3, 6, 2];
    let smallest: list<i32> = partial_sort(values, 3);
    verify(smallest.len() == 3 && smallest[0] == 1 &&
           smallest[1] == 2 && smallest[2] == 3);
    verify(values[0] == 9 && values[1] == 1);

    let greatest = |a: i32, b: i32| { return a > b; };
    let largest: list<i32> = partial_sort_by(values, 2, greatest);
    verify(largest.len() == 2 && largest[0] == 9 && largest[1] == 7);

    let none: list<i32> = partial_sort(values, -4);
    let all: list<i32> = partial_sort(values, 100);
    verify(none.len() == 0 && all.len() == 6);
    verify(all[0] == 1 && all[5] == 9);
    let empty: list<i32> = [];
    let empty_sorted: list<i32> = partial_sort(empty, 2);
    verify(empty_sorted.len() == 0);
}

#[test]
fn test_algorithm_ranges_partial_sort_by_projection() {
    let values: list<i32> = [42, 11, 23, 31, 19, 5];
    let project_tens = |value: i32| { return value / 10; };
    let first_three: list<i32> =
        partial_sort_projected(values, 3, project_tens);
    verify(first_three.len() == 3);
    verify(first_three[0] == 5 &&
           ((first_three[1] == 11 && first_three[2] == 19) ||
            (first_three[1] == 19 && first_three[2] == 11)));

    let none: list<i32> = partial_sort_projected(values, -2, project_tens);
    let all: list<i32> = partial_sort_projected(values, 99, project_tens);
    verify(none.len() == 0 && all.len() == values.len());
    verify(is_sorted_projected(all, project_tens));
    verify(values[0] == 42 && values[5] == 5);
}

#[test]
fn test_algorithm_ranges_projected_heap_operations() {
    let values: list<i32> = [41, 12, 35, 24, 58, 17];
    let project_tens = |value: i32| { return value / 10; };
    let heap: list<i32> = make_heap_projected(values, project_tens);
    verify(is_heap_projected(heap, project_tens));
    verify(heap[0] == 58);

    let appended: list<i32> = [heap[0], heap[1], heap[2], heap[3], heap[4],
                               heap[5], 99];
    let pushed: list<i32> = push_heap_projected(appended, project_tens);
    verify(is_heap_projected(pushed, project_tens) && pushed[0] == 99);
    let popped: list<i32> = pop_heap_projected(pushed, project_tens);
    verify(popped[popped.len() - 1] == 99);
    verify(is_heap_until_projected(popped, project_tens) == popped.len() - 1);

    let ordered: list<i32> = sort_heap_projected(heap, project_tens);
    verify(is_sorted_projected(ordered, project_tens));
    verify(ordered[0] == 12 && ordered[5] == 58);
}

#[test]
fn test_algorithm_ranges_comparator_projected_heap_operations() {
    let values: list<i32> = [41, 12, 35, 24, 58, 17];
    let greater = |a: i32, b: i32| { return a > b; };
    let project_tens = |value: i32| { return value / 10; };
    let heap: list<i32> = make_heap_by_projected(values, greater,
                                                  project_tens);
    verify(is_heap_by_projected(heap, greater, project_tens));
    verify(is_heap_until_by_projected(heap, greater, project_tens) ==
           heap.len());
    verify(project_tens(heap[0]) == 1);

    var appended: list<i32> = take(heap, heap.len());
    appended.push(9);
    let pushed: list<i32> = push_heap_by_projected(appended, greater,
                                                   project_tens);
    verify(is_heap_by_projected(pushed, greater, project_tens));
    verify(pushed[0] == 9);
    let popped: list<i32> = pop_heap_by_projected(pushed, greater,
                                                  project_tens);
    verify(popped[popped.len() - 1] == 9);
    verify(is_heap_until_by_projected(popped, greater, project_tens) ==
           popped.len() - 1);

    let ordered: list<i32> = sort_heap_by_projected(heap, greater,
                                                     project_tens);
    verify(is_sorted_by_projected(ordered, greater, project_tens));
    verify(ordered[0] == 58 &&
           project_tens(ordered[ordered.len() - 1]) == 1);
}

#[test]
fn test_algorithm_ranges_partial_sort_comparator_projection() {
    let values: list<i32> = [42, 11, 23, 31, 19, 55];
    let greater = |a: i32, b: i32| { return a > b; };
    let project_tens = |value: i32| { return value / 10; };
    let largest: list<i32> = partial_sort_by_projected(
        values, 3, greater, project_tens);
    verify(largest.len() == 3 && largest[0] == 55 &&
           largest[1] == 42 && largest[2] == 31);
    verify(is_sorted_by_projected(largest, greater, project_tens));

    let copied: list<i32> = partial_sort_copy_by_projected(
        values, 2, greater, project_tens);
    verify(copied.len() == 2 && copied[0] == 55 && copied[1] == 42);
    let empty: list<i32> = partial_sort_by_projected(
        values, -1, greater, project_tens);
    verify(empty.len() == 0 && values[0] == 42);
}

#[test]
fn test_algorithm_ranges_partial_sort_copy_capacity() {
    let input: list<i32> = [8, 2, 5, 1, 7];
    let small_output: list<i32> = partial_sort_copy(input, 3);
    verify(small_output.len() == 3 && small_output[0] == 1 &&
           small_output[1] == 2 && small_output[2] == 5);

    let greatest = |a: i32, b: i32| { return a > b; };
    let largest: list<i32> = partial_sort_copy_by(input, 2, greatest);
    verify(largest.len() == 2 && largest[0] == 8 && largest[1] == 7);
    let no_output: list<i32> = partial_sort_copy(input, 0);
    let empty_input: list<i32> = [];
    let no_input: list<i32> = partial_sort_copy(empty_input, 4);
    verify(no_output.len() == 0 && no_input.len() == 0);
    verify(input[0] == 8 && input[3] == 1);
}

#[test]
fn test_algorithm_ranges_partial_sort_copy_projected() {
    let input: list<i32> = [38, 12, 56, 21, 49];
    let project_tens = |value: i32| { return value / 10; };
    let selected: list<i32> = partial_sort_copy_projected(
        input, 3, project_tens);
    verify(selected.len() == 3 && selected[0] == 12 &&
           selected[1] == 21 && selected[2] == 38);
    let all: list<i32> = partial_sort_copy_projected(
        input, 9, project_tens);
    verify(all.len() == 5 && all[0] == 12 && all[1] == 21 &&
           all[2] == 38 && all[3] == 49 && all[4] == 56);
    let none: list<i32> = partial_sort_copy_projected(
        input, -2, project_tens);
    verify(none.len() == 0 && input[0] == 38);
}

#[test]
fn test_algorithm_ranges_nth_element() {
    let values: list<i32> = [7, 2, 9, 1, 5, 3];
    let partitioned: list<i32> = nth_element(values, 2);
    verify(partitioned.len() == 6 && partitioned[2] == 3);
    for i in 0..2 { verify(partitioned[i] <= partitioned[2]); }
    for i in 3..6 { verify(partitioned[i] >= partitioned[2]); }
    verify(values[0] == 7 && values[1] == 2);

    let greater = |left: i32, right: i32| { return left > right; };
    let reverse_partition: list<i32> = nth_element_by(values, 1, greater);
    verify(reverse_partition[1] == 7);
    for i in 0..1 { verify(reverse_partition[i] >= reverse_partition[1]); }
    for i in 2..6 { verify(reverse_partition[i] <= reverse_partition[1]); }

    let invalid_low: list<i32> = nth_element(values, -1);
    let invalid_high: list<i32> = nth_element(values, 6);
    let empty: list<i32> = [];
    let invalid_empty: list<i32> = nth_element(empty, 0);
    verify(invalid_low.len() == 0 && invalid_high.len() == 0 &&
           invalid_empty.len() == 0);

    let repeated: list<i32> = [5, 1, 5, 2, 5];
    let repeated_partition: list<i32> = nth_element(repeated, 3);
    verify(repeated_partition[3] == 5);
    for i in 0..3 { verify(repeated_partition[i] <= 5); }
    verify(repeated_partition[4] >= 5);
}

#[test]
fn test_algorithm_ranges_nth_element_by_projection() {
    let values: list<i32> = [42, 11, 23, 31, 19, 5];
    let project_tens = |value: i32| { return value / 10; };
    let partitioned: list<i32> =
        nth_element_projected(values, 2, project_tens);
    let selected_key: i32 = project_tens(partitioned[2]);
    verify(partitioned.len() == values.len());
    for i in 0..2 {
        verify(project_tens(partitioned[i]) <= selected_key);
    }
    for i in 3..partitioned.len() {
        verify(project_tens(partitioned[i]) >= selected_key);
    }
    verify(values[0] == 42 && values[5] == 5);

    let invalid: list<i32> = nth_element_projected(values, 6, project_tens);
    verify(invalid.len() == 0);
}

#[test]
fn test_algorithm_ranges_nth_element_comparator_projection() {
    let values: list<i32> = [42, 11, 23, 31, 19, 5];
    let greater = |left: i32, right: i32| { return left > right; };
    let project_tens = |value: i32| { return value / 10; };
    let partitioned: list<i32> = nth_element_by_projected(
        values, 2, greater, project_tens);
    let selected_key: i32 = project_tens(partitioned[2]);
    verify(partitioned.len() == values.len() && selected_key == 2);
    for i in 0..2 {
        verify(project_tens(partitioned[i]) >= selected_key);
    }
    for i in 3..partitioned.len() {
        verify(project_tens(partitioned[i]) <= selected_key);
    }
    verify(values[0] == 42 && values[5] == 5);

    let invalid_low: list<i32> = nth_element_by_projected(
        values, -1, greater, project_tens);
    let invalid_high: list<i32> = nth_element_by_projected(
        values, values.len(), greater, project_tens);
    verify(invalid_low.len() == 0 && invalid_high.len() == 0);
}

#[test]
fn test_algorithm_ranges_generic_merged() {
    let left: list<i32> = [1, 3, 3, 8];
    let right: list<i32> = [2, 3, 7];
    let result: list<i32> = merged(left, right);
    verify(result.len() == 7);
    verify(result[0] == 1 && result[1] == 2 && result[2] == 3);
    verify(result[3] == 3 && result[4] == 3 && result[5] == 7 && result[6] == 8);
    verify(left[0] == 1 && right[0] == 2);
    let empty: list<i32> = [];
    let one_side: list<i32> = merged(empty, right);
    verify(one_side.len() == 3 && one_side[2] == 7);
}

#[test]
fn test_algorithm_ranges_inplace_merge_copy() {
    let values: list<i32> = [1, 3, 3, 2, 3, 7];
    let merged_values: list<i32> = inplace_merge(values, 3);
    verify(merged_values.len() == 6 && merged_values[0] == 1 &&
           merged_values[1] == 2 && merged_values[2] == 3 &&
           merged_values[3] == 3 && merged_values[4] == 3 &&
           merged_values[5] == 7);
    verify(values[0] == 1 && values[3] == 2);

    let reversed: list<i32> = [9, 7, 3, 8, 4, 1];
    let greater = |a: i32, b: i32| { return a > b; };
    let descending: list<i32> = inplace_merge_by(reversed, 3, greater);
    verify(descending[0] == 9 && descending[1] == 8 &&
           descending[2] == 7 && descending[3] == 4 &&
           descending[4] == 3 && descending[5] == 1);

    let sorted_values: list<i32> = [1, 2, 3];
    let negative_split: list<i32> = inplace_merge(sorted_values, -5);
    let past_end_split: list<i32> = inplace_merge(sorted_values, 99);
    verify(negative_split.len() == 3 && negative_split[0] == 1 &&
           past_end_split.len() == 3 && past_end_split[2] == 3);

    let empty: list<i32> = [];
    let empty_result: list<i32> = inplace_merge(empty, 5);
    verify(empty_result.len() == 0);
}

#[test]
fn test_algorithm_ranges_inplace_merge_projected() {
    let values: list<i32> = [11, 29, 22, 18, 31, 39];
    let project_tens = |value: i32| { return value / 10; };
    let merged_values: list<i32> = inplace_merge_projected(
        values, 3, project_tens);
    verify(merged_values.len() == 6 && merged_values[0] == 11 &&
           merged_values[1] == 18 && merged_values[2] == 29 &&
           merged_values[3] == 22 && merged_values[4] == 31 &&
           merged_values[5] == 39);
    verify(values[0] == 11 && values[1] == 29 && values[3] == 18);
}

#[test]
fn test_algorithm_ranges_generic_union_sorted() {
    let left: list<i32> = [1, 2, 2, 5];
    let right: list<i32> = [2, 3, 5, 5];
    let result: list<i32> = union_sorted(left, right);
    verify(result.len() == 6);
    verify(result[0] == 1 && result[1] == 2 && result[2] == 2);
    verify(result[3] == 3 && result[4] == 5 && result[5] == 5);
}

#[test]
fn test_algorithm_ranges_generic_intersection_sorted() {
    let left: list<i32> = [1, 2, 2, 2, 5, 7];
    let right: list<i32> = [2, 2, 3, 5, 5];
    let result: list<i32> = intersection_sorted(left, right);
    verify(result.len() == 3);
    verify(result[0] == 2 && result[1] == 2 && result[2] == 5);
    let empty: list<i32> = [];
    let none: list<i32> = intersection_sorted(left, empty);
    verify(none.len() == 0);
}

#[test]
fn test_algorithm_ranges_generic_difference_sorted() {
    let left: list<i32> = [1, 2, 2, 2, 4, 6];
    let right: list<i32> = [2, 3, 6, 6];
    let result: list<i32> = difference_sorted(left, right);
    verify(result.len() == 4);
    verify(result[0] == 1 && result[1] == 2 && result[2] == 2 && result[3] == 4);
    let empty: list<i32> = [];
    let unchanged: list<i32> = difference_sorted(left, empty);
    verify(unchanged.len() == left.len() && unchanged[2] == 2);
}

#[test]
fn test_algorithm_ranges_generic_symmetric_difference_sorted() {
    let left: list<i32> = [1, 2, 2, 2, 5];
    let right: list<i32> = [2, 2, 3, 5, 5];
    let result: list<i32> = symmetric_difference_sorted(left, right);
    verify(result.len() == 4);
    verify(result[0] == 1 && result[1] == 2 && result[2] == 3 && result[3] == 5);
    let empty: list<i32> = [];
    let unchanged: list<i32> = symmetric_difference_sorted(left, empty);
    verify(unchanged.len() == left.len() && unchanged[2] == 2);
}

#[test]
fn test_algorithm_ranges_projected_merge_and_set_operations() {
    let left: list<i32> = [11, 12, 21, 22, 41];
    let right: list<i32> = [13, 22, 23, 31, 41, 42];
    let project_tens = |value: i32| { return value / 10; };

    let merged_values: list<i32> =
        merged_projected(left, right, project_tens);
    verify(merged_values.len() == 11);
    verify(is_sorted_projected(merged_values, project_tens));
    verify(merged_values[0] == 11 && merged_values[1] == 12 &&
           merged_values[2] == 13);

    let union_values: list<i32> =
        union_sorted_projected(left, right, project_tens);
    verify(union_values.len() == 7);
    verify(is_sorted_projected(union_values, project_tens));
    verify(union_values[0] == 11 && union_values[1] == 12);

    let intersection_values: list<i32> =
        intersection_sorted_projected(left, right, project_tens);
    verify(intersection_values.len() == 4);
    verify(intersection_values[0] == 11 && intersection_values[1] == 21 &&
           intersection_values[2] == 22 && intersection_values[3] == 41);

    let difference_values: list<i32> =
        difference_sorted_projected(left, right, project_tens);
    verify(difference_values.len() == 1 && difference_values[0] == 12);

    let symmetric_values: list<i32> =
        symmetric_difference_sorted_projected(left, right, project_tens);
    verify(symmetric_values.len() == 3);
    verify(symmetric_values[0] == 12 && symmetric_values[1] == 31 &&
           symmetric_values[2] == 42);
}

#[test]
fn test_algorithm_ranges_comparator_projected_set_operations() {
    let left: list<i32> = [59, 52, 41, 28, 24];
    let right: list<i32> = [58, 53, 42, 33, 22];
    let subset: list<i32> = [59, 41, 28];
    let too_many: list<i32> = [59, 52, 51];
    let empty: list<i32> = [];
    let greater = |a: i32, b: i32| { return a > b; };
    let project_tens = |value: i32| { return value / 10; };

    verify(includes_by_projected(left, subset, greater, project_tens));
    verify(!includes_by_projected(left, too_many, greater, project_tens));
    verify(includes_by_projected(left, empty, greater, project_tens));

    let union_values: list<i32> = union_sorted_by_projected(
        left, right, greater, project_tens);
    verify(union_values.len() == 6 && union_values[0] == 59 &&
           union_values[1] == 52 && union_values[2] == 41 &&
           union_values[3] == 33 && union_values[4] == 28 &&
           union_values[5] == 24);
    verify(is_sorted_by_projected(union_values, greater, project_tens));

    let intersection_values: list<i32> = intersection_sorted_by_projected(
        left, right, greater, project_tens);
    verify(intersection_values.len() == 4 && intersection_values[0] == 59 &&
           intersection_values[1] == 52 && intersection_values[2] == 41 &&
           intersection_values[3] == 28);
    let difference_values: list<i32> = difference_sorted_by_projected(
        left, right, greater, project_tens);
    verify(difference_values.len() == 1 && difference_values[0] == 24);
    let symmetric_values: list<i32> =
        symmetric_difference_sorted_by_projected(
            left, right, greater, project_tens);
    verify(symmetric_values.len() == 2 && symmetric_values[0] == 33 &&
           symmetric_values[1] == 24);
    verify(left[0] == 59 && right[0] == 58);
}

#[test]
fn test_algorithm_ranges_generic_lower_bound() {
    let values: list<i32> = [1, 3, 3, 7, 9];
    verify(lower_bound(values, 0) == 0);
    verify(lower_bound(values, 3) == 1);
    verify(lower_bound(values, 4) == 3);
    verify(lower_bound(values, 12) == 5);

    let words: list<str8> = ["ant", "bee", "bee", "fox"];
    verify(lower_bound(words, "bee") == 1);
    verify(lower_bound(words, "cat") == 3);
}

#[test]
fn test_algorithm_ranges_generic_upper_bound() {
    let values: list<i32> = [1, 3, 3, 7, 9];
    verify(upper_bound(values, 0) == 0);
    verify(upper_bound(values, 3) == 3);
    verify(upper_bound(values, 4) == 3);
    verify(upper_bound(values, 12) == 5);

    let words: list<str8> = ["ant", "bee", "bee", "fox"];
    verify(upper_bound(words, "bee") == 3);
    verify(upper_bound(words, "cat") == 3);
}

#[test]
fn test_algorithm_ranges_generic_equal_range() {
    let values: list<i32> = [1, 3, 3, 7, 9];
    let threes: tuple<i64, i64> = equal_range(values, 3);
    let absent: tuple<i64, i64> = equal_range(values, 4);
    verify(threes.0 == 1 && threes.1 == 3);
    verify(absent.0 == 3 && absent.1 == 3);

    let empty: list<i32> = [];
    let empty_result: tuple<i64, i64> = equal_range(empty, 4);
    verify(empty_result.0 == 0 && empty_result.1 == 0);
}

#[test]
fn test_algorithm_ranges_generic_binary_search() {
    let values: list<i32> = [1, 3, 3, 7, 9];
    verify(binary_search(values, 1));
    verify(binary_search(values, 3));
    verify(binary_search(values, 8) == false);

    let words: list<str8> = ["ant", "bee", "fox"];
    verify(binary_search(words, "bee"));
    verify(binary_search(words, "cat") == false);
}

#[test]
fn test_algorithm_ranges_projected_order_queries() {
    let records: list<i32> = [11, 19, 20, 28, 31];
    let project_tens = |value: i32| { return value / 10; };
    verify(is_sorted_projected(records, project_tens));
    verify(is_sorted_until_projected(records, project_tens) == 5);
    verify(lower_bound_projected(records, 2, project_tens) == 2);
    verify(upper_bound_projected(records, 2, project_tens) == 4);
    let twos: tuple<i64, i64> =
        equal_range_projected(records, 2, project_tens);
    verify(twos.0 == 2 && twos.1 == 4);
    verify(binary_search_projected(records, 2, project_tens));
    verify(!binary_search_projected(records, 4, project_tens));

    let broken: list<i32> = [11, 21, 19, 30];
    let empty_values: list<i32> = [];
    verify(!is_sorted_projected(broken, project_tens));
    verify(is_sorted_until_projected(broken, project_tens) == 2);
    verify(is_sorted_projected(empty_values, project_tens));
    verify(is_sorted_until_projected(empty_values, project_tens) == 0);
}

#[test]
fn test_algorithm_ranges_comparator_order_queries() {
    let descending: list<i32> = [9, 7, 7, 3, 1];
    let broken: list<i32> = [9, 7, 8, 3];
    let empty: list<i32> = [];
    let greater = |left: i32, right: i32| { return left > right; };

    verify(is_sorted_by(descending, greater));
    verify(!is_sorted_by(broken, greater));
    verify(is_sorted_until_by(descending, greater) == 5);
    verify(is_sorted_until_by(broken, greater) == 2);
    verify(is_sorted_by(empty, greater));
    verify(is_sorted_until_by(empty, greater) == 0);

    verify(lower_bound_by(descending, 7, greater) == 1);
    verify(upper_bound_by(descending, 7, greater) == 3);
    let equal_sevens: tuple<i64, i64> = equal_range_by(descending, 7, greater);
    verify(equal_sevens.0 == 1 && equal_sevens.1 == 3);
    verify(lower_bound_by(descending, 10, greater) == 0);
    verify(upper_bound_by(descending, 0, greater) == 5);
    verify(binary_search_by(descending, 7, greater));
    verify(!binary_search_by(descending, 8, greater));
    verify(lower_bound_by(empty, 4, greater) == 0);
    verify(upper_bound_by(empty, 4, greater) == 0);
    verify(!binary_search_by(empty, 4, greater));
}

#[test]
fn test_algorithm_ranges_comparator_projected_order_queries() {
    let descending: list<i32> = [38, 31, 29, 22, 11];
    let broken: list<i32> = [38, 22, 31];
    let empty: list<i32> = [];
    let greater = |left: i32, right: i32| { return left > right; };
    let project_tens = |value: i32| { return value / 10; };

    verify(is_sorted_by_projected(descending, greater, project_tens));
    verify(!is_sorted_by_projected(broken, greater, project_tens));
    verify(is_sorted_until_by_projected(
        descending, greater, project_tens) == 5);
    verify(is_sorted_until_by_projected(
        broken, greater, project_tens) == 2);
    verify(is_sorted_by_projected(empty, greater, project_tens));
    verify(is_sorted_until_by_projected(empty, greater, project_tens) == 0);

    verify(lower_bound_by_projected(
        descending, 2, greater, project_tens) == 2);
    verify(upper_bound_by_projected(
        descending, 2, greater, project_tens) == 4);
    let twos: tuple<i64, i64> = equal_range_by_projected(
        descending, 2, greater, project_tens);
    verify(twos.0 == 2 && twos.1 == 4);
    verify(binary_search_by_projected(
        descending, 2, greater, project_tens));
    verify(!binary_search_by_projected(
        descending, 4, greater, project_tens));
    verify(lower_bound_by_projected(
        empty, 2, greater, project_tens) == 0);
    verify(!binary_search_by_projected(
        empty, 2, greater, project_tens));
}

#[test]
fn test_algorithm_ranges_comparator_merged() {
    let left: list<i32> = [9, 7, 7, 3, 1];
    let right: list<i32> = [8, 7, 4, 3, 3];
    let greater = |a: i32, b: i32| { return a > b; };

    let merged_values: list<i32> = merged_by(left, right, greater);
    verify(merged_values.len() == 10);
    verify(merged_values[0] == 9 && merged_values[1] == 8);
    verify(merged_values[2] == 7 && merged_values[3] == 7 &&
           merged_values[4] == 7);
    verify(merged_values[5] == 4 && merged_values[6] == 3);
    verify(merged_values[7] == 3 && merged_values[8] == 3);
    verify(merged_values[9] == 1);
}

#[test]
fn test_algorithm_ranges_comparator_projected_merge() {
    let left: list<i32> = [29, 22, 11];
    let right: list<i32> = [28, 24, 19];
    let greater = |a: i32, b: i32| { return a > b; };
    let project_tens = |value: i32| { return value / 10; };

    let merged_values: list<i32> = merged_by_projected(
        left, right, greater, project_tens);
    verify(merged_values.len() == 6 && merged_values[0] == 29 &&
           merged_values[1] == 22 && merged_values[2] == 28 &&
           merged_values[3] == 24 && merged_values[4] == 11 &&
           merged_values[5] == 19);
    verify(is_sorted_by_projected(merged_values, greater, project_tens));

    let halves: list<i32> = [29, 22, 28, 24, 19, 11];
    let inplace: list<i32> = inplace_merge_by_projected(
        halves, 3, greater, project_tens);
    verify(inplace.len() == 6 && inplace[0] == 29 && inplace[1] == 22 &&
           inplace[2] == 28 && inplace[3] == 24 && inplace[4] == 19 &&
           inplace[5] == 11);
    verify(halves[0] == 29 && halves[3] == 24);
    let clamped: list<i32> = inplace_merge_by_projected(
        left, 99, greater, project_tens);
    verify(clamped.len() == left.len() && clamped[0] == 29);
}

#[test]
fn test_algorithm_ranges_comparator_union_sorted() {
    let left: list<i32> = [9, 7, 7, 3, 1];
    let right: list<i32> = [8, 7, 4, 3, 3];
    let greater = |a: i32, b: i32| { return a > b; };
    let union_values: list<i32> = union_sorted_by(left, right, greater);
    verify(union_values.len() == 8);
    verify(union_values[0] == 9 && union_values[1] == 8);
    verify(union_values[2] == 7 && union_values[3] == 7);
    verify(union_values[4] == 4 && union_values[5] == 3);
    verify(union_values[6] == 3 && union_values[7] == 1);
}

#[test]
fn test_algorithm_ranges_comparator_intersection_sorted() {
    let left: list<i32> = [9, 7, 7, 3, 1];
    let right: list<i32> = [8, 7, 4, 3, 3];
    let greater = |a: i32, b: i32| { return a > b; };
    let intersection_values: list<i32> = intersection_sorted_by(left, right, greater);
    verify(intersection_values.len() == 2);
    verify(intersection_values[0] == 7 && intersection_values[1] == 3);
}

#[test]
fn test_algorithm_ranges_comparator_difference_sorted() {
    let left: list<i32> = [9, 7, 7, 3, 1];
    let right: list<i32> = [8, 7, 4, 3, 3];
    let greater = |a: i32, b: i32| { return a > b; };
    let difference_values: list<i32> = difference_sorted_by(left, right, greater);
    verify(difference_values.len() == 3);
    verify(difference_values[0] == 9 && difference_values[1] == 7 &&
           difference_values[2] == 1);
}

#[test]
fn test_algorithm_ranges_comparator_symmetric_difference_sorted() {
    let left: list<i32> = [9, 7, 7, 3, 1];
    let right: list<i32> = [8, 7, 4, 3, 3];
    let greater = |a: i32, b: i32| { return a > b; };
    let symmetric_values: list<i32> = symmetric_difference_sorted_by(left, right, greater);
    verify(symmetric_values.len() == 6);
    verify(symmetric_values[0] == 9 && symmetric_values[1] == 8);
    verify(symmetric_values[2] == 7 && symmetric_values[3] == 4);
    verify(symmetric_values[4] == 3 && symmetric_values[5] == 1);
}

#[test]
fn test_algorithm_ranges_generic_sorted_copy() {
    let values: list<i32> = [5, 1, 3, 1, 9, -2];
    let result: list<i32> = sorted(values);
    verify(result.len() == 6);
    verify(result[0] == -2 && result[1] == 1 && result[2] == 1);
    verify(result[3] == 3 && result[4] == 5 && result[5] == 9);
    verify(values[0] == 5 && values[5] == -2);

    let words: list<str8> = ["fox", "ant", "bee", "ant"];
    let ordered: list<str8> = sorted(words);
    verify(ordered.len() == 4);
    verify(ordered[0] == "ant" && ordered[1] == "ant");
    verify(ordered[2] == "bee" && ordered[3] == "fox");
}

#[test]
fn test_algorithm_ranges_sorted_by_comparator() {
    let values: list<i32> = [2, 5, 1, 5, 9];
    let greater = |a: i32, b: i32| { return a > b; };
    let descending: list<i32> = sorted_by(values, greater);
    verify(descending.len() == 5);
    verify(descending[0] == 9 && descending[1] == 5);
    verify(descending[2] == 5 && descending[3] == 2 && descending[4] == 1);
    verify(values[0] == 2 && values[4] == 9);

    let grouped: list<i32> = [21, 22, 12, 11, 3];
    let by_tens = |a: i32, b: i32| { return a / 10 < b / 10; };
    let stable: list<i32> = sorted_by(grouped, by_tens);
    verify(stable[0] == 3 && stable[1] == 12 && stable[2] == 11);
    verify(stable[3] == 21 && stable[4] == 22);

    let empty: list<i32> = [];
    let empty_sorted: list<i32> = sorted_by(empty, greater);
    verify(empty_sorted.len() == 0);
    let one: list<i32> = [7];
    let one_sorted: list<i32> = sorted_by(one, greater);
    verify(one_sorted[0] == 7);
}

#[test]
fn test_algorithm_ranges_sorted_by_projection() {
    let values: list<i32> = [22, 11, 21, 12, 3, 19];
    let project_tens = |value: i32| { return value / 10; };
    let ordered: list<i32> = sorted_projected(values, project_tens);
    verify(ordered.len() == 6);
    verify(ordered[0] == 3 && ordered[1] == 11 && ordered[2] == 12);
    verify(ordered[3] == 19 && ordered[4] == 22 && ordered[5] == 21);
    verify(is_sorted_projected(ordered, project_tens));
    verify(values[0] == 22 && values[5] == 19);

    let empty: list<i32> = [];
    let one: list<i32> = [7];
    let empty_sorted: list<i32> = sorted_projected(empty, project_tens);
    let one_sorted: list<i32> = sorted_projected(one, project_tens);
    verify(empty_sorted.len() == 0);
    verify(one_sorted[0] == 7);
}

#[test]
fn test_algorithm_ranges_sorted_by_projected_comparator() {
    let values: list<i32> = [32, 19, 21, 14, 28, 11];
    let greater = |left: i32, right: i32| { return left > right; };
    let project_tens = |value: i32| { return value / 10; };
    let ordered: list<i32> = sorted_by_projected(
        values, greater, project_tens);
    verify(ordered.len() == 6 && ordered[0] == 32 &&
           ordered[1] == 21 && ordered[2] == 28 &&
           ordered[3] == 19 && ordered[4] == 14 && ordered[5] == 11);
    verify(is_sorted_by_projected(ordered, greater, project_tens));
    verify(values[0] == 32 && values[1] == 19 && values[5] == 11);

    let empty: list<i32> = [];
    let empty_sorted: list<i32> = sorted_by_projected(
        empty, greater, project_tens);
    verify(empty_sorted.len() == 0);
}

#[test]
fn test_algorithm_ranges_permutations() {
    let ascending: list<i32> = [1, 2, 3];
    let next: tuple<bool, list<i32>> = next_permutation(ascending);
    let next_values: list<i32> = next.1;
    verify(next.0 && next_values[0] == 1 && next_values[1] == 3 && next_values[2] == 2);

    let previous: tuple<bool, list<i32>> = prev_permutation(ascending);
    let previous_values: list<i32> = previous.1;
    verify(!previous.0 && previous_values[0] == 3 && previous_values[1] == 2 && previous_values[2] == 1);

    let descending: list<i32> = [3, 2, 1];
    let wrapped: tuple<bool, list<i32>> = next_permutation(descending);
    let wrapped_values: list<i32> = wrapped.1;
    verify(!wrapped.0 && wrapped_values[0] == 1 && wrapped_values[1] == 2 && wrapped_values[2] == 3);

    let duplicate_values: list<i32> = [1, 2, 2];
    let duplicate_next: tuple<bool, list<i32>> = next_permutation(duplicate_values);
    let duplicate_result: list<i32> = duplicate_next.1;
    verify(duplicate_next.0 && duplicate_result[0] == 2 && duplicate_result[1] == 1 && duplicate_result[2] == 2);

    let greater = |left: i32, right: i32| { return left > right; };
    let custom_next: tuple<bool, list<i32>> = next_permutation_by(descending, greater);
    let custom_values: list<i32> = custom_next.1;
    verify(custom_next.0 && custom_values[0] == 3 && custom_values[1] == 1 && custom_values[2] == 2);
    let custom_previous: tuple<bool, list<i32>> = prev_permutation_by(descending, greater);
    let custom_wrapped: list<i32> = custom_previous.1;
    verify(!custom_previous.0 && custom_wrapped[0] == 1 && custom_wrapped[2] == 3);

    verify(ascending[0] == 1 && ascending[2] == 3);
}

#[test]
fn test_algorithm_ranges_projected_permutations() {
    let values: list<i32> = [11, 19, 22];
    let project_tens = |value: i32| { return value / 10; };
    let next: tuple<bool, list<i32>> = next_permutation_projected(
        values, project_tens);
    let next_values: list<i32> = next.1;
    verify(next.0 && next_values[0] == 11 &&
           next_values[1] == 22 && next_values[2] == 19);

    let previous: tuple<bool, list<i32>> = prev_permutation_projected(
        next_values, project_tens);
    let previous_values: list<i32> = previous.1;
    verify(previous.0 && previous_values[0] == 11 &&
           previous_values[1] == 19 && previous_values[2] == 22);

    let descending: list<i32> = [32, 21, 19];
    let wrapped: tuple<bool, list<i32>> = next_permutation_projected(
        descending, project_tens);
    let wrapped_values: list<i32> = wrapped.1;
    verify(!wrapped.0 && wrapped_values[0] == 19 &&
           wrapped_values[1] == 21 && wrapped_values[2] == 32);
    verify(values[0] == 11 && values[2] == 22);
}

#[test]
fn test_algorithm_ranges_comparator_projected_permutations() {
    let values: list<i32> = [11, 21, 12];
    let greater = |left: i32, right: i32| { return left > right; };
    let project_tens = |value: i32| { return value / 10; };
    let next: tuple<bool, list<i32>> = next_permutation_by_projected(
        values, greater, project_tens);
    let next_values: list<i32> = next.1;
    verify(next.0 && project_tens(next_values[0]) == 1 &&
           project_tens(next_values[1]) == 1 &&
           project_tens(next_values[2]) == 2);

    let previous: tuple<bool, list<i32>> = prev_permutation_by_projected(
        next_values, greater, project_tens);
    let previous_values: list<i32> = previous.1;
    verify(previous.0 && previous_values[0] == values[0] &&
           previous_values[1] == values[1] &&
           previous_values[2] == values[2]);

    let last: list<i32> = [12, 11, 21];
    let wrapped_next: tuple<bool, list<i32>> = next_permutation_by_projected(
        last, greater, project_tens);
    let wrapped_next_values: list<i32> = wrapped_next.1;
    verify(!wrapped_next.0 &&
           project_tens(wrapped_next_values[0]) == 2 &&
           project_tens(wrapped_next_values[2]) == 1);
    let first: list<i32> = [21, 11, 12];
    let wrapped_previous: tuple<bool, list<i32>> =
        prev_permutation_by_projected(first, greater, project_tens);
    let wrapped_previous_values: list<i32> = wrapped_previous.1;
    verify(!wrapped_previous.0 &&
           project_tens(wrapped_previous_values[0]) == 1 &&
           project_tens(wrapped_previous_values[2]) == 2);
}

#[test]
fn test_algorithm_ranges_generic_reversed_copy() {
    let values: list<i32> = [1, 2, 3, 4];
    let backwards: list<i32> = reversed(values);
    verify(backwards.len() == 4);
    verify(backwards[0] == 4 && backwards[1] == 3);
    verify(backwards[2] == 2 && backwards[3] == 1);
    let standard_named: list<i32> = reverse_copy(values);
    verify(standard_named[0] == 4 && standard_named[3] == 1);
    verify(values[0] == 1 && values[3] == 4);

    let empty: list<str8> = [];
    let empty_reversed: list<str8> = reversed(empty);
    verify(empty_reversed.len() == 0);
}

#[test]
fn test_algorithm_ranges_generic_rotate_left_copy() {
    let values: list<i32> = [1, 2, 3, 4];
    let left: list<i32> = rotate_left(values, 2);
    verify(left[0] == 3 && left[1] == 4 && left[2] == 1 && left[3] == 2);

    let right: list<i32> = rotate_left(values, -1);
    verify(right[0] == 4 && right[1] == 1 && right[2] == 2 && right[3] == 3);

    let unchanged: list<i32> = rotate_left(values, 8);
    verify(unchanged[0] == 1 && unchanged[3] == 4);
    let empty: list<i32> = [];
    let empty_rotated: list<i32> = rotate_left(empty, 1);
    verify(empty_rotated.len() == 0);
}

#[test]
fn test_algorithm_ranges_generic_chunked() {
    let data: list<i32> = [1, 2, 3, 4, 5];
    let groups: list<list<i32>> = chunked(data, 2);
    verify(groups.len() == 3);
    let first: list<i32> = groups[0];
    let second: list<i32> = groups[1];
    let final: list<i32> = groups[2];
    verify(first.len() == 2 && first[0] == 1 && first[1] == 2);
    verify(second.len() == 2 && second[0] == 3 && second[1] == 4);
    verify(final.len() == 1 && final[0] == 5);
    let invalid_size: list<list<i32>> = chunked(data, 0);
    let large_size: list<list<i32>> = chunked(data, 9);
    verify(invalid_size.len() == 0);
    verify(large_size.len() == 1);
}

#[test]
fn test_algorithm_ranges_generic_windows() {
    let data: list<i32> = [2, 4, 6, 8];
    let result: list<list<i32>> = windows(data, 3);
    verify(result.len() == 2);
    let first: list<i32> = result[0];
    let second: list<i32> = result[1];
    verify(first.len() == 3 && first[0] == 2 && first[2] == 6);
    verify(second.len() == 3 && second[0] == 4 && second[2] == 8);
    let zero: list<list<i32>> = windows(data, 0);
    let too_wide: list<list<i32>> = windows(data, 5);
    verify(zero.len() == 0 && too_wide.len() == 0);
}

#[test]
fn test_algorithm_ranges_generic_strided() {
    let data: list<i32> = [10, 20, 30, 40, 50];
    let result: list<i32> = strided(data, 2);
    verify(result.len() == 3);
    verify(result[0] == 10 && result[1] == 30 && result[2] == 50);
    let invalid: list<i32> = strided(data, 0);
    verify(invalid.len() == 0);
    let words: list<str8> = ["a", "b", "c"];
    let selected: list<str8> = strided(words, 2);
    verify(selected.len() == 2 && selected[0] == "a" && selected[1] == "c");
}

#[test]
fn test_algorithm_ranges_generic_joined() {
    let nested: list<list<i32>> = [[1, 2], [], [3], [4, 5]];
    let flattened: list<i32> = joined(nested);
    verify(flattened.len() == 5);
    verify(flattened[0] == 1 && flattened[1] == 2);
    verify(flattened[2] == 3 && flattened[3] == 4 && flattened[4] == 5);
    let no_lists: list<list<i32>> = [];
    let empty_flattened: list<i32> = joined(no_lists);
    verify(empty_flattened.len() == 0);
}

#[test]
fn test_algorithm_ranges_generic_joined_with() {
    let nested: list<list<i32>> = [[1, 2], [], [3], [4, 5]];
    let separator: list<i32> = [0, 0];
    let flattened: list<i32> = joined_with(nested, separator);
    verify(flattened.len() == 11);
    verify(flattened[0] == 1 && flattened[1] == 2);
    verify(flattened[2] == 0 && flattened[3] == 0);
    verify(flattened[4] == 0 && flattened[5] == 0);
    verify(flattened[6] == 3 && flattened[7] == 0);
    verify(flattened[8] == 0 && flattened[9] == 4 && flattened[10] == 5);
    verify(nested[0][0] == 1 && nested[3][1] == 5);

    let no_lists: list<list<i32>> = [];
    let no_flattened: list<i32> = joined_with(no_lists, separator);
    verify(no_flattened.len() == 0);
    let one_list: list<list<i32>> = [[7]];
    let single: list<i32> = joined_with(one_list, separator);
    verify(single.len() == 1 && single[0] == 7);
    let empty_separator: list<i32> = [];
    let without_separator: list<i32> = joined_with(nested, empty_separator);
    verify(without_separator.len() == 5);
    verify(without_separator[2] == 3 && without_separator[4] == 5);
}

#[test]
fn test_algorithm_ranges_standard_view_names() {
    let values: list<i32> = [1, 2, 3, 4, 5];
    let groups: list<list<i32>> = chunk(values, 2);
    let final_group: list<i32> = groups[2];
    verify(groups.len() == 3 && final_group.len() == 1 &&
           final_group[0] == 5);
    let windows_by_slide: list<list<i32>> = slide(values, 3);
    let middle_window: list<i32> = windows_by_slide[1];
    verify(windows_by_slide.len() == 3 && middle_window[0] == 2 &&
           middle_window[2] == 4);
    let every_other: list<i32> = stride(values, 2);
    verify(every_other.len() == 3 && every_other[0] == 1 &&
           every_other[2] == 5);

    let nested: list<list<i32>> = [[1, 2], [], [3]];
    let flattened: list<i32> = join(nested);
    verify(flattened.len() == 3 && flattened[0] == 1 &&
           flattened[2] == 3);
    let separator: list<i32> = [0];
    let flattened_with: list<i32> = join_with(nested, separator);
    verify(flattened_with.len() == 5 && flattened_with[2] == 0 &&
           flattened_with[4] == 3);
    verify(values[0] == 1 && nested[2][0] == 3);
}

#[test]
fn test_algorithm_ranges_generic_split() {
    let values: list<i32> = [1, 0, 0, 2, 0];
    let delimiter: list<i64> = [0];
    let fields: list<list<i32>> = split(values, delimiter);
    verify(fields.len() == 4);
    let field0: list<i32> = fields[0];
    let field1: list<i32> = fields[1];
    let field2: list<i32> = fields[2];
    let field3: list<i32> = fields[3];
    verify(field0.len() == 1 && field0[0] == 1);
    verify(field1.len() == 0);
    verify(field2.len() == 1 && field2[0] == 2);
    verify(field3.len() == 0);

    let pair_delimiter: list<i32> = [0, 0];
    let pair_split: list<list<i32>> = split(values, pair_delimiter);
    verify(pair_split.len() == 2);
    let pair0: list<i32> = pair_split[0];
    let pair1: list<i32> = pair_split[1];
    verify(pair0.len() == 1 && pair0[0] == 1);
    verify(pair1.len() == 2);
    verify(pair1[0] == 2 && pair1[1] == 0);

    let leading: list<i32> = [0, 7];
    let leading_split: list<list<i32>> = split(leading, delimiter);
    let leading0: list<i32> = leading_split[0];
    let leading1: list<i32> = leading_split[1];
    verify(leading_split.len() == 2 && leading0.len() == 0);
    verify(leading1.len() == 1 && leading1[0] == 7);

    let empty: list<i32> = [];
    let no_fields: list<list<i32>> = split(empty, delimiter);
    verify(no_fields.len() == 0);
    let empty_delimiter: list<i32> = [];
    let unsplit: list<list<i32>> = split(values, empty_delimiter);
    let single_field: list<i32> = unsplit[0];
    verify(unsplit.len() == 1 && single_field.len() == values.len());
    verify(single_field[0] == 1 && single_field[4] == 0);
    verify(values[0] == 1 && values[4] == 0);
}

#[test]
fn test_algorithm_ranges_generic_concat() {
    let left: list<i32> = [1, 2];
    let right: list<i32> = [3, 4, 5];
    let result: list<i32> = concat(left, right);
    verify(result.len() == 5);
    verify(result[0] == 1 && result[1] == 2);
    verify(result[2] == 3 && result[4] == 5);
    let empty: list<i32> = [];
    let one_side: list<i32> = concat(empty, right);
    verify(one_side.len() == 3 && one_side[0] == 3);
}

#[test]
fn test_algorithm_ranges_zip() {
    let numbers: list<i32> = [4, 5, 6];
    let words: list<str8> = ["four", "five"];
    let pairs: list<tuple<i32, str8>> = zip(numbers, words);
    verify(pairs.len() == 2);

    let first: tuple<i32, str8> = pairs[0];
    let second: tuple<i32, str8> = pairs[1];
    verify(first.0 == 4);
    verify(second.0 == 5);
    verify(numbers.len() == 3 && words.len() == 2);

    let offsets: list<i32> = [40, 50];
    let numeric_pairs: list<tuple<i32, i32>> = zip(numbers, offsets);
    let numeric_pair = numeric_pairs[1];
    verify(numeric_pair.0 == 5 && numeric_pair.1 == 50);

    let empty: list<i32> = [];
    let no_pairs: list<tuple<i32, str8>> = zip(empty, words);
    verify(no_pairs.len() == 0);
}

#[test]
fn test_algorithm_ranges_zip_three_ranges() {
    let numbers: list<i32> = [1, 2, 3];
    let wide_numbers: list<i64> = [10, 20];
    let flags: list<bool> = [true, false, true, false];
    let triples: list<tuple<i32, i64, bool>> = zip(numbers, wide_numbers, flags);
    verify(triples.len() == 2);
    let first: tuple<i32, i64, bool> = triples[0];
    let second: tuple<i32, i64, bool> = triples[1];
    verify(first.0 == 1 && first.1 == 10 && first.2);
    verify(second.0 == 2 && second.1 == 20 && !second.2);
    verify(numbers.len() == 3 && wide_numbers.len() == 2 && flags.len() == 4);

    let empty: list<i32> = [];
    let no_triples: list<tuple<i32, i64, bool>> = zip(empty, wide_numbers, flags);
    verify(no_triples.len() == 0);
}

#[test]
fn test_algorithm_ranges_zip_four_ranges() {
    let first_values: list<i32> = [1, 2, 3];
    let second_values: list<i64> = [10, 20];
    let third_values: list<bool> = [true, false, true, false];
    let fourth_values: list<i32> = [100];
    let rows: list<tuple<i32, i64, bool, i32>> =
        zip(first_values, second_values, third_values, fourth_values);
    verify(rows.len() == 1);
    let first_row: tuple<i32, i64, bool, i32> = rows[0];
    verify(first_row.0 == 1 && first_row.1 == 10 && first_row.2 &&
           first_row.3 == 100);
}

#[test]
fn test_algorithm_ranges_zip_five_ranges() {
    let first_values: list<i32> = [1, 2, 3];
    let second_values: list<i64> = [10, 20];
    let third_values: list<bool> = [true, false, true];
    let fourth_values: list<str8> = ["a", "b", "c"];
    let fifth_values: list<i32> = [100, 200, 300, 400];
    let rows: list<tuple<i32, i64, bool, str8, i32>> =
        zip(first_values, second_values, third_values, fourth_values,
            fifth_values);
    verify(rows.len() == 2);
    let first_row: tuple<i32, i64, bool, str8, i32> = rows[0];
    verify(first_row.0 == 1 && first_row.1 == 10 && first_row.2 &&
           eq(first_row.3, "a") == 1 && first_row.4 == 100);

    let a: list<i32> = [1, 2, 3];
    let b: list<i32> = [10, 20];
    let c: list<i32> = [100, 200, 300];
    let d: list<i32> = [1000, 2000, 3000];
    let e: list<i32> = [10000, 20000, 30000];
    let sum_five = |x: i32, y: i32, z: i32, w: i32, v: i32| {
        return x + y + z + w + v;
    };
    let sums: list<i32> = zip_transform(a, b, c, d, e, sum_five);
    verify(sums.len() == 2 && sums[0] == 11111 && sums[1] == 22222);

    let f: list<i32> = [100000, 200000, 300000];
    let sum_six = |x: i32, y: i32, z: i32, w: i32, v: i32, u: i32| {
        return x + y + z + w + v + u;
    };
    let six_sums: list<i32> = zip_transform(a, b, c, d, e, f, sum_six);
    verify(six_sums.len() == 2 && six_sums[0] == 111111 &&
           six_sums[1] == 222222);

    let sixth_values: list<i64> = [100000, 200000];
    let six_rows: list<tuple<i32, i64, bool, str8, i32, i64>> =
        zip(first_values, second_values, third_values, fourth_values,
            fifth_values, sixth_values);
    verify(six_rows.len() == 2);
    let six_first: tuple<i32, i64, bool, str8, i32, i64> = six_rows[0];
    verify(six_first.0 == 1 && six_first.1 == 10 && six_first.2 &&
           eq(six_first.3, "a") == 1 && six_first.4 == 100 &&
           six_first.5 == 100000);
}

#[test]
fn test_algorithm_ranges_enumerate() {
    let values: list<i32> = [7, 3, 9];
    let indexed: list<tuple<i64, i32>> = enumerate(values);
    verify(indexed.len() == 3);
    let first = indexed[0];
    let middle = indexed[1];
    let last = indexed[2];
    verify(first.0 == 0 && first.1 == 7);
    verify(middle.0 == 1 && middle.1 == 3);
    verify(last.0 == 2 && last.1 == 9);
    verify(values[0] == 7 && values[2] == 9);

    let empty: list<i32> = [];
    let no_items: list<tuple<i64, i32>> = enumerate(empty);
    verify(no_items.len() == 0);

    let from_ten: list<tuple<i64, i32>> = enumerate_from(values, 10);
    let from_ten_first = from_ten[0];
    let from_ten_middle = from_ten[1];
    let from_ten_last = from_ten[2];
    verify(from_ten.len() == 3 && from_ten_first.0 == 10 &&
           from_ten_last.0 == 12 && from_ten_middle.1 == 3);
    let negative: list<tuple<i64, i32>> = enumerate_from(values, -2);
    let negative_first = negative[0];
    let negative_last = negative[2];
    verify(negative_first.0 == -2 && negative_last.0 == 0);
    let empty_from: list<tuple<i64, i32>> = enumerate_from(empty, 5);
    verify(empty_from.len() == 0);
}

#[test]
fn test_algorithm_ranges_cartesian_product() {
    let left: list<i32> = [2, 4];
    let right: list<i32> = [7, 9, 11];
    let pairs: list<tuple<i32, i32>> = cartesian_product(left, right);
    verify(pairs.len() == 6);

    let first = pairs[0];
    let second = pairs[1];
    let third = pairs[2];
    let fourth = pairs[3];
    let last = pairs[5];
    verify(first.0 == 2 && first.1 == 7);
    verify(second.0 == 2 && second.1 == 9);
    verify(third.0 == 2 && third.1 == 11);
    verify(fourth.0 == 4 && fourth.1 == 7);
    verify(last.0 == 4 && last.1 == 11);

    let empty: list<i32> = [];
    let no_pairs: list<tuple<i32, i32>> = cartesian_product(left, empty);
    verify(no_pairs.len() == 0);

    let middle: list<i64> = [10, 20];
    let last_values: list<i32> = [100, 200];
    let triples: list<tuple<i32, i64, i32>> =
        cartesian_product(left, middle, last_values);
    verify(triples.len() == 8);
    let first_triple = triples[0];
    let second_triple = triples[1];
    let third_triple = triples[2];
    let last_triple = triples[7];
    verify(first_triple.0 == 2 && first_triple.1 == 10 && first_triple.2 == 100);
    verify(second_triple.0 == 2 && second_triple.1 == 10 && second_triple.2 == 200);
    verify(third_triple.0 == 2 && third_triple.1 == 20 && third_triple.2 == 100);
    verify(last_triple.0 == 4 && last_triple.1 == 20 && last_triple.2 == 200);
    let empty_values: list<i32> = [];
    let no_triples: list<tuple<i32, i64, i32>> =
        cartesian_product(left, middle, empty_values);
    verify(no_triples.len() == 0);

    let third_values: list<bool> = [true];
    let fourth_values: list<i64> = [1000, 2000];
    let quadruples: list<tuple<i32, i64, bool, i64>> =
        cartesian_product(left, middle, third_values, fourth_values);
    verify(quadruples.len() == 8);
    let first_quadruple = quadruples[0];
    let second_quadruple = quadruples[1];
    let third_quadruple = quadruples[2];
    let last_quadruple = quadruples[7];
    verify(first_quadruple.0 == 2 && first_quadruple.1 == 10 &&
           first_quadruple.2 && first_quadruple.3 == 1000);
    verify(second_quadruple.0 == 2 && second_quadruple.1 == 10 &&
           second_quadruple.3 == 2000);
    verify(third_quadruple.0 == 2 && third_quadruple.1 == 20 &&
           third_quadruple.3 == 1000);
    verify(last_quadruple.0 == 4 && last_quadruple.1 == 20 &&
           last_quadruple.3 == 2000);

    let fifth_values: list<i32> = [10000, 20000];
    let products: list<tuple<i32, i64, bool, i64, i32>> =
        cartesian_product(left, middle, third_values, fourth_values,
                          fifth_values);
    verify(products.len() == 16);
    let first_product: tuple<i32, i64, bool, i64, i32> = products[0];
    let second_product: tuple<i32, i64, bool, i64, i32> = products[1];
    let third_product: tuple<i32, i64, bool, i64, i32> = products[2];
    let last_product: tuple<i32, i64, bool, i64, i32> = products[15];
    verify(first_product.0 == 2 && first_product.1 == 10 &&
           first_product.2 && first_product.3 == 1000 &&
           first_product.4 == 10000);
    verify(second_product.0 == 2 && second_product.1 == 10 &&
           second_product.2 && second_product.4 == 20000);
    verify(third_product.0 == 2 && third_product.1 == 10 &&
           third_product.2 && third_product.3 == 2000 &&
           third_product.4 == 10000);
    verify(last_product.0 == 4 && last_product.1 == 20 &&
           last_product.2 && last_product.4 == 20000);
    let no_products: list<tuple<i32, i64, bool, i64, i32>> =
        cartesian_product(left, middle, third_values, fourth_values,
                          empty_values);
    verify(no_products.len() == 0);

    let sixth_values: list<i64> = [50000, 60000];
    let six_products: list<tuple<i32, i64, bool, i64, i32, i64>> =
        cartesian_product(left, middle, third_values, fourth_values,
                          fifth_values, sixth_values);
    verify(six_products.len() == 32);
    let first_six: tuple<i32, i64, bool, i64, i32, i64> = six_products[0];
    let last_six: tuple<i32, i64, bool, i64, i32, i64> = six_products[31];
    verify(first_six.0 == 2 && first_six.1 == 10 && first_six.2 &&
           first_six.3 == 1000 && first_six.4 == 10000 &&
           first_six.5 == 50000);
    verify(last_six.0 == 4 && last_six.1 == 20 && last_six.2 &&
           last_six.3 == 2000 && last_six.4 == 20000 &&
           last_six.5 == 60000);
}

#[test]
fn test_algorithm_ranges_tuple_keys_and_values() {
    let numbers: list<i32> = [4, 8, 15];
    let offsets: list<i64> = [40, 80, 150];
    let pairs: list<tuple<i32, i64>> = zip(numbers, offsets);

    let selected_keys: list<i32> = keys(pairs);
    let selected_values: list<i64> = values(pairs);
    verify(selected_keys.len() == 3 && selected_keys[0] == 4);
    verify(selected_keys[1] == 8 && selected_keys[2] == 15);
    verify(selected_values.len() == 3);
    verify(selected_values[0] == 40 && selected_values[2] == 150);
    let original_pair: tuple<i32, i64> = pairs[1];
    verify(original_pair.0 == 8 && original_pair.1 == 80);

    let words: list<str8> = ["four", "eight"];
    let word_pairs: list<tuple<i32, str8>> = zip(numbers, words);
    let projected_words: list<str8> = values(word_pairs);
    verify(eq(projected_words[0], "four") == 1);
    verify(eq(projected_words[1], "eight") == 1);

    let empty_pairs: list<tuple<i32, i64>> = [];
    let no_keys: list<i32> = keys(empty_pairs);
    let no_values: list<i64> = values(empty_pairs);
    verify(no_keys.len() == 0 && no_values.len() == 0);
}

#[test]
fn test_algorithm_ranges_pairwise() {
    let values: list<i32> = [4, 6, 9];
    let pairs: list<tuple<i32, i32>> = pairwise(values);
    verify(pairs.len() == 2);
    let first = pairs[0];
    let second = pairs[1];
    verify(first.0 == 4 && first.1 == 6);
    verify(second.0 == 6 && second.1 == 9);

    let singleton: list<i32> = [7];
    let no_pairs: list<tuple<i32, i32>> = pairwise(singleton);
    verify(no_pairs.len() == 0);

    let sum_as_double = |left: i32, right: i32| {
        return f64(left + right);
    };
    let adjacent_sums: list<f64> = adjacent_transform(values, sum_as_double);
    verify(adjacent_sums.len() == 2);
    verify(adjacent_sums[0] == 10.0 && adjacent_sums[1] == 15.0);

    let values_four: list<i32> = [4, 6, 9, 13];
    let triples: list<tuple<i32, i32, i32>> = adjacent3(values_four);
    verify(triples.len() == 2);
    let first_triple = triples[0];
    let second_triple = triples[1];
    verify(first_triple.0 == 4 && first_triple.1 == 6 && first_triple.2 == 9);
    verify(second_triple.0 == 6 && second_triple.1 == 9 && second_triple.2 == 13);
    let quadruples: list<tuple<i32, i32, i32, i32>> = adjacent4(values_four);
    verify(quadruples.len() == 1);
    let only_quadruple = quadruples[0];
    verify(only_quadruple.0 == 4 && only_quadruple.1 == 6 &&
           only_quadruple.2 == 9 && only_quadruple.3 == 13);
    let no_triples: list<tuple<i32, i32, i32>> = adjacent3(singleton);
    let no_quadruples: list<tuple<i32, i32, i32, i32>> = adjacent4(values);
    verify(no_triples.len() == 0 && no_quadruples.len() == 0);
}

#[test]
fn test_algorithm_ranges_adjacent_transform_wider_windows() {
    let values: list<i32> = [2, 4, 6, 8, 10];
    let sum_three = |a: i32, b: i32, c: i32| { return a + b + c; };
    let sum_four = |a: i32, b: i32, c: i32, d: i32| {
        return a + b + c + d;
    };
    let triples: list<i32> = adjacent_transform3(values, sum_three);
    verify(triples.len() == 3 && triples[0] == 12 && triples[1] == 18 &&
           triples[2] == 24);
    let quadruples: list<i32> = adjacent_transform4(values, sum_four);
    verify(quadruples.len() == 2 && quadruples[0] == 20 &&
           quadruples[1] == 28);

    let short: list<i32> = [7, 9];
    let no_triples: list<i32> = adjacent_transform3(short, sum_three);
    let no_quadruples: list<i32> = adjacent_transform4(short, sum_four);
    verify(no_triples.len() == 0 && no_quadruples.len() == 0);
    verify(values[0] == 2 && values[4] == 10);
}

#[test]
fn test_algorithm_ranges_adjacent_five_element_windows() {
    let values: list<i32> = [2, 4, 6, 8, 10, 12];
    let windows: list<tuple<i32, i32, i32, i32, i32>> = adjacent5(values);
    verify(windows.len() == 2);
    let first: tuple<i32, i32, i32, i32, i32> = windows[0];
    verify(first.0 == 2 && first.1 == 4 && first.2 == 6 && first.3 == 8 &&
           first.4 == 10);

    let sum_five = |a: i32, b: i32, c: i32, d: i32, e: i32| {
        return a + b + c + d + e;
    };
    let sums: list<i32> = adjacent_transform5(values, sum_five);
    verify(sums.len() == 2 && sums[0] == 30 && sums[1] == 40);

    let double = |value: i32| { return value * 2; };
    let projected: list<i32> =
        adjacent_transform5_projected(values, sum_five, double);
    verify(projected.len() == 2 && projected[0] == 60 && projected[1] == 80);

    let short: list<i32> = [1, 2, 3, 4];
    let no_windows: list<tuple<i32, i32, i32, i32, i32>> = adjacent5(short);
    let no_sums: list<i32> = adjacent_transform5(short, sum_five);
    let no_projected: list<i32> =
        adjacent_transform5_projected(short, sum_five, double);
    verify(no_windows.len() == 0 && no_sums.len() == 0 &&
           no_projected.len() == 0);
    verify(values[0] == 2 && values[5] == 12);
}

#[test]
fn test_algorithm_ranges_projected_adjacent_transform() {
    let values: list<i32> = [11, 12, 19, 21, 25, 30];
    let tens = |value: i32| { return value / 10; };
    let sum_two = |a: i32, b: i32| { return a + b; };
    let pairs: list<i32> = adjacent_transform_projected(values, sum_two, tens);
    verify(pairs.len() == 5 && pairs[0] == 2 && pairs[2] == 3 && pairs[4] == 5);
    verify(values[0] == 11 && values[5] == 30);
}

#[test]
fn test_algorithm_ranges_projected_adjacent_transform3() {
    let values: list<i32> = [11, 12, 19, 21, 25, 30];
    let tens = |value: i32| { return value / 10; };
    let sum_three = |a: i32, b: i32, c: i32| { return a + b + c; };
    let triples: list<i32> = adjacent_transform3_projected(values, sum_three, tens);
    verify(triples.len() == 4 && triples[0] == 3 && triples[2] == 5);
    let short: list<i32> = [11, 21];
    let no_triples: list<i32> = adjacent_transform3_projected(short, sum_three, tens);
    verify(no_triples.len() == 0);
}

#[test]
fn test_algorithm_ranges_projected_adjacent_transform4() {
    let values: list<i32> = [11, 12, 19, 21, 25, 30];
    let tens = |value: i32| { return value / 10; };
    let sum_four = |a: i32, b: i32, c: i32, d: i32| {
        return a + b + c + d;
    };
    let quadruples: list<i32> = adjacent_transform4_projected(values, sum_four, tens);
    verify(quadruples.len() == 3 && quadruples[0] == 5 && quadruples[2] == 8);
    let short: list<i32> = [11, 21];
    let no_quadruples: list<i32> = adjacent_transform4_projected(short, sum_four, tens);
    verify(no_quadruples.len() == 0);
}

#[test]
fn test_algorithm_ranges_generic_replace() {
    let values: list<i32> = [1, 2, 2, 3, 2];
    let updated: list<i32> = replace(values, 2, 9);
    verify(updated.len() == 5);
    verify(updated[0] == 1 && updated[1] == 9 && updated[2] == 9);
    verify(updated[3] == 3 && updated[4] == 9);
    verify(values[1] == 2 && values[4] == 2);
    let words: list<str8> = ["red", "blue", "red"];
    let renamed: list<str8> = replace(words, "red", "green");
    verify(renamed[0] == "green" && renamed[1] == "blue");
}

#[test]
fn test_algorithm_ranges_copy_remove_replace_copy() {
    let values: list<i32> = [1, 2, 3, 2, 4];
    let is_even = |value: i32| { return value % 2 == 0; };

    let selected: list<i32> = copy_if(values, is_even);
    verify(selected.len() == 3);
    verify(selected[0] == 2 && selected[1] == 2 && selected[2] == 4);

    let without_two: list<i32> = remove_copy(values, 2);
    verify(without_two.len() == 3);
    verify(without_two[0] == 1 && without_two[1] == 3 && without_two[2] == 4);

    let without_evens: list<i32> = remove_copy_if(values, is_even);
    verify(without_evens.len() == 2);
    verify(without_evens[0] == 1 && without_evens[1] == 3);

    let replaced: list<i32> = replace_copy(values, 2, 9);
    verify(replaced.len() == 5);
    verify(replaced[0] == 1 && replaced[1] == 9 && replaced[2] == 3);
    verify(replaced[3] == 9 && replaced[4] == 4);

    let replaced_evens: list<i32> = replace_copy_if(values, is_even, 0);
    verify(replaced_evens.len() == 5);
    verify(replaced_evens[0] == 1 && replaced_evens[1] == 0);
    verify(replaced_evens[2] == 3 && replaced_evens[3] == 0);
    verify(replaced_evens[4] == 0);
    verify(values[0] == 1 && values[1] == 2 && values[4] == 4);

    let empty: list<i32> = [];
    let empty_selected: list<i32> = copy_if(empty, is_even);
    let empty_without_value: list<i32> = remove_copy(empty, 2);
    let empty_without_predicate: list<i32> = remove_copy_if(empty, is_even);
    let empty_replaced: list<i32> = replace_copy(empty, 2, 9);
    let empty_replaced_if: list<i32> = replace_copy_if(empty, is_even, 0);
    verify(empty_selected.len() == 0);
    verify(empty_without_value.len() == 0);
    verify(empty_without_predicate.len() == 0);
    verify(empty_replaced.len() == 0);
    verify(empty_replaced_if.len() == 0);
}

#[test]
fn test_algorithm_ranges_projected_remove_replace() {
    let values: list<i32> = [11, 22, 29, 31, 42];
    let project_tens = |value: i32| { return value / 10; };

    let removed: list<i32> = remove_projected(values, 2, project_tens);
    verify(removed.len() == 3 && removed[0] == 11 &&
           removed[1] == 31 && removed[2] == 42);
    let removed_copy: list<i32> = remove_copy_projected(
        values, 2, project_tens);
    verify(removed_copy.len() == 3 && removed_copy[0] == 11 &&
           removed_copy[1] == 31 && removed_copy[2] == 42);

    let replaced: list<i32> = replace_projected(
        values, 2, 99, project_tens);
    verify(replaced.len() == 5 && replaced[0] == 11 &&
           replaced[1] == 99 && replaced[2] == 99 &&
           replaced[3] == 31 && replaced[4] == 42);
    let replaced_copy: list<i32> = replace_copy_projected(
        values, 2, 99, project_tens);
    verify(replaced_copy.len() == 5 && replaced_copy[1] == 99 &&
           replaced_copy[2] == 99);
    verify(values[1] == 22 && values[2] == 29);
}

#[test]
fn test_algorithm_ranges_equivalence_replace() {
    let values: list<i32> = [11, 22, 29, 31, 42];
    let same_decade = |item: i32, key: i32| { return item / 10 == key / 10; };
    let replaced: list<i32> = replace_by(values, 20, 99, same_decade);
    let copied: list<i32> = replace_copy_by(values, 20, 99, same_decade);
    verify(replaced.len() == 5 && replaced[0] == 11 &&
           replaced[1] == 99 && replaced[2] == 99 &&
           replaced[3] == 31 && replaced[4] == 42);
    verify(copied.len() == 5 && copied[1] == 99 && copied[2] == 99);

    let project_tens = |value: i32| { return value / 10; };
    let same_parity = |left: i32, right: i32| {
        return left % 2 == right % 2;
    };
    let replaced_projected: list<i32> = replace_by_projected(
        values, 2, 99, same_parity, project_tens);
    let copied_projected: list<i32> = replace_copy_by_projected(
        values, 2, 99, same_parity, project_tens);
    verify(replaced_projected.len() == 5 &&
           replaced_projected[0] == 11 &&
           replaced_projected[1] == 99 &&
           replaced_projected[2] == 99 &&
           replaced_projected[3] == 31 &&
           replaced_projected[4] == 99);
    verify(copied_projected.len() == 5 &&
           copied_projected[1] == 99 && copied_projected[4] == 99);
    verify(values[0] == 11 && values[1] == 22 && values[4] == 42);
}

#[test]
fn test_algorithm_ranges_projected_conditional_transforms() {
    let values: list<i32> = [11, 22, 29, 31, 42];
    let project_tens = |value: i32| { return value / 10; };
    let key_at_least_three = |key: i32| { return key >= 3; };

    let removed: list<i32> = remove_if_projected(
        values, key_at_least_three, project_tens);
    let removed_copy: list<i32> = remove_copy_if_projected(
        values, key_at_least_three, project_tens);
    verify(removed.len() == 3 && removed[0] == 11 &&
           removed[1] == 22 && removed[2] == 29);
    verify(removed_copy.len() == 3 && removed_copy[2] == 29);

    let replaced: list<i32> = replace_if_projected(
        values, key_at_least_three, 99, project_tens);
    let replaced_copy: list<i32> = replace_copy_if_projected(
        values, key_at_least_three, 99, project_tens);
    verify(replaced.len() == 5 && replaced[0] == 11 &&
           replaced[2] == 29 && replaced[3] == 99 && replaced[4] == 99);
    verify(replaced_copy.len() == 5 && replaced_copy[3] == 99 &&
           replaced_copy[4] == 99);
    verify(values[3] == 31 && values[4] == 42);

    let empty: list<i32> = [];
    let empty_removed: list<i32> = remove_if_projected(
        empty, key_at_least_three, project_tens);
    let empty_replaced: list<i32> = replace_if_projected(
        empty, key_at_least_three, 99, project_tens);
    verify(empty_removed.len() == 0 && empty_replaced.len() == 0);
}


#[test]
fn test_algorithm_ranges_predicate_queries() {
    let flags: list<bool> = [true, true, false];
    let all_flags: bool = all_of(flags);
    let any_flags: bool = any_of(flags);
    let no_flags: bool = none_of(flags);
    let empty: list<bool> = [];
    let empty_all: bool = all_of(empty);
    let empty_any: bool = any_of(empty);
    let empty_none: bool = none_of(empty);
    verify(!all_flags && any_flags && !no_flags);
    verify(empty_all && !empty_any && empty_none);
}

#[test]
fn test_algorithm_ranges_generic_element_extrema() {
    let values: list<i32> = [8, -3, 11, 11, 4];
    let empty: list<i32> = [];
    verify(min_element_index(values) == 1);
    verify(max_element_index(values) == 2);
    verify(min_element_index(empty) == -1);
    verify(max_element_index(empty) == -1);
    let extrema: tuple<i64, i64> = minmax_element_index(values);
    let no_extrema: tuple<i64, i64> = minmax_element_index(empty);
    verify(extrema.0 == 1 && extrema.1 == 3);
    verify(no_extrema.0 == -1 && no_extrema.1 == -1);
}

#[test]
fn test_algorithm_ranges_generic_element_values() {
    let values: list<i32> = [8, -3, 11, 11, 4];
    verify(min_element_value(values) == -3);
    verify(max_element_value(values) == 11);
    let values_extrema: tuple<i32, i32> = minmax_element_value(values);
    verify(values_extrema.0 == -3 && values_extrema.1 == 11);
    let words: list<str8> = ["pear", "apple", "plum"];
    verify(min_element_value(words) == "apple");
    verify(max_element_value(words) == "plum");
}

#[test]
fn test_algorithm_ranges_comparator_element_extrema() {
    let values: list<i32> = [22, 11, 21, 12, 3];
    let empty: list<i32> = [];
    let by_tens = |a: i32, b: i32| { return a / 10 < b / 10; };
    verify(min_element_index_by(values, by_tens) == 4);
    verify(max_element_index_by(values, by_tens) == 0);
    verify(min_element_value_by(values, by_tens) == 3);
    verify(max_element_value_by(values, by_tens) == 22);
    let values_extrema: tuple<i32, i32> =
        minmax_element_value_by(values, by_tens);
    verify(values_extrema.0 == 3 && values_extrema.1 == 21);
    verify(min_element_index_by(empty, by_tens) == -1);
    verify(max_element_index_by(empty, by_tens) == -1);
    let by_tens_extrema: tuple<i64, i64> =
        minmax_element_index_by(values, by_tens);
    verify(by_tens_extrema.0 == 4 && by_tens_extrema.1 == 2);

    let tied: list<i32> = [12, 11, 19];
    verify(min_element_index_by(tied, by_tens) == 0);
    verify(max_element_index_by(tied, by_tens) == 0);
    let tied_extrema: tuple<i64, i64> =
        minmax_element_index_by(tied, by_tens);
    verify(tied_extrema.0 == 0 && tied_extrema.1 == 2);
    verify(min_element_value_by(tied, by_tens) == 12);
    verify(max_element_value_by(tied, by_tens) == 12);

    let descending = |a: i32, b: i32| { return a > b; };
    verify(min_element_index_by(values, descending) == 0);
    verify(max_element_index_by(values, descending) == 4);
}

#[test]
fn test_algorithm_ranges_projected_element_extrema() {
    let values: list<i32> = [23, 11, 19, 32, 38];
    let empty: list<i32> = [];
    let project_tens = |value: i32| { return value / 10; };

    verify(min_element_index_projected(values, project_tens) == 1);
    verify(max_element_index_projected(values, project_tens) == 3);
    let indices: tuple<i64, i64> = minmax_element_index_projected(
        values, project_tens);
    verify(indices.0 == 1 && indices.1 == 4);
    verify(min_element_index_projected(empty, project_tens) == -1);
    verify(max_element_index_projected(empty, project_tens) == -1);
    let empty_indices: tuple<i64, i64> = minmax_element_index_projected(
        empty, project_tens);
    verify(empty_indices.0 == -1 && empty_indices.1 == -1);

    verify(min_element_value_projected(values, project_tens) == 11);
    verify(max_element_value_projected(values, project_tens) == 32);
    let extrema: tuple<i32, i32> = minmax_element_value_projected(
        values, project_tens);
    verify(extrema.0 == 11 && extrema.1 == 38);
}

#[test]
fn test_algorithm_ranges_comparator_projected_element_extrema() {
    let values: list<i32> = [22, 21, 11, 12, 3, 4];
    let empty: list<i32> = [];
    let greater = |left: i32, right: i32| { return left > right; };
    let project_tens = |value: i32| { return value / 10; };

    verify(min_element_index_by_projected(
        values, greater, project_tens) == 0);
    verify(max_element_index_by_projected(
        values, greater, project_tens) == 4);
    let indices: tuple<i64, i64> = minmax_element_index_by_projected(
        values, greater, project_tens);
    verify(indices.0 == 0 && indices.1 == 5);
    verify(min_element_index_by_projected(
        empty, greater, project_tens) == -1);
    verify(max_element_index_by_projected(
        empty, greater, project_tens) == -1);
    let empty_indices: tuple<i64, i64> = minmax_element_index_by_projected(
        empty, greater, project_tens);
    verify(empty_indices.0 == -1 && empty_indices.1 == -1);

    verify(min_element_value_by_projected(
        values, greater, project_tens) == 22);
    verify(max_element_value_by_projected(
        values, greater, project_tens) == 3);
    let extrema: tuple<i32, i32> = minmax_element_value_by_projected(
        values, greater, project_tens);
    verify(extrema.0 == 22 && extrema.1 == 4);
}

#[test]
fn test_algorithm_ranges_generic_sequence_transforms() {
    let data: list<i32> = [5, 6, 6, 7, 8, 6];
    let removed: list<i32> = remove(data, 6);
    verify(removed.len() == 3);
    verify(removed[0] == 5 && removed[1] == 7 && removed[2] == 8);

    let prefix: list<i32> = take(data, 3);
    verify(prefix.len() == 3 && prefix[0] == 5 && prefix[2] == 6);
    let suffix: list<i32> = drop(data, 4);
    verify(suffix.len() == 2 && suffix[0] == 8 && suffix[1] == 6);
    let none_taken: list<i32> = take(data, -2);
    let all_dropped: list<i32> = drop(data, 99);
    verify(none_taken.len() == 0 && all_dropped.len() == 0);
}

#[test]
fn test_algorithm_ranges_take_drop_while() {
    let values: list<i32> = [1, 2, 3, 0, 4];
    let below_three = |value: i32| { return value < 3; };
    let prefix: list<i32> = take_while(values, below_three);
    let suffix: list<i32> = drop_while(values, below_three);
    verify(prefix.len() == 2 && prefix[0] == 1 && prefix[1] == 2);
    verify(suffix.len() == 3 && suffix[0] == 3 && suffix[1] == 0 && suffix[2] == 4);
    verify(values.len() == 5 && values[0] == 1 && values[4] == 4);

    let starts_rejected: list<i32> = [3, 1, 2];
    let empty_prefix: list<i32> = take_while(starts_rejected, below_three);
    let unchanged: list<i32> = drop_while(starts_rejected, below_three);
    verify(empty_prefix.len() == 0);
    verify(unchanged.len() == 3 && unchanged[0] == 3 && unchanged[2] == 2);

    let empty: list<i32> = [];
    let empty_prefix2: list<i32> = take_while(empty, below_three);
    let empty_suffix2: list<i32> = drop_while(empty, below_three);
    verify(empty_prefix2.len() == 0 && empty_suffix2.len() == 0);
}

#[test]
fn test_algorithm_ranges_projected_take_drop_while() {
    let values: list<i32> = [11, 12, 19, 21, 25, 30];
    let below_two = |key: i32| { return key < 2; };
    let tens = |value: i32| { return value / 10; };
    let prefix: list<i32> = take_while_projected(values, below_two, tens);
    let suffix: list<i32> = drop_while_projected(values, below_two, tens);
    verify(prefix.len() == 3 && prefix[0] == 11 && prefix[1] == 12 &&
           prefix[2] == 19);
    verify(suffix.len() == 3 && suffix[0] == 21 && suffix[1] == 25 &&
           suffix[2] == 30);

    let starts_rejected: list<i32> = [21, 11, 12];
    let no_prefix: list<i32> =
        take_while_projected(starts_rejected, below_two, tens);
    let unchanged: list<i32> =
        drop_while_projected(starts_rejected, below_two, tens);
    verify(no_prefix.len() == 0 && unchanged.len() == 3 &&
           unchanged[0] == 21 && unchanged[2] == 12);

    let empty: list<i32> = [];
    let empty_prefix: list<i32> =
        take_while_projected(empty, below_two, tens);
    let empty_suffix: list<i32> =
        drop_while_projected(empty, below_two, tens);
    verify(empty_prefix.len() == 0 && empty_suffix.len() == 0);
}

#[test]
fn test_algorithm_ranges_transform_changes_element_type() {
    let values: list<i32> = [1, 3, 2];
    let to_double = |value: i32| { return f64(value); };
    let converted: list<f64> = transform(values, to_double);
    verify(converted.len() == 3);
    verify(converted[0] == 1.0 && converted[1] == 3.0 && converted[2] == 2.0);

    let add_one = |value: i32| { return value + 1; };
    let incremented: list<i32> = transform(values, add_one);
    verify(incremented.len() == 3);
    verify(incremented[0] == 2 && incremented[1] == 4 && incremented[2] == 3);

    let counted: tuple<i64, list<i32>> =
        transform_with_count(values, add_one);
    let counted_values: list<i32> = counted.1;
    verify(counted.0 == 3 && counted_values[0] == 2 &&
           counted_values[2] == 3);
    let empty: list<i32> = [];
    let empty_counted: tuple<i64, list<i32>> =
        transform_with_count(empty, add_one);
    let empty_values: list<i32> = empty_counted.1;
    verify(empty_counted.0 == 0 && empty_values.len() == 0);
}

#[test]
fn test_algorithm_ranges_binary_transform() {
    let left: list<i32> = [1, 2, 3, 4];
    let right: list<i32> = [10, 20, 30];
    let add = |a: i32, b: i32| { return a + b; };
    let sums: list<i32> = transform(left, right, add);
    verify(sums.len() == 3 && sums[0] == 11 && sums[2] == 33);
    verify(left.len() == 4 && right.len() == 3);

    let empty: list<i32> = [];
    let none: list<i32> = transform(empty, right, add);
    verify(none.len() == 0);
}

#[test]
fn test_algorithm_ranges_transform_projected() {
    let values: list<i32> = [11, 22, 33];
    let project_tens = |value: i32| { return value / 10; };
    let square_as_float = |key: i32| { return f64(key * key); };
    let squares: list<f64> = transform_projected(
        values, square_as_float, project_tens);
    verify(squares.len() == 3 && squares[0] == 1.0 &&
           squares[1] == 4.0 && squares[2] == 9.0);
    let counted_squares: tuple<i64, list<f64>> =
        transform_projected_with_count(
            values, square_as_float, project_tens);
    let counted_square_values: list<f64> = counted_squares.1;
    verify(counted_squares.0 == 3 && counted_square_values[2] == 9.0);

    let other: list<i32> = [19, 28];
    let add_keys = |left: i32, right: i32| { return left + right; };
    let sums: list<i32> = zip_transform_projected(
        values, other, add_keys, project_tens, project_tens);
    verify(sums.len() == 2 && sums[0] == 2 && sums[1] == 4);
    verify(values[0] == 11 && other.len() == 2);
}

#[test]
fn test_algorithm_ranges_zip_transform() {
    let counts: list<i32> = [10, 20, 30];
    let offsets: list<f64> = [0.5, 1.5];
    let combine = |count: i32, offset: f64| {
        return f64(count) + offset;
    };
    let combined: list<f64> = zip_transform(counts, offsets, combine);
    verify(combined.len() == 2);
    verify(combined[0] == 10.5 && combined[1] == 21.5);
}

#[test]
fn test_algorithm_ranges_zip_transform_three_inputs() {
    let first: list<i32> = [1, 2, 3];
    let second: list<i64> = [10, 20];
    let third: list<i32> = [100, 200, 300, 400];
    let sum_three = |a: i32, b: i64, c: i32| { return a + i32(b) + c; };
    let sums: list<i32> = zip_transform(first, second, third, sum_three);
    verify(sums.len() == 2);
    verify(sums[0] == 111 && sums[1] == 222);
    verify(first.len() == 3 && second.len() == 2 && third.len() == 4);

    let empty: list<i32> = [];
    let no_sums: list<i32> = zip_transform(first, second, empty, sum_three);
    verify(no_sums.len() == 0);
}

#[test]
fn test_algorithm_ranges_zip_transform_four_inputs() {
    let first: list<i32> = [1, 2, 3];
    let second: list<i32> = [10, 20];
    let third: list<i32> = [100, 200, 300];
    let fourth: list<i32> = [1000];
    let combine = |a: i32, b: i32, c: i32, d: i32| {
        return a + b + c + d;
    };
    let combined: list<i32> = zip_transform(first, second, third, fourth, combine);
    verify(combined.len() == 1 && combined[0] == 1111);

    let empty: list<i32> = [];
    let none: list<i32> = zip_transform(first, second, third, empty, combine);
    verify(none.len() == 0);
}

#[test]
fn test_algorithm_ranges_zip_transform_projected_three_and_four_inputs() {
    let first: list<i32> = [11, 22, 33];
    let second: list<i64> = [19, 28];
    let third: list<i32> = [5, 6, 7, 8];
    let first_key = |value: i32| { return value / 10; };
    let second_key = |value: i64| { return i32(value / 10); };
    let third_key = |value: i32| { return value * 10; };
    let sum_three = |a: i32, b: i32, c: i32| { return a + b + c; };
    let sums: list<i32> = zip_transform3_projected(
        first, second, third, sum_three, first_key, second_key, third_key);
    verify(sums.len() == 2 && sums[0] == 52 && sums[1] == 64);

    let fourth: list<i32> = [100, 200, 300];
    let tens = |value: i32| { return value / 10; };
    let ones = |value: i32| { return value % 10; };
    let combine_four = |a: i32, b: i32, c: i32, d: i32| {
        return a + b + c + d;
    };
    let combined: list<i32> = zip_transform4_projected(
        first, third, fourth, first, combine_four,
        first_key, third_key, tens, ones);
    verify(combined.len() == 3 && combined[0] == 62 &&
           combined[1] == 84 && combined[2] == 106);

    let empty: list<i32> = [];
    let none: list<i32> = zip_transform3_projected(
        first, second, empty, sum_three, first_key, second_key, third_key);
    verify(none.len() == 0 && first[0] == 11 && second[0] == 19);
}

#[test]
fn test_algorithm_ranges_chunk_by() {
    let values: list<i32> = [1, 2, 5, 6, 7, 10];
    let consecutive = |left: i32, right: i32| { return right == left + 1; };
    let groups: list<list<i32>> = chunk_by(values, consecutive);
    verify(groups.len() == 3);
    let first_group: list<i32> = groups[0];
    let middle_group: list<i32> = groups[1];
    let last_group: list<i32> = groups[2];
    verify(first_group.len() == 2 && first_group[0] == 1 && first_group[1] == 2);
    verify(middle_group.len() == 3 && middle_group[0] == 5 && middle_group[2] == 7);
    verify(last_group.len() == 1 && last_group[0] == 10);

    let empty: list<i32> = [];
    let no_groups: list<list<i32>> = chunk_by(empty, consecutive);
    verify(no_groups.len() == 0);
}

#[test]
fn test_algorithm_ranges_chunk_by_projected() {
    let values: list<i32> = [11, 12, 19, 21, 25, 30];
    let equal_key = |left: i32, right: i32| { return left == right; };
    let tens = |value: i32| { return value / 10; };
    let groups: list<list<i32>> = chunk_by_projected(values, equal_key, tens);
    verify(groups.len() == 3);
    let first: list<i32> = groups[0];
    let second: list<i32> = groups[1];
    let third: list<i32> = groups[2];
    verify(first.len() == 3 && first[0] == 11 && first[2] == 19);
    verify(second.len() == 2 && second[0] == 21 && second[1] == 25);
    verify(third.len() == 1 && third[0] == 30);
    let empty: list<i32> = [];
    let no_groups: list<list<i32>> = chunk_by_projected(empty, equal_key, tens);
    verify(no_groups.len() == 0);
}

#[test]
fn test_algorithm_ranges_iota() {
    let values: list<i64> = iota(-2, 3);
    verify(values.len() == 5);
    verify(values[0] == -2 && values[1] == -1 && values[2] == 0);
    verify(values[3] == 1 && values[4] == 2);

    let empty: list<i64> = iota(4, 4);
    let reversed: list<i64> = iota(5, 1);
    verify(empty.len() == 0 && reversed.len() == 0);

    let stepped: list<i64> = iota_by(1, 10, 3);
    verify(stepped.len() == 3);
    verify(stepped[0] == 1 && stepped[1] == 4 && stepped[2] == 7);

    let descending: list<i64> = iota_by(9, 0, -2);
    verify(descending.len() == 5);
    verify(descending[0] == 9 && descending[1] == 7 &&
           descending[2] == 5 && descending[3] == 3 && descending[4] == 1);

    let zero_step: list<i64> = iota_by(1, 10, 0);
    let wrong_direction: list<i64> = iota_by(1, 10, -1);
    verify(zero_step.len() == 0 && wrong_direction.len() == 0);

    let near_max: list<i64> = iota_by(9223372036854775806,
                                      9223372036854775807, 4);
    verify(near_max.len() == 1 && near_max[0] == 9223372036854775806);

    let first: i32 = 2;
    let last: i32 = 6;
    let typed: list<i32> = iota_range(first, last);
    verify(typed.len() == 4 && typed[0] == 2 && typed[3] == 5);

    let step: i32 = 3;
    let stepped_end: i32 = 11;
    let typed_stepped: list<i32> =
        iota_range_by(first, stepped_end, step);
    verify(typed_stepped.len() == 3 && typed_stepped[0] == 2 &&
           typed_stepped[1] == 5 && typed_stepped[2] == 8);
    let down_from: i32 = 9;
    let down_to: i32 = 0;
    let down_step: i32 = -2;
    let typed_descending: list<i32> =
        iota_range_by(down_from, down_to, down_step);
    verify(typed_descending.len() == 5 && typed_descending[0] == 9 &&
           typed_descending[4] == 1);
    let zero_step_i32: i32 = 0;
    let negative_step_i32: i32 = -1;
    let no_step: list<i32> = iota_range_by(first, last, zero_step_i32);
    let away: list<i32> = iota_range_by(first, last, negative_step_i32);
    verify(no_step.is_empty() && away.is_empty());

}


#[test]
fn test_algorithm_ranges_repeat_len() {
