#[test]
fn test_algorithm_numeric_generic_partial_sum_and_adjacent_difference() {
    let data: list<i32> = [2, 3, 5];
    let init: i32 = 10;
    let prefix: list<i32> = partial_sum(data, init);
    verify(prefix.len() == 3);
    verify(prefix[0] == 12 && prefix[1] == 15 && prefix[2] == 20);

    let differences: list<i32> = adjacent_difference(prefix, init);
    verify(differences.len() == 3);
