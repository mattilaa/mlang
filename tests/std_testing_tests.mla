mod std::testing;

use std::testing::*;

#[test]
fn test_expect_helpers_pass() -> i32 {
    reset();

    expect_true(1 < 2);
    expect_false(3 < 2);
    expect_eq(42, 42);
    expect_eq("mlang", "mlang");
    EXPECT_TRUE(true);
    EXPECT_FALSE(false);

    if failures() != 0 { return 1; }
    if checks() != 6 { return 1; }
    return result();
}

#[test]
fn test_expect_helpers_record_nonfatal_failures() -> i32 {
    reset();
    set_quiet(true);

    expect_true(false);
    expect_false(true);
    expect_eq(1, 2);
    expect_eq("a", "b");

    set_quiet(false);
    if checks() != 4 { return 1; }
    if failures() != 4 { return 1; }
    return result() == 1 ? 0 : 1;
}

#[test]
fn test_verify_helpers_pass() -> i32 {
    reset();

    verify_true(10 > 2);
    verify_false(2 > 10);
    verify_eq(7, 7);
    verify_eq("ok", "ok");
    VERIFY_TRUE(true);
    VERIFY_FALSE(false);
    VERIFY_EQ(3, 3);

    if failures() != 0 { return 1; }
    return 0;
}

#[test]
fn test_mock_expectations_pass() -> i32 {
    reset();

    let m: Mock = mock_new();
    mock_expect_call(m.handle, "fetch", 2);
    mock_expect_call(m.handle, "save", 1);

    mock_called(m.handle, "fetch");
    mock_called(m.handle, "save");
    mock_called(m.handle, "fetch");

    expect_true(mock_calls(m.handle, "fetch") == 2);
    expect_true(mock_calls(m.handle, "save") == 1);
    expect_true(mock_verify(m.handle));
    mock_free(m.handle);

    if failures() != 0 { return 1; }
    return 0;
}

#[test]
fn test_mock_expectations_report_mismatch() -> i32 {
    reset();
    set_quiet(true);

    let m: Mock = mock_new();
    mock_expect_call(m.handle, "publish", 3);
    mock_called(m.handle, "publish");

    expect_false(mock_verify(m.handle));
    mock_free(m.handle);
    set_quiet(false);

    return failures() > 0 ? 0 : 1;
}
