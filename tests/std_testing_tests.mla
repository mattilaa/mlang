mod std::testing;

use std::testing::*;

#[test]
fn test_expect_helpers_pass() {
    reset();

    expect_true(1 < 2);
    expect_false(3 < 2);
    expect_eq(42, 42);
    expect_eq("mlang", "mlang");
    expect_true(true);
    expect_false(false);

    verify_eq_i32(6, checks());
    verify_eq_i32(0, failures());
    verify_eq_i32(0, result());
}

#[test]
fn test_expect_helpers_record_nonfatal_failures() {
    reset();
    set_quiet(true);

    expect_true(false);
    expect_false(true);
    expect_eq(1, 2);
    expect_eq("a", "b");

    set_quiet(false);
    verify_eq_i32(4, checks());
    verify_eq_i32(4, failures());
    verify_true(result() == 1);
}

#[test]
fn test_expect_array_helpers() {
    reset();
    set_quiet(true);

    let a_i32: list<i32> = [1, 2, 3];
    let b_i32: list<i32> = [1, 2, 3];
    let c_i32: list<i32> = [1, 2, 4];
    expect_array_eq(a_i32, b_i32);
    expect_array_eq(a_i32, b_i32);
    expect_array_eq(a_i32, c_i32);

    let a_s: list<string> = ["a", "b"];
    let b_s: list<string> = ["a", "b"];
    let c_s: list<string> = ["a", "x"];
    expect_array_eq(a_s, b_s);
    expect_array_eq(a_s, c_s);

    set_quiet(false);
    verify_true(checks() > 0);
    verify_true(failures() > 0);
}

#[test]
fn test_verify_helpers_pass() {
    reset();

    verify_true(10 > 2);
    verify_false(2 > 10);
    verify_eq(7, 7);
    verify_eq("ok", "ok");
    verify_true(true);
    verify_false(false);
    verify_eq(3, 3);

    verify_eq_i32(0, failures());
}

#[test]
fn test_verify_array_helpers_pass() {
    reset();
    let a_i64: list<i64> = [10, 20, 30];
    let b_i64: list<i64> = [10, 20, 30];
    verify_array_eq(a_i64, b_i64);
    verify_array_eq(a_i64, b_i64);

    let a_b: list<bool> = [true, false, true];
    let b_b: list<bool> = [true, false, true];
    verify_array_eq(a_b, b_b);
    verify_array_eq(a_b, b_b);
}

#[test]
fn test_mock_expectations_pass() {
    reset();

    let m: Mock = mock_new();
    mock_expect_call(m.handle, "fetch", 2);
    mock_expect_call(m.handle, "save", 1);

    mock_called(m.handle, "fetch");
    mock_called(m.handle, "save");
    mock_called(m.handle, "fetch");

    expect_true(mock_calls(m.handle, "fetch") == 2);
    expect_true(mock_calls(m.handle, "save") == 1);
    expect_true(mock_verify(m.handle));
    mock_free(m.handle);

    verify_eq_i32(0, failures());
}

#[test]
fn test_mock_expectations_report_mismatch() {
    reset();
    set_quiet(true);

    let m: Mock = mock_new();
    mock_expect_call(m.handle, "publish", 3);
    mock_called(m.handle, "publish");

    expect_false(mock_verify(m.handle));
    mock_free(m.handle);
    set_quiet(false);

    verify_true(failures() > 0);
}
