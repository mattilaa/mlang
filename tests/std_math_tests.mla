mod std::testing;
mod std::math;
mod std::numbers;
mod std::limits;

use std::math::*;
use std::numbers::pi as numbers_pi;
use std::numbers::e as numbers_e;
use std::numbers::ln2 as numbers_ln2;
use std::numbers::ln10 as numbers_ln10;
use std::numbers::log2e as numbers_log2e;
use std::numbers::log10e as numbers_log10e;
use std::numbers::inv_pi as numbers_inv_pi;
use std::numbers::inv_sqrtpi as numbers_inv_sqrtpi;
use std::numbers::sqrt2 as numbers_sqrt2;
use std::numbers::sqrt3 as numbers_sqrt3;
use std::numbers::inv_sqrt3 as numbers_inv_sqrt3;
use std::numbers::phi as numbers_phi;
use std::numbers::egamma as numbers_egamma;
use std::numbers::phi as numbers_phi;
use std::testing::verify;
use std::limits::i32_min as limits_i32_min;
use std::limits::i32_max as limits_i32_max;
use std::limits::i64_min as limits_i64_min;
use std::limits::i64_max as limits_i64_max;

fn approx_float(a: f32, b: f32, eps: f32) -> bool {
    var diff: f32 = a - b;
    if diff < 0.0f: {
        diff = 0.0f - diff;
    }
    return diff <= eps;
}

fn approx_double(a: f64, b: f64, eps: f64) -> bool {
    var diff: f64 = a - b;
    if diff < 0.0: {
        diff = 0.0 - diff;
    }
    return diff <= eps;
}

#[test]
fn test_cpp20_numbers_constants() {
    let eps: f64 = 0.000000000001;
    verify(approx_double(numbers_e(), 2.718281828459045, eps));
    verify(approx_double(numbers_ln2(), 0.6931471805599453, eps));
    verify(approx_double(numbers_ln10(), 2.302585092994046, eps));
    verify(approx_double(numbers_log2e(), 1.4426950408889634, eps));
    verify(approx_double(numbers_log10e(), 0.4342944819032518, eps));
    verify(approx_double(numbers_pi(), 3.141592653589793, eps));
    verify(approx_double(numbers_inv_pi(), 0.3183098861837907, eps));
    verify(approx_double(numbers_inv_sqrtpi(), 0.5641895835477563, eps));
    verify(approx_double(numbers_sqrt2(), 1.4142135623730951, eps));
    verify(approx_double(numbers_sqrt3(), 1.7320508075688772, eps));
    verify(approx_double(numbers_inv_sqrt3(), 0.5773502691896257, eps));
    verify(approx_double(numbers_egamma(), 0.5772156649015329, eps));
    verify(approx_double(numbers_phi(), 1.618033988749895, eps));
}

#[test]
fn test_math_int() {
    verify(!(add(2, 3) != 5));
    verify(!(subtract(10, 4) != 6));
    verify(!(multiply(3, 7) != 21));
    verify(!(square(6) != 36));
    verify(!(sum_range(1, 5) != 10));
    verify(!(factorial(5) != 120));

    verify(!(abs(0 - 9) != 9));
    verify(!(min(4, 9) != 4));
    verify(!(max(4, 9) != 9));
    verify(!(clamp(7, 0, 5) != 5));
    verify(!(pow(2, 3) != 8));
    verify(!(sqrt(81) != 9));

    verify(!(sin(0) != 0));
    verify(!(cos(0) != 1));
    verify(!(tan(0) != 0));
    verify(!(floor(7) != 7));
    verify(!(ceil(7) != 7));
    verify(!(round(7) != 7));
    verify(!(log(1) != 0));
    verify(!(exp(0) != 1));
    verify(!(modulo(17, 5) != 2));

    }

#[test]
fn test_math_f32() {
    let eps: f32 = 0.0001f;
    verify(!(!approx_float(add(2.5f, 3.25f), 5.75f, eps)));
    verify(!(!approx_float(subtract(5.5f, 2.0f), 3.5f, eps)));
    verify(!(!approx_float(multiply(2.0f, 3.5f), 7.0f, eps)));
    verify(!(!approx_float(square(4.0f), 16.0f, eps)));

    verify(!(!approx_float(abs(0.0f - 3.5f), 3.5f, eps)));
    verify(!(!approx_float(min(1.5f, 2.5f), 1.5f, eps)));
    verify(!(!approx_float(max(1.5f, 2.5f), 2.5f, eps)));
    verify(!(!approx_float(clamp(2.75f, 0.5f, 2.0f), 2.0f, eps)));
    verify(!(!approx_float(pow(2.0f, 3.0f), 8.0f, eps)));
    verify(!(!approx_float(sqrt(9.0f), 3.0f, eps)));

    verify(!(!approx_float(sin(0.0f), 0.0f, eps)));
    verify(!(!approx_float(cos(0.0f), 1.0f, eps)));
    verify(!(!approx_float(tan(0.0f), 0.0f, eps)));
    verify(!(!approx_float(floor(2.7f), 2.0f, eps)));
    verify(!(!approx_float(ceil(2.2f), 3.0f, eps)));
    verify(!(!approx_float(round(2.4f), 2.0f, eps)));
    verify(!(!approx_float(log(exp(1.0f)), 1.0f, 0.001f)));
    verify(!(!approx_float(exp(0.0f), 1.0f, eps)));
    verify(!(!approx_float(modulo(5.5f, 2.0f), 1.5f, eps)));

    }

#[test]
fn test_math_f64() {
    let eps: f64 = 0.0000001;
    verify(!(!approx_double(add(2.5, 3.25), 5.75, eps)));
    verify(!(!approx_double(subtract(5.5, 2.0), 3.5, eps)));
    verify(!(!approx_double(multiply(2.0, 3.5), 7.0, eps)));
    verify(!(!approx_double(square(4.0), 16.0, eps)));

    verify(!(!approx_double(abs(0.0 - 3.5), 3.5, eps)));
    verify(!(!approx_double(min(1.5, 2.5), 1.5, eps)));
    verify(!(!approx_double(max(1.5, 2.5), 2.5, eps)));
    verify(!(!approx_double(clamp(2.75, 0.5, 2.0), 2.0, eps)));
    verify(!(!approx_double(pow(2.0, 3.0), 8.0, eps)));
    verify(!(!approx_double(sqrt(9.0), 3.0, eps)));

    verify(!(!approx_double(sin(0.0), 0.0, eps)));
    verify(!(!approx_double(cos(0.0), 1.0, eps)));
    verify(!(!approx_double(tan(0.0), 0.0, eps)));
    verify(!(!approx_double(floor(2.7), 2.0, eps)));
    verify(!(!approx_double(ceil(2.2), 3.0, eps)));
    verify(!(!approx_double(round(2.4), 2.0, eps)));
    verify(!(!approx_double(log(exp(1.0)), 1.0, 0.0001)));
    verify(!(!approx_double(exp(0.0), 1.0, eps)));
    verify(!(!approx_double(modulo(5.5, 2.0), 1.5, eps)));

}

#[test]
fn test_cpp20_lerp_interpolation() {
    verify(approx_float(lerp(2.0f, 6.0f, 0.25f), 3.0f, 0.00001f));
    verify(lerp(2.0f, 6.0f, 0.0f) == 2.0f);
    verify(lerp(2.0f, 6.0f, 1.0f) == 6.0f);
    verify(approx_float(lerp(2.0f, 6.0f, 1.5f), 8.0f, 0.00001f));

    verify(approx_double(lerp(-1.0, 1.0, 0.25), -0.5, 0.000000000001));
    verify(lerp(-1000000000000.0, 1000000000000.0, 0.5) == 0.0);
    verify(lerp(1000000000000.0, 2000000000000.0, 0.0) == 1000000000000.0);
    verify(lerp(1000000000000.0, 2000000000000.0, 1.0) == 2000000000000.0);
}

#[test]
fn test_cpp20_hypot_stable_norm() {
    verify(approx_float(hypot(3.0f, 4.0f), 5.0f, 0.00001f));
    verify(approx_double(hypot(5.0, 12.0), 13.0, 0.000000000001));

    let large: f32 = 200000000000000000000000000000000000000.0f;
    let large_norm: f32 = hypot(large, large);
    verify(large_norm > large);
    verify(large_norm < 340000000000000000000000000000000000000.0f);

    let tiny: f32 = 0.000000000000000000000000000001f;
    verify(hypot(tiny, tiny) > tiny);
}

#[test]
fn test_fma_fused_multiply_add() {
    verify(fma(2.0f, 3.0f, 4.0f) == 10.0f);
    verify(fma(2.0, 3.0, 4.0) == 10.0);

    let large: f32 = 200000000000000000000000000000000000000.0f;
    let fused: f32 = fma(large, 2.0f, 0.0f - large);
    verify(fused == large);
}

#[test]
fn test_cpp_math_float_classification_and_nextafter() {
    let next_f32: f32 = nextafter(1.0f, 2.0f);
    let next_f64: f64 = nextafter(1.0, 2.0);
    verify(next_f32 > 1.0f && next_f32 < 2.0f);
    verify(next_f64 > 1.0 && next_f64 < 2.0);

    verify(isfinite(next_f32) && isfinite(next_f64));
    let infinity: f64 = exp(1000.0);
    verify(isinf(infinity) && !isfinite(infinity));
    let nan: f64 = sqrt(0.0 - 1.0);
    verify(isnan(nan) && !isfinite(nan));
    verify(signbit(0.0f - 1.0f) && !signbit(1.0));
}

#[test]
fn test_cpp20_midpoint() {
    verify(midpoint(0, 1) == 0);
    verify(midpoint(1, 0) == 1);
    verify(midpoint(-2, -1) == -2);
    verify(midpoint(-1, -2) == -1);
    verify(midpoint(limits_i32_min(), limits_i32_max()) == -1);
    verify(midpoint(limits_i64_min(), limits_i64_max()) == -1);
    verify(midpoint(2.0f, 6.0f) == 4.0f);
    verify(midpoint(-1000000000000.0, 1000000000000.0) == 0.0);
}

#[test]
fn test_complex_i32_ops() {
    let a1: Complex<i32> = Complex<i32> { re: 2, im: 3 };
    let b1: Complex<i32> = Complex<i32> { re: 4, im: 5 };
    let s: Complex<i32> = a1 + b1;
    verify(!(s.re != 6));
    verify(!(s.im != 8));

    let b2: Complex<i32> = Complex<i32> { re: 4, im: 5 };
    let a2: Complex<i32> = Complex<i32> { re: 2, im: 3 };
    let d: Complex<i32> = b2 - a2;
    verify(!(d.re != 2));
    verify(!(d.im != 2));

    let a3: Complex<i32> = Complex<i32> { re: 2, im: 3 };
    let b3: Complex<i32> = Complex<i32> { re: 4, im: 5 };
    let p: Complex<i32> = a3 * b3;
    verify(!(p.re != -7));
    verify(!(p.im != 22));

    let a4: Complex<i32> = Complex<i32> { re: 2, im: 3 };
    let c: Complex<i32> = a4.conj();
    verify(!(c.re != 2));
    verify(!(c.im != -3));

    let a5: Complex<i32> = Complex<i32> { re: 2, im: 3 };
    let n: i32 = a5.norm_sqr();
    verify(!(n != 13));

    let a6: Complex<i32> = Complex<i32> { re: 2, im: 3 };
    let neg: Complex<i32> = -a6;
    verify(!(neg.re != -2));
    verify(!(neg.im != -3));

    }

#[test]
fn test_complex_f64_division() {
    let numerator: Complex<f64> = Complex<f64> { re: 7.0, im: 5.0 };
    let denominator: Complex<f64> = Complex<f64> { re: 2.0, im: -3.0 };
    let quotient: Complex<f64> = numerator / denominator;
    verify(approx_double(quotient.re, -1.0 / 13.0, 0.000000000001));
    verify(approx_double(quotient.im, 31.0 / 13.0, 0.000000000001));
}

#[test]
fn test_complex_norm() {
    let z: Complex<f64> = Complex<f64> { re: 3.0, im: 4.0 };
    verify(z.norm() == 25.0);
}

#[test]
fn test_atan2_f64() {
    let angle: f64 = atan2(4.0, 3.0);
    verify(angle > 0.92729 && angle < 0.92730);
}

#[test]
fn test_complex_argument() {
    let z: Complex<f64> = Complex<f64> { re: 3.0, im: 4.0 };
    verify(z.arg() > 0.92729 && z.arg() < 0.92730);
}

#[test]
fn test_complex_polar_construction() {
    let phase: f64 = atan2(4.0, 3.0);
    let z: Complex<f64> = polar(5.0, phase);
    verify(approx_double(z.re, 3.0, 0.000001));
    verify(approx_double(z.im, 4.0, 0.000001));

    let unit: Complex<f32> = polar(1.0f, 0.0f);
    verify(unit.re == 1.0f && unit.im == 0.0f);
}

#[test]
fn test_complex_exp() {
    let zero: Complex<f64> = Complex<f64> { re: 0.0, im: 0.0 };
    let exp_zero: Complex<f64> = exp(zero);
    verify(exp_zero.re == 1.0 && exp_zero.im == 0.0);
    let zero32: Complex<f32> = Complex<f32> { re: 0.0f, im: 0.0f };
    let exp_zero32: Complex<f32> = exp(zero32);
    verify(exp_zero32.re == 1.0f && exp_zero32.im == 0.0f);
}

#[test]
fn test_complex_log() {
    let z: Complex<f64> = Complex<f64> { re: 3.0, im: 4.0 };
    let logarithm: Complex<f64> = log(z);
    verify(approx_double(logarithm.re, log(5.0), 0.000001));
    verify(logarithm.im > 0.92729 && logarithm.im < 0.92730);
}

#[test]
fn test_complex_sqrt() {
    let zero: Complex<f64> = Complex<f64> { re: 0.0, im: 0.0 };
    let zero_root: Complex<f64> = sqrt(zero);
    verify(zero_root.re == 0.0 && zero_root.im == 0.0);

    let negative: Complex<f64> = Complex<f64> { re: -1.0, im: 0.0 };
    let root: Complex<f64> = sqrt(negative);
    verify(approx_double(root.re, 0.0, 0.000001));
    verify(approx_double(root.im, 1.0, 0.000001));
}

#[test]
fn test_complex_sqrt_negative_imaginary_zero() {
    let negative_lower: Complex<f64> = Complex<f64> { re: -1.0, im: -0.0 };
    let lower_root: Complex<f64> = sqrt(negative_lower);
    verify(lower_root.im <= 0.0);
}

#[test]
fn test_complex_f32_abs() {
    let eps: f32 = 0.0001f;
    let z: Complex<f32> = Complex<f32> { re: 3.0f, im: 4.0f };
    verify(!(!approx_float(z.abs(), 5.0f, eps)));
    }

#[test]
fn test_complex_u32_add_mul() {
    let a1: Complex<u32> = Complex<u32> { re: 2, im: 3 };
    let b1: Complex<u32> = Complex<u32> { re: 4, im: 5 };
    let s: Complex<u32> = a1 + b1;
    verify(!(s.re != 6));
    verify(!(s.im != 8));

    let a2: Complex<u32> = Complex<u32> { re: 2, im: 3 };
    let b2: Complex<u32> = Complex<u32> { re: 4, im: 5 };
    let p: Complex<u32> = a2 * b2;
    verify(!(p.re != 4294967289)); // wraps on u32 for 8-15
    verify(!(p.im != 22));
    }

#[test]
fn test_complex_i64_add_mul() {
    let a1: Complex<i64> = Complex<i64> { re: 2, im: 3 };
    let b1: Complex<i64> = Complex<i64> { re: 4, im: 5 };
    let s: Complex<i64> = a1 + b1;
    verify(!(s.re != 6));
    verify(!(s.im != 8));

    let a2: Complex<i64> = Complex<i64> { re: 2, im: 3 };
    let b2: Complex<i64> = Complex<i64> { re: 4, im: 5 };
    let p: Complex<i64> = a2 * b2;
    verify(!(p.re != -7));
    verify(!(p.im != 22));
    }

#[test]
fn test_complex_u64_add_mul() {
    let a1: Complex<u64> = Complex<u64> { re: 2, im: 3 };
    let b1: Complex<u64> = Complex<u64> { re: 4, im: 5 };
    let s: Complex<u64> = a1 + b1;
    verify(!(s.re != 6));
    verify(!(s.im != 8));

    let a2: Complex<u64> = Complex<u64> { re: 2, im: 3 };
    let b2: Complex<u64> = Complex<u64> { re: 4, im: 5 };
    let p: Complex<u64> = a2 * b2;
    verify(!(p.re + 7 != 0)); // wraps on u64 for 8-15
    verify(!(p.im != 22));
    }
