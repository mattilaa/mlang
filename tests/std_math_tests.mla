mod std::math;

use std::math::*;

fn approx_float(a: float, b: float, eps: float) -> bool {
    var diff: float = a - b;
    if diff < 0.0f: {
        diff = 0.0f - diff;
    }
    return diff <= eps;
}

fn approx_double(a: double, b: double, eps: double) -> bool {
    var diff: double = a - b;
    if diff < 0.0: {
        diff = 0.0 - diff;
    }
    return diff <= eps;
}

#[test]
fn test_math_int() -> i32 {
    if add(2, 3) != 5: { return 1; }
    if subtract(10, 4) != 6: { return 1; }
    if multiply(3, 7) != 21: { return 1; }
    if square(6) != 36: { return 1; }
    if sum_range(1, 5) != 10: { return 1; }
    if factorial(5) != 120: { return 1; }

    if abs(0 - 9) != 9: { return 1; }
    if min(4, 9) != 4: { return 1; }
    if max(4, 9) != 9: { return 1; }
    if clamp(7, 0, 5) != 5: { return 1; }
    if pow(2, 3) != 8: { return 1; }
    if sqrt(81) != 9: { return 1; }

    if sin(0) != 0: { return 1; }
    if cos(0) != 1: { return 1; }
    if tan(0) != 0: { return 1; }
    if floor(7) != 7: { return 1; }
    if ceil(7) != 7: { return 1; }
    if round(7) != 7: { return 1; }
    if log(1) != 0: { return 1; }
    if exp(0) != 1: { return 1; }
    if modulo(17, 5) != 2: { return 1; }

    return 0;
}

#[test]
fn test_math_float() -> i32 {
    let eps: float = 0.0001f;
    if !approx_float(add(2.5f, 3.25f), 5.75f, eps): { return 1; }
    if !approx_float(subtract(5.5f, 2.0f), 3.5f, eps): { return 1; }
    if !approx_float(multiply(2.0f, 3.5f), 7.0f, eps): { return 1; }
    if !approx_float(square(4.0f), 16.0f, eps): { return 1; }

    if !approx_float(abs(0.0f - 3.5f), 3.5f, eps): { return 1; }
    if !approx_float(min(1.5f, 2.5f), 1.5f, eps): { return 1; }
    if !approx_float(max(1.5f, 2.5f), 2.5f, eps): { return 1; }
    if !approx_float(clamp(2.75f, 0.5f, 2.0f), 2.0f, eps): { return 1; }
    if !approx_float(pow(2.0f, 3.0f), 8.0f, eps): { return 1; }
    if !approx_float(sqrt(9.0f), 3.0f, eps): { return 1; }

    if !approx_float(sin(0.0f), 0.0f, eps): { return 1; }
    if !approx_float(cos(0.0f), 1.0f, eps): { return 1; }
    if !approx_float(tan(0.0f), 0.0f, eps): { return 1; }
    if !approx_float(floor(2.7f), 2.0f, eps): { return 1; }
    if !approx_float(ceil(2.2f), 3.0f, eps): { return 1; }
    if !approx_float(round(2.4f), 2.0f, eps): { return 1; }
    if !approx_float(log(exp(1.0f)), 1.0f, 0.001f): { return 1; }
    if !approx_float(exp(0.0f), 1.0f, eps): { return 1; }
    if !approx_float(modulo(5.5f, 2.0f), 1.5f, eps): { return 1; }

    return 0;
}

#[test]
fn test_math_double() -> i32 {
    let eps: double = 0.0000001;
    if !approx_double(add(2.5, 3.25), 5.75, eps): { return 1; }
    if !approx_double(subtract(5.5, 2.0), 3.5, eps): { return 1; }
    if !approx_double(multiply(2.0, 3.5), 7.0, eps): { return 1; }
    if !approx_double(square(4.0), 16.0, eps): { return 1; }

    if !approx_double(abs(0.0 - 3.5), 3.5, eps): { return 1; }
    if !approx_double(min(1.5, 2.5), 1.5, eps): { return 1; }
    if !approx_double(max(1.5, 2.5), 2.5, eps): { return 1; }
    if !approx_double(clamp(2.75, 0.5, 2.0), 2.0, eps): { return 1; }
    if !approx_double(pow(2.0, 3.0), 8.0, eps): { return 1; }
    if !approx_double(sqrt(9.0), 3.0, eps): { return 1; }

    if !approx_double(sin(0.0), 0.0, eps): { return 1; }
    if !approx_double(cos(0.0), 1.0, eps): { return 1; }
    if !approx_double(tan(0.0), 0.0, eps): { return 1; }
    if !approx_double(floor(2.7), 2.0, eps): { return 1; }
    if !approx_double(ceil(2.2), 3.0, eps): { return 1; }
    if !approx_double(round(2.4), 2.0, eps): { return 1; }
    if !approx_double(log(exp(1.0)), 1.0, 0.0001): { return 1; }
    if !approx_double(exp(0.0), 1.0, eps): { return 1; }
    if !approx_double(modulo(5.5, 2.0), 1.5, eps): { return 1; }

    return 0;
}
