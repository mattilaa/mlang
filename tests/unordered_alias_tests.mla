mod std::testing;
mod std::unordered;
use std::unordered::*;
use std::testing::verify;

#[test]
fn test_unordered_map_alias_basic() {
    let scores: UnorderedMap<string, i32> =
        UnorderedMap<string, i32> { data: {"Alice": 95, "Bob": 87} };
    let raw: map<string, i32> = scores.data;
    verify(raw["Alice"] == 95);
}

#[test]
fn test_unordered_set_alias_membership_flags() {
    var data: list<i32> = [];
    data.push(7);
    data.push(8);
    data.push(7);

    if data.contains(7) == false {
        verify(false);
    }
    if data.contains(9) {
        verify(false);
    }
    let seen: UnorderedSet<i32> = UnorderedSet<i32> { data: data };
    let check: list<i32> = seen.data;
    if check.len() != 3 { verify(false); }
    }

#[test]
fn test_vector_alias_methods() {
    var data: list<i32> = [];
    data.push(7);
    data.push(8);
    data.push(9);
    let ids: Vector<i32> = Vector<i32> { data: data };
    let check: list<i32> = ids.data;
    verify(check.len() == 3);
}
