mod std::testing;
mod std::fs;
mod std::log;
mod std::thread;

use std::fs::File;
use std::fs::write_all_text;
use std::log::Log;
use std::testing::verify;
use std::thread::join;

fn file_size(path: str8) -> i64 {
    let opened: Result<File, str8> = File::open(path);
    if opened.is_err() { return -1; }
    let f: File = opened.unwrap();
    let sr: Result<i64, str8> = f.size();
    let _ = f.close();
    if sr.is_err() { return -1; }
    return sr.unwrap();
}

#[test]
fn test_log_writes_return_counts() {
    let n1: i64 = std::log::out("std_log_out_test");
    let n2: i64 = std::log::warn("std_log_warn_test");
    let n3: i64 = std::log::err("std_log_err_test");
    verify(n1 > 0);
    verify(n2 > 0);
    verify(n3 > 0);
}

#[test]
fn test_log_forward_all_to_file() {
    let path: str8 = "/tmp/mlang_std_log_all_test.log";
    let _clean = write_all_text(path, "");

    verify(std::log::forward_all_to_file(path) == 0);
    let n1: i64 = std::log::out("log-all-out");
    let n2: i64 = std::log::warn("log-all-warn");
    let n3: i64 = std::log::err("log-all-err");
    verify(std::log::clear_forwarding() == 0);
    if n1 <= 0 || n2 <= 0 || n3 <= 0 { verify(false); }
    verify(file_size(path) == 48);
}

#[test]
fn test_log_forward_single_level_to_file() {
    let out_path: str8 = "/tmp/mlang_std_log_out_only_test.log";
    let err_path: str8 = "/tmp/mlang_std_log_err_only_test.log";
    let _clean_out = write_all_text(out_path, "");
    let _clean_err = write_all_text(err_path, "");

    verify(std::log::forward_out_to_file(out_path) == 0);
    verify(std::log::forward_err_to_file(err_path) == 0);
    std::log::out("only-out-forwarded");
    std::log::warn("not-forwarded-to-these-files");
    std::log::err("only-err-forwarded");
    verify(std::log::clear_forwarding() == 0);
    verify(file_size(out_path) == 19);
    verify(file_size(err_path) == 24);
}

#[test]
fn test_log_can_change_output_path() {
    let first_path: str8 = "/tmp/mlang_std_log_change_first.log";
    let second_path: str8 = "/tmp/mlang_std_log_change_second.log";
    let _clean_first = write_all_text(first_path, "");
    let _clean_second = write_all_text(second_path, "");

    verify(std::log::set_output_path(first_path) == 0);
    std::log::out("first");
    verify(std::log::set_output_path(second_path) == 0);
    std::log::out("second");
    verify(std::log::reset_output_path() == 0);

    verify(file_size(first_path) == 6);
    verify(file_size(second_path) == 7);
}

fn shared_log_writer(handle: i64, iterations: i64) -> i32 {
    let logger: Log = Log { handle: handle };
    var i: i64 = 0;
    while i < iterations {
        let written: i64 = logger.out("thread-safe");
        if written != 12 { return 1; }
        i = i + 1;
    }
    return 0;
}

#[test]
fn test_created_log_has_initial_output_path() {
    let path: str8 = "/tmp/mlang_std_log_created_path.log";
    let _clean = write_all_text(path, "");

    let lr: Result<Log, str8> = Log::with_output_path(path);
    if lr.is_err() { verify(false); return; }
    let logger: Log = lr.unwrap();
    logger.out("created");
    logger.warn("created-warn");
    logger.err("created-err");
    verify(logger.close() == 0);

    verify(file_size(path) == 44);
}

#[test]
fn test_log_thread_safe_file_forwarding() {
    let path: str8 = "/tmp/mlang_std_log_thread_safe.log";
    let _clean = write_all_text(path, "");

    let lr: Result<Log, str8> = Log::with_output_path(path);
    if lr.is_err() { verify(false); return; }
    let logger: Log = lr.unwrap();
    let handle: i64 = logger.handle;

    let h1: Handle<Thread> = thread_spawn(shared_log_writer, handle, 20);
    let h2: Handle<Thread> = thread_spawn(shared_log_writer, handle, 20);
    let h3: Handle<Thread> = thread_spawn(shared_log_writer, handle, 20);
    let h4: Handle<Thread> = thread_spawn(shared_log_writer, handle, 20);

    let rc1: i32 = join(h1);
    let rc2: i32 = join(h2);
    let rc3: i32 = join(h3);
    let rc4: i32 = join(h4);
    verify(logger.close() == 0);

    verify(rc1 == 0);
    verify(rc2 == 0);
    verify(rc3 == 0);
    verify(rc4 == 0);
    verify(file_size(path) == 960);
}

#[test]
fn test_log_module_timestamps() {
    let path: str8 = "/tmp/mlang_std_log_timestamp_module_test.log";
    let _clean = write_all_text(path, "");

    verify(std::log::set_output_path(path) == 0);
    verify(std::log::enable_timestamps() == 0);
    let written: i64 = std::log::out("timestamped");
    verify(std::log::disable_timestamps() == 0);
    verify(std::log::reset_output_path() == 0);

    verify(written == 34);
    verify(file_size(path) == 34);
}

#[test]
fn test_created_log_can_enable_timestamps_at_creation() {
    let path: str8 = "/tmp/mlang_std_log_timestamp_created_test.log";
    let _clean = write_all_text(path, "");

    let lr: Result<Log, str8> = Log::with_options(path, 1);
    if lr.is_err() { verify(false); return; }
    let logger: Log = lr.unwrap();
    let n1: i64 = logger.out("created-ts");
    let n2: i64 = logger.warn("created-warn-ts");
    verify(logger.close() == 0);

    verify(n1 == 33);
    verify(n2 == 44);
    verify(file_size(path) == 77);
}
