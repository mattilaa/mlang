mod std::io;
mod std::strbuf;

use std::io::*;
use std::strbuf::*;

#[test]
fn test_read_write_seek_cursor() -> i32 {
    let w = as_write(cursor_with_capacity(16));
    if write(w, "hello world") != 11: {
        return 1;
    }

    var out = with_capacity(32);
    let r = as_read(cursor_from_string("hello world"));
    if read(r, out, 32) != 11: {
        free(out);
        return 1;
    }

    let ok = eq(out, "hello world");
    free(out);
    return ok == 1 ? 0 : 1;
}

#[test]
fn test_bufread_lines_cursor() -> i32 {
    let c = cursor_from_string("alpha\nbeta\n");
    var line = with_capacity(16);
    let n1 = read_line(as_buf_read(c), line, 16);
    if n1 != 5: {
        free(line);
        return 1;
    }
    if eq(line, "alpha") != 1: {
        free(line);
        return 1;
    }

    free(line);
    return 0;
}

#[test]
fn test_cursor_to_string() -> i32 {
    let snapshot = to_string(cursor_from_string("abc"));
    let ok = eq(snapshot, "abc");

    free(snapshot);
    return ok == 1 ? 0 : 1;
}
