mod std::testing;
mod std::strbuf;

use std::strbuf::*;
use std::testing::verify;

extern fn snprintf(dst: str8, size: i64, fmt: str8, ...) -> i32;
extern fn strcmp(a: str8, b: str8) -> i32;

fn test_string_new_and_free_impl() -> i32 {
    let s = String::new();
    let ok: i32 = strcmp(s, "");
    String::free(s);
    return ok == 0 ? 0 : 1;
}

#[test]
fn test_string_new_and_free() {
    verify(test_string_new_and_free_impl() == 0);
}

fn test_string_with_capacity_and_write_impl() -> i32 {
    var s = with_capacity(32);
    snprintf(s, 32, "n=%d", 7);
    let ok: i32 = strcmp(s, "n=7");
    free(s);
    return ok == 0 ? 0 : 1;
}

#[test]
fn test_string_with_capacity_and_write() {
    verify(test_string_with_capacity_and_write_impl() == 0);
}

fn test_string_utils_and_utf_impl() -> i32 {
    let s = concat("he", "llo");
    if len(s) != 5: { return 1; }
    if is_empty(s) != 0: { return 1; }
    if eq(s, "hello") != 1: { return 1; }
    if starts_with(s, "he") != 1: { return 1; }
    if ends_with(s, "lo") != 1: { return 1; }
    if contains(s, "ell") != 1: { return 1; }
    if find(s, "ell") != 1: { return 1; }
    if rfind(s, "l") != 3: { return 1; }
    if compare(s, "hello") != 0: { return 1; }

    let rep = repeat("xo", 3);
    if eq(rep, "xoxoxo") != 1: { return 1; }

    let utf16_buf = to_utf16(s);
    let back = to_utf8(utf16_buf);
    if eq(back, "hello") != 1: { return 1; }

    free_utf16(utf16_buf);
    free(back);
    free(rep);
    free(s);
    return 0;
}

#[test]
fn test_string_utils_and_utf() {
    verify(test_string_utils_and_utf_impl() == 0);
}

fn test_string_sub_bounds_impl() -> i32 {
    let s = clone("abcdef");
    let mid = sub(s, 2, 3);
    if eq(mid, "cde") != 1: { return 1; }

    let to_end = sub(s, 4, 99);
    if eq(to_end, "ef") != 1: { return 1; }

    let clamped = sub(s, -5, 2);
    if eq(clamped, "ab") != 1: { return 1; }

    let empty1 = sub(s, 99, 2);
    if eq(empty1, "") != 1: { return 1; }

    let empty2 = sub(s, 1, -3);
    if eq(empty2, "") != 1: { return 1; }

    free(empty2);
    free(empty1);
    free(clamped);
    free(to_end);
    free(mid);
    free(s);
    return 0;
}

#[test]
fn test_string_sub_bounds() {
    verify(test_string_sub_bounds_impl() == 0);
}

fn test_string_pad_helpers_impl() -> i32 {
    let base = clone("abc");
    let l = pad_left(base, 6, "0");
    let r = pad_right(base, 6, ".");
    let same_l = pad_left(base, 3, " ");
    let same_r = pad_right(base, 2, " ");
    let num_l = pad_i64_left(18, 4, " ");
    let num_r = pad_i64_right(18, 4, ".");
    let num_z = zpad_i64(7, 3);
    let fit_same = fit_right("abc", 3, " ");
    let fit_pad = fit_right("abc", 5, ".");
    let fit_cut = fit_right("abcdef", 4, " ");

    if eq(l, "000abc") != 1 { free(fit_cut); free(fit_pad); free(fit_same); free(num_z); free(num_r); free(num_l); free(same_r); free(same_l); free(r); free(l); free(base); return 1; }
    if eq(r, "abc...") != 1 { free(fit_cut); free(fit_pad); free(fit_same); free(num_z); free(num_r); free(num_l); free(same_r); free(same_l); free(r); free(l); free(base); return 1; }
    if eq(same_l, "abc") != 1 { free(fit_cut); free(fit_pad); free(fit_same); free(num_z); free(num_r); free(num_l); free(same_r); free(same_l); free(r); free(l); free(base); return 1; }
    if eq(same_r, "abc") != 1 { free(fit_cut); free(fit_pad); free(fit_same); free(num_z); free(num_r); free(num_l); free(same_r); free(same_l); free(r); free(l); free(base); return 1; }
    if eq(num_l, "  18") != 1 { free(fit_cut); free(fit_pad); free(fit_same); free(num_z); free(num_r); free(num_l); free(same_r); free(same_l); free(r); free(l); free(base); return 1; }
    if eq(num_r, "18..") != 1 { free(fit_cut); free(fit_pad); free(fit_same); free(num_z); free(num_r); free(num_l); free(same_r); free(same_l); free(r); free(l); free(base); return 1; }
    if eq(num_z, "007") != 1 { free(fit_cut); free(fit_pad); free(fit_same); free(num_z); free(num_r); free(num_l); free(same_r); free(same_l); free(r); free(l); free(base); return 1; }
    if eq(fit_same, "abc") != 1 { free(fit_cut); free(fit_pad); free(fit_same); free(num_z); free(num_r); free(num_l); free(same_r); free(same_l); free(r); free(l); free(base); return 1; }
    if eq(fit_pad, "abc..") != 1 { free(fit_cut); free(fit_pad); free(fit_same); free(num_z); free(num_r); free(num_l); free(same_r); free(same_l); free(r); free(l); free(base); return 1; }
    if eq(fit_cut, "abcd") != 1 { free(fit_cut); free(fit_pad); free(fit_same); free(num_z); free(num_r); free(num_l); free(same_r); free(same_l); free(r); free(l); free(base); return 1; }

    free(fit_cut);
    free(fit_pad);
    free(fit_same);
    free(num_z);
    free(num_r);
    free(num_l);
    free(same_r);
    free(same_l);
    free(r);
    free(l);
    free(base);
    return 0;
}

#[test]
fn test_string_pad_helpers() {
    verify(test_string_pad_helpers_impl() == 0);
}

fn test_string_wrap_words_impl() -> i32 {
    let lines: list<str8> = wrap_words("alpha beta gamma", 10);
    if lines.len() != 2 { return 1; }
    if eq(lines[0], "alpha beta") != 1 { return 1; }
    if eq(lines[1], "gamma") != 1 { return 1; }
    return 0;
}

#[test]
fn test_string_wrap_words() {
    verify(test_string_wrap_words_impl() == 0);
}

fn test_string_builder_dynamic_growth_and_take_impl() -> i32 {
    var b: StringBuilder = builder_with_page(2, 4);
    if builder_is_valid(b) != 1 { return 1; }
    if builder_append(b, "ab") != 2 { builder_free(b); return 1; }
    if builder_append_char(b, 99) != 1 { builder_free(b); return 1; } // 'c'
    if builder_append(b, "defghijklmnop") != 13 { builder_free(b); return 1; }
    if builder_len(b) != 16 { builder_free(b); return 1; }
    if builder_capacity(b) < 16 { builder_free(b); return 1; }

    let s: str8 = builder_take_string(b);
    if eq(s, "abcdefghijklmnop") != 1 { free(s); builder_free(b); return 1; }
    if builder_len(b) != 0 { free(s); builder_free(b); return 1; }
    free(s);
    builder_free(b);
    return 0;
}

#[test]
fn test_string_builder_dynamic_growth_and_take() {
    verify(test_string_builder_dynamic_growth_and_take_impl() == 0);
}

fn test_string_builder_reserve_clear_and_clone_impl() -> i32 {
    var b: StringBuilder = builder_new(0);
    if builder_is_valid(b) != 1 { return 1; }
    if builder_reserve(b, 64) != 0 { builder_free(b); return 1; }
    if builder_capacity(b) < 64 { builder_free(b); return 1; }
    if builder_append(b, "hello") != 5 { builder_free(b); return 1; }

    let c: str8 = builder_to_string(b);
    if eq(c, "hello") != 1 { free(c); builder_free(b); return 1; }
    free(c);

    if builder_clear(b) != 0 { builder_free(b); return 1; }
    if builder_len(b) != 0 { builder_free(b); return 1; }
    if builder_append_char(b, 300) != -1 { builder_free(b); return 1; }
    builder_free(b);
    return 0;
}

#[test]
fn test_string_builder_reserve_clear_and_clone() {
    verify(test_string_builder_reserve_clear_and_clone_impl() == 0);
}
