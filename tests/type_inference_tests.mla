mod std::strbuf;

use std::strbuf::*;

struct Point {
    let x: i32 = 0;
    let y: i32 = 0;
};

#[test]
fn test_infer_int_and_float() -> i32 {
    let a = 41;
    var b = 1;
    b = b + a;

    let f = 1.5f;
    var d = 2.0;
    d = d + 1.0;

    if b != 42: { return 1; }
    if f <= 1.0f: { return 1; }
    if d < 3.0: { return 1; }
    return 0;
}

#[test]
fn test_infer_list_map_tuple_struct() -> i32 {
    let nums = [1, 2, 3];
    let typed_nums: list<i32> = nums;

    let m = {"a": 3, "b": 4};
    let typed_map: map<string, i32> = m;

    let t = (7, 2.5f, 9);
    let typed_tuple: tuple<i32, f32, i32> = t;

    let p = Point { x: 3, y: 4 };
    if p.x != 3: { return 1; }
    if p.y != 4: { return 1; }
    let typed_point: Point = p;

    return 0;
}

#[test]
fn test_infer_string_alloc_style() -> i32 {
    var buffer = String::new();
    String::free(buffer);

    let tiny = new();
    free(tiny);

    var capbuf = String::with_capacity(32);
    String::free(capbuf);
    return 0;
}
