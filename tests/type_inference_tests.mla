mod std::testing;
mod std::strbuf;

use std::strbuf::*;
use std::testing::verify;

struct Point {
    let x: i32 = 0;
    let y: i32 = 0;
};

#[test]
fn test_infer_int_and_float() {
    let a = 41;
    var b = 1;
    b = b + a;

    let f = 1.5f;
    var d = 2.0;
    d = d + 1.0;

    verify(!(b != 42));
    verify(!(f <= 1.0f));
    verify(!(d < 3.0));
    }

#[test]
fn test_infer_list_map_tuple_struct() {
    let nums = [1, 2, 3];
    let typed_nums: list<i32> = nums;

    let m = {"a": 3, "b": 4};
    let typed_map: map<str8, i32> = m;

    let t = (7, 2.5f, 9);
    let typed_tuple: tuple<i32, f32, i32> = t;

    let p = Point { x: 3, y: 4 };
    verify(!(p.x != 3));
    verify(!(p.y != 4));
    let typed_point: Point = p;

    }

#[test]
fn test_infer_string_alloc_style() {
    var buffer = String::new();
    String::free(buffer);

    let tiny = new();
    free(tiny);

    var capbuf = String::with_capacity(32);
    String::free(capbuf);
    }

#[test]
fn test_infer_anonymous_object_literal_and_nested_access() {
    let view = object {
        width: 1024,
        header.title: "My App",
        header.height: 60
    };

    verify(!(view.width != 1024));
    verify(!(eq(view.header.title, "My App") != 1));
    verify(!(view.header.height != 60));
}

#[test]
fn test_infer_anonymous_object_literal_for_var_mutation() {
    var state = object {
        counter: 1,
        nested.enabled: true
    };

    state.counter = state.counter + 1;
    state.nested.enabled = false;

    verify(!(state.counter != 2));
    verify(!(state.nested.enabled != false));
}

#[test]
fn test_infer_builder_style_object_tree_and_nested_access() {
    let view = add<View>()
        | Name{"MainView"}
        | Width{1024}
        | Height{768}
        | BoundingBox{{0, 0, 1024, 768}}
        | Title{"Main Application View"}
        | add<View>(
            Name{"Header"},
            Height{60},
            Title{"Header View"},
            add<Widget>(
                Name{"AppTitle"},
                Width{200},
                Text{"My App"}
            )
        );

    let bbox = view.boundingBox;
    verify(!(view.width != 1024));
    verify(!(bbox.2 != 1024));
    verify(!(view.header.height != 60));
    verify(!(view.header.appTitle.width != 200));
    verify(!(eq(view.header.appTitle.text, "My App") != 1));
}

#[test]
fn test_infer_builder_style_http_request_example_with_headers() {
    let request = add<HttpRequest>()
        | Method{"GET"}
        | Url{"https://api.example.com/v1/items"}
        | add<Header>(
            Name{"Authorization"},
            Value{"Bearer token-123"}
        )
        | add<Header>(
            Name{"ContentType"},
            Value{"application/json"}
        );

    verify(!(eq(request.method, "GET") != 1));
    verify(!(eq(request.url, "https://api.example.com/v1/items") != 1));
    verify(!(eq(request.authorization.value, "Bearer token-123") != 1));
    verify(!(eq(request.contentType.value, "application/json") != 1));
}

#[test]
fn test_infer_builder_style_var_tree_mutation_updates_nested_data() {
    var view = add<View>()
        | Name{"MainView"}
        | Title{"Before"}
        | add<View>(
            Name{"Header"},
            Height{60},
            add<Widget>(
                Name{"AppTitle"},
                Text{"Old Title"}
            )
        );

    view.title = "After";
    view.header.height = 72;
    view.header.appTitle.text = "New Title";

    verify(!(eq(view.title, "After") != 1));
    verify(!(view.header.height != 72));
    verify(!(eq(view.header.appTitle.text, "New Title") != 1));
}

#[test]
fn test_infer_builder_style_object_json_and_pretty_json_formatting() {
    let request = add<HttpRequest>()
        | Method{"GET"}
        | Url{"https://api.example.com/v1/items"}
        | add<Body>(
            Text{"hello"}
        )
        | add<Header>(
            Name{"Authorization"},
            Value{"Bearer token-123"}
        )
        | add<Header>(
            Name{"ContentType"},
            Value{"application/json"}
        );

    let compact: str8 = format!("{:json}", request);
    let pretty: str8 = format!("{:#json}", request);

    verify(!(contains(compact, "\"type\": \"HttpRequest\"") != 1));
    verify(!(contains(compact, "\"body\": {\"type\": \"Body\",\"text\": \"hello\"}") != 1));
    verify(!(contains(compact, "\"authorization\": {\"type\": \"Header\"") != 1));
    verify(!(contains(compact, "\"method\": \"GET\"") != 1));
    verify(!(contains(compact, "\"authorization\"") != 1));
    verify(!(contains(pretty, "\n") != 1));
    verify(!(contains(pretty, "\n  \"body\": {") != 1));
    verify(!(contains(pretty, "\n    \"type\": \"Body\"") != 1));
    verify(!(contains(pretty, "\n    \"type\": \"Header\"") != 1));
    verify(!(contains(pretty, "\n  },") != 1));
    verify(!(contains(pretty, "\"contentType\"") != 1));
}
