mod std::testing;
mod std::strbuf;

use std::strbuf::*;
use std::testing::verify;

struct Point {
    let x: i32 = 0;
    let y: i32 = 0;
};

#[test]
fn test_infer_int_and_float() {
    let a = 41;
    var b = 1;
    b = b + a;

    let f = 1.5f;
    var d = 2.0;
    d = d + 1.0;

    verify(!(b != 42));
    verify(!(f <= 1.0f));
    verify(!(d < 3.0));
    }

#[test]
fn test_infer_list_map_tuple_struct() {
    let nums = [1, 2, 3];
    let typed_nums: list<i32> = nums;

    let m = {"a": 3, "b": 4};
    let typed_map: map<str8, i32> = m;

    let t = (7, 2.5f, 9);
    let typed_tuple: tuple<i32, f32, i32> = t;

    let p = Point { x: 3, y: 4 };
    verify(!(p.x != 3));
    verify(!(p.y != 4));
    let typed_point: Point = p;

    }

#[test]
fn test_infer_string_alloc_style() {
    var buffer = String::new();
    String::free(buffer);

    let tiny = new();
    free(tiny);

    var capbuf = String::with_capacity(32);
    String::free(capbuf);
    }

#[test]
fn test_infer_anonymous_object_literal_and_nested_access() {
    let view = object {
        width: 1024,
        header.title: "My App",
        header.height: 60
    };

    verify(!(view.width != 1024));
    verify(!(eq(view.header.title, "My App") != 1));
    verify(!(view.header.height != 60));
}

#[test]
fn test_infer_anonymous_object_literal_for_var_mutation() {
    var state = object {
        counter: 1,
        nested.enabled: true
    };

    state.counter = state.counter + 1;
    state.nested.enabled = false;

    verify(!(state.counter != 2));
    verify(!(state.nested.enabled != false));
}
