mod std::testing;
mod std::strbuf;

use std::strbuf::*;
use std::testing::verify;

struct Point {
    let x: i32 = 0;
    let y: i32 = 0;
};

#[test]
fn test_infer_int_and_float() {
    let a = 41;
    var b = 1;
    b = b + a;

    let f = 1.5f;
    var d = 2.0;
    d = d + 1.0;

    verify(!(b != 42));
    verify(!(f <= 1.0f));
    verify(!(d < 3.0));
    }

#[test]
fn test_infer_list_map_tuple_struct() {
    let nums = [1, 2, 3];
    let typed_nums: list<i32> = nums;

    let m = {"a": 3, "b": 4};
    let typed_map: map<string, i32> = m;

    let t = (7, 2.5f, 9);
    let typed_tuple: tuple<i32, f32, i32> = t;

    let p = Point { x: 3, y: 4 };
    verify(!(p.x != 3));
    verify(!(p.y != 4));
    let typed_point: Point = p;

    }

#[test]
fn test_infer_string_alloc_style() {
    var buffer = String::new();
    String::free(buffer);

    let tiny = new();
    free(tiny);

    var capbuf = String::with_capacity(32);
    String::free(capbuf);
    }
