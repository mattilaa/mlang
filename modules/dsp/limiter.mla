/// \file limiter.mla
/// \brief Allocation-free linked-stereo look-ahead peak limiter.
///
/// This is an original implementation based on general dynamics-processing
/// techniques. It does not contain or derive from proprietary limiter code.
///
/// @defgroup dsp_limiter dsp::limiter
/// @ingroup dsp
/// @brief Look-ahead master limiter with maximizer-style threshold and release.
/// @{

/// \cond INTERNAL_IMPORTS
mod dsp::detail;
mod std::ringbuffer;
use dsp::detail::expf;
use dsp::detail::llroundf;
use std::ringbuffer::RingBufferF32;
/// \endcond

fn limiter_clamp(value: f32, low: f32, high: f32) -> f32 {
    if value < low { return low; }
    if value > high { return high; }
    return value;
}

fn limiter_db_gain(decibels: f32) -> f32 {
    return expf(0.11512925464970228420f * decibels);
}

fn limiter_abs(value: f32) -> f32 { return value < 0.0f ? 0.0f - value : value; }

/// @brief One processed linked-stereo limiter frame.
pub struct LimiterFrame {
    var left_value: f32;
    var right_value: f32;
};

impl LimiterFrame {
    pub fn left(self: LimiterFrame) -> f32 { return self.left_value; }
    pub fn right(self: LimiterFrame) -> f32 { return self.right_value; }
}

/// @brief Stereo look-ahead peak limiter suitable for a master output.
///
/// Threshold is maximizer-style: lowering it applies makeup gain before the
/// fixed output ceiling, increasing loudness and gain reduction together.
/// Both channels share one detector and gain envelope to preserve stereo image.
pub struct StereoLimiter {
    var sample_rate_hz: f32;
    var threshold_db: f32;
    var ceiling_db: f32;
    var release_ms: f32;
    var lookahead_ms: f32;
    var threshold_gain: f32;
    var ceiling_gain: f32;
    var input_gain: f32;
    var release_coefficient: f32;
    var current_gain_value: f32;
    var hold_remaining: i64;
    var lookahead_samples: i64;
    var left_delay: RingBufferF32;
    var right_delay: RingBufferF32;
};

impl StereoLimiter {
    /// @brief Allocate a limiter with -3 dB threshold and -0.3 dB ceiling.
    pub fn new(sample_rate: f32) -> StereoLimiter {
        let safe_rate: f32 = limiter_clamp(sample_rate, 8000.0f, 384000.0f);
        let maximum_lookahead: i64 = llroundf(safe_rate * 0.020f) + 2;
        var limiter: StereoLimiter = StereoLimiter {
            sample_rate_hz: safe_rate,
            threshold_db: -3.0f,
            ceiling_db: -0.3f,
            release_ms: 120.0f,
            lookahead_ms: 5.0f,
            threshold_gain: 1.0f,
            ceiling_gain: 1.0f,
            input_gain: 1.0f,
            release_coefficient: 0.999f,
            current_gain_value: 1.0f,
            hold_remaining: 0,
            lookahead_samples: 1,
            left_delay: RingBufferF32::new(maximum_lookahead),
            right_delay: RingBufferF32::new(maximum_lookahead)
        };
        limiter.update_controls();
        return limiter;
    }

    fn update_controls(self: &mut Self) -> void {
        self.threshold_gain = limiter_db_gain(self.threshold_db);
        self.ceiling_gain = limiter_db_gain(self.ceiling_db);
        self.input_gain = self.ceiling_gain / self.threshold_gain;
        let release_samples: f32 = self.sample_rate_hz * self.release_ms / 1000.0f;
        self.release_coefficient = expf(-1.0f / release_samples);
        self.lookahead_samples = llroundf(self.sample_rate_hz * self.lookahead_ms / 1000.0f);
        if self.lookahead_samples < 0 { self.lookahead_samples = 0; }
        if self.lookahead_samples > self.left_delay.capacity() - 2 {
            self.lookahead_samples = self.left_delay.capacity() - 2;
        }
    }

    /// @brief Set maximizer threshold from -60 to 0 dB.
    pub fn set_threshold_db(self: &mut Self, value: f32) -> void {
        self.threshold_db = limiter_clamp(value, -60.0f, 0.0f);
        self.update_controls();
    }

    /// @brief Set sample-peak output ceiling from -24 to 0 dB.
    pub fn set_ceiling_db(self: &mut Self, value: f32) -> void {
        self.ceiling_db = limiter_clamp(value, -24.0f, 0.0f);
        self.update_controls();
    }

    /// @brief Set gain-recovery time from 5 to 5000 milliseconds.
    pub fn set_release_ms(self: &mut Self, value: f32) -> void {
        self.release_ms = limiter_clamp(value, 5.0f, 5000.0f);
        self.update_controls();
    }

    /// @brief Set look-ahead delay from 0 to 20 milliseconds.
    pub fn set_lookahead_ms(self: &mut Self, value: f32) -> void {
        self.lookahead_ms = limiter_clamp(value, 0.0f, 20.0f);
        self.update_controls();
    }

    /// @brief Return the current linked gain envelope in linear units.
    pub fn current_gain(self: StereoLimiter) -> f32 { return self.current_gain_value; }

    /// @brief Clear look-ahead audio and restore unity envelope gain.
    pub fn reset(self: &mut Self) -> void {
        self.left_delay.clear();
        self.right_delay.clear();
        self.current_gain_value = 1.0f;
        self.hold_remaining = 0;
    }

    /// @brief Process one stereo sample without allocation or locking.
    pub fn process_stereo(self: &mut Self, left: f32, right: f32) -> LimiterFrame {
        let driven_left: f32 = left * self.input_gain;
        let driven_right: f32 = right * self.input_gain;
        var peak: f32 = limiter_abs(driven_left);
        let right_peak: f32 = limiter_abs(driven_right);
        if right_peak > peak { peak = right_peak; }
        let target_gain: f32 = peak > self.ceiling_gain
            ? self.ceiling_gain / peak : 1.0f;

        if target_gain < self.current_gain_value {
            self.current_gain_value = target_gain;
            self.hold_remaining = self.lookahead_samples;
        } else if self.hold_remaining > 0 {
            self.hold_remaining = self.hold_remaining - 1;
        } else {
            self.current_gain_value = self.release_coefficient * self.current_gain_value +
                (1.0f - self.release_coefficient) * target_gain;
            if self.current_gain_value > 1.0f { self.current_gain_value = 1.0f; }
        }

        self.left_delay.write(driven_left);
        self.right_delay.write(driven_right);
        let delayed_left: f32 = self.left_delay.read(self.lookahead_samples + 1);
        let delayed_right: f32 = self.right_delay.read(self.lookahead_samples + 1);
        let output_left: f32 = limiter_clamp(delayed_left * self.current_gain_value,
                                               0.0f - self.ceiling_gain,
                                               self.ceiling_gain);
        let output_right: f32 = limiter_clamp(delayed_right * self.current_gain_value,
                                                0.0f - self.ceiling_gain,
                                                self.ceiling_gain);
        return LimiterFrame { left_value: output_left, right_value: output_right };
    }
}

/// @}
