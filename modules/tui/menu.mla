mod tui::geometry;
mod tui::surface;
mod tui::theme;
mod tui::widgets;
mod std::bytes;
use tui::geometry::*;
use tui::surface::*;
use tui::theme::Theme;
use tui::widgets::Panel;
use std::bytes::Bytes;

pub enum Key { Left, Right, Up, Down, Enter, Escape, Toggle };
/// action > 0 identifies an application command; 0 is reserved for no action.
pub struct MenuItem { var label: str8; var action: i32; var enabled: bool; };
pub struct Menu { var title: str8; var items: list<MenuItem>; };

fn label_width(text: str8) -> i32 {
    let raw: result<Bytes, str8> = Bytes::from_string(text);
    if raw.is_err() { return 0; }
    let bytes: Bytes = raw.unwrap();
    var count: i32 = 0;
    for i in 0..bytes.len() {
        let byte: i32 = bytes.get(i);
        if byte < 128 || byte >= 192 { count = count + 1; }
    }
    bytes.close();
    return count;
}

pub struct MenuBar { var menus: list<Menu>; var active: i32; var selected: i32; };
impl MenuBar {
    pub fn new(menus: list<Menu>) -> MenuBar {
        return MenuBar { menus: menus, active: -1, selected: -1 };
    }
    pub fn viewport(self: MenuBar, bounds: Rect) -> Viewport {
        return Viewport { bounds: bounds, has_menu: self.menus.len() > 0 };
    }
    pub fn dismiss(self: &mut Self) -> void { self.active = -1; self.selected = -1; }
    pub fn open(self: &mut Self, index: i32) -> void {
        self.dismiss();
        if index < 0 || index >= self.menus.len() { return; }
        self.active = index;
        self.move_selection(1);
    }
    fn move_selection(self: &mut Self, direction: i32) -> void {
        if self.active < 0 || self.active >= self.menus.len() { return; }
        let menu: Menu = self.menus[self.active];
        let count: i32 = i32(menu.items.len());
        if count == 0 { self.selected = -1; return; }
        var next: i32 = self.selected;
        for _i in 0..count {
            next = (next + direction + count) % count;
            let item: MenuItem = menu.items[next];
            if item.enabled && item.action > 0 { self.selected = next; return; }
        }
        self.selected = -1;
    }
    /// Returns a positive command ID on activation, otherwise zero.
    pub fn on_key(self: &mut Self, key: Key) -> i32 {
        if key == Key::Escape { self.dismiss(); return 0; }
        if key == Key::Toggle {
            if self.active >= 0 { self.dismiss(); } else { self.open(0); }
            return 0;
        }
        let count: i32 = i32(self.menus.len());
        if self.active < 0 || count == 0 { return 0; }
        if key == Key::Left { self.open((self.active + count - 1) % count); }
        else if key == Key::Right { self.open((self.active + 1) % count); }
        else if key == Key::Up { self.move_selection(-1); }
        else if key == Key::Down { self.move_selection(1); }
        else if key == Key::Enter {
            let menu: Menu = self.menus[self.active];
            if self.selected >= 0 && self.selected < menu.items.len() {
                let item: MenuItem = menu.items[self.selected];
                if item.enabled && item.action > 0 { self.dismiss(); return item.action; }
            }
        }
        return 0;
    }
    pub fn popup_rect(self: MenuBar, bounds: Rect) -> Rect {
        if self.active < 0 || self.active >= self.menus.len() || bounds.height < 2 {
            return Rect::new(bounds.x, bounds.y, 0, 0);
        }
        var x: i32 = bounds.x;
        for i in 0..self.active {
            let previous: Menu = self.menus[i];
            x = x + label_width(previous.title) + 2;
        }
        let menu: Menu = self.menus[self.active];
        var width: i32 = 8;
        let items: list<MenuItem> = menu.items;
        for item in items {
            let needed: i32 = label_width(item.label) + 4;
            if needed > width { width = needed; }
        }
        if width > bounds.width { width = bounds.width; }
        if x + width > bounds.x + bounds.width { x = bounds.x + bounds.width - width; }
        let wanted: i32 = i32(menu.items.len()) + 2;
        let height: i32 = wanted > bounds.height - 1 ? bounds.height - 1 : wanted;
        return Rect::new(x, bounds.y + 1, width, height);
    }
    /// Call AFTER all content widgets: menu and shadow form the top layer.
    pub fn paint(self: MenuBar, surface: Surface, bounds: Rect, theme: Theme) -> void {
        if self.menus.len() == 0 || bounds.width == 0 || bounds.height == 0 { return; }
        surface.fill(Rect::new(bounds.x, bounds.y, bounds.width, 1),
            Cell { glyph: 32, foreground: theme.foreground, background: theme.menu_background });
        var x: i32 = bounds.x;
        for i in 0..self.menus.len() {
            let menu: Menu = self.menus[i];
            let width: i32 = label_width(menu.title) + 2;
            let bg: i32 = i == self.active ? theme.selection : theme.menu_background;
            let tab_area: Rect = Rect::new(x, bounds.y, width, 1);
            let tab: Rect = tab_area.intersect(bounds);
            surface.fill(tab, Cell { glyph: 32, foreground: theme.foreground, background: bg });
            let text_area: Rect = Rect::new(x + 1, bounds.y, width - 2, 1);
            surface.text(text_area.intersect(bounds),
                menu.title, theme.foreground, bg);
            x = x + width;
        }
        if self.active < 0 || self.active >= self.menus.len() { return; }
        let popup: Rect = self.popup_rect(bounds);
        if popup.width < 2 || popup.height < 2 { return; }
        // Offset the full shadow then cover its overlap with the opaque menu.
        let shadow: Rect = Rect::new(popup.x + 1, popup.y + 1, popup.width, popup.height);
        surface.shadow(shadow.intersect(bounds),
            theme.shadow_percent);
        var menu_theme: Theme = theme;
        menu_theme.panel = theme.menu_background;
        let border: Panel = Panel { title: "" };
        let inside: Rect = border.paint(surface, popup, menu_theme);
        let menu: Menu = self.menus[self.active];
        var start: i32 = 0;
        if self.selected >= inside.height && inside.height > 0 { start = self.selected - inside.height + 1; }
        for row in 0..inside.height {
            let index: i32 = start + i32(row);
            if index >= menu.items.len() { break; }
            let item: MenuItem = menu.items[index];
            let bg: i32 = index == self.selected ? theme.selection : theme.menu_background;
            let fg: i32 = item.enabled ? theme.foreground : theme.muted;
            let line: Rect = Rect::new(inside.x, inside.y + i32(row), inside.width, 1);
            surface.fill(line, Cell { glyph: 32, foreground: fg, background: bg });
            surface.text(Rect::new(line.x + 1, line.y, line.width - 2, 1), item.label, fg, bg);
        }
    }
}
