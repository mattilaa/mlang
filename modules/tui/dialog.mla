/// Base modal dialog: shared frame, content layout, configurable bottom buttons,
/// focus, and a short pressed animation before dispatching a button action.
pub struct Dialog {
    var title: str8; var width: i32; var height: i32;
    var active: bool{false};
    var focus: PaneFocus;
    var buttons: list<PushButton>{[]};
    var button_alignment: Alignment;
    var button_selected: i32{0}; var pressed_button: i32{-1};
    var press_ticks: i32{0}; var result: i32{0};
    pub fn new(title: str8, width: i32, height: i32) -> Dialog {
        return Dialog { title: title, width: width, height: height,
            button_alignment: Alignment::Center, focus: PaneFocus::new(3),
            buttons: [PushButton { label: "OK", action: 1 }, PushButton { label: "Cancel", action: 2 }] };
    }
    pub fn reset_buttons(self: &mut Self) -> void {
        self.result = 0; self.pressed_button = -1; self.press_ticks = 0;
        self.button_selected = -1;
        self.move_button(1);
    }
    pub fn button_row(self: Dialog, viewport: Rect) -> Rect {
        let area: Rect = self.bounds(viewport);
        let inner: Rect = area.inset(1);
        let height: i32 = self.buttons.len() == 0 ? 0 : (inner.height < 4 ? inner.height : 4);
        return Rect::new(inner.x, inner.y + inner.height - height, inner.width, height);
    }
    pub fn content_rect(self: Dialog, viewport: Rect) -> Rect {
        let area: Rect = self.bounds(viewport);
        let inner: Rect = area.inset(1);
        let row: Rect = self.button_row(viewport);
        return Rect::new(inner.x, inner.y, inner.width, inner.height - row.height);
    }
    pub fn button_rects(self: Dialog, viewport: Rect) -> list<Rect> {
        let row: Rect = self.button_row(viewport);
        var sizes: list<Size> = [];
        var total: i32 = 0; var selected_end: i32 = 0;
        for i in 0..self.buttons.len() {
            let button: PushButton = self.buttons[i];
            sizes.push(Size::fixed(button.width()));
            total = total + button.width() + (i > 0 ? 2 : 0);
            if i == self.button_selected { selected_end = total; }
        }
        let offset: i32 = selected_end > row.width ? selected_end - row.width : 0;
        let virtual_row: Rect = Rect::new(row.x - offset, row.y, total > row.width ? total : row.width, row.height);
        let layout: Layout = Layout { axis: Axis::Horizontal, gap: 2, sizes: sizes, alignment: self.button_alignment };
        let rectangles: list<Rect> = layout.split(virtual_row);
        var clipped: list<Rect> = [];
        for rectangle in rectangles { clipped.push(rectangle.intersect(row)); }
        return clipped;
    }
    pub fn paint_buttons(self: Dialog, surface: Surface, viewport: Rect, theme: Theme) -> void {
        let rectangles: list<Rect> = self.button_rects(viewport);
        for i in 0..self.buttons.len() {
            let button: PushButton = self.buttons[i];
            button.paint(surface, rectangles[i], theme,
                self.focus.selected == 3 && i == self.button_selected, i == self.pressed_button);
        }
    }
    pub fn move_button(self: &mut Self, direction: i32) -> void {
        let count: i32 = i32(self.buttons.len());
        if count == 0 { self.button_selected = -1; return; }
        var next: i32 = self.button_selected;
        for _i in 0..count {
            next = (next + direction + count) % count;
            let button: PushButton = self.buttons[next];
            if button.enabled { self.button_selected = next; return; }
        }
        self.button_selected = -1;
    }
    pub fn on_button_event(self: &mut Self, event: InputEvent) -> void {
        if self.pressed_button >= 0 { return; }
        if event.kind == InputKind::Menu && event.key == Key::Left { self.move_button(-1); }
        if event.kind == InputKind::Menu && (event.key == Key::Right || event.key == Key::Toggle) { self.move_button(1); }
        if (event.kind == InputKind::Menu && event.key == Key::Enter) || event.code == 32 {
            if self.button_selected >= 0 && self.button_selected < self.buttons.len() {
                let button: PushButton = self.buttons[self.button_selected];
                if button.enabled { self.pressed_button = self.button_selected; self.press_ticks = 10; }
            }
        }
    }
    /// Call once per 10ms UI tick. Returns the action after the pressed frame
    /// has remained visible for about 100ms; zero means no completed activation.
    pub fn tick_buttons(self: &mut Self) -> i32 {
        if self.pressed_button < 0 { return 0; }
        self.press_ticks = self.press_ticks - 1;
        if self.press_ticks > 0 { return 0; }
        let index: i32 = self.pressed_button;
        self.pressed_button = -1;
        if index >= self.buttons.len() { return 0; }
        let button: PushButton = self.buttons[index];
        self.result = button.enabled ? button.action : 0;
        return self.result;
    }
    pub fn bounds(self: Dialog, viewport: Rect) -> Rect {
        let available_width: i32 = viewport.width > 4 ? viewport.width - 4 : viewport.width;
        let available_height: i32 = viewport.height > 4 ? viewport.height - 4 : viewport.height;
        let width: i32 = self.width < available_width ? self.width : available_width;
        let height: i32 = self.height < available_height ? self.height : available_height;
        return Rect::new(viewport.x + (viewport.width - width) / 2,
                viewport.y + (viewport.height - height) / 2, width, height);
    }
    pub fn paint_frame(self: Dialog, surface: Surface, viewport: Rect, theme: Theme) -> Rect {
        let area: Rect = self.bounds(viewport);
        let shadow: Rect = Rect::new(area.x + 1, area.y + 1, area.width, area.height);
        surface.shadow(shadow.intersect(viewport), theme.shadow_percent);
        let panel: Panel = Panel { title: self.title };
        panel.paint_focused(surface, area, theme, true);
        self.paint_buttons(surface, viewport, theme);
        return self.content_rect(viewport);
    }
    pub fn paint(self: Dialog, surface: Surface, viewport: Rect, theme: Theme) -> Rect {
        return self.paint_frame(surface, viewport, theme);
    }
};

/// A simple non-file modal. Action 0 is reserved for no answer; 2 is Cancel.
pub struct QuestionDialog : Dialog {
    var question: str8;
};
impl QuestionDialog {
    pub fn new(title: str8, question: str8) -> QuestionDialog {
        return QuestionDialog { title: title, question: question, width: 56, height: 11,
            button_alignment: Alignment::Center, focus: PaneFocus::new(3),
            buttons: [PushButton { label: "OK", action: 1 }, PushButton { label: "Cancel", action: 2 }] };
    }
    pub fn open(self: &mut Self) -> void {
        self.reset_buttons(); self.focus.selected = 3; self.active = true;
    }
    pub fn on_event(self: &mut Self, event: InputEvent) -> void {
        if !self.active { return; }
        if (event.kind == InputKind::Menu && event.key == Key::Escape) ||
                event.code == 3 || (event.code == 99 && event.modifiers == 5) {
            self.active = false; self.result = 2; self.pressed_button = -1; return;
        }
        self.on_button_event(event);
    }
    pub fn tick(self: &mut Self) -> void {
        if self.active && self.tick_buttons() != 0 { self.active = false; }
    }
    pub fn paint(self: QuestionDialog, surface: Surface, viewport: Rect, theme: Theme) -> void {
        if !self.active { return; }
        let inner: Rect = self.paint_frame(surface, viewport, theme);
        surface.text(inner.inset(1), self.question, theme.foreground, theme.panel);
    }
}

pub struct DirectoryNode { var path: str8; var label: str8; var depth: i32; var expanded: bool; };

fn join_owned(base: str8, name: str8) -> str8 {
    if starts_with(name, "/") == 1 { return clone(name); }
    return ends_with(base, "/") == 1 ? format!("{}{}", base, name): format!("{}/{}", base, name);
}

/// Filesystem chooser. Owns strings/tree storage; call release once. A successful
/// selection returns a path in accepted_path (and every marked file in
/// accepted_paths); the application loads its format.
pub struct OpenSessionDialog : Dialog {
    var accepted: bool; var accepted_path: str8;
    /// Every accepted file, in marking order; one entry for a plain Enter.
    var accepted_paths: list<str8>;
    /// Full paths marked with Space, kept while browsing other directories.
    var marked: list<str8>;
    var directory: str8; var path_field: TextField;
    var nodes: list<DirectoryNode>; var tree_selected: i32;
    var files: list<str8>; var file_selected: i32;
    var status: str8;
    /// Optional full-path regex, also enforced for manually entered paths.
    var file_pattern: str8{""};
    /// Save choosers may accept a new filename; the caller handles overwrites.
    var save_mode: bool;
    /// Matching directories can be selected as opaque bundles (e.g. .vst3).
    var bundle_pattern: str8{""};
    /// Space marks several files only where opening many makes sense (audio
    /// and plugin choosers). Never for sessions, presets or save dialogs.
    var multi_select: bool;
};
impl OpenSessionDialog {
    pub fn new() -> OpenSessionDialog {
        return OpenSessionDialog {title: "Open session", width: 90, height: 26, button_alignment: Alignment::Center,
            buttons: [PushButton { label: "OK", action: 1 }, PushButton { label: "Cancel", action: 2 }],
            active: false, accepted: false, accepted_path: clone(""),
            directory: clone(""), path_field: TextField::new(""), focus: PaneFocus::new(0),
            nodes: [], tree_selected: -1, files: [], file_selected: -1, status: ""};
    }
    fn clear_nodes(self: &mut Self) -> void {
        let nodes: list<DirectoryNode> = self.nodes;
        for node in nodes { free(node.path); free(node.label); }
        self.nodes.clear();
    }
    fn clear_files(self: &mut Self) -> void {
        let files: list<str8> = self.files;
        for name in files { free(name); }
        self.files.clear();
    }
    pub fn release(self: &mut Self) -> void {
        self.clear_nodes(); self.clear_files();
        self.clear_marked(); self.clear_accepted();
        free(self.directory); free(self.accepted_path); self.path_field.release();
    }
    /// Does not change the process working directory or write filesystem data.
    fn clear_marked(self: &mut Self) -> void {
        let marked: list<str8> = self.marked; for path in marked { free(path); } self.marked = [];
    }
    fn clear_accepted(self: &mut Self) -> void {
        let paths: list<str8> = self.accepted_paths; for path in paths { free(path); } self.accepted_paths = [];
    }
    /// True when `path` is marked for multi-open.
    pub fn is_marked(self: OpenSessionDialog, path: str8) -> bool {
        let marked: list<str8> = self.marked;
        for entry in marked { if entry == path { return true; } }
        return false;
    }
    /// Space toggles the file under the cursor.
    fn toggle_marked(self: &mut Self) -> void {
        if self.file_selected < 0 || self.file_selected >= self.files.len() { return; }
        let target: str8 = join_owned(self.directory, self.files[self.file_selected]);
        var kept: list<str8> = []; var removed: bool = false;
        let marked: list<str8> = self.marked;
        for entry in marked {
            if entry == target { free(entry); removed = true; } else { kept.push(entry); }
        }
        if removed { free(target); } else { kept.push(target); }
        self.marked = kept;
        self.status = removed ? "Unmarked. Space marks files; Enter opens every marked file."
            : "Marked. Space unmarks; Enter opens every marked file.";
        if self.file_selected + 1 < self.files.len() { self.file_selected = self.file_selected + 1; }
    }
    pub fn open(self: &mut Self, initial_directory: str8) -> void {
        self.reset_buttons();
        self.active = true; self.accepted = false;
        self.clear_marked(); self.clear_accepted();
        free(self.accepted_path); self.accepted_path = clone("");
        // Browsing starts in the directory tree (pane 1); a save chooser starts
        // in the path field, where its suggested filename is edited.
        self.focus.selected = self.save_mode ? 0 : 1; self.focus.menu_active = false;
        let working: str8 = cwd();
        let path: str8 = len(initial_directory) == 0 ? clone(working) : join_owned(working, initial_directory);
        self.path_field.set_text(path);
        self.set_root(path);
        free(path); free(working);
    }
    pub fn cancel(self: &mut Self) -> void {
        self.active = false; self.accepted = false; self.pressed_button = -1; self.result = 2;
    }
    pub fn tick(self: &mut Self) -> void {
        if !self.active { return; }
        let action: i32 = self.tick_buttons();
        if action == 2 { self.cancel(); }
        else if action == 1 {
            if self.marked.len() > 0 { self.accept_marked(); }
            else if self.path_field.text != self.directory { self.submit_path(); }
            else if self.file_selected >= 0 && self.file_selected < self.files.len() {
                let target: str8 = join_owned(self.directory, self.files[self.file_selected]);
                self.accept_file(target); free(target);
            } else { self.status = "Select a file to open."; }
            if self.active { self.result = 0; }
        } else if action != 0 { self.active = false; }
    }
    fn load_files(self: &mut Self, path: str8) -> bool {
        if is_dir(path) == 0 { self.status = "Directory does not exist or is inaccessible."; return false; }
        let directory: str8 = clone(path);
        self.clear_files();
        let entries: list<str8> = list_dir(directory);
        for name in entries {
            let full: str8 = join_owned(directory, name);
            if (is_dir(full) == 0 || self.matches_bundle(full)) && self.matches_file(full) { self.files.push(clone(name)); }
            free(full);
        }
        free_lines(entries);
        free(self.directory); self.directory = directory;
        self.path_field.set_text(directory);
        self.file_selected = self.files.len() > 0 ? 0 : -1;
        self.status = self.files.len() > 0 ? "Enter: open file | Esc: cancel": "No files (directory empty or unreadable).";
        return true;
    }
    pub fn set_root(self: &mut Self, path: str8) -> bool {
        // Clone before load_files, since callers may pass the current directory.
        let target: str8 = clone(path);
        if !self.load_files(target) { free(target); return false; }
        self.clear_nodes();
        let parent: str8 = parent_dir(target);
        if parent != target {
            self.nodes.push(DirectoryNode { path: clone(parent), label: clone(".."), depth: -1, expanded: false });
        }
        free(parent);
        self.nodes.push(DirectoryNode { path: clone(target), label: clone(target), depth: 0, expanded: false });
        self.tree_selected = i32(self.nodes.len()) - 1;
        self.expand_selected(); free(target); return true;
    }
    pub fn expand_selected(self: &mut Self) -> void {
        if self.tree_selected < 0 || self.tree_selected >= self.nodes.len() { return; }
        let node: DirectoryNode = self.nodes[self.tree_selected];
        if node.depth < 0 { self.set_root(node.path); return; }
        if node.expanded || node.depth >= 32 { return; }
        let entries: list<str8> = list_dir(node.path);
        var rebuilt: list<DirectoryNode> = [];
        for i in 0..self.nodes.len() {
            let current: DirectoryNode = self.nodes[i];
            if i == self.tree_selected {
                rebuilt.push(DirectoryNode { path: current.path, label: current.label, depth: current.depth, expanded: true });
                for name in entries {
                    let full: str8 = join_owned(current.path, name);
                    if is_dir(full) == 1 && !self.matches_bundle(full) {
                        rebuilt.push(DirectoryNode { path: full, label: clone(name), depth: current.depth + 1, expanded: false });
                    } else {free(full);}
                }
            } else {rebuilt.push(current);}
        }
        free_lines(entries); self.nodes = rebuilt;
    }
    pub fn collapse_selected(self: &mut Self) -> void {
        if self.tree_selected < 0 || self.tree_selected >= self.nodes.len() { return; }
        let node: DirectoryNode = self.nodes[self.tree_selected];
        if !node.expanded {
            var i: i32 = self.tree_selected - 1;
            while i >= 0 {
                let parent: DirectoryNode = self.nodes[i];
                if parent.depth < node.depth { self.select_directory(i); return; }
                i = i - 1;
            }
            return;
        }
        var rebuilt: list<DirectoryNode> = [];
        var removing: bool = false;
        for i in 0..self.nodes.len() {
            let current: DirectoryNode = self.nodes[i];
            if i == self.tree_selected {
                rebuilt.push(DirectoryNode { path: current.path, label: current.label, depth: current.depth, expanded: false });
                removing = true;
            } else if removing && current.depth > node.depth {
                free(current.path); free(current.label);
            } else {removing = false; rebuilt.push(current);}
        }
        self.nodes = rebuilt;
    }
    pub fn select_directory(self: &mut Self, index: i32) -> void {
        if index < 0 || index >= self.nodes.len() { return; }
        let node: DirectoryNode = self.nodes[index];
        if self.load_files(node.path) { self.tree_selected = index; }
    }
    pub fn matches_file(self: OpenSessionDialog, path: str8) -> bool {
        return self.file_pattern == "" || tui::table::table_matches(self.file_pattern, path);
    }
    pub fn matches_bundle(self: OpenSessionDialog, path: str8) -> bool {
        return self.bundle_pattern != "" && tui::table::table_matches(self.bundle_pattern, path);
    }
    fn accept_file(self: &mut Self, path: str8) -> void {
        if !self.matches_file(path) { self.status = "File type does not match the filter."; return; }
        if (!self.save_mode && file_exists(path) == 0) || (is_dir(path) == 1 && !self.matches_bundle(path)) {
            self.status = "File no longer exists or is inaccessible."; return;
        }
        let copy: str8 = clone(path);
        free(self.accepted_path); self.accepted_path = copy;
        self.clear_accepted(); self.accepted_paths.push(clone(path));
        self.accepted = true; self.active = false; self.result = 1;
    }
    /// Accept every marked file. All must still pass the filter and exist.
    fn accept_marked(self: &mut Self) -> void {
        let marked: list<str8> = self.marked;
        for path in marked {
            if !self.matches_file(path) { self.status = "A marked file does not match the filter."; return; }
            if file_exists(path) == 0 && !(is_dir(path) == 1 && self.matches_bundle(path)) {
                self.status = "A marked file no longer exists or is inaccessible."; return;
            }
        }
        self.clear_accepted();
        var first: str8 = "";
        for path in marked { if first == "" { first = path; } self.accepted_paths.push(clone(path)); }
        free(self.accepted_path); self.accepted_path = clone(first);
        self.accepted = true; self.active = false; self.result = 1;
    }
    pub fn submit_path(self: &mut Self) -> void {
        if len(self.path_field.text) == 0 { self.status = "Enter a directory or file path."; return; }
        let working: str8 = len(self.directory) > 0 ? clone(self.directory) : cwd();
        let target: str8 = join_owned(working, self.path_field.text);
        if is_dir(target) == 1 && !self.matches_bundle(target) { self.set_root(target); }
        else { self.accept_file(target); }
        free(working); free(target);
    }
    pub fn panes(self: OpenSessionDialog, viewport: Rect) -> list<Pane> {
        let area: Rect = self.bounds(viewport);
        if area.width < 16 || area.height < 11 { return []; }
        let inner: Rect = self.content_rect(viewport);
        let body: Rect = Rect::new(inner.x, inner.y + 1, inner.width, inner.height - 2);
        let layout: Layout = Layout { axis: Axis::Horizontal, gap: 1, sizes: [Size::flex(1), Size::flex(2)] };
        let columns: list<Rect> = layout.split(body);
        return [Pane { id: 0, bounds: Rect::new(inner.x, inner.y, inner.width, 1), min_height: 1 },
                Pane { id: 1, bounds: columns[0] }, Pane { id: 2, bounds: columns[1] },
                Pane { id: 3, bounds: self.button_row(viewport) }];
    }
    pub fn on_event(self: &mut Self, event: InputEvent, viewport: Rect) -> void {
        if !self.active { return; }
        let panes: list<Pane> = self.panes(viewport);
        self.focus.reconcile(panes);
        if event.kind == InputKind::Pane { self.focus.navigate(event.key, panes); return; }
        if event.kind == InputKind::Menu && event.key == Key::Escape && event.code < 32 { self.cancel(); return; }
        if event.code == 3 ||(event.code == 99 && event.modifiers == 5) { self.cancel(); return; }
        if self.pressed_button >= 0 { return; }
        if event.kind == InputKind::Menu && event.key == Key::Toggle {
            self.focus.selected = (self.focus.selected + 1) % 4; return;
        }
        if self.focus.selected == 3 { self.on_button_event(event); return; }
        if self.focus.selected == 0 {
            if event.kind == InputKind::Menu && event.key == Key::Enter { self.submit_path(); }
            else { self.path_field.on_event(event); }
            return;
        }
        // From the lists, Ctrl+U or the start of an absolute path jumps to the
        // path field, so a path can be typed without tabbing there first. Plain
        // letters cannot: h/j/k/l navigate the lists.
        if self.focus.selected != 0 && (event.code == 21 || event.code == 47 || event.code == 126) {
            // "/" and "~" begin a fresh absolute path rather than extending the
            // browsed one; Ctrl+U clears the field itself.
            if event.code != 21 { self.path_field.set_text(""); }
            self.focus.selected = 0; self.path_field.on_event(event); return;
        }
        // Space marks/unmarks the file under the cursor for multi-open.
        if self.focus.selected == 2 && event.code == 32 && self.multi_select && !self.save_mode { self.toggle_marked(); return; }
        if event.kind != InputKind::Menu { return; }
        if self.focus.selected == 1 {
            if event.key == Key::Up { self.select_directory(self.tree_selected - 1); }
            if event.key == Key::Down { self.select_directory(self.tree_selected + 1); }
            if event.key == Key::Right || event.key == Key::Enter { self.expand_selected(); }
            if event.key == Key::Left { self.collapse_selected(); }
        } else if self.focus.selected == 2 {
            if event.key == Key::Up && self.file_selected > 0 { self.file_selected = self.file_selected - 1; }
            if event.key == Key::Down && self.file_selected + 1 < self.files.len() { self.file_selected = self.file_selected + 1; }
            if event.key == Key::Enter && self.marked.len() > 0 { self.accept_marked(); }
            else if event.key == Key::Enter && self.file_selected >= 0 && self.file_selected < self.files.len() {
                let target: str8 = join_owned(self.directory, self.files[self.file_selected]);
                self.accept_file(target); free(target);
            }
        }
    }
    pub fn paint(self: &mut Self, surface: Surface, viewport: Rect, theme: Theme) -> void {
        if !self.active { return; }
        let panes: list<Pane> = self.panes(viewport);
        self.focus.reconcile(panes);
        let inner: Rect = self.paint_frame(surface, viewport, theme);
        if panes.len() == 0 { surface.text(inner, "Resize terminal | Esc: cancel", theme.muted, theme.panel); return; }
        let path: Pane = panes[0]; let tree: Pane = panes[1]; let files: Pane = panes[2];
        let path_active: bool = self.focus.is_active(0);
        let bg: i32 = path_active ? theme.selection : theme.background;
        surface.fill(path.bounds, Cell { glyph: 32, foreground: theme.foreground, background: bg });
        surface.text(path.bounds, "Path: ", path_active ? theme.accent : theme.muted, bg);
        self.path_field.paint(surface, Rect::new(path.bounds.x + 6, path.bounds.y, path.bounds.width - 6, 1),
                theme.foreground, bg, path_active);
        let tree_panel: Panel = Panel { title: " Directories " };
        let tree_body: Rect = tree_panel.paint_focused(surface, tree.bounds, theme, self.focus.is_active(1));
        let file_panel: Panel = Panel { title: " Files " };
        let file_body: Rect = file_panel.paint_focused(surface, files.bounds, theme, self.focus.is_active(2));
        var start: i32 = self.tree_selected >= tree_body.height ? self.tree_selected - tree_body.height + 1 : 0;
        for row in 0..tree_body.height {
            let index: i32 = start + i32(row);
            if index < 0 || index >= self.nodes.len() { break; }
            let node: DirectoryNode = self.nodes[index];
            let indent: str8 = repeat("  ", node.depth > 0 ? node.depth : 0);
            let text: str8 = format!("{}{} {}", indent, node.depth < 0 ? "<" : (node.expanded ? "v" : ">"), node.label);
            let line: Rect = Rect::new(tree_body.x, tree_body.y + i32(row), tree_body.width, 1);
            let selected_bg: i32 = index == self.tree_selected ? theme.selection : theme.panel;
            surface.fill(line, Cell { glyph: 32, foreground: theme.foreground, background: selected_bg });
            surface.text(line, text, theme.foreground, selected_bg);
            free(indent); free(text);
        }
        start = self.file_selected >= file_body.height ? self.file_selected - file_body.height + 1 : 0;
        for row in 0..file_body.height {
            let index: i32 = start + i32(row);
            if index < 0 || index >= self.files.len() { break; }
            let line: Rect = Rect::new(file_body.x, file_body.y + i32(row), file_body.width, 1);
            let full: str8 = join_owned(self.directory, self.files[index]);
            // Marked rows sit a step brighter than their unmarked neighbours.
            let base: i32 = index == self.file_selected ? theme.selection : theme.panel;
            let selected_bg: i32 = self.is_marked(full) ? lighten(base, 26) : base;
            free(full);
            surface.fill(line, Cell { glyph: 32, foreground: theme.foreground, background: selected_bg });
            surface.text(line, self.files[index], theme.foreground, selected_bg);
        }
        surface.text(Rect::new(inner.x, inner.y + inner.height - 1, inner.width, 1), self.status, theme.muted, theme.panel);
    }
}
