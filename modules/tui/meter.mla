mod tui::geometry;
mod tui::surface;
mod tui::theme;
use tui::geometry::*;
use tui::surface::*;
use tui::theme::*;

/// Vertical VU display; caller supplies a normalized level (0..1000).
/// Quarter-cell fill and colors follow the std::esc oscilloscope demo.
pub struct VuMeter { var level: i32; };
impl VuMeter {
    pub fn color(level: i32) -> i32 {
        if level >= 850 { return 0xFF604C; }
        if level >= 700 { return 0xFF9046; }
        if level >= 520 { return 0xFFD65C; }
        return 0x74F078;
    }
    pub fn paint(self: VuMeter, surface: Surface, area: Rect, background: i32) -> void {
        if area.width <= 0 || area.height <= 0 { return; }
        let level: i32 = self.level < 0 ? 0 : (self.level > 1000 ? 1000 : self.level);
        let total: i64 = wide(area.height) * 4;
        let filled: i64 = wide(level) * total / 1000;
        for row in 0..area.height {
            let base: i64 = (wide(area.height) - 1 - row) * 4;
            let amount: i32 = filled <= base ? 0 : (filled - base >= 4 ? 4 : i32(filled - base));
            let threshold: i32 = i32((base + 2) * 1000 / total);
            let glyph: i32 = amount == 0 ? 0x2502 : (amount == 1 ? 0x2582 : (amount == 2 ? 0x2584 : (amount == 3 ? 0x2586 : 0x2588)));
            for x in 0..area.width {
                surface.put(area.x + i32(x), area.y + i32(row), Cell { glyph: glyph,
                    foreground: amount == 0 ? 0x163A2A : VuMeter::color(threshold), background: background });
            }
        }
    }
}
