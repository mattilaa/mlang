mod tui::table;
mod tui::textfield;
mod tui::theme;
mod std::math;
use tui::table::table_matches;
use tui::textfield::*;
use tui::theme::*;
use tui::geometry::*;
use tui::surface::*;
use tui::input::*;
use tui::menu::Key;
use std::bytes::Bytes;
use std::strbuf::clone;
use std::strbuf::free;
use std::math::floor;
fn slider_integer(value: f64) -> i64 { return value; }

/// Numeric slider. Owns label/editor; release once. Supported types: i32, u32,
/// f32, f64. Decimal input is strict (no NaN, infinity, suffixes or exponents).
pub struct Slider {
    var label: str8; var value_type: str8{"f64"};
    var minimum: f64; var maximum: f64{1.0}; var value: f64;
    var step: f64{0.01}; var read_only: bool;
    var editor: TextField; var editing: bool; var error: str8{""};
};
impl Slider {
    /// Vertical fader; its last row shows the value, remaining rows form the rail.
    pub fn paint_vertical(self: Slider, surface: Surface, area: Rect, theme: Theme, selected: bool) -> void {
        if area.width < 1 || area.height < 1 { return; }
        let bg: i32 = selected ? theme.selection : theme.panel;
        surface.fill(area, Cell { glyph: 32, foreground: theme.foreground, background: bg });
        let text: str8 = self.value_text();
        surface.text(Rect::new(area.x, area.y + area.height - 1, area.width, 1), text, theme.foreground, bg); free(text);
        if area.height < 2 || !self.accepts(self.value) { return; }
        let height: i32 = area.height - 1;
        var position: i32 = 0;
        if self.maximum > self.minimum {
            let span: f64 = self.maximum * 0.5 - self.minimum * 0.5;
            if span > 0.0 { position = i32((self.value * 0.5 - self.minimum * 0.5) / span * f64(height - 1)); }
        }
        for y in 0..height {
            let knob: bool = i32(y) == height - 1 - position;
            surface.put(area.x + area.width / 2, area.y + i32(y), Cell { glyph: knob ? 0x2501 : 0x2502, foreground: knob ? theme.accent : theme.muted, background: bg });
        }
    }
    pub fn new(label: str8, minimum: f64, maximum: f64, value: f64, value_type: str8) -> Slider {
        return Slider { label: clone(label), minimum: minimum, maximum: maximum,
            value: value, value_type: value_type, step: value_type == "i32" || value_type == "u32" ? 1.0 : 0.01, editor: TextField::new("") };
    }
    pub fn accepts(self: Slider, value: f64) -> bool {
        if !(self.minimum - self.minimum == 0.0) || !(self.maximum - self.maximum == 0.0) || !(self.minimum <= self.maximum) || !(value >= self.minimum && value <= self.maximum) { return false; }
        if self.value_type == "i32" { return value >= f64(-2147483648) && value <= f64(2147483647) && floor(value) == value; }
        if self.value_type == "u32" { return value >= 0.0 && value <= f64(4294967295) && floor(value) == value; }
        if self.value_type == "f32" { return value >= -340282346600000000000000000000000000000.0 && value <= 340282346600000000000000000000000000000.0; }
        return self.value_type == "f64" && value - value == 0.0;
    }
    pub fn parse(self: Slider, text: str8) -> result<f64, str8> {
        let integral: bool = self.value_type == "i32" || self.value_type == "u32";
        if !table_matches(integral ? "[+-]?[0-9]+" : "[+-]?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)", text) {
            return Err<f64, str8>("Invalid numeric type");
        }
        let raw: result<Bytes, str8> = Bytes::from_string(text);
        if raw.is_err() { return Err<f64, str8>("Cannot read value"); }
        let bytes: Bytes = raw.unwrap();
        let negative: bool = bytes.get(0) == 45;
        var i: i64 = bytes.get(0) == 43 || negative ? 1 : 0;
        var value: f64 = 0.0; var fraction: f64 = 0.0; var decimal: bool = false;
        while i < bytes.len() {
            let digit: i32 = bytes.get(i);
            if digit == 46 { fraction = 1.0; fraction = fraction / 10.0; decimal = true; }
            else if decimal { value = value + f64(digit - 48) * fraction; fraction = fraction / 10.0; }
            else { value = value * 10.0 + f64(digit - 48); }
            i = i + 1;
        }
        bytes.close(); if negative { value = -value; }
        if !self.accepts(value) { return Err<f64, str8>("Value outside slider range/type"); }
        return Ok<f64, str8>(value);
    }
    fn value_text(self: Slider) -> str8 {
        if !self.accepts(self.value) { return clone("Invalid range/value"); }
        return self.value_type == "i32" || self.value_type == "u32" ? format!("{}", slider_integer(self.value)) : format!("{}", self.value);
    }
    /// Returns true only for a committed value change. J decreases, K increases.
    pub fn on_event(self: &mut Self, event: InputEvent) -> bool {
        if self.read_only { return false; }
        if self.editing {
            if event.kind == InputKind::Menu && event.key == Key::Escape && event.code < 32 { self.editing = false; self.error = ""; return false; }
            if event.kind == InputKind::Menu && event.key == Key::Enter {
                let parsed: result<f64, str8> = self.parse(self.editor.text);
                if parsed.is_err() { self.error = "Invalid value: check type and range"; return false; }
                let changed: bool = self.value != parsed.unwrap();
                self.value = parsed.unwrap(); self.editing = false; self.error = ""; return changed;
            }
            self.editor.on_event(event); return false;
        }
        if event.kind == InputKind::Menu && event.key == Key::Enter {
            let text: str8 = self.accepts(self.value) ? self.value_text() : clone("");
            self.editor.set_text(text); free(text); self.editing = true; self.error = ""; return false;
        }
        let down: bool = (event.modifiers == 1 && event.code == 74) || (event.modifiers == 2 && (event.code == 106 || event.code == 74));
        let up: bool = (event.modifiers == 1 && event.code == 75) || (event.modifiers == 2 && (event.code == 107 || event.code == 75));
        if (!down && !up) || !(self.step > 0.0) || !(self.step - self.step == 0.0) || !self.accepts(self.value) { return false; }
        var next: f64 = self.value + (up ? self.step : -self.step);
        if next < self.minimum { next = self.minimum; }
        if next > self.maximum { next = self.maximum; }
        if !self.accepts(next) { self.error = "Invalid step for slider type"; return false; }
        let changed: bool = next != self.value; self.value = next; self.error = ""; return changed;
    }
    pub fn paint(self: Slider, surface: Surface, area: Rect, theme: Theme, selected: bool) -> void {
        if area.width < 1 || area.height < 1 { return; }
        let bg: i32 = selected ? theme.selection : theme.panel;
        let fg: i32 = self.read_only ? theme.muted : theme.foreground;
        surface.fill(area, Cell { glyph: 32, foreground: fg, background: bg });
        surface.text(Rect::new(area.x, area.y, area.width, 1), self.label, fg, bg);
        if area.height < 2 { return; }
        let text: str8 = self.value_text();
        if self.editing { self.editor.paint(surface, Rect::new(area.x, area.y + 1, area.width, 1), fg, bg, true); }
        else { surface.text(Rect::new(area.x, area.y + 1, area.width, 1), text, fg, bg); }
        free(text);
        if area.height < 3 { return; }
        var count: i32 = 0;
        if self.accepts(self.value) && self.maximum > self.minimum {
            // Half-scaled differences avoid overflow across the full f64 range.
            let span: f64 = self.maximum * 0.5 - self.minimum * 0.5;
            if span > 0.0 { count = i32((self.value * 0.5 - self.minimum * 0.5) / span * f64(area.width)); }
        }
        for x in 0..area.width {
            surface.put(area.x + i32(x), area.y + 2, Cell { glyph: i32(x) < count ? 0x2501 : 0x2500, foreground: i32(x) < count ? theme.accent : theme.muted, background: bg });
        }
    }
    pub fn release(self: Slider) -> void { free(self.label); self.editor.release(); }
}
