mod tui::geometry;
mod tui::theme;
mod std::bytes;
mod std::strbuf;
mod std::esc;
use tui::geometry::Rect;
use tui::geometry::wide;
use tui::theme::darken;
use std::bytes::Bytes;
use std::strbuf::*;
use std::esc::fg_rgb;
use std::esc::bg_rgb;
use std::esc::cursor_pos;
use std::esc::reset;

pub struct Cell { var glyph: i32; var foreground: i32; var background: i32; };

/// Single-cell repertoire for the first version: printable ASCII, Latin,
/// box-drawing, Braille, and status-light circles. Unsupported widths become '?'.
pub fn cell_glyph(code: i32) -> i32 {
    if code == 173 { return 63; } // soft hyphen is not reliably one cell
    if (code >= 32 && code <= 126) || (code >= 160 && code <= 591) ||
       (code >= 0x2500 && code <= 0x2588) || (code >= 0x2800 && code <= 0x28FF) ||
       code == 0x25CB || code == 0x25CF { return code; }
    return 63;
}

pub fn append_glyph(builder: i64, code: i32) -> void {
    if code < 128 { builder_append_char(builder, code); }
    else if code < 2048 {
        builder_append_char(builder, 192 + code / 64);
        builder_append_char(builder, 128 + code % 64);
    } else {
        builder_append_char(builder, 224 + code / 4096);
        builder_append_char(builder, 128 + code / 64 % 64);
        builder_append_char(builder, 128 + code % 64);
    }
}

/// Shared cell storage. Copies alias it; call release once after all painting.
/// Allocation is limited to 1,000,000 cells. Check is_valid() after construction.
pub struct Surface { var width: i32; var height: i32; var data: Bytes; };
impl Surface {
    pub fn new(width: i32, height: i32) -> Surface {
        if width < 0 || height < 0 || wide(width) * wide(height) > 1000000 {
            return Surface { width: 0, height: 0, data: Bytes { handle: 0 } };
        }
        let count: i64 = wide(width) * wide(height) * 12;
        let allocated: result<Bytes, str8> = Bytes::new(count + 1);
        if allocated.is_err() {
            return Surface { width: 0, height: 0, data: Bytes { handle: 0 } };
        }
        let data: Bytes = allocated.unwrap();
        for i in 0..count { data.append_byte(i % 12 == 0 ? 32 : 0); }
        return Surface { width: width, height: height, data: data };
    }
    pub fn is_valid(self: Surface) -> bool { return self.data.handle != 0; }
    pub fn bounds(self: Surface) -> Rect { return Rect::new(0, 0, self.width, self.height); }
    pub fn release(self: Surface) -> void { self.data.close(); }
    fn read_word(self: Surface, offset: i64) -> i32 {
        return self.data.get(offset) + self.data.get(offset + 1) * 256 +
               self.data.get(offset + 2) * 65536;
    }
    fn write_word(self: Surface, offset: i64, value: i32) -> void {
        self.data.set(offset, value % 256);
        self.data.set(offset + 1, value / 256 % 256);
        self.data.set(offset + 2, value / 65536 % 256);
    }
    pub fn cell(self: Surface, x: i32, y: i32) -> Cell {
        if x < 0 || y < 0 || x >= self.width || y >= self.height {
            return Cell { glyph: 32, foreground: 0, background: 0 };
        }
        let offset: i64 = (wide(y) * wide(self.width) + wide(x)) * 12;
        return Cell { glyph: self.read_word(offset), foreground: self.read_word(offset + 4),
                      background: self.read_word(offset + 8) };
    }
    pub fn put(self: Surface, x: i32, y: i32, cell: Cell) -> void {
        if x < 0 || y < 0 || x >= self.width || y >= self.height { return; }
        let offset: i64 = (wide(y) * wide(self.width) + wide(x)) * 12;
        self.write_word(offset, cell_glyph(cell.glyph));
        self.write_word(offset + 4, cell.foreground);
        self.write_word(offset + 8, cell.background);
    }
    pub fn fill(self: Surface, area: Rect, cell: Cell) -> void {
        let clipped: Rect = area.intersect(self.bounds());
        for y in clipped.y..clipped.y + clipped.height {
            for x in clipped.x..clipped.x + clipped.width { self.put(i32(x), i32(y), cell); }
        }
    }
    /// Preserve underlying glyphs, darkening foreground AND background.
    pub fn shadow(self: Surface, area: Rect, percent: i32) -> void {
        let clipped: Rect = area.intersect(self.bounds());
        for y in clipped.y..clipped.y + clipped.height {
            for x in clipped.x..clipped.x + clipped.width {
                let old: Cell = self.cell(i32(x), i32(y));
                self.put(i32(x), i32(y), Cell { glyph: old.glyph,
                    foreground: darken(old.foreground, percent),
                    background: darken(old.background, percent) });
            }
        }
    }
    /// Clip labels to one row, decoding UTF-8 before counting terminal cells.
    pub fn text(self: Surface, area: Rect, text: str8, fg: i32, bg: i32) -> void {
        if area.width <= 0 || area.height <= 0 { return; }
        let raw: result<Bytes, str8> = Bytes::from_string(text);
        if raw.is_err() { return; }
        let bytes: Bytes = raw.unwrap();
        var index: i64 = 0;
        var column: i32 = 0;
        while index < bytes.len() && column < area.width {
            let first: i32 = bytes.get(index);
            var code: i32 = first;
            var count: i32 = 1;
            if first >= 194 && first <= 223 { count = 2; code = first - 192; }
            else if first >= 224 && first <= 239 { count = 3; code = first - 224; }
            else if first >= 240 && first <= 244 { count = 4; code = first - 240; }
            else if first >= 128 { code = 63; }
            var valid: bool = index + wide(count) <= bytes.len();
            for j in 1..count {
                let next: i32 = bytes.get(index + j);
                if next < 128 || next > 191 { valid = false; }
                code = code * 64 + next - 128;
            }
            if !valid { count = 1; code = 63; }
            if (count == 2 && code < 128) || (count == 3 && code < 2048) ||
               (count == 4 && code < 65536) { code = 63; }
            self.put(area.x + column, area.y, Cell { glyph: cell_glyph(code),
                foreground: fg, background: bg });
            column = column + 1;
            index = index + wide(count);
        }
        bytes.close();
    }
    /// Owned output string. ANSI=false produces a deterministic plain snapshot.
    pub fn encode(self: Surface, ansi: bool) -> str8 {
        let builder: i64 = builder_new(wide(self.width) * wide(self.height) * 4 + 64);
        var last_fg: i32 = -1;
        var last_bg: i32 = -1;
        for y in 0..self.height {
            if ansi { builder_append(builder, cursor_pos(i32(y) + 1, 1)); }
            else if y > 0 { builder_append(builder, "\n"); }
            for x in 0..self.width {
                let cell: Cell = self.cell(i32(x), i32(y));
                if ansi && cell.foreground != last_fg {
                    builder_append(builder, fg_rgb(cell.foreground / 65536 % 256,
                        cell.foreground / 256 % 256, cell.foreground % 256));
                    last_fg = cell.foreground;
                }
                if ansi && cell.background != last_bg {
                    builder_append(builder, bg_rgb(cell.background / 65536 % 256,
                        cell.background / 256 % 256, cell.background % 256));
                    last_bg = cell.background;
                }
                append_glyph(builder, cell_glyph(cell.glyph));
            }
        }
        if ansi { builder_append(builder, reset()); }
        let output: str8 = builder_take_string(builder);
        builder_free(builder);
        return output;
    }
}
