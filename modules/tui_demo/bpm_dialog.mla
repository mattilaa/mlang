mod tui::dialog;
mod tui::table;
use tui::dialog::Dialog;
use tui::textfield::TextField;
use tui::button::PushButton;
use tui::focus::PaneFocus;
use tui::layout::Alignment;
use tui::geometry::*;
use tui::surface::*;
use tui::theme::*;
use tui::input::*;
use tui::menu::Key;
use tui::table::table_integer;
use std::strbuf::free;

pub struct BpmDialog : Dialog { var editor: TextField; var value: i32; var error: str8; };
impl BpmDialog {
    pub fn new() -> BpmDialog {
        return BpmDialog { title: "Set BPM", width: 48, height: 12, editor: TextField::new(""), error: "",
            focus: PaneFocus::new(0), button_alignment: Alignment::Center,
            buttons: [PushButton { label: "OK", action: 1 }, PushButton { label: "Cancel", action: 2 }] };
    }
    pub fn open(self: &mut Self, value: i32) -> void {
        let text: str8 = format!("{}", value); self.editor.set_text(text); free(text);
        self.value = value; self.error = ""; self.reset_buttons(); self.focus.selected = 0; self.active = true;
    }
    fn accept(self: &mut Self) -> void {
        let parsed: result<i64, str8> = table_integer(self.editor.text);
        if parsed.is_ok() {
            let value: i64 = parsed.unwrap();
            if value >= 20 && value <= 400 { self.value = i32(value); self.result = 1; self.active = false; return; }
        }
        self.error = "Enter a whole number from 20 to 400"; self.result = 0;
    }
    pub fn on_event(self: &mut Self, event: InputEvent) -> void {
        if event.kind == InputKind::Pane {
            if event.key == Key::Down { self.focus.selected = 3; }
            if event.key == Key::Up { self.focus.selected = 0; }
            return;
        }
        if event.kind == InputKind::Menu && event.key == Key::Escape && event.code < 32 {
            self.active = false; self.result = 2; self.pressed_button = -1; return;
        }
        if event.kind == InputKind::Menu && event.key == Key::Toggle {
            self.focus.selected = self.focus.selected == 0 ? 3 : 0; return;
        }
        if self.focus.selected == 3 { self.on_button_event(event); return; }
        if event.kind == InputKind::Menu && event.key == Key::Enter { self.accept(); }
        else { self.editor.on_event(event); }
    }
    pub fn tick(self: &mut Self) -> void {
        let action: i32 = self.tick_buttons();
        if action == 1 { self.accept(); } else if action == 2 { self.active = false; }
    }
    pub fn paint(self: BpmDialog, surface: Surface, area: Rect, theme: Theme) -> void {
        if !self.active { return; }
        let body: Rect = self.paint_frame(surface, area, theme);
        surface.text(body, "Tempo (20-400 BPM)", theme.foreground, theme.panel);
        if body.height > 1 { self.editor.paint(surface, Rect::new(body.x, body.y + 1, body.width, 1), theme.foreground, theme.selection, self.focus.selected == 0); }
        if body.height > 2 { surface.text(Rect::new(body.x, body.y + 2, body.width, 1), self.error, theme.accent, theme.panel); }
    }
    pub fn release(self: &mut Self) -> void { self.editor.release(); }
}
