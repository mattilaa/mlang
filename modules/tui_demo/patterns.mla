mod tui::listview;
mod tui_demo::sequence;
mod tui::dialog;
mod tui_demo::audio_library;
use tui_demo::audio_library::AudioLibrary;
use tui_demo::audio_clip::AudioClip;
use tui::listview::*;
use tui_demo::sequence::SequenceTable;
use tui_demo::sequence::SequenceTrack;
use tui::textfield::TextField;
use tui::dialog::Dialog;
use tui::geometry::*;
use tui::surface::*;
use tui::theme::*;
use tui::input::*;
use tui::menu::Key;
use tui::table::table_matches;
use std::strbuf::clone;
use std::strbuf::free;

pub struct PatternEntry { var id: i32; var name: str8; var data: SequenceTable; };
/// One parallel column of the song matrix: a pattern ID per song row, 0 = empty.
/// Lane 0 is the plain `song` list, so 1.0 sessions keep working.
pub struct SongLane { var slots: list<i32>; };
/// Owns independent saved patterns plus the current editable pattern.
/// Song order uses stable pattern IDs; repeated occurrences share a pattern.
pub struct PatternLibrary {
    var patterns: list<PatternEntry>; var song: list<i32>; var active_id: i32; var next_id: i32;
    var table: SequenceTable; var view: ListView;
    var renaming: bool; var editor: TextField; var error: str8;
    var audio: AudioLibrary; var audio_mode: bool;
    var instruments: ListView; var instruments_mode: bool;
    /// Columns 2..N of the song matrix; `song` itself is column 1.
    var extra_lanes: list<SongLane>;
    /// Instance the user tried to assign while another track already uses it;
    /// the application asks whether to share it or load a new instance.
    var share_request: i32;
};
impl PatternLibrary {
    /// Reuse only plugin IDs no longer referenced by any committed/live pattern.
    pub fn free_insert_id(self: PatternLibrary, count: i32) -> i32 {
        for id in 1..count + 1 {
            var used: bool = false; let patterns: list<PatternEntry> = self.patterns;
            for entry in patterns {
                var data: SequenceTable = SequenceTable {}; data = entry.id == self.active_id ? self.table : entry.data;
                let tracks: list<SequenceTrack> = data.tracks;
                for track in tracks { for n in 0..4 { if track.insert_id(i32(n)) == id { used = true; } } }
            }
            if !used { return i32(id); }
        }
        return count + 1;
    }
    pub fn adopt(self: &mut Self, source: &PatternLibrary) -> void {
        var next: PatternLibrary = PatternLibrary {}; next = source;
        self.release();
        self.patterns = next.patterns; self.song = next.song; self.active_id = next.active_id; self.next_id = next.next_id;
        self.extra_lanes = next.extra_lanes;
        self.table = next.table; self.view = next.view;
        self.renaming = false; self.editor = next.editor; self.error = next.error;
        self.audio = next.audio; self.audio_mode = next.audio_mode;
        self.instruments = next.instruments; self.instruments_mode = next.instruments_mode;
    }
    pub fn empty() -> PatternLibrary {
        var library: PatternLibrary = PatternLibrary { active_id: 1, next_id: 2,
            table: SequenceTable::empty(), editor: TextField::new(""), error: "" };
        library.patterns.push(PatternEntry { id: 1, name: clone("Untitled"), data: SequenceTable::empty() });
        library.refresh(); return library;
    }
    pub fn new() -> PatternLibrary {
        var library: PatternLibrary = PatternLibrary { active_id: 1, next_id: 4,
            table: SequenceTable::new(), editor: TextField::new(""), error: "" };
        let names: list<str8> = ["Intro", "Verse", "Chorus"];
        for i in 0..3 {
            var data: SequenceTable = SequenceTable::new();
            let steps: i32 = i32(i) * 4;
            for _j in 0..steps { data.edit_event(InputEvent { kind: InputKind::Text, key: Key::Escape, code: 75 }, Rect::new(0, 0, 80, 24)); }
            library.patterns.push(PatternEntry { id: i32(i) + 1, name: clone(names[i]), data: data });
        }
        let order: list<i32> = [1, 2, 2, 3];
        library.song = order; library.refresh(); return library;
    }
    pub fn index_of(self: PatternLibrary, id: i32) -> i32 {
        for i in 0..self.patterns.len() { let entry: PatternEntry = self.patterns[i]; if entry.id == id { return i32(i); } }
        return -1;
    }
    pub fn active_name(self: PatternLibrary) -> str8 {
        let index: i32 = self.index_of(self.active_id); if index < 0 { return ""; }
        let entry: PatternEntry = self.patterns[index]; return entry.name;
    }
    fn save_active(self: &mut Self) -> void {
        var entries: list<PatternEntry> = [];
        let previous: list<PatternEntry> = self.patterns;
        for entry in previous {
            var next: PatternEntry = PatternEntry {};
            next = entry;
            if next.id == self.active_id { next.data.release(); next.data = self.table.copy_pattern(); }
            entries.push(next);
        }
        self.patterns = entries;
    }
    pub fn select(self: &mut Self, id: i32) -> void {
        if id == self.active_id || self.index_of(id) < 0 { return; }
        self.save_active();
        let entry: PatternEntry = self.patterns[self.index_of(id)];
        var replacement: SequenceTable = entry.data.copy_pattern();
        replacement.clipboard = self.table.clipboard; replacement.clipboard_kinds = self.table.clipboard_kinds;
        replacement.clipboard_rows = self.table.clipboard_rows;
        self.table.clipboard = []; self.table.clipboard_kinds = [];
        self.table.release(); self.table = replacement; self.active_id = id;
        self.error = "";
    }
    /// Columns in the song matrix, counting the base `song` column.
    /// Pattern highlighted in the sidebar list (song mode uses its row), or 0.
    pub fn selected_pattern(self: PatternLibrary) -> i32 {
        if self.view.selected < 0 || self.view.selected >= self.view.items.len() { return 0; }
        let item: ListItem = self.view.items[self.view.selected];
        return item.id;
    }
    pub fn song_lanes(self: PatternLibrary) -> i32 { return i32(self.extra_lanes.len()) + 1; }
    /// Pattern ID at a matrix cell, or 0 when empty/out of range.
    pub fn song_at(self: PatternLibrary, row: i32, lane: i32) -> i32 {
        if row < 0 || row >= self.song.len() || lane < 0 { return 0; }
        if lane == 0 { return self.song[row]; }
        if lane - 1 >= self.extra_lanes.len() { return 0; }
        let column: SongLane = self.extra_lanes[lane - 1];
        return row < column.slots.len() ? column.slots[row] : 0;
    }
    /// Put a pattern (or 0 to clear) into a matrix cell, adding lanes as needed.
    /// Row 0 of lane 0 always holds a pattern, so the song is never empty.
    pub fn set_song_at(self: &mut Self, row: i32, lane: i32, id: i32) -> bool {
        if row < 0 || row >= self.song.len() || lane < 0 || lane >= 16 { return false; }
        if lane == 0 {
            var order: list<i32> = [];
            for i in 0..self.song.len() { order.push(i32(i) == row ? id : self.song[i]); }
            self.song = order; self.refresh(); return true;
        }
        while self.extra_lanes.len() < lane { self.extra_lanes.push(SongLane {}); }
        var lanes: list<SongLane> = [];
        for l in 0..self.extra_lanes.len() {
            let column: SongLane = self.extra_lanes[l];
            var slots: list<i32> = [];
            for r in 0..self.song.len() {
                let previous: i32 = r < column.slots.len() ? column.slots[r] : 0;
                slots.push(i32(l) == lane - 1 && i32(r) == row ? id : previous);
            }
            lanes.push(SongLane { slots: slots });
        }
        self.extra_lanes = lanes;
        // Drop trailing lanes that no longer hold anything.
        var kept: list<SongLane> = []; var last: i32 = -1;
        for l in 0..self.extra_lanes.len() {
            let column: SongLane = self.extra_lanes[l];
            let slots: list<i32> = column.slots;
            for value in slots { if value != 0 { last = i32(l); break; } }
        }
        for l in 0..self.extra_lanes.len() { if i32(l) <= last { kept.push(self.extra_lanes[l]); } }
        self.extra_lanes = kept;
        return true;
    }
    /// Insert an empty matrix row above or below `row`.
    pub fn matrix_insert_row(self: &mut Self, row: i32, after: bool) -> bool {
        if self.song.len() >= 65536 { return false; }
        let at: i32 = self.song.len() == 0 ? 0 : (after ? row + 1 : row);
        if at < 0 || at > self.song.len() { return false; }
        var order: list<i32> = [];
        for i in 0..self.song.len() {
            if i32(i) == at { order.push(0); }
            order.push(self.song[i]);
        }
        if at >= self.song.len() { order.push(0); }
        self.song = order; self.sync_lanes(at, true);
        self.refresh(); return true;
    }
    /// Remove a whole matrix row, lanes included.
    pub fn matrix_remove_row(self: &mut Self, row: i32) -> bool {
        if row < 0 || row >= self.song.len() { return false; }
        var order: list<i32> = [];
        for i in 0..self.song.len() { if i32(i) != row { order.push(self.song[i]); } }
        self.song = order; self.sync_lanes(row, false);
        self.refresh(); return true;
    }
    /// Push one lane down from `row`, leaving that cell empty. The other lanes
    /// keep their rows, so only this column shifts.
    pub fn matrix_insert_cell(self: &mut Self, row: i32, lane: i32, after: bool) -> bool {
        if row < 0 || row >= self.song.len() || lane < 0 || lane >= 16 { return false; }
        let at: i32 = after ? row + 1 : row;
        if at > self.song.len() { return false; }
        // The last cell of the lane falls off unless a row is added for it.
        if self.song_at(i32(self.song.len()) - 1, lane) != 0 && !self.matrix_insert_row(i32(self.song.len()) - 1, true) { return false; }
        var moved: i32 = 0;
        for i in 0..self.song.len() {
            let source: i32 = i32(self.song.len()) - 1 - i32(i);
            if source < at { break; }
            let value: i32 = self.song_at(source - 1 < at ? source : source - 1, lane);
            if source == at { self.set_song_at(source, lane, 0); }
            else { self.set_song_at(source, lane, self.song_at(source - 1, lane)); }
            moved = moved + 1;
        }
        return moved > 0;
    }
    /// Keep every lane the same length as the song after a row insert/remove.
    fn sync_lanes(self: &mut Self, row: i32, inserted: bool) -> void {
        var lanes: list<SongLane> = [];
        for l in 0..self.extra_lanes.len() {
            let column: SongLane = self.extra_lanes[l];
            var slots: list<i32> = [];
            for r in 0..column.slots.len() {
                if i32(r) == row && inserted { slots.push(0); }
                if !(i32(r) == row && !inserted) { slots.push(column.slots[r]); }
            }
            if inserted && row >= column.slots.len() { slots.push(0); }
            lanes.push(SongLane { slots: slots });
        }
        self.extra_lanes = lanes;
    }
    /// Notes that two patterns would send to the same instrument at the same
    /// row: same instance, same row, same note. Returns how many collide.
    pub fn clashing_notes(self: PatternLibrary, first: i32, second: i32) -> i32 {
        let a: i32 = self.index_of(first); let b: i32 = self.index_of(second);
        if a < 0 || b < 0 || first == second { return 0; }
        let left: PatternEntry = self.patterns[a]; let right: PatternEntry = self.patterns[b];
        var count: i32 = 0;
        let rows: i64 = left.data.rows.len() < right.data.rows.len() ? left.data.rows.len() : right.data.rows.len();
        for t in 0..left.data.tracks.len() {
            let track: SequenceTrack = left.data.tracks[t];
            if track.audio || !track.instrument || track.instrument_id <= 0 { continue; }
            for u in 0..right.data.tracks.len() {
                let other: SequenceTrack = right.data.tracks[u];
                if other.audio || !other.instrument || other.instrument_id != track.instrument_id { continue; }
                for r in 0..rows {
                    let left_row: TableRow = left.data.rows[r]; let right_row: TableRow = right.data.rows[r];
                    for line in 0..track.note_lines {
                        let column: i32 = left.data.track_start(i32(t)) + i32(line) * 4;
                        let note: str8 = left_row.cells[column];
                        if note == "" { continue; }
                        for other_line in 0..other.note_lines {
                            let other_column: i32 = right.data.track_start(i32(u)) + i32(other_line) * 4;
                            if right_row.cells[other_column] == note { count = count + 1; }
                        }
                    }
                }
            }
        }
        return count;
    }
    /// Notes of `id` that clash with the patterns already in `row`, ignoring `lane`.
    pub fn song_row_clashes(self: PatternLibrary, row: i32, lane: i32, id: i32) -> i32 {
        var count: i32 = 0;
        for l in 0..self.song_lanes() {
            if i32(l) == lane { continue; }
            let other: i32 = self.song_at(row, i32(l));
            if other > 0 { count = count + self.clashing_notes(id, other); }
        }
        return count;
    }
    /// How many patterns in `row` already play instrument tracks, ignoring `lane`.
    fn row_occupants(self: PatternLibrary, row: i32, lane: i32) -> i32 {
        var count: i32 = 0;
        for l in 0..self.song_lanes() {
            if i32(l) != lane && self.song_at(row, i32(l)) > 0 { count = count + 1; }
        }
        return count;
    }
    /// Give the clashing instrument tracks of `id` their own note line, so the
    /// parallel patterns stop sharing one. Tracks are renamed "<name> - <n>",
    /// where n counts the patterns sharing that instrument in the row.
    /// Returns the number of tracks split.
    pub fn split_song_clashes(self: &mut Self, row: i32, lane: i32, id: i32, area: Rect) -> i32 {
        let index: i32 = self.index_of(id);
        if index < 0 { return 0; }
        let line: i32 = self.row_occupants(row, lane) + 1;
        if line < 2 { return 0; }
        var entries: list<PatternEntry> = []; var split: i32 = 0;
        let previous: list<PatternEntry> = self.patterns;
        for item in previous {
            var entry: PatternEntry = PatternEntry {}; entry = item;
            if entry.id == id {
                for t in 0..entry.data.tracks.len() {
                    let track: SequenceTrack = entry.data.tracks[t];
                    if track.audio || !track.instrument || track.instrument_id <= 0 { continue; }
                    var clashes: bool = false;
                    for l in 0..self.song_lanes() {
                        if i32(l) == lane { continue; }
                        let other: i32 = self.song_at(row, i32(l));
                        if other > 0 && self.clashing_notes(id, other) > 0 { clashes = true; }
                    }
                    if !clashes { continue; }
                    if entry.data.move_notes_to_line(i32(t), line - 1, area) { split = split + 1; }
                }
            }
            entries.push(entry);
        }
        self.patterns = entries;
        if self.active_id == id {
            let entry: PatternEntry = self.patterns[self.index_of(id)];
            self.table.release(); self.table = entry.data.copy_pattern();
        }
        self.refresh();
        return split;
    }
    pub fn refresh(self: &mut Self) -> void {
        let old: list<ListItem> = self.view.items;
        for item in old { free(item.label); }
        var items: list<ListItem> = [];
        let entries: list<PatternEntry> = self.patterns;
        {
            for entry in entries {
                items.push(ListItem { id: entry.id, label: format!("{}{} {}", entry.id < 10 ? "00" : (entry.id < 100 ? "0" : ""), entry.id, entry.name) });
            }
        }
        self.view.items = items; self.view.cancel_pending();
    }
    /// Show the pattern list in the sidebar (the song lives in the matrix).
    pub fn show_patterns(self: &mut Self) -> void {
        self.instruments_mode = false; self.instruments.cancel_pending();
        self.audio_mode = false; self.audio.view.cancel_pending();
        self.view.selected = 0; self.view.scroll = 0; self.refresh();
        for i in 0..self.view.items.len() {
            let item: ListItem = self.view.items[i];
            if item.id == self.active_id { self.view.selected = i32(i); return; }
        }
        self.choose_selected();
    }
    pub fn choose_selected(self: &mut Self) -> void {
        if self.view.selected < 0 || self.view.selected >= self.view.items.len() { return; }
        let item: ListItem = self.view.items[self.view.selected]; self.select(item.id);
    }
    pub fn add(self: &mut Self, duplicate: bool) -> void {
        if self.patterns.len() >= 128 { self.error = "Maximum 128 patterns"; return; }
        var data: SequenceTable = self.table.copy_pattern();
        if !duplicate {
            data.release(); data = SequenceTable::new();
            for i in 0..data.tracks.len() { data.selected_column = data.track_start(i32(i)); data.clear_track(); }
            data.selected_column = 1;
        }
        let id: i32 = self.next_id; self.next_id = self.next_id + 1;
        let name: str8 = duplicate ? format!("{} copy", self.active_name()) : format!("Pattern {}", id);
        self.patterns.push(PatternEntry { id: id, name: name, data: data });
        self.song.push(id); self.select(id); self.refresh();
        self.view.selected = i32(self.patterns.len()) - 1;
    }
    pub fn rename(self: &mut Self, name: str8) -> bool {
        if !table_matches("[A-Za-z0-9][A-Za-z0-9 _-]{0,47}", name) { self.error = "Name: 1-48 letters, digits, spaces, _ or -"; return false; }
        var entries: list<PatternEntry> = []; let previous: list<PatternEntry> = self.patterns;
        for entry in previous {
            var next: PatternEntry = PatternEntry {};
            next = entry;
            if next.id == self.active_id { let copy: str8 = clone(name); free(next.name); next.name = copy; }
            entries.push(next);
        }
        self.patterns = entries; self.refresh(); self.error = ""; return true;
    }
    pub fn remove_active(self: &mut Self, area: Rect) -> void {
        if self.patterns.len() <= 1 { self.error = "Keep at least one pattern"; return; }
        let removed: i32 = self.active_id;
        let index: i32 = self.index_of(removed);
        var entries: list<PatternEntry> = []; let previous: list<PatternEntry> = self.patterns;
        for entry in previous {
            var next: PatternEntry = PatternEntry {};
            next = entry;
            if next.id == removed { free(next.name); next.data.release(); }
            else { entries.push(next); }
        }
        var song: list<i32> = []; let order: list<i32> = self.song;
        var dropped: list<i32> = [];
        for i in 0..order.len() { if order[i] == removed { dropped.push(i32(i)); } else { song.push(order[i]); } }
        self.patterns = entries; self.song = song;
        // Same rows leave every lane, and the pattern clears from the others.
        var lanes: list<SongLane> = [];
        for l in 0..self.extra_lanes.len() {
            let column: SongLane = self.extra_lanes[l]; var slots: list<i32> = [];
            for r in 0..column.slots.len() {
                var gone: bool = false;
                for index in dropped { if index == i32(r) { gone = true; } }
                if !gone { slots.push(column.slots[r] == removed ? 0 : column.slots[r]); }
            }
            lanes.push(SongLane { slots: slots });
        }
        self.extra_lanes = lanes;
        let next_index: i32 = index >= self.patterns.len() ? i32(self.patterns.len()) - 1 : index;
        let next: PatternEntry = self.patterns[next_index];
        var replacement: SequenceTable = next.data.copy_pattern();
        replacement.clipboard = self.table.clipboard; replacement.clipboard_kinds = self.table.clipboard_kinds;
        replacement.clipboard_rows = self.table.clipboard_rows;
        self.table.clipboard = []; self.table.clipboard_kinds = [];
        self.table.release(); self.table = replacement; self.active_id = next.id;
        self.view.selected = next_index;
        self.refresh(); self.view.reconcile(area); self.choose_selected(); self.error = "";
    }
    pub fn remove_song_occurrence(self: &mut Self, area: Rect) -> void {
        if self.view.selected < 0 || self.view.selected >= self.song.len() { return; }
        var order: list<i32> = [];
        for i in 0..self.song.len() { if i != self.view.selected { order.push(self.song[i]); } }
        self.song = order; self.sync_lanes(self.view.selected, false);
        self.refresh(); self.view.reconcile(area); self.choose_selected();
    }
    fn move_song_row(self: &mut Self, direction: i32, area: Rect) -> void {
        self.view.cancel_pending();
        let selected: i32 = self.view.selected; let target: i32 = selected + direction;
        if selected < 0 || selected >= self.song.len() || target < 0 || target >= self.song.len() { return; }
        var order: list<i32> = [];
        for i in 0..self.song.len() {
            if i == selected { order.push(self.song[target]); }
            else if i == target { order.push(self.song[selected]); }
            else { order.push(self.song[i]); }
        }
        self.song = order; self.view.selected = target;
        self.refresh(); self.view.reconcile(area); self.choose_selected();
    }
    fn insert_song_row(self: &mut Self, after: bool, area: Rect) -> void {
        self.view.cancel_pending();
        let selected: i32 = self.view.selected;
        if selected < 0 || selected >= self.song.len() { return; }
        var order: list<i32> = [];
        for i in 0..self.song.len() {
            if i == selected && !after { order.push(self.song[selected]); }
            order.push(self.song[i]);
            if i == selected && after { order.push(self.song[selected]); }
        }
        self.song = order; self.sync_lanes(after ? selected + 1 : selected, true);
        self.view.selected = after ? selected + 1 : selected;
        self.refresh(); self.view.reconcile(area); self.choose_selected();
    }
    fn change_song_pattern(self: &mut Self, direction: i32, area: Rect) -> void {
        self.view.cancel_pending();
        let selected: i32 = self.view.selected;
        if selected < 0 || selected >= self.song.len() { return; }
        let target: i32 = self.index_of(self.song[selected]) + direction;
        if target < 0 || target >= self.patterns.len() { return; }
        let entry: PatternEntry = self.patterns[target];
        var order: list<i32> = [];
        for i in 0..self.song.len() { order.push(i == selected ? entry.id : self.song[i]); }
        self.song = order; self.refresh(); self.view.reconcile(area); self.choose_selected();
    }
    pub fn on_event(self: &mut Self, event: InputEvent, area: Rect) -> bool {
        if self.instruments_mode {
            let action: i32 = self.instruments.on_event(event, area);
            if action == 2 {
                let id: i32 = self.selected_instrument();
                let index: i32 = self.table.active_track();
                if index >= 0 && id > 0 && self.table.instrument_used_by_other(id, index) { self.share_request = id; }
                else { self.table.assign_instrument(id); }
            }
            return action != 0;
        }
        if self.audio_mode {
            let action: i32 = self.audio.view.on_event(event, area);
            if action == 2 { self.insert_selected_audio(area); }
            return action != 0;
        }
        let action: i32 = self.view.on_event(event, area);
        if action == 3 { self.choose_selected(); self.remove_active(area); }
        else if action != 0 { self.choose_selected(); }
        return action != 0;
    }
    pub fn rename_event(self: &mut Self, event: InputEvent) -> void {
        if event.kind == InputKind::Menu && event.key == Key::Escape && event.code < 32 { self.renaming = false; self.error = ""; return; }
        if event.kind == InputKind::Menu && event.key == Key::Enter {
            if self.rename(self.editor.text) { self.renaming = false; }
        } else { self.editor.on_event(event); }
    }
    pub fn show_audio(self: &mut Self) -> void {
        self.instruments_mode = false; self.instruments.cancel_pending();
        self.audio_mode = true; self.view.cancel_pending(); self.audio.view.cancel_pending();
    }
    pub fn selected_instrument(self: PatternLibrary) -> i32 {
        if self.instruments.selected < 0 || self.instruments.selected >= self.instruments.items.len() { return 0; }
        let item: ListItem = self.instruments.items[self.instruments.selected]; return item.id;
    }
    pub fn remove_instrument(self: &mut Self, id: i32, area: Rect) -> void {
        self.table.detach_instrument(id);
        let old: list<PatternEntry> = self.patterns; var next: list<PatternEntry> = [];
        for item in old { var entry: PatternEntry = PatternEntry {}; entry = item; entry.data.detach_instrument(id); next.push(entry); }
        self.patterns = next;
        let items: list<ListItem> = self.instruments.items; var kept: list<ListItem> = [];
        for item in items { if item.id == id { free(item.label); } else { kept.push(item); } }
        self.instruments.items = kept; self.instruments.cancel_pending(); self.instruments.reconcile(area);
    }
    pub fn show_instruments(self: &mut Self) -> void {
        self.instruments_mode = true; self.audio_mode = false;
        self.view.cancel_pending(); self.audio.view.cancel_pending(); self.instruments.cancel_pending();
    }
    pub fn add_instrument(self: &mut Self, id: i32, name: str8) -> void {
        self.instruments.items.push(ListItem { id: id, label: format!("{}{} {}", id < 10 ? "00" : "0", id, name) });
        self.instruments.selected = i32(self.instruments.items.len()) - 1;
        self.show_instruments();
        let index: i32 = self.table.active_track();
        if index >= 0 {
            let track: SequenceTrack = self.table.tracks[index];
            if track.instrument { self.table.assign_instrument(id); }
        }
    }
    pub fn name_instrument(self: &mut Self, id: i32, name: str8) -> void {
        let items: list<ListItem> = self.instruments.items; var next: list<ListItem> = [];
        for item in items {
            if item.id == id {
                free(item.label);
                next.push(ListItem { id: id, label: format!("{}{} {}", id < 10 ? "00" : "0", id, name) });
            } else { next.push(item); }
        }
        self.instruments.items = next;
    }
    /// Placements of Audio-list sample `index` across every pattern.
    pub fn sample_usage(self: PatternLibrary, index: i32) -> i32 {
        if index < 0 || index >= self.audio.samples.len() { return 0; }
        let sample: AudioClip = self.audio.samples[index];
        var count: i32 = self.table.clip_usage(sample);
        let entries: list<PatternEntry> = self.patterns;
        for entry in entries { if entry.id != self.active_id { count = count + entry.data.clip_usage(sample); } }
        return count;
    }
    /// Remove Audio-list sample `index`, dropping every placement of it.
    /// Returns the number of placements removed, or -1 for an invalid index.
    pub fn remove_sample(self: &mut Self, index: i32, area: Rect) -> i32 {
        if index < 0 || index >= self.audio.samples.len() { return -1; }
        let sample: AudioClip = self.audio.samples[index];
        var removed: i32 = self.table.remove_clips_of(sample);
        let entries: list<PatternEntry> = self.patterns; var next: list<PatternEntry> = [];
        for item in entries {
            var entry: PatternEntry = PatternEntry {}; entry = item;
            let count: i32 = entry.data.remove_clips_of(sample);
            if entry.id != self.active_id { removed = removed + count; }
            next.push(entry);
        }
        self.patterns = next;
        var kept: list<AudioClip> = [];
        for i in 0..self.audio.samples.len() { if i32(i) != index { kept.push(self.audio.samples[i]); } }
        self.audio.samples = kept;
        sample.release();
        // Rebuild the list labels: entries are numbered by position.
        let items: list<ListItem> = self.audio.view.items;
        for item in items { free(item.label); }
        var labels: list<ListItem> = [];
        for i in 0..self.audio.samples.len() {
            let clip: AudioClip = self.audio.samples[i];
            let name: str8 = base_name(clip.source);
            labels.push(ListItem { id: i32(i) + 1, label: format!("{} {}", i + 1, name) });
            free(name);
        }
        self.audio.view.items = labels;
        if self.audio.view.selected >= self.audio.view.items.len() { self.audio.view.selected = i32(self.audio.view.items.len()) - 1; }
        self.audio.view.cancel_pending(); self.audio.view.reconcile(area);
        self.table.reconcile(area);
        return removed;
    }
    /// Tracks assigned to instrument instance `id` across every pattern.
    pub fn instrument_usage(self: PatternLibrary, id: i32) -> i32 {
        var count: i32 = self.table.instrument_usage(id);
        let entries: list<PatternEntry> = self.patterns;
        for entry in entries { if entry.id != self.active_id { count = count + entry.data.instrument_usage(id); } }
        return count;
    }
    /// Delete every track using instrument instance `id`, in every pattern.
    pub fn remove_tracks_using_instrument(self: &mut Self, id: i32, area: Rect) -> i32 {
        var removed: i32 = self.table.remove_tracks_using_instrument(id, area);
        let entries: list<PatternEntry> = self.patterns; var next: list<PatternEntry> = [];
        for item in entries {
            var entry: PatternEntry = PatternEntry {}; entry = item;
            let count: i32 = entry.data.remove_tracks_using_instrument(id, area);
            if entry.id != self.active_id { removed = removed + count; }
            next.push(entry);
        }
        self.patterns = next;
        return removed;
    }
    /// Destructively replace Audio-list sample `index` with `edited` (ownership
    /// moves in) and update every placement in every pattern. Returns the
    /// number of placements updated, or -1 for an invalid index.
    pub fn replace_sample(self: &mut Self, index: i32, edited: AudioClip) -> i32 {
        if index < 0 || index >= self.audio.samples.len() { edited.release(); return -1; }
        let old: AudioClip = self.audio.samples[index];
        var count: i32 = self.table.replace_clip(old, edited);
        let entries: list<PatternEntry> = self.patterns; var next: list<PatternEntry> = [];
        for item in entries {
            var entry: PatternEntry = PatternEntry {}; entry = item;
            // The live copy of the active pattern was counted above.
            let placed: i32 = entry.data.replace_clip(old, edited);
            if entry.id != self.active_id { count = count + placed; }
            next.push(entry);
        }
        self.patterns = next;
        let samples: list<AudioClip> = self.audio.samples; var kept: list<AudioClip> = [];
        for i in 0..samples.len() { kept.push(i == index ? edited : samples[i]); }
        self.audio.samples = kept;
        old.release();
        return count;
    }
    pub fn insert_selected_audio(self: &mut Self, area: Rect) -> bool {
        let index: i32 = self.audio.view.selected;
        if index < 0 || index >= self.audio.samples.len() { self.error = "Select a loaded sample"; return false; }
        let clip: AudioClip = self.audio.samples[index];
        self.error = ""; return self.table.insert_audio(clip, area);
    }
    pub fn load_audio(self: &mut Self, path: str8, bpm: i32, area: Rect) -> bool {
        if !self.audio.load(path, bpm) { self.error = self.audio.error; return false; }
        self.error = ""; self.table.error = "";
        let index: i32 = self.table.active_track();
        if index >= 0 {
            let track: SequenceTrack = self.table.tracks[index];
            if track.audio { self.insert_selected_audio(area); return true; }
        }
        self.show_audio(); return true;
    }
    pub fn paint_rename(self: PatternLibrary, surface: Surface, area: Rect, theme: Theme) -> void {
        if !self.renaming { return; }
        let dialog: Dialog = Dialog { title: "Rename pattern", width: 64, height: 9 };
        let content: Rect = dialog.paint_frame(surface, area, theme);
        surface.text(content, "Pattern name:", theme.foreground, theme.panel);
        if content.height > 2 { self.editor.paint(surface, Rect::new(content.x, content.y + 2, content.width, 1), theme.foreground, theme.selection, true); }
        if content.height > 4 { surface.text(Rect::new(content.x, content.y + 4, content.width, 1), self.error == "" ? "Enter: save | Esc: cancel" : self.error, theme.accent, theme.panel); }
    }
    pub fn release(self: &mut Self) -> void {
        let instruments: list<ListItem> = self.instruments.items; for item in instruments { free(item.label); }
        self.audio.release();
        self.table.release(); self.editor.release();
        let entries: list<PatternEntry> = self.patterns;
        for entry in entries { var owned: PatternEntry = PatternEntry {}; owned = entry; owned.data.release(); free(owned.name); }
        let items: list<ListItem> = self.view.items; for item in items { free(item.label); }
    }
}
