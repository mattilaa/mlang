mod std::audio::controller;
mod tui_demo::midi_controller;
mod tui_demo::note_playback;
mod tui_demo::sequence;
use tui_demo::sequence::SequenceTable;
use tui_demo::sequence::SequenceTrack;
use tui_demo::sequence::AudioInstance;
use tui_demo::audio_clip::AudioClip;
use tui_demo::audio_clip::base_name;
use std::audio::controller::*;
use std::audio::detail::__mlang_std_audio_last_error;
use std::midi::input_count;
use tui_demo::midi_controller::MidiController;
use tui_demo::note_playback::NoteEvent;
use std::strbuf::clone;
use std::strbuf::free;

/// Control-thread owner. AUHAL owns rendering; MIDI uses its separate lane.
pub struct EffectChannel { var path: str8{""}; var volume: i32{100}; };
/// Sampler-instrument pad (0-based) filled from the session sample list.
pub struct PadAssignment { var slot: i32; var pad: i32; var sample: i32; };
pub struct SamplePlacement { var sample: i64; var track: i64; var start: i64; var duration: i64; var rate: i64; var next: i64; var head: i64; };
/// PCM already registered with the controller. Clips are matched by content,
/// so re-arming a pattern reuses the registration instead of stopping the
/// device to upload the same audio again.
pub struct RegisteredClip { var id: i64; var frames: i64; var channels: i64; var rate: i64; var fingerprint: i64; };
/// Cheap content key: enough spread to separate two clips of equal geometry,
/// including one a destructive edit rewrote in place.
pub fn clip_fingerprint(samples: list<f32>) -> i64 {
    let count: i64 = samples.len();
    let step: i64 = count > 64 ? count / 64 : 1;
    var hash: i64 = count % 1000000007;
    var i: i64 = 0;
    while i < count {
        hash = (hash * 131 + wide(i32(samples[i] * 32767.0f)) + 2147483648) % 1000000007;
        i = i + step;
    }
    return hash;
}
pub struct AudioSystem {
    var output: AudioController; var midi: MidiController;
    var click_output: i64; var click_high: i64{-1}; var click_low: i64{-1};
    var midi_id: i64{-1}; var output_id: i64{-1};
    var hardware_requested: bool;
    var requested_buffer_frames: i64{128};
    var requested_sample_rate: i64{0};
    var processor_path: str8{""};
    var instrument_paths: list<str8>;
    var last_instrument_id: i32;
    var instrument_output_failed: bool;
    var effects: list<EffectChannel>;
    var insert_paths: list<str8>;
    var pads: list<PadAssignment>;
    var sample_placements: list<SamplePlacement>; var samples_running: bool;
    var sample_output: i64; var sample_last: i64;
    /// Tick where row 0 of the pattern holding the placements falls, and the
    /// row it starts on (-1 takes it from the tick, which is right while one
    /// pattern keeps playing). Both mirror NotePlayback, so clips and notes
    /// share a pattern's grid.
    var sample_epoch: i64; var sample_start_row: i32{-1};
    var registered_clips: list<RegisteredClip>;
};
impl AudioSystem {
    pub fn adopt(self: &mut Self, source: &AudioSystem) -> void {
        var next: AudioSystem = AudioSystem {}; next = source;
        self.release();
        self.output = next.output; self.midi = next.midi; self.midi_id = next.midi_id; self.output_id = next.output_id;
        self.hardware_requested = next.hardware_requested;
        self.requested_buffer_frames = next.requested_buffer_frames;
        self.requested_sample_rate = next.requested_sample_rate;
        self.processor_path = next.processor_path; self.instrument_paths = next.instrument_paths;
        self.last_instrument_id = next.last_instrument_id; self.instrument_output_failed = next.instrument_output_failed;
        self.effects = next.effects;
        self.insert_paths = next.insert_paths;
        self.pads = next.pads;
        self.samples_running = false; self.sample_placements = []; self.sample_output = 0;
        self.sample_epoch = 0; self.sample_start_row = -1; self.registered_clips = [];
        self.click_output = 0; self.click_high = -1; self.click_low = -1;
    }
    pub fn start(hardware: bool) -> AudioSystem {
        var system: AudioSystem = AudioSystem { hardware_requested: hardware };
        if hardware {
            let opened: result<AudioController, str8> = AudioController::open(-1, 128);
            if opened.is_ok() {
                system.output = opened.unwrap();
                if system.output.start() != 0 { system.output.close(); system.output.handle = 0; }
            }
            system.midi = MidiController::start_selected(-1, system.output.handle);
        }
        return system;
    }
    /// Prepare new output before retiring old resources. Failure leaves old output.
    /// `samples` is the session sample list; sampler pads live inside their
    /// plugin instances and are re-sent after the instruments reload.
    pub fn configure(self: &mut Self, midi_id: i64, output_id: i64, samples: &list<AudioClip>) -> result<i32, str8> {
        return self.configure_buffer(midi_id, output_id, self.requested_buffer_frames, samples);
    }
    pub fn configure_buffer(self: &mut Self, midi_id: i64, output_id: i64, frames: i64, samples: &list<AudioClip>) -> result<i32, str8> {
        return self.configure_audio(midi_id, output_id, frames, self.requested_sample_rate, samples);
    }
    pub fn configure_audio(self: &mut Self, midi_id: i64, output_id: i64, frames: i64, rate: i64, samples: &list<AudioClip>) -> result<i32, str8> {
        if rate != 0 && rate != 44100 && rate != 48000 && rate != 96000 { return Err<i32, str8>("Select 44.1, 48 or 96 kHz"); }
        if frames < 32 || frames > 4096 { return Err<i32, str8>("Buffer size must be 32..4096 frames"); }
        if midi_id < -2 || output_id < -2 { return Err<i32, str8>("Invalid device selection"); }
        if midi_id >= std::midi::input_count() { return Err<i32, str8>("MIDI adapter unavailable; reopen Settings"); }
        var next: AudioController = AudioController {};
        if output_id != -2 {
            let opened: result<AudioController, str8> = AudioController::open_at_rate(output_id, frames, rate);
            if opened.is_err() { return Err<i32, str8>(__mlang_std_audio_last_error()); }
            next = opened.unwrap();
        }
        if output_id == -2 && (self.instrument_paths.len() > 0 || self.processor_path != "" || self.effects.len() > 0 || self.insert_paths.len() > 0) {
            let created: result<AudioController, str8> = AudioController::new(rate == 0 ? 48000 : rate, frames);
            if created.is_err() { return Err<i32, str8>(__mlang_std_audio_last_error()); }
            next = created.unwrap();
        }
        if next.handle != 0 {
            if self.processor_path != "" {
                if next.load_processor(self.processor_path) != 0 { next.close(); return Err<i32, str8>(__mlang_std_audio_last_error()); }
                if next.copy_parameters_from(self.output, 0) != 0 { next.close(); return Err<i32, str8>("Cannot preserve master plugin parameters; settings unchanged"); }
            }
            for i in 0..self.instrument_paths.len() {
                if self.instrument_paths[i] != "" {
                    if next.load_instrument(i + 1, self.instrument_paths[i]) != 0 { next.close(); return Err<i32, str8>(__mlang_std_audio_last_error()); }
                    if next.copy_parameters_from(self.output, i + 1) != 0 { next.close(); return Err<i32, str8>("Cannot preserve instrument parameters; settings unchanged"); }
                }
            }
            let pads: list<PadAssignment> = self.pads;
            for entry in pads {
                let clip: AudioClip = samples[entry.sample];
                let name: str8 = base_name(clip.source);
                let sent: i32 = next.instrument_pad(entry.slot, entry.pad, clip.samples, clip.channels, clip.sample_rate, name);
                free(name);
                if sent != 0 { next.close(); return Err<i32, str8>("Cannot preserve sampler pads; settings unchanged"); }
            }
            if next.copy_midi_learn_from(self.output) != 0 { next.close(); return Err<i32, str8>("Cannot preserve MIDI learn; settings unchanged"); }
            for i in 0..self.effects.len() {
                let effect: EffectChannel = self.effects[i];
                if effect.path != "" {
                    if next.load_effect(i, effect.path) != 0 { next.close(); return Err<i32, str8>("Cannot reload effect; settings unchanged"); }
                    if next.copy_parameters_from(self.output, i + 33) != 0 { next.close(); return Err<i32, str8>("Cannot preserve effect parameters; settings unchanged"); }
                }
                next.effect_volume(i, effect.volume);
            }
            for i in 0..self.insert_paths.len() {
                if next.load_insert(i + 1, self.insert_paths[i]) != 0 || next.copy_parameters_from(self.output, i + 41) != 0 {
                    next.close(); return Err<i32, str8>("Cannot preserve insert plugin; settings unchanged");
                }
            }
            if output_id != -2 { if next.start() != 0 { next.close(); return Err<i32, str8>(__mlang_std_audio_last_error()); } }
        }
        // Never free an audio handle while the MIDI producer still borrows it.
        self.midi.release();
        if self.output.handle != 0 {
            if self.output.close() != 0 {
                if next.handle != 0 { next.close(); }
                self.midi = MidiController::start_selected(self.midi_id, self.output.handle);
                return Err<i32, str8>("Could not stop previous output; settings unchanged");
            }
        }
        self.output = next; self.midi_id = midi_id; self.output_id = output_id;
        self.hardware_requested = output_id != -2;
        self.requested_buffer_frames = frames;
        self.requested_sample_rate = rate;
        self.midi = MidiController::start_selected(midi_id, self.output.handle);
        return Ok<i32, str8>(0);
    }
    pub fn poll(self: &mut Self, now: i64) -> bool { return self.midi.poll(now); }
    /// Register embedded PCM off the audio thread, then send only bounded events.
    pub fn sample_playback(self: &mut Self, source: &SequenceTable, tick: i64, playing: bool, bpm: i32) -> bool {
        var table: SequenceTable = SequenceTable {}; table = source;
        if !playing || table.rows.len() == 0 {
            if self.samples_running {
                let placements: list<SamplePlacement> = self.sample_placements;
                for placement in placements {
                    self.output.post(AudioEvent { kind: AudioEventKind::StopSource, source: placement.track }, 0);
                }
            }
            self.samples_running = false; return true;
        }
        if self.output.handle == 0 { return true; }
        if bpm <= 0 { return false; }
        let period: i64 = table.rows.len() * 15000;
        if !self.samples_running || self.sample_output != self.output.handle || tick < self.sample_last {
            // The pattern starts on this row now; its clips repeat on its own
            // length from there, whatever the previous pattern's length was.
            let row_start: i64 = tick - tick % 15000;
            let row: i64 = self.sample_start_row >= 0 ? wide(self.sample_start_row) : tick / 15000 % wide(i32(table.rows.len()));
            self.sample_epoch = row_start - row * 15000;
            self.sample_start_row = -1;
            // Arming a pattern never stops the device: registration appends
            // while it renders, so effect tails and instrument voices survive a
            // matrix row change. Only a full cache (256 clips) reloads.
            if self.sample_output != self.output.handle { self.registered_clips = []; }
            var valid: bool = false;
            for attempt in 0..2 {
                if valid { break; }
                if attempt == 1 {
                    // Every slot is taken by clips this session no longer uses.
                    // Emptying them is the one case that needs a stopped device.
                    let worker: bool = self.midi.worker.raw != 0;
                    let restart: bool = self.output.hardware_output();
                    self.midi.release();
                    if self.output.stop() != 0 {
                        if worker { self.midi = MidiController::start_selected(self.midi_id, self.output.handle); }
                        return false;
                    }
                    self.output.clear_samples(); self.registered_clips = []; self.click_high = -1; self.click_low = -1;
                    if restart { if self.output.start() != 0 { return false; } }
                    if worker { self.midi = MidiController::start_selected(self.midi_id, self.output.handle); }
                }
                self.sample_placements = []; valid = true;
                for t in 0..table.tracks.len() {
                    let track: SequenceTrack = table.tracks[t];
                    if !track.audio { continue; }
                    let instances: list<AudioInstance> = track.instances;
                    for instance in instances {
                        let rc: AudioClip = instance.render_clip();
                        let id: i64 = self.register_clip(instance.clip);
                        if id < 0 { valid = false; continue; }
                        let start: i64 = wide(instance.start_row) * 15000;
                        let duration: i64 = rc.frames * wide(bpm) * 1000 / instance.clip.sample_rate;
                        var next: i64 = self.sample_epoch + (tick - self.sample_epoch) / period * period + start;
                        if next + duration <= tick { next = next + period; }
                        self.sample_placements.push(SamplePlacement { sample: id, track: t, start: start, duration: duration,
                            rate: instance.clip.sample_rate, next: next, head: rc.offset });
                    }
                }
            }
            self.sample_output = self.output.handle; self.samples_running = true;
            if !valid { self.samples_running = false; return false; }
        }
        let previous: list<SamplePlacement> = self.sample_placements;
        var updated: list<SamplePlacement> = [];
        for item in previous {
            var placement: SamplePlacement = item;
            if placement.next <= tick {
                if tick - placement.next >= period { placement.next = placement.next + (tick - placement.next) / period * period; }
                let elapsed: i64 = tick - placement.next;
                if elapsed < placement.duration {
                    let offset: i64 = placement.head + elapsed * placement.rate / (wide(bpm) * 1000);
                    let length: i64 = (placement.duration - elapsed) * placement.rate / (wide(bpm) * 1000);
                    if length > 0 { self.output.play_sample(placement.sample, placement.track, offset, length); }
                }
                placement.next = placement.next + period;
            }
            updated.push(placement);
        }
        self.sample_placements = updated; self.sample_last = tick; return true;
    }
    /// Short decaying clicks use the existing realtime PCM mixer, outside track routing.
    pub fn metronome(self: &mut Self, accent: bool) -> void {
        if self.output.handle == 0 { return; }
        if self.click_output != self.output.handle {
            self.click_output = self.output.handle; self.click_high = -1; self.click_low = -1;
        }
        if self.click_high < 0 || self.click_low < 0 {
            var high: list<f32> = []; var low: list<f32> = [];
            for i in 0..1440 {
                let envelope: f32 = 0.18f * f32(1440 - i) / 1440.0f;
                high.push((i % 24 < 12 ? 1.0f : -1.0f) * envelope);
                low.push((i % 48 < 24 ? 1.0f : -1.0f) * envelope);
            }
            if self.click_high < 0 { self.click_high = self.output.add_sample_data(high, 1, 48000); }
            if self.click_low < 0 { self.click_low = self.output.add_sample_data(low, 1, 48000); }
        }
        let sample: i64 = accent ? self.click_high : self.click_low;
        if sample >= 0 { self.output.post(AudioEvent { kind: AudioEventKind::PlaySample, sample: sample, source: 32767 }, 0); }
    }
    /// Controller-side PCM id for a clip, uploading it only the first time.
    /// Returns -1 when the controller is full or refuses the data.
    fn register_clip(self: &mut Self, clip: AudioClip) -> i64 {
        let fingerprint: i64 = clip_fingerprint(clip.samples);
        let known: list<RegisteredClip> = self.registered_clips;
        for entry in known {
            if entry.fingerprint == fingerprint && entry.frames == clip.frames
                && entry.channels == clip.channels && entry.rate == clip.sample_rate { return entry.id; }
        }
        let id: i64 = self.output.add_sample_data(clip.samples, clip.channels, clip.sample_rate);
        if id < 0 { return -1; }
        self.registered_clips.push(RegisteredClip { id: id, frames: clip.frames, channels: clip.channels,
            rate: clip.sample_rate, fingerprint: fingerprint });
        return id;
    }
    /// The playing pattern changed: silence its clips and re-arm the next
    /// pattern's placements on the next `sample_playback`.
    pub fn restart_samples(self: &mut Self, row: i32) -> void {
        if self.samples_running {
            let placements: list<SamplePlacement> = self.sample_placements;
            for placement in placements {
                self.output.post(AudioEvent { kind: AudioEventKind::StopSource, source: placement.track }, 0);
            }
        }
        self.samples_running = false; self.sample_placements = []; self.sample_start_row = row;
    }
    pub fn sync_volumes(self: AudioSystem, source: &SequenceTable) -> void {
        var table: SequenceTable = SequenceTable {}; table = source;
        // Publish final routes directly: never transiently bypass active chains.
        for s in 0..96 {
            var selected: i32 = -1;
            for t in 0..table.tracks.len() {
                let track: SequenceTrack = table.tracks[t];
                if (!track.instrument && s == t) || (track.instrument && track.instrument_id > 0 && s == 63 + wide(track.instrument_id)) { selected = i32(t); }
            }
            for n in 0..4 {
                var id: i32 = 0; if selected >= 0 { let track: SequenceTrack = table.tracks[selected]; id = track.insert_id(i32(n)); }
                self.output.insert_route(s, n, id);
            }
        }
        // Output channels: a track feeds master (0) or another audio track,
        // which then applies its own inserts, fader and sends.
        for s in 0..96 {
            var destination: i32 = 0;
            for t in 0..table.tracks.len() {
                let track: SequenceTrack = table.tracks[t];
                if (!track.instrument && s == t) || (track.instrument && track.instrument_id > 0 && s == 63 + wide(track.instrument_id)) {
                    destination = table.track_output(i32(t));
                }
            }
            self.output.output_route(s, wide(destination));
        }
        for i in 0..table.tracks.len() {
            let track: SequenceTrack = table.tracks[i];
            self.output.track_volume(i, track.instrument ? track.instrument_id : 0, track.muted ? 0 : track.volume);
            for fx in 0..8 { self.output.effect_send(i, track.instrument ? track.instrument_id : 0, fx, track.muted ? 0 : track.send_level(i32(fx))); }
        }
        // A muted assignment must not silence other tracks using the same instance.
        for i in 0..table.tracks.len() {
            let track: SequenceTrack = table.tracks[i];
            if track.instrument && !track.muted {
                self.output.track_volume(i, track.instrument_id, track.volume);
                for fx in 0..8 { self.output.effect_send(i, track.instrument_id, fx, track.send_level(i32(fx))); }
            }
        }
        for fx in 0..self.effects.len() { let effect: EffectChannel = self.effects[fx]; self.output.effect_volume(fx, effect.volume); }
    }
    pub fn add_effect(self: &mut Self) -> bool {
        if self.effects.len() >= 8 { return false; }
        self.effects.push(EffectChannel {}); return true;
    }
    pub fn effect_level(self: &mut Self, index: i32, value: i32) -> void {
        if index < 0 || index >= self.effects.len() || value < 0 || value > 100 { return; }
        let old: list<EffectChannel> = self.effects; var next: list<EffectChannel> = [];
        for i in 0..old.len() { var effect: EffectChannel = old[i]; if i == index { effect.volume = value; } next.push(effect); }
        self.effects = next;
    }
    pub fn load_effect(self: &mut Self, index: i32, path: str8) -> str8 {
        if index < 0 || index >= self.effects.len() { return clone("Select an effect channel in Mixer first"); }
        if self.output.handle == 0 {
            let created: result<AudioController, str8> = AudioController::new(self.requested_sample_rate == 0 ? 48000 : self.requested_sample_rate, self.requested_buffer_frames);
            if created.is_err() { return clone("Cannot create effect output"); } self.output = created.unwrap(); self.reconnect_midi();
        }
        let worker: bool = self.midi.worker.raw != 0; self.midi.release();
        let restart: bool = self.output.hardware_output();
        if self.output.stop() != 0 { self.resume_midi(worker); return clone("Cannot stop output; effect unchanged"); }
        let loaded: i32 = self.output.load_effect(index, path);
        var message: str8 = loaded == 0 ? clone(path == "" ? "Effect plugin removed" : "Effect loaded; set the plugin wet mix to 100% for aux use") : clone(__mlang_std_audio_last_error());
        if loaded == 0 {
            let old: list<EffectChannel> = self.effects; var next: list<EffectChannel> = [];
            for i in 0..old.len() { var effect: EffectChannel = old[i]; if i == index { if effect.path != "" { free(effect.path); } effect.path = path == "" ? "" : clone(path); } next.push(effect); }
            self.effects = next;
        }
        if restart { if self.output.start() != 0 { free(message); message = clone("Effect processed but audio restart failed; reopen Settings"); } }
        self.resume_midi(worker); return message;
    }
    pub fn route_selected(self: AudioSystem, source: &SequenceTable) -> void {
        var table: SequenceTable = SequenceTable {}; table = source;
        if self.output.handle == 0 { return; }
        let index: i32 = table.recording_track >= 0 ? table.recording_track : table.active_track();
        if index < 0 { self.output.midi_target(0, -1); return; }
        let track: SequenceTrack = table.tracks[index];
        var slot: i32 = 0;
        if track.audio || track.muted { slot = -1; }
        else if track.instrument { slot = track.instrument_id > 0 ? track.instrument_id : -1; }
        self.output.midi_target(index, slot);
    }
    // A device worker may already exist when loading creates an offline output.
    pub fn resume_midi(self: &mut Self, was_running: bool) -> void {
        if was_running && self.midi.worker.raw == 0 { self.midi = MidiController::start_selected(self.midi_id, self.output.handle); }
    }
    fn reconnect_midi(self: &mut Self) -> void {
        if self.midi.worker.raw != 0 {
            self.midi.release(); self.midi = MidiController::start_selected(self.midi_id, self.output.handle);
        }
    }
    /// Returns owned error text, or empty literal on success. IDs remain stable.
    pub fn add_instrument(self: &mut Self, path: str8) -> str8 {
        self.instrument_output_failed = false;
        var slot: i32 = i32(self.instrument_paths.len()) + 1;
        for i in 0..self.instrument_paths.len() { if self.instrument_paths[i] == "" && slot > self.instrument_paths.len() { slot = i32(i) + 1; } }
        if slot > 32 { return clone("Maximum 32 loaded instruments"); }
        if self.output.handle == 0 {
            let created: result<AudioController, str8> = AudioController::new(self.requested_sample_rate == 0 ? 48000 : self.requested_sample_rate, self.requested_buffer_frames);
            if created.is_err() { return clone(__mlang_std_audio_last_error()); }
            self.output = created.unwrap();
            self.reconnect_midi();
        }
        let restart: bool = self.output.hardware_output();
        if self.output.stop() != 0 { return clone(__mlang_std_audio_last_error()); }
        if self.output.load_instrument(slot, path) != 0 {
            let error: str8 = format!("Instrument load failed: {}", __mlang_std_audio_last_error());
            if restart { self.output.start(); } return error;
        }
        if slot > self.instrument_paths.len() { self.instrument_paths.push(clone(path)); }
        else {
            let old: list<str8> = self.instrument_paths; var next: list<str8> = [];
            for i in 0..old.len() { next.push(i + 1 == slot ? clone(path) : old[i]); }
            self.instrument_paths = next;
        }
        self.last_instrument_id = slot;
        // The loaded slot remains valid even if hardware cannot restart.
        if restart { self.instrument_output_failed = self.output.start() != 0; }
        return "";
    }
    pub fn remove_instrument(self: &mut Self, slot: i32) -> str8 {
        if slot < 1 || slot > self.instrument_paths.len() { return clone("Select a loaded instrument"); }
        if self.instrument_paths[slot - 1] == "" { return clone("Select a loaded instrument"); }
        let restart: bool = self.output.hardware_output();
        let worker: bool = self.midi.worker.raw != 0;
        self.output.midi_target(0, -1);
        self.midi.release();
        if self.output.stop() != 0 {
            if worker { self.midi = MidiController::start_selected(self.midi_id, self.output.handle); }
            return clone("Could not stop audio; instrument retained");
        }
        self.output.panic();
        if self.output.unload_instrument(slot) != 0 {
            if restart { self.output.start(); }
            if worker { self.midi = MidiController::start_selected(self.midi_id, self.output.handle); }
            return clone("Instrument unload failed");
        }
        let old: list<str8> = self.instrument_paths; var next: list<str8> = [];
        for i in 0..old.len() { if i + 1 == slot { free(old[i]); next.push(""); } else { next.push(old[i]); } }
        self.instrument_paths = next;
        self.forget_pads(slot);
        self.instrument_output_failed = restart && self.output.start() != 0;
        if worker { self.midi = MidiController::start_selected(self.midi_id, self.output.handle); }
        return "";
    }
    /// Send interleaved PCM to a sampler instrument pad and remember the
    /// sample-list index for sessions. Audio keeps running; the plugin swaps
    /// the pad on its audio thread. Returns owned error text, or "" on success.
    pub fn assign_pad(self: &mut Self, slot: i32, pad: i32, sample: i32, samples: list<f32>, channels: i64, rate: i64, name: str8) -> str8 {
        if slot < 1 || slot > self.instrument_paths.len() { return clone("Select a loaded instrument in Instruments first"); }
        if self.instrument_paths[slot - 1] == "" { return clone("Select a loaded instrument in Instruments first"); }
        if self.output.instrument_pad(slot, pad, samples, channels, rate, name) != 0 {
            return format!("Pad sample failed: {}", __mlang_std_audio_last_error());
        }
        let old: list<PadAssignment> = self.pads; var next: list<PadAssignment> = [];
        var placed: bool = false;
        // Keep ascending (slot, pad) order; the session format requires it.
        for entry in old {
            let key: i32 = entry.slot * 128 + entry.pad;
            if !placed && key >= slot * 128 + pad { next.push(PadAssignment { slot: slot, pad: pad, sample: sample }); placed = true; }
            if key != slot * 128 + pad { next.push(entry); }
        }
        if !placed { next.push(PadAssignment { slot: slot, pad: pad, sample: sample }); }
        self.pads = next;
        return "";
    }
    /// After a destructive edit of session sample `sample`, re-send every pad
    /// that uses it. Returns the number of pads refreshed, or -1 on failure.
    pub fn refresh_pads(self: AudioSystem, sample: i32, clip: &AudioClip) -> i32 {
        var source: AudioClip = AudioClip {}; source = clip;
        let name: str8 = base_name(source.source);
        var count: i32 = 0;
        let pads: list<PadAssignment> = self.pads;
        for entry in pads {
            if entry.sample != sample { continue; }
            if self.output.instrument_pad(entry.slot, entry.pad, source.samples, source.channels, source.sample_rate, name) != 0 { count = -1; break; }
            count = count + 1;
        }
        free(name);
        return count;
    }
    /// Empty a sampler pad and forget its session assignment. Owned error or "".
    pub fn clear_pad(self: &mut Self, slot: i32, pad: i32) -> str8 {
        if self.output.instrument_clear_pad(slot, pad) != 0 { return format!("Cannot clear pad: {}", __mlang_std_audio_last_error()); }
        let old: list<PadAssignment> = self.pads; var next: list<PadAssignment> = [];
        for entry in old { if entry.slot != slot || entry.pad != pad { next.push(entry); } }
        self.pads = next;
        return "";
    }
    /// Session sample index loaded into a pad, or -1.
    pub fn pad_sample(self: AudioSystem, slot: i32, pad: i32) -> i32 {
        let pads: list<PadAssignment> = self.pads;
        for entry in pads { if entry.slot == slot && entry.pad == pad { return entry.sample; } }
        return -1;
    }
    /// A removed session sample invalidates the pads playing it: those pads are
    /// emptied, and later sample indexes shift down. Returns pads cleared.
    pub fn drop_sample_pads(self: &mut Self, sample: i32) -> i32 {
        var cleared: i32 = 0;
        let old: list<PadAssignment> = self.pads; var next: list<PadAssignment> = [];
        for entry in old {
            if entry.sample == sample {
                if self.output.instrument_clear_pad(entry.slot, entry.pad) == 0 { cleared = cleared + 1; }
            } else {
                next.push(PadAssignment { slot: entry.slot, pad: entry.pad,
                    sample: entry.sample > sample ? entry.sample - 1 : entry.sample });
            }
        }
        self.pads = next;
        return cleared;
    }
    fn forget_pads(self: &mut Self, slot: i32) -> void {
        let old: list<PadAssignment> = self.pads; var next: list<PadAssignment> = [];
        for entry in old { if entry.slot != slot { next.push(entry); } }
        self.pads = next;
    }
    /// Returns an owned status string. Load outside the audio callback; retain
    /// the old processor if the new bundle cannot initialize.
    pub fn set_processor(self: &mut Self, path: str8) -> str8 {
        if self.output.handle == 0 {
            let created: result<AudioController, str8> = AudioController::new(self.requested_sample_rate == 0 ? 48000 : self.requested_sample_rate, self.requested_buffer_frames);
            if created.is_err() { return clone(__mlang_std_audio_last_error()); }
            self.output = created.unwrap();
            self.reconnect_midi();
        }
        let restart: bool = self.output.hardware_output();
        if self.output.stop() != 0 { return clone(__mlang_std_audio_last_error()); }
        let loaded: i32 = self.output.load_processor(path);
        if loaded != 0 {
            let error: str8 = format!("VST3 load failed: {}", __mlang_std_audio_last_error());
            if restart { self.output.start(); }
            return error;
        }
        if self.processor_path != "" { free(self.processor_path); }
        self.processor_path = path == "" ? "" : clone(path);
        if restart { if self.output.start() != 0 { return clone(__mlang_std_audio_last_error()); } }
        if path == "" { return clone("Master VST3 unloaded; preview synth restored."); }
        return format!("Master VST3: {}{}", self.output.processor_name(), restart ? "" : " (audio output disabled)");
    }
    pub fn sequencer_events(self: AudioSystem, events: list<NoteEvent>) -> void {
        if self.output.handle == 0 { return; }
        for event in events {
            var kind: AudioEventKind = event.on == 1 ? AudioEventKind::NoteOn : AudioEventKind::NoteOff;
            if event.instrument != 0 { kind = event.on == 1 ? AudioEventKind::InstrumentNoteOn : AudioEventKind::InstrumentNoteOff; }
            if event.on == 2 { kind = event.instrument == 0 ? AudioEventKind::ControlChange : AudioEventKind::InstrumentControlChange; }
            self.output.post(AudioEvent { kind: kind, sample: event.instrument > 0 ? event.instrument : 0,
                midi: AudioMidiEvent { channel: event.track % 16, note: event.note, velocity: event.velocity }, source: event.track }, 0);
        }
    }
    pub fn add_insert(self: &mut Self, path: str8, id: i32) -> i32 {
        if id < 1 || id > 256 || id > self.insert_paths.len() + 1 { return -1; }
        if self.output.handle == 0 {
            let created: result<AudioController, str8> = AudioController::new(self.requested_sample_rate == 0 ? 48000 : self.requested_sample_rate, self.requested_buffer_frames);
            if created.is_err() { return -1; } self.output = created.unwrap(); self.reconnect_midi();
        }
        let worker: bool = self.midi.worker.raw != 0; let restart: bool = self.output.hardware_output();
        self.midi.release();
        if self.output.stop() != 0 { self.resume_midi(worker); return -1; }
        let loaded: i32 = self.output.load_insert(id, path);
        if loaded == 0 {
            if id > self.insert_paths.len() { self.insert_paths.push(clone(path)); }
            else {
                let old: list<str8> = self.insert_paths; var paths: list<str8> = [];
                for i in 0..old.len() { if i + 1 == id { free(old[i]); paths.push(clone(path)); } else { paths.push(old[i]); } }
                self.insert_paths = paths;
            }
        }
        if restart { self.output.start(); } self.resume_midi(worker);
        return loaded == 0 ? id : -1;
    }
    pub fn release(self: &mut Self) -> void {
        self.midi.release();
        if self.output.handle != 0 { if self.output.close() == 0 { self.output.handle = 0; } }
        if self.processor_path != "" { free(self.processor_path); }
        self.processor_path = "";
        let paths: list<str8> = self.instrument_paths; for path in paths { if path != "" { free(path); } }
        self.instrument_paths = [];
        let insert_paths: list<str8> = self.insert_paths; for path in insert_paths { free(path); } self.insert_paths = [];
        let effects: list<EffectChannel> = self.effects; for effect in effects { if effect.path != "" { free(effect.path); } } self.effects = [];
        self.pads = [];
    }
}
