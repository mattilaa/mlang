mod std::audio::controller;
mod tui_demo::midi_controller;
mod tui_demo::note_playback;
mod tui_demo::sequence;
use tui_demo::sequence::SequenceTable;
use tui_demo::sequence::SequenceTrack;
use std::audio::controller::*;
use std::audio::detail::__mlang_std_audio_last_error;
use std::midi::input_count;
use tui_demo::midi_controller::MidiController;
use tui_demo::note_playback::NoteEvent;
use std::strbuf::clone;
use std::strbuf::free;

/// Control-thread owner. AUHAL owns rendering; MIDI uses its separate lane.
pub struct AudioSystem {
    var output: AudioController; var midi: MidiController;
    var midi_id: i64{-1}; var output_id: i64{-1};
    var processor_path: str8{""};
    var instrument_paths: list<str8>;
    var last_instrument_id: i32;
    var instrument_output_failed: bool;
};
impl AudioSystem {
    pub fn start(hardware: bool) -> AudioSystem {
        var system: AudioSystem = AudioSystem {};
        if hardware {
            let opened: result<AudioController, str8> = AudioController::open(-1, 128);
            if opened.is_ok() {
                system.output = opened.unwrap();
                if system.output.start() != 0 { system.output.close(); system.output.handle = 0; }
            }
            system.midi = MidiController::start_selected(-1, system.output.handle);
        }
        return system;
    }
    /// Prepare new output before retiring old resources. Failure leaves old output.
    pub fn configure(self: &mut Self, midi_id: i64, output_id: i64) -> result<i32, str8> {
        if midi_id < -2 || output_id < -2 { return Err<i32, str8>("Invalid device selection"); }
        if midi_id >= std::midi::input_count() { return Err<i32, str8>("MIDI adapter unavailable; reopen Settings"); }
        var next: AudioController = AudioController {};
        if output_id != -2 {
            let opened: result<AudioController, str8> = AudioController::open(output_id, 128);
            if opened.is_err() { return Err<i32, str8>(__mlang_std_audio_last_error()); }
            next = opened.unwrap();
        }
        if output_id == -2 && (self.instrument_paths.len() > 0 || self.processor_path != "") {
            let created: result<AudioController, str8> = AudioController::new(48000, 128);
            if created.is_err() { return Err<i32, str8>(__mlang_std_audio_last_error()); }
            next = created.unwrap();
        }
        if next.handle != 0 {
            if self.processor_path != "" {
                if next.load_processor(self.processor_path) != 0 { next.close(); return Err<i32, str8>(__mlang_std_audio_last_error()); }
            }
            for i in 0..self.instrument_paths.len() {
                if self.instrument_paths[i] != "" {
                    if next.load_instrument(i + 1, self.instrument_paths[i]) != 0 { next.close(); return Err<i32, str8>(__mlang_std_audio_last_error()); }
                }
            }
            if output_id != -2 { if next.start() != 0 { next.close(); return Err<i32, str8>(__mlang_std_audio_last_error()); } }
        }
        // Never free an audio handle while the MIDI producer still borrows it.
        self.midi.release();
        if self.output.handle != 0 {
            if self.output.close() != 0 {
                if next.handle != 0 { next.close(); }
                self.midi = MidiController::start_selected(self.midi_id, self.output.handle);
                return Err<i32, str8>("Could not stop previous output; settings unchanged");
            }
        }
        self.output = next; self.midi_id = midi_id; self.output_id = output_id;
        self.midi = MidiController::start_selected(midi_id, self.output.handle);
        return Ok<i32, str8>(0);
    }
    pub fn poll(self: &mut Self, now: i64) -> bool { return self.midi.poll(now); }
    pub fn route_selected(self: AudioSystem, source: &SequenceTable) -> void {
        var table: SequenceTable = SequenceTable {}; table = source;
        if self.output.handle == 0 { return; }
        let index: i32 = table.active_track();
        if index < 0 { self.output.midi_target(0, -1); return; }
        let track: SequenceTrack = table.tracks[index];
        var slot: i32 = 0;
        if track.audio || track.muted { slot = -1; }
        else if track.instrument { slot = track.instrument_id > 0 ? track.instrument_id : -1; }
        self.output.midi_target(index, slot);
    }
    // A device worker may already exist when loading creates an offline output.
    fn reconnect_midi(self: &mut Self) -> void {
        if self.midi.worker.raw != 0 {
            self.midi.release(); self.midi = MidiController::start_selected(self.midi_id, self.output.handle);
        }
    }
    /// Returns owned error text, or empty literal on success. IDs remain stable.
    pub fn add_instrument(self: &mut Self, path: str8) -> str8 {
        self.instrument_output_failed = false;
        var slot: i32 = i32(self.instrument_paths.len()) + 1;
        for i in 0..self.instrument_paths.len() { if self.instrument_paths[i] == "" && slot > self.instrument_paths.len() { slot = i32(i) + 1; } }
        if slot > 32 { return clone("Maximum 32 loaded instruments"); }
        if self.output.handle == 0 {
            let created: result<AudioController, str8> = AudioController::new(48000, 128);
            if created.is_err() { return clone(__mlang_std_audio_last_error()); }
            self.output = created.unwrap();
            self.reconnect_midi();
        }
        let restart: bool = self.output.hardware_output();
        if self.output.stop() != 0 { return clone(__mlang_std_audio_last_error()); }
        if self.output.load_instrument(slot, path) != 0 {
            let error: str8 = format!("Instrument load failed: {}", __mlang_std_audio_last_error());
            if restart { self.output.start(); } return error;
        }
        if slot > self.instrument_paths.len() { self.instrument_paths.push(clone(path)); }
        else {
            let old: list<str8> = self.instrument_paths; var next: list<str8> = [];
            for i in 0..old.len() { next.push(i + 1 == slot ? clone(path) : old[i]); }
            self.instrument_paths = next;
        }
        self.last_instrument_id = slot;
        // The loaded slot remains valid even if hardware cannot restart.
        if restart { self.instrument_output_failed = self.output.start() != 0; }
        return "";
    }
    pub fn remove_instrument(self: &mut Self, slot: i32) -> str8 {
        if slot < 1 || slot > self.instrument_paths.len() { return clone("Select a loaded instrument"); }
        if self.instrument_paths[slot - 1] == "" { return clone("Select a loaded instrument"); }
        let restart: bool = self.output.hardware_output();
        let worker: bool = self.midi.worker.raw != 0;
        self.output.midi_target(0, -1);
        self.midi.release();
        if self.output.stop() != 0 {
            if worker { self.midi = MidiController::start_selected(self.midi_id, self.output.handle); }
            return clone("Could not stop audio; instrument retained");
        }
        self.output.panic();
        if self.output.unload_instrument(slot) != 0 {
            if restart { self.output.start(); }
            if worker { self.midi = MidiController::start_selected(self.midi_id, self.output.handle); }
            return clone("Instrument unload failed");
        }
        let old: list<str8> = self.instrument_paths; var next: list<str8> = [];
        for i in 0..old.len() { if i + 1 == slot { free(old[i]); next.push(""); } else { next.push(old[i]); } }
        self.instrument_paths = next;
        self.instrument_output_failed = restart && self.output.start() != 0;
        if worker { self.midi = MidiController::start_selected(self.midi_id, self.output.handle); }
        return "";
    }
    /// Returns an owned status string. Load outside the audio callback; retain
    /// the old processor if the new bundle cannot initialize.
    pub fn set_processor(self: &mut Self, path: str8) -> str8 {
        if self.output.handle == 0 {
            let created: result<AudioController, str8> = AudioController::new(48000, 128);
            if created.is_err() { return clone(__mlang_std_audio_last_error()); }
            self.output = created.unwrap();
            self.reconnect_midi();
        }
        let restart: bool = self.output.hardware_output();
        if self.output.stop() != 0 { return clone(__mlang_std_audio_last_error()); }
        let loaded: i32 = self.output.load_processor(path);
        if loaded != 0 {
            let error: str8 = format!("VST3 load failed: {}", __mlang_std_audio_last_error());
            if restart { self.output.start(); }
            return error;
        }
        if self.processor_path != "" { free(self.processor_path); }
        self.processor_path = path == "" ? "" : clone(path);
        if restart { if self.output.start() != 0 { return clone(__mlang_std_audio_last_error()); } }
        if path == "" { return clone("Master VST3 unloaded; preview synth restored."); }
        return format!("Master VST3: {}{}", self.output.processor_name(), restart ? "" : " (audio output disabled)");
    }
    pub fn sequencer_events(self: AudioSystem, events: list<NoteEvent>) -> void {
        if self.output.handle == 0 { return; }
        for event in events {
            var kind: AudioEventKind = event.on == 1 ? AudioEventKind::NoteOn : AudioEventKind::NoteOff;
            if event.instrument != 0 { kind = event.on == 1 ? AudioEventKind::InstrumentNoteOn : AudioEventKind::InstrumentNoteOff; }
            if event.on == 2 { kind = event.instrument == 0 ? AudioEventKind::ControlChange : AudioEventKind::InstrumentControlChange; }
            self.output.post(AudioEvent { kind: kind, sample: event.instrument > 0 ? event.instrument : 0,
                midi: AudioMidiEvent { channel: event.track % 16, note: event.note, velocity: event.velocity }, source: event.track }, 0);
        }
    }
    pub fn release(self: &mut Self) -> void {
        self.midi.release();
        if self.output.handle != 0 { if self.output.close() == 0 { self.output.handle = 0; } }
        if self.processor_path != "" { free(self.processor_path); }
        self.processor_path = "";
        let paths: list<str8> = self.instrument_paths; for path in paths { if path != "" { free(path); } }
        self.instrument_paths = [];
    }
}
