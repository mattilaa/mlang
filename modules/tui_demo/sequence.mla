/// Editable sequence used by tui_demo; not part of the reusable TUI library.
mod tui::table;
mod tui::textfield;
mod tui::dialog;
use tui::dialog::Dialog;
use tui::table::*;
use tui::textfield::TextField;
use tui::geometry::*;
use tui::surface::*;
use tui::theme::*;
use tui::input::*;
use tui::menu::Key;
use std::strbuf::clone;
use std::strbuf::free;
use std::strbuf::len;
use std::strbuf::find;
use std::strbuf::sub;
pub struct AutomationSlot { var parameter: str8; var minimum: i64; var maximum: i64; };
pub struct SequenceTrack {
    var name: str8; var muted: bool; var cc1: AutomationSlot; var cc2: AutomationSlot;
    var volume: i32{100}; var pan: i32;
    var audio: bool;
};
pub struct SequenceTable : Table {
    var notes: array<str8, 128>;
    var editor: TextField; var editing: bool; var error: str8;
    var delete_pending: bool;
    var top_pending: bool;
    var tracks: list<SequenceTrack>; var edit_mode: i32;
    var next_track_id: i32;
};
impl SequenceTable {
pub fn new() -> SequenceTable {
    // std::array is compiler-provided; array<T, N> needs no module import.
    var midi: array<str8, 128> = {};
    let names: array<str8, 12> = {"C-", "C#", "D-", "D#", "E-", "F-", "F#", "G-", "G#", "A-", "A#", "B-"};
    for i in 0..128 { midi.push(format!("{}{}", names[i % 12], i / 12 - 1)); }
    var rows: list<TableRow> = [];
    for i in 0..64 {
        let number: str8 = format!("{}{}", i < 9 ? "00" : "0", i + 1);
        var cells: list<str8> = [number];
        for _t in 0..3 { cells.push(clone("C-4")); cells.push(clone("100")); cells.push(clone("")); cells.push(clone("")); }
        rows.push(TableRow { cells: cells });
    }
    var tracks: list<SequenceTrack> = [];
    for i in 0..3 {
        tracks.push(SequenceTrack { name: format!("Track {}", i + 1),
            cc1: AutomationSlot { parameter: clone("cc:1"), minimum: 0, maximum: 127 },
            cc2: AutomationSlot { parameter: clone("cc:74"), minimum: 0, maximum: 127 } });
    }
    var table: SequenceTable = SequenceTable { frozen_columns: 1, horizontal_scrollbar: true, vertical_scrollbar: true,
        selected_column: 1, editor: TextField::new(""), error: "", next_track_id: 4 };
    table.rows = rows; table.tracks = tracks; table.notes = midi;
    table.rebuild_columns(); return table;
}
pub fn active_track(self: SequenceTable) -> i32 {
    if self.selected_column < 1 || self.tracks.len() == 0 { return -1; }
    var first: i32 = 1;
    for i in 0..self.tracks.len() {
        first = first + self.track_columns(i32(i));
        if self.selected_column < first { return i32(i); }
    }
    return i32(self.tracks.len()) - 1;
}
/// Independent pattern snapshot, including tracks, automation, mixer settings,
/// cursor and viewport. No owned strings or mutable lists alias the source.
pub fn copy_pattern(self: SequenceTable) -> SequenceTable {
    var copy: SequenceTable = SequenceTable { frozen_columns: self.frozen_columns,
        horizontal_scrollbar: self.horizontal_scrollbar, vertical_scrollbar: self.vertical_scrollbar,
        selected_row: self.selected_row, selected_column: self.selected_column,
        scroll_x: self.scroll_x, scroll_y: self.scroll_y, next_track_id: self.next_track_id,
        editor: TextField::new(""), error: "" };
    var rows: list<TableRow> = []; let source_rows: list<TableRow> = self.rows;
    for row in source_rows {
        var cells: list<str8> = []; let source_cells: list<str8> = row.cells;
        for value in source_cells { cells.push(clone(value)); }
        rows.push(TableRow { cells: cells });
    }
    var tracks: list<SequenceTrack> = []; let source_tracks: list<SequenceTrack> = self.tracks;
    for track in source_tracks {
        tracks.push(SequenceTrack { name: clone(track.name), muted: track.muted, volume: track.volume, pan: track.pan, audio: track.audio,
            cc1: AutomationSlot { parameter: clone(track.cc1.parameter), minimum: track.cc1.minimum, maximum: track.cc1.maximum },
            cc2: AutomationSlot { parameter: clone(track.cc2.parameter), minimum: track.cc2.minimum, maximum: track.cc2.maximum } });
    }
    var notes: array<str8, 128> = {};
    for i in 0..128 { notes.push(clone(self.notes[i])); }
    copy.rows = rows; copy.tracks = tracks; copy.notes = notes;
    copy.rebuild_columns(); return copy;
}
pub fn track_columns(self: SequenceTable, index: i32) -> i32 {
    let track: SequenceTrack = self.tracks[index]; return track.audio ? 2 : 4;
}
pub fn track_start(self: SequenceTable, index: i32) -> i32 {
    var first: i32 = 1;
    for i in 0..index { first = first + self.track_columns(i32(i)); }
    return first;
}
pub fn automation_column(self: SequenceTable, index: i32, slot: i32) -> i32 {
    let track: SequenceTrack = self.tracks[index];
    return self.track_start(index) + (track.audio ? 0 : 2) + slot - 1;
}
pub fn is_note(self: SequenceTable) -> bool {
    let index: i32 = self.active_track(); if index < 0 { return false; }
    let track: SequenceTrack = self.tracks[index];
    return !track.audio && self.selected_column == self.track_start(index);
}
fn replace_track(self: &mut Self, index: i32, value: SequenceTrack) -> void {
    var tracks: list<SequenceTrack> = [];
    for i in 0..self.tracks.len() { tracks.push(i == index ? value : self.tracks[i]); }
    self.tracks = tracks;
}
pub fn rebuild_columns(self: &mut Self) -> void {
    let old_groups: list<TableGroup> = self.groups;
    for group in old_groups { free(group.title); }
    var columns: list<TableColumn> = [TableColumn { title: "ROW", width: 4, value_type: "u32", read_only: true }];
    var groups: list<TableGroup> = [];
    for i in 0..self.tracks.len() {
        let track: SequenceTrack = self.tracks[i];
        groups.push(TableGroup { title: format!("{}{}", track.name, track.muted ? " [M]" : ""), first: i32(columns.len()), count: self.track_columns(i32(i)) });
        if !track.audio {
            columns.push(TableColumn { title: "NOTE", width: 6, value_type: "str8", pattern: "[A-G][#-]-?[0-9]", nullable: true });
            columns.push(TableColumn { title: "VEL", width: 4, value_type: "i32", bounded: true, minimum: 0, maximum: 127, nullable: true });
        }
        columns.push(TableColumn { title: "CC1", width: 6, value_type: "i32", bounded: true,
            minimum: track.cc1.minimum, maximum: track.cc1.maximum, nullable: true });
        columns.push(TableColumn { title: "CC2", width: 6, value_type: "i32", bounded: true,
            minimum: track.cc2.minimum, maximum: track.cc2.maximum, nullable: true });
    }
    self.columns = columns; self.groups = groups;
}
pub fn create_track(self: &mut Self, duplicate: bool, area: Rect) -> void {
    self.create_track_kind(duplicate, false, area);
}
pub fn create_track_kind(self: &mut Self, duplicate: bool, audio: bool, area: Rect) -> void {
    if self.tracks.len() >= 64 { self.error = "Maximum 64 tracks"; return; }
    let source: i32 = self.active_track();
    if duplicate && source < 0 { return; }
    var track: SequenceTrack = SequenceTrack { name: format!("{} {}", audio ? "Audio" : "Track", self.next_track_id), audio: audio,
        cc1: AutomationSlot { parameter: clone("cc:1"), minimum: 0, maximum: 127 },
        cc2: AutomationSlot { parameter: clone("cc:74"), minimum: 0, maximum: 127 } };
    if duplicate {
        let original: SequenceTrack = self.tracks[source];
        free(track.name); free(track.cc1.parameter); free(track.cc2.parameter);
        track = SequenceTrack { name: format!("{} copy", original.name), muted: original.muted, volume: original.volume, pan: original.pan, audio: original.audio,
            cc1: AutomationSlot { parameter: clone(original.cc1.parameter), minimum: original.cc1.minimum, maximum: original.cc1.maximum },
            cc2: AutomationSlot { parameter: clone(original.cc2.parameter), minimum: original.cc2.minimum, maximum: original.cc2.maximum } };
    }
    self.tracks.push(track);
    if !duplicate { self.next_track_id = self.next_track_id + 1; }
    var rows: list<TableRow> = [];
    let old: list<TableRow> = self.rows;
    for row in old {
        var cells: list<str8> = []; let previous: list<str8> = row.cells;
        for value in previous { cells.push(value); }
        for c in 0..self.track_columns(i32(self.tracks.len()) - 1) {
            if duplicate { cells.push(clone(row.cells[self.track_start(source) + c])); }
            else { cells.push(clone("")); }
        }
        rows.push(TableRow { cells: cells });
    }
    self.rows = rows; self.selected_column = self.track_start(i32(self.tracks.len()) - 1);
    self.rebuild_columns(); self.reconcile(area); self.error = "";
}
pub fn remove_track(self: &mut Self, area: Rect) -> void {
    let index: i32 = self.active_track();
    if index < 0 { return; }
    if self.tracks.len() <= 1 { self.error = "Keep at least one track"; return; }
    let first: i32 = self.track_start(index); let end: i32 = first + self.track_columns(index);
    var tracks: list<SequenceTrack> = [];
    for i in 0..self.tracks.len() {
        let track: SequenceTrack = self.tracks[i];
        if i == index { free(track.name); free(track.cc1.parameter); free(track.cc2.parameter); }
        else { tracks.push(track); }
    }
    var rows: list<TableRow> = []; let previous: list<TableRow> = self.rows;
    for row in previous {
        var cells: list<str8> = [];
        for c in 0..row.cells.len() {
            if c >= first && c < end { free(row.cells[c]); }
            else { cells.push(row.cells[c]); }
        }
        rows.push(TableRow { cells: cells });
    }
    let next: i32 = index >= tracks.len() ? i32(tracks.len()) - 1 : index;
    self.tracks = tracks; self.rows = rows;
    self.selected_column = self.track_start(next);
    self.rebuild_columns(); self.reconcile(area); self.error = "";
}
pub fn clear_track(self: &mut Self) -> void {
    let index: i32 = self.active_track(); if index < 0 { return; }
    let first: i32 = self.track_start(index); let end: i32 = first + self.track_columns(index);
    var rows: list<TableRow> = []; let previous: list<TableRow> = self.rows;
    for row in previous {
        var cells: list<str8> = [];
        for c in 0..row.cells.len() {
            if c >= first && c < end { free(row.cells[c]); cells.push(clone("")); }
            else { cells.push(row.cells[c]); }
        }
        rows.push(TableRow { cells: cells });
    }
    self.rows = rows; self.error = "";
}
pub fn rename_track(self: &mut Self, name: str8) -> bool {
    let index: i32 = self.active_track(); if index < 0 { return false; }
    if !table_matches("[A-Za-z0-9][A-Za-z0-9 _-]{0,31}", name) { self.error = "Name: 1-32 letters, digits, spaces, _ or -"; return false; }
    var track: SequenceTrack = self.tracks[index];
    let copy: str8 = clone(name); free(track.name); track.name = copy;
    self.replace_track(index, track); self.rebuild_columns(); self.error = ""; return true;
}
pub fn configure_slot(self: &mut Self, slot: i32, spec: str8) -> bool {
    let index: i32 = self.active_track(); if index < 0 || slot < 1 || slot > 2 { return false; }
    var low: i64 = 0; var high: i64 = 127;
    if spec == "pitchbend" { low = -8192; high = 8191; }
    else if table_matches("cc:[0-9]{1,3}", spec) {
        let suffix: str8 = sub(spec, 3, len(spec) - 3);
        let parsed: result<i64, str8> = table_integer(suffix); free(suffix);
        if parsed.is_err() { return false; }
        if parsed.unwrap() > 127 { self.error = "CC number must be 0-127"; return false; }
    } else if table_matches("[A-Za-z][A-Za-z0-9_]*:-?[0-9]+:-?[0-9]+", spec) {
        let colon: i64 = find(spec, ":");
        let rest: str8 = sub(spec, colon + 1, len(spec) - colon - 1);
        let split: i64 = find(rest, ":");
        let first: str8 = sub(rest, 0, split); let last: str8 = sub(rest, split + 1, len(rest) - split - 1);
        let a: result<i64, str8> = table_integer(first); let b: result<i64, str8> = table_integer(last);
        free(first); free(last); free(rest);
        if a.is_err() || b.is_err() { self.error = "Invalid limits"; return false; }
        low = a.unwrap(); high = b.unwrap();
        if low < -2147483648 || high > 2147483647 || low > high { self.error = "Limits must fit i32, minimum <= maximum"; return false; }
    } else { self.error = "Use cc:N, pitchbend, or name:min:max"; return false; }
    let column: TableColumn = TableColumn { title: "", width: 6, value_type: "i32", bounded: true, minimum: low, maximum: high, nullable: true };
    let rows: list<TableRow> = self.rows;
    for row in rows {
        if !column.validate(row.cells[self.automation_column(index, slot)]) { self.error = "Existing values exceed limits; clear track first"; return false; }
    }
    var track: SequenceTrack = self.tracks[index];
    let copy: str8 = clone(spec);
    let definition: AutomationSlot = AutomationSlot { parameter: copy, minimum: low, maximum: high };
    if slot == 1 { free(track.cc1.parameter); track.cc1 = definition; }
    else { free(track.cc2.parameter); track.cc2 = definition; }
    self.replace_track(index, track); self.rebuild_columns(); self.error = ""; return true;
}
pub fn track_action(self: &mut Self, command: i32, area: Rect) -> void {
    self.delete_pending = false;
    if command == 21 { self.create_track(false, area); return; }
    if command == 28 { self.create_track_kind(false, true, area); return; }
    if command == 23 { self.create_track(true, area); return; }
    if command == 22 { self.remove_track(area); return; }
    if command == 24 { self.clear_track(); return; }
    let index: i32 = self.active_track(); if index < 0 { return; }
    var track: SequenceTrack = self.tracks[index];
    if command == 25 { track.muted = !track.muted; self.replace_track(index, track); self.rebuild_columns(); return; }
    if command == 20 || command == 26 || command == 27 {
        self.edit_mode = command == 20 ? 1 : command - 24;
        self.editor.set_text(command == 20 ? track.name : (command == 26 ? track.cc1.parameter : track.cc2.parameter));
        self.editing = true; self.error = "";
    }
}
pub fn release(self: &mut Self) -> void {
    let tracks: list<SequenceTrack> = self.tracks;
    for track in tracks { free(track.name); free(track.cc1.parameter); free(track.cc2.parameter); }
    let groups: list<TableGroup> = self.groups;
    for group in groups { free(group.title); }
    let rows: list<TableRow> = self.rows;
    for row in rows { let cells: list<str8> = row.cells; for cell in cells { free(cell); } }
    let notes: array<str8, 128> = self.notes;
    for note in notes { free(note); }
    self.editor.release();
}
fn note_index(self: SequenceTable, value: str8) -> i32 {
    for i in 0..128 { if self.notes[i] == value { return i32(i); } }
    return -1;
}
fn commit(self: &mut Self, value: str8) -> bool {
    if !self.can_set(self.selected_row, self.selected_column, value) { self.error = "Invalid type or outside column limits"; return false; }
    if self.is_note() && value != "" {
        if self.note_index(value) < 0 { self.error = "Expected MIDI note C--1 through G-9"; return false; }
    }
    let row: TableRow = self.rows[self.selected_row];
    let old: str8 = row.cells[self.selected_column];
    let copy: str8 = clone(value);
    if !self.set_cell(self.selected_row, self.selected_column, copy) { free(copy); return false; }
    free(old); self.error = ""; return true;
}
pub fn clear_row(self: &mut Self) -> void {
    if self.selected_row < 0 || self.selected_row >= self.rows.len() { return; }
    let row: TableRow = self.rows[self.selected_row];
    // Validate the complete operation before changing any cell.
    for c in 0..self.columns.len() {
        let column: TableColumn = self.columns[c];
        if !column.read_only {
            if !self.can_set(self.selected_row, i32(c), "") { self.error = "Column does not allow an empty value"; return; }
        }
    }
    for c in 0..self.columns.len() {
        let column: TableColumn = self.columns[c];
        if !column.read_only {
            let empty: str8 = clone("");
            self.set_cell(self.selected_row, i32(c), empty); free(row.cells[c]);
        }
    }
    self.error = "";
}
pub fn delete_row(self: &mut Self, area: Rect) -> void {
    if self.selected_row < 0 || self.selected_row >= self.rows.len() { return; }
    let previous: list<TableRow> = self.rows;
    var kept: list<TableRow> = [];
    for i in 0..previous.len() {
        let row: TableRow = previous[i];
        let cells: list<str8> = row.cells;
        if i == self.selected_row {
            for cell in cells { free(cell); }
        } else {
            var replacement: list<str8> = [];
            let index: i32 = i32(kept.len());
            replacement.push(format!("{}{}", index < 9 ? "00" : "0", index + 1));
            for c in 1..cells.len() { replacement.push(cells[c]); }
            free(cells[0]); kept.push(TableRow { cells: replacement });
        }
    }
    self.rows = kept; self.error = ""; self.delete_pending = false;
    self.reconcile(area);
}
pub fn edit_event(self: &mut Self, event: InputEvent, area: Rect) -> bool {
    if event.kind == InputKind::None && event.code == 0 { return false; }
    if self.editing {
        self.delete_pending = false; self.top_pending = false;
        if event.kind == InputKind::Menu && event.key == Key::Escape && event.code < 32 {
            self.editing = false; self.edit_mode = 0; self.error = ""; return true;
        }
        if event.kind == InputKind::Menu && event.key == Key::Enter {
            var accepted: bool = false;
            if self.edit_mode == 1 { accepted = self.rename_track(self.editor.text); }
            else if self.edit_mode > 1 { accepted = self.configure_slot(self.edit_mode - 1, self.editor.text); }
            else { accepted = self.commit(self.editor.text); }
            if accepted { self.editing = false; self.edit_mode = 0; }
        } else { self.editor.on_event(event); }
        return true;
    }
    let delete_key: bool = event.modifiers == 1 && event.code == 100;
    if !delete_key { self.delete_pending = false; }
    let top_key: bool = event.modifiers == 1 && event.code == 103;
    if !top_key { self.top_pending = false; }
    self.reconcile(area);
    if (event.code == 71 && (event.modifiers == 1 || event.modifiers == 2)) ||
            (event.code == 103 && event.modifiers == 2) {
        self.selected_row = i32(self.rows.len()) - 1; self.reconcile(area); return true;
    }
    if top_key {
        if self.top_pending { self.selected_row = 0; self.top_pending = false; self.reconcile(area); }
        else { self.top_pending = true; }
        return true;
    }
    if self.selected_row < 0 || self.selected_column < 0 { return self.on_event(event, area); }
    if delete_key {
        if self.delete_pending { self.delete_row(area); }
        else { self.delete_pending = true; }
        return true;
    }
    if event.modifiers == 2 && (event.code == 8 || event.code == 127) {
        self.clear_row(); return true;
    }
    let row: TableRow = self.rows[self.selected_row];
    if event.kind == InputKind::Menu && event.key == Key::Enter {
        self.editor.set_text(row.cells[self.selected_column]); self.editing = true; self.edit_mode = 0; self.error = ""; return true;
    }
    var delta: i32 = 0;
    if event.modifiers == 1 || event.modifiers == 2 {
        if event.code == 74 || (event.modifiers == 2 && event.code == 106) { delta = -1; }
        if event.code == 75 || (event.modifiers == 2 && event.code == 107) { delta = 1; }
    }
    if delta != 0 {
        if row.cells[self.selected_column] == "" {
            if self.is_note() { self.commit("C-4"); }
            else {
                let column: TableColumn = self.columns[self.selected_column];
                if column.value_type != "str8" && column.value_type != "bool" {
                    let initial: str8 = format!("{}", column.bounded ? column.minimum : 0);
                    self.commit(initial); free(initial);
                }
            }
            return true;
        }
        if self.is_note() {
            let next: i32 = self.note_index(row.cells[self.selected_column]) + delta;
            if next >= 0 && next < 128 { self.commit(self.notes[next]); }
        } else {
            let column: TableColumn = self.columns[self.selected_column];
            if column.value_type != "str8" && column.value_type != "bool" {
                let parsed: result<i64, str8> = table_integer(row.cells[self.selected_column]);
                if parsed.is_ok() {
                    let value: i64 = parsed.unwrap();
                    if delta > 0 && value == 9223372036854775807 { return true; }
                    if delta < 0 && value == -9223372036854775807 - 1 { return true; }
                    let text: str8 = format!("{}", value + delta);
                    if column.validate(text) { self.commit(text); }
                    free(text);
                }
            }
        }
        return true;
    }
    return self.on_event(event, area);
}
pub fn paint_editor(self: SequenceTable, surface: Surface, area: Rect, theme: Theme) -> void {
    if self.editing && self.edit_mode == 0 { self.editor.paint(surface, self.selected_rect(area), theme.foreground, theme.selection, true); }
}
pub fn paint_track_dialog(self: SequenceTable, surface: Surface, viewport: Rect, theme: Theme) -> void {
    if !self.editing || self.edit_mode == 0 { return; }
    let dialog: Dialog = Dialog { title: self.edit_mode == 1 ? "Rename track" : (self.edit_mode == 2 ? "Configure CC1" : "Configure CC2"), width: 64, height: 9 };
    let content: Rect = dialog.paint_frame(surface, viewport, theme);
    surface.text(Rect::new(content.x, content.y, content.width, 1), self.edit_mode == 1 ? "Track name:" : "cc:N | pitchbend | name:min:max", theme.foreground, theme.panel);
    if content.height > 2 { self.editor.paint(surface, Rect::new(content.x, content.y + 2, content.width, 1), theme.foreground, theme.selection, true); }
    if content.height > 4 { surface.text(Rect::new(content.x, content.y + 4, content.width, 1), self.error == "" ? "Enter: save | Esc: cancel" : self.error, theme.accent, theme.panel); }
}
pub fn paint_track_details(self: SequenceTable, surface: Surface, area: Rect, theme: Theme) -> void {
    let index: i32 = self.active_track(); if index < 0 || area.height < 3 { return; }
    let track: SequenceTrack = self.tracks[index];
    let title: str8 = format!("{} [{}]{}", track.name, track.audio ? "AUDIO" : "MIDI", track.muted ? " [muted]" : "");
    let parameters: str8 = format!("CC1={}  CC2={}", track.cc1.parameter, track.cc2.parameter);
    surface.text(Rect::new(area.x, area.y + 1, area.width, 1), title, theme.accent, theme.panel);
    surface.text(Rect::new(area.x, area.y + 2, area.width, 1), parameters, theme.muted, theme.panel);
    free(title); free(parameters);
}
}
