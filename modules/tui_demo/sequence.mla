use tui_demo::waveform::paint_grainy_row;
use tui_demo::waveform::paint_grainy_row_duration;
use tui::dialog::Dialog;
use tui::table::*;
use tui::textfield::TextField;
use tui::geometry::*;
use tui::surface::*;
use tui::theme::*;
use tui::input::*;
use tui::menu::Key;
use std::strbuf::clone;
use std::strbuf::free;
use std::strbuf::len;
use std::strbuf::find;
use std::strbuf::sub;
pub struct AutomationSlot { var parameter: str8; var minimum: i64; var maximum: i64; };
/// Automation columns a track may hold.
pub fn automation_limit() -> i32 { return 16; }
/// Automation steps per row: a row is a sixteenth, a step a 1/64 note.
pub fn automation_steps_per_row() -> i32 { return 4; }
/// One cell holds a single value played on the row, or four space-separated
/// 1/64 steps where "." leaves a step empty ("12 . 31 40").
pub fn automation_pattern() -> str8 { return "(-?[0-9]{1,10}|\\.)( (-?[0-9]{1,10}|\\.)){3}|-?[0-9]{1,10}"; }
/// A new track automates the modulation wheel.
pub fn default_automation() -> list<AutomationSlot> {
    return [AutomationSlot { parameter: clone("cc:1"), minimum: 0, maximum: 127 }];
}
/// MIDI controller of an automation parameter: 0-127 for "cc:N", 129 for
/// pitch bend, -1 for a named parameter that plays nothing.
pub fn automation_controller(parameter: str8) -> i64 {
    if parameter == "pitchbend" { return 129; }
    if !table_matches("cc:[0-9]{1,3}", parameter) { return -1; }
    let suffix: str8 = sub(parameter, 3, len(parameter) - 3);
    let parsed: result<i64, str8> = table_integer(suffix); free(suffix);
    if parsed.is_err() { return -1; }
    let number: i64 = parsed.unwrap(); return number <= 127 ? number : -1;
}
/// Column header of an automation parameter: "CC74", "PB", or the name.
pub fn automation_title(parameter: str8) -> str8 {
    let controller: i64 = automation_controller(parameter);
    if controller == 129 { return clone("PB"); }
    if controller >= 0 { return format!("CC{}", controller); }
    let colon: i64 = find(parameter, ":");
    let size: i64 = colon > 0 ? colon : len(parameter);
    return sub(parameter, 0, size > 5 ? 5 : size);
}
/// The four steps of an automation cell, owned; "" is an empty step.
pub fn automation_steps(text: str8) -> list<str8> {
    var steps: list<str8> = []; let count: i32 = automation_steps_per_row();
    if find(text, " ") < 0 {
        steps.push(clone(text));
        for _s in 1..count { steps.push(clone("")); }
        return steps;
    }
    var rest: str8 = clone(text);
    for _s in 0..count {
        let space: i64 = find(rest, " ");
        let size: i64 = space < 0 ? len(rest) : space;
        let part: str8 = sub(rest, 0, size);
        if part == "." { free(part); steps.push(clone("")); } else { steps.push(part); }
        let next: str8 = space < 0 ? clone("") : sub(rest, space + 1, len(rest) - space - 1);
        free(rest); rest = next;
    }
    free(rest); return steps;
}
/// Cell text of four steps, which it frees: a lone first step stays a plain value.
pub fn automation_text(steps: list<str8>) -> str8 {
    var single: bool = true;
    for s in 1..steps.len() { if steps[s] != "" { single = false; } }
    var text: str8 = clone(single && steps.len() > 0 ? steps[0] : "");
    if !single {
        for s in 0..steps.len() {
            let joined: str8 = format!("{}{}{}", text, s == 0 ? "" : " ", steps[s] == "" ? "." : steps[s]);
            free(text); text = joined;
        }
    }
    for step in steps { free(step); }
    return text;
}
pub fn free_steps(steps: list<str8>) -> void { for step in steps { free(step); } }
/// True when every step of `text` is empty or a value within the limits.
pub fn automation_valid(text: str8, minimum: i64, maximum: i64) -> bool {
    if text == "" { return true; }
    if !table_matches(automation_pattern(), text) { return false; }
    let steps: list<str8> = automation_steps(text); var valid: bool = true;
    for step in steps {
        if step == "" { continue; }
        let parsed: result<i64, str8> = table_integer(step);
        if parsed.is_err() || parsed.unwrap() < minimum || parsed.unwrap() > maximum { valid = false; }
    }
    free_steps(steps); return valid;
}
// Keep the fixed-size list element naturally aligned (no trailing bool padding).
pub struct RecordedKey { var row: i32; var line: i32; var note: i64; var channel: i64; var start: i64; var held: i64; };
pub struct ViewNote { var row: i32; var column: i32; var lane: i32; var slot: i32; };
pub struct NoteSpan { var start: i64; var end: i64; };
/// "Track 1 - 2" -> "Track 1": splitting twice must not stack suffixes.
fn strip_split_suffix(name: str8) -> str8 {
    let size: i64 = len(name);
    for i in 0..size {
        let at: i64 = size - 1 - i;
        if at < 3 { break; }
        let candidate: str8 = sub(name, at - 3, 3);
        let tail: str8 = sub(name, at, size - at);
        let matched: bool = candidate == " - " && table_matches("[0-9]{1,2}", tail);
        free(candidate);
        if matched { free(tail); return sub(name, 0, at - 3); }
        free(tail);
    }
    return clone(name);
}
pub struct AudioInstance { var clip: AudioClip; var start_row: i32; var length_ticks: i32; var offset_frames: i64; };
impl AudioInstance {
    /// Borrowed render view: metadata is gated by LEN and the non-destructive
    /// start trim; shares the full sample buffer. Never release this view.
    pub fn render_clip(self: AudioInstance) -> AudioClip {
        var clip: AudioClip = AudioClip {}; clip = self.clip;
        var off: i64 = self.offset_frames; if off < 0 { off = 0; } if off > self.clip.frames { off = self.clip.frames; }
        clip.offset = off;
        var window: i64 = self.clip.frames - off; if window < 0 { window = 0; }
        if self.length_ticks > 0 {
            let durf: i64 = (wide(self.length_ticks) * self.clip.frames_per_row + 14999) / 15000;
            if durf < window { window = durf; }
        }
        clip.frames = window;
        return clip;
    }
    pub fn duration(self: AudioInstance) -> i64 {
        if self.length_ticks > 0 { return wide(self.length_ticks); }
        if self.clip.frames_per_row > 0 { return self.clip.frames * 15000 / self.clip.frames_per_row; }
        return wide(i32(self.clip.peaks.len())) * 15000;
    }
}
pub struct SequenceTrack {
    var name: str8; var muted: bool;
    /// One column per automated parameter, after the note lines.
    var automation: list<AutomationSlot>;
    var volume: i32{100}; var pan: i32;
    var record_armed: bool;
    var sends: list<i32>;
    var inserts: list<i32>;
    var audio: bool;
    /// Output channel: 0 = master, otherwise the destination track index + 1.
    /// Only audio tracks are destinations; an instrument track sends the audio
    /// of its instrument there.
    var output: i32;
    var instrument: bool; var instrument_id: i32;
    var note_lines: i32{1};
    var instances: list<AudioInstance>;
    var wave_zoom: bool;
    var zoom_stage: i32;
};
impl SequenceTrack {
    pub fn insert_id(self: SequenceTrack, position: i32) -> i32 {
        if position < 0 || position >= self.inserts.len() { return 0; } return self.inserts[position];
    }
    pub fn send_level(self: SequenceTrack, fx: i32) -> i32 {
        if fx < 0 || fx >= self.sends.len() { return 0; } return self.sends[fx];
    }
    pub fn copy_sends(self: SequenceTrack) -> list<i32> {
        var copy: list<i32> = []; for i in 0..self.sends.len() { copy.push(self.sends[i]); } return copy;
    }
    pub fn instance_at(self: SequenceTrack, row: i32) -> i32 {
        for i in 0..self.instances.len() {
            let instance: AudioInstance = self.instances[i];
            if row >= instance.start_row && wide(row - instance.start_row) * 15000 < instance.duration() { return i32(i); }
        }
        return -1;
    }
    pub fn copy_audio(self: SequenceTrack) -> list<AudioInstance> {
        var copies: list<AudioInstance> = []; let instances: list<AudioInstance> = self.instances;
        for instance in instances { copies.push(AudioInstance { clip: instance.clip.copy(), start_row: instance.start_row, length_ticks: instance.length_ticks, offset_frames: instance.offset_frames }); }
        return copies;
    }
    pub fn release_audio(self: SequenceTrack) -> void {
        let instances: list<AudioInstance> = self.instances;
        for instance in instances { instance.clip.release(); }
    }
    pub fn copy_automation(self: SequenceTrack) -> list<AutomationSlot> {
        var copies: list<AutomationSlot> = []; let slots: list<AutomationSlot> = self.automation;
        for slot in slots { copies.push(AutomationSlot { parameter: clone(slot.parameter), minimum: slot.minimum, maximum: slot.maximum }); }
        return copies;
    }
    /// Frees the name and automation strings; audio is released separately.
    pub fn release_strings(self: SequenceTrack) -> void {
        free(self.name);
        let slots: list<AutomationSlot> = self.automation;
        for slot in slots { free(slot.parameter); }
    }
    /// Zero-based automation slot playing `controller`, or -1.
    pub fn automation_of(self: SequenceTrack, controller: i64) -> i32 {
        for i in 0..self.automation.len() {
            let slot: AutomationSlot = self.automation[i];
            if automation_controller(slot.parameter) == controller { return i32(i); }
        }
        return -1;
    }
}
/// Validated output channel of `index`: 0 = master, otherwise the destination
/// track index + 1. A route to a missing track, to itself or to a channel that
/// is not an audio track reads as master.
pub fn track_output_of(tracks: list<SequenceTrack>, index: i32) -> i32 {
    if index < 0 || index >= tracks.len() { return 0; }
    let track: SequenceTrack = tracks[index];
    let destination: i32 = track.output;
    if destination <= 0 || destination > tracks.len() || destination - 1 == index { return 0; }
    let target: SequenceTrack = tracks[destination - 1];
    return target.audio ? destination : 0;
}
/// Mixer OUT row for a channel that plays instrument `instrument_id` (0 when
/// it plays none) and feeds `destination` (0 = master, else a track index + 1):
/// "OUT:MST", "OUT:A3", "OUT:I4", or both hops as "I4>A3".
pub fn output_label_text(instrument_id: i32, destination: i32) -> str8 {
    if instrument_id > 0 {
        return destination > 0 ? format!("I{}>A{}", instrument_id, destination) : format!("OUT:I{}", instrument_id);
    }
    return destination > 0 ? format!("OUT:A{}", destination) : clone("OUT:MST");
}
pub fn track_output_label(tracks: list<SequenceTrack>, index: i32) -> str8 {
    if index < 0 || index >= tracks.len() { return clone("OUT:MST"); }
    let track: SequenceTrack = tracks[index];
    // Same validation as track_output_of; the list cannot be passed on twice.
    var destination: i32 = track.output;
    if destination > tracks.len() || destination - 1 == index { destination = 0; }
    if destination > 0 {
        let target: SequenceTrack = tracks[destination - 1];
        if !target.audio { destination = 0; }
    }
    return output_label_text(track.instrument ? track.instrument_id : 0, destination);
}
pub struct SequenceTable : Table {
    var recording_track: i32{-1}; var recorded_keys: list<RecordedKey>;
    var recording_extend: bool{true}; var recording_cleared: i64{-1};
    var notes: array<str8, 128>;
    var editor: TextField; var editing: bool; var error: str8;
    var delete_pending: bool;
    var top_pending: bool;
    var tracks: list<SequenceTrack>; var edit_mode: i32;
    /// One-based automation slot the configure dialog edits.
    var edit_slot: i32;
    var next_track_id: i32; var revision: i64;
    var clipboard: list<TableRow>; var clipboard_kinds: list<str8>; var paste_error: bool;
    var clipboard_rows: bool; var clipboard_spacing: i32;
    var audio_clipboard: AudioClip;
    /// Automation column headers, owned here and replaced by rebuild_columns.
    var column_titles: list<str8>;
};
impl SequenceTable {
pub fn set_insert(self: &mut Self, index: i32, position: i32, id: i32) -> void {
    if index < 0 || index >= self.tracks.len() || position < 0 || position >= 4 || id < 0 || id > 256 { return; }
    let selected: SequenceTrack = self.tracks[index]; let linked: i32 = selected.instrument ? selected.instrument_id : 0;
    let old: list<SequenceTrack> = self.tracks;
    for i in 0..old.len() {
        var track: SequenceTrack = old[i];
        if i == index || (linked > 0 && track.instrument && track.instrument_id == linked) {
            var ids: list<i32> = [];
            for n in 0..4 { let value: i32 = n == position ? id : track.insert_id(i32(n)); ids.push(value); }
            track.inserts = ids; self.replace_track(i32(i), track);
        }
    }
}
/// Show each instrument track's instance under its name, numbered as in the
/// Instruments list. Call before painting; the labels are owned by the groups.
pub fn instrument_labels(self: &mut Self, output: AudioController) -> void {
    var any: bool = false;
    let tracks: list<SequenceTrack> = self.tracks;
    for track in tracks { if track.instrument { any = true; } }
    self.group_subtitles = any;
    if !any { return; }
    let old: list<TableGroup> = self.groups; var groups: list<TableGroup> = [];
    for i in 0..old.len() {
        var group: TableGroup = old[i];
        if group.subtitle != "" { free(group.subtitle); }
        let track: SequenceTrack = self.tracks[i];
        if !track.instrument { group.subtitle = ""; }
        else if track.instrument_id <= 0 { group.subtitle = clone("- unassigned -"); }
        else {
            let name: str8 = output.instrument_name(track.instrument_id);
            group.subtitle = format!("{}{} {}", track.instrument_id < 10 ? "00" : (track.instrument_id < 100 ? "0" : ""),
                track.instrument_id, name == "" ? "instrument" : name);
        }
        groups.push(group);
    }
    self.groups = groups;
}
pub fn insert_labels(self: &mut Self, output: AudioController) -> void {
    if self.group_detail_rows == 0 { return; }
    let old: list<TableGroup> = self.groups; var groups: list<TableGroup> = [];
    for i in 0..old.len() {
        var group: TableGroup = old[i]; group.details = [];
        let track: SequenceTrack = self.tracks[i];
        for n in 0..4 {
            let id: i32 = track.insert_id(i32(n));
            group.details.push(id > 0 ? output.instrument_name(id + 40) : "- empty -");
        }
        groups.push(group);
    }
    self.groups = groups;
}
/// Returns 115=load/edit, 116=remove. Insert mode never edits pattern cells.
pub fn insert_event(self: &mut Self, event: InputEvent, area: Rect) -> i32 {
    if event.code == 102 && event.modifiers == 1 {
        self.group_detail_rows = self.group_detail_rows == 0 ? 4 : 0;
        self.selected_group_detail = self.group_detail_rows == 0 ? -1 : 0;
        self.visual = false; self.delete_pending = false; self.reconcile(area); return 0;
    }
    if self.group_detail_rows == 0 { return 0; }
    if event.kind == InputKind::Menu {
        if event.key == Key::Left || event.key == Key::Right { self.mixer_event(event, area); }
        if event.key == Key::Up && self.selected_group_detail > 0 { self.selected_group_detail = self.selected_group_detail - 1; }
        if event.key == Key::Down && self.selected_group_detail < 3 { self.selected_group_detail = self.selected_group_detail + 1; }
        if event.key == Key::Enter { return 115; }
    }
    if event.code == 127 || event.code == 8 { return 116; }
    return 0;
}
pub fn empty() -> SequenceTable {
    var table: SequenceTable = SequenceTable::new();
    let tracks: list<SequenceTrack> = table.tracks;
    for track in tracks { track.release_strings(); }
    table.tracks = []; table.next_track_id = 1;
    let old: list<TableRow> = table.rows; var rows: list<TableRow> = [];
    for row in old {
        let cells: list<str8> = row.cells;
        for i in 1..cells.len() { free(cells[i]); }
        rows.push(TableRow { cells: [cells[0]] });
    }
    table.rows = rows; table.selected_column = 0; table.rebuild_columns(); return table;
}
pub fn new() -> SequenceTable {
    // std::array is compiler-provided; array<T, N> needs no module import.
    var midi: array<str8, 128> = {};
    let names: array<str8, 12> = {"C-", "C#", "D-", "D#", "E-", "F-", "F#", "G-", "G#", "A-", "A#", "B-"};
    for i in 0..128 { midi.push(format!("{}{}", names[i % 12], i / 12 - 1)); }
    var rows: list<TableRow> = [];
    for i in 0..64 {
        let number: str8 = format!("{}{}", i < 9 ? "00" : "0", i + 1);
        var cells: list<str8> = [number];
        for _t in 0..3 { cells.push(clone("C-4")); cells.push(clone("100")); cells.push(clone("1.00")); cells.push(clone("0.00")); cells.push(clone("")); }
        rows.push(TableRow { cells: cells });
    }
    var tracks: list<SequenceTrack> = [];
    for i in 0..3 {
        tracks.push(SequenceTrack { name: format!("Track {}", i + 1), automation: default_automation() });
    }
    var table: SequenceTable = SequenceTable { frozen_columns: 1, horizontal_scrollbar: true, vertical_scrollbar: true, alternate_group_text: true,
        selected_column: 1, editor: TextField::new(""), error: "", next_track_id: 4 };
    table.rows = rows; table.tracks = tracks; table.notes = midi;
    table.rebuild_columns(); return table;
}
pub fn active_track(self: SequenceTable) -> i32 {
    if self.selected_column < 1 || self.tracks.len() == 0 { return -1; }
    var first: i32 = 1;
    for i in 0..self.tracks.len() {
        first = first + self.track_columns(i32(i));
        if self.selected_column < first { return i32(i); }
    }
    return i32(self.tracks.len()) - 1;
}
/// Mixer controls are separate from the pattern's cell-editing shortcuts.
pub fn mixer_event(self: &mut Self, event: InputEvent, area: Rect) -> bool {
    let index: i32 = self.active_track(); if index < 0 { return false; }
    if event.kind == InputKind::Menu && (event.key == Key::Left || event.key == Key::Right) {
        let next: i32 = index + (event.key == Key::Right ? 1 : -1);
        if next >= 0 && next < self.tracks.len() { self.selected_column = self.track_start(next); self.reconcile(area); return true; }
        return false;
    }
    var track: SequenceTrack = self.tracks[index];
    let arm: bool = (event.code == 82 && event.modifiers == 1) || (event.modifiers == 2 && (event.code == 114 || event.code == 82));
    if arm {
        if track.audio { return false; }
        track.record_armed = !track.record_armed; self.replace_track(index, track); return true;
    }
    let down: bool = (event.code == 74 && event.modifiers == 1) || (event.modifiers == 2 && (event.code == 106 || event.code == 74));
    let up: bool = (event.code == 75 && event.modifiers == 1) || (event.modifiers == 2 && (event.code == 107 || event.code == 75));
    if !down && !up { return false; }
    let value: i32 = track.volume + (up ? 1 : -1);
    if value < 0 || value > 100 { return false; }
    let linked_slot: i32 = track.instrument ? track.instrument_id : 0;
    track.volume = value; self.replace_track(index, track);
    // One loaded VST instance has one PCM output: linked assignments share gain.
    if linked_slot > 0 {
        let old: list<SequenceTrack> = self.tracks;
        for i in 0..old.len() {
            var other: SequenceTrack = old[i];
            if other.instrument && other.instrument_id == linked_slot { other.volume = value; self.replace_track(i32(i), other); }
        }
    }
    return true;
}
/// Arm or disarm track `index` for recording; AUDIO tracks never arm.
pub fn set_record_armed(self: &mut Self, index: i32, armed: bool) -> bool {
    if index < 0 || index >= self.tracks.len() { return false; }
    var track: SequenceTrack = self.tracks[index];
    if track.audio { return false; }
    track.record_armed = armed; self.replace_track(index, track); return true;
}
/// Track a matrix take records into: an armed MIDI track, else the MIDI track
/// under the cursor, else the first MIDI track; -1 when there is none.
pub fn recording_candidate(self: SequenceTable) -> i32 {
    for i in 0..self.tracks.len() { let track: SequenceTrack = self.tracks[i]; if !track.audio && track.record_armed { return i32(i); } }
    let active: i32 = self.active_track();
    if active >= 0 { let track: SequenceTrack = self.tracks[active]; if !track.audio { return active; } }
    for i in 0..self.tracks.len() { let track: SequenceTrack = self.tracks[i]; if !track.audio { return i32(i); } }
    return -1;
}
/// Pattern length a take stopped at `tick` leaves: the nearest bar line of
/// `bar_rows` rows, moved on by whole bars while that would cut off notes.
pub fn take_length(self: SequenceTable, tick: i64, bar_rows: i32) -> i32 {
    let bar: i64 = wide(bar_rows < 1 ? 1 : bar_rows);
    var bars: i64 = (tick + bar * 7500) / (bar * 15000);
    if bars < 1 { bars = 1; }
    var length: i64 = bars * bar;
    while length < 16384 && self.length_truncates_data(i32(length)) { length = length + bar; }
    return i32(length > 16384 ? 16384 : length);
}
/// Start a take on one armed synth; subsequent cursor movement cannot reroute it.
pub fn start_recording(self: &mut Self) -> bool {
    let index: i32 = self.active_track(); if index < 0 { return false; }
    let track: SequenceTrack = self.tracks[index];
    if track.audio || !track.record_armed { return false; }
    self.recording_track = index; self.recorded_keys = []; self.recording_cleared = wide(self.selected_row) - 1; return true;
}
pub fn grow_recording(self: &mut Self, tick: i64) -> void {
    if !self.recording_extend { self.clear_recording_rows(tick); return; }
    let requested: i64 = tick / 15000 + 2;
    let count: i32 = i32(requested > 16384 ? 16384 : requested);
    while self.rows.len() < count {
        var cells: list<str8> = [format!("{}", self.rows.len() + 1)]; for _c in 1..self.columns.len() { cells.push(clone("")); }
        self.rows.push(TableRow { cells: cells }); self.revision = self.revision + 1;
    }
}
/// Clear only the armed track as each row is reached; retain chords within a row.
pub fn clear_recording_rows(self: &mut Self, tick: i64) -> void {
    if self.recording_track < 0 || self.rows.len() == 0 { return; }
    let target: i64 = tick / 15000;
    if target <= self.recording_cleared { return; }
    var start: i64 = self.recording_cleared + 1;
    if target - start >= self.rows.len() { start = target - self.rows.len() + 1; }
    let first: i32 = self.track_start(self.recording_track);
    let track: SequenceTrack = self.tracks[self.recording_track];
    for absolute in start..target + 1 {
        let row: i32 = i32(absolute % self.rows.len());
        var retained: list<RecordedKey> = []; let keys: list<RecordedKey> = self.recorded_keys;
        for key in keys { if key.row != row { retained.push(key); } }
        self.recorded_keys = retained;
        for column in 0..(track.note_lines * 4) { self.write_owned_cell(row, first + i32(column), clone("")); }
    }
    self.recording_cleared = target; self.revision = self.revision + 1;
}
pub fn release_recorded(self: &mut Self, note: i64, channel: i64, tick: i64, all: bool) -> void {
    var keys: list<RecordedKey> = []; let old: list<RecordedKey> = self.recorded_keys;
    for entry in old {
        var key: RecordedKey = entry;
        if key.held == 1 && (all || (key.note == note && key.channel == channel)) {
            let length: i64 = tick > key.start ? tick - key.start : 150;
            self.write_owned_cell(key.row, self.track_start(self.recording_track) + key.line * 4 + 2, duration_text(length));
            key.held = 0; self.revision = self.revision + 1;
        }
        keys.push(key);
    }
    self.recorded_keys = keys;
}
pub fn record_timed(self: &mut Self, note: i64, velocity: i64, channel: i64, tick: i64, on: bool) -> bool {
    if self.recording_track < 0 || note < 0 || note > 127 { return false; }
    self.release_recorded(note, channel, tick, false);
    if !on || velocity <= 0 { return true; }
    let time: i64 = tick < 0 ? 0 : tick;
    let absolute_row: i64 = (time + 7500) / 15000;
    self.grow_recording(time + 7500);
    if self.recording_extend && absolute_row >= self.rows.len() { return false; }
    let row_index: i32 = i32(absolute_row % self.rows.len());
    let first: i32 = self.track_start(self.recording_track);
    let track: SequenceTrack = self.tracks[self.recording_track];
    let row: TableRow = self.rows[row_index];
    var used: i32 = 0; var insert: i32 = 0;
    for line in 0..track.note_lines {
        let text: str8 = row.cells[first + line * 4];
        if text != "" {
            used = i32(line) + 1;
            for pitch in 0..128 { if text == self.notes[pitch] && pitch <= note { insert = i32(line) + 1; } }
        }
    }
    if !self.ensure_note_lines(self.recording_track, used + 1) { self.error = "Recording note-line limit reached"; return false; }
    self.rebuild_columns();
    for n in 0..used - insert {
        let source: i32 = used - 1 - i32(n);
        let current: TableRow = self.rows[row_index];
        for f in 0..4 { self.write_owned_cell(row_index, first + (source + 1) * 4 + i32(f), clone(current.cells[first + source * 4 + f])); }
    }
    var keys: list<RecordedKey> = []; let old: list<RecordedKey> = self.recorded_keys;
    for entry in old {
        var key: RecordedKey = entry;
        if key.row == row_index && key.line >= insert { key.line = key.line + 1; }
        keys.push(key);
    }
    keys.push(RecordedKey { row: row_index, line: insert, note: note, channel: channel, start: time, held: 1 });
    self.recorded_keys = keys;
    self.write_owned_cell(row_index, first + insert * 4, clone(self.notes[note]));
    self.write_owned_cell(row_index, first + insert * 4 + 1, format!("{}", velocity));
    self.write_owned_cell(row_index, first + insert * 4 + 2, clone("1.00"));
    self.write_owned_cell(row_index, first + insert * 4 + 3, offset_text(time - absolute_row * 15000));
    self.revision = self.revision + 1; return true;
}
/// Record a controller of the take at the nearest 1/64 step, adding a CC
/// column when the armed track does not automate that controller yet.
/// `controller` 129 is pitch bend with its raw 14-bit value.
pub fn record_control(self: &mut Self, controller: i64, value: i64, tick: i64) -> bool {
    if self.recording_track < 0 || controller < 0 || (controller > 127 && controller != 129) { return false; }
    let bend: bool = controller == 129;
    let stored: i64 = bend ? value - 8192 : value;
    if bend && (stored < -8192 || stored > 8191) { return false; }
    if !bend && (value < 0 || value > 127) { return false; }
    let steps: i64 = wide(automation_steps_per_row()); let step_ticks: i64 = 15000 / steps;
    let time: i64 = tick < 0 ? 0 : tick;
    let position: i64 = (time + step_ticks / 2) / step_ticks;
    let absolute_row: i64 = position / steps;
    self.grow_recording(absolute_row * 15000);
    if self.recording_extend && absolute_row >= self.rows.len() { return false; }
    let track: SequenceTrack = self.tracks[self.recording_track];
    var slot: i32 = track.automation_of(controller) + 1;
    if slot == 0 {
        let spec: str8 = bend ? clone("pitchbend") : format!("cc:{}", controller);
        slot = self.add_automation(self.recording_track, spec); free(spec);
        if slot == 0 { return false; }
    }
    let text: str8 = format!("{}", stored);
    let recorded: bool = self.set_automation_step(i32(absolute_row % self.rows.len()),
        self.automation_column(self.recording_track, slot), i32(position % steps), text);
    free(text); return recorded;
}
pub fn stop_recording(self: &mut Self, tick: i64, area: Rect) -> void {
    if self.recording_track < 0 { return; }
    self.release_recorded(0, 0, tick, true);
    self.selected_column = self.track_start(self.recording_track);
    self.recording_track = -1; self.recorded_keys = [];
    self.track_action(20, area);
}
pub fn record_note(self: &mut Self, note: i64, velocity: i64) -> bool {
    if note < 0 || note > 127 || velocity <= 0 || velocity > 127 || self.editing || self.visual { return false; }
    let index: i32 = self.active_track(); if index < 0 { return false; }
    let track: SequenceTrack = self.tracks[index];
    if track.audio || !track.record_armed || self.selected_row < 0 || self.selected_row >= self.rows.len() { return false; }
    let first: i32 = self.track_start(index);
    let offset: i32 = self.selected_column - first;
    let line: i32 = offset >= 0 && offset < track.note_lines * 4 ? offset / 4 : 0;
    let column: i32 = first + line * 4;
    if self.row_spacing() > 1 {
        let selected: i32 = self.selected_column; self.selected_column = column;
        let accepted: bool = self.subdivision_commit(self.notes[note]);
        if accepted {
            let source: ViewNote = self.subdivision_source();
            if source.row >= 0 { self.write_owned_cell(source.row, source.column + 1, format!("{}", velocity)); }
        }
        self.selected_column = selected; return accepted;
    }
    let row: TableRow = self.rows[self.selected_row];
    let fresh: bool = row.cells[column] == "";
    self.write_owned_cell(self.selected_row, column, clone(self.notes[note]));
    self.write_owned_cell(self.selected_row, column + 1, format!("{}", velocity));
    if fresh {
        self.write_owned_cell(self.selected_row, column + 2, clone("1.00"));
        self.write_owned_cell(self.selected_row, column + 3, clone("0.00"));
    }
    self.revision = self.revision + 1; return true;
}
pub fn set_send(self: &mut Self, index: i32, fx: i32, value: i32) -> bool {
    if index < 0 || index >= self.tracks.len() || fx < 0 || fx >= 8 || value < 0 || value > 100 { return false; }
    let target: SequenceTrack = self.tracks[index];
    let linked: i32 = target.instrument ? target.instrument_id : 0;
    let old: list<SequenceTrack> = self.tracks;
    for i in 0..old.len() {
        var track: SequenceTrack = old[i];
        if i == index || (linked > 0 && track.instrument && track.instrument_id == linked) {
            var sends: list<i32> = []; for bus in 0..8 { sends.push(bus == fx ? value : track.send_level(i32(bus))); }
            track.sends = sends; self.replace_track(i32(i), track);
        }
    }
    return true;
}
/// Output channel of a track: 0 = master, otherwise destination index + 1.
pub fn track_output(self: SequenceTable, index: i32) -> i32 {
    return track_output_of(self.tracks, index);
}
/// Mixer label of a track's output: "MST", "A3", or the instrument it plays.
pub fn output_label(self: SequenceTable, index: i32) -> str8 {
    return track_output_label(self.tracks, index);
}
/// True when routing `index` into `destination` (1-based) would loop back.
pub fn output_loops(self: SequenceTable, index: i32, destination: i32) -> bool {
    if destination <= 0 { return false; }
    var step: i32 = destination - 1;
    for _hop in 0..64 {
        if step == index { return true; }
        let next: i32 = self.track_output(step);
        if next <= 0 { return false; }
        step = next - 1;
    }
    return true;
}
/// Route a track to an audio track (destination index + 1) or to master (0).
/// Tracks sharing one instrument instance share its output channel, exactly as
/// they share its inserts and sends.
pub fn set_track_output(self: &mut Self, index: i32, destination: i32) -> bool {
    if index < 0 || index >= self.tracks.len() || destination < 0 || destination > self.tracks.len() { return false; }
    if destination > 0 {
        if destination - 1 == index { self.error = "A track cannot feed itself"; return false; }
        let target: SequenceTrack = self.tracks[destination - 1];
        if !target.audio { self.error = "Only an AUDIO track can take another channel"; return false; }
        if self.output_loops(index, destination) { self.error = "That route would loop back to this track"; return false; }
    }
    let selected: SequenceTrack = self.tracks[index];
    let linked: i32 = selected.instrument ? selected.instrument_id : 0;
    let old: list<SequenceTrack> = self.tracks;
    for i in 0..old.len() {
        var track: SequenceTrack = old[i];
        if i == index || (linked > 0 && track.instrument && track.instrument_id == linked) {
            track.output = destination; self.replace_track(i32(i), track);
        }
    }
    self.revision = self.revision + 1; self.error = ""; return true;
}
/// MIDI output of a track: the instrument instance its notes play, 0 to detach
/// it back to a plain MIDI track. Tracks on one instance share its inserts,
/// sends and output channel.
pub fn set_instrument_output(self: &mut Self, index: i32, id: i32) -> bool {
    if index < 0 || index >= self.tracks.len() || id < 0 || id > 32 { return false; }
    var track: SequenceTrack = self.tracks[index];
    if track.audio { self.error = "An AUDIO track has no MIDI output"; return false; }
    track.instrument = id > 0; track.instrument_id = id;
    for i in 0..self.tracks.len() {
        let other: SequenceTrack = self.tracks[i];
        if i != index && id > 0 && other.instrument && other.instrument_id == id {
            track.inserts = other.inserts; track.sends = other.copy_sends(); track.output = other.output;
        }
    }
    self.replace_track(index, track); self.rebuild_columns();
    self.revision = self.revision + 1; self.error = ""; return true;
}
/// Drop routes to a removed track and shift the ones past it.
fn remap_outputs(self: &mut Self, removed: i32) -> void {
    let old: list<SequenceTrack> = self.tracks; var tracks: list<SequenceTrack> = [];
    for i in 0..old.len() {
        var track: SequenceTrack = old[i];
        if track.output == removed + 1 { track.output = 0; }
        else if track.output > removed + 1 { track.output = track.output - 1; }
        tracks.push(track);
    }
    self.tracks = tracks;
}
pub fn import_audio(self: &mut Self, path: str8, bpm: i32, area: Rect) -> bool {
    let index: i32 = self.active_track(); if index < 0 { self.error = "Select an AUDIO track first"; return false; }
    var track: SequenceTrack = self.tracks[index];
    if !track.audio { self.error = "Select an AUDIO track first"; return false; }
    let loaded: result<AudioClip, str8> = AudioClip::load(path, bpm);
    if loaded.is_err() { self.error = loaded.unwrap_err(); return false; }
    let clip: AudioClip = loaded.unwrap();
    let inserted: bool = self.insert_audio(clip, area); clip.release(); return inserted;
}
pub fn insert_audio(self: &mut Self, source: &AudioClip, area: Rect) -> bool {
    let index: i32 = self.active_track(); if index < 0 { self.error = "Select an AUDIO track first"; return false; }
    var track: SequenceTrack = self.tracks[index];
    if !track.audio { self.error = "Select an AUDIO track first"; return false; }
    var clip: AudioClip = AudioClip {}; clip = source;
    if clip.peaks.len() == 0 { self.error = "Sample is empty"; return false; }
    let row: i32 = self.selected_row < 0 ? 0 : self.selected_row;
    let count: i32 = row + i32(clip.peaks.len());
    if count > 16384 { self.error = "Audio exceeds 16384 pattern rows"; return false; }
    let instances: list<AudioInstance> = track.instances;
    for instance in instances {
        if wide(row) * 15000 < wide(instance.start_row) * 15000 + instance.duration() && count > instance.start_row {
            self.error = "Audio overlaps another instance"; return false;
        }
    }
    let insert: bool = track.instances.len() == 0;
    let column: i32 = self.audio_length_column(index) + 1;
    track.instances.push(AudioInstance { clip: clip.copy(), start_row: row });
    self.replace_track(index, track);
    if insert {
        var rows: list<TableRow> = []; let previous: list<TableRow> = self.rows;
        for row in previous {
            var cells: list<str8> = [];
            for c in 0..row.cells.len() {
                if c == column { cells.push(clone("")); }
                cells.push(row.cells[c]);
            }
            if column == row.cells.len() { cells.push(clone("")); }
            rows.push(TableRow { cells: cells });
        }
        self.rows = rows;
    }
    self.rebuild_columns();
    let start: i32 = i32(self.rows.len());
    for r in start..count {
        var cells: list<str8> = [format!("{}{}", r < 9 ? "00" : (r < 99 ? "0" : ""), r + 1)];
        for _c in 1..self.columns.len() { cells.push(clone("")); }
        self.rows.push(TableRow { cells: cells });
    }
    let saved: SequenceTrack = self.tracks[index];
    let placed: AudioInstance = saved.instances[saved.instances.len() - 1];
    self.write_owned_cell(row, column - 1, duration_text(placed.duration()));
    self.reconcile(area); self.error = ""; return true;
}
pub fn remove_audio_under_cursor(self: &mut Self) -> bool {
    let index: i32 = self.active_track(); if index < 0 { return false; }
    var track: SequenceTrack = self.tracks[index];
    let hit: i32 = track.instance_at(self.selected_row); if hit < 0 { return false; }
    var kept: list<AudioInstance> = [];
    for i in 0..track.instances.len() {
        let instance: AudioInstance = track.instances[i];
        if i == hit {
            self.write_owned_cell(instance.start_row, self.audio_length_column(index), clone(""));
            instance.clip.release();
        } else { kept.push(instance); }
    }
    let empty: bool = kept.len() == 0;
    track.instances = kept; self.replace_track(index, track);
    if empty {
        let column: i32 = self.audio_length_column(index) + 1;
        var rows: list<TableRow> = []; let old: list<TableRow> = self.rows;
        for row in old {
            var cells: list<str8> = [];
            for c in 0..row.cells.len() { if c == column { free(row.cells[c]); } else { cells.push(row.cells[c]); } }
            rows.push(TableRow { cells: cells });
        }
        self.rows = rows; self.rebuild_columns();
    }
    self.error = ""; return true;
}
/// Yank the audio from the cursor row to the end of the instance under it into
/// the audio clipboard, leaving the pattern unchanged. Row-granular, cursor-based.
pub fn copy_audio(self: &mut Self) -> bool {
    let index: i32 = self.active_track(); if index < 0 { self.error = "Select an AUDIO track first"; return false; }
    let track: SequenceTrack = self.tracks[index];
    if !track.audio { self.error = "Select an AUDIO track first"; return false; }
    let hit: i32 = track.instance_at(self.selected_row);
    if hit < 0 { self.error = "No audio under the cursor to copy"; return false; }
    let instance: AudioInstance = track.instances[hit];
    let offset: i64 = wide(self.selected_row - instance.start_row);
    let tail: AudioClip = instance.clip.slice_tail(offset);
    self.audio_clipboard.release(); self.audio_clipboard = tail;
    self.error = ""; return true;
}
/// Cut the audio at the cursor row: the tail (cursor row to the end) is moved to
/// the audio clipboard and the instance is truncated so its head ends on the row
/// above. Cutting on the first row of an instance removes the whole instance.
pub fn cut_audio(self: &mut Self, area: Rect) -> bool {
    let index: i32 = self.active_track(); if index < 0 { self.error = "Select an AUDIO track first"; return false; }
    var track: SequenceTrack = self.tracks[index];
    if !track.audio { self.error = "Select an AUDIO track first"; return false; }
    let hit: i32 = track.instance_at(self.selected_row);
    if hit < 0 { self.error = "No audio under the cursor to cut"; return false; }
    let instance: AudioInstance = track.instances[hit];
    let offset: i64 = wide(self.selected_row - instance.start_row);
    let tail: AudioClip = instance.clip.slice_tail(offset);
    self.audio_clipboard.release(); self.audio_clipboard = tail;
    if offset <= 0 { self.remove_audio_under_cursor(); self.reconcile(area); self.error = ""; return true; }
    self.revision = self.revision + 1;
    var kept: list<AudioInstance> = [];
    for i in 0..track.instances.len() {
        var next: AudioInstance = AudioInstance {}; next = track.instances[i];
        if i == hit {
            next.length_ticks = i32(offset * 15000);
            var peaks: list<WavePeak> = []; var details: list<WavePeak> = [];
            let src_peaks: list<WavePeak> = next.clip.peaks;
            for r in 0..offset { peaks.push(src_peaks[r]); }
            let src_details: list<WavePeak> = next.clip.detail_peaks;
            for r in 0..src_details.len() { if r < offset * 4 { details.push(src_details[r]); } }
            next.clip.peaks = peaks; next.clip.detail_peaks = details;
            let frames: i64 = offset * next.clip.frames_per_row;
            if frames < next.clip.frames { next.clip.frames = frames; }
        }
        kept.push(next);
    }
    track.instances = kept; self.replace_track(index, track);
    self.write_owned_cell(instance.start_row, self.audio_length_column(index), duration_text(offset * 15000));
    self.reconcile(area); self.error = ""; return true;
}
/// Paste the audio clipboard at the cursor row on the active AUDIO track.
pub fn paste_audio(self: &mut Self, area: Rect) -> bool {
    if self.audio_clipboard.peaks.len() == 0 { self.error = "Clipboard is empty"; return false; }
    var clip: AudioClip = AudioClip {}; clip = self.audio_clipboard;
    return self.insert_audio(clip, area);
}
/// Visual-selection copy/cut of the first whole instance intersecting the
/// selected row range. Reuses the cursor-based copy_audio/cut_audio by parking
/// the cursor on the instance start (offset 0 = whole clip).
pub fn visual_audio_copy(self: &mut Self, cut: bool, area: Rect) -> bool {
    let index: i32 = self.active_track();
    if index < 0 || !self.tracks[index].audio { self.visual = false; return false; }
    let a: i32 = self.anchor_row < self.selected_row ? self.anchor_row : self.selected_row;
    let b: i32 = self.anchor_row > self.selected_row ? self.anchor_row : self.selected_row;
    let track: SequenceTrack = self.tracks[index];
    var hit: i32 = -1;
    for i in 0..track.instances.len() {
        let instance: AudioInstance = track.instances[i];
        let end: i32 = instance.start_row + i32((instance.duration() + 14999) / 15000) - 1;
        if instance.start_row <= b && end >= a { hit = i32(i); break; }
    }
    if hit < 0 { self.visual = false; self.error = "No audio in the selection"; return false; }
    self.selected_row = track.instances[hit].start_row;
    self.visual = false; self.visual_rows = false;
    if cut { return self.cut_audio(area); }
    let ok: bool = self.copy_audio(); self.reconcile(area); return ok;
}
/// Move the instance under the cursor by one row (delta -1 up, +1 down) with
/// pattern bounds and overlap checks, following it with the cursor.
pub fn move_audio(self: &mut Self, delta: i32, area: Rect) -> bool {
    let index: i32 = self.active_track();
    if index < 0 || !self.tracks[index].audio { return false; }
    var track: SequenceTrack = self.tracks[index];
    let hit: i32 = track.instance_at(self.selected_row);
    if hit < 0 { return false; }
    let moving: AudioInstance = track.instances[hit];
    let span: i32 = i32((moving.duration() + 14999) / 15000);
    let new_start: i32 = moving.start_row + delta;
    if new_start < 0 || new_start + span > i32(self.rows.len()) { self.error = ""; return false; }
    for i in 0..track.instances.len() {
        if i == hit { continue; }
        let other: AudioInstance = track.instances[i];
        let other_span: i32 = i32((other.duration() + 14999) / 15000);
        if new_start < other.start_row + other_span && new_start + span > other.start_row {
            self.error = "Move overlaps another instance"; return false;
        }
    }
    let old_start: i32 = moving.start_row; let dur: i64 = moving.duration();
    var updated: list<AudioInstance> = [];
    for i in 0..track.instances.len() {
        var next: AudioInstance = AudioInstance {}; next = track.instances[i];
        if i == hit { next.start_row = new_start; }
        updated.push(next);
    }
    track.instances = updated; self.replace_track(index, track);
    self.revision = self.revision + 1;
    let len_col: i32 = self.audio_length_column(index);
    self.write_owned_cell(old_start, len_col, clone(""));
    self.write_owned_cell(new_start, len_col, duration_text(dur));
    self.selected_row = self.selected_row + delta;
    self.reconcile(area); self.error = ""; return true;
}
/// Reverse the audio of the instance under the cursor in place.
pub fn reverse_audio(self: &mut Self, area: Rect) -> bool {
    let index: i32 = self.active_track();
    if index < 0 || !self.tracks[index].audio { self.error = "Select an AUDIO track first"; return false; }
    var track: SequenceTrack = self.tracks[index];
    let hit: i32 = track.instance_at(self.selected_row);
    if hit < 0 { self.error = "No audio under the cursor to reverse"; return false; }
    var updated: list<AudioInstance> = [];
    for i in 0..track.instances.len() {
        var next: AudioInstance = AudioInstance {}; next = track.instances[i];
        if i == hit { let flipped: AudioClip = next.clip.reverse(); next.clip.release(); next.clip = flipped; }
        updated.push(next);
    }
    track.instances = updated; self.replace_track(index, track);
    self.revision = self.revision + 1;
    self.reconcile(area); self.error = ""; return true;
}
/// Non-destructive trim of the instance under the cursor to the sample-view
/// selection [from, to) (frames within the current render window). The shared
/// full clip is untouched; only the instance's start offset and length change.
pub fn trim_audio(self: &mut Self, from: i64, to: i64, area: Rect) -> bool {
    let index: i32 = self.active_track();
    if index < 0 || !self.tracks[index].audio { self.error = "Select an AUDIO track first"; return false; }
    var track: SequenceTrack = self.tracks[index];
    let hit: i32 = track.instance_at(self.selected_row);
    if hit < 0 { self.error = "No audio under the cursor to trim"; return false; }
    let instance: AudioInstance = track.instances[hit];
    let fpr: i64 = instance.clip.frames_per_row > 0 ? instance.clip.frames_per_row : 1;
    let rc: AudioClip = instance.render_clip();
    var lo: i64 = from < 0 ? 0 : from; var hi: i64 = to > rc.frames ? rc.frames : to;
    if hi <= lo { self.error = "Trim selection is empty"; return false; }
    let new_offset: i64 = rc.offset + lo;
    let window: i64 = hi - lo;
    let ticks: i64 = (window * 15000 + fpr - 1) / fpr;
    if ticks < 1 { self.error = "Trim selection is too short"; return false; }
    var updated: list<AudioInstance> = [];
    for i in 0..track.instances.len() {
        var next: AudioInstance = AudioInstance {}; next = track.instances[i];
        if i == hit { next.offset_frames = new_offset; next.length_ticks = i32(ticks); }
        updated.push(next);
    }
    track.instances = updated; self.replace_track(index, track);
    self.revision = self.revision + 1;
    self.write_owned_cell(instance.start_row, self.audio_length_column(index), duration_text(ticks));
    self.reconcile(area); self.error = ""; return true;
}
/// Non-destructive slice of the instance covering the visual row selection into
/// up to three instances (head / selected middle / tail), all sharing the same
/// full sample buffer with independent start offsets and lengths.
pub fn slice_audio(self: &mut Self, area: Rect) -> bool {
    let index: i32 = self.active_track();
    if index < 0 || !self.tracks[index].audio { self.visual = false; self.error = "Select an AUDIO track first"; return false; }
    let a: i32 = self.anchor_row < self.selected_row ? self.anchor_row : self.selected_row;
    let b: i32 = self.anchor_row > self.selected_row ? self.anchor_row : self.selected_row;
    var track: SequenceTrack = self.tracks[index];
    var hit: i32 = -1;
    for i in 0..track.instances.len() {
        let instance: AudioInstance = track.instances[i];
        let span: i32 = i32((instance.duration() + 14999) / 15000);
        if instance.start_row <= a && instance.start_row + span - 1 >= b { hit = i32(i); break; }
    }
    if hit < 0 { self.visual = false; self.visual_rows = false; self.error = "Select rows inside one audio instance"; return false; }
    let fpr: i64 = track.instances[hit].clip.frames_per_row > 0 ? track.instances[hit].clip.frames_per_row : 1;
    let span: i32 = i32((track.instances[hit].duration() + 14999) / 15000);
    let start: i32 = track.instances[hit].start_row;
    let base_offset: i64 = track.instances[hit].offset_frames;
    let head_rows: i32 = a - start;
    let mid_rows: i32 = b - a + 1;
    let tail_rows: i32 = start + span - (b + 1);
    let len_col: i32 = self.audio_length_column(index);
    if head_rows <= 0 && tail_rows <= 0 { self.visual = false; self.visual_rows = false; self.error = "Selection covers the whole instance"; return false; }
    var pieces: list<AudioInstance> = [];
    if head_rows > 0 {
        pieces.push(AudioInstance { clip: track.instances[hit].clip.copy(), start_row: start, length_ticks: head_rows * 15000, offset_frames: base_offset });
    }
    pieces.push(AudioInstance { clip: track.instances[hit].clip.copy(), start_row: a, length_ticks: mid_rows * 15000, offset_frames: base_offset + wide(a - start) * fpr });
    if tail_rows > 0 {
        pieces.push(AudioInstance { clip: track.instances[hit].clip.copy(), start_row: b + 1, length_ticks: tail_rows * 15000, offset_frames: base_offset + wide(b + 1 - start) * fpr });
    }
    track.instances[hit].clip.release();
    var updated: list<AudioInstance> = [];
    for i in 0..track.instances.len() {
        if i == hit { continue; }
        var keep: AudioInstance = AudioInstance {}; keep = track.instances[i]; updated.push(keep);
    }
    for piece in pieces { updated.push(piece); }
    track.instances = updated; self.replace_track(index, track);
    self.revision = self.revision + 1;
    self.visual = false; self.visual_rows = false;
    self.write_owned_cell(start, len_col, clone(""));
    let saved: SequenceTrack = self.tracks[index]; let all: list<AudioInstance> = saved.instances;
    for inst in all { self.write_owned_cell(inst.start_row, len_col, duration_text(inst.duration())); }
    self.reconcile(area); self.error = ""; return true;
}
pub fn paint_audio(self: SequenceTable, surface: Surface, area: Rect, theme: Theme) -> void {
    self.paint_audio_style(surface, area, theme, true, false);
}
/// Thin sub-row dots show duration on the NOTE cell's unchanged background.
/// View-only subdivisions: numbered rows and stored timing are unchanged.
pub fn cycle_vertical_zoom(self: &mut Self, area: Rect) -> void {
    self.selected_subrow = 0;
    self.row_scale = self.row_spacing() == 1 ? 2 : (self.row_spacing() == 2 ? 4 : 1);
    self.reconcile(area);
}
pub fn subdivision_brightness(self: SequenceTable, line: i32) -> i32 {
    let part: i32 = line % self.row_spacing();
    if part == 0 { return 100; }
    return self.row_spacing() == 4 && part % 2 == 1 ? 68 : 84;
}
/// Pack notes at each visible time position into chord lanes. Storage stays in
/// normal rows with OFF values, shared by playback, sessions and pattern files.
pub fn view_notes(self: SequenceTable, track_index: i32) -> list<ViewNote> {
    let track: SequenceTrack = self.tracks[track_index];
    var result: list<ViewNote> = []; if track.audio { return result; }
    let count: i64 = self.rows.len() * wide(self.row_spacing());
    let allocated: result<Bytes, str8> = Bytes::new(count + 1); if allocated.is_err() { return result; }
    let counts: Bytes = allocated.unwrap(); for _i in 0..count { counts.append_byte(0); }
    let step: i64 = 15000 / wide(self.row_spacing());
    let first: i32 = self.track_start(track_index);
    for r in 0..self.rows.len() {
        let row: TableRow = self.rows[r];
        for line in 0..track.note_lines {
            let column: i32 = first + i32(line) * 4; if row.cells[column] == "" { continue; }
            let tick: i64 = r * 15000 + self.note_offset(i32(r), column);
            if tick < 0 { continue; }
            let slot: i32 = i32((tick + step / 2) / step);
            if slot >= count { continue; }
            let lane: i32 = self.row_spacing() == 1 ? i32(line) : counts.get(slot);
            if counts.get(slot) < 65 { counts.set(slot, counts.get(slot) + 1); }
            result.push(ViewNote { row: i32(r), column: column, lane: lane, slot: slot });
        }
    }
    counts.close(); return result;
}
/// Mark the numbered row when finer notes are hidden at the current zoom.
pub fn mark_hidden_notes(self: &mut Self) -> void {
    self.bright_rows = []; if self.row_spacing() == 4 { return; }
    let allocated: result<Bytes, str8> = Bytes::new(self.rows.len() + 1); if allocated.is_err() { return; }
    let flags: Bytes = allocated.unwrap(); for _r in 0..self.rows.len() { flags.append_byte(0); }
    let step: i64 = 15000 / wide(self.row_spacing());
    for t in 0..self.tracks.len() {
        let track: SequenceTrack = self.tracks[t]; if track.audio { continue; }
        let first: i32 = self.track_start(i32(t));
        for r in 0..self.rows.len() {
            let row: TableRow = self.rows[r];
            for line in 0..track.note_lines {
                let column: i32 = first + i32(line) * 4; if row.cells[column] == "" { continue; }
                let tick: i64 = r * 15000 + self.note_offset(i32(r), column);
                if tick >= 0 && tick < self.rows.len() * 15000 && tick % step != 0 { flags.set(tick / 15000, 1); }
            }
        }
    }
    // Automation steps between the visible lines mark their row too.
    let per_line: i32 = automation_steps_per_row() / self.row_spacing();
    for column in 1..self.columns.len() {
        if self.automation_slot_at(i32(column)) == 0 { continue; }
        for r in 0..self.rows.len() {
            let row: TableRow = self.rows[r]; if find(row.cells[column], " ") < 0 { continue; }
            let steps: list<str8> = automation_steps(row.cells[column]);
            for step in 0..steps.len() { if steps[step] != "" && i32(step) % per_line != 0 { flags.set(r, 1); } }
            free_steps(steps);
        }
    }
    for r in 0..self.rows.len() { if flags.get(r) != 0 { self.bright_rows.push(i32(r)); } }
    flags.close();
}
/// Repaint automation cells holding 1/64 steps: zoomed in, each visible step
/// on its own line; a value followed by "+" hides steps between the lines.
pub fn paint_automation(self: SequenceTable, surface: Surface, area: Rect, theme: Theme) -> void {
    let body: Rect = self.body(area);
    let clip: Rect = Rect::new(body.x + self.frozen_width(), body.y, body.width - self.frozen_width(), body.height);
    let spacing: i32 = self.row_spacing(); let per_line: i32 = automation_steps_per_row() / spacing;
    for column in 1..self.columns.len() {
        if self.automation_slot_at(i32(column)) == 0 { continue; }
        let width: i32 = self.column_width(i32(column)); if width <= 0 { continue; }
        let x: i32 = area.x + self.column_x(i32(column));
        for y in 0..body.height {
            let r: i32 = self.scroll_y + i32(y) / spacing; if r >= self.rows.len() { break; }
            let row: TableRow = self.rows[r];
            // Plain values are the table's own text.
            if find(row.cells[column], " ") < 0 { continue; }
            let line: i32 = i32(y) % spacing;
            let steps: list<str8> = automation_steps(row.cells[column]);
            var value: str8 = clone(steps[line * per_line]); var hidden: bool = false;
            for s in 1..per_line { if steps[line * per_line + i32(s)] != "" { hidden = true; } }
            free_steps(steps);
            if hidden { let marked: str8 = format!("{}+", value); free(value); value = marked; }
            let cell: Cell = surface.cell(x, body.y + i32(y));
            let text: Surface = Surface::new(width, 1);
            text.fill(text.bounds(), Cell { glyph: 32, foreground: cell.foreground, background: cell.background });
            text.text(text.bounds(), value, cell.foreground, cell.background);
            for dx in 0..width {
                let pixel: Rect = Rect::new(x + i32(dx), body.y + i32(y), 1, 1); let target: Rect = pixel.intersect(clip);
                if target.width > 0 { surface.put(target.x, target.y, text.cell(i32(dx), 0)); }
            }
            text.release(); free(value);
        }
    }
}
/// Owned clipboard text for the displayed cell, including OFF relative to its
/// visible position so pasting shifts timing to the destination subdivision.
fn subdivision_cell(self: &mut Self, slot: i32, column: i32) -> str8 {
    let saved_row: i32 = self.selected_row; let saved_sub: i32 = self.selected_subrow; let saved_col: i32 = self.selected_column;
    self.selected_row = slot / self.row_spacing(); self.selected_subrow = slot % self.row_spacing(); self.selected_column = column;
    var text: str8 = clone("");
    if self.subdivision_note_field() {
        let source: ViewNote = self.subdivision_source();
        if source.row >= 0 {
            let field_index: i32 = (column - self.track_start(self.active_track())) % 4;
            let row: TableRow = self.rows[source.row]; free(text);
            if field_index == 3 { text = offset_text(wide(source.row) * 15000 + self.note_offset(source.row, source.column) - wide(slot) * 15000 / wide(self.row_spacing())); }
            else { text = clone(row.cells[source.column + field_index]); }
        }
    } else if self.is_automation() { free(text); text = self.automation_cursor_text(); }
    else if self.selected_subrow == 0 { let row: TableRow = self.rows[self.selected_row]; free(text); text = clone(row.cells[column]); }
    self.selected_row = saved_row; self.selected_subrow = saved_sub; self.selected_column = saved_col; return text;
}
pub fn paint_subdivision_notes(self: SequenceTable, surface: Surface, area: Rect, theme: Theme) -> void {
    if self.row_spacing() == 1 { return; }
    let body: Rect = self.body(area);
    let clip: Rect = Rect::new(body.x + self.frozen_width(), body.y, body.width - self.frozen_width(), body.height);
    for t in 0..self.tracks.len() {
        let track: SequenceTrack = self.tracks[t]; if track.audio { continue; }
        let first: i32 = self.track_start(i32(t));
        for f in 0..(track.note_lines * 4) {
            let column: i32 = first + i32(f); let width: i32 = self.column_width(column);
            let x: i32 = area.x + self.column_x(column);
            for y in 0..body.height {
                let cell: Cell = surface.cell(x, body.y + i32(y));
                let blank: Rect = Rect::new(x, body.y + i32(y), width, 1);
                surface.fill(blank.intersect(clip), Cell { glyph: 32, foreground: cell.foreground, background: cell.background });
            }
        }
        let notes: list<ViewNote> = self.view_notes(i32(t));
        for note in notes {
            let y: i32 = note.slot - self.scroll_y * self.row_spacing();
            if y < 0 || y >= body.height || note.lane >= track.note_lines { continue; }
            let row: TableRow = self.rows[note.row];
            for f in 0..4 {
                let column: i32 = first + note.lane * 4 + i32(f); let width: i32 = self.column_width(column);
                let x: i32 = area.x + self.column_x(column);
                let cell: Cell = surface.cell(x, body.y + y);
                let normal: i32 = self.dim_column(column) ? darken(theme.foreground, 88) : theme.foreground;
                let fg: i32 = darken(normal, self.subdivision_brightness(note.slot));
                if width > 0 {
                    let text: Surface = Surface::new(width, 1);
                    text.fill(text.bounds(), Cell { glyph: 32, foreground: fg, background: cell.background });
                    text.text(text.bounds(), row.cells[note.column + i32(f)], fg, cell.background);
                    for dx in 0..width {
                        let pixel: Rect = Rect::new(x + i32(dx), body.y + y, 1, 1); let target: Rect = pixel.intersect(clip);
                        if target.width > 0 { surface.put(target.x, target.y, text.cell(i32(dx), 0)); }
                    }
                    text.release();
                }
            }
        }
    }
}
/// Source note under the zoomed cursor, or {-1,-1} for an empty time position.
pub fn subdivision_source(self: SequenceTable) -> ViewNote {
    let index: i32 = self.active_track(); if index < 0 { return ViewNote { row: -1, column: -1 }; }
    let lane: i32 = (self.selected_column - self.track_start(index)) / 4;
    let slot: i32 = self.selected_row * self.row_spacing() + self.selected_subrow;
    let notes: list<ViewNote> = self.view_notes(index);
    for note in notes { if note.slot == slot && note.lane == lane { return note; } }
    return ViewNote { row: -1, column: -1 };
}
fn subdivision_commit(self: &mut Self, value: str8) -> bool {
    let index: i32 = self.active_track(); if index < 0 { return false; }
    let display_column: i32 = self.selected_column; let display_row: i32 = self.selected_row;
    let first: i32 = self.track_start(index); let field_index: i32 = (display_column - first) % 4;
    var source: ViewNote = self.subdivision_source();
    if source.row < 0 {
        if value == "" { return true; }
        if field_index != 0 { self.error = "Add a note at this position first"; return false; }
        if self.note_index(value) < 0 { self.error = "Expected MIDI note C--1 through G-9"; return false; }
        let track: SequenceTrack = self.tracks[index]; let row: TableRow = self.rows[display_row];
        var column: i32 = -1;
        for line in 0..track.note_lines { if column < 0 && row.cells[first + i32(line) * 4] == "" { column = first + i32(line) * 4; } }
        if column < 0 {
            if !self.ensure_note_lines(index, track.note_lines + 1) { self.error = "Maximum 64 notes per main row"; return false; }
            column = first + track.note_lines * 4; self.rebuild_columns();
        }
        source = ViewNote { row: display_row, column: column };
        self.selected_row = source.row; self.selected_column = source.column;
        let ok: bool = self.commit(value);
        if ok { self.write_owned_cell(source.row, source.column + 3, offset_text(wide(self.selected_subrow) * 15000 / wide(self.row_spacing()))); }
        self.selected_row = display_row; self.selected_column = display_column; return ok;
    }
    self.selected_row = source.row; self.selected_column = source.column + field_index;
    let ok: bool = self.commit(value);
    self.selected_row = display_row; self.selected_column = display_column; return ok;
}
pub fn paint_note_lengths(self: SequenceTable, surface: Surface, area: Rect, theme: Theme) -> void {
    let body: Rect = self.body(area);
    let powers: array<i32, 8> = {1, 2, 4, 8, 16, 32, 64, 128};
    let dots: array<i32, 4> = {1, 2, 4, 64};
    for t in 0..self.tracks.len() {
        let track: SequenceTrack = self.tracks[t]; if track.audio { continue; }
        let view: list<ViewNote> = self.view_notes(i32(t));
        for line in 0..track.note_lines {
            let column: i32 = self.track_start(i32(t)) + i32(line) * 4;
            let x: i32 = area.x + self.column_x(column) + 5;
            if x < body.x + self.frozen_width() || x >= body.x + body.width { continue; }
            var spans: list<NoteSpan> = [];
            for note in view {
                if note.lane == line {
                    let start: i64 = wide(note.row) * 15000 + self.note_offset(note.row, note.column);
                    spans.push(NoteSpan { start: start, end: start + self.note_length(note.row, note.column) });
                }
            }
            for y in 0..body.height {
                let r: i32 = self.scroll_y + i32(y) / self.row_spacing(); if r >= self.rows.len() { break; }
                let step: i64 = 15000 / wide(self.row_spacing());
                let start: i64 = wide(self.scroll_y) * 15000 + y * step; var mask: i32 = 0;
                for part in 0..8 {
                    var occupied: bool = false;
                    for span in spans {
                        if span.start >= start + step || span.end <= start { continue; }
                        let first: i32 = span.start <= start ? 0 : i32((span.start - start) * 8 / step);
                        var last: i32 = span.end >= start + step ? 8 : i32((span.end - start) * 8 / step);
                        if last <= first { last = first + 1; }
                        if part >= first && part < last { occupied = true; }
                    }
                    if occupied { mask = mask + powers[part]; }
                }
                if mask == 0 { continue; }
                let note_cell: Cell = surface.cell(x, body.y + i32(y));
                let bg: i32 = note_cell.background;
                var glyph: i32 = 0x2800;
                for part in 0..4 { if mask / powers[part * 2] % 4 != 0 { glyph = glyph + dots[part]; } }
                surface.put(x, body.y + i32(y), Cell { glyph: glyph, foreground: darken(note_cell.foreground, 92), background: bg });
            }
        }
    }
}
pub fn audio_under_cursor(self: SequenceTable) -> bool {
    let index: i32 = self.active_track(); if index < 0 { return false; }
    let track: SequenceTrack = self.tracks[index];
    return track.audio && self.selected_row >= 0 && self.selected_row < self.rows.len() &&
        track.instance_at(self.selected_row) >= 0;
}
pub fn paint_audio_style(self: SequenceTable, surface: Surface, area: Rect, theme: Theme, grainy: bool, wave: bool) -> void {
    let body: Rect = self.body(area);
    let clip: Rect = Rect::new(body.x + self.frozen_width(), body.y, body.width - self.frozen_width(), body.height);
    for t in 0..self.tracks.len() {
        let track: SequenceTrack = self.tracks[t];
        if track.instances.len() > 0 {
            let x: i32 = area.x + self.column_x(self.audio_length_column(i32(t)) + 1);
            let half: i32 = track.wave_zoom ? 12 : 6;
            for y in 0..body.height {
                let row: i32 = self.scroll_y + i32(y) / self.row_spacing();
                let hit: i32 = track.instance_at(row);
                if hit >= 0 && row < self.rows.len() {
                    let instance: AudioInstance = track.instances[hit];
                    let local: i32 = row - instance.start_row;
                    let offset_rows: i32 = instance.clip.frames_per_row > 0 ? i32(instance.offset_frames / instance.clip.frames_per_row) : 0;
                    let peak_row: i32 = offset_rows + local;
                    let has_peak: bool = peak_row >= 0 && peak_row < instance.clip.peaks.len();
                    let peak: WavePeak = has_peak ? instance.clip.peaks[peak_row] : WavePeak {};
                    let background_cell: Cell = surface.cell(x, body.y + i32(y));
                    let bg: i32 = background_cell.background;
                    let line: Rect = Rect::new(x, body.y + i32(y), half * 2 + 1, 1);
                    surface.fill(line.intersect(clip), Cell { glyph: 32, foreground: theme.muted, background: bg });
                    let left: Rect = Rect::new(x, body.y + i32(y), half, 1);
                    let right: Rect = Rect::new(x + half + 1, body.y + i32(y), half, 1);
                    let center: Rect = Rect::new(x + half, body.y + i32(y), 1, 1);
                    let remaining: i64 = instance.duration() - wide(local) * 15000;
                    if has_peak {
                        if grainy || remaining < 15000 {
                            paint_grainy_row_duration(surface, left, clip, instance.clip.detail_peaks, peak_row, true, 0x5adc8c, bg, wave, remaining);
                            paint_grainy_row_duration(surface, right, clip, instance.clip.detail_peaks, peak_row, false, 0xef6575, bg, wave, remaining);
                        } else {
                            paint_wave_channel_style(surface, left, clip, peak.left, peak.left_body, true, 0x5adc8c, bg, false, wave);
                            paint_wave_channel_style(surface, right, clip, peak.right, peak.right_body, false, 0xef6575, bg, false, wave);
                        }
                    }
                    let end_glyph: i32 = remaining >= 15000 ? 0x2502 : (remaining > 11250 ? 0x2847 : (remaining > 7500 ? 0x2807 : (remaining > 3750 ? 0x2803 : 0x2801)));
                    surface.fill(center.intersect(clip), Cell { glyph: end_glyph, foreground: theme.muted, background: bg });
                }
            }
        }
    }
}
/// Independent pattern snapshot, including tracks, automation, mixer settings,
/// cursor and viewport. No owned strings or mutable lists alias the source.
pub fn copy_pattern(self: SequenceTable) -> SequenceTable {
    var copy: SequenceTable = SequenceTable { frozen_columns: self.frozen_columns,
        alternate_group_text: self.alternate_group_text,
        horizontal_scrollbar: self.horizontal_scrollbar, vertical_scrollbar: self.vertical_scrollbar,
        selected_row: self.selected_row, selected_column: self.selected_column,
        scroll_x: self.scroll_x, scroll_y: self.scroll_y, row_scale: self.row_spacing(), selected_subrow: self.selected_subrow, next_track_id: self.next_track_id,
        editor: TextField::new(""), error: "" };
    var rows: list<TableRow> = []; let source_rows: list<TableRow> = self.rows;
    for row in source_rows {
        var cells: list<str8> = []; let source_cells: list<str8> = row.cells;
        for value in source_cells { cells.push(clone(value)); }
        rows.push(TableRow { cells: cells });
    }
    var tracks: list<SequenceTrack> = []; let source_tracks: list<SequenceTrack> = self.tracks;
    for track in source_tracks {
        tracks.push(SequenceTrack { name: clone(track.name), muted: track.muted, volume: track.volume, pan: track.pan, record_armed: track.record_armed, sends: track.copy_sends(), inserts: track.inserts, audio: track.audio, output: track.output, instrument: track.instrument, instrument_id: track.instrument_id, note_lines: track.note_lines, instances: track.copy_audio(), wave_zoom: track.wave_zoom, zoom_stage: track.zoom_stage,
            automation: track.copy_automation() });
    }
    var notes: array<str8, 128> = {};
    for i in 0..128 { notes.push(clone(self.notes[i])); }
    copy.rows = rows; copy.tracks = tracks; copy.notes = notes;
    copy.audio_clipboard = self.audio_clipboard.copy();
    copy.rebuild_columns(); return copy;
}
/// One matrix row's worth of this pattern: `count` rows starting at `start`,
/// wrapping so a pattern shorter than the matrix row repeats to fill it. Audio
/// clips keep their place relative to the slice and are dropped when they start
/// outside it.
pub fn copy_slice(self: SequenceTable, start: i32, count: i32) -> SequenceTable {
    var copy: SequenceTable = self.copy_pattern();
    let source_rows: i64 = self.rows.len();
    if count <= 0 || source_rows == 0 || (start == 0 && wide(count) == source_rows) { return copy; }
    var rows: list<TableRow> = []; let old: list<TableRow> = copy.rows;
    for r in 0..count {
        let source: TableRow = old[(wide(start) + wide(i32(r))) % source_rows];
        var cells: list<str8> = []; let values: list<str8> = source.cells;
        for value in values { cells.push(clone(value)); }
        rows.push(TableRow { cells: cells });
    }
    for row in old { let values: list<str8> = row.cells; for value in values { free(value); } }
    copy.rows = rows;
    var tracks: list<SequenceTrack> = []; let source_tracks: list<SequenceTrack> = copy.tracks;
    // A loop repeat asks for a slice past the pattern's end: clips keep their
    // place in the pattern it wraps into.
    let phase: i32 = i32(wide(start) % source_rows);
    for track in source_tracks {
        let placed: list<AudioInstance> = track.instances;
        var moved: SequenceTrack = SequenceTrack {}; moved = track;
        var instances: list<AudioInstance> = [];
        for instance in placed {
            let row: i32 = instance.start_row - phase;
            if row >= 0 && row < count {
                instances.push(AudioInstance { clip: instance.clip, start_row: row,
                    length_ticks: instance.length_ticks, offset_frames: instance.offset_frames });
            } else { instance.clip.release(); }
        }
        moved.instances = instances; tracks.push(moved);
    }
    copy.tracks = tracks;
    copy.selected_row = 0; copy.rebuild_columns(); return copy;
}
pub fn track_columns(self: SequenceTable, index: i32) -> i32 {
    let track: SequenceTrack = self.tracks[index]; let slots: i32 = i32(track.automation.len());
    return track.audio ? slots + (track.instances.len() > 0 ? 2 : 1) : track.note_lines * 4 + slots;
}
pub fn track_start(self: SequenceTable, index: i32) -> i32 {
    var first: i32 = 1;
    for i in 0..index { first = first + self.track_columns(i32(i)); }
    return first;
}
/// Column of one-based automation `slot` of track `index`.
pub fn automation_column(self: SequenceTable, index: i32, slot: i32) -> i32 {
    let track: SequenceTrack = self.tracks[index];
    return self.track_start(index) + (track.audio ? 0 : track.note_lines * 4) + slot - 1;
}
/// LEN column of an AUDIO track; its waveform column follows it.
pub fn audio_length_column(self: SequenceTable, index: i32) -> i32 {
    let track: SequenceTrack = self.tracks[index];
    return self.track_start(index) + i32(track.automation.len());
}
/// Track owning `column`, or -1 for the ROW column.
pub fn track_of_column(self: SequenceTable, column: i32) -> i32 {
    if column < 1 { return -1; }
    var first: i32 = 1;
    for i in 0..self.tracks.len() {
        first = first + self.track_columns(i32(i));
        if column < first { return i32(i); }
    }
    return -1;
}
/// One-based automation slot at `column`, or 0 when it is not automation.
pub fn automation_slot_at(self: SequenceTable, column: i32) -> i32 {
    let index: i32 = self.track_of_column(column); if index < 0 { return 0; }
    let track: SequenceTrack = self.tracks[index];
    let slot: i32 = column - self.automation_column(index, 1) + 1;
    return slot >= 1 && slot <= track.automation.len() ? slot : 0;
}
pub fn is_automation(self: SequenceTable) -> bool { return self.automation_slot_at(self.selected_column) > 0; }
/// Automation step under the cursor: the zoomed sub-row as a 1/64 step.
pub fn automation_step(self: SequenceTable) -> i32 {
    return self.selected_subrow * (automation_steps_per_row() / self.row_spacing());
}
pub fn is_note(self: SequenceTable) -> bool {
    let index: i32 = self.active_track(); if index < 0 { return false; }
    let track: SequenceTrack = self.tracks[index];
    let offset: i32 = self.selected_column - self.track_start(index);
    return !track.audio && offset >= 0 && offset < track.note_lines * 4 && offset % 4 == 0;
}
/// Point every placement of `old` (matched like the session codec: source,
/// frames and row size) at `edited`. A length change resets the placement's
/// non-destructive trim to the natural length. Returns the number replaced.
pub fn replace_clip(self: &mut Self, old: &AudioClip, edited: &AudioClip) -> i32 {
    var before: AudioClip = AudioClip {}; before = old;
    var after: AudioClip = AudioClip {}; after = edited;
    var count: i32 = 0;
    for t in 0..self.tracks.len() {
        var track: SequenceTrack = self.tracks[t];
        if !track.audio { continue; }
        var changed: bool = false; var updated: list<AudioInstance> = [];
        for i in 0..track.instances.len() {
            var next: AudioInstance = AudioInstance {}; next = track.instances[i];
            if next.clip.source == before.source && next.clip.frames == before.frames && next.clip.frames_per_row == before.frames_per_row {
                next.clip.release(); next.clip = after.copy(); next.clip.offset = 0;
                if after.frames != before.frames { next.offset_frames = 0; next.length_ticks = 0; }
                changed = true; count = count + 1;
            }
            updated.push(next);
        }
        if changed { track.instances = updated; self.replace_track(i32(t), track); }
    }
    if count > 0 { self.revision = self.revision + 1; }
    return count;
}
fn replace_track(self: &mut Self, index: i32, value: SequenceTrack) -> void {
    var tracks: list<SequenceTrack> = [];
    for i in 0..self.tracks.len() { tracks.push(i == index ? value : self.tracks[i]); }
    self.tracks = tracks;
}
pub fn rebuild_columns(self: &mut Self) -> void {
    self.visual = false; self.visual_rows = false;
    self.revision = self.revision + 1;
    let old_groups: list<TableGroup> = self.groups;
    for group in old_groups { free(group.title); if group.subtitle != "" { free(group.subtitle); } }
    let old_titles: list<str8> = self.column_titles; for title in old_titles { free(title); }
    var titles: list<str8> = [];
    var columns: list<TableColumn> = [TableColumn { title: "ROW", width: 4, value_type: "u32", read_only: true }];
    var groups: list<TableGroup> = [];
    for i in 0..self.tracks.len() {
        let track: SequenceTrack = self.tracks[i];
        groups.push(TableGroup { title: format!("{}{}", track.name, track.muted ? " [M]" : ""), first: i32(columns.len()), count: self.track_columns(i32(i)) });
        if !track.audio {
            for _line in 0..track.note_lines {
                columns.push(TableColumn { title: "NOTE", width: 6, value_type: "str8", pattern: "[A-G][#-]-?[0-9]", nullable: true });
                columns.push(TableColumn { title: "VEL", width: 5, value_type: "i32", bounded: true, minimum: 0, maximum: 127, nullable: true });
                columns.push(TableColumn { title: "LEN", width: 6, value_type: "str8", pattern: "[0-9]{1,5}(\\.[0-9]{1,2})?", nullable: true, hidden: track.zoom_stage == 0 });
                columns.push(TableColumn { title: "OFF", width: 6, value_type: "str8", pattern: "[+-]?[0-9]{1,5}(\\.[0-9]{1,2})?", nullable: true, hidden: track.zoom_stage == 0 });
            }
        }
        // Limits live in the slot: a cell may hold four 1/64 steps.
        let slots: list<AutomationSlot> = track.automation;
        for slot in slots {
            let title: str8 = automation_title(slot.parameter); titles.push(title);
            columns.push(TableColumn { title: title, width: 6, value_type: "str8",
                pattern: automation_pattern(), hidden: !track.audio && track.zoom_stage < 2, nullable: true });
        }
        if track.audio { columns.push(TableColumn { title: "LEN", width: 6, value_type: "str8", pattern: "[0-9]{1,5}(\\.[0-9]{1,2})?", nullable: true }); }
        if track.audio && track.instances.len() > 0 {
            columns.push(TableColumn { title: track.wave_zoom ? "L  WAVE x2  R" : "L  WAVE  R", width: track.wave_zoom ? 25 : 13, value_type: "str8", read_only: true, nullable: true });
        }
    }
    self.columns = columns; self.groups = groups; self.column_titles = titles;
}
pub fn create_track(self: &mut Self, duplicate: bool, area: Rect) -> void {
    self.create_track_kind(duplicate, false, area);
}
pub fn assign_instrument(self: &mut Self, id: i32) -> bool {
    let index: i32 = self.active_track();
    if index < 0 { return false; }
    var track: SequenceTrack = self.tracks[index];
    if !track.instrument { self.error = "Select an Instrument track first"; return false; }
    for i in 0..self.tracks.len() {
        let other: SequenceTrack = self.tracks[i];
        if i != index && id > 0 && other.instrument && other.instrument_id == id { track.inserts = other.inserts; }
    }
    track.instrument_id = id; self.replace_track(index, track);
    self.revision = self.revision + 1; self.error = ""; return true;
}
pub fn detach_instrument(self: &mut Self, id: i32) -> void {
    let old: list<SequenceTrack> = self.tracks; var next: list<SequenceTrack> = [];
    for item in old {
        var track: SequenceTrack = SequenceTrack {}; track = item;
        if track.instrument_id == id { track.instrument_id = 0; }
        next.push(track);
    }
    self.tracks = next; self.revision = self.revision + 1;
}
/// Placements of `sample` in this pattern (matched like the session codec).
pub fn clip_usage(self: SequenceTable, sample: &AudioClip) -> i32 {
    var source: AudioClip = AudioClip {}; source = sample;
    var count: i32 = 0;
    for t in 0..self.tracks.len() {
        let track: SequenceTrack = self.tracks[t];
        let instances: list<AudioInstance> = track.instances;
        for instance in instances {
            if instance.clip.source == source.source && instance.clip.frames == source.frames &&
               instance.clip.frames_per_row == source.frames_per_row { count = count + 1; }
        }
    }
    return count;
}
/// Drop every placement of `sample`. Returns how many were removed.
pub fn remove_clips_of(self: &mut Self, sample: &AudioClip) -> i32 {
    var source: AudioClip = AudioClip {}; source = sample;
    var count: i32 = 0;
    for t in 0..self.tracks.len() {
        var track: SequenceTrack = self.tracks[t];
        if !track.audio { continue; }
        var kept: list<AudioInstance> = []; var changed: bool = false;
        let instances: list<AudioInstance> = track.instances;
        for instance in instances {
            if instance.clip.source == source.source && instance.clip.frames == source.frames &&
               instance.clip.frames_per_row == source.frames_per_row {
                instance.clip.release(); changed = true; count = count + 1;
            } else { kept.push(instance); }
        }
        if changed { track.instances = kept; self.replace_track(i32(t), track); }
    }
    if count > 0 { self.revision = self.revision + 1; }
    return count;
}
/// Tracks assigned to instrument instance `id`.
pub fn instrument_usage(self: SequenceTable, id: i32) -> i32 {
    var count: i32 = 0;
    let tracks: list<SequenceTrack> = self.tracks;
    for track in tracks { if track.instrument && track.instrument_id == id { count = count + 1; } }
    return count;
}
/// True when any track in this pattern is assigned instrument instance `id`.
pub fn instrument_in_use(self: SequenceTable, id: i32) -> bool {
    if id <= 0 { return false; }
    let tracks: list<SequenceTrack> = self.tracks;
    for track in tracks { if track.instrument && track.instrument_id == id { return true; } }
    return false;
}
/// True when a track other than `index` is assigned instrument instance `id`.
pub fn instrument_used_by_other(self: SequenceTable, id: i32, index: i32) -> bool {
    if id <= 0 { return false; }
    for i in 0..self.tracks.len() {
        let track: SequenceTrack = self.tracks[i];
        if i32(i) != index && track.instrument && track.instrument_id == id { return true; }
    }
    return false;
}
/// First track (other than `index`) using instance `id`, or -1.
pub fn instrument_user(self: SequenceTable, id: i32, index: i32) -> i32 {
    for i in 0..self.tracks.len() {
        let track: SequenceTrack = self.tracks[i];
        if i32(i) != index && track.instrument && track.instrument_id == id { return i32(i); }
    }
    return -1;
}
/// Detach the active track from its insert instances (only this track; a
/// track that just moved to its own instrument must not keep feeding the
/// inserts of the tracks it left).
pub fn clear_active_inserts(self: &mut Self) -> void {
    let index: i32 = self.active_track();
    if index < 0 { return; }
    var track: SequenceTrack = self.tracks[index];
    track.inserts = [0, 0, 0, 0]; self.replace_track(index, track);
    self.revision = self.revision + 1;
}
/// Instrument instance of the selected track, or 0 when it is not an assigned
/// Instrument track.
pub fn active_instrument(self: SequenceTable) -> i32 {
    let index: i32 = self.active_track();
    if index < 0 { return 0; }
    let track: SequenceTrack = self.tracks[index];
    return track.instrument ? track.instrument_id : 0;
}
pub fn create_instrument_track(self: &mut Self, id: i32, area: Rect) -> void {
    if self.tracks.len() >= 64 { self.error = "Maximum 64 tracks"; return; }
    self.create_track(false, area);
    let index: i32 = self.active_track();
    var track: SequenceTrack = self.tracks[index];
    free(track.name); track.name = format!("Instrument {}", self.next_track_id - 1);
    track.instrument = true; track.instrument_id = id;
    self.replace_track(index, track); self.assign_instrument(id); self.rebuild_columns();
}
pub fn create_track_kind(self: &mut Self, duplicate: bool, audio: bool, area: Rect) -> void {
    if self.tracks.len() >= 64 { self.error = "Maximum 64 tracks"; return; }
    let source: i32 = self.active_track();
    if duplicate && source < 0 { return; }
    var track: SequenceTrack = SequenceTrack { name: format!("{} {}", audio ? "Audio" : "Track", self.next_track_id), audio: audio };
    // AUDIO tracks play no MIDI, so they start without automation.
    if !audio { track.automation = default_automation(); }
    if duplicate {
        let original: SequenceTrack = self.tracks[source];
        track.release_strings();
        track = SequenceTrack { name: format!("{} copy", original.name), muted: original.muted, volume: original.volume, pan: original.pan, sends: original.copy_sends(), audio: original.audio, output: original.output, instrument: original.instrument, instrument_id: original.instrument_id, note_lines: original.note_lines, instances: original.copy_audio(), wave_zoom: original.wave_zoom, zoom_stage: original.zoom_stage,
            automation: original.copy_automation() };
    }
    if duplicate && track.instrument { let original: SequenceTrack = self.tracks[source]; track.inserts = original.inserts; }
    self.tracks.push(track);
    if !duplicate { self.next_track_id = self.next_track_id + 1; }
    var rows: list<TableRow> = [];
    let old: list<TableRow> = self.rows;
    for row in old {
        var cells: list<str8> = []; let previous: list<str8> = row.cells;
        for value in previous { cells.push(value); }
        for c in 0..self.track_columns(i32(self.tracks.len()) - 1) {
            if duplicate { cells.push(clone(row.cells[self.track_start(source) + c])); }
            else { cells.push(clone("")); }
        }
        rows.push(TableRow { cells: cells });
    }
    self.rows = rows; self.selected_column = self.track_start(i32(self.tracks.len()) - 1);
    self.rebuild_columns(); self.reconcile(area); self.error = "";
}
/// Delete every track assigned to instrument instance `id`, keeping at least
/// one track in the pattern. Returns how many were removed.
pub fn remove_tracks_using_instrument(self: &mut Self, id: i32, area: Rect) -> i32 {
    var removed: i32 = 0;
    // Re-scan after each removal: indices and columns shift.
    for _pass in 0..64 {
        var target: i32 = -1;
        for i in 0..self.tracks.len() {
            let track: SequenceTrack = self.tracks[i];
            if target < 0 && track.instrument && track.instrument_id == id { target = i32(i); }
        }
        if target < 0 || self.tracks.len() <= 1 { break; }
        self.selected_column = self.track_start(target);
        let before: i64 = self.tracks.len();
        self.remove_track(area);
        if self.tracks.len() == before { break; }
        removed = removed + 1;
    }
    return removed;
}
pub fn remove_track(self: &mut Self, area: Rect) -> void {
    let index: i32 = self.active_track();
    if index < 0 { return; }
    if self.tracks.len() <= 1 { self.error = "Keep at least one track"; return; }
    let first: i32 = self.track_start(index); let end: i32 = first + self.track_columns(index);
    var tracks: list<SequenceTrack> = [];
    for i in 0..self.tracks.len() {
        let track: SequenceTrack = self.tracks[i];
        if i == index { track.release_strings(); track.release_audio(); }
        else { tracks.push(track); }
    }
    var rows: list<TableRow> = []; let previous: list<TableRow> = self.rows;
    for row in previous {
        var cells: list<str8> = [];
        for c in 0..row.cells.len() {
            if c >= first && c < end { free(row.cells[c]); }
            else { cells.push(row.cells[c]); }
        }
        rows.push(TableRow { cells: cells });
    }
    let next: i32 = index >= tracks.len() ? i32(tracks.len()) - 1 : index;
    self.tracks = tracks; self.rows = rows;
    self.remap_outputs(index);
    self.selected_column = self.track_start(next);
    self.rebuild_columns(); self.reconcile(area); self.error = "";
}
pub fn clear_track(self: &mut Self) -> void {
    self.revision = self.revision + 1;
    let index: i32 = self.active_track(); if index < 0 { return; }
    let first: i32 = self.track_start(index); let end: i32 = first + self.track_columns(index);
    var track: SequenceTrack = self.tracks[index];
    let has_clip: bool = track.instances.len() > 0;
    let wave: i32 = track.audio ? self.audio_length_column(index) + 1 : -1;
    var rows: list<TableRow> = []; let previous: list<TableRow> = self.rows;
    for row in previous {
        var cells: list<str8> = [];
        for c in 0..row.cells.len() {
            if c >= first && c < end {
                free(row.cells[c]);
                if !has_clip || c != wave { cells.push(clone("")); }
            }
            else { cells.push(row.cells[c]); }
        }
        rows.push(TableRow { cells: cells });
    }
    self.rows = rows; self.error = "";
    if has_clip {
        track.release_audio(); track.instances = [];
        self.replace_track(index, track); self.rebuild_columns();
    }
}
pub fn rename_track(self: &mut Self, name: str8) -> bool {
    let index: i32 = self.active_track(); if index < 0 { return false; }
    if !table_matches("[A-Za-z0-9][A-Za-z0-9 _-]{0,31}", name) { self.error = "Name: 1-32 letters, digits, spaces, _ or -"; return false; }
    var track: SequenceTrack = self.tracks[index];
    let copy: str8 = clone(name); free(track.name); track.name = copy;
    self.replace_track(index, track); self.rebuild_columns(); self.error = ""; return true;
}
/// Parse "cc:N", "pitchbend" or "name:min:max" into an owned slot; sets
/// `error` and returns an empty parameter when the spec is invalid.
fn parse_automation(self: &mut Self, spec: str8) -> AutomationSlot {
    var low: i64 = 0; var high: i64 = 127;
    if spec == "pitchbend" { low = -8192; high = 8191; }
    else if table_matches("cc:[0-9]{1,3}", spec) {
        let suffix: str8 = sub(spec, 3, len(spec) - 3);
        let parsed: result<i64, str8> = table_integer(suffix); free(suffix);
        if parsed.is_err() { self.error = "Invalid CC number"; return AutomationSlot { parameter: "" }; }
        if parsed.unwrap() > 127 { self.error = "CC number must be 0-127"; return AutomationSlot { parameter: "" }; }
    } else if table_matches("[A-Za-z][A-Za-z0-9_]*:-?[0-9]+:-?[0-9]+", spec) {
        let colon: i64 = find(spec, ":");
        let rest: str8 = sub(spec, colon + 1, len(spec) - colon - 1);
        let split: i64 = find(rest, ":");
        let first: str8 = sub(rest, 0, split); let last: str8 = sub(rest, split + 1, len(rest) - split - 1);
        let a: result<i64, str8> = table_integer(first); let b: result<i64, str8> = table_integer(last);
        free(first); free(last); free(rest);
        if a.is_err() || b.is_err() { self.error = "Invalid limits"; return AutomationSlot { parameter: "" }; }
        low = a.unwrap(); high = b.unwrap();
        if low < -2147483648 || high > 2147483647 || low > high { self.error = "Limits must fit i32, minimum <= maximum"; return AutomationSlot { parameter: "" }; }
    } else { self.error = "Use cc:N, pitchbend, or name:min:max"; return AutomationSlot { parameter: "" }; }
    return AutomationSlot { parameter: clone(spec), minimum: low, maximum: high };
}
/// True when another slot of track `index` than `skip` (one-based) already
/// plays the controller or parameter of `spec`.
fn automation_taken(self: SequenceTable, index: i32, spec: str8, skip: i32) -> bool {
    let track: SequenceTrack = self.tracks[index];
    let controller: i64 = automation_controller(spec);
    for i in 0..track.automation.len() {
        if i32(i) + 1 == skip { continue; }
        let slot: AutomationSlot = track.automation[i];
        if slot.parameter == spec || (controller >= 0 && automation_controller(slot.parameter) == controller) { return true; }
    }
    return false;
}
/// Change what one-based automation `slot` of the active track plays.
pub fn configure_slot(self: &mut Self, slot: i32, spec: str8) -> bool {
    let index: i32 = self.active_track(); if index < 0 { return false; }
    let current: SequenceTrack = self.tracks[index];
    if slot < 1 || slot > current.automation.len() { self.error = "Select a CC column first"; return false; }
    if self.automation_taken(index, spec, slot) { self.error = "The track already has a column for that controller"; return false; }
    let definition: AutomationSlot = self.parse_automation(spec);
    if definition.parameter == "" { return false; }
    let column: i32 = self.automation_column(index, slot);
    let rows: list<TableRow> = self.rows;
    for row in rows {
        if !automation_valid(row.cells[column], definition.minimum, definition.maximum) {
            free(definition.parameter); self.error = "Existing values exceed limits; clear track first"; return false;
        }
    }
    var track: SequenceTrack = self.tracks[index];
    var slots: list<AutomationSlot> = [];
    for i in 0..track.automation.len() {
        let old: AutomationSlot = track.automation[i];
        if i32(i) + 1 == slot { free(old.parameter); slots.push(definition); } else { slots.push(old); }
    }
    track.automation = slots;
    self.replace_track(index, track); self.rebuild_columns(); self.error = ""; return true;
}
/// Add an automation column for `spec` after the last one of track `index`
/// and show it. Returns its one-based slot, or 0 with `error` set.
pub fn add_automation(self: &mut Self, index: i32, spec: str8) -> i32 {
    if index < 0 || index >= self.tracks.len() { return 0; }
    let current: SequenceTrack = self.tracks[index];
    if current.audio { self.error = "An AUDIO track has no MIDI output to automate"; return 0; }
    if current.automation.len() >= automation_limit() { self.error = "Maximum 16 CC columns per track"; return 0; }
    if self.automation_taken(index, spec, 0) { self.error = "The track already has a column for that controller"; return 0; }
    let definition: AutomationSlot = self.parse_automation(spec);
    if definition.parameter == "" { return 0; }
    let column: i32 = self.track_start(index) + self.track_columns(index);
    var rows: list<TableRow> = []; let previous: list<TableRow> = self.rows;
    for row in previous {
        var cells: list<str8> = [];
        for c in 0..row.cells.len() {
            if c == column { cells.push(clone("")); }
            cells.push(row.cells[c]);
        }
        if column >= row.cells.len() { cells.push(clone("")); }
        rows.push(TableRow { cells: cells });
    }
    self.rows = rows;
    var track: SequenceTrack = self.tracks[index];
    track.automation.push(definition); track.zoom_stage = 2;
    let added: i32 = i32(track.automation.len());
    self.replace_track(index, track); self.rebuild_columns();
    self.revision = self.revision + 1; self.error = "";
    return added;
}
/// Remove one-based automation `slot` of track `index` with its values.
pub fn remove_automation(self: &mut Self, index: i32, slot: i32, area: Rect) -> bool {
    if index < 0 || index >= self.tracks.len() { return false; }
    var track: SequenceTrack = self.tracks[index];
    if slot < 1 || slot > track.automation.len() { self.error = "Select a CC column first"; return false; }
    let column: i32 = self.automation_column(index, slot);
    var rows: list<TableRow> = []; let previous: list<TableRow> = self.rows;
    for row in previous {
        var cells: list<str8> = [];
        for c in 0..row.cells.len() { if c == column { free(row.cells[c]); } else { cells.push(row.cells[c]); } }
        rows.push(TableRow { cells: cells });
    }
    self.rows = rows;
    var slots: list<AutomationSlot> = [];
    for i in 0..track.automation.len() {
        let old: AutomationSlot = track.automation[i];
        if i32(i) + 1 == slot { free(old.parameter); } else { slots.push(old); }
    }
    let remaining: i32 = i32(slots.len());
    track.automation = slots; self.replace_track(index, track);
    // The cursor stays on the neighbouring CC column, else the track's NOTE.
    self.selected_column = remaining > 0 ? self.automation_column(index, slot > remaining ? remaining : slot) : self.track_start(index);
    self.rebuild_columns(); self.reconcile(area);
    self.revision = self.revision + 1; self.error = ""; return true;
}
/// Replace every automation column of track `index` with `slots` (owned),
/// leaving their cells empty.
fn replace_automation(self: &mut Self, index: i32, slots: list<AutomationSlot>) -> void {
    let track: SequenceTrack = self.tracks[index];
    let first: i32 = self.automation_column(index, 1); let old_count: i32 = i32(track.automation.len());
    var rows: list<TableRow> = []; let previous: list<TableRow> = self.rows;
    for row in previous {
        var cells: list<str8> = [];
        for c in 0..row.cells.len() {
            if c == first { for _s in 0..slots.len() { cells.push(clone("")); } }
            if c >= first && c < first + old_count { free(row.cells[c]); } else { cells.push(row.cells[c]); }
        }
        if first >= row.cells.len() { for _s in 0..slots.len() { cells.push(clone("")); } }
        rows.push(TableRow { cells: cells });
    }
    self.rows = rows;
    var updated: SequenceTrack = self.tracks[index];
    let old: list<AutomationSlot> = updated.automation; for slot in old { free(slot.parameter); }
    updated.automation = slots; self.replace_track(index, updated);
}
/// 80 adds a blank note line, 81 removes it, 82 duplicates NOTE/VEL/LEN/OFF.
/// Move every note of track `index` onto note line `line`, adding lines until
/// it exists, and rename the track "<name> - <line + 1>". Used when parallel
/// song patterns would drive one instrument with the same notes.
/// Grow track `index` to at least `count` note lines, adding empty columns.
pub fn ensure_note_lines(self: &mut Self, index: i32, count: i32) -> bool {
    if index < 0 || index >= self.tracks.len() || count < 1 || count > 64 { return false; }
    var track: SequenceTrack = self.tracks[index];
    if track.audio { return false; }
    let first: i32 = self.track_start(index);
    while track.note_lines < count {
        var grown: SequenceTrack = self.tracks[index];
        let column: i32 = first + track.note_lines * 4;
        var rows: list<TableRow> = []; let previous: list<TableRow> = self.rows;
        for row in previous {
            var cells: list<str8> = [];
            for c in 0..row.cells.len() {
                if c == column { for _f in 0..4 { cells.push(clone("")); } }
                cells.push(row.cells[c]);
            }
            if column >= row.cells.len() { for _f in 0..4 { cells.push(clone("")); } }
            rows.push(TableRow { cells: cells });
        }
        self.rows = rows;
        grown.note_lines = grown.note_lines + 1;
        self.replace_track(index, grown);
        track = self.tracks[index];
    }
    return true;
}
/// Append every track of `source`, looping its rows when it is shorter. Used to
/// play one song-matrix row: the parallel patterns become one table.
/// Bring another pattern's tracks in beside these. `shared_once` keeps one
/// channel when both patterns carry it (same kind, name and instrument), for
/// views that show a song row's channels rather than play its notes.
pub fn append_tracks_from(self: &mut Self, source: &SequenceTable, area: Rect, shared_once: bool, start: i32) -> void {
    var other: SequenceTable = SequenceTable {}; other = source;
    let source_rows: i64 = other.rows.len();
    if source_rows == 0 { return; }
    for t in 0..other.tracks.len() {
        let track: SequenceTrack = other.tracks[t];
        if shared_once {
            var present: bool = false;
            let existing: list<SequenceTrack> = self.tracks;
            for channel in existing {
                if channel.audio == track.audio && channel.instrument_id == track.instrument_id
                    && channel.name == track.name { present = true; }
            }
            if present { continue; }
        }
        self.create_track_kind(false, track.audio, area);
        let index: i32 = i32(self.tracks.len()) - 1;
        if !track.audio { self.ensure_note_lines(index, track.note_lines); }
        var copy: SequenceTrack = self.tracks[index];
        free(copy.name); copy.name = clone(track.name);
        copy.muted = track.muted; copy.volume = track.volume; copy.pan = track.pan;
        copy.instrument = track.instrument; copy.instrument_id = track.instrument_id;
        copy.sends = track.copy_sends(); copy.inserts = track.inserts; copy.output = track.output;
        // Clips live in the track, not in its cells: a merged lane plays its
        // audio, not just its LEN column.
        copy.instances = track.copy_audio();
        self.replace_track(index, copy);
        self.replace_automation(index, track.copy_automation());
        // Growing note lines widens the rows but not the column list; the copy
        // below stops at the column count, so rebuild it first or every note
        // line after the first (chords) and the CC columns are dropped.
        self.rebuild_columns();
        let columns: i32 = other.track_columns(i32(t));
        let from: i32 = other.track_start(i32(t)); let to: i32 = self.track_start(index);
        for r in 0..self.rows.len() {
            let row: TableRow = other.rows[(wide(start) + wide(i32(r))) % source_rows];
            for c in 0..columns {
                if from + i32(c) >= row.cells.len() || to + i32(c) >= self.columns.len() { break; }
                self.set_cell(i32(r), to + i32(c), clone(row.cells[from + i32(c)]));
            }
        }
    }
    self.rebuild_columns();
}
pub fn move_notes_to_line(self: &mut Self, index: i32, line: i32, area: Rect) -> bool {
    if index < 0 || index >= self.tracks.len() || line < 1 || line > 15 { return false; }
    var track: SequenceTrack = self.tracks[index];
    if track.audio { return false; }
    if !self.ensure_note_lines(index, line + 1) { return false; }
    let first: i32 = self.track_start(index);
    // Move line 0 onto the target line; the source line is left empty.
    let source: i32 = first; let target: i32 = first + line * 4;
    var moved: list<TableRow> = []; let rows: list<TableRow> = self.rows;
    for row in rows {
        // Copy the source line first: the target sits after it, so freeing in
        // place would leave the target reading freed cells.
        var carried: list<str8> = [];
        for f in 0..4 { carried.push(clone(row.cells[source + f])); }
        var cells: list<str8> = [];
        for c in 0..row.cells.len() {
            if c >= target && c < target + 4 { free(row.cells[c]); cells.push(clone(carried[c - target])); }
            else if c >= source && c < source + 4 { free(row.cells[c]); cells.push(clone("")); }
            else { cells.push(row.cells[c]); }
        }
        for value in carried { free(value); }
        moved.push(TableRow { cells: cells });
    }
    self.rows = moved;
    var renamed: SequenceTrack = self.tracks[index];
    let base: str8 = strip_split_suffix(renamed.name);
    free(renamed.name); renamed.name = format!("{} - {}", base, line + 1); free(base);
    self.replace_track(index, renamed);
    self.revision = self.revision + 1;
    self.rebuild_columns(); self.reconcile(area);
    return true;
}
pub fn note_line_action(self: &mut Self, command: i32, area: Rect) -> void {
    let index: i32 = self.active_track(); if index < 0 { return; }
    var track: SequenceTrack = self.tracks[index];
    if track.audio { self.error = "Note lines require a MIDI track"; return; }
    let first: i32 = self.track_start(index);
    let offset: i32 = self.selected_column - first;
    let selected: i32 = offset < track.note_lines * 4 ? offset / 4 : -1;
    if selected < 0 && command != 80 { self.error = "Select a NOTE, VEL, LEN or OFF column"; return; }
    if command == 81 && track.note_lines == 1 { self.error = "Keep at least one note line"; return; }
    if command != 81 && track.note_lines >= 16 { self.error = "Maximum 16 note lines per track"; return; }
    let line: i32 = command == 81 ? selected : (selected < 0 ? track.note_lines : selected + 1);
    let column: i32 = first + line * 4;
    let source: i32 = first + selected * 4;
    var rows: list<TableRow> = []; let previous: list<TableRow> = self.rows;
    for row in previous {
        var cells: list<str8> = [];
        for c in 0..row.cells.len() {
            if c == column && command != 81 {
                if command == 82 { cells.push(clone(row.cells[source])); cells.push(clone(row.cells[source + 1])); cells.push(clone(row.cells[source + 2])); cells.push(clone(row.cells[source + 3])); }
                else { cells.push(clone("")); cells.push(clone("")); cells.push(clone("")); cells.push(clone("")); }
            }
            if command == 81 && (c >= column && c < column + 4) { free(row.cells[c]); }
            else { cells.push(row.cells[c]); }
        }
        rows.push(TableRow { cells: cells });
    }
    track.note_lines = track.note_lines + (command == 81 ? -1 : 1);
    let next: i32 = line >= track.note_lines ? track.note_lines - 1 : line;
    self.replace_track(index, track); self.rows = rows;
    self.selected_column = first + next * 4;
    self.rebuild_columns(); self.reconcile(area); self.error = "";
    self.delete_pending = false; self.top_pending = false;
}
pub fn track_action(self: &mut Self, command: i32, area: Rect) -> void {
    if command == 83 || command == 84 { self.zoom_tracks(command == 83 ? 0 : 2, true, area); return; }
    if command >= 80 && command <= 82 { self.note_line_action(command, area); return; }
    self.delete_pending = false;
    if command == 21 { self.create_track(false, area); return; }
    if command == 28 { self.create_track_kind(false, true, area); return; }
    if command == 23 { self.create_track(true, area); return; }
    if command == 22 { self.remove_track(area); return; }
    if command == 24 { self.clear_track(); return; }
    let index: i32 = self.active_track(); if index < 0 { return; }
    var track: SequenceTrack = self.tracks[index];
    if command == 25 { track.muted = !track.muted; self.replace_track(index, track); self.rebuild_columns(); return; }
    if command == 85 {
        self.remove_automation(index, self.automation_slot_at(self.selected_column), area); return;
    }
    if command == 27 && track.audio { self.error = "An AUDIO track has no MIDI output to automate"; return; }
    if command == 26 {
        // Off a CC column (they hide while a track is collapsed) the first one is meant.
        self.edit_slot = self.automation_slot_at(self.selected_column);
        if self.edit_slot == 0 && track.automation.len() > 0 { self.edit_slot = 1; }
        if self.edit_slot == 0 { self.error = "The track has no CC column; add one first"; return; }
    }
    if command == 20 || command == 26 || command == 27 {
        self.edit_mode = command == 20 ? 1 : (command == 26 ? 2 : 3);
        if command == 20 { self.editor.set_text(track.name); }
        else if command == 26 { let slot: AutomationSlot = track.automation[self.edit_slot - 1]; self.editor.set_text(slot.parameter); }
        else { self.editor.set_text("cc:74"); }
        self.editing = true; self.error = "";
    }
}
pub fn release(self: &mut Self) -> void {
    self.clear_clipboard();
    let tracks: list<SequenceTrack> = self.tracks;
    for track in tracks { track.release_strings(); track.release_audio(); }
    let groups: list<TableGroup> = self.groups;
    for group in groups { free(group.title); if group.subtitle != "" { free(group.subtitle); } }
    let titles: list<str8> = self.column_titles; for title in titles { free(title); }
    let rows: list<TableRow> = self.rows;
    for row in rows { let cells: list<str8> = row.cells; for cell in cells { free(cell); } }
    let notes: array<str8, 128> = self.notes;
    for note in notes { free(note); }
    self.audio_clipboard.release();
    self.editor.release();
}
/// -1 cycles each targeted MIDI track independently; 0/2 collapse/expand.
/// Hidden columns keep their storage and validation; audio keeps waveform zoom.
pub fn zoom_tracks(self: &mut Self, stage: i32, all: bool, area: Rect) -> void {
    let selected: i32 = self.active_track();
    var tracks: list<SequenceTrack> = [];
    for i in 0..self.tracks.len() {
        var track: SequenceTrack = self.tracks[i];
        if !track.audio && (all || i == selected) {
            track.zoom_stage = stage < 0 ? (track.zoom_stage + 1) % 3 : stage;
        }
        tracks.push(track);
    }
    self.tracks = tracks; self.rebuild_columns();
    if selected >= 0 && self.selected_column >= 0 {
        let column: TableColumn = self.columns[self.selected_column];
        if column.hidden {
            let first: i32 = self.track_start(selected); let track: SequenceTrack = self.tracks[selected];
            let offset: i32 = self.selected_column - first;
            self.selected_column = first + (offset < track.note_lines * 4 ? offset / 4 * 4 : 0);
        }
    }
    self.reconcile(area);
}
pub fn note_index(self: SequenceTable, value: str8) -> i32 {
    for i in 0..128 { if self.notes[i] == value { return i32(i); } }
    return -1;
}
pub fn note_length(self: SequenceTable, row: i32, column: i32) -> i64 {
    let data: TableRow = self.rows[row];
    if data.cells[column + 2] == "" || data.cells[column + 2] == "1.00" { return 15000; }
    let ticks: i64 = duration_ticks(data.cells[column + 2]);
    return ticks > 0 ? ticks : 15000;
}
pub fn is_length(self: SequenceTable) -> bool {
    let index: i32 = self.active_track(); if index < 0 { return false; }
    let track: SequenceTrack = self.tracks[index];
    let offset: i32 = self.selected_column - self.track_start(index);
    return track.audio ? offset == i32(track.automation.len()) : (offset < track.note_lines * 4 && offset % 4 == 2);
}
pub fn note_offset(self: SequenceTable, row: i32, column: i32) -> i64 {
    let data: TableRow = self.rows[row];
    if data.cells[column + 3] == "" || data.cells[column + 3] == "0.00" { return 0; }
    let ticks: i64 = offset_ticks(data.cells[column + 3]);
    return ticks >= -245760000 ? ticks : 0;
}
pub fn is_offset(self: SequenceTable) -> bool {
    let index: i32 = self.active_track(); if index < 0 { return false; }
    let track: SequenceTrack = self.tracks[index];
    let offset: i32 = self.selected_column - self.track_start(index);
    return !track.audio && offset >= 0 && offset < track.note_lines * 4 && offset % 4 == 3;
}
fn write_owned_cell(self: &mut Self, row: i32, column: i32, value: str8) -> void {
    let data: TableRow = self.rows[row]; let old: str8 = data.cells[column];
    if self.set_cell(row, column, value) { free(old); } else { free(value); }
}
/// Store an owned automation cell text after checking the slot's limits.
fn store_automation(self: &mut Self, row: i32, column: i32, text: str8) -> bool {
    let index: i32 = self.track_of_column(column); let number: i32 = self.automation_slot_at(column);
    if index < 0 || number == 0 || row < 0 || row >= self.rows.len() { free(text); return false; }
    let track: SequenceTrack = self.tracks[index]; let slot: AutomationSlot = track.automation[number - 1];
    if !automation_valid(text, slot.minimum, slot.maximum) {
        free(text); self.error = format!("{}: {} to {}, or four 1/64 steps like 12 . 31 40", slot.parameter, slot.minimum, slot.maximum); return false;
    }
    let data: TableRow = self.rows[row];
    if data.cells[column] == text { free(text); self.error = ""; return true; }
    self.write_owned_cell(row, column, text);
    self.revision = self.revision + 1; self.error = ""; return true;
}
/// Set 1/64 `step` of an automation cell, keeping its other steps.
pub fn set_automation_step(self: &mut Self, row: i32, column: i32, step: i32, value: str8) -> bool {
    if row < 0 || row >= self.rows.len() { return false; }
    let data: TableRow = self.rows[row];
    let steps: list<str8> = automation_steps(data.cells[column]); var updated: list<str8> = [];
    for s in 0..steps.len() { updated.push(clone(i32(s) == step ? value : steps[s])); }
    free_steps(steps); let text: str8 = automation_text(updated);
    return self.store_automation(row, column, text);
}
/// Owned value of the automation step under the cursor (whole cell unzoomed).
fn automation_cursor_text(self: SequenceTable) -> str8 {
    let row: TableRow = self.rows[self.selected_row];
    if self.row_spacing() == 1 { return clone(row.cells[self.selected_column]); }
    let steps: list<str8> = automation_steps(row.cells[self.selected_column]);
    let value: str8 = clone(steps[self.automation_step()]); free_steps(steps); return value;
}
/// Step J/K on an automation cell: unzoomed (or `all`) every step moves
/// together, zoomed only the step under the cursor. An empty target starts at
/// the slot minimum; a step that would leave the limits cancels the change.
pub fn nudge_automation(self: &mut Self, delta: i32, all: bool) -> bool {
    let index: i32 = self.active_track(); let number: i32 = self.automation_slot_at(self.selected_column);
    if index < 0 || number == 0 || self.selected_row < 0 || self.selected_row >= self.rows.len() { return false; }
    let track: SequenceTrack = self.tracks[index]; let slot: AutomationSlot = track.automation[number - 1];
    let row: TableRow = self.rows[self.selected_row];
    let steps: list<str8> = automation_steps(row.cells[self.selected_column]);
    let whole: bool = all || self.row_spacing() == 1;
    let target: i32 = self.automation_step();
    var empty: bool = true;
    for s in 0..steps.len() { if (whole || i32(s) == target) && steps[s] != "" { empty = false; } }
    var updated: list<str8> = [];
    for s in 0..steps.len() {
        let chosen: bool = whole ? (empty ? s == 0 : steps[s] != "") : i32(s) == target;
        if !chosen { updated.push(clone(steps[s])); continue; }
        if steps[s] == "" { updated.push(format!("{}", slot.minimum)); continue; }
        let parsed: result<i64, str8> = table_integer(steps[s]);
        updated.push(parsed.is_ok() ? format!("{}", parsed.unwrap() + wide(delta)) : clone(steps[s]));
    }
    free_steps(steps); let text: str8 = automation_text(updated);
    return self.store_automation(self.selected_row, self.selected_column, text);
}
fn commit(self: &mut Self, value: str8) -> bool {
    // Zoomed in, a single value sets the 1/64 step under the cursor; a
    // four-step text always replaces the cell.
    if self.is_automation() {
        if value != "" && !table_matches(automation_pattern(), value) { self.error = "CC: a value, or four 1/64 steps like 12 . 31 40"; return false; }
        if self.row_spacing() > 1 && find(value, " ") < 0 {
            return self.set_automation_step(self.selected_row, self.selected_column, self.automation_step(), value);
        }
        return self.store_automation(self.selected_row, self.selected_column, clone(value));
    }
    if !self.can_set(self.selected_row, self.selected_column, value) { self.error = "Invalid type or outside column limits"; return false; }
    if self.is_offset() && offset_ticks(value) < -245760000 { self.error = "OFF: -16384.00 to 16384.00 sixteenth notes"; return false; }
    if self.is_note() && value != "" {
        if self.note_index(value) < 0 { self.error = "Expected MIDI note C--1 through G-9"; return false; }
    }
    if self.is_length() {
        let ticks: i64 = value == "" ? 15000 : duration_ticks(value);
        if ticks < 0 { self.error = "LEN: 0.01-16384.00 sixteenth notes"; return false; }
        let index: i32 = self.active_track(); var track: SequenceTrack = self.tracks[index];
        if track.audio {
            let hit: i32 = track.instance_at(self.selected_row);
            if hit < 0 { self.error = "Set LEN at the start of an audio instance"; return false; }
            let instance: AudioInstance = track.instances[hit];
            if instance.start_row != self.selected_row { self.error = "Set LEN at the start of an audio instance"; return false; }
            let natural: i64 = instance.clip.frames_per_row > 0 ? instance.clip.frames * 15000 / instance.clip.frames_per_row : wide(i32(instance.clip.peaks.len())) * 15000;
            let duration: i64 = value == "" ? natural : ticks;
            if duration > natural + 149 { self.error = "LEN exceeds the sample duration"; return false; }
            let end: i64 = wide(instance.start_row) * 15000 + duration;
            if end > wide(i32(self.rows.len())) * 15000 { self.error = "Extend the pattern first"; return false; }
            let instances: list<AudioInstance> = track.instances; var updated: list<AudioInstance> = [];
            for other in instances {
                if other.start_row > instance.start_row && wide(other.start_row) * 15000 < end {
                    self.error = "Audio overlaps another instance"; return false;
                }
            }
            for i in 0..track.instances.len() {
                var next: AudioInstance = track.instances[i];
                if i == hit { next.length_ticks = i32(duration > natural ? natural : duration); }
                updated.push(next);
            }
            track.instances = updated; self.replace_track(index, track);
            self.write_owned_cell(self.selected_row, self.selected_column, duration_text(duration)); self.error = ""; return true;
        }
    }
    let row: TableRow = self.rows[self.selected_row];
    let old: str8 = row.cells[self.selected_column];
    let copy: str8 = clone(value);
    if !self.set_cell(self.selected_row, self.selected_column, copy) { free(copy); return false; }
    let new_note: bool = self.is_note() && old == "" && value != "";
    free(old);
    if new_note { self.write_owned_cell(self.selected_row, self.selected_column + 1, clone("100")); }
    if new_note { self.write_owned_cell(self.selected_row, self.selected_column + 2, clone("1.00")); }
    if new_note { self.write_owned_cell(self.selected_row, self.selected_column + 3, clone("0.00")); }
    self.revision = self.revision + 1;
    self.error = ""; return true;
}
pub fn clear_row(self: &mut Self) -> void {
    self.revision = self.revision + 1;
    if self.selected_row < 0 || self.selected_row >= self.rows.len() { return; }
    let row: TableRow = self.rows[self.selected_row];
    // Validate the complete operation before changing any cell.
    for c in 0..self.columns.len() {
        let column: TableColumn = self.columns[c];
        if !column.read_only {
            if !self.can_set(self.selected_row, i32(c), "") { self.error = "Column does not allow an empty value"; return; }
        }
    }
    for c in 0..self.columns.len() {
        let column: TableColumn = self.columns[c];
        if !column.read_only {
            let empty: str8 = clone("");
            self.set_cell(self.selected_row, i32(c), empty); free(row.cells[c]);
        }
    }
    self.error = "";
}
pub fn length_truncates_data(self: SequenceTable, count: i32) -> bool {
    if count >= self.rows.len() { return false; }
    for r in count..self.rows.len() {
        let row: TableRow = self.rows[r];
        for c in 1..row.cells.len() { if row.cells[c] != "" { return true; } }
    }
    let tracks: list<SequenceTrack> = self.tracks;
    for track in tracks {
        let instances: list<AudioInstance> = track.instances;
        for instance in instances {
            if wide(instance.start_row) * 15000 + instance.duration() > wide(count) * 15000 { return true; }
        }
    }
    return false;
}
pub fn set_length(self: &mut Self, count: i32, area: Rect) -> bool {
    if count < 1 || count > 16384 { return false; }
    self.revision = self.revision + 1;
    let selected_row: i32 = self.selected_row; let selected_column: i32 = self.selected_column;
    // Remove placements beyond the new end using the existing column cleanup.
    for t in 0..self.tracks.len() {
        let track: SequenceTrack = self.tracks[t];
        let instances: list<AudioInstance> = track.instances;
        for instance in instances {
            if instance.start_row >= count {
                self.selected_column = self.track_start(i32(t)); self.selected_row = instance.start_row;
                self.remove_audio_under_cursor();
            }
        }
        var updated: SequenceTrack = self.tracks[t];
        var kept: list<AudioInstance> = []; let remaining: list<AudioInstance> = updated.instances;
        for instance in remaining {
            var clipped: AudioInstance = AudioInstance {}; clipped = instance;
            let length: i32 = count - clipped.start_row;
            if clipped.duration() > wide(length) * 15000 { clipped.length_ticks = length * 15000; }
            if length < clipped.clip.peaks.len() {
                var peaks: list<WavePeak> = []; var details: list<WavePeak> = [];
                for r in 0..length { peaks.push(clipped.clip.peaks[r]); }
                for r in 0..clipped.clip.detail_peaks.len() {
                    if r < length * 4 { details.push(clipped.clip.detail_peaks[r]); }
                }
                clipped.clip.peaks = peaks; clipped.clip.detail_peaks = details;
                let frames: i64 = wide(length) * clipped.clip.frames_per_row;
                if frames < clipped.clip.frames { clipped.clip.frames = frames; }
            }
            kept.push(clipped);
        }
        updated.instances = kept; self.replace_track(i32(t), updated);
        let saved: SequenceTrack = self.tracks[t]; let placements: list<AudioInstance> = saved.instances;
        for instance in placements { self.write_owned_cell(instance.start_row, self.audio_length_column(i32(t)), duration_text(instance.duration())); }
    }
    var rows: list<TableRow> = []; let previous: list<TableRow> = self.rows;
    for r in 0..previous.len() {
        let row: TableRow = previous[r];
        if r < count { rows.push(row); }
        else { let cells: list<str8> = row.cells; for cell in cells { free(cell); } }
    }
    for r in rows.len()..count {
        var cells: list<str8> = [format!("{}{}", r < 9 ? "00" : (r < 99 ? "0" : ""), r + 1)];
        for _c in 1..self.columns.len() { cells.push(clone("")); }
        rows.push(TableRow { cells: cells });
    }
    self.rows = rows; self.delete_pending = false; self.top_pending = false; self.error = "";
    self.selected_row = selected_row; self.selected_column = selected_column;
    self.reconcile(area); return true;
}
/// Insert/delete one visible note-time slot without removing its neighbouring
/// subdivisions. Main-row automation and audio placements keep their anchors.
pub fn shift_subdivision(self: &mut Self, above: bool, removing: bool, area: Rect) -> bool {
    self.delete_pending = false; self.top_pending = false;
    self.reconcile(area);
    if self.selected_row < 0 { return false; }
    let scale: i32 = self.row_spacing(); let step: i64 = 15000 / wide(scale);
    let slot: i32 = self.selected_row * scale + self.selected_subrow + (!removing && !above ? 1 : 0);
    let selected_track: i32 = self.active_track();
    let selected_offset: i32 = selected_track >= 0 ? self.selected_column - self.track_start(selected_track) : 0;
    var candidate: SequenceTable = self.copy_pattern();
    // Clear only notes in the staged copy. Automation/audio remain row-based.
    for t in 0..candidate.tracks.len() {
        let track: SequenceTrack = candidate.tracks[t]; if track.audio { continue; }
        let first: i32 = candidate.track_start(i32(t));
        for r in 0..candidate.rows.len() {
            for c in 0..(track.note_lines * 4) { candidate.write_owned_cell(i32(r), first + i32(c), clone("")); }
        }
    }
    for t in 0..self.tracks.len() {
        let track: SequenceTrack = self.tracks[t]; if track.audio { continue; }
        let first: i32 = self.track_start(i32(t));
        for r in 0..self.rows.len() {
            let row: TableRow = self.rows[r];
            for line in 0..track.note_lines {
                let column: i32 = first + i32(line) * 4; if row.cells[column] == "" { continue; }
                let original: i64 = r * 15000 + self.note_offset(i32(r), column);
                var tick: i64 = original;
                if original >= 0 && original < self.rows.len() * 15000 {
                    let position: i64 = (original + step / 2) / step;
                    if removing && position == slot { continue; }
                    if position >= slot { tick = original + (removing ? -step : step); }
                }
                let destination: i32 = tick >= 0 && tick < 245760000 ? i32(tick / 15000) : i32(r);
                if tick >= 245760000 && tick != original { self.error = "Maximum pattern length is 16384 rows"; candidate.release(); return false; }
                if destination >= candidate.rows.len() { candidate.set_length(destination + 1, area); }
                let target_track: SequenceTrack = candidate.tracks[t]; let target_first: i32 = candidate.track_start(i32(t));
                let target: TableRow = candidate.rows[destination]; var free_line: i32 = -1;
                for n in 0..target_track.note_lines { if free_line < 0 && target.cells[target_first + i32(n) * 4] == "" { free_line = i32(n); } }
                if free_line < 0 {
                    free_line = target_track.note_lines;
                    if !candidate.ensure_note_lines(i32(t), free_line + 1) { self.error = "Maximum 64 notes per main row"; candidate.release(); return false; }
                    candidate.rebuild_columns();
                }
                let target_column: i32 = candidate.track_start(i32(t)) + free_line * 4;
                for f in 0..3 { candidate.write_owned_cell(destination, target_column + i32(f), clone(row.cells[column + i32(f)])); }
                candidate.write_owned_cell(destination, target_column + 3, offset_text(tick - wide(destination) * 15000));
            }
        }
    }
    // An insertion after the final visible slot still needs a blank destination.
    if !removing && slot >= candidate.rows.len() * scale {
        if candidate.rows.len() >= 16384 { self.error = "Maximum pattern length is 16384 rows"; candidate.release(); return false; }
        candidate.set_length(i32(candidate.rows.len()) + 1, area);
    }
    let old_rows: list<TableRow> = self.rows;
    for row in old_rows { let cells: list<str8> = row.cells; for cell in cells { free(cell); } }
    let old_tracks: list<SequenceTrack> = self.tracks;
    for track in old_tracks { track.release_strings(); track.release_audio(); }
    self.rows = candidate.rows; self.tracks = candidate.tracks;
    candidate.rows = []; candidate.tracks = []; candidate.release();
    self.rebuild_columns(); self.selected_row = slot / scale; self.selected_subrow = slot % scale;
    if selected_track >= 0 { self.selected_column = self.track_start(selected_track) + selected_offset; }
    self.visual = false; self.revision = self.revision + 1; self.error = ""; self.reconcile(area); return true;
}
pub fn insert_row(self: &mut Self, above: bool, area: Rect) -> void {
    if self.row_spacing() > 1 { self.shift_subdivision(above, false, area); return; }
    self.delete_pending = false; self.top_pending = false;
    if self.rows.len() >= 16384 { self.error = "Maximum pattern length is 16384 rows"; return; }
    self.reconcile(area);
    let index: i32 = self.rows.len() == 0 ? 0 : self.selected_row + (above ? 0 : 1);
    let previous: list<TableRow> = self.rows; var rows: list<TableRow> = [];
    for r in 0..previous.len() + 1 {
        var cells: list<str8> = [format!("{}{}", r < 9 ? "00" : (r < 99 ? "0" : ""), r + 1)];
        if r == index {
            for _c in 1..self.columns.len() { cells.push(clone("")); }
        } else {
            let old: TableRow = previous[r < index ? r : r - 1];
            free(old.cells[0]);
            for c in 1..old.cells.len() { cells.push(old.cells[c]); }
        }
        rows.push(TableRow { cells: cells });
    }
    self.rows = rows;
    // Keep clip starts attached to their shifted rows. Clips already sounding
    // across the insertion point retain their duration and are not stretched.
    for t in 0..self.tracks.len() {
        var track: SequenceTrack = self.tracks[t];
        let old: list<AudioInstance> = track.instances; var shifted: list<AudioInstance> = [];
        for instance in old {
            var next: AudioInstance = AudioInstance {}; next = instance;
            if next.start_row >= index { next.start_row = next.start_row + 1; }
            shifted.push(next);
        }
        track.instances = shifted; self.replace_track(i32(t), track);
    }
    self.selected_row = index; self.visual = false; self.error = "";
    self.revision = self.revision + 1; self.reconcile(area);
}
pub fn delete_row(self: &mut Self, area: Rect) -> void {
    if self.row_spacing() > 1 { self.shift_subdivision(false, true, area); return; }
    self.revision = self.revision + 1;
    if self.selected_row < 0 || self.selected_row >= self.rows.len() { return; }
    let previous: list<TableRow> = self.rows;
    var kept: list<TableRow> = [];
    for i in 0..previous.len() {
        let row: TableRow = previous[i];
        let cells: list<str8> = row.cells;
        if i == self.selected_row {
            for cell in cells { free(cell); }
        } else {
            var replacement: list<str8> = [];
            let index: i32 = i32(kept.len());
            replacement.push(format!("{}{}", index < 9 ? "00" : "0", index + 1));
            for c in 1..cells.len() { replacement.push(cells[c]); }
            free(cells[0]); kept.push(TableRow { cells: replacement });
        }
    }
    self.rows = kept; self.error = ""; self.delete_pending = false;
    self.reconcile(area);
}
pub fn clear_clipboard(self: &mut Self) -> void {
    let rows: list<TableRow> = self.clipboard;
    for row in rows { let cells: list<str8> = row.cells; for cell in cells { free(cell); } }
    let kinds: list<str8> = self.clipboard_kinds; for kind in kinds { free(kind); }
    self.clipboard = []; self.clipboard_kinds = []; self.clipboard_rows = false; self.clipboard_spacing = 1;
}
fn cell_kind(self: SequenceTable, column: i32) -> str8 {
    // Any CC column takes any other's values; limits are checked on paste.
    if self.automation_slot_at(column) > 0 { return clone("CC:automation"); }
    let definition: TableColumn = self.columns[column];
    return format!("{}:{}", definition.title, definition.value_type);
}
pub fn copy_visual(self: &mut Self, cut: bool, area: Rect) -> void {
    if !self.visual { return; }
    if self.anchor_row < 0 || self.anchor_row >= self.rows.len() || self.anchor_column < 0 || self.anchor_column >= self.columns.len() {
        self.visual = false; return;
    }
    self.error = ""; self.paste_error = false;
    let anchor: i32 = self.anchor_row * self.row_spacing() + self.anchor_subrow;
    let selected: i32 = self.selected_row * self.row_spacing() + self.selected_subrow;
    let first_row: i32 = anchor < selected ? anchor : selected;
    let last_row: i32 = anchor > selected ? anchor : selected;
    let first_col: i32 = self.visual_rows ? 1 : (self.anchor_column < self.selected_column ? self.anchor_column : self.selected_column);
    let last_col: i32 = self.visual_rows ? i32(self.columns.len()) - 1 : (self.anchor_column > self.selected_column ? self.anchor_column : self.selected_column);
    self.clear_clipboard();
    self.clipboard_rows = self.visual_rows; self.clipboard_spacing = self.row_spacing();
    for c in first_col..last_col + 1 {
        let column: TableColumn = self.columns[c];
        if (self.clipboard_rows || !column.hidden) && !column.read_only { self.clipboard_kinds.push(self.cell_kind(i32(c))); }
    }
    for r in first_row..last_row + 1 {
        var cells: list<str8> = [];
        for c in first_col..last_col + 1 {
            let column: TableColumn = self.columns[c];
            if (self.clipboard_rows || !column.hidden) && !column.read_only { if self.row_spacing() > 1 { cells.push(self.subdivision_cell(i32(r), i32(c))); }
                else { let row: TableRow = self.rows[r]; cells.push(clone(row.cells[c])); } }
        }
        self.clipboard.push(TableRow { cells: cells });
    }
    self.visual = false; self.selected_row = first_row / self.row_spacing(); self.selected_subrow = first_row % self.row_spacing(); self.selected_column = first_col;
    if cut { self.apply_clipboard(true, area); }
    self.reconcile(area);
}
/// Delete the selected cells while retaining the previous paste buffer.
pub fn erase_visual(self: &mut Self, area: Rect) -> void {
    let saved: list<TableRow> = self.clipboard; let kinds: list<str8> = self.clipboard_kinds;
    let whole: bool = self.clipboard_rows; let spacing: i32 = self.clipboard_spacing;
    var audio: AudioClip = AudioClip {}; audio = self.audio_clipboard;
    self.clipboard = []; self.clipboard_kinds = []; self.audio_clipboard = AudioClip {};
    let track: i32 = self.active_track();
    if track >= 0 && self.tracks[track].audio { self.visual_audio_copy(true, area); }
    else { self.copy_visual(true, area); }
    self.clear_clipboard(); self.audio_clipboard.release();
    self.clipboard = saved; self.clipboard_kinds = kinds; self.clipboard_rows = whole; self.clipboard_spacing = spacing;
    self.audio_clipboard = audio;
}
pub fn paste_visual(self: &mut Self, area: Rect) -> void { self.apply_clipboard(false, area); }
fn apply_clipboard(self: &mut Self, erase: bool, area: Rect) -> void {
    self.error = ""; self.paste_error = false;
    if self.clipboard.len() == 0 || self.clipboard_kinds.len() == 0 { return; }
    if self.selected_row < 0 || self.selected_column < 0 { return; }
    let start_kind: str8 = self.cell_kind(self.selected_column);
    let matching_start: bool = start_kind == self.clipboard_kinds[0]; free(start_kind);
    if !matching_start {
        self.error = "Paste needs matching columns: NOTE to NOTE, etc."; self.paste_error = true; return;
    }
    let spacing: i32 = self.clipboard_spacing > 0 ? self.clipboard_spacing : 1;
    let start_tick: i64 = wide(self.selected_row) * 15000 + wide(self.selected_subrow) * 15000 / wide(self.row_spacing());
    if start_tick + (self.clipboard.len() - 1) * 15000 / wide(spacing) >= self.rows.len() * 15000 {
        self.error = "Selection does not fit in the pattern"; self.paste_error = true; return;
    }
    var targets: list<i32> = [];
    for c in self.selected_column..self.columns.len() {
        if targets.len() == self.clipboard_kinds.len() { break; }
        let column: TableColumn = self.columns[c];
        if (self.clipboard_rows || !column.hidden) && !column.read_only { targets.push(i32(c)); }
    }
    if targets.len() != self.clipboard_kinds.len() {
        self.error = "Selection does not fit in the pattern"; self.paste_error = true; return;
    }
    for i in 0..targets.len() {
        let kind: str8 = self.cell_kind(targets[i]); let matches: bool = kind == self.clipboard_kinds[i]; free(kind);
        if !matches { self.error = "Paste needs matching columns: NOTE to NOTE, etc."; self.paste_error = true; return; }
    }
    // Stage the entire edit so failed pastes never partially change the pattern.
    var candidate: SequenceTable = self.copy_pattern();
    let subdivisions: bool = spacing > 1 || self.row_spacing() > 1;
    var track_indices: list<i32> = []; var offsets: list<i32> = [];
    let saved_column: i32 = self.selected_column;
    for target in targets {
        self.selected_column = target; let track: i32 = self.active_track();
        track_indices.push(track); offsets.push(target - self.track_start(track));
    }
    self.selected_column = saved_column;
    if subdivisions { candidate.row_scale = 4; }
    for r in 0..self.clipboard.len() {
        let row: TableRow = self.clipboard[r];
        let tick: i64 = start_tick + r * 15000 / wide(spacing);
        for c in 0..targets.len() {
            candidate.selected_row = i32(tick / 15000); candidate.selected_subrow = i32(tick % 15000 / 3750);
            candidate.selected_column = candidate.track_start(track_indices[c]) + offsets[c];
            let value: str8 = erase ? "" : row.cells[c];
            var accepted: bool = true;
            if subdivisions && candidate.subdivision_note_field() {
                if erase {
                    // Resolve against the original projection, before clearing
                    // any note can collapse the lanes of the remaining chord.
                    let old_row: i32 = self.selected_row; let old_sub: i32 = self.selected_subrow;
                    self.selected_row = i32(tick / 15000); self.selected_subrow = i32(tick % 15000 / (15000 / wide(self.row_spacing()))); self.selected_column = targets[c];
                    let source: ViewNote = self.subdivision_source();
                    self.selected_row = old_row; self.selected_subrow = old_sub; self.selected_column = saved_column;
                    if source.row >= 0 {
                        candidate.selected_row = source.row; candidate.selected_column = source.column + offsets[c] % 4;
                        accepted = candidate.commit("");
                    }
                } else if offsets[c] % 4 == 3 && value != "" {
                    let source: ViewNote = candidate.subdivision_source();
                    let origin: i64 = source.row >= 0 ? wide(source.row) * 15000 : tick - tick % 15000;
                    let adjusted: str8 = offset_text(offset_ticks(value) + tick - origin);
                    accepted = candidate.subdivision_commit(adjusted); free(adjusted);
                } else { accepted = candidate.subdivision_commit(value); }
            } else if subdivisions && candidate.is_automation() { accepted = candidate.commit(value); }
            else if !subdivisions || tick % 15000 == 0 {
                let target: TableRow = candidate.rows[candidate.selected_row];
                if target.cells[candidate.selected_column] != value { accepted = candidate.commit(value); }
            }
            else if value != "" { candidate.error = "Automation and audio must start on a main row"; accepted = false; }
            if !accepted { self.error = candidate.error; self.paste_error = true; candidate.release(); return; }
        }
    }
    let old_rows: list<TableRow> = self.rows;
    for row in old_rows { let cells: list<str8> = row.cells; for cell in cells { free(cell); } }
    let old_tracks: list<SequenceTrack> = self.tracks;
    for track in old_tracks { track.release_strings(); track.release_audio(); }
    self.rows = candidate.rows; self.tracks = candidate.tracks; self.revision = self.revision + 1;
    candidate.rows = []; candidate.tracks = []; candidate.release();
    self.rebuild_columns(); self.reconcile(area);
}
pub fn transpose_visual(self: &mut Self, event: InputEvent, area: Rect) -> void {
    if !self.visual { return; }
    // Work on an independent pattern so a limit in any cell cancels the whole
    // step. Reuse normal editing for MIDI ranges, numeric limits and audio LEN.
    var candidate: SequenceTable = self.copy_pattern();
    var changed: bool = false;
    for r in 0..self.rows.len() {
        let row: TableRow = self.rows[r];
        for c in 0..self.columns.len() {
            let column: TableColumn = self.columns[c];
            if column.hidden || column.read_only || !self.visual_cell(i32(r), i32(c)) { continue; }
            if row.cells[c] == "" { continue; }
            candidate.selected_row = i32(r); candidate.selected_column = i32(c);
            if candidate.is_automation() {
                let down: bool = event.code == 74 || event.code == 106;
                if !candidate.nudge_automation(down ? -1 : 1, true) { candidate.release(); return; }
                changed = true; continue;
            }
            if !candidate.is_note() && !candidate.is_length() && !candidate.is_offset() &&
                    (column.value_type == "str8" || column.value_type == "bool") { continue; }
            candidate.edit_event(event, area);
            let updated: TableRow = candidate.rows[r];
            if updated.cells[c] == row.cells[c] { candidate.release(); return; }
            changed = true;
        }
    }
    if !changed { candidate.release(); return; }
    let old_rows: list<TableRow> = self.rows;
    for row in old_rows { let cells: list<str8> = row.cells; for cell in cells { free(cell); } }
    let old_tracks: list<SequenceTrack> = self.tracks;
    for track in old_tracks { track.release_strings(); track.release_audio(); }
    self.rows = candidate.rows; self.tracks = candidate.tracks;
    candidate.rows = []; candidate.tracks = []; candidate.release();
    let whole_rows: bool = self.visual_rows;
    self.rebuild_columns(); self.visual = true; self.visual_rows = whole_rows; self.error = ""; self.reconcile(area);
}
pub fn subdivision_note_field(self: SequenceTable) -> bool {
    let index: i32 = self.active_track(); if index < 0 { return false; }
    let track: SequenceTrack = self.tracks[index]; let offset: i32 = self.selected_column - self.track_start(index);
    return !track.audio && offset >= 0 && offset < track.note_lines * 4;
}
pub fn edit_event(self: &mut Self, event: InputEvent, area: Rect) -> bool {
    if event.kind == InputKind::None && event.code == 0 { return false; }
    if self.editing {
        self.delete_pending = false; self.top_pending = false;
        if event.kind == InputKind::Menu && event.key == Key::Escape && event.code < 32 {
            self.editing = false; self.edit_mode = 0; self.error = ""; return true;
        }
        if event.kind == InputKind::Menu && event.key == Key::Enter {
            var accepted: bool = false;
            if self.edit_mode == 1 { accepted = self.rename_track(self.editor.text); }
            else if self.edit_mode == 2 { accepted = self.configure_slot(self.edit_slot, self.editor.text); }
            else if self.edit_mode == 3 {
                let index: i32 = self.active_track(); let slot: i32 = self.add_automation(index, self.editor.text);
                accepted = slot > 0;
                if accepted { self.selected_column = self.automation_column(index, slot); self.reconcile(area); }
            }
            else if self.row_spacing() > 1 && self.subdivision_note_field() { accepted = self.subdivision_commit(self.editor.text); }
            else { accepted = self.commit(self.editor.text); }
            if accepted { self.editing = false; self.edit_mode = 0; }
        } else { self.editor.on_event(event); }
        return true;
    }
    self.reconcile(area);
    if self.row_spacing() > 1 && !self.visual && self.subdivision_note_field() {
        let source: ViewNote = self.subdivision_source();
        let field_index: i32 = (self.selected_column - self.track_start(self.active_track())) % 4;
        var value: str8 = "";
        if source.row >= 0 { let row: TableRow = self.rows[source.row]; value = row.cells[source.column + field_index]; }
        if event.kind == InputKind::Menu && event.key == Key::Enter {
            self.editor.set_text(value); self.editing = true; self.edit_mode = 0; self.error = ""; return true;
        }
        if event.modifiers == 1 && (event.code == 8 || event.code == 127) { self.subdivision_commit(""); return true; }
        if (event.modifiers == 1 && (event.code == 74 || event.code == 75)) || (event.modifiers == 2 && (event.code == 106 || event.code == 107)) {
            let delta: i32 = event.code == 74 || event.code == 106 ? -1 : 1;
            if field_index == 0 {
                let pitch: i32 = value == "" ? 60 : self.note_index(value) + delta;
                if pitch >= 0 && pitch <= 127 { self.subdivision_commit(self.notes[pitch]); }
            } else if value != "" {
                if field_index == 2 || field_index == 3 {
                    let ticks: i64 = field_index == 2 ? duration_ticks(value) : offset_ticks(value);
                    let next: i64 = ticks + wide(delta) * 150;
                    let text: str8 = field_index == 2 ? duration_text(next) : offset_text(next);
                    self.subdivision_commit(text); free(text);
                } else {
                    let parsed: result<i64, str8> = table_integer(value);
                    if parsed.is_ok() { let text: str8 = format!("{}", parsed.unwrap() + wide(delta)); self.subdivision_commit(text); free(text); }
                }
            }
            return true;
        }
    }
    if (event.code == 86 && (event.modifiers == 1 || event.modifiers == 2)) || (event.code == 118 && event.modifiers == 2) {
        if self.selected_row >= 0 && self.selected_column >= 0 {
            if self.visual && self.visual_rows { self.visual = false; self.visual_rows = false; }
            else {
                if !self.visual { self.anchor_row = self.selected_row; self.anchor_column = self.selected_column; self.anchor_subrow = self.selected_subrow; }
                self.visual = true; self.visual_rows = true;
            }
            self.delete_pending = false; self.top_pending = false;
        }
        return true;
    }
    // Boundary movement uses visible positions and keeps the selection anchor.
    let jump_top: bool = event.modifiers == 1 && event.code == 103;
    if !jump_top { self.top_pending = false; }
    if (event.code == 71 && (event.modifiers == 1 || event.modifiers == 2)) || (event.code == 103 && event.modifiers == 2) {
        self.selected_row = i32(self.rows.len()) - 1; self.selected_subrow = self.row_spacing() - 1;
        self.reconcile(area); return true;
    }
    if jump_top {
        if self.top_pending { self.selected_row = 0; self.selected_subrow = 0; self.top_pending = false; self.reconcile(area); }
        else { self.top_pending = true; }
        return true;
    }
    if self.visual {
        self.delete_pending = false;
        if event.kind == InputKind::Edit && event.key == Key::Backspace && event.modifiers == 1 { self.erase_visual(area); return true; }
        if event.kind == InputKind::Menu && event.key == Key::Escape && event.code < 32 { self.visual = false; return true; }
        if (event.modifiers == 1 || event.modifiers == 2) &&
                (event.code == 74 || event.code == 75 || (event.modifiers == 2 && (event.code == 106 || event.code == 107))) {
            self.transpose_visual(event, area); return true;
        }
        if event.modifiers == 1 {
            if event.code == 118 { self.visual = false; return true; }
            if event.code == 121 || event.code == 100 {
                let ai: i32 = self.active_track();
                if ai >= 0 && self.tracks[ai].audio { self.visual_audio_copy(event.code == 100, area); return true; }
                self.copy_visual(event.code == 100, area); return true;
            }
            if event.code == 104 || event.code == 106 || event.code == 107 || event.code == 108 || (event.kind == InputKind::Menu && (event.key == Key::Up || event.key == Key::Down)) { return self.on_event(event, area); }
        }
        return true;
    }
    if event.modifiers == 1 && event.code == 118 {
        if self.selected_row >= 0 && self.selected_column >= 0 {
            self.visual = true; self.visual_rows = false; self.anchor_row = self.selected_row; self.anchor_column = self.selected_column; self.anchor_subrow = self.selected_subrow;
            self.delete_pending = false; self.top_pending = false;
        }
        return true;
    }
    // Audio clip cut/copy/paste on the instance under the cursor. On AUDIO tracks
    // these take priority over the vim-style row yank/paste; elsewhere they defer.
    if event.modifiers == 5 && (event.code == 106 || event.code == 107) {
        let ai: i32 = self.active_track();
        if ai >= 0 && self.tracks[ai].audio { self.move_audio(event.code == 106 ? 1 : -1, area); return true; }
    }
    if event.modifiers == 1 && (event.code == 99 || event.code == 121) && self.audio_under_cursor() {
        if event.code == 99 { self.cut_audio(area); return true; }
        self.copy_audio(); self.reconcile(area); return true;
    }
    if event.modifiers == 1 && event.code == 112 && self.audio_clipboard.peaks.len() > 0 {
        let ai: i32 = self.active_track();
        if ai >= 0 && self.tracks[ai].audio { self.paste_audio(area); return true; }
    }
    if event.modifiers == 1 && event.code == 112 { self.paste_visual(area); return true; }
    if event.modifiers == 1 && event.code == 111 { self.insert_row(false, area); return true; }
    if (event.code == 79 && (event.modifiers == 1 || event.modifiers == 2)) ||
            (event.code == 111 && event.modifiers == 2) { self.insert_row(true, area); return true; }
    let delete_key: bool = event.modifiers == 1 && event.code == 100;
    if !delete_key { self.delete_pending = false; }
    self.reconcile(area);
    if (event.code == 90 && (event.modifiers == 1 || event.modifiers == 2)) || (event.code == 122 && event.modifiers == 2) {
        self.zoom_tracks(-1, true, area); return true;
    }
    if event.modifiers == 1 && (event.code == 8 || event.code == 127) {
        if self.remove_audio_under_cursor() { self.reconcile(area); return true; }
    }
    if event.code == 122 && event.modifiers == 1 {
        let index: i32 = self.active_track();
        if index < 0 { return false; }
        var track: SequenceTrack = self.tracks[index];
        if !track.audio { self.zoom_tracks(-1, false, area); return true; }
        track.wave_zoom = !track.wave_zoom;
        self.replace_track(index, track); self.rebuild_columns(); self.reconcile(area); return true;
    }
    if self.selected_row < 0 || self.selected_column < 0 { return self.on_event(event, area); }
    if delete_key {
        if self.delete_pending { self.delete_row(area); }
        else { self.delete_pending = true; }
        return true;
    }
    if event.modifiers == 2 && (event.code == 8 || event.code == 127) {
        self.clear_row(); return true;
    }
    let row: TableRow = self.rows[self.selected_row];
    if event.kind == InputKind::Menu && event.key == Key::Enter {
        if self.is_automation() {
            let value: str8 = self.automation_cursor_text(); self.editor.set_text(value); free(value);
        } else { self.editor.set_text(row.cells[self.selected_column]); }
        self.editing = true; self.edit_mode = 0; self.error = ""; return true;
    }
    var delta: i32 = 0;
    if event.modifiers == 1 || event.modifiers == 2 {
        if event.code == 74 || (event.modifiers == 2 && event.code == 106) { delta = -1; }
        if event.code == 75 || (event.modifiers == 2 && event.code == 107) { delta = 1; }
    }
    if delta != 0 {
        if self.is_automation() { self.nudge_automation(delta, false); return true; }
        if self.is_offset() {
            let current: i64 = offset_ticks(row.cells[self.selected_column]);
            let next: i64 = current + wide(delta) * 150;
            if next >= -245760000 && next <= 245760000 {
                let text: str8 = offset_text(next); self.commit(text); free(text);
            }
            return true;
        }
        if self.is_length() {
            let ti: i32 = self.active_track();
            if ti >= 0 && self.tracks[ti].audio {
                let hit: i32 = self.tracks[ti].instance_at(self.selected_row);
                if hit < 0 || self.tracks[ti].instances[hit].start_row != self.selected_row { return true; }
            }
            let current: i64 = row.cells[self.selected_column] == "" ? 15000 : duration_ticks(row.cells[self.selected_column]);
            let next: i64 = current + wide(delta) * 150;
            if next >= 150 && next <= 245760000 {
                let text: str8 = duration_text(next); self.commit(text); free(text);
            }
            return true;
        }
        if row.cells[self.selected_column] == "" {
            if self.is_note() { self.commit("C-4"); }
            else {
                let column: TableColumn = self.columns[self.selected_column];
                if column.value_type != "str8" && column.value_type != "bool" {
                    let initial: str8 = format!("{}", column.bounded ? column.minimum : 0);
                    self.commit(initial); free(initial);
                }
            }
            return true;
        }
        if self.is_note() {
            let next: i32 = self.note_index(row.cells[self.selected_column]) + delta;
            if next >= 0 && next < 128 { self.commit(self.notes[next]); }
        } else {
            let column: TableColumn = self.columns[self.selected_column];
            if column.value_type != "str8" && column.value_type != "bool" {
                let parsed: result<i64, str8> = table_integer(row.cells[self.selected_column]);
                if parsed.is_ok() {
                    let value: i64 = parsed.unwrap();
                    if delta > 0 && value == 9223372036854775807 { return true; }
                    if delta < 0 && value == -9223372036854775807 - 1 { return true; }
                    let text: str8 = format!("{}", value + delta);
                    if column.validate(text) { self.commit(text); }
                    free(text);
                }
            }
        }
        return true;
    }
    return self.on_event(event, area);
}
pub fn paint_editor(self: SequenceTable, surface: Surface, area: Rect, theme: Theme) -> void {
    if self.editing && self.edit_mode == 0 { self.editor.paint(surface, self.selected_rect(area), theme.foreground, theme.selection, true); }
}
pub fn paint_track_dialog(self: SequenceTable, surface: Surface, viewport: Rect, theme: Theme) -> void {
    if !self.editing || self.edit_mode == 0 { return; }
    let dialog: Dialog = Dialog { title: self.edit_mode == 1 ? "Rename track" : (self.edit_mode == 2 ? "Configure CC column" : "Add CC column"), width: 64, height: 9 };
    let content: Rect = dialog.paint_frame(surface, viewport, theme);
    surface.text(Rect::new(content.x, content.y, content.width, 1), self.edit_mode == 1 ? "Track name:" : "cc:N | pitchbend | name:min:max", theme.foreground, theme.panel);
    if content.height > 2 { self.editor.paint(surface, Rect::new(content.x, content.y + 2, content.width, 1), theme.foreground, theme.selection, true); }
    if content.height > 4 { surface.text(Rect::new(content.x, content.y + 4, content.width, 1), self.error == "" ? "Enter: save | Esc: cancel" : self.error, theme.accent, theme.panel); }
}
pub fn paint_track_details(self: SequenceTable, surface: Surface, area: Rect, theme: Theme) -> void {
    let index: i32 = self.active_track(); if index < 0 || area.height < 3 { return; }
    let track: SequenceTrack = self.tracks[index];
    let title: str8 = format!("{} [{}]{}", track.name, track.audio ? "AUDIO" : (track.instrument ? "INSTRUMENT" : "MIDI"), track.muted ? " [muted]" : "");
    var automated: str8 = clone(track.automation.len() == 0 ? "none" : "");
    for i in 0..track.automation.len() {
        let slot: AutomationSlot = track.automation[i];
        let joined: str8 = format!("{}{}{}", automated, i == 0 ? "" : " ", slot.parameter); free(automated); automated = joined;
    }
    let parameters: str8 = track.instrument ? format!("Instrument: {} | CC: {}", track.instrument_id, automated) : format!("CC: {}", automated);
    free(automated);
    surface.text(Rect::new(area.x, area.y + 1, area.width, 1), title, theme.accent, theme.panel);
    surface.text(Rect::new(area.x, area.y + 2, area.width, 1), parameters, theme.muted, theme.panel);
    free(title); free(parameters);
}
}
