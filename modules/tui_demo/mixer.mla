mod tui::meter;
mod tui::slider;
mod std::audio::controller;
use std::audio::controller::AudioController;
mod tui_demo::audio_controller;
use tui_demo::audio_controller::EffectChannel;
use tui::slider::Slider;
mod tui_demo::sequence;
use tui::geometry::*;
use tui::surface::*;
use tui::theme::*;
use tui::meter::VuMeter;
use tui_demo::sequence::SequenceTrack;
use tui_demo::sequence::SequenceTable;
use tui_demo::sequence::AudioInstance;
use tui_demo::audio_clip::WavePeak;
use tui::table::TableRow;
use tui::table::table_integer;
use std::strbuf::free;

pub struct MeterLevel { var left: i32; var right: i32; };
/// Meters are derived from sequenced notes and audio peaks, never synthetic.
pub struct Mixer { var visible: bool; var grainy: bool{true}; var levels: list<MeterLevel>; var master: MeterLevel; var instrument_levels: list<MeterLevel>; var effect_volumes: list<i32>; var effect_levels: list<MeterLevel>; var bus_focus: bool; var selected_effect: i32; };
impl Mixer {
    pub fn update_effects(self: &mut Self, output: AudioController, effects: &list<EffectChannel>, delta: i32) -> bool {
        var levels: list<MeterLevel> = []; var volumes: list<i32> = []; var changed: bool = self.effect_volumes.len() != effects.len();
        for i in 0..effects.len() {
            let effect: EffectChannel = effects[i]; var old: MeterLevel = MeterLevel {};
            if i < self.effect_levels.len() { old = self.effect_levels[i]; }
            let level: MeterLevel = MeterLevel { left: meter_ramp(old.left, output.effect_peak(i, 0), delta), right: meter_ramp(old.right, output.effect_peak(i, 1), delta) };
            if level.left != old.left || level.right != old.right { changed = true; }
            if i < self.effect_volumes.len() { if self.effect_volumes[i] != effect.volume { changed = true; } }
            levels.push(level); volumes.push(effect.volume);
        }
        self.effect_levels = levels; self.effect_volumes = volumes; return changed;
    }
    /// Consume each plugin's peaks once; shared track assignments reuse the cache.
    pub fn update_instruments(self: &mut Self, output: AudioController, delta: i32) -> bool {
        var next: list<MeterLevel> = []; var changed: bool = false;
        for i in 0..32 {
            var old: MeterLevel = MeterLevel {};
            if i < self.instrument_levels.len() { old = self.instrument_levels[i]; }
            let left: i32 = output.instrument_peak(i + 1, 0);
            let right: i32 = output.instrument_peak(i + 1, 1);
            var level: MeterLevel = MeterLevel {};
            if output.parameter_info(i + 1, 0, 0) >= 0.0 {
                level = MeterLevel { left: meter_ramp(old.left, left, delta), right: meter_ramp(old.right, right, delta) };
            }
            if level.left != old.left || level.right != old.right { changed = true; }
            next.push(level);
        }
        self.instrument_levels = next; return changed;
    }
    pub fn update_master(self: &mut Self, left: i32, right: i32, delta: i32) -> bool {
        let next: MeterLevel = MeterLevel { left: meter_ramp(self.master.left, left, delta), right: meter_ramp(self.master.right, right, delta) };
        let changed: bool = next.left != self.master.left || next.right != self.master.right;
        self.master = next; return changed;
    }
    pub fn update(self: &mut Self, source: &SequenceTable, row: i32, phase: i32, playing: bool, delta: i32) -> bool {
        var table: SequenceTable = SequenceTable {}; table = source;
        // Track edits already repaint layout; resizing silent meter state is
        // not an additional animation frame.
        var levels: list<MeterLevel> = []; var changed: bool = false;
        for i in 0..table.tracks.len() {
            let track: SequenceTrack = table.tracks[i];
            var left: i32 = 0; var right: i32 = 0;
            if playing && row >= 0 && row < table.rows.len() && !track.muted {
                if track.audio {
                    let hit: i32 = track.instance_at(row);
                    if hit >= 0 {
                        let instance: AudioInstance = track.instances[hit];
                        let peak: WavePeak = instance.clip.peaks[row - instance.start_row];
                        if wide(row - instance.start_row) * 15000 + wide(phase) < instance.duration() {
                            left = peak.left; right = peak.right;
                        }
                    }
                } else {
                    let first: i32 = table.track_start(i32(i));
                    for r in 0..table.rows.len() {
                        let data: TableRow = table.rows[r];
                        for line in 0..track.note_lines {
                            let column: i32 = first + i32(line) * 4;
                            if data.cells[column] == "" { continue; }
                            let age: i64 = wide(row - i32(r)) * 15000 + wide(phase) - table.note_offset(i32(r), column);
                            if age < 0 { continue; }
                            if age >= 15000 && (data.cells[column + 2] == "" || data.cells[column + 2] == "1.00") { continue; }
                            if data.cells[column] != "" {
                                let velocity: result<i64, str8> = table_integer(data.cells[column + 1]);
                                let decay: i64 = table.note_length(i32(r), column) * 3 / 5;
                                if velocity.is_ok() && age < decay {
                                    let value: i64 = velocity.unwrap();
                                    if value >= 0 && value <= 127 {
                                        let level: i32 = i32(value * 1000 / 127 * (decay - age) / decay);
                                        if level > left { left = level; }
                                    }
                                }
                            }
                        }
                    }
                    // Visual decay is separate from the exact LEN note-off gate.
                    right = left;
                }
            }
            var old: MeterLevel = MeterLevel {};
            if i < self.levels.len() { old = self.levels[i]; }
            let next: MeterLevel = MeterLevel { left: meter_ramp(old.left, left, delta), right: meter_ramp(old.right, right, delta) };
            if next.left != old.left || next.right != old.right { changed = true; }
            levels.push(next);
        }
        self.levels = levels; return changed;
    }
    pub fn level(self: Mixer, index: i32, volume: i32, pan: i32, right: bool, muted: bool) -> i32 {
        if muted { return 0; }
        if index < 0 || index >= self.levels.len() { return 0; }
        let level: MeterLevel = self.levels[index];
        let wave: i32 = right ? level.right : level.left;
        let gain: i32 = volume < 0 ? 0 : (volume > 100 ? 100 : volume);
        let p: i32 = pan < -100 ? -100 : (pan > 100 ? 100 : pan);
        let balance: i32 = right ? (p < 0 ? 100 + p : 100) : (p > 0 ? 100 - p : 100);
        return wave * gain / 100 * balance / 100;
    }
    pub fn paint(self: Mixer, surface: Surface, area: Rect, theme: Theme, tracks: &list<SequenceTrack>, selected: i32) -> void {
        surface.fill(area, Cell { glyph: 32, foreground: theme.foreground, background: theme.panel });
        if area.width <= 0 || area.height <= 0 { return; }
        let master_width: i32 = area.width < 6 ? area.width : 6;
        let remaining: i32 = area.width - master_width;
        let effect_width: i32 = i32(self.effect_volumes.len()) * 6 < remaining / 2 ? i32(self.effect_volumes.len()) * 6 : remaining / 2;
        let available: i32 = remaining - effect_width;
        var start: i32 = 0; var span: i32 = 0;
        for i in 0..tracks.len() {
            if i > selected { break; }
            let track: SequenceTrack = tracks[i]; span = span + (track.instrument ? 8 : 6);
        }
        while span > available && start < selected && start < tracks.len() {
            let track: SequenceTrack = tracks[start]; span = span - (track.instrument ? 8 : 6); start = start + 1;
        }
        var cursor: i32 = 0;
        for index in start..tracks.len() {
            if cursor >= available { break; }
            let track: SequenceTrack = tracks[index];
            let preferred: i32 = track.instrument ? 8 : 6;
            let width: i32 = available - cursor < preferred ? available - cursor : preferred;
            let x: i32 = area.x + cursor; cursor = cursor + width;
            let strip: Rect = Rect::new(x, area.y, width - (width > 1 ? 1 : 0), area.height);
            let bg: i32 = index == selected && !self.bus_focus ? lighten(theme.panel, 8) : theme.panel;
            surface.fill(strip, Cell { glyph: 32, foreground: theme.foreground, background: bg });
            let title: str8 = format!("{}{}", track.audio ? "A" : (track.instrument ? "I" : "M"), index + 1);
            surface.text(Rect::new(x, area.y, strip.width, 1), title, index == selected ? theme.accent : theme.foreground, bg);
            let pan: str8 = format!("P{}", track.pan);
            if strip.width > 3 && !track.audio {
                surface.text(Rect::new(x + strip.width - 1, area.y, 1, 1), "R", track.record_armed ? 0xFFFFFF : theme.muted, track.record_armed ? 0xC02030 : bg);
            }
            if area.height > 1 { surface.text(Rect::new(x, area.y + 1, strip.width, 1), track.muted ? "MUTED" : "VOL", theme.foreground, bg); }
            if area.height > 2 { surface.text(Rect::new(x, area.y + 2, strip.width, 1), pan, theme.muted, bg); }
            free(title); free(pan);
            if area.height > 3 && strip.width >= 4 {
                let fader: Slider = Slider { minimum: 0.0, maximum: 100.0, value: f64(track.volume), value_type: "i32" };
                var fader_theme: Theme = theme; fader_theme.panel = bg; fader_theme.selection = bg;
                fader.paint_vertical(surface, Rect::new(x, area.y + 3, 3, area.height - 3), fader_theme, index == selected);
                let left: VuMeter = VuMeter { level: self.level(index, track.volume, track.audio ? track.pan : 0, false, track.muted), grainy: self.grainy };
                let right: VuMeter = VuMeter { level: self.level(index, track.volume, track.pan, true, track.muted), grainy: self.grainy };
                let meter_x: i32 = x + 3;
                left.paint(surface, Rect::new(meter_x, area.y + 3, 1, area.height - 4), bg);
                if track.audio && strip.width >= 5 { right.paint(surface, Rect::new(meter_x + 1, area.y + 3, 1, area.height - 4), bg); }
                if track.instrument && strip.width >= 7 {
                    var pcm: MeterLevel = MeterLevel {};
                    if track.instrument_id > 0 && track.instrument_id <= self.instrument_levels.len() { pcm = self.instrument_levels[track.instrument_id - 1]; }
                    let pcm_left: VuMeter = VuMeter { level: pcm.left, grainy: self.grainy };
                    let pcm_right: VuMeter = VuMeter { level: pcm.right, grainy: self.grainy };
                    surface.text(Rect::new(x + 3, area.y + 2, 4, 1), "M LR", theme.muted, bg);
                    pcm_left.paint(surface, Rect::new(x + 5, area.y + 3, 1, area.height - 4), bg);
                    pcm_right.paint(surface, Rect::new(x + 6, area.y + 3, 1, area.height - 4), bg);
                }
            }
        }
        // Aux bank has its own scrolling window; normal tracks never move it.
        if effect_width > 0 {
            let width: i32 = effect_width < 6 ? effect_width : 6;
            let capacity: i32 = effect_width / width;
            let start: i32 = self.selected_effect >= capacity ? self.selected_effect - capacity + 1 : 0;
            for cell in 0..capacity {
                let index: i32 = start + i32(cell); if index >= self.effect_volumes.len() { break; }
                let x: i32 = area.x + available + i32(cell) * width;
                let bg: i32 = lighten(theme.panel, self.bus_focus && index == self.selected_effect ? 12 : 4);
                surface.fill(Rect::new(x, area.y, width, area.height), Cell { glyph: 32, foreground: theme.foreground, background: bg });
                let title: str8 = format!("FX{}", index + 1);
                surface.text(Rect::new(x, area.y, width, 1), title, theme.accent, bg); free(title);
                if area.height > 1 { surface.text(Rect::new(x, area.y + 1, width, 1), "AUX", theme.muted, bg); }
                if area.height > 3 && width >= 5 {
                    var fader_theme: Theme = theme; fader_theme.panel = bg; fader_theme.selection = bg;
                    let fader: Slider = Slider { minimum: 0.0, maximum: 100.0, value: f64(self.effect_volumes[index]), value_type: "i32" };
                    fader.paint_vertical(surface, Rect::new(x, area.y + 3, 3, area.height - 3), fader_theme, self.bus_focus && index == self.selected_effect);
                    var level: MeterLevel = MeterLevel {}; if index < self.effect_levels.len() { level = self.effect_levels[index]; }
                    let left: VuMeter = VuMeter { level: level.left, grainy: self.grainy }; let right: VuMeter = VuMeter { level: level.right, grainy: self.grainy };
                    surface.text(Rect::new(x + 3, area.y + 2, 2, 1), "LR", theme.muted, bg);
                    left.paint(surface, Rect::new(x + 3, area.y + 3, 1, area.height - 4), bg);
                    right.paint(surface, Rect::new(x + 4, area.y + 3, 1, area.height - 4), bg);
                }
            }
        }
        // Fixed to the right, independent of the horizontally scrolling tracks.
        let x: i32 = area.x + area.width - master_width;
        let bg: i32 = lighten(theme.panel, 4);
        surface.fill(Rect::new(x, area.y, master_width, area.height), Cell { glyph: 32, foreground: theme.foreground, background: bg });
        surface.text(Rect::new(x, area.y, master_width, 1), "Master", theme.accent, bg);
        if area.height > 1 { surface.text(Rect::new(x, area.y + 1, master_width, 1), "OUT", theme.foreground, bg); }
        if area.height > 2 { surface.text(Rect::new(x, area.y + 2, master_width, 1), "L R", theme.muted, bg); }
        if area.height > 3 {
            let left: VuMeter = VuMeter { level: self.master.left, grainy: self.grainy };
            let right: VuMeter = VuMeter { level: self.master.right, grainy: self.grainy };
            left.paint(surface, Rect::new(x, area.y + 3, 1, area.height - 3), bg);
            if master_width >= 3 { right.paint(surface, Rect::new(x + 2, area.y + 3, 1, area.height - 3), bg); }
        }
    }
}
/// Fast attack and release, bounded by the next target (no overshoot).
pub fn meter_ramp(current: i32, target: i32, delta: i32) -> i32 {
    if delta <= 0 { return current; }
    let next: i32 = target < 0 ? 0 : (target > 1000 ? 1000 : target);
    let diff: i32 = next - current;
    let distance: i32 = diff < 0 ? -diff : diff;
    let time: i32 = delta > 1000 ? 1000 : delta;
    let rate: i32 = diff > 0 ? 8 : 25;
    let step: i32 = (distance * time + rate + time - 1) / (rate + time);
    return diff > 0 ? current + step : current - step;
}
