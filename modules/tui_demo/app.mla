fn demo_menus(fixture: bool, follow_matrix: bool) -> MenuBar {
    // Grouped like a DAW's menu bar: each menu starts with what it creates,
    // then what it changes, then what it removes; families use submenus.
    let plugins: bool = AudioController::processor_support();
    return MenuBar::new([
                    Menu {title: "File", items: [
                                MenuItem { label: "New session", action: 1, enabled: true },
                                MenuItem { label: "Open session", action: 2, enabled: true },
                                MenuItem::submenu("Recent sessions", [
                                                MenuItem { label: "Blue hour", action: 8, enabled: true },
                                                MenuItem::submenu("Templates", [
                                                                MenuItem { label: "Ambient", action: 9, enabled: true },
                                                                MenuItem { label: "Dance", action: 10, enabled: true }
                                                        ])
                                        ]),
                                MenuItem { label: "Save session", action: 3, enabled: !fixture },
                                MenuItem { label: "Save session as", action: 96, enabled: !fixture },
                                MenuItem { label: "Settings", action: 90, enabled: true },
                                MenuItem { label: "Quit", action: 99, enabled: true }] },
                    Menu {title: "Edit", items: [
                                MenuItem { label: "Undo", action: 4, enabled: true },
                                MenuItem { label: "Redo", action: 5, enabled: true },
                                MenuItem { label: "Copy clip", action: 61, enabled: true },
                                MenuItem { label: "Cut clip", action: 62, enabled: true },
                                MenuItem { label: "Paste clip", action: 63, enabled: true }] },
                    Menu {title: "View", items: [
                                MenuItem { label: "Patterns", action: 42, enabled: true },
                                MenuItem { label: "Song matrix", action: 43, enabled: true },
                                MenuItem { label: "Audio", action: 44, enabled: true },
                                MenuItem { label: "Instruments", action: 45, enabled: plugins },
                                MenuItem::submenu("Sample view", [
                                                MenuItem { label: "Normal", action: 70, enabled: true },
                                                MenuItem { label: "Grainy", action: 71, enabled: true },
                                                MenuItem::submenu("Type", [
                                                                MenuItem { label: "Filled blocks", action: 72, enabled: true },
                                                                MenuItem { label: "Wave (osc)", action: 73, enabled: true }])]),
                                MenuItem::submenu("Meter", [
                                                MenuItem { label: "Solid bars", action: 40, enabled: true },
                                                MenuItem { label: "Grainy (osc)", action: 41, enabled: true },
                                                MenuItem { label: "Set update rate", action: 74, enabled: true }]),
                                MenuItem { label: "Reset layout", action: 6, enabled: true },
                                MenuItem { label: "Show details", action: 7, enabled: true }] },
                    Menu {title: "Track", items: [
                                // Plain entries, not a submenu: a submenu as the first
                                // item would swallow the Right key that walks the menu bar.
                                MenuItem { label: "Create MIDI track", action: 21, enabled: true },
                                MenuItem { label: "Create AUDIO track", action: 28, enabled: true },
                                MenuItem { label: "Create Instrument track", action: 29, enabled: plugins },
                                MenuItem { label: "Rename", action: 20, enabled: true },
                                MenuItem { label: "Duplicate", action: 23, enabled: true },
                                MenuItem { label: "Mute / unmute", action: 25, enabled: true },
                                MenuItem { label: "Set output channel", action: 30, enabled: true },
                                MenuItem::submenu("Note lines", [
                                                MenuItem { label: "Add note line", action: 80, enabled: true },
                                                MenuItem { label: "Duplicate note line", action: 82, enabled: true },
                                                MenuItem { label: "Remove note line", action: 81, enabled: true },
                                                MenuItem { label: "Collapse all", action: 83, enabled: true },
                                                MenuItem { label: "Expand all", action: 84, enabled: true }]),
                                MenuItem::submenu("Automation", [
                                                MenuItem { label: "Configure CC1", action: 26, enabled: true },
                                                MenuItem { label: "Configure CC2", action: 27, enabled: true }]),
                                MenuItem { label: "Clear pattern", action: 24, enabled: true },
                                MenuItem { label: "Delete", action: 22, enabled: true }] },
                    Menu {title: "Pattern", items: [
                                MenuItem { label: "Add pattern", action: 50, enabled: true },
                                MenuItem { label: "Clone pattern", action: 53, enabled: true },
                                MenuItem { label: "Rename pattern", action: 51, enabled: true },
                                MenuItem { label: "Set length", action: 54, enabled: true },
                                MenuItem { label: follow_matrix ? "[x] Follow matrix patterns" : "[ ] Follow matrix patterns",
                                    action: 55, enabled: true },
                                MenuItem { label: "Set matrix row length", action: 56, enabled: true },
                                MenuItem { label: "Remove pattern", action: 52, enabled: true },
                                MenuItem { label: "Save pattern", action: 57, enabled: true },
                                MenuItem { label: "Load pattern", action: 58, enabled: true }] },
                    Menu {title: "Audio", items: [
                                MenuItem { label: "Add audio", action: 60, enabled: true },
                                MenuItem { label: "Edit sample (destructive)", action: 107, enabled: true },
                                MenuItem::submenu("Clip", [
                                                MenuItem { label: "Move clip up", action: 103, enabled: true },
                                                MenuItem { label: "Move clip down", action: 104, enabled: true },
                                                MenuItem { label: "Trim to selection", action: 105, enabled: true },
                                                MenuItem { label: "Slice selection", action: 106, enabled: true },
                                                MenuItem { label: "Reverse clip", action: 102, enabled: true }]),
                                MenuItem { label: "Remove audio", action: 120, enabled: true }] },
                    Menu {title: "Instrument", items: [
                                MenuItem { label: "Add instrument", action: 93, enabled: plugins },
                                MenuItem { label: "Open VST3 editor", action: 94, enabled: plugins },
                                MenuItem::submenu("Drum pads", [
                                                MenuItem { label: "Send audio sample to pad", action: 117, enabled: plugins },
                                                MenuItem { label: "Load pad sample from file", action: 118, enabled: plugins }]),
                                MenuItem::submenu("Presets", [
                                                MenuItem { label: "Save plugin preset", action: 100, enabled: plugins },
                                                MenuItem { label: "Load plugin preset", action: 101, enabled: plugins }]),
                                MenuItem::submenu("MIDI learn", [
                                                MenuItem { label: "Save MIDI learn", action: 97, enabled: plugins },
                                                MenuItem { label: "Load MIDI learn", action: 98, enabled: plugins }]),
                                MenuItem { label: "Remove instrument", action: 95, enabled: plugins }] },
                    Menu {title: "Effect", items: [
                                MenuItem { label: "Add effect channel", action: 110, enabled: plugins },
                                MenuItem { label: "Load effect plugin", action: 111, enabled: plugins },
                                MenuItem { label: "Edit effect plugin", action: 112, enabled: plugins },
                                MenuItem { label: "Set track send", action: 113, enabled: plugins },
                                MenuItem::submenu("Master", [
                                                MenuItem { label: "Load master VST3", action: 91, enabled: plugins },
                                                MenuItem { label: "Unload master VST3", action: 92, enabled: plugins }]),
                                MenuItem { label: "Remove effect plugin", action: 114, enabled: plugins },
                                MenuItem::submenu("Presets", [
                                                MenuItem { label: "Load plugin preset", action: 140, enabled: plugins },
                                                MenuItem { label: "Save plugin preset", action: 141, enabled: plugins }])] }
            ]);
}

fn demo_panes(content: Rect) -> list<Pane> {
    let vertical: Layout = Layout {axis: Axis::Vertical, gap: 0,
        sizes: [Size::flex(1), Size::fixed(1)]};
    let rows: list<Rect> = vertical.split(content);
    let horizontal: Layout = Layout {axis: Axis::Horizontal, gap: 1,
        sizes: [Size::fixed(22), Size::flex(1)]};
    let columns: list<Rect> = horizontal.split(rows[0]);
    let right_layout: Layout = Layout {axis: Axis::Vertical, gap: 1,
        sizes: [Size::flex(2), Size::flex(1)]};
    let right: list<Rect> = right_layout.split(columns[1]);
    return [Pane { id: 0, bounds: columns[0] }, Pane { id: 1, bounds: right[0] },
            Pane { id: 2, bounds: right[1] }];
}

fn paint_demo(surface: Surface, menus: &MenuBar, focus: PaneFocus, panes: &list<Pane>, message: str8, table: &SequenceTable, mixer: &Mixer, patterns: &PatternLibrary, transport: TransportStatus, sample: SampleView, matrix_visible: bool, channels: &SequenceTable, merged_channels: bool) -> void {
    let theme: Theme = Theme::dark_blue();
    surface.fill(surface.bounds(), Cell { glyph: 32, foreground: theme.foreground, background: theme.background });
    let library: Pane = panes[0];
    let editor: Pane = panes[1];
    let inspector: Pane = panes[2];
    let sidebar: Panel = Panel { title: patterns.instruments_mode ? " Instruments " : (patterns.audio_mode ? " Audio " : " Patterns ") };
    let left: Rect = sidebar.paint_focused(surface, library.bounds, theme, focus.is_active(0));
    if patterns.instruments_mode { patterns.instruments.paint(surface, left, theme); }
    else if patterns.audio_mode { patterns.audio.view.paint(surface, left, theme); }
    else { patterns.view.paint(surface, left, theme); }
    // The song matrix takes over this pane; the caller paints it right after,
    // still below the menu bar.
    if !matrix_visible {
        let title: str8 = format!(" Pattern / {} {} ", patterns.active_id, patterns.active_name());
        let sequence: Panel = Panel { title: title };
        let top: Rect = sequence.paint_focused(surface, editor.bounds, theme, focus.is_active(1));
        free(title);
        table.paint(surface, top, theme);
        table.paint_audio_style(surface, top, theme, sample.grainy, sample.wave);
        table.paint_note_lengths(surface, top, theme);
        table.paint_editor(surface, top, theme);
    }
    let show_sample: bool = sample.visible && table.audio_under_cursor();
    var sample_title: str8 = "";
    if show_sample {
        let track: SequenceTrack = table.tracks[table.active_track()];
        let instance: AudioInstance = track.instances[track.instance_at(table.selected_row)];
        let name: str8 = base_name(instance.clip.source); sample_title = format!(" Sample: {} ", name); free(name);
    }
    let details: Panel = Panel { title: show_sample ? sample_title : (mixer.visible ? " Mixer " : " Inspector ") };
    let bottom: Rect = details.paint_focused(surface, inspector.bounds, theme, focus.is_active(2));
    let label: Label = Label { text: patterns.error != "" ? patterns.error : (table.error != "" ? table.error : (table.editing ? "Editing: Enter saves | Esc cancels": message)) };
    if show_sample {
        let track: SequenceTrack = table.tracks[table.active_track()];
        let instance: AudioInstance = track.instances[track.instance_at(table.selected_row)];
        let render_clip: AudioClip = instance.render_clip();
        sample.paint_at(surface, bottom, theme, render_clip, table.selected_row - instance.start_row, transport.playing ? transport.phase : 0);
        if(patterns.error != "" || table.error != "") && bottom.height > 0 {
            surface.text(Rect::new(bottom.x, bottom.y + bottom.height - 1, bottom.width, 1), patterns.error != "" ? patterns.error : table.error, theme.accent, theme.panel);
        }
    }
    else if mixer.visible {
        let mix_area: Rect = Rect::new(bottom.x, bottom.y, bottom.width, bottom.height - (mixer.effect_volumes.len() > 0 && bottom.height > 1 ? 1 : 0));
        if merged_channels { mixer.paint(surface, mix_area, theme, channels.tracks, channels.active_track()); }
        else { mixer.paint(surface, mix_area, theme, table.tracks, table.active_track()); }
        if mixer.effect_volumes.len() > 0 && bottom.height > 1 { surface.text(Rect::new(bottom.x, bottom.y + bottom.height - 1, bottom.width, 1), message, theme.muted, theme.panel); }
        if(patterns.error != "" || table.error != "") && bottom.height > 0 {
            surface.text(Rect::new(bottom.x, bottom.y + bottom.height - 1, bottom.width, 1), patterns.error != "" ? patterns.error : table.error, theme.accent, theme.panel);
        }
    }
    else { label.paint(surface, bottom, theme); table.paint_track_details(surface, bottom, theme); }
    if show_sample { free(sample_title); }
    transport.paint(surface, Rect::new(0, surface.height - 1, surface.width, 1), theme);
}

pub fn run() -> i32 {
    let fixture_env: str8 = __env_get_var("MLANG_TUI_DEMO");
    let fixture: bool = fixture_env == "1" || !AudioController::processor_support(); free(fixture_env);
    var terminal: Terminal = Terminal::begin();
    // Browsing or playing the matrix shows that pattern: editor, sidebar and
    // the mixer's channels. Pattern > Follow matrix patterns turns it off.
    var follow_matrix: bool = true;
    // Channels of the playing song row, one strip per channel even when
    // parallel patterns share it. Only the mixer reads it.
    var mixer_table: SequenceTable = SequenceTable {};
    var menus: MenuBar = demo_menus(fixture, follow_matrix);
    if fixture { menus.open(0); }
    var focus: PaneFocus = PaneFocus::new(0);
    var input: InputDecoder = InputDecoder::new();
    var dialog: OpenSessionDialog = OpenSessionDialog::new();
    var adding_audio: bool = false;
    var adding_plugin: bool = false;
    var adding_instrument: bool = false;
    var adding_effect: i32 = -1; var send_track: i32 = -1; var send_fx: i32 = -1;
    var adding_insert_track: i32 = -1; var adding_insert_position: i32 = 0;
    var library: PatternLibrary = fixture ? PatternLibrary::new() : PatternLibrary::empty();
    var session_path: str8 = clone(""); var request_path: str8 = clone("");
    var session_request: i32 = 0; var saving_session: bool = false;
    var pattern_action: i32 = 0; var last_pattern_dir: str8 = clone("");
    var learn_action: i32 = 0; var learn_slot: i64 = 0;
    // Sampler pads: 117 = from the Audio list, 118 = from a file.
    var pad_action: i32 = 0; var pad_slot: i32 = 0; var pad_sample: i32 = -1; var pad_index: i32 = 0;
    var adding_pad_file: bool = false;
    var accept_pending: bool = false;
    var transport_request: bool = false;
    var preset_request: i32 = 0; var preset_path: str8 = clone(""); var preset_worker: bool = false;
    // Last directory browsed per kind, so each chooser reopens where it was.
    var last_session_dir: str8 = clone(""); var last_audio_dir: str8 = clone("");
    var last_plugin_dir: str8 = clone("/Library/Audio/Plug-Ins/VST3"); var last_preset_dir: str8 = clone("");
    var piano: PianoDialog = PianoDialog::new();
    var sample_editor: SampleEditor = SampleEditor {};
    if !fixture {
        let arguments: list<str8> = __env_args();
        if arguments.len() == 2 { free(request_path); request_path = clone(arguments[1]); session_request = 1; }
    }
    var transport: TransportStatus = TransportStatus {};
    var bpm_dialog: BpmDialog = BpmDialog::new();
    var settings: SettingsDialog = SettingsDialog::new();
    var instrument_editor: InstrumentEditor = InstrumentEditor {};
    var note_playback: NotePlayback = NotePlayback {};
    var pending_length: i32 = 0;
    var length_target: i32 = 0;
    var mixer: Mixer = Mixer { visible: false };
    var sample: SampleView = SampleView {};
    var last_tick: i64 = now_ms(); var ui_clock: i64 = last_tick;
    var frame_rate: FrameRate = FrameRate {};
    var playback_dirty: bool = false; var play_pattern: i32 = library.active_id;
    var question: QuestionDialog = QuestionDialog::new("New session", "Start a new session?");
    var paste_error: QuestionDialog = QuestionDialog::new("Cannot paste selection", "");
    // Share an instrument instance, or give the track its own new instance.
    var share_question: QuestionDialog = QuestionDialog::new("Instrument already in use", "");
    share_question.width = 72; share_question.height = 12;
    share_question.buttons = [PushButton { label: "New instance", action: 1 }, PushButton { label: "Share", action: 3 }];
    var share_id: i32 = 0;
    // Removing a library item that is still used asks what to do with its uses.
    var remove_question: QuestionDialog = QuestionDialog::new("Remove", "");
    remove_question.width = 72; remove_question.height = 12;
    var remove_request: i32 = 0; var remove_target: i32 = 0; var remove_pending: i32 = 0;
    // Song matrix (Shift+M) and the warning shown when parallel patterns would
    // drive one instrument with the same notes.
    var matrix: SongMatrix = SongMatrix {};
    var clash_question: QuestionDialog = QuestionDialog::new("Parallel patterns clash", "");
    clash_question.width = 74; clash_question.height = 12;
    clash_question.buttons = [PushButton { label: "OK", action: 1 }, PushButton { label: "Cancel", action: 2 },
        PushButton { label: "Split", action: 3 }];
    var clash_row: i32 = 0; var clash_lane: i32 = 0; var clash_id: i32 = 0;
    var picker: PatternPicker = PatternPicker::new();
    // Output channel of the selected mixer strip (Track > Set output channel).
    // kind 1 = the instrument a MIDI track plays, 2 = the audio channel this
    // track feeds.
    var outputs: OutputPicker = OutputPicker::new();
    var output_kind: i32 = 0; var output_track: i32 = -1;
    // Matrix playback: the merged table of the playing row, and which row it is.
    var song_playing: bool = false; var song_row: i32 = -1;
    var song_table: SequenceTable = SequenceTable {};
    var song_request: i32 = 0;
    paste_error.buttons = [PushButton { label: "OK", action: 1 }];
    var message: str8 = clone("Select a command from the menu.");
    if AudioController::processor_support() { free(message); message = clone("mlacker | Add > VST3 master plugin to load an instrument or effect."); }
    var running: bool = true;
    var dirty: bool = true;
    var previous_width: i32 = 0;
    var previous_height: i32 = 0;
    var escape_ticks: i32 = 0;
    var confirm_track_action: i32 = 0;
    var last_processor_errors: i64 = 0;
    var prev_sample_row: i32 = -1;
    let no_hardware: str8 = __env_get_var("MLANG_TUI_NO_HARDWARE");
    var midi: AudioSystem = AudioSystem::start(terminal.active && no_hardware != "1");
    free(no_hardware);
    var master_meter_clock: i64 = now_ms();
    while running {
        if session_request != 0 {
            var session_status: str8 = "";
            transport.playing = false;
            note_playback.update(library.table, transport.ticks, false); midi.sequencer_events(note_playback.events);
            if session_request == 2 {
                let view: SessionView = SessionView { bpm: transport.bpm, beats: transport.beats_per_bar, unit: transport.beat_unit,
                    row: transport.row < 0 ? 0 : transport.row, phase: transport.phase, pane: focus.selected,
                    sidebar: library.instruments_mode ? 3 : (library.audio_mode ? 2 : 0),
                    list_selected: library.view.selected, list_scroll: library.view.scroll,
                    audio_selected: library.audio.view.selected, audio_scroll: library.audio.view.scroll,
                    instrument_selected: library.instruments.selected, instrument_scroll: library.instruments.scroll,
                    mixer: mixer.visible, meter_grainy: mixer.grainy, meter_fps: frame_rate.fps, effect_focus: mixer.bus_focus, effect_selected: mixer.selected_effect,
                    sample: sample.visible, sample_grainy: sample.grainy, sample_wave: sample.wave, sample_zoom: sample.zoom,
                    editor: instrument_editor.active, editor_slot: i32(instrument_editor.slot), editor_selected: instrument_editor.selected, editor_scroll: instrument_editor.scroll };
                var serializer: SessionCodec = SessionCodec {};
                let saved: bool = serializer.save(request_path, library, view, midi);
                if saved { free(session_path); session_path = clone(request_path); session_status = format!("Saved: {}", session_path); }
                else { session_status = clone("Save failed: invalid state, size limit or unwritable path. Original file retained."); }
            } else {
                var result: result<SessionData, str8> = session_request == 3 ? Ok<SessionData, str8>(SessionData { library: PatternLibrary::empty(), view: SessionView {} }) : SessionCodec::load(request_path);
                if result.is_err() { session_status = clone(result.unwrap_err()); }
                else {
                    var data: SessionData = result.unwrap();
                    let prepared: result<AudioSystem, str8> = data.prepare_audio(midi);
                    if prepared.is_err() { session_status = clone(prepared.unwrap_err()); data.release(); }
                    else {
                        var next: AudioSystem = prepared.unwrap();
                        let worker: bool = midi.midi.worker.raw != 0;
                        let hardware: bool = midi.output.hardware_output();
                        var accepted: bool = midi.output.handle == 0 || midi.output.stop() == 0;
                        if accepted && next.output.hardware_output() { accepted = next.output.start() == 0; }
                        if !accepted {
                            if hardware { midi.output.start(); }
                            next.release(); data.release(); session_status = clone("Cannot switch audio output; previous session retained");
                        } else {
                            midi.adopt(next);
                            if worker { midi.midi = MidiController::start_selected(midi.midi_id, midi.output.handle); }
                            library.adopt(data.library); data.release_plugins();
                            for i in 0..midi.instrument_paths.len() {
                                if midi.instrument_paths[i] != "" {
                                    library.name_instrument(i32(i) + 1, midi.output.instrument_name(i + 1));
                                }
                            }
                            let v: SessionView = data.view;
                            transport = TransportStatus { bpm: v.bpm, beats_per_bar: v.beats, beat_unit: v.unit, row: v.row, phase: v.phase,
                                ticks: wide(v.row) * 15000 + v.phase, elapsed_ms: i32((wide(v.row) * 15000 + v.phase) / wide(v.bpm)) };
                            focus.selected = v.pane;
                            mixer = Mixer { visible: v.mixer, grainy: v.meter_grainy, bus_focus: v.effect_focus, selected_effect: v.effect_selected };
                            mixer.update_effects(midi.output, midi.effects, 0);
                            sample = SampleView { visible: v.sample, grainy: v.sample_grainy, wave: v.sample_wave, zoom: v.sample_zoom };
                            frame_rate.set(v.meter_fps, now_ms()); note_playback = NotePlayback {}; play_pattern = library.active_id;
                            instrument_editor.release();
                            instrument_editor.slot = v.editor_slot;
                            instrument_editor.selected = v.editor_selected;
                            instrument_editor.scroll = v.editor_scroll;
                            if v.editor {
                                if instrument_editor.open(midi.output, v.editor_slot) {
                                    if v.editor_selected < instrument_editor.sliders.len() { instrument_editor.selected = v.editor_selected; }
                                    instrument_editor.scroll = v.editor_scroll;
                                }
                            }
                            free(session_path); session_path = session_request == 3 ? clone("") : clone(request_path);
                            session_status = session_request == 3 ? clone("New empty session") : format!("Opened: {}", session_path);
                        }
                    }
                }
            }
            free(message); message = clone(session_status); free(session_status);
            session_request = 0; menus.dismiss(); dirty = true;
        }
        if remove_request != 0 {
            // 1 = sample (with its clips), 2 = instrument and its tracks,
            // 3 = instrument only, leaving the tracks for another plugin.
            let kind: i32 = remove_request; remove_request = 0;
            let area: Rect = terminal_bounds();
            free(message);
            if kind == 1 {
                let cleared: i32 = midi.drop_sample_pads(remove_target);
                let clips: i32 = library.remove_sample(remove_target, area);
                message = clips < 0 ? clone("Select a sample in Audio first")
                    : format!("Removed sample {}: {} clip(s), {} drum pad(s) cleared", remove_target + 1, clips, cleared);
                playback_dirty = true;
            } else {
                let uses: i32 = library.instrument_usage(remove_target);
                var tracks: i32 = 0;
