                    midi.output.midi_learn(-1, 0, 0);
                    if command == 101 { transport.playing = false; }
                    dialog.save_mode = command == 97 || command == 100; dialog.bundle_pattern = ""; dialog.multi_select = false;
                    dialog.title = command == 97 ? "Save MIDI learn (.mlalearn)" : "Load MIDI learn (.mlalearn)";
                    dialog.file_pattern = command == 97 ? "" : ".*\\.[mM][lL][aA][lL][eE][aA][rR][nN]";
                    if command >= 100 {
                        dialog.title = command == 100 ? "Save plugin preset (.mlapre)" : "Load plugin preset (.mlapre)";
                        dialog.file_pattern = command == 100 ? "" : ".*\\.[mM][lL][aA][pP][rR][eE]";
                    }
                    dialog.open(last_preset_dir);
                    if command == 97 || command == 100 {
                        let suggested: str8 = SessionCodec::learn_suggestion(learn_slot == 0 ? midi.output.processor_name() : midi.output.instrument_name(learn_slot));
                        dialog.path_field.set_text(suggested); free(suggested);
                    }
                    focus.set_menu_active(true);
                }
            }
            else if command == 140 || command == 141 {
                learn_slot = -1;
                if instrument_editor.active && (instrument_editor.slot == 0 || instrument_editor.slot >= 33) { learn_slot = instrument_editor.slot; }
                else if focus.selected == 1 && library.table.group_detail_rows > 0 {
                    let index: i32 = library.table.active_track();
                    if index >= 0 {
                        let track: SequenceTrack = library.table.tracks[index];
                        let id: i32 = track.insert_id(library.table.selected_group_detail);
                        if id > 0 { learn_slot = id + 40; }
                    }
                } else if mixer.selected_effect >= 0 && mixer.selected_effect < midi.effects.len() { learn_slot = mixer.selected_effect + 33; }
                if learn_slot < 0 || midi.output.parameter_info(learn_slot, 0, 0) < 0.0 {
                    free(message); message = clone("Select a loaded effect in Mixer or open its editor first");
                } else {
                    learn_action = command; adding_effect = -1; adding_audio = false; adding_plugin = false; adding_instrument = false; saving_session = false;
                    midi.output.midi_learn(-1, 0, 0);
                    if command == 140 { transport.playing = false; }
                    dialog.save_mode = command == 141; dialog.bundle_pattern = ""; dialog.multi_select = false;
                    dialog.title = command == 141 ? "Save plugin preset (.mlafxpre)" : "Load plugin preset (.mlafxpre)";
                    dialog.file_pattern = command == 141 ? "" : ".*\\.[mM][lL][aA][fF][xX][pP][rR][eE]";
                    dialog.open(last_preset_dir);
                    if command == 141 {
                        let suggested: str8 = SessionCodec::learn_suggestion(learn_slot == 0 ? midi.output.processor_name() : midi.output.instrument_name(learn_slot));
                        dialog.path_field.set_text(suggested); free(suggested);
                    }
                    focus.set_menu_active(true);
                }
            }
            else if command == 110 {
                if midi.add_effect() {
                    mixer.visible = true; sample.visible = false; focus.selected = 2; mixer.bus_focus = true; mixer.selected_effect = i32(midi.effects.len()) - 1;
                    mixer.update_effects(midi.output, midi.effects, 0);
                    free(message); message = clone("Effect channel added. Enter loads plugin; Effect > Set track send routes the selected track.");
                } else { free(message); message = clone("Maximum 8 effect channels"); }
            }
            else if command == 115 || command == 116 || (command == 112 && focus.selected == 1 && library.table.group_detail_rows > 0) {
                let index: i32 = library.table.active_track();
                if index >= 0 {
                    let track: SequenceTrack = library.table.tracks[index];
                    let position: i32 = library.table.selected_group_detail;
                    let id: i32 = track.insert_id(position);
                    if command == 116 { library.table.set_insert(index, position, 0); }
                    else if id > 0 { instrument_editor.open(midi.output, id + 40); }
                    else if command == 112 { free(message); message = clone("Select a loaded insert effect first"); }
                    else {
                        adding_insert_track = index; adding_insert_position = position;
                        adding_effect = -1; learn_action = 0; adding_audio = false; adding_plugin = false; adding_instrument = false; saving_session = false;
                        transport.playing = false; dialog.save_mode = false; dialog.multi_select = false; dialog.title = "Load VST3 insert effect";
                        dialog.file_pattern = ".*\\.[vV][sS][tT]3"; dialog.bundle_pattern = dialog.file_pattern;
                        dialog.open(last_plugin_dir); focus.set_menu_active(true);
                    }
                }
            }
            else if command >= 111 && command <= 114 {
                if mixer.selected_effect < 0 || mixer.selected_effect >= midi.effects.len() { free(message); message = clone("Add/select an effect channel in Mixer first"); }
                else if command == 111 {
                    adding_effect = mixer.selected_effect; learn_action = 0; adding_audio = false; adding_plugin = false; adding_instrument = false; saving_session = false;
                    transport.playing = false; dialog.save_mode = false; dialog.multi_select = false; dialog.title = "Load VST3 effect";
                    dialog.file_pattern = ".*\\.[vV][sS][tT]3"; dialog.bundle_pattern = dialog.file_pattern;
                    dialog.open(last_plugin_dir); focus.set_menu_active(true);
                } else if command == 112 {
                    if !instrument_editor.open(midi.output, mixer.selected_effect + 33) { free(message); message = clone("Load an effect plugin first"); }
                } else if command == 114 { free(message); message = midi.load_effect(mixer.selected_effect, ""); }
                else {
                    send_track = library.table.active_track(); send_fx = mixer.selected_effect;
                    if send_track >= 0 { let track: SequenceTrack = library.table.tracks[send_track]; bpm_dialog.open_send(track.send_level(send_fx)); }
                    else { free(message); message = clone("Select a source track in Pattern view first"); }
                }
            }
            else if command == 117 || command == 118 {
                // The selected Instrument track decides which instance gets the
                // pad; the Instruments list is the fallback for other tracks.
                let track_slot: i32 = library.table.active_instrument();
                let slot: i32 = track_slot > 0 ? track_slot : library.selected_instrument();
                let selected: i32 = library.audio.view.selected;
                let root: i64 = slot < 1 ? -1 : midi.output.instrument_sampler(slot, 0);
                if root < 0 {
                    free(message); message = clone("Select a loaded sampler instrument (e.g. Mla Drum) in Instruments first");
                } else if command == 117 && (selected < 0 || selected >= library.audio.samples.len()) {
                    free(message); message = clone("Select a sample in Audio first (View > Audio)");
                } else {
                    pad_action = command; pad_slot = slot; pad_sample = selected;
                    let pads: i64 = midi.output.instrument_sampler(slot, 1);
                    var names: list<str8> = [];
                    for p in 0..pads {
                        let used: i32 = midi.pad_sample(slot, i32(p));
                        if used >= 0 && used < library.audio.samples.len() { let clip: AudioClip = library.audio.samples[used]; names.push(base_name(clip.source)); }
                        else { names.push(clone("")); }
                    }
                    let title: str8 = format!("{} | {} #{}", command == 117 ? "Send sample to drum key" : "Load drum key from file", midi.output.instrument_name(slot), slot);
                    piano.open(title, i32(root), i32(pads),
                        midi.output.instrument_sampler(slot, 2), names, command == 117 ? "inserts the Audio sample" : "picks a file");
                    focus.set_menu_active(true);
                }
            }
            else if command == 119 {
                pad_index = piano.pad();
                if piano.result == 3 {
                    let error: str8 = midi.clear_pad(pad_slot, pad_index);
                    free(message); message = error == "" ? format!("Pad {} cleared", pad_index + 1) : error;
                } else if pad_action == 117 {
                    let clip: AudioClip = library.audio.samples[pad_sample];
                    let name: str8 = base_name(clip.source);
                    let error: str8 = midi.assign_pad(pad_slot, pad_index, pad_sample, clip.samples, clip.channels, clip.sample_rate, name);
                    free(message);
                    message = error == "" ? format!("Pad {}: {}", pad_index + 1, name) : error;
                    free(name);
                } else {
                    adding_effect = -1; learn_action = 0; adding_audio = false; adding_plugin = false; adding_instrument = false; saving_session = false;
                    adding_pad_file = true; dialog.save_mode = false; dialog.bundle_pattern = ""; dialog.multi_select = true;
                    dialog.title = format!("Load sample for pad {}", pad_index + 1);
                    dialog.file_pattern = ".*\\.([wW][aA][vV]|[aA][iI][fF]([fF])?)";
                    dialog.open(last_audio_dir); focus.set_menu_active(true);
                }
            }
            else if command == 107 {
                let index: i32 = library.audio.view.selected;
                if index < 0 || index >= library.audio.samples.len() { free(message); message = clone("Select a sample in Audio first (View > Audio)"); }
                else {
                    transport.playing = false;
                    let clip: AudioClip = library.audio.samples[index];
                    sample_editor.open(clip, index);
                    free(message); message = clone("Editing a copy: Enter saves to the session and drum pads, Esc discards");
                }
            }
            else if command == 94 {
                if !instrument_editor.open(midi.output, library.selected_instrument()) {
                    free(message); message = clone("Select a loaded instrument in Instruments first");
                }
            }
            else if command == 121 || command == 122 {
                let id: i32 = command == 122 ? matrix.clipboard : picker.chosen();
                if id <= 0 { free(message); message = clone("Select a pattern in the sidebar first (View > Patterns)"); }
                else {
                    let blocked: i32 = library.song_placement_blocked(matrix.row, matrix.lane, id);
                    let clashes: i32 = library.song_row_clashes(matrix.row, matrix.lane, id);
                    if blocked != 0 {
                        free(message);
                        message = blocked < 0
                            ? format!("Row {} already plays a pattern that started above it", matrix.row + 1)
                            : format!("Pattern {} needs {} matrix rows and pattern {} is in the way", id, library.song_span(id), blocked);
                    }
                    else if clashes == 0 {
                        free(message);
                        message = library.set_song_at(matrix.row, matrix.lane, id)
                            ? format!("Row {} lane {}: pattern {}", matrix.row + 1, matrix.lane + 1, id)
                            : clone("Cannot place the pattern here");
                    } else {
                        clash_row = matrix.row; clash_lane = matrix.lane; clash_id = id;
                        clash_question.title = format!("{} note(s) clash in row {}", clashes, matrix.row + 1);
                        clash_question.question = clone("Same instrument and note as a parallel pattern. Split gives it its own note line.");
                        clash_question.open(); focus.set_menu_active(true); dirty = true;
                    }
                }
            }
            else if command == 120 {
                let index: i32 = library.audio.view.selected;
                let uses: i32 = library.sample_usage(index);
                if index < 0 || index >= library.audio.samples.len() { free(message); message = clone("Select a sample in Audio first (View > Audio)"); }
                else if uses == 0 { remove_target = index; remove_request = 1; }
                else {
                    let clip: AudioClip = library.audio.samples[index];
                    let name: str8 = base_name(clip.source);
                    remove_target = index; remove_pending = 1;
                    remove_question.title = format!("Remove sample {}: {}", index + 1, name);
                    remove_question.question = format!("{} clip(s) in the song use it. Remove them too?", uses);
                    remove_question.buttons = [PushButton { label: "Remove clips", action: 1 }, PushButton { label: "Cancel", action: 2 }];
                    remove_question.open(); focus.set_menu_active(true);
                    free(name);
                }
            }
            else if command == 95 {
                let id: i32 = library.selected_instrument();
                let uses: i32 = library.instrument_usage(id);
                if id < 1 { free(message); message = clone("Select a loaded instrument in Instruments first"); }
                else if uses == 0 { remove_target = id; remove_request = 3; }
                else {
                    let name: str8 = midi.output.instrument_name(id);
                    remove_target = id; remove_pending = 2;
                    remove_question.title = format!("Remove {} #{}", name, id);
                    remove_question.question = format!("{} track(s) play it. Remove those tracks, or keep their notes?", uses);
                    remove_question.buttons = [PushButton { label: "Remove tracks", action: 1 }, PushButton { label: "Keep tracks", action: 3 }];
                    remove_question.open(); focus.set_menu_active(true);
                }
            }
            else if command == 92 {
                transport.playing = false; free(message); message = midi.set_processor("");
            }
            else if command == 30 {
                // A MIDI track chooses the instrument it plays; an audio or
                // instrument track chooses the channel it feeds.
                let index: i32 = library.table.active_track();
                if index < 0 { free(message); message = clone("Select a track first"); }
                else {
                    let track: SequenceTrack = library.table.tracks[index];
                    var ids: list<i32> = [0]; var labels: list<str8> = [];
                    output_track = index; output_kind = track.audio || track.instrument ? 2 : 1;
                    var current: i32 = 0;
                    if output_kind == 1 {
                        labels.push(clone("  MST  master (preview tone)"));
                        for i in 0..midi.instrument_paths.len() {
                            if midi.instrument_paths[i] == "" { continue; }
                            // instrument_name borrows the plugin's own name; never free it.
                            let name: str8 = midi.output.instrument_name(i + 1);
                            ids.push(i32(i) + 1); labels.push(format!("  I{}   {}", i + 1, name));
                        }
                    } else {
                        labels.push(clone("  MST  master"));
                        current = library.table.track_output(index);
                        let channels: list<SequenceTrack> = library.table.tracks;
                        for t in 0..channels.len() {
                            let other: SequenceTrack = channels[t];
                            if !other.audio || i32(t) == index || library.table.output_loops(index, i32(t) + 1) { continue; }
                            ids.push(i32(t) + 1); labels.push(format!("  A{}   {}", t + 1, other.name));
                        }
                    }
                    if ids.len() == 1 {
                        free(message);
                        message = output_kind == 1 ? clone("No instrument loaded yet (Instrument > Add instrument)")
                            : clone("No AUDIO track to feed; create one with Track > Create AUDIO track");
                        let spare: list<str8> = labels; for label in spare { free(label); }
                    } else {
                        outputs.title = output_kind == 1 ? "MIDI output" : "Output channel";
                        outputs.open(ids, labels, current);
                        focus.set_menu_active(true);
                    }
                }
            }
            else if command == 31 {
                let choice: i32 = outputs.chosen();
                let index: i32 = output_track;
                free(message);
                if output_kind == 1 {
                    let shared: bool = choice > 0 && library.table.instrument_used_by_other(choice, index);
                    if !library.table.set_instrument_output(index, choice) { message = clone(library.table.error); }
                    else if choice == 0 { message = clone("MIDI output: master (preview tone)"); }
                    else {
                        let name: str8 = midi.output.instrument_name(wide(choice));
                        message = shared ? format!("MIDI output: {} #{}, shared with another track (same pads, fader and inserts)", name, choice)
                            : format!("MIDI output: {} #{}", name, choice);
                    }
                } else if !library.table.set_track_output(index, choice) { message = clone(library.table.error); }
                else { message = choice == 0 ? clone("Output channel: master") : format!("Output channel: A{}", choice); }
                playback_dirty = true;
            }
            else if command == 22 || command == 24 {
                confirm_track_action = command;
                question.title = command == 22 ? "Delete track" : "Clear track";
                question.question = command == 22 ? "Delete the selected track and its pattern?" : "Clear all rows of the selected track?";
                question.open(); focus.set_menu_active(true);
            }
            else if command == 42 {
                matrix.visible = false; library.show_patterns();
            }
            else if command == 43 {
                if library.song.len() == 0 { library.matrix_insert_row(0, false); }
                matrix.visible = true; focus.selected = 1;
                free(message); message = clone("Song matrix: Enter chooses a pattern for the cell; parallel lanes play together");
            }
            else if command == 44 { library.show_audio(); }
            else if command == 45 { library.show_instruments(); }
            else if command == 29 {
                // Never join an instance another track already plays through: two
                // tracks on one instance share its pads, fader and meters. Sharing
                // stays available explicitly (Enter in Instruments, Track > Duplicate).
                let candidate: i32 = library.selected_instrument();
                let shared: bool = library.table.instrument_in_use(candidate);
                library.table.create_instrument_track(shared ? 0 : candidate, panes[1].bounds.inset(1));
                library.show_instruments();
                free(message);
                message = shared ? format!("Instrument track created unassigned (instance {} is used by another track). Add > Instrument loads a new one; Enter in Instruments shares it.", candidate)
                    : clone("Instrument track created. Add > Instrument loads a plugin; Enter in Instruments assigns it.");
            }
            else if command == 57 || command == 58 {
                pattern_action = command; learn_action = 0; adding_audio = false; adding_plugin = false;
                adding_instrument = false; adding_effect = -1; adding_insert_track = -1; adding_pad_file = false;
                transport.playing = false; dialog.save_mode = command == 57; dialog.multi_select = false; dialog.bundle_pattern = "";
                dialog.title = command == 57 ? "Save pattern (.mlapatt)" : "Load pattern (.mlapatt)";
                dialog.file_pattern = command == 57 ? "" : ".*\\.[mM][lL][aA][pP][aA][tT][tT]";
                dialog.open(last_pattern_dir);
                if command == 57 { dialog.path_field.set_text(library.active_name()); }
                focus.set_menu_active(true);
            }
            else if command == 50 || command == 53 { library.add(command == 53); }
            else if command == 51 {
                library.editor.set_text(library.active_name()); library.renaming = true; library.error = "";
            }
            else if command == 56 {
                transport.playing = false; song_playing = false;
                bpm_dialog.open_matrix_steps(library.matrix_steps);
                focus.set_menu_active(true);
            }
            else if command == 55 {
                follow_matrix = !follow_matrix;
                menus = demo_menus(fixture, follow_matrix);
                free(message);
                if follow_matrix {
                    if song_playing { library.follow_pattern(library.song_row_pattern(song_row)); play_pattern = library.active_id; }
                    message = clone("Follow matrix patterns: on. The editor and mixer show the row the matrix browses or plays.");
                } else { message = clone("Follow matrix patterns: off. The editor and mixer stay on the selected pattern."); }
            }
            else if command == 52 { library.remove_active(panes[0].bounds.inset(1)); }
            else if command == 54 {
                transport.playing = false;
                bpm_dialog.open_pattern_length(i32(library.table.rows.len()));
            }
            else if command == 70 || command == 71 { sample.grainy = command == 71; }
            else if command == 72 || command == 73 { sample.wave = command == 73; }
            else if command == 74 { bpm_dialog.open_meter_rate(frame_rate.fps); }
            else if command == 40 || command == 41 {
                mixer.grainy = command == 41;
                free(message); message = clone(mixer.grainy ? "Meter style: grainy (osc)": "Meter style: solid bars");
            }
            else if command == 61 {
                free(message);
                message = library.table.copy_audio()
                    ? clone("Copied audio tail to clipboard.")
                    : clone(library.table.error);
            }
            else if command == 62 {
                free(message);
                message = library.table.cut_audio(panes[1].bounds.inset(1))
                    ? clone("Cut audio tail to clipboard.")
                    : clone(library.table.error);
            }
            else if command == 63 {
                free(message);
                message = library.table.paste_audio(panes[1].bounds.inset(1))
                    ? clone("Pasted audio from clipboard.")
                    : clone(library.table.error);
            }
            else if command == 102 {
                free(message);
                message = library.table.reverse_audio(panes[1].bounds.inset(1))
                    ? clone("Reversed audio clip.")
                    : clone(library.table.error);
            }
            else if command == 105 {
                free(message);
                message = library.table.trim_audio(sample.sel_start, sample.sel_end, panes[1].bounds.inset(1))
                    ? clone("Trimmed audio clip to selection.")
                    : clone(library.table.error);
            }
            else if command == 106 {
                free(message);
                message = library.table.slice_audio(panes[1].bounds.inset(1))
                    ? clone("Sliced audio clip into three parts.")
                    : clone(library.table.error);
            }
            else if command == 103 {
                free(message);
                message = library.table.move_audio(-1, panes[1].bounds.inset(1))
                    ? clone("Moved audio clip up.")
                    : clone(library.table.error);
            }
            else if command == 104 {
                free(message);
                message = library.table.move_audio(1, panes[1].bounds.inset(1))
                    ? clone("Moved audio clip down.")
                    : clone(library.table.error);
            }
            else if(command >= 20 && command <= 28) ||(command >= 80 && command <= 84) {
                library.table.track_action(command, panes[1].bounds.inset(1));
                free(message); message = clone("Track updated. Mute affects demo state only.");
            }
            else if command > 0 {
                free(message); message = clone("Command selected. Ready for the application handler.");
            }
            if pending_length > 0 {
                length_target = pending_length; pending_length = 0;
                if library.table.length_truncates_data(length_target) {
                    question.title = "Set length";
                    question.question = "Are you sure, data will be truncated";
                    confirm_track_action = 54; question.open();
                } else {library.table.set_length(length_target, panes[1].bounds.inset(1));}
                dirty = true;
            }
            if !running { break; }
        }
        if !received_input && input.pending() {
            escape_ticks = escape_ticks + i32(ui_steps);
            if escape_ticks >= 5 {
                let event: InputEvent = input.expire();
                library.table.delete_pending = false;
                library.table.top_pending = false;
                library.view.cancel_pending();
                library.audio.view.cancel_pending();
                library.instruments.cancel_pending();
                if paste_error.active { paste_error.on_event(event); dirty = true; }
                else if instrument_editor.active && instrument_editor.focused && !dialog.active { instrument_editor.on_event(event, midi.output, panes[1].bounds); dirty = true; }
                else if sample_editor.active {
                    if sample_editor.on_event(event, panes[1].bounds.width - 2) == 2 { sample_editor.release(); free(message); message = clone("Sample edits discarded"); }
                    dirty = true;
                }
                else if piano.active { piano.on_event(event); dirty = true; }
                else if settings.active { settings.on_event(event); dirty = true; }
                else if bpm_dialog.active { bpm_dialog.on_event(event); dirty = true; }
                else if library.renaming { library.rename_event(event); dirty = true; }
                else if picker.active {
                    picker.on_event(event);
                    if !picker.active && picker.result == 2 { free(message); message = clone("Cancelled."); }
                    dirty = true;
                }
                else if outputs.active {
                    outputs.on_event(event);
                    if !outputs.active && outputs.result == 2 { free(message); message = clone("Cancelled."); }
                    dirty = true;
                }
                else if clash_question.active {
                    clash_question.on_event(event); dirty = true;
                }
                else if remove_question.active {
                    remove_question.on_event(event);
                    if !remove_question.active && remove_question.result == 2 { remove_pending = 0; free(message); message = clone("Cancelled."); }
                    dirty = true;
                }
                else if share_question.active {
                    share_question.on_event(event);
                    if !share_question.active { share_id = 0; free(message); message = clone("Cancelled."); }
                    dirty = true;
                }
                else if question.active {
                    question.on_event(event);
                    if !question.active { confirm_track_action = 0; free(message); message = clone("Cancelled."); }
                    dirty = true;
                }
                else if dialog.active {
                    dialog.on_event(event, area);
                    focus.set_menu_active(dialog.active);
                    if !dialog.active && !dialog.accepted { adding_pad_file = false; }
                    dirty = true;
                }
                else if library.table.editing || (library.table.visual && menus.active < 0 && focus.selected == 1) {
                    library.table.edit_event(event, panes[1].bounds.inset(1)); dirty = true;
                }
                else if event.kind == InputKind::Menu {
                    menus.on_key(event.key);
                    focus.set_menu_active(menus.active >= 0);
                    dirty = true;
                }
            }
        }
        midi.route_selected(library.table);
        sleep_ms(frame_rate.sleep_ms(now_ms()));
    }
    note_playback.update(library.table, transport.ticks, false);
    midi.release();
    settings.release();
    free(session_path); free(request_path);
    instrument_editor.release(); sample_editor.release(); piano.release(); picker.release(); outputs.release(); song_table.release(); mixer_table.release(); free(preset_path);
    free(last_pattern_dir); free(last_session_dir); free(last_audio_dir); free(last_plugin_dir); free(last_preset_dir);
    library.release(); dialog.release(); bpm_dialog.release(); free(message);
    terminal.finish();
    return 0;
}
