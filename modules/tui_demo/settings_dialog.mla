mod tui::dialog;
mod tui::dropdown;
mod tui::textfield;
mod std::audio;
mod std::midi;
use std::midi::input_count;
use std::midi::input_name;
use std::audio::output_device_count;
use std::audio::output_device_name;
use tui::dialog::Dialog;
use tui::dropdown::*;
use tui::textfield::TextField;
use tui::button::PushButton;
use tui::focus::PaneFocus;
use tui::layout::Alignment;
use tui::geometry::*;
use tui::surface::*;
use tui::theme::*;
use tui::input::*;
use tui::menu::Key;
use std::strbuf::clone;
use std::strbuf::free;

/// Focus order: 0 MIDI, 1 output, 2 buffer, 3 rate, 4 folder, 5 buttons.
pub struct SettingsDialog : Dialog {
    var midi: DropDown; var output: DropDown; var buffer: DropDown; var rate: DropDown; var error: str8;
    /// Where mlacker keeps its presets and its own settings file.
    var folder: TextField;
};
impl SettingsDialog {
    pub fn new() -> SettingsDialog {
        return SettingsDialog { title: "Settings", width: 72, height: 26, folder: TextField::new(""),
            error: clone(""), focus: PaneFocus::new(0), button_alignment: Alignment::Center,
            buttons: [PushButton { label: "OK", action: 1 }, PushButton { label: "Cancel", action: 2 }] };
    }
    pub fn open(self: &mut Self, midi_id: i64, output_id: i64) -> void {
        self.open_with_buffer(midi_id, output_id, 128);
    }
    pub fn open_with_buffer(self: &mut Self, midi_id: i64, output_id: i64, frames: i64) -> void {
        self.open_audio(midi_id, output_id, frames, 0);
    }
    pub fn open_audio(self: &mut Self, midi_id: i64, output_id: i64, frames: i64, rate: i64) -> void {
        self.open_full(midi_id, output_id, frames, rate, "");
    }
    pub fn open_full(self: &mut Self, midi_id: i64, output_id: i64, frames: i64, rate: i64, folder: str8) -> void {
        self.folder.set_text(folder);
        self.rate.set_items([DropDownItem { id: 0, label: "Device default" },
            DropDownItem { id: 44100, label: "44.1 kHz" }, DropDownItem { id: 48000, label: "48 kHz" },
            DropDownItem { id: 96000, label: "96 kHz" }], rate);
        var buffer_items: list<DropDownItem> = [];
        var size: i64 = 32;
        while size <= 4096 {
            buffer_items.push(DropDownItem { id: size, label: format!("{} frames", size) });
            size = size * 2;
        }
        self.buffer.set_items(buffer_items, frames);
        for item in buffer_items { free(item.label); }
        var midi_items: list<DropDownItem> = [DropDownItem { id: -2, label: clone("Disabled") }, DropDownItem { id: -1, label: clone("System default") }];
        let midi_count: i64 = std::midi::input_count();
        for id in 0..midi_count {
            midi_items.push(DropDownItem { id: id, label: clone(std::midi::input_name(id)) });
        }
        self.midi.set_items(midi_items, midi_id);
        for item in midi_items { free(item.label); }
        var audio_items: list<DropDownItem> = [DropDownItem { id: -2, label: clone("Disabled") }, DropDownItem { id: -1, label: clone("AUHAL - System default") }];
        let audio_count: i64 = std::audio::output_device_count();
        for id in 0..audio_count {
            audio_items.push(DropDownItem { id: id, label: format!("AUHAL - {}", std::audio::output_device_name(id)) });
        }
        self.output.set_items(audio_items, output_id);
        for item in audio_items { free(item.label); }
        free(self.error); self.error = clone("");
        self.reset_buttons(); self.focus.selected = 0; self.active = true;
    }
    pub fn fail(self: &mut Self, error: str8) -> void {
        free(self.error); self.error = clone(error); self.active = true; self.reset_buttons();
    }
    pub fn on_event(self: &mut Self, event: InputEvent) -> void {
        if self.pressed_button >= 0 { return; }
        if event.kind == InputKind::Pane || (event.kind == InputKind::Menu && event.key == Key::Toggle) {
            self.midi.cancel(); self.output.cancel(); self.buffer.cancel(); self.rate.cancel();
            let back: bool = event.kind == InputKind::Pane && (event.key == Key::Up || event.key == Key::Left);
            if back { self.focus.selected = self.focus.selected == 0 ? 5 : self.focus.selected - 1; }
            else { self.focus.selected = self.focus.selected == 5 ? 0 : self.focus.selected + 1; }
            return;
        }
        if self.focus.selected == 0 { if self.midi.on_event(event) { return; } }
        if self.focus.selected == 1 { if self.output.on_event(event) { return; } }
        if self.focus.selected == 2 { if self.buffer.on_event(event) { return; } }
        if self.focus.selected == 3 { if self.rate.on_event(event) { return; } }
        if event.kind == InputKind::Menu && event.key == Key::Escape && event.code < 32 {
            self.active = false; self.result = 2; return;
        }
        // The folder is typed in place; Enter there moves on to the buttons.
        if self.focus.selected == 4 {
            if event.kind == InputKind::Menu && event.key == Key::Enter { self.focus.selected = 5; return; }
            self.folder.on_event(event); return;
        }
        if self.focus.selected == 5 { self.on_button_event(event); }
    }
    pub fn tick(self: &mut Self) -> void {
        let action: i32 = self.tick_buttons();
        if action == 1 || action == 2 { self.active = false; self.result = action; }
    }
    pub fn paint(self: SettingsDialog, surface: Surface, viewport: Rect, theme: Theme) -> void {
        if !self.active { return; }
        let body: Rect = self.paint_frame(surface, viewport, theme);
        let midi_row: Rect = Rect::new(body.x + 1, body.y + 1, body.width - 2, body.height > 1 ? 1 : 0);
        let output_row: Rect = Rect::new(body.x + 1, body.y + 4, body.width - 2, body.height > 4 ? 1 : 0);
        let buffer_row: Rect = Rect::new(body.x + 1, body.y + 7, body.width - 2, body.height > 7 ? 1 : 0);
        let rate_row: Rect = Rect::new(body.x + 1, body.y + 10, body.width - 2, body.height > 10 ? 1 : 0);
        let folder_row: Rect = Rect::new(body.x + 1, body.y + 13, body.width - 2, body.height > 13 ? 1 : 0);
        surface.text(body, "MIDI input adapter", theme.foreground, theme.panel);
        if body.height > 3 { surface.text(Rect::new(body.x, body.y + 3, body.width, 1), "Master output (AUHAL)", theme.foreground, theme.panel); }
        self.midi.paint(surface, midi_row, theme, self.focus.selected == 0);
        self.output.paint(surface, output_row, theme, self.focus.selected == 1);
        if body.height > 6 { surface.text(Rect::new(body.x, body.y + 6, body.width, 1), "Buffer size (samples per channel)", theme.foreground, theme.panel); }
        self.buffer.paint(surface, buffer_row, theme, self.focus.selected == 2);
        if body.height > 9 { surface.text(Rect::new(body.x, body.y + 9, body.width, 1), "Sample rate", theme.foreground, theme.panel); }
        self.rate.paint(surface, rate_row, theme, self.focus.selected == 3);
        if body.height > 12 { surface.text(Rect::new(body.x, body.y + 12, body.width, 1), "Mlacker folder (presets and settings)", theme.foreground, theme.panel); }
        let folder_bg: i32 = self.focus.selected == 4 ? theme.selection : theme.panel;
        self.folder.paint(surface, folder_row, theme.foreground, folder_bg, self.focus.selected == 4);
        if body.height > 15 { surface.text(Rect::new(body.x, body.y + 15, body.width, 1), "Buffer size is a request; device size may differ.", theme.muted, theme.panel); }
        if body.height > 16 { surface.text(Rect::new(body.x, body.y + 16, body.width, 1), self.error, theme.accent, theme.panel); }
        // Overlays are last, so they cover labels, fields and buttons.
        self.midi.paint_popup(surface, midi_row, viewport, theme);
        self.output.paint_popup(surface, output_row, viewport, theme);
        self.buffer.paint_popup(surface, buffer_row, viewport, theme);
        self.rate.paint_popup(surface, rate_row, viewport, theme);
    }
    pub fn release(self: &mut Self) -> void { self.midi.release(); self.output.release(); self.buffer.release(); self.rate.release(); self.folder.release(); free(self.error); }
}
