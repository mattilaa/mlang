fn calculate(a: int, b: float) -> int {
    let result: int = 1;
    result = a + int(b);
    return result;
}

fn max(a: int, b: int) -> int {
    if a > b: {
        return a;
    }
    if a > b: return a;
    else if b > a: return b;
    else: return a;
}

fn main() -> void {
    let x: int = 1;
    var y: float = 0.0;
    x = 5;
    y = 3.14;
    let y: int = calculate(x, y);
    return;
}
