/// \file mla_verb_dsp.mla
/// \brief C-ABI bridge that drives the shared dsp::reverb2 FDN reverb.
///
/// State is per plug-in instance: `mlaverb_create` heap-allocates one `Reverb2`
/// and returns an opaque pointer that the C++ VST3 layer stores and passes back
/// to every call. This keeps multiple loaded instances independent (mlacker
/// allows several aux/effect slots), unlike module-level globals.
///
/// The handle is a `ptr<Reverb2>` **directly** (no wrapper struct): calling a
/// `&mut self` method on a struct field reached through a raw pointer
/// (`(*handle).field.method()`) corrupts the heap because of how the nested
/// field access interacts with MLang's implicit drops of the heap-backed delay
/// buffers. Pointing straight at the `Reverb2` keeps every call a plain
/// `(*handle).method()` and avoids that path.
///
/// All numeric ranges are physical (seconds, milliseconds, 0..1 controls); the
/// C++ side maps VST3 normalized parameters onto them.

mod dsp::reverb2;
use dsp::reverb2::Reverb2;
use dsp::reverb2::Reverb2Type;
use dsp::reverb2::Reverb2Frame;

extern fn calloc(count: i64, size: i64) -> ptr<Reverb2>;
extern fn free(block: ptr<Reverb2>) -> void;

fn mlaverb_type_from_index(index: i32) -> Reverb2Type {
    if index <= 0 { return Reverb2Type::Hall; }
    if index == 1 { return Reverb2Type::Room; }
    if index == 2 { return Reverb2Type::Plate; }
    if index == 3 { return Reverb2Type::Gated; }
    if index == 4 { return Reverb2Type::Reverse; }
    if index == 5 { return Reverb2Type::NonlinearShort; }
    if index == 6 { return Reverb2Type::NonlinearLong; }
    if index == 7 { return Reverb2Type::Custom; }
    return Reverb2Type::InfiniteHall;
}

/// @brief Allocate a reverb instance for a sample rate (8 kHz..384 kHz).
/// @return Opaque handle owned by the caller; release with `mlaverb_destroy`.
fn mlaverb_create(sample_rate: f32) -> ptr<Reverb2> {
    var rate: f32 = sample_rate;
    if rate < 8000.0f { rate = 8000.0f; }
    if rate > 384000.0f { rate = 384000.0f; }
    // `calloc` zero-fills the block so the delay buffers read as empty/null
    // before assignment; that keeps MLang's implicit drop of the previous value
    // a safe no-op instead of freeing uninitialised garbage. Assign the
    // constructor rvalue directly so the heap-backed reverb is moved into place
    // (a temporary copy would drop its delay buffers and leave them dangling).
    let handle: ptr<Reverb2> = calloc(1, size_of(Reverb2));
    unsafe { *handle = Reverb2::new(rate); }
    return handle;
}

/// @brief Release a reverb instance created by `mlaverb_create`.
fn mlaverb_destroy(handle: ptr<Reverb2>) {
    // Move the struct into a local so MLang drops its heap-backed delay buffers,
    // then free the (now buffer-less) block.
    unsafe {
        let dead: Reverb2 = *handle;
        dead.reset();
    }
    free(handle);
}

/// @brief Clear all reverb history without reallocating.
fn mlaverb_reset(handle: ptr<Reverb2>) {
    unsafe { (*handle).reset(); }
}

fn mlaverb_set_type(handle: ptr<Reverb2>, index: i32) {
    unsafe { (*handle).set_type(mlaverb_type_from_index(index)); }
}

fn mlaverb_set_size(handle: ptr<Reverb2>, value: f32) {
    unsafe { (*handle).set_size(value); }
}

fn mlaverb_set_decay(handle: ptr<Reverb2>, seconds: f32) {
    unsafe { (*handle).set_decay_seconds(seconds); }
}

fn mlaverb_set_damp(handle: ptr<Reverb2>, value: f32) {
    unsafe { (*handle).set_damping(value); }
}

fn mlaverb_set_diffusion(handle: ptr<Reverb2>, value: f32) {
    unsafe { (*handle).set_diffusion(value); }
}

fn mlaverb_set_predelay(handle: ptr<Reverb2>, milliseconds: f32) {
    unsafe { (*handle).set_predelay_ms(milliseconds); }
}

fn mlaverb_set_early(handle: ptr<Reverb2>, value: f32) {
    unsafe { (*handle).set_early_mix(value); }
}

fn mlaverb_set_width(handle: ptr<Reverb2>, value: f32) {
    unsafe { (*handle).set_stereo_width(value); }
}

fn mlaverb_set_mix(handle: ptr<Reverb2>, value: f32) {
    unsafe { (*handle).set_mix(value); }
}

fn mlaverb_set_freeze(handle: ptr<Reverb2>, enabled: i32) {
    unsafe { (*handle).set_freeze(enabled != 0); }
}

/// @brief Process one stereo frame. Returns the left output and writes the
/// matching right output through `out_right`.
fn mlaverb_process(handle: ptr<Reverb2>, input_left: f32, input_right: f32, out_right: ptr<f32>) -> f32 {
    unsafe {
        let frame: Reverb2Frame = (*handle).process_stereo(input_left, input_right);
        *out_right = frame.right();
        return frame.left();
    }
}
