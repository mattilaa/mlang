/// Per-instance C ABI for dsp::punch_limiter. Allocate only on setup;
/// parameter updates and processing retain the delay lines.
mod dsp::punch_limiter;
use dsp::punch_limiter::PunchLimiter;
use dsp::punch_limiter::PunchLimiterFrame;
use dsp::punch_limiter::PunchLimiterMode;
extern fn calloc(count: i64, size: i64) -> ptr<PunchLimiter>;
extern fn free(block: ptr<PunchLimiter>) -> void;

fn mlalimiter_create(rate: f32) -> ptr<PunchLimiter> {
    let handle: ptr<PunchLimiter> = calloc(1, size_of(PunchLimiter));
    unsafe { *handle = PunchLimiter::new(rate); }
    return handle;
}
fn mlalimiter_destroy(handle: ptr<PunchLimiter>) {
    unsafe { let dead: PunchLimiter = *handle; dead.reset(); }
    free(handle);
}
fn mlalimiter_reset(handle: ptr<PunchLimiter>) { unsafe { (*handle).reset(); } }
fn mlalimiter_latency(handle: ptr<PunchLimiter>) -> i64 { unsafe { return (*handle).latency_samples(); } }
fn mlalimiter_reduction(handle: ptr<PunchLimiter>) -> f32 { unsafe { return (*handle).gain_reduction_db(); } }

/// 0 mode (0 Maximizer, 1 Smooth), 1 threshold dB, 2 ceiling dB,
/// 3 release ms, 4 auto release (0/1), 5 punch, 6 fat, 7 attack ms,
/// 8 bypass (0/1), 9 true peak (0/1).
fn mlalimiter_set(handle: ptr<PunchLimiter>, index: i32, value: f32) {
    unsafe {
        if index == 0 {
            (*handle).set_mode(value >= 0.5f ? PunchLimiterMode::Smooth : PunchLimiterMode::Maximizer);
        }
        else if index == 1 { (*handle).set_threshold_db(value); }
        else if index == 2 { (*handle).set_ceiling_db(value); }
        else if index == 3 { (*handle).set_release_ms(value); }
        else if index == 4 { (*handle).set_arc(value >= 0.5f); }
        else if index == 5 { (*handle).set_punch(value); }
        else if index == 6 { (*handle).set_fat(value); }
        else if index == 7 { (*handle).set_attack_ms(value); }
        else if index == 8 { (*handle).set_bypass(value >= 0.5f); }
        else if index == 9 { (*handle).set_true_peak(value >= 0.5f); }
    }
}
fn mlalimiter_process(handle: ptr<PunchLimiter>, left: f32, right: f32, out_right: ptr<f32>) -> f32 {
    unsafe {
        let frame: PunchLimiterFrame = (*handle).process_stereo(left, right);
        *out_right = frame.right(); return frame.left();
    }
}
