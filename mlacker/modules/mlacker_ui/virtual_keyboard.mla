mod tui::piano;
mod mlacker_ui::midi_controller;
use tui::geometry::*;
use tui::surface::*;
use tui::theme::*;
use tui::input::*;
use tui::menu::Key;
use tui::piano::*;
use mlacker_ui::midi_controller::MidiInputEvent;
use std::strbuf::free;

/// A sounding note, the key code playing it, and the live target (see
/// AudioSystem::live_target) its note-off must reach. Without key releases it
/// ends at `until` unless its key repeats first.
pub struct HeldNote { var note: i32; var code: i32; var target: i64; var until: i64; };

/// Computer-keyboard piano in the bottom pane (View menu / Shift+P), tracker
/// layout: z s x d c v g b h n j m , l . ; / from C of `octave`, q 2 w 3 e r
/// 5 t 6 y 7 u i 9 o 0 p an octave up. Each key sounds from its press to its
/// release, so chords work. Terminals without the kitty key-release report
/// send no releases: there a note ends once its key stops auto-repeating for
/// `hold_ms`, until the first release shows the terminal sends them.
pub struct VirtualKeyboard {
    var visible: bool; var octave: i32{3}; var velocity: i32{100}; var hold_ms: i64{400};
    var releases_seen: bool;
    var notes: list<HeldNote>;
    /// Note-ons and -offs not yet handed to MidiController::inject.
    var events: list<MidiInputEvent>;
};
impl VirtualKeyboard {
    /// Semitones above C of the current octave for a key code, or -1.
    pub fn key_offset(code: i32) -> i32 {
        for i in 0..17 {
            if VirtualKeyboard::row_code(false, i32(i)) == code { return i32(i); }
            if VirtualKeyboard::row_code(true, i32(i)) == code { return i32(i) + 12; }
        }
        return -1;
    }
    /// Key code at `index` (0-16) of the Z row, or of the Q row when `upper`.
    fn row_code(upper: bool, index: i32) -> i32 {
        let lower_row: array<i32, 17> = {122, 115, 120, 100, 99, 118, 103, 98, 104, 110, 106, 109, 44, 108, 46, 59, 47};
        let upper_row: array<i32, 17> = {113, 50, 119, 51, 101, 114, 53, 116, 54, 121, 55, 117, 105, 57, 111, 48, 112};
        if index < 0 || index > 16 { return 0; }
        return upper ? upper_row[index] : lower_row[index];
    }
    /// MIDI note of C in the current octave (octave 4 = MIDI 60, C-4).
    pub fn base(self: VirtualKeyboard) -> i32 { return (self.octave + 1) * 12; }
    /// Keys the focused keyboard keeps for itself: everything printable and the
    /// arrows. Pane moves, Tab, F1, Escape, control shortcuts, Space (transport)
    /// and the Shift+M / Shift+P view toggles still reach the application.
    pub fn handles(event: InputEvent) -> bool {
        if event.kind == InputKind::None || event.kind == InputKind::Pane { return false; }
        if event.modifiers != 1 && event.modifiers != 2 { return false; }
        if event.kind == InputKind::Menu && (event.key == Key::Toggle || event.key == Key::Function1 || event.key == Key::Escape) { return false; }
        if event.code == 32 || event.code == 77 || event.code == 80 { return false; }
        if event.modifiers == 2 && (event.code == 109 || event.code == 112) { return false; }
        if event.code == 13 || event.code == 10 { return true; }
        return event.code == 0 || event.code >= 33;
    }
    pub fn shift_octave(self: &mut Self, delta: i32) -> bool {
        let next: i32 = self.octave + delta;
        if next < 0 || next > 8 { return false; }
        self.octave = next; return true;
    }
    fn held_index(self: VirtualKeyboard, note: i32) -> i32 {
        for i in 0..self.notes.len() { let held: HeldNote = self.notes[i]; if held.note == note { return i32(i); } }
        return -1;
    }
    fn key_index(self: VirtualKeyboard, code: i32) -> i32 {
        for i in 0..self.notes.len() { let held: HeldNote = self.notes[i]; if held.code == code { return i32(i); } }
        return -1;
    }
    pub fn is_held(self: VirtualKeyboard, note: i32) -> bool { return self.held_index(note) >= 0; }
    /// A key release ends the note that key started, even after an octave
    /// change; the caller sends the returned notes' note-offs.
    pub fn on_release(self: &mut Self, event: InputEvent, now: i64) -> list<HeldNote> {
        self.releases_seen = true;
        var released: list<HeldNote> = []; var kept: list<HeldNote> = [];
        for i in 0..self.notes.len() {
            let held: HeldNote = self.notes[i];
            if held.code == event.code {
                released.push(held);
                self.events.push(MidiInputEvent { kind: 2, note: wide(held.note), received_ms: now });
            } else { kept.push(held); }
        }
        if released.len() > 0 { self.notes = kept; }
        return released;
    }
    /// A key press. Returns the MIDI note to start, or -1 when nothing new
    /// sounds: an octave key, an unmapped key, or the auto-repeat of a held
    /// note (which only keeps it sounding).
    pub fn on_event(self: &mut Self, event: InputEvent, target: i64, now: i64) -> i32 {
        if event.code == 45 || (event.code == 0 && event.kind == InputKind::Menu && event.key == Key::Left) { self.shift_octave(-1); return -1; }
        if event.code == 61 || event.code == 43 || (event.code == 0 && event.kind == InputKind::Menu && event.key == Key::Right) { self.shift_octave(1); return -1; }
        if event.modifiers != 1 { return -1; }
        let offset: i32 = VirtualKeyboard::key_offset(event.code);
        if offset < 0 { return -1; }
        let note: i32 = self.base() + offset;
        if note > 127 { return -1; }
        // A repeat of a held key, or the same note from its other row.
        var index: i32 = self.key_index(event.code);
        if index < 0 { index = self.held_index(note); }
        if index >= 0 {
            var held: HeldNote = self.notes[index]; held.until = now + self.hold_ms;
            var next: list<HeldNote> = [];
            for i in 0..self.notes.len() { if i32(i) == index { next.push(held); } else { next.push(self.notes[i]); } }
            self.notes = next;
            return -1;
        }
        if target < 0 { return -1; }
        self.notes.push(HeldNote { note: note, code: event.code, target: target, until: now + self.hold_ms });
        self.events.push(MidiInputEvent { kind: 1, note: wide(note), velocity: wide(self.velocity), received_ms: now });
        return note;
    }
    /// Removes and returns the notes whose keys stopped repeating, on
    /// terminals without key releases (all notes when `all`); the caller
    /// sends their note-offs.
    pub fn release_due(self: &mut Self, now: i64, all: bool) -> list<HeldNote> {
        var released: list<HeldNote> = []; var kept: list<HeldNote> = [];
        for i in 0..self.notes.len() {
            let held: HeldNote = self.notes[i];
            if all || (!self.releases_seen && now >= held.until) {
                released.push(held);
                self.events.push(MidiInputEvent { kind: 2, note: wide(held.note), received_ms: now });
            } else { kept.push(held); }
        }
        if released.len() > 0 { self.notes = kept; }
        return released;
    }
    pub fn take_events(self: &mut Self) -> list<MidiInputEvent> {
        let events: list<MidiInputEvent> = self.events; self.events = []; return events;
    }
    /// Pane title, e.g. " Keyboard | Octave 3 (C-3..E-5) | Lead ".
    pub fn title(self: VirtualKeyboard, target_name: str8) -> str8 {
        let low: str8 = piano_note_name(self.base());
        let top: i32 = self.base() + 28 > 127 ? 127 : self.base() + 28;
        let high: str8 = piano_note_name(top);
        let text: str8 = format!(" Keyboard | Octave {} ({}..{}) | {} ", self.octave, low, high, target_name);
        free(low); free(high); return text;
    }
    /// Paints into a panel's inner area: the piano (playable keys captioned
    /// with the computer keys that play them), a key help line, and `status`
    /// on the last row, since the keyboard covers the inspector's messages.
    pub fn paint(self: VirtualKeyboard, surface: Surface, area: Rect, theme: Theme, status: str8) -> void {
        if area.width < 21 || area.height < 4 { return; }
        let base: i32 = self.base();
        // Z-row letters on the first octave, Q-row keys from its C upwards.
        var captions: list<i32> = [];
        for k in 0..128 {
            let offset: i32 = i32(k) - base;
            var code: i32 = 0;
            if offset >= 0 && offset < 12 { code = VirtualKeyboard::row_code(false, offset); }
            if offset >= 12 && offset <= 28 { code = VirtualKeyboard::row_code(true, offset - 12); }
            captions.push(code >= 97 && code <= 122 ? code - 32 : code);
        }
        var pressed: list<i32> = [];
        for i in 0..self.notes.len() { let held: HeldNote = self.notes[i]; pressed.push(held.note); }
        // One octave below the playable range when there is room for it.
        let fit: i32 = PianoKeyboard::octaves_for(area.width, 3);
        let below: bool = fit >= 4 && self.octave > 0;
        let keyboard: PianoKeyboard = PianoKeyboard { first_octave: self.octave + (below ? 0 : 1),
            octaves: below ? 4 : 3, key_width: 3, low: base, high: base + 28 > 127 ? 127 : base + 28,
            pressed: pressed, captions: captions };
        let rows: i32 = area.height - 2 > 7 ? 7 : area.height - 2;
        keyboard.paint(surface, Rect::new(area.x, area.y, area.width, rows), theme);
        surface.text(Rect::new(area.x, area.y + area.height - 2, area.width, 1),
            "Keys play notes | Left/Right or -/= octave | Space play/stop | Shift+P hide", theme.muted, theme.panel);
        surface.text(Rect::new(area.x, area.y + area.height - 1, area.width, 1), status, theme.foreground, theme.panel);
    }
}
