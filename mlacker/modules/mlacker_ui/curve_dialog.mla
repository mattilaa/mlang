mod tui::dialog;
mod mlacker_ui::sequence;
use tui::dialog::Dialog;
use tui::button::PushButton;
use tui::focus::PaneFocus;
use tui::layout::Alignment;
use tui::geometry::*;
use tui::surface::*;
use tui::theme::*;
use tui::input::*;
use tui::menu::Key;
use mlacker_ui::sequence::curve_names;
use mlacker_ui::sequence::curve_shape;

/// Ctrl+A in the pattern: choose the curve that ramps between the two marked
/// CC values. j/k (or Up/Down) pick a shape, Tab reaches OK/Cancel, Enter on
/// the list applies it. result: 1 = apply `selected`, 2 = cancelled.
pub struct CurveDialog : Dialog { var selected: i32; };
impl CurveDialog {
    pub fn new() -> CurveDialog {
        return CurveDialog { title: "Automation curve", width: 44, height: 16,
            focus: PaneFocus::new(0), button_alignment: Alignment::Center,
            buttons: [PushButton { label: "OK", action: 1 }, PushButton { label: "Cancel", action: 2 }] };
    }
    /// Opens on Linear.
    pub fn open(self: &mut Self) -> void {
        self.selected = 0; self.reset_buttons(); self.focus.selected = 0; self.active = true;
    }
    pub fn on_event(self: &mut Self, event: InputEvent) -> void {
        if event.kind == InputKind::Pane {
            if event.key == Key::Down { self.focus.selected = 3; }
            if event.key == Key::Up { self.focus.selected = 0; }
            return;
        }
        if event.kind == InputKind::Menu && event.key == Key::Escape && event.code < 32 {
            self.active = false; self.result = 2; self.pressed_button = -1; return;
        }
        if event.kind == InputKind::Menu && event.key == Key::Toggle {
            self.focus.selected = self.focus.selected == 0 ? 3 : 0; return;
        }
        if self.focus.selected == 3 { self.on_button_event(event); return; }
        if event.kind != InputKind::Menu { return; }
        let names: list<str8> = curve_names(); let count: i32 = i32(names.len());
        if event.key == Key::Up { self.selected = self.selected > 0 ? self.selected - 1 : 0; }
        if event.key == Key::Down { self.selected = self.selected + 1 < count ? self.selected + 1 : count - 1; }
        if event.key == Key::Enter { self.active = false; self.result = 1; }
    }
    /// Call once per 10ms UI tick while a button shows pressed.
    pub fn tick(self: &mut Self) -> void {
        let action: i32 = self.tick_buttons();
        if action == 1 || action == 2 { self.active = false; }
    }
    pub fn paint(self: CurveDialog, surface: Surface, area: Rect, theme: Theme) -> void {
        if !self.active { return; }
        let body: Rect = self.paint_frame(surface, area, theme);
        let names: list<str8> = curve_names();
        for i in 0..names.len() {
            if i32(i) >= body.height { break; }
            let row: Rect = Rect::new(body.x, body.y + i32(i), body.width, 1);
            let chosen: bool = i32(i) == self.selected;
            let background: i32 = chosen && self.focus.selected == 0 ? theme.selection : theme.panel;
            surface.fill(row, Cell { glyph: 32, foreground: theme.foreground, background: background });
            surface.text(row, chosen ? "> " : "  ", theme.accent, background);
            surface.text(Rect::new(row.x + 2, row.y, row.width - 2, 1), names[i], chosen ? theme.accent : theme.foreground, background);
        }
        // A small preview of the chosen shape, low value to high value.
        let bars: list<str8> = ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"];
        let top: i32 = body.y + i32(names.len()) + 1;
        if top >= body.y + body.height { return; }
        let width: i32 = body.width < 32 ? body.width : 32;
        for x in 0..width {
            let t: f64 = width > 1 ? f64(i32(x)) / f64(width - 1) : 0.0;
            var level: i32 = i32(curve_shape(self.selected, t) * 7.0 + 0.5);
            if level < 0 { level = 0; } if level > 7 { level = 7; }
            surface.text(Rect::new(body.x + (body.width - width) / 2 + i32(x), top, 1, 1), bars[level], theme.accent, theme.panel);
        }
    }
}
