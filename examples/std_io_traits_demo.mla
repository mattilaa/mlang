/// \file std_io_traits_demo.mla
/// @ingroup examples
/// \brief Read/Write/Seek trait-like API demo from std::io.
///
mod std::io;
mod std::strbuf;

use std::io::*;
use std::strbuf::*;

fn main() -> i32 {
    let out = stdout();
    writeln(out, "std::io Read/Write/Seek/BufRead demo");

    let cursor = cursor_with_capacity(64);
    let writer = as_write(cursor);
    write(writer, "first line\nsecond line\n");

    let seeker = as_seek(cursor);
    seek(seeker, 0, seek_set());

    var line = with_capacity(64);
    let reader = as_buf_read(cursor);
    let n1 = read_line(reader, line, 64);
    if n1 > 0: {
        writeln(out, line);
    }

    let n2 = read_line(reader, line, 64);
    if n2 > 0: {
        writeln(out, line);
    }

    free(line);
    cursor_free(cursor);
    return 0;
}
