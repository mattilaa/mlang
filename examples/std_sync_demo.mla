/// \file std_sync_demo.mla
/// @ingroup examples
/// \brief Synchronization primitives demo (mutex, atomics) from std::sync.
///
mod std::sync;
mod std::strbuf;

use std::strbuf::contains;
use std::sync::Channel;
use std::sync::Condvar;
use std::sync::mutex;

fn main() -> i32 {
    let mr: result<mutex, str8> = mutex::new();
    let cr: result<Condvar, str8> = Condvar::new();
    if mr.is_err(): {
        println!("mutex/condvar create failed");
        return 1;
    }
    if cr.is_err(): {
        println!("mutex/condvar create failed");
        return 1;
    }
    let m: mutex = mr.unwrap();
    let c: Condvar = cr.unwrap();
    m.lock();
    let w: result<i32, str8> = c.wait_timeout_ms(m, 10);
    m.unlock();
    c.close();
    m.close();
    if w.is_err(): {
        println!("condvar wait failed");
        return 1;
    }
    println!("condvar timeout result={}", w.unwrap());

    let chr: result<Channel, str8> = Channel::new(4);
    if chr.is_err(): {
        println!("channel create failed");
        return 1;
    }
    let ch: Channel = chr.unwrap();
    ch.send("sync-message");
    var buf = String::with_capacity(128);
    let rr: result<i64, str8> = ch.recv(buf, 128);
    if rr.is_err(): {
        println!("channel recv failed");
        String::free(buf);
        ch.free();
        return 1;
    }
    println!("channel recv bytes={} value={}", rr.unwrap(), buf);
    let ok: i32 = contains(buf, "sync-message") == 1 ? 1 : 0;
    String::free(buf);
    ch.close();
    ch.free();
    return ok == 1 ? 0 : 1;
}
