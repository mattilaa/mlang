mod std::net;
mod std::protocol;
mod std::strbuf;

use std::net::TcpListener;
use std::net::TcpStream;
use std::protocol::ProtocolFrame;
use std::protocol::close;
use std::protocol::connect;
use std::protocol::default_max_payload_bytes;
use std::protocol::from_stream;
use std::protocol::recv;
use std::protocol::send;
use std::strbuf::eq;

fn main() -> i32 {
    let listener_r: Result<TcpListener, str8> = TcpListener::bind("127.0.0.1", 0);
    if listener_r.is_err() {
        let e: str8 = match listener_r {
            Ok(_v) => String::new(),
            Err(err) => err
        };
        println!("bind failed: {}", e);
        return 1;
    }
    let listener: TcpListener = match listener_r {
        Ok(v) => v,
        Err(_e) => TcpListener { handle: 0 }
    };

    let port_r: Result<i64, str8> = listener.local_port();
    if port_r.is_err() {
        let e: str8 = match port_r {
            Ok(_v) => String::new(),
            Err(err) => err
        };
        println!("local_port failed: {}", e);
        listener.close();
        return 1;
    }
    let port: i64 = match port_r {
        Ok(v) => v,
        Err(_e) => -1
    };

    let client_r: Result<i64, str8> = connect("127.0.0.1", port);
    if client_r.is_err() {
        let e: str8 = match client_r {
            Ok(_v) => String::new(),
            Err(err) => err
        };
        println!("connect failed: {}", e);
        listener.close();
        return 1;
    }
    let client: i64 = match client_r {
        Ok(v) => v,
        Err(_e) => -1
    };

    let server_stream_r: Result<TcpStream, str8> = listener.accept();
    if server_stream_r.is_err() {
        let e: str8 = match server_stream_r {
            Ok(_v) => String::new(),
            Err(err) => err
        };
        println!("accept failed: {}", e);
        close(client);
        listener.close();
        return 1;
    }
    let server: i64 = match server_stream_r {
        Ok(v) => from_stream(v),
        Err(_e) => -1
    };

    // Derived protocol example:
    // opcode=1 -> ping request, opcode=2 -> pong response
    let sr: Result<i64, str8> = send(client, 1, "hello-protocol");
    if sr.is_err() {
        let e: str8 = match sr {
            Ok(_v) => String::new(),
            Err(err) => err
        };
        println!("client send failed: {}", e);
        close(server);
        close(client);
        listener.close();
        return 1;
    }

    let rf: Result<ProtocolFrame, str8> = recv(server, 256, default_max_payload_bytes());
    if rf.is_err() {
        let e: str8 = match rf {
            Ok(_v) => String::new(),
            Err(err) => err
        };
        println!("server recv failed: {}", e);
        close(server);
        close(client);
        listener.close();
        return 1;
    }
    let f: ProtocolFrame = rf.unwrap();

    if f.opcode == 1 && eq(f.payload, "hello-protocol") == 1 {
        send(server, 2, "pong");
    } else {
        send(server, 99, "bad-request");
    }
    String::free(f.payload);

    let cf: Result<ProtocolFrame, str8> = recv(client, 256, default_max_payload_bytes());
    if cf.is_err() {
        let e: str8 = match cf {
            Ok(_v) => String::new(),
            Err(err) => err
        };
        println!("client recv failed: {}", e);
        close(server);
        close(client);
        listener.close();
        return 1;
    }
    let out: ProtocolFrame = cf.unwrap();

    println!("client got opcode={} payload={} ", out.opcode, out.payload);
    String::free(out.payload);

    close(server);
    close(client);
    listener.close();
    return 0;
}
