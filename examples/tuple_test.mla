fn main() -> i32 {
    // Create a tuple
    let coords: tuple<int, int, int> = (10, 20, 30);

    // Access elements
    println!("x: {}", coords.0);
    println!("y: {}", coords.1);
    println!("z: {}", coords.2);

    // Mixed types
    let data: tuple<string, int, double> = ("test", 42, 3.14);
    println!("{} {} {}", data.0, data.1, data.2);

    return 0;
}
