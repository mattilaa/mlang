/// \file property_fields_demo.mla
/// @ingroup examples
/// \brief `@property(...)` accessor and JSON metadata demo.

#[derive(Json)]
struct Track {
    @property(hidden) var secret: i32;
    @property var plays: i32;
    var artist: str8;
};

struct ProtectedCounter {
    @property(protected) var value: i32;

    fn bump(self: &mut ProtectedCounter) -> void {
        self.value = self.value + 1;
    }

    fn read(self: ProtectedCounter) -> i32 {
        return self.value;
    }
};

fn run_demo() -> result<i32, str8> {
    var track: Track = Track { artist: "MLang Ensemble" };
    track.setSecret(7);
    track.setPlays(3);

    let encoded: str8 = track.to_json();
    println!("{}", encoded);

    let decoded: Track = Track::from_json(encoded)?;
    println!("{} {} {}", decoded.artist, decoded.getSecret(), decoded.getPlays());

    var counter: ProtectedCounter = ProtectedCounter {};
    counter.bump();
    println!("protected value={}", counter.read());
    return Ok<i32, str8>(0);
}

fn main() -> i32 {
    let r: result<i32, str8> = run_demo();
    if r.is_err() {
        println!("demo failed: {}", r.unwrap_err());
        return 1;
    }
    return 0;
}
