/// \file notepad_demo.mla
/// @ingroup examples
/// \brief Minimal terminal notepad editor demo.
///
mod std::ascii;
mod std::esc;
mod std::fs;
mod std::io;
mod std::strbuf;
mod std::term;
mod std::time;

use std::ascii::AsciiKey;
use std::esc::bg_rgb;
use std::esc::bold_on;
use std::esc::cmd_clear_screen;
use std::esc::cmd_hide;
use std::esc::cmd_home;
use std::esc::cmd_show;
use std::esc::cursor;
use std::esc::cursor_color_reset;
use std::esc::cursor_color_rgb;
use std::esc::cursor_pos;
use std::esc::fg;
use std::esc::fg_rgb;
use std::esc::inverse_on;
use std::esc::reset;
use std::esc::color_black;
use std::esc::color_white;
use std::fs::read_all_text;
use std::fs::write_all_text;
use std::io::Stdin;
use std::io::stdin;
use std::io::stdout;
use std::io::write;
use std::io::read_keycode_nonblocking;
use std::strbuf::StringBuilder;
use std::strbuf::builder_append;
use std::strbuf::builder_append_char;
use std::strbuf::builder_free;
use std::strbuf::builder_new;
use std::strbuf::builder_take_string;
use std::strbuf::clone;
use std::strbuf::concat;
use std::strbuf::eq;
use std::strbuf::fit_right;
use std::strbuf::free;
use std::strbuf::len;
use std::strbuf::repeat;
use std::strbuf::sub;
use std::term::TermSize;
use std::term::stdin_enable_raw;
use std::term::stdin_is_tty;
use std::term::stdin_restore;
use std::term::stdout_size;
use std::time::sleep_ms;

fn max_i64(a: i64, b: i64) -> i64 {
    return a > b ? a : b;
}

fn min_i64(a: i64, b: i64) -> i64 {
    return a < b ? a : b;
}

fn clamp_i64(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo {
        return lo;
    }
    if v > hi {
        return hi;
    }
    return v;
}

fn printable_ascii(keycode: i32) -> i32 {
    return keycode >= 32 && keycode <= 126 ? 1 : 0;
}

fn append_char_to_owned(src: str8, k: i32) -> str8 {
    let b: StringBuilder = builder_new(len(src) + 8);
    let _ = builder_append(b, src);
    let _ = builder_append_char(b, k);
    let out: str8 = builder_take_string(b);
    builder_free(b);
    return out;
}

fn esc_prefixed(suffix: str8) -> str8 {
    let b: StringBuilder = builder_new(len(suffix) + 4);
    let _ = builder_append_char(b, 27);
    let _ = builder_append(b, suffix);
    let out: str8 = builder_take_string(b);
    builder_free(b);
    return out;
}

fn alt_screen_on_real() -> str8 {
    return esc_prefixed("[?1049h");
}

fn alt_screen_off_real() -> str8 {
    return esc_prefixed("[?1049l");
}

fn menu_anchor(menu_open: i32) -> i32 {
    if menu_open == 1 {
        return 1;
    }
    if menu_open == 2 {
        return 7;
    }
    return 13;
}

fn menu_count(menu_open: i32) -> i32 {
    if menu_open == 1 {
        return 3;
    }
    if menu_open == 2 {
        return 2;
    }
    return 2;
}

fn menu_width(menu_open: i32) -> i32 {
    if menu_open == 1 {
        return 10;
    }
    if menu_open == 2 {
        return 8;
    }
    return 11;
}

fn menu_label(menu_open: i32, idx: i32) -> str8 {
    if menu_open == 1 {
        if idx == 0 { return " Open... "; }
        if idx == 1 { return " Save    "; }
        return " Exit    ";
    }
    if menu_open == 2 {
        if idx == 0 { return " Top    "; }
        return " Bottom ";
    }
    if idx == 0 { return " New Line  "; }
    return " Delete Ln ";
}

fn free_line_list(lines: &list<str8>) -> void {
    let _ = lines.len();
}

fn ensure_line_buffer(lines: list<str8>) -> list<str8> {
    if lines.len() > 0 {
        return lines;
    }
    var out: list<str8> = [];
    out.push(clone(""));
    return out;
}

fn split_text_lines(text: str8) -> list<str8> {
    var out: list<str8> = [];
    let n: i64 = len(text);
    let b: StringBuilder = builder_new(n + 16);
    var i: i64 = 0;
    while i < n {
        let ch: str8 = sub(text, i, 1);
        if eq(ch, "\r") == 1 {
            let line: str8 = builder_take_string(b);
            out.push(line);
            let nx: i64 = i + 1;
            if nx < n {
                let ch2: str8 = sub(text, nx, 1);
                if eq(ch2, "\n") == 1 {
                    free(ch2);
                    free(ch);
                    i = i + 2;
                    continue;
                }
                free(ch2);
            }
            free(ch);
            i = i + 1;
            continue;
        }
        if eq(ch, "\n") == 1 {
            let line2: str8 = builder_take_string(b);
            out.push(line2);
            free(ch);
            i = i + 1;
            continue;
        }
        let _ = builder_append(b, ch);
        free(ch);
        i = i + 1;
    }
    out.push(builder_take_string(b));
    builder_free(b);
    return ensure_line_buffer(out);
}

fn join_lines(lines: &list<str8>) -> str8 {
    let b: StringBuilder = builder_new(1024);
    for(i, line) in lines.enumerate() {
        let _ = builder_append(b, line);
        if i + 1 < lines.len() {
            let _ = builder_append(b, "\n");
        }
    }
    let out: str8 = builder_take_string(b);
    builder_free(b);
    return out;
}

fn replace_line(lines: &list<str8>, row: i64, new_line: str8) -> list<str8> {
    var out: list<str8> = [];
    for(i, line) in lines.enumerate() {
        if i == row {
            out.push(new_line);
        } else {
            out.push(clone(line));
        }
    }
    return ensure_line_buffer(out);
}

fn insert_line_after(lines: &list<str8>, row: i64, new_line: str8) -> list<str8> {
    var out: list<str8> = [];
    for(i, line) in lines.enumerate() {
        out.push(clone(line));
        if i == row {
            out.push(new_line);
        }
    }
    if lines.len() == 0 {
        out.push(new_line);
    }
    return ensure_line_buffer(out);
}

fn remove_line(lines: &list<str8>, row: i64) -> list<str8> {
    if lines.len() <= 1 {
        var blank: list<str8> = [];
        blank.push(clone(""));
        return blank;
    }
    var out: list<str8> = [];
    for(i, line) in lines.enumerate() {
        if i != row {
            out.push(clone(line));
        }
    }
    return ensure_line_buffer(out);
}

fn update_scroll(cursor_row: i64, cursor_col: i64, editor_rows: i64, editor_cols: i64,
                 scroll_row: i64, scroll_col: i64) -> list<i64> {
    var out: list<i64> = [];
    var next_scroll_row: i64 = scroll_row;
    var next_scroll_col: i64 = scroll_col;
    if cursor_row < next_scroll_row {
        next_scroll_row = cursor_row;
    }
    if cursor_row >= next_scroll_row + editor_rows {
        next_scroll_row = cursor_row - editor_rows + 1;
    }
    if cursor_col < next_scroll_col {
        next_scroll_col = cursor_col;
    }
    if cursor_col >= next_scroll_col + editor_cols {
        next_scroll_col = cursor_col - editor_cols + 1;
    }
    if next_scroll_row < 0 { next_scroll_row = 0; }
    if next_scroll_col < 0 { next_scroll_col = 0; }
    out.push(next_scroll_row);
    out.push(next_scroll_col);
    return out;
}

fn parse_key(input: Stdin) -> i32 {
    let keycode: i32 = read_keycode_nonblocking(input);
    if keycode == AsciiKey::Ack {
        return 1101;
    }
    if keycode == AsciiKey::Syn {
        return 1102;
    }
    if keycode == AsciiKey::Enq {
        return 1103;
    }
    if keycode == 0xC6 {
        var k2f: i32 = -2;
        var tries_f: i32 = 0;
        while tries_f < 4 && k2f == -2 {
            sleep_ms(2);
            k2f = read_keycode_nonblocking(stdin());
            tries_f = tries_f + 1;
        }
        if k2f == 0x92 {
            return 1101;
        }
        return keycode;
    }
    if keycode == 0xE2 {
        var k2v: i32 = -2;
        var tries_v1: i32 = 0;
        while tries_v1 < 4 && k2v == -2 {
            sleep_ms(2);
            k2v = read_keycode_nonblocking(stdin());
            tries_v1 = tries_v1 + 1;
        }
        if k2v == 0x88 {
            var k3v: i32 = -2;
            var tries_v2: i32 = 0;
            while tries_v2 < 4 && k3v == -2 {
                sleep_ms(2);
                k3v = read_keycode_nonblocking(stdin());
                tries_v2 = tries_v2 + 1;
            }
            if k3v == 0x9A {
                return 1102;
            }
        }
        return keycode;
    }
    if keycode == 0xC2 {
        var k2e: i32 = -2;
        var tries_e: i32 = 0;
        while tries_e < 4 && k2e == -2 {
            sleep_ms(2);
            k2e = read_keycode_nonblocking(stdin());
            tries_e = tries_e + 1;
        }
        if k2e == 0xB4 {
            return 1103;
        }
        return keycode;
    }
    if keycode != AsciiKey::Esc {
        return keycode;
    }

    let k2: i32 = read_keycode_nonblocking(stdin());
    if k2 == -2 {
        return AsciiKey::Esc;
    }
    if k2 == AsciiKey::LBracket {
        let k3: i32 = read_keycode_nonblocking(stdin());
        if k3 == AsciiKey::UpperA { return 1001; }
        if k3 == AsciiKey::UpperB { return 1002; }
        if k3 == AsciiKey::UpperC { return 1003; }
        if k3 == AsciiKey::UpperD { return 1004; }
        if k3 == AsciiKey::Digit3 {
            let k4: i32 = read_keycode_nonblocking(stdin());
            if k4 == AsciiKey::Tilde {
                return 1005;
            }
        }
        return AsciiKey::Esc;
    }
    if k2 == AsciiKey::LowerF || k2 == AsciiKey::UpperF { return 1101; }
    if k2 == AsciiKey::LowerV || k2 == AsciiKey::UpperV { return 1102; }
    if k2 == AsciiKey::LowerE || k2 == AsciiKey::UpperE { return 1103; }
    return AsciiKey::Esc;
}

fn open_file_into_buffer(path: str8) -> result<list<str8>, str8> {
    let rr: result<str8, str8> = read_all_text(path);
    if rr.is_err(): {
        return Err<list<str8>, str8>(rr.unwrap_err());
    }
    let text: str8 = rr.unwrap();
    let lines: list<str8> = split_text_lines(text);
    free(text);
    return Ok<list<str8>, str8>(lines);
}

fn menu_line(label: str8, is_open: i32) -> str8 {
    if is_open == 1 {
        return format!("{}{}{}{}{}", fg(color_white()), bg_rgb(32, 52, 120), bold_on(), label, reset());
    }
    return format!("{}{}{}{}", fg(color_black()), bg_rgb(228, 228, 220), label, reset());
}

fn render_frame(cols: i64, rows: i64, lines: &list<str8>, filename: str8, status: str8,
                menu_open: i32, menu_sel: i32, prompt_mode: i32, prompt_input: str8,
                cursor_row: i64, cursor_col: i64, scroll_row: i64, scroll_col: i64,
                dirty: i32, blink_visible: i32) -> str8 {
    let editor_rows: i64 = max_i64(1, rows - 3);
    let b: StringBuilder = builder_new(4096);
    let _ = builder_append(b, cursor(cmd_home()));
    let _ = builder_append(b, cursor(cmd_clear_screen()));
    let _ = builder_append(b, cursor(cmd_hide()));
    let _ = builder_append(b, cursor_color_reset());

    let file_tab: str8 = menu_line(" File ", menu_open == 1 ? 1 : 0);
    let view_tab: str8 = menu_line(" View ", menu_open == 2 ? 1 : 0);
    let edit_tab: str8 = menu_line(" Edit ", menu_open == 3 ? 1 : 0);
    let menu_raw: str8 = format!("{}{}{}{}", file_tab, view_tab, edit_tab, bg_rgb(228, 228, 220));
    let menu_fit: str8 = fit_right(menu_raw, cols, " ");
    let menu_line_out: str8 = format!("{}{}{}{}\r\n", fg(color_black()), bg_rgb(228, 228, 220), menu_fit, reset());
    let _ = builder_append(b, menu_line_out);

    let dirty_mark: str8 = dirty == 1 ? "*" : "";
    let header_raw: str8 = format!(" {}{} ", filename, dirty_mark);
    let header_fit: str8 = fit_right(header_raw, cols, " ");
    let header_line: str8 = format!("{}{}{}{}\r\n", fg(color_black()), bg_rgb(244, 244, 238), header_fit, reset());
    let _ = builder_append(b, header_line);

    var r: i64 = 0;
    while r < editor_rows {
        let line_idx: i64 = scroll_row + r;
        var line_out: str8 = "";
        if line_idx < lines.len() {
            let view_part: str8 = sub(lines[line_idx], scroll_col, cols);
            line_out = fit_right(view_part, cols, " ");
        } else {
            line_out = repeat(" ", cols);
        }
        let painted: str8 = format!("{}{}{}{}", fg(color_white()), bg_rgb(8, 24, 92), line_out, reset());
        let _ = builder_append(b, painted);
        if r + 1 < editor_rows {
            let _ = builder_append(b, "\r\n");
        }
        r = r + 1;
    }

    let status_text: str8 = prompt_mode == 1
        ? format!(" Open file: {}", prompt_input)
        : format!(" {}", status);
    let status_fit0: str8 = fit_right(status_text, cols, " ");
    let status_fit: str8 = sub(status_fit0, 0, cols);
    let status_line: str8 = format!("\r\n{}{}{}{}", fg(color_black()), bg_rgb(210, 210, 202), status_fit, reset());
    let _ = builder_append(b, status_line);

    if menu_open > 0 {
        let x: i32 = menu_anchor(menu_open);
        let w: i32 = menu_width(menu_open);
        let count: i32 = menu_count(menu_open);
        var i: i32 = 0;
        while i < count {
            let move: str8 = cursor_pos(2 + i, x);
            let label: str8 = menu_label(menu_open, i);
            let fit: str8 = fit_right(label, w, " ");
            let row_s: str8 = i == menu_sel
                ? format!("{}{}{}{}{}{}", move, fg(color_white()), bg_rgb(26, 26, 26), fit, reset(), "")
                : format!("{}{}{}{}{}{}", move, fg(color_black()), bg_rgb(238, 238, 232), fit, reset(), "");
            let _ = builder_append(b, row_s);
            i = i + 1;
        }
    }

    if prompt_mode == 1 {
        let prompt_col: i64 = min_i64(cols, 13 + len(prompt_input));
        let move2: str8 = cursor_pos(rows, prompt_col);
        let _ = builder_append(b, move2);
    } else {
        let cursor_y: i64 = clamp_i64(3 + (cursor_row - scroll_row), 3, rows - 1);
        let cursor_x: i64 = clamp_i64(1 + (cursor_col - scroll_col), 1, cols);
        let move3: str8 = cursor_pos(cursor_y, cursor_x);
        let _ = builder_append(b, move3);
        if menu_open == 0 && blink_visible == 1 {
            var cursor_cell: str8 = " ";
            if cursor_row < lines.len() {
                let line_now: str8 = lines[cursor_row];
                if cursor_col < len(line_now) {
                    cursor_cell = sub(line_now, cursor_col, 1);
                }
            }
            let cursor_mark: str8 = format!("{}{}{}{}{}", fg(color_white()), bg_rgb(8, 24, 92), inverse_on(), cursor_cell, reset());
            let _ = builder_append(b, cursor_mark);
        }
    }

    let out: str8 = builder_take_string(b);
    builder_free(b);
    return out;
}

fn main() -> i32 {
    if stdin_is_tty() == 0 {
        println!("notepad_demo requires a TTY");
        return 1;
    }

    let input: Stdin = stdin();
    var lines: list<str8> = [];
    lines.push(clone(""));

    var filename: str8 = clone("untitled.txt");
    var status: str8 = clone("Alt-F File  Alt-V View  Alt-E Edit  Esc closes menus");
    var prompt_input: str8 = clone("");

    var cursor_row: i64 = 0;
    var cursor_col: i64 = 0;
    var scroll_row: i64 = 0;
    var scroll_col: i64 = 0;
    var menu_open: i32 = 0;
    var menu_sel: i32 = 0;
    var prompt_mode: i32 = 0;
    var dirty: i32 = 0;
    var running: i32 = 1;
    var skip_lf_after_cr: i32 = 0;
    var blink_tick: i64 = 0;

    let _ = stdin_enable_raw();
    let _ = write(stdout(), alt_screen_on_real());

    while running == 1 {
        let ts: TermSize = stdout_size();
        let rows: i64 = max_i64(8, ts.rows);
        let cols: i64 = max_i64(30, ts.cols);
        let editor_rows: i64 = max_i64(1, rows - 3);
        let scroll_pair: list<i64> = update_scroll(cursor_row, cursor_col, editor_rows, cols, scroll_row, scroll_col);
        scroll_row = scroll_pair[0];
        scroll_col = scroll_pair[1];

        let blink_visible: i32 = ((blink_tick / 18) % 2) == 0 ? 1 : 0;
        let frame: str8 = render_frame(cols, rows, lines, filename, status, menu_open, menu_sel,
                                       prompt_mode, prompt_input, cursor_row, cursor_col,
                                       scroll_row, scroll_col, dirty, blink_visible);
        let _ = write(stdout(), frame);

        while 1 {
            let keycode: i32 = parse_key(input);
            if keycode == -2 {
                break;
            }
            if keycode < 0 {
                running = 0;
                break;
            }
            if skip_lf_after_cr == 1 && keycode == AsciiKey::Lf {
                skip_lf_after_cr = 0;
                continue;
            }
            if keycode != AsciiKey::Cr {
                skip_lf_after_cr = 0;
            }

            if prompt_mode == 1 {
                if keycode == AsciiKey::Esc {
                    prompt_mode = 0;
                    prompt_input = clone("");
                    status = clone("Open cancelled");
                    continue;
                }
                if keycode == AsciiKey::Backspace || keycode == AsciiKey::Del || keycode == 127 {
                    let n0: i64 = len(prompt_input);
                    if n0 > 0 {
                        let next_prompt: str8 = sub(prompt_input, 0, n0 - 1);
                        free(prompt_input);
                        prompt_input = next_prompt;
                    }
                    continue;
                }
                if keycode == AsciiKey::Cr || keycode == AsciiKey::Lf {
                    skip_lf_after_cr = keycode == AsciiKey::Cr ? 1 : 0;
                    let path: str8 = clone(prompt_input);
                    prompt_mode = 0;
                    if len(path) == 0 {
                        status = clone("Open cancelled");
                        continue;
                    }
                    let loaded: result<list<str8>, str8> = open_file_into_buffer(path);
                    if loaded.is_err(): {
                        status = format!("Open failed: {}", loaded.unwrap_err());
                        continue;
                    }
                    free_line_list(lines);
                    lines = loaded.unwrap();
                    filename = path;
                    cursor_row = 0;
                    cursor_col = 0;
                    scroll_row = 0;
                    scroll_col = 0;
                    dirty = 0;
                    status = format!("Opened {}", filename);
                    prompt_input = clone("");
                    continue;
                }
                if printable_ascii(keycode) == 1 {
                    let joined: str8 = append_char_to_owned(prompt_input, keycode);
                    prompt_input = joined;
                }
                continue;
            }

            if keycode == 1101 {
                menu_open = 1;
                menu_sel = 0;
                continue;
            }
            if keycode == 1102 {
                menu_open = 2;
                menu_sel = 0;
                continue;
            }
            if keycode == 1103 {
                menu_open = 3;
                menu_sel = 0;
                continue;
            }

            if menu_open > 0 {
                if keycode == AsciiKey::Esc {
                    menu_open = 0;
                    continue;
                }
                if keycode == 1004 {
                    menu_open = menu_open == 1 ? 3 : (menu_open - 1);
                    menu_sel = 0;
                    continue;
                }
                if keycode == 1003 {
                    menu_open = menu_open == 3 ? 1 : (menu_open + 1);
                    menu_sel = 0;
                    continue;
                }
                if keycode == 1001 {
                    let count0: i32 = menu_count(menu_open);
                    menu_sel = menu_sel == 0 ? (count0 - 1) : (menu_sel - 1);
                    continue;
                }
                if keycode == 1002 {
                    let count1: i32 = menu_count(menu_open);
                    menu_sel = menu_sel + 1 >= count1 ? 0 : (menu_sel + 1);
                    continue;
                }
                if keycode == AsciiKey::Cr || keycode == AsciiKey::Lf {
                    skip_lf_after_cr = keycode == AsciiKey::Cr ? 1 : 0;
                    if menu_open == 1 {
                        if menu_sel == 0 {
                            prompt_mode = 1;
                            prompt_input = clone(filename);
                            status = clone("Type a path and press Enter");
                        } else if menu_sel == 1 {
                            let text: str8 = join_lines(lines);
                            let wr: result<i32, str8> = write_all_text(filename, text);
                            if wr.is_err(): {
                                status = format!("Save failed: {}", wr.unwrap_err());
                            } else {
                                dirty = 0;
                                status = format!("Saved {}", filename);
                            }
                        } else {
                            running = 0;
                        }
                    } else if menu_open == 2 {
                        if menu_sel == 0 {
                            cursor_row = 0;
                            cursor_col = 0;
                            status = clone("Moved to top");
                        } else {
                            cursor_row = lines.len() - 1;
                            cursor_col = len(lines[cursor_row]);
                            status = clone("Moved to bottom");
                        }
                    } else {
                        if menu_sel == 0 {
                            let next_lines: list<str8> = insert_line_after(lines, cursor_row, clone(""));
                            free_line_list(lines);
                            lines = next_lines;
                            cursor_row = min_i64(cursor_row + 1, lines.len() - 1);
                            cursor_col = 0;
                            dirty = 1;
                            status = clone("Inserted line");
                        } else {
                            let next_lines2: list<str8> = remove_line(lines, cursor_row);
                            free_line_list(lines);
                            lines = next_lines2;
                            cursor_row = clamp_i64(cursor_row, 0, lines.len() - 1);
                            cursor_col = clamp_i64(cursor_col, 0, len(lines[cursor_row]));
                            dirty = 1;
                            status = clone("Deleted line");
                        }
                    }
                    menu_open = 0;
                    continue;
                }
                continue;
            }

            if keycode == AsciiKey::Etx {
                running = 0;
                break;
            }

            if keycode == 1001 {
                cursor_row = cursor_row <= 0 ? 0 : (cursor_row - 1);
                cursor_col = clamp_i64(cursor_col, 0, len(lines[cursor_row]));
                continue;
            }
            if keycode == 1002 {
                cursor_row = cursor_row + 1 >= lines.len() ? (lines.len() - 1) : (cursor_row + 1);
                cursor_col = clamp_i64(cursor_col, 0, len(lines[cursor_row]));
                continue;
            }
            if keycode == 1003 {
                let cur_len_r: i64 = len(lines[cursor_row]);
                cursor_col = cursor_col >= cur_len_r ? cur_len_r : (cursor_col + 1);
                continue;
            }
            if keycode == 1004 {
                cursor_col = cursor_col <= 0 ? 0 : (cursor_col - 1);
                continue;
            }

            if keycode == AsciiKey::Cr || keycode == AsciiKey::Lf {
                skip_lf_after_cr = keycode == AsciiKey::Cr ? 1 : 0;
                let current: str8 = lines[cursor_row];
                let left: str8 = sub(current, 0, cursor_col);
                let right: str8 = sub(current, cursor_col, len(current) - cursor_col);
                let replaced: list<str8> = replace_line(lines, cursor_row, left);
                let inserted: list<str8> = insert_line_after(replaced, cursor_row, right);
                free_line_list(replaced);
                free_line_list(lines);
                lines = inserted;
                cursor_row = cursor_row + 1;
                cursor_col = 0;
                dirty = 1;
                continue;
            }

            if keycode == AsciiKey::Backspace || keycode == AsciiKey::Del || keycode == 127 {
                if cursor_col > 0 {
                    let current2: str8 = lines[cursor_row];
                    let left2: str8 = sub(current2, 0, cursor_col - 1);
                    let right2: str8 = sub(current2, cursor_col, len(current2) - cursor_col);
                    let merged: str8 = concat(left2, right2);
                    let next_lines3: list<str8> = replace_line(lines, cursor_row, merged);
                    free_line_list(lines);
                    lines = next_lines3;
                    cursor_col = cursor_col - 1;
                    dirty = 1;
                } else if cursor_row > 0 {
                    let prev: str8 = lines[cursor_row - 1];
                    let cur: str8 = lines[cursor_row];
                    let merged2: str8 = concat(prev, cur);
                    let tmp: list<str8> = replace_line(lines, cursor_row - 1, merged2);
                    let next_lines4: list<str8> = remove_line(tmp, cursor_row);
                    free_line_list(tmp);
                    free_line_list(lines);
                    lines = next_lines4;
                    cursor_row = cursor_row - 1;
                    cursor_col = len(lines[cursor_row]);
                    dirty = 1;
                }
                continue;
            }

            if keycode == 1005 {
                let current3: str8 = lines[cursor_row];
                let cur_len_d: i64 = len(current3);
                if cursor_col < cur_len_d {
                    let left3: str8 = sub(current3, 0, cursor_col);
                    let right3: str8 = sub(current3, cursor_col + 1, cur_len_d - cursor_col - 1);
                    let merged3: str8 = concat(left3, right3);
                    let next_lines5: list<str8> = replace_line(lines, cursor_row, merged3);
                    free_line_list(lines);
                    lines = next_lines5;
                    dirty = 1;
                } else if cursor_row + 1 < lines.len() {
                    let next_line: str8 = lines[cursor_row + 1];
                    let merged4: str8 = concat(current3, next_line);
                    let tmp2: list<str8> = replace_line(lines, cursor_row, merged4);
                    let next_lines6: list<str8> = remove_line(tmp2, cursor_row + 1);
                    free_line_list(tmp2);
                    free_line_list(lines);
                    lines = next_lines6;
                    dirty = 1;
                }
                continue;
            }

            if keycode == AsciiKey::Tab {
                var t: i32 = 0;
                while t < 4 {
                    let current4: str8 = lines[cursor_row];
                    let left4: str8 = sub(current4, 0, cursor_col);
                    let right4: str8 = sub(current4, cursor_col, len(current4) - cursor_col);
                    let left_plus: str8 = concat(left4, " ");
                    let merged5: str8 = concat(left_plus, right4);
                    let next_lines7: list<str8> = replace_line(lines, cursor_row, merged5);
                    free_line_list(lines);
                    lines = next_lines7;
                    cursor_col = cursor_col + 1;
                    dirty = 1;
                    t = t + 1;
                }
                continue;
            }

            if printable_ascii(keycode) == 1 {
                let current5: str8 = lines[cursor_row];
                let left5: str8 = sub(current5, 0, cursor_col);
                let right5: str8 = sub(current5, cursor_col, len(current5) - cursor_col);
                let left_plus2: str8 = append_char_to_owned(left5, keycode);
                let merged6: str8 = concat(left_plus2, right5);
                let next_lines8: list<str8> = replace_line(lines, cursor_row, merged6);
                free_line_list(lines);
                lines = next_lines8;
                cursor_col = cursor_col + 1;
                dirty = 1;
                continue;
            }
        }

        sleep_ms(16);
        blink_tick = blink_tick + 1;
    }

    let _ = stdin_restore();
    let _ = write(stdout(), reset());
    let _ = write(stdout(), cursor(cmd_show()));
    let _ = write(stdout(), cursor_color_reset());
    let _ = write(stdout(), alt_screen_off_real());
    let _ = write(stdout(), "\r\n");

    free_line_list(lines);
    return 0;
}
