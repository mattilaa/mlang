/// \file branch_prediction_demo.mla
/// @ingroup examples
/// \brief Demonstrates likely/unlikely optimization hints on runtime branches.

fn classify(value: i32) -> i32 {
    likely if value > 0 {
        return 1;
    } else unlikely if value == 0 {
        return 0;
    } else {
        return -1;
    }
}

fn main() -> i32 {
    println!("positive={}, zero={}, negative={}",
             classify(42), classify(0), classify(-7));
    return 0;
}
