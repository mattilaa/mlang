/// \file closure_thread.mla
/// @ingroup examples
/// \brief Spawning a worker thread with a captured closure.
///
// Example: thread::spawn with closure syntax
mod std::thread;
use std::thread::*;

fn main() -> i32 {
    // Spawn a thread with a closure (|| { ... } syntax)
    let h1: std::thread::thread = thread::spawn(|| {
        println!("hello from spawned thread!");
    });
    join(h1);

    // Closure with a loop
    let h2: std::thread::thread = thread::spawn(|| {
        var i: i32 = 0;
        for i in 0..3 {
            println!("thread loop iteration {}", i);
        }
    });
    join(h2);

    // The stdlib spawn entrypoint also accepts closures.
    let h3: std::thread::thread = thread::spawn(|| {
        println!("spawned via stdlib entrypoint with closure");
    });
    join(h3);

    println!("all threads done");
    return 0;
}
