/// \file type_alias_demo.mla
/// @ingroup examples
/// \brief `alias` / `use type` type-alias declaration demo.
///
/// Demonstrates type aliases:
/// - concrete alias: alias Distance = f32;
/// - implicit generic alias: alias SomeMap = map<K, V>;
/// - explicit generic alias: alias VecAlias<T> = list<T>;
/// - `use type Name = Type;` remains valid and equivalent.

// Distance meters of from point to point
alias Distance = f32;
alias SomeMap = map<K, V>;
alias VecAlias<T> = list<T>;

fn average(a: Distance, b: Distance) -> Distance {
    return(a + b) / 2.0f;
}

fn main() -> i32 {
    let d1: Distance = 10.0f;
    let d2: Distance = 14.0f;
    println!("avg={}", average(d1, d2));

    let scores: SomeMap<str8, i32> = { "Alice": 95, "Bob": 87 };
    println!("alice={}", scores["Alice"]);

    let ids: VecAlias<i32> = [7, 8, 9];
    println!("ids.len={}", ids.len());

    {
        alias Distance = i32;
        let grid: Distance = 42;
        println!("grid={}", grid);
    }

    let precise: Distance = 1.5f;
    println!("precise={}", precise);
    return 0;
}
