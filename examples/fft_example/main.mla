fn abs_i64(x: i64) -> i64 {
    return x < 0 ? 0 - x : x;
}

fn clamp_i64(x: i64, lo: i64, hi: i64) -> i64 {
    if x < lo {
        return lo;
    }
    if x > hi {
        return hi;
    }
    return x;
}

fn viewport_width(cols: i32) -> i64 {
    // Keep two spare columns to avoid terminal right-edge autowrap jitter.
    let w: i64 = cols - 2;
    if w < 1 {
        return 1;
    }
    return w > 200 ? 200 : w;
}

fn viewport_height(rows: i32) -> i64 {
    // Use live terminal rows directly; graph_h reserves header rows.
    if rows < 4 {
        return 4;
    }
    return rows > 80 ? 80 : rows;
}

fn choose_fft_window(width: i64) -> i32 {
    // Positive-frequency bins are window/2; keep enough bins but prioritize UI FPS.
    var want: i64 = width * 8;
    if want < 1024 {
        want = 1024;
    }
    if want > 8192 {
        want = 8192;
    }
    var w: i64 = 1;
    while w < want {
        w = w * 2;
    }
    if w > 8192 {
        w = 8192;
    }
    return w;
}

fn scale_height(mag: i64, max_mag: i64, graph_h: i64) -> i64 {
    if mag <= 0 || max_mag <= 0 {
        return 0;
    }
    let h: i64 = (mag * graph_h + max_mag - 1) / max_mag;
    return clamp_i64(h, 0, graph_h);
}

fn log2_i64(v: i64) -> i64 {
    var x: i64 = v;
    var p: i64 = 0;
    while x > 1 {
        x = x / 2;
        p = p + 1;
    }
    return p;
}

fn scale_height_log(mag: i64, floor_mag: i64, max_mag: i64, graph_h: i64) -> i64 {
    if mag <= floor_mag || max_mag <= floor_mag {
        return 0;
    }
    let a: i64 = log2_i64(mag + 1);
    let f: i64 = log2_i64(floor_mag + 1);
    let m: i64 = log2_i64(max_mag + 1);
    if m <= f {
        return 0;
    }
    let num: i64 = a > f ? (a - f) : 0;
    let den: i64 = m - f;
    let h: i64 = (num * graph_h + den - 1) / den;
    return clamp_i64(h, 0, graph_h);
}

fn freq_base_r(permille: i64) -> i64 {
    // Tune: lows greener/darker, highs redder/brighter.
    if permille <= 300 {
        return 18 + (permille * 34) / 300;
    }
    if permille <= 650 {
        return 52 + ((permille - 300) * 168) / 350;
    }
    return 220 + ((permille - 650) * 35) / 350;
}

fn freq_base_g(permille: i64) -> i64 {
    if permille <= 220 {
        return 120 + (permille * 130) / 220;
    }
    if permille <= 620 {
        return 250 - ((permille - 220) * 90) / 400;
    }
    return 160 - ((permille - 620) * 140) / 380;
}

fn freq_base_b(permille: i64) -> i64 {
    if permille <= 260 {
        return 96 + (permille * 94) / 260;
    }
    if permille <= 640 {
        return 190 - ((permille - 260) * 155) / 380;
    }
    return 35 - ((permille - 640) * 27) / 360;
}

fn clamp_i32(x: i32, lo: i32, hi: i32) -> i32 {
    if x < lo {
        return lo;
    }
    if x > hi {
        return hi;
    }
    return x;
}

fn max3_i64(a: i64, b: i64, c: i64) -> i64 {
    var m: i64 = a;
    if b > m {
        m = b;
    }
    if c > m {
        m = c;
    }
    return m;
}

fn draw_rgb_block(on_l: i32, on_r: i32, r: i64, g: i64, b: i64, dot_mode: i32, dark_bg: i32,
                  shade_mode: i32, dist_from_top: i64, half_cap: i32) -> void {
    var rr: i32 = r;
    var gg: i32 = g;
    var bb: i32 = b;
    if on_l == 1 && on_r == 0 {
        gg = gg + 18;
        bb = bb + 28;
    } else if on_l == 0 && on_r == 1 {
        rr = rr + 28;
        bb = bb + 18;
    }
    rr = clamp_i32(rr, 0, 255);
    gg = clamp_i32(gg, 0, 255);
    bb = clamp_i32(bb, 0, 255);
    let bg_s: str8 = dark_bg == 1 ? bg_rgb(12, 18, 38) : bg_rgb(0, 0, 0);
    if dot_mode == 1 {
        print!("{}{}{}", fg_rgb(rr, gg, bb), bg_s, unicode_box_glyph(UnicodeBoxGlyph::Dot));
    } else {
        if half_cap == 1 {
            print!("{}{}{}", fg_rgb(rr, gg, bb), bg_s, unicode_box_glyph(UnicodeBoxGlyph::LowerHalfBlock));
        } else if shade_mode == 1 {
            if dist_from_top <= 0 {
                print!("{}{}{}", fg_rgb(rr, gg, bb), bg_s, unicode_box_glyph(UnicodeBoxGlyph::LightShade));
            } else if dist_from_top == 1 {
                print!("{}{}{}", fg_rgb(rr, gg, bb), bg_s, unicode_box_glyph(UnicodeBoxGlyph::MediumShade));
            } else if dist_from_top == 2 {
                print!("{}{}{}", fg_rgb(rr, gg, bb), bg_s, unicode_box_glyph(UnicodeBoxGlyph::DarkShade));
            } else {
                print!("{}{}{}", fg_rgb(rr, gg, bb), bg_s, unicode_box_glyph(UnicodeBoxGlyph::FullBlock));
            }
        } else {
            let level: i64 = (rr + gg + bb) / 3;
            print!("{}{}{}", fg_rgb(rr, gg, bb), bg_s, unicode_density_glyph(level, 255));
        }
    }
}

fn cursor_force(cmd: i32) -> str8 {
    let gated: str8 = cursor(cmd);
    if len(gated) > 0 {
        return gated;
    }
    return __mlang_std_esc_cursor_code(cmd);
}

fn max_hz_for_axis(sr: i64) -> i64 {
    var out: i64 = sr / 2;
    if out > 20000 {
        out = 20000;
    }
    if out < 1000 {
        out = 1000;
    }
    return out;
}

fn x_for_hz_calibrated(hz_in: i64, width: i64, sr: i64) -> i64 {
    if width <= 1 {
        return 0;
    }
    let max_hz: i64 = max_hz_for_axis(sr);
    // Frequency anchors and display-position anchors (permille of width).
    // This keeps 20-100 close while preserving readable mid/high distribution.
    let hz_anchors: list<i64> = [20, 100, 500, 1000, 4000, 8000, 16000, 20000];
    let x_anchors: list<i64> = [0, 40, 200, 360, 620, 780, 910, 980];
    let nseg: i64 = hz_anchors.len() - 1;
    let hz: i64 = clamp_i64(hz_in, 20, max_hz);
    var seg: i64 = 0;
    var scan: i64 = 0;
    while scan < (nseg - 1) {
        let nxt: i64 = scan + 1;
        let a_next: i64 = hz_anchors[nxt];
        if a_next < hz {
            seg = nxt;
        }
        scan = nxt;
    }
    var h0: i64 = hz_anchors[seg];
    var h1: i64 = hz_anchors[seg + 1];
    if h0 > max_hz {
        h0 = max_hz;
    }
    if h1 > max_hz {
        h1 = max_hz;
    }
    let x0p: i64 = x_anchors[seg];
    let x1p: i64 = x_anchors[seg + 1];
    if h1 <= h0 {
        return clamp_i64((x0p * (width - 1)) / 1000, 0, width - 1);
    }
    let xp: i64 = x0p + (((hz - h0) * (x1p - x0p)) / (h1 - h0));
    return clamp_i64((xp * (width - 1)) / 1000, 0, width - 1);
}

fn hz_for_x_calibrated(x: i64, width: i64, sr: i64) -> i64 {
    if width <= 1 {
        return 20;
    }
    let max_hz: i64 = max_hz_for_axis(sr);
    let hz_anchors: list<i64> = [20, 100, 500, 1000, 4000, 8000, 16000, 20000];
    let x_anchors: list<i64> = [0, 40, 200, 360, 620, 780, 910, 980];
    let nseg: i64 = hz_anchors.len() - 1;
    let xp: i64 = (x * 1000) / (width - 1);

    var seg: i64 = 0;
    var scan: i64 = 0;
    while scan < (nseg - 1) {
        let nxt: i64 = scan + 1;
        let x_next: i64 = x_anchors[nxt];
        if x_next < xp {
            seg = nxt;
        }
        scan = nxt;
    }

    let x0p: i64 = x_anchors[seg];
    let x1p: i64 = x_anchors[seg + 1];
    let h0: i64 = hz_anchors[seg];
    var h1: i64 = hz_anchors[seg + 1];
    if h1 > max_hz {
        h1 = max_hz;
    }
    if x1p <= x0p {
        return clamp_i64(h0, 20, max_hz);
    }
    let hz: i64 = h0 + (((xp - x0p) * (h1 - h0)) / (x1p - x0p));
    return clamp_i64(hz, 20, max_hz);
}

fn bin_for_x_calibrated(x: i64, width: i64, fft_window: i32, sr: i64, bins: i64) -> i64 {
    if fft_window <= 0 || sr <= 0 || bins <= 3 {
        return 2;
    }
    let hz: i64 = hz_for_x_calibrated(x, width, sr);
    let b: i64 = (hz * fft_window) / sr;
    return clamp_i64(b, 2, bins - 2);
}

fn draw_freq_axis(width: i64, bins: i64, fft_window: i32, sr: i64) -> void {
    print!("{}", cursor_force(cmd_clear_line()));
    print!("{}{}", fg(color_black()), bg(color_white()));

    let x20: i64 = x_for_hz_calibrated(20, width, sr);
    let x100: i64 = x_for_hz_calibrated(100, width, sr);
    let x500: i64 = x_for_hz_calibrated(500, width, sr);
    let x1k: i64 = x_for_hz_calibrated(1000, width, sr);
    let x4k: i64 = x_for_hz_calibrated(4000, width, sr);
    let x8k: i64 = x_for_hz_calibrated(8000, width, sr);
    let x16k: i64 = x_for_hz_calibrated(16000, width, sr);

    var cur: i64 = 0;

    var p: i64 = x20;
    if p > cur {
        for _i in cur..p { print!(" "); }
        cur = p;
    }
    if p < width {
        let t: str8 = "20Hz";
        let tl: i64 = len(t);
        if p + tl <= width {
            print!("{}", t);
            cur = cur + tl;
        }
    }

    p = x100;
    if p > cur {
        for _i in cur..p { print!(" "); }
        cur = p;
    }
    if p < width {
        let t: str8 = "100Hz";
        let tl: i64 = len(t);
        if p + tl <= width {
            print!("{}", t);
            cur = cur + tl;
        }
    }

    p = x500;
    if p > cur {
        for _i in cur..p { print!(" "); }
        cur = p;
    }
    if p < width {
        let t: str8 = "500Hz";
        let tl: i64 = len(t);
        if p + tl <= width {
            print!("{}", t);
            cur = cur + tl;
        }
    }

    p = x1k;
    if p > cur {
        for _i in cur..p { print!(" "); }
        cur = p;
    }
    if p < width {
        let t: str8 = "1KHz";
        let tl: i64 = len(t);
        if p + tl <= width {
            print!("{}", t);
            cur = cur + tl;
        }
    }

    p = x4k;
    if p > cur {
        for _i in cur..p { print!(" "); }
        cur = p;
    }
    if p < width {
        let t: str8 = "4KHz";
        let tl: i64 = len(t);
        if p + tl <= width {
            print!("{}", t);
            cur = cur + tl;
        }
    }

    p = x8k;
    if p > cur {
        for _i in cur..p { print!(" "); }
        cur = p;
    }
    if p < width {
        let t: str8 = "8KHz";
        let tl: i64 = len(t);
        if p + tl <= width {
            print!("{}", t);
            cur = cur + tl;
        }
    }

    p = x16k;
    if p > cur {
        for _i in cur..p { print!(" "); }
        cur = p;
    }
    if p < width {
        let t: str8 = "16KHz";
        let tl: i64 = len(t);
        if p + tl <= width {
            print!("{}", t);
            cur = cur + tl;
        }
    }

    if cur < width {
        for _i in cur..width {
            print!(" ");
        }
    }
    // No trailing newline here; prevents terminal scroll/jitter per frame.
    print!("{}", reset());
}

fn begin_white_bar_line(width: i64) -> void {
    print!("{}", cursor_force(cmd_clear_line()));
    print!("{}{}", fg(color_black()), bg(color_white()));
    for _i in 0..width {
        print!(" ");
    }
    print!("\r");
    print!("{}{}", fg(color_black()), bg(color_white()));
}

fn fmt2(v: i64) -> str8 {
    return v < 10 ? format!("0{}", v) : format!("{}", v);
}

fn format_timecode(seconds_in: i64) -> str8 {
    let sec: i64 = seconds_in < 0 ? 0 : seconds_in;
    let hh: i64 = sec / 3600;
    let mm: i64 = (sec / 60) % 60;
    let ss: i64 = sec % 60;
    if hh > 0 {
        return format!("{}:{}:{}", fmt2(hh), fmt2(mm), fmt2(ss));
    }
    return format!("{}:{}", fmt2(mm), fmt2(ss));
}

fn draw_progress_row(width: i64, cur_frame: i64, total_frames: i64, sr: i64) -> void {
    print!("{}", cursor_force(cmd_clear_line()));
    print!("{}{}", fg(color_black()), bg(color_white()));

    let cur_sec: i64 = sr > 0 ? (cur_frame / sr) : 0;
    let tot_sec: i64 = sr > 0 ? (total_frames / sr) : 0;
    let t_now: str8 = format_timecode(cur_sec);
    let t_end: str8 = format_timecode(tot_sec);
    let head: str8 = format!(" {} / {} ", t_now, t_end);
    print!("{}", head);

    var used: i64 = len(head);
    var bar_w: i64 = width - used - 2;
    if bar_w < 8 {
        bar_w = 8;
    }
    if bar_w > (width - used) {
        bar_w = width - used;
    }
    if bar_w < 0 {
        bar_w = 0;
    }

    var filled: i64 = 0;
    if total_frames > 0 && bar_w > 0 {
        filled = clamp_i64((cur_frame * bar_w) / total_frames, 0, bar_w);
    }

    if bar_w > 0 {
        print!("[");
        var i: i64 = 0;
        while i < bar_w {
            if i < filled {
                print!("█");
            } else {
                print!("·");
            }
            i = i + 1;
        }
        print!("]");
        used = used + bar_w + 2;
    }

    if used < width {
        for _i in used..width {
            print!(" ");
        }
    }
    print!("{}", reset());
}

fn render_frame(freq_l: list<i64>, freq_r: list<i64>, width: i64, height: i64,
                cur_frame: i64, total_frames: i64, fft_sr: i64, time_sr: i64, mode: i32, fft_window: i32,
                dot_mode: i32, dark_bg: i32, log_scale: i32, detail_mode: i32, shade_mode: i32,
                flash_threshold: i32, flash_mode: i32) -> void {
    // 1 header + 1 frequency axis + 1 progress row.
    let graph_h: i64 = height - 3;
    let bins_full: i64 = (freq_l.len() / 2);
    // FFT on real-valued audio is mirrored; render only positive frequencies.
    let bins: i64 = bins_full / 2;
    if bins <= 4 {
        return;
    }

    print!("{}{}", cursor_force(cmd_home()), reset());
    begin_white_bar_line(width);
    let cur_sec: i64 = time_sr > 0 ? (cur_frame / time_sr) : 0;
    let pos_time: str8 = format_timecode(cur_sec);
    print!(
        "FFT {}x{} sr={} pos={} L=cyan R=magenta B=yellow/white ",
        width, height, fft_sr, pos_time
    );
    print!(
        "mode={} glyph={} bg={} log={} flash={}({}) detail={} shade={} ",
        mode == 1 ? "music" : "flat",
        dot_mode == 1 ? "dot" : "block",
        dark_bg == 1 ? "blue" : "black",
        log_scale,
        flash_threshold,
        flash_mode == 1 ? "on" : "off",
        detail_mode == 1 ? "on" : "off",
        shade_mode == 1 ? "on" : "off"
    );
    print!(
        "[h/l seek f/m/x/b/d/D v flash +/- flash h/l seek q] win={} frame={}/{}\r\n",
        fft_window, cur_frame, total_frames
    );
    print!("{}", reset());

    var col_hl: Vec<i64> = Vec::new();
    var col_hr: Vec<i64> = Vec::new();
    var col_half_l: Vec<i64> = Vec::new();
    var col_half_r: Vec<i64> = Vec::new();

    var max_l: i64 = 0;
    var max_r: i64 = 0;
    for b in 2..(bins - 1) {
        let base: i64 = b * 2;
        let raw_l: i64 = abs_i64(freq_l[base]) + abs_i64(freq_l[base + 1]);
        let raw_r: i64 = abs_i64(freq_r[base]) + abs_i64(freq_r[base + 1]);
        let weight: i64 = mode == 1 ? (b + 1) : 1;
        let ml: i64 = raw_l * weight;
        let mr: i64 = raw_r * weight;
        if ml > max_l {
            max_l = ml;
        }
        if mr > max_r {
            max_r = mr;
        }
    }

    var max_ref: i64 = max_l > max_r ? max_l : max_r;
    if max_ref < 1 {
        max_ref = 1;
    }
    let noise_floor: i64 = mode == 1 ? (max_ref / 8) : (max_ref / 1200);
    let max_vis: i64 = max_ref;

    var col_ml: Vec<i64> = Vec::new();
    var col_mr: Vec<i64> = Vec::new();
    var col_density: Vec<i64> = Vec::new();
    var col_r: Vec<i64> = Vec::new();
    var col_g: Vec<i64> = Vec::new();
    var col_b: Vec<i64> = Vec::new();
    var max_density: i64 = 1;
    for x in 0..width {
        // True logarithmic horizontal frequency mapping.
        let b: i64 = bin_for_x_calibrated(x, width, fft_window, fft_sr, bins);
        var spread: i64 = 1;
        if detail_mode == 1 {
            // In detailed mode keep low bins sharper (narrower neighborhood).
            let p: i64 = width > 1 ? (x * 1000) / (width - 1) : 0;
            if p < 520 {
                spread = 0;
            } else if p < 820 {
                spread = 1;
            } else {
                spread = 2;
            }
        }
        let b0: i64 = b > (2 + spread) ? (b - spread) : 2;
        let b1: i64 = b;
        let b2: i64 = b < ((bins - 2) - spread) ? (b + spread) : (bins - 2);
        let base0: i64 = b0 * 2;
        let base1: i64 = b1 * 2;
        let base2: i64 = b2 * 2;
        let l0: i64 = abs_i64(freq_l[base0]) + abs_i64(freq_l[base0 + 1]);
        let l1: i64 = abs_i64(freq_l[base1]) + abs_i64(freq_l[base1 + 1]);
        let l2: i64 = abs_i64(freq_l[base2]) + abs_i64(freq_l[base2 + 1]);
        let r0: i64 = abs_i64(freq_r[base0]) + abs_i64(freq_r[base0 + 1]);
        let r1: i64 = abs_i64(freq_r[base1]) + abs_i64(freq_r[base1 + 1]);
        let r2: i64 = abs_i64(freq_r[base2]) + abs_i64(freq_r[base2 + 1]);
        let m_l0: i64 = max3_i64(l0, l1, l2);
        let m_r0: i64 = max3_i64(r0, r1, r2);
        let weight: i64 = mode == 1 ? (b + 1) : 1;
        let raw_l: i64 = m_l0 * weight;
        let raw_r: i64 = m_r0 * weight;
        var ml: i64 = raw_l > noise_floor ? (raw_l - noise_floor) : 0;
        var mr: i64 = raw_r > noise_floor ? (raw_r - noise_floor) : 0;
        if mode == 1 {
            // Mild display EQ for music mode.
            let eq_num: i64 = x + (width / 6) + 1;
            let eq_den: i64 = width + 1;
            ml = (ml * eq_num) / eq_den;
            mr = (mr * eq_num) / eq_den;
        }
        let density: i64 = b2 - b0 + 1;
        if density > max_density {
            max_density = density;
        }
        col_density.push(density);
        let floor_mag: i64 = mode == 1 ? noise_floor : (noise_floor / 8);
        let hl2: i64 = scale_height_log(ml, floor_mag, max_vis, graph_h * 2);
        let hr2: i64 = scale_height_log(mr, floor_mag, max_vis, graph_h * 2);
        let hl2_shrunk: i64 = (hl2 * 3) / 4;
        let hr2_shrunk: i64 = (hr2 * 3) / 4;
        // Keep log scaling in a conservative stable range to avoid extreme
        // magnification/compression behavior in live rendering.
        let hs: i64 = clamp_i64(log_scale, 50, 200);
        let hl2_scaled: i64 = clamp_i64((hl2_shrunk * 100) / hs, 0, graph_h * 2);
        let hr2_scaled: i64 = clamp_i64((hr2_shrunk * 100) / hs, 0, graph_h * 2);
        var hlf: i64 = hl2_scaled / 2;
        var hrf: i64 = hr2_scaled / 2;
        var hhalf_l: i64 = hl2_scaled % 2;
        var hhalf_r: i64 = hr2_scaled % 2;
        if hl2_scaled < 2 {
            hlf = 0;
            hhalf_l = 0;
        }
        if hr2_scaled < 2 {
            hrf = 0;
            hhalf_r = 0;
        }

        col_hl.push(hlf);
        col_hr.push(hrf);
        col_half_l.push(hhalf_l);
        col_half_r.push(hhalf_r);
        col_ml.push(ml);
        col_mr.push(mr);

        let permille: i64 = width > 1 ? (x * 1000) / (width - 1) : 0;
        col_r.push(freq_base_r(permille));
        col_g.push(freq_base_g(permille));
        col_b.push(freq_base_b(permille));
    }

    // Brightness scales from both energy and how many source bins feed a column.
    // Use a non-linear (square) energy curve for a stronger visual response.
    var col_lum: Vec<i64> = Vec::new();
    for x in 0..width {
        let ml: i64 = col_ml[x];
        let mr: i64 = col_mr[x];
        let peak: i64 = ml > mr ? ml : mr;
        let amp: i64 = max_vis > 0 ? clamp_i64((peak * 255) / max_vis, 0, 255) : 0;
        let gate: i64 = flash_mode == 1 ? clamp_i64(flash_threshold, 0, 240) : 0;
        var amp_eff: i64 = amp - gate;
        if amp_eff < 0 {
            amp_eff = 0;
        }
        var gate_span: i64 = 255 - gate;
        if gate_span < 1 {
            gate_span = 1;
        }
        let amp_norm: i64 = clamp_i64((amp_eff * 255) / gate_span, 0, 255);
        let amp_nl: i64 = (amp_norm * amp_norm) / 255;
        let dens: i64 = col_density[x];
        var dens_boost: i64 = 82 + (dens * 173) / max_density;
        if detail_mode == 1 && x < (width / 2) {
            dens_boost = 54 + (dens * 120) / max_density;
        }
        let lum: i64 = clamp_i64((amp_nl * 3 + dens_boost * 2) / 5, 18, 255);
        col_lum.push(lum);
    }

    // Fill isolated horizontal holes so columns look continuous across x.
    var fix_l: Vec<i64> = Vec::new();
    var fix_r: Vec<i64> = Vec::new();
    var fix_half_l: Vec<i64> = Vec::new();
    var fix_half_r: Vec<i64> = Vec::new();
    for x in 0..width {
        var hl: i64 = col_hl[x];
        var hr: i64 = col_hr[x];
        var hh_l: i64 = col_half_l[x];
        var hh_r: i64 = col_half_r[x];
        if x > 0 && x < (width - 1) {
            let ll: i64 = col_hl[x - 1];
            let rl: i64 = col_hl[x + 1];
            let lr: i64 = col_hr[x - 1];
            let rr: i64 = col_hr[x + 1];
            let allow_fill: i32 = detail_mode == 1 && x < (width / 2) ? 0 : 1;
            if allow_fill == 1 && hl == 0 && ll > 0 && rl > 0 {
                hl = (ll + rl) / 2;
                hh_l = 0;
            }
            if allow_fill == 1 && hr == 0 && lr > 0 && rr > 0 {
                hr = (lr + rr) / 2;
                hh_r = 0;
            }
        }
        fix_l.push(hl);
        fix_r.push(hr);
        fix_half_l.push(hh_l);
        fix_half_r.push(hh_r);
    }
    col_hl = fix_l;
    col_hr = fix_r;
    col_half_l = fix_half_l;
    col_half_r = fix_half_r;

    var row: i64 = graph_h;
    while row > 0 {
        row = row - 1;
        // Pre-fill row with very dark blue background, then overlay FFT cells.
        if dark_bg == 1 {
            print!("{}", bg_rgb(12, 18, 38));
        } else {
            print!("{}", bg_rgb(0, 0, 0));
        }
        for _i in 0..width {
            print!(" ");
        }
        print!("\r");
        if dark_bg == 1 {
            print!("{}", bg_rgb(12, 18, 38));
        } else {
            print!("{}", bg_rgb(0, 0, 0));
        }
        for x in 0..width {
            let ml: i64 = col_ml[x];
            let mr: i64 = col_mr[x];
            let hl: i64 = col_hl[x];
            let hr: i64 = col_hr[x];
            let hh_l: i64 = col_half_l[x];
            let hh_r: i64 = col_half_r[x];
            let full_l: i32 = hl > row ? 1 : 0;
            let full_r: i32 = hr > row ? 1 : 0;
            let half_l: i32 = hh_l == 1 && hl == row ? 1 : 0;
            let half_r: i32 = hh_r == 1 && hr == row ? 1 : 0;
            let on_l: i32 = (full_l == 1 || half_l == 1) ? 1 : 0;
            let on_r: i32 = (full_r == 1 || half_r == 1) ? 1 : 0;
            if on_l == 1 || on_r == 1 {
                let lum: i64 = col_lum[x];
                let rr: i64 = (col_r[x] * lum) / 255;
                let gg: i64 = (col_g[x] * lum) / 255;
                let bb: i64 = (col_b[x] * lum) / 255;
                let hpk: i64 = hl > hr ? hl : hr;
                let top_dist: i64 = hpk - (row + 1);
                let half_cap: i32 = (full_l == 0 && full_r == 0 && (half_l == 1 || half_r == 1)) ? 1 : 0;
                draw_rgb_block(on_l, on_r, rr, gg, bb, dot_mode, dark_bg, shade_mode, top_dist, half_cap);
            } else {
                print!(" ");
            }
        }
        print!("{}\r\n", reset());
    }
    draw_freq_axis(width, bins, fft_window, fft_sr);
    print!("\r\n");
    draw_progress_row(width, cur_frame, total_frames, time_sr);
    let out: Stdout = stdout();
    let _ = flush(out);
}

fn main(argc: i32, args: list<str8>) -> i32 {
    var wav_path: str8 = "examples/fft_example/illusion.wav";
    var mode: i32 = 0; // 1=music, 0=flat
    var dot_mode: i32 = 0; // 1=dot, 0=block
    var dark_bg: i32 = 1; // 1=dark blue, 0=black
    var detail_mode: i32 = 0; // 1=more low-bin detail
    var shade_mode: i32 = 0; // 1=full-cell shades on bar tops
    var flash_threshold: i32 = 64; // higher = less flashing, lower = more flashing
    var flash_mode: i32 = 1; // 1=flash/brightness accent, 0=steady spectrum
    var start_time: str8 = "";
    var log_scale: i32 = 100; // stable range in runtime is clamped to [50, 200]
    var jack_buffer: i32 = 0; // 0=unchanged
    var i: i32 = 1;
    while i < argc {
        let a: str8 = args[i];
        if eq(a, "--help") == 1 || eq(a, "-h") == 1 {
            println!("Usage: fft_analyzer_demo [WAV_PATH] [--flat|--music] [--time=hh::mm::ss] [--log=x] [--buffer=n] [--flash=x] [--no-flash|--flash-on]");
            println!("Keys: q quit, f flat, m music, x glyph(block/dot), b bg(blue/black), d detail, D top-shade, v flash on/off, +/- flash threshold, h/l seek -/+5s");
            println!("Examples:");
            println!("  ./examples/fft_example/run_demo.sh --music --time=00::01::30");
            println!("  ./examples/fft_example/run_demo.sh /path/to/file.wav --flat --time=01::02::03");
            println!("  ./examples/fft_example/run_demo.sh --log=120   # compress bars");
            println!("  ./examples/fft_example/run_demo.sh --log=80    # expand bars");
            println!("  ./examples/fft_example/run_demo.sh --buffer=32 # JACK buffer frames");
            println!("  ./examples/fft_example/run_demo.sh --flash=96  # reduce flashing");
            println!("  ./examples/fft_example/run_demo.sh --no-flash  # steady spectrum");
            return 0;
        } else if eq(a, "--flat") == 1 {
            mode = 0;
        } else if eq(a, "--music") == 1 {
            mode = 1;
        } else if starts_with(a, "--time=") == 1 {
            start_time = sub(a, 7, len(a) - 7);
        } else if starts_with(a, "--log=") == 1 {
            let ls: str8 = sub(a, 6, len(a) - 6);
            let parsed: i32 = atoi(ls);
            if parsed < 50 {
                log_scale = 50;
            } else if parsed > 200 {
                log_scale = 200;
            } else {
                log_scale = parsed;
            }
        } else if starts_with(a, "--buffer=") == 1 {
            let bs: str8 = sub(a, 9, len(a) - 9);
            let parsed_b: i32 = atoi(bs);
            if parsed_b > 0 && parsed_b <= 8192 {
                jack_buffer = parsed_b;
            }
        } else if starts_with(a, "--flash=") == 1 {
            let fs: str8 = sub(a, 8, len(a) - 8);
            let parsed_f: i32 = atoi(fs);
            if parsed_f >= 0 && parsed_f <= 240 {
                flash_threshold = parsed_f;
            }
        } else if eq(a, "--no-flash") == 1 {
            flash_mode = 0;
        } else if eq(a, "--flash-on") == 1 {
            flash_mode = 1;
        } else {
            wav_path = a;
        }
        i = i + 1;
    }

    if jack_buffer > 0 {
        let _ = jack2_fftviz_set_buffer_size(jack_buffer);
    }

    let rc: i32 = jack2_fftviz_start(wav_path, "mlang_fft_analyzer");
    if rc != 0 {
        eprintln!("jack2_fftviz_start failed: rc={}", rc);
        return 1;
    }

    print!("{}{}{}", cursor_force(cmd_clear_screen()), cursor_force(cmd_home()), cursor_force(cmd_hide()));
    let input: Stdin = stdin();
    var key_buf = with_capacity(32);
    var raw_on: i32 = 0;
    if stdin_is_tty() == 1 {
        if stdin_enable_raw() == 0 {
            raw_on = 1;
        }
    }

    let fft_sr: i64 = jack2_fftviz_sample_rate();
    let time_sr: i64 = jack2_fftviz_wav_sample_rate();
    let total_frames: i64 = jack2_fftviz_total_frames();
    if len(start_time) > 0 {
        let _ = jack2_fftviz_seek_timecode(start_time);
    }

    // Keep rendering shortly after playback ends so final frame is visible.
    var tail_ticks: i64 = 10;
    while jack2_fftviz_running() == 1 || tail_ticks > 0 {
        let n_key: i64 = read_line_nonblocking(input, key_buf, 32);
        if n_key > 0 {
            if find(key_buf, "q") >= 0 || find(key_buf, "Q") >= 0 {
                break;
            }
            if find(key_buf, "f") >= 0 || find(key_buf, "F") >= 0 {
                mode = 0;
            }
            if find(key_buf, "m") >= 0 || find(key_buf, "M") >= 0 {
                mode = 1;
            }
            if find(key_buf, "x") >= 0 || find(key_buf, "X") >= 0 {
                dot_mode = dot_mode == 0 ? 1 : 0;
            }
            if find(key_buf, "b") >= 0 || find(key_buf, "B") >= 0 {
                dark_bg = dark_bg == 0 ? 1 : 0;
            }
            if find(key_buf, "D") >= 0 {
                shade_mode = shade_mode == 0 ? 1 : 0;
            } else if find(key_buf, "d") >= 0 {
                detail_mode = detail_mode == 0 ? 1 : 0;
            }
            if find(key_buf, "h") >= 0 || find(key_buf, "H") >= 0 {
                let delta: i64 = 0 - (time_sr * 5);
                let _ = jack2_fftviz_seek_rel_frames(delta);
                tail_ticks = 10;
            }
            if find(key_buf, "l") >= 0 || find(key_buf, "L") >= 0 {
                let delta: i64 = time_sr * 5;
                let _ = jack2_fftviz_seek_rel_frames(delta);
                tail_ticks = 10;
            }
            if find(key_buf, "+") >= 0 || find(key_buf, "=") >= 0 {
                flash_threshold = flash_threshold + 8;
                if flash_threshold > 240 {
                    flash_threshold = 240;
                }
            }
            if find(key_buf, "-") >= 0 || find(key_buf, "_") >= 0 {
                flash_threshold = flash_threshold - 8;
                if flash_threshold < 0 {
                    flash_threshold = 0;
                }
            }
            if find(key_buf, "v") >= 0 || find(key_buf, "V") >= 0 {
                flash_mode = flash_mode == 0 ? 1 : 0;
            }
        }

        let term_sz: TermSize = stdout_size();
        let width: i64 = viewport_width(term_sz.cols);
        let height: i64 = viewport_height(term_sz.rows);
        let fft_window: i32 = choose_fft_window(width);

        let snap_l: list<i64> = jack2_fftviz_snapshot_i64(0, fft_window);
        let snap_r: list<i64> = jack2_fftviz_snapshot_i64(1, fft_window);
        let freq_l: list<i64> = forward(snap_l);
        let freq_r: list<i64> = forward(snap_r);
        let cur_frame: i64 = jack2_fftviz_current_frame();
        render_frame(freq_l, freq_r, width, height, cur_frame, total_frames, fft_sr, time_sr, mode, fft_window, dot_mode, dark_bg, log_scale, detail_mode, shade_mode, flash_threshold, flash_mode);
        sleep_ms(16);
        if jack2_fftviz_running() == 0 {
            tail_ticks = tail_ticks - 1;
        }
    }

    print!("{}{}\n", reset(), cursor_force(cmd_show()));
    if raw_on == 1 {
        let _ = stdin_restore();
    }
    free(key_buf);
    jack2_fftviz_stop();
    return 0;
}
