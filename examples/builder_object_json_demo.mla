/// \file builder_object_json_demo.mla
/// \ingroup examples
/// \brief Builder object JSON demo — Option A: every clause key and container
///        type is declared as a full `struct`.
///
/// Shows the declarative `add<T>()` builder form with `|` clause chaining,
/// printed via `{:json}` and `{:#json}`. All clause keys (`Method`, `Url`,
/// `Name`, `Value`, `Text`, `Priority`) are single-field structs, so their
/// value types are enforced by the compiler — here one of them uses `i32`
/// (`Priority{7}`) alongside the string-valued clauses.
///
/// See \ref builder_syntax "Builder Syntax" for the full language rules.
///
/// Run with:
/// \code
///   mlang run examples/builder_object_json_demo.mla
/// \endcode

// Builder JSON demo — Option A: every builder clause and container type is a
// full `struct` declaration. Leaf clauses (Method, Url, Name, Value, Text,
// Priority) are single-field structs whose `value` field's type is enforced
// by the compiler. Builder roots (HttpRequest, Header, Body) are regular
// structs.

struct Method   { var value: str8; };
struct Url      { var value: str8; };
struct Name     { var value: str8; };
struct Value    { var value: str8; };
struct Text     { var value: str8; };
struct Priority { var value: i32;  };

struct Header { var name: str8; var value: str8; };
struct Body   { var text: str8; };
struct HttpRequest {
    var method:   str8;
    var url:      str8;
    var body:     Body;
    var priority: i32;
};

fn main() -> i32 {
    let request = add<HttpRequest>()
        | Method{"POST"}
        | Url{"https://api.example.com/v1/messages"}
        | Priority{7}
        | add<Body>(
            Text{"hello"}
        )
        | add<Header>(
            Name{"Authorization"},
            Value{"Bearer token-123"}
        )
        | add<Header>(
            Name{"ContentType"},
            Value{"application/json"}
        );

    println!("{:json}", request);
    println!("{:#json}", request);
    return 0;
}
