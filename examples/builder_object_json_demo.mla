fn main() -> i32 {
    let request = add<HttpRequest>()
        | Method{"POST"}
        | Url{"https://api.example.com/v1/messages"}
        | Body{"{\"text\":\"hello\"}"}
        | add<Header>(
            Name{"Authorization"},
            Value{"Bearer token-123"}
        )
        | add<Header>(
            Name{"ContentType"},
            Value{"application/json"}
        );

    println!("{:json}", request);
    println!("{:#json}", request);
    return 0;
}
