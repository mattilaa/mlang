/// \file std_thread_demo.mla
/// @ingroup examples
/// \brief std::thread spawn/join API demo.
///
mod std::thread;
mod std::sync;

use std::sync::mutex;
use std::thread::*;

fn worker(id: i64) -> i32 {
    println!("worker {}", id);
    return 0;
}

fn main() -> i32 {
    // std::thread owns the public handle and helper APIs.
    let h1: std::thread::thread = thread::spawn(worker, 1);
    let h2: std::thread::thread = thread::spawn(worker, 2);

    join(h1);
    join(h2);

    let mtx_r: result<mutex, str8> = mutex::new();
    if mtx_r.is_err() { return 1; }
    let mtx: mutex = mtx_r.unwrap();
    let _ = mtx.lock();
    let _ = mtx.unlock();
    mtx.close();

    let counter: std::thread::atomic64 = atomic_new(10);
    let prev: i64 = atomic_add_value(counter, 5);
    let cur: i64 = atomic_load_value(counter);
    println!("atomic prev={} cur={}", prev, cur);
    atomic_store_value(counter, 42);
    println!("atomic now={}", atomic_load_value(counter));
    atomic_free_handle(counter);

    return 0;
}
