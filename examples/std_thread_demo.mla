/// \file std_thread_demo.mla
/// @ingroup examples
/// \brief std::thread spawn/join API demo.
///
mod std::thread;

use std::thread::*;

fn worker(id: i64) -> i32 {
    println!("worker {}", id);
    return 0;
}

fn main() -> i32 {
    // thread_spawn is intrinsic; std::thread provides helper wrappers.
    let h1: Handle<Thread> = thread_spawn(worker, 1);
    let h2: Handle<Thread> = thread_spawn(worker, 2);

    join(h1);
    join(h2);

    let mtx: Handle<Mutex> = mutex_new();
    mutex_lock_handle(mtx);
    mutex_unlock_handle(mtx);
    mutex_free(mtx);

    let counter: Handle<Atomic64> = atomic_new(10);
    let prev: i64 = atomic_add_value(counter, 5);
    let cur: i64 = atomic_load_value(counter);
    println!("atomic prev={} cur={}", prev, cur);
    atomic_store_value(counter, 42);
    println!("atomic now={}", atomic_load_value(counter));
    atomic_free_handle(counter);

    return 0;
}

