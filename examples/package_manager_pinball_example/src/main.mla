mod std::ascii;
mod std::esc;
mod std::image;
mod std::io;
mod std::strbuf;
mod std::term;
mod std::time;

use std::ascii::AsciiKey;
use std::ascii::UnicodeBoxGlyph;
use std::ascii::unicode_box_glyph;
use std::esc::alt_screen_off;
use std::esc::alt_screen_on;
use std::esc::bg_rgb;
use std::esc::bold_on;
use std::esc::cmd_clear_screen;
use std::esc::cmd_hide;
use std::esc::cmd_home;
use std::esc::cmd_show;
use std::esc::color_black;
use std::esc::color_bright_black;
use std::esc::color_bright_yellow;
use std::esc::color_bright_white;
use std::esc::color_bright_red;
use std::esc::cursor;
use std::esc::cursor_pos;
use std::esc::fg;
use std::esc::fg_rgb;
use std::esc::bg;
use std::esc::reset;
use std::image::ImageGlyphMode;
use std::image::ImageInfo;
use std::image::probe;
use std::image::render_truecolor_crop;
use std::image::render_truecolor_with_mode;
use std::io::Stdin;
use std::io::read_keycode_nonblocking;
use std::io::stdin;
use std::io::stdout;
use std::io::write;
use std::strbuf::StringBuilder;
use std::strbuf::builder_append;
use std::strbuf::builder_append_char;
use std::strbuf::builder_new;
use std::strbuf::builder_take_string;
use std::term::stdin_enable_raw;
use std::term::stdin_is_tty;
use std::term::stdin_restore;
use std::term::stdout_is_tty;
use std::term::stdout_size;
use std::time::sleep_ms;

fn min_i64(a: i64, b: i64) -> i64 {
    return a < b ? a : b;
}

fn max_i64(a: i64, b: i64) -> i64 {
    return a > b ? a : b;
}

fn clamp_i64(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}

fn abs_i64(v: i64) -> i64 {
    return v < 0 ? -v : v;
}

fn append_text(builder: StringBuilder, text: str8) -> void {
    let _ = builder_append(builder, text);
}

fn in_bumper(ball_x: i64, ball_y: i64, cx: i64, cy: i64) -> i32 {
    return abs_i64(ball_x - cx) <= 1 && abs_i64(ball_y - cy) <= 1 ? 1 : 0;
}

/// Append cursor_pos + text if the position is inside the visible viewport.
/// text is consumed (moved) — pass a fresh value each call.
fn draw_at(builder: StringBuilder, ty: i64, tx: i64,
           view_x: i64, view_y: i64, vp_w: i64, vp_h: i64,
           text: str8) -> void {
    let sc_row: i64 = ty - view_y + 3;
    let sc_col: i64 = tx - view_x + 1;
    if sc_row < 3 || sc_row > vp_h + 2 { return; }
    if sc_col < 1 || sc_col > vp_w      { return; }
    append_text(builder, cursor_pos(i32(sc_row), i32(sc_col)));
    append_text(builder, text);
}

fn main() -> i32 {
    if stdin_is_tty() == 0 || stdout_is_tty() == 0 {
        println!("package_manager_pinball_example requires a TTY");
        return 1;
    }

    let input: Stdin = stdin();
    let _ = stdin_enable_raw();
    let _ = write(stdout(), alt_screen_on());
    let _ = write(stdout(), cursor(cmd_hide()));

    /* ── table geometry ──────────────────────────────────────────── */
    let table_width: i64  = 72;
    let table_height: i64 = 54;

    let bumper_a_x: i64 = 18;
    let bumper_a_y: i64 = 18;
    let bumper_b_x: i64 = table_width / 2;
    let bumper_b_y: i64 = 14;
    let bumper_c_x: i64 = table_width - 19;
    let bumper_c_y: i64 = 21;

    let left_flipper_start: i64  = 18;
    let left_flipper_end: i64    = 31;
    let right_flipper_start: i64 = table_width - 32;
    let right_flipper_end: i64   = table_width - 19;
    let drain_y: i64             = table_height - 5;

    /* ── probe Metallica background image ───────────────────────── */
    var img_w: i64 = 433;
    var img_h: i64 = 869;
    let probe_r: Result<ImageInfo, str8> = probe("pics/metallica.jpg");
    if probe_r.is_ok() {
        let info: ImageInfo = probe_r.unwrap();
        img_w = info.width;
        img_h = info.height;
    }

    /* ── cached background ───────────────────────────────────────── */
    var cached_bg: str8 = "";
    var cached_vw: i64  = -1;
    var cached_vh: i64  = -1;
    var cached_vx: i64  = -1;
    var cached_vy: i64  = -1;
    var bg_valid: i32   = 0;

    /* ── game state ──────────────────────────────────────────────── */
    var ball_x: i64          = table_width - 3;
    var ball_y: i64          = table_height - 3;
    var ball_dx: i64         = 0;
    var ball_dy: i64         = 0;
    var launch_charge: i64   = 0;
    var launched: i64        = 0;
    var left_flipper_ticks: i64  = 0;
    var right_flipper_ticks: i64 = 0;
    var score: i64           = 0;
    var lives: i64           = 3;
    var bumper_a_lit: i64    = 0;
    var bumper_b_lit: i64    = 0;
    var bumper_c_lit: i64    = 0;

    var running: i32 = 1;
    while running == 1 {
        let term = stdout_size();
        let vp_w: i64 = clamp_i64(term.cols - 2, 20, table_width);
        let vp_h: i64 = clamp_i64(term.rows - 5, 10, table_height);
        let margin_x: i64 = max_i64(6, vp_w / 3);
        let margin_y: i64 = max_i64(6, vp_h / 3);
        let view_x: i64 = clamp_i64(ball_x - margin_x, 0, max_i64(0, table_width  - vp_w));
        let view_y: i64 = clamp_i64(ball_y - margin_y, 0, max_i64(0, table_height - vp_h));

        if launched == 0 {
            ball_x = table_width - 3;
            ball_y = table_height - 3;
        }

        /* ── refresh background when viewport changes ────────────── */
        if vp_w != cached_vw || vp_h != cached_vh || view_x != cached_vx || view_y != cached_vy {
            if bg_valid == 1 {
                free(cached_bg);
                bg_valid = 0;
                cached_bg = "";
            }
            let cx: i64 = view_x * img_w / table_width;
            let cy: i64 = view_y * img_h / table_height;
            let cw: i64 = max_i64(1, vp_w * img_w / table_width);
            let ch: i64 = max_i64(1, vp_h * img_h / table_height);
            let bg_r = render_truecolor_crop("pics/metallica.jpg", vp_w, vp_h,
                                             ImageGlyphMode::ColorSplitBlocks,
                                             cx, cy, cw, ch);
            if bg_r.is_ok() {
                cached_bg = bg_r.unwrap();
                bg_valid  = 1;
            }
            cached_vw = vp_w;
            cached_vh = vp_h;
            cached_vx = view_x;
            cached_vy = view_y;
        }

        /* ── too small ───────────────────────────────────────────── */
        if term.rows < 14 || term.cols < 24 {
            let tiny: str8 = format!(
                "{}{}terminal too small (need 24×14, got {}×{}). q to quit.{}",
                cursor(cmd_home()), fg_rgb(255, 60, 60),
                term.cols, term.rows, reset());
            let _ = write(stdout(), tiny);
            free(tiny);
        } else {
            /* ── Part 1: clear + header (rows 1-2) ──────────────── */
            let lf_label: str8 = left_flipper_ticks > 0
                ? format!("{}[A]↑{}", fg_rgb(140, 255, 90), reset())
                : format!("{}[A]↓{}", fg_rgb(50, 140, 40),  reset());
            let rf_label: str8 = right_flipper_ticks > 0
                ? format!("{}[D]↑{}", fg_rgb(140, 255, 90), reset())
                : format!("{}[D]↓{}", fg_rgb(50, 140, 40),  reset());
            let launch_hint: str8 = launch_charge > 0
                ? format!(" {}charge:{}{}",
                          fg_rgb(255, 200, 40), launch_charge, reset())
                : "                 ";
            let part1: str8 = format!(
                "{}{}{}METALLICA PINBALL{}  score:{}{}{}  lives:{}  {}  {}  [space]=launch{}  [r]=reset  [q]=quit\n{}{} table {}×{}  ball ({},{})  view ({},{})  A/D flippers{}\n",
                cursor(cmd_home()), cursor(cmd_clear_screen()),
                bold_on(), reset(),
                fg_rgb(255, 255, 100), score, reset(),
                lives, lf_label, rf_label, launch_hint, reset(),
                fg(color_bright_black()),
                launched == 0 ? "Hold [space] charge, release to fire." : "",
                table_width, table_height,
                ball_x, ball_y, view_x, view_y, reset());
            let _ = write(stdout(), part1);
            free(part1);
            free(lf_label);
            free(rf_label);
            free(launch_hint);

            /* ── Part 2: background image at row 3 ──────────────── */
            let _ = write(stdout(), cursor_pos(3, 1));
            if bg_valid == 1 {
                let _ = write(stdout(), cached_bg);
            }

            /* ── Part 3: overlay (cursor_pos per element) ────────── */
            let sb: StringBuilder = builder_new(vp_w * 4 + 2048);

            /* table border – top wall */
            let top_row: i64 = 0 - view_y + 3;
            if top_row >= 3 && top_row <= vp_h + 2 {
                append_text(sb, cursor_pos(i32(top_row), 1));
                for col in 0..vp_w {
                    let tx: i64 = view_x + col;
                    if tx >= 0 && tx < table_width {
                        append_text(sb, format!("{}{}█{}", fg_rgb(200, 160, 40), bg_rgb(160, 120, 20), reset()));
                    }
                }
            }
            /* bottom wall */
            let bot_row: i64 = table_height - 1 - view_y + 3;
            if bot_row >= 3 && bot_row <= vp_h + 2 {
                append_text(sb, cursor_pos(i32(bot_row), 1));
                for col in 0..vp_w {
                    let tx: i64 = view_x + col;
                    if tx >= 0 && tx < table_width {
                        append_text(sb, format!("{}{}█{}", fg_rgb(200, 160, 40), bg_rgb(160, 120, 20), reset()));
                    }
                }
            }
            /* left/right walls */
            for row_i in 0..vp_h {
                let ty: i64 = view_y + row_i;
                if ty > 0 && ty < table_height - 1 {
                    let sc_row: i64 = row_i + 3;
                    let lsc: i64 = 0 - view_x + 1;
                    if lsc >= 1 && lsc <= vp_w {
                        append_text(sb, cursor_pos(i32(sc_row), i32(lsc)));
                        append_text(sb, format!("{}{}█{}", fg_rgb(200, 160, 40), bg_rgb(160, 120, 20), reset()));
                    }
                    let rsc: i64 = table_width - 1 - view_x + 1;
                    if rsc >= 1 && rsc <= vp_w {
                        append_text(sb, cursor_pos(i32(sc_row), i32(rsc)));
                        append_text(sb, format!("{}{}█{}", fg_rgb(200, 160, 40), bg_rgb(160, 120, 20), reset()));
                    }
                }
            }

            /* drain warning */
            let drain_sc_row: i64 = drain_y + 1 - view_y + 3;
            if drain_sc_row >= 3 && drain_sc_row <= vp_h + 2 {
                var dx2: i64 = left_flipper_end + 2;
                while dx2 <= right_flipper_start - 2 {
                    let dsc: i64 = dx2 - view_x + 1;
                    if dsc >= 1 && dsc <= vp_w {
                        append_text(sb, cursor_pos(i32(drain_sc_row), i32(dsc)));
                        append_text(sb, format!("{}{}▄{}", fg_rgb(200, 40, 20), bg_rgb(80, 10, 5), reset()));
                    }
                    dx2 = dx2 + 1;
                }
            }

            /* bumpers */
            let ba_str: str8 = bumper_a_lit > 0
                ? format!("{}{}{}◉{}", bold_on(), fg_rgb(255, 255, 80), bg_rgb(220, 60, 0), reset())
                : format!("{}{}◉{}", bold_on(), fg_rgb(255, 64, 64), reset());
            draw_at(sb, bumper_a_y, bumper_a_x, view_x, view_y, vp_w, vp_h, ba_str);

            let bb_str: str8 = bumper_b_lit > 0
                ? format!("{}{}{}◉{}", bold_on(), fg_rgb(255, 255, 80), bg_rgb(220, 60, 0), reset())
                : format!("{}{}◉{}", bold_on(), fg_rgb(255, 64, 64), reset());
            draw_at(sb, bumper_b_y, bumper_b_x, view_x, view_y, vp_w, vp_h, bb_str);

            let bc_str: str8 = bumper_c_lit > 0
                ? format!("{}{}{}◉{}", bold_on(), fg_rgb(255, 255, 80), bg_rgb(220, 60, 0), reset())
                : format!("{}{}◉{}", bold_on(), fg_rgb(255, 64, 64), reset());
            draw_at(sb, bumper_c_y, bumper_c_x, view_x, view_y, vp_w, vp_h, bc_str);

            /* flippers */
            let flip_sc_row: i64 = drain_y - view_y + 3;
            if flip_sc_row >= 3 && flip_sc_row <= vp_h + 2 {
                var fx: i64 = left_flipper_start;
                while fx <= left_flipper_end {
                    let fsc: i64 = fx - view_x + 1;
                    if fsc >= 1 && fsc <= vp_w {
                        append_text(sb, cursor_pos(i32(flip_sc_row), i32(fsc)));
                        if left_flipper_ticks > 0 {
                            append_text(sb, format!("{}{}▬{}", bold_on(), fg_rgb(140, 255, 90), reset()));
                        } else {
                            append_text(sb, format!("{}{}▬{}", bold_on(), fg_rgb(50, 160, 40), reset()));
                        }
                    }
                    fx = fx + 1;
                }
                fx = right_flipper_start;
                while fx <= right_flipper_end {
                    let fsc: i64 = fx - view_x + 1;
                    if fsc >= 1 && fsc <= vp_w {
                        append_text(sb, cursor_pos(i32(flip_sc_row), i32(fsc)));
                        if right_flipper_ticks > 0 {
                            append_text(sb, format!("{}{}▬{}", bold_on(), fg_rgb(140, 255, 90), reset()));
                        } else {
                            append_text(sb, format!("{}{}▬{}", bold_on(), fg_rgb(50, 160, 40), reset()));
                        }
                    }
                    fx = fx + 1;
                }
                /* raised flipper tips */
                if left_flipper_ticks > 0 {
                    let tip_row: i64 = drain_y - 1 - view_y + 3;
                    if tip_row >= 3 && tip_row <= vp_h + 2 {
                        var tx2: i64 = left_flipper_end - 3;
                        while tx2 <= left_flipper_end + 1 {
                            let tsc: i64 = tx2 - view_x + 1;
                            if tsc >= 1 && tsc <= vp_w {
                                append_text(sb, cursor_pos(i32(tip_row), i32(tsc)));
                                append_text(sb, format!("{}{}▲{}", bold_on(), fg_rgb(160, 255, 110), reset()));
                            }
                            tx2 = tx2 + 1;
                        }
                    }
                }
                if right_flipper_ticks > 0 {
                    let tip_row: i64 = drain_y - 1 - view_y + 3;
                    if tip_row >= 3 && tip_row <= vp_h + 2 {
                        var tx2: i64 = right_flipper_start - 1;
                        while tx2 <= right_flipper_start + 3 {
                            let tsc: i64 = tx2 - view_x + 1;
                            if tsc >= 1 && tsc <= vp_w {
                                append_text(sb, cursor_pos(i32(tip_row), i32(tsc)));
                                append_text(sb, format!("{}{}▲{}", bold_on(), fg_rgb(160, 255, 110), reset()));
                            }
                            tx2 = tx2 + 1;
                        }
                    }
                }
            }

            /* ball */
            let ball_sc_row: i64 = ball_y - view_y + 3;
            let ball_sc_col: i64 = ball_x - view_x + 1;
            if ball_sc_row >= 3 && ball_sc_row <= vp_h + 2
               && ball_sc_col >= 1 && ball_sc_col <= vp_w {
                append_text(sb, cursor_pos(i32(ball_sc_row), i32(ball_sc_col)));
                append_text(sb, format!("{}{}●{}", bold_on(), fg_rgb(255, 248, 120), reset()));
            }

            /* legend */
            let legend_row: i64 = vp_h + 3;
            append_text(sb, cursor_pos(i32(legend_row), 1));
            append_text(sb, format!(
                "{}{}bumpers +25  A/D flippers  space=launch  drain=lose life{}",
                fg(color_bright_black()), bg(color_black()), reset()));

            let overlay: str8 = builder_take_string(sb);
            let _ = write(stdout(), overlay);
            free(overlay);
        }

        /* ── input ───────────────────────────────────────────────── */
        let keycode: i32 = read_keycode_nonblocking(input);
        if keycode >= 0 {
            if keycode == AsciiKey::LowerQ || keycode == AsciiKey::UpperQ
               || keycode == AsciiKey::Etx {
                running = 0;
            } else if keycode == AsciiKey::LowerA || keycode == AsciiKey::UpperA {
                left_flipper_ticks = 5;
            } else if keycode == AsciiKey::LowerD || keycode == AsciiKey::UpperD {
                right_flipper_ticks = 5;
            } else if keycode == AsciiKey::Space {
                if launched == 0 {
                    launch_charge = min_i64(10, launch_charge + 1);
                }
            } else if keycode == AsciiKey::LowerR || keycode == AsciiKey::UpperR {
                score = 0;
                lives = 3;
                ball_x = table_width - 3;
                ball_y = table_height - 3;
                ball_dx = 0;
                ball_dy = 0;
                launch_charge = 0;
                launched = 0;
            }
        } else if launched == 0 && launch_charge > 0 {
            launched = 1;
            ball_dx = -1;
            ball_dy = -(1 + launch_charge / 3);
            launch_charge = 0;
        }

        if left_flipper_ticks  > 0 { left_flipper_ticks  = left_flipper_ticks  - 1; }
        if right_flipper_ticks > 0 { right_flipper_ticks = right_flipper_ticks - 1; }
        if bumper_a_lit > 0 { bumper_a_lit = bumper_a_lit - 1; }
        if bumper_b_lit > 0 { bumper_b_lit = bumper_b_lit - 1; }
        if bumper_c_lit > 0 { bumper_c_lit = bumper_c_lit - 1; }

        /* ── physics ─────────────────────────────────────────────── */
        if launched == 1 {
            var next_x: i64 = ball_x + ball_dx;
            var next_y: i64 = ball_y + ball_dy;
            let wall_left: i64   = 1;
            let wall_right: i64  = table_width - 2;
            let wall_top: i64    = 1;
            let wall_bottom: i64 = table_height - 2;

            if next_x <= wall_left  { next_x = wall_left;  ball_dx =  1; }
            if next_x >= wall_right { next_x = wall_right; ball_dx = -1; }
            if next_y <= wall_top   { next_y = wall_top;   ball_dy =  1; }

            /* gentle gravity */
            if ball_dy < 3 && (ball_y % 3 == 0) {
                ball_dy = ball_dy + 1;
            }

            /* bumper hits */
            if in_bumper(next_x, next_y, bumper_a_x, bumper_a_y) == 1 {
                score = score + 25;
                bumper_a_lit = 3;
                ball_dx = ball_x < bumper_a_x ? -1 : 1;
                ball_dy = -2;
                next_x = ball_x + ball_dx;
                next_y = ball_y + ball_dy;
            }
            if in_bumper(next_x, next_y, bumper_b_x, bumper_b_y) == 1 {
                score = score + 25;
                bumper_b_lit = 3;
                ball_dx = ball_x < bumper_b_x ? -1 : 1;
                ball_dy = -2;
                next_x = ball_x + ball_dx;
                next_y = ball_y + ball_dy;
            }
            if in_bumper(next_x, next_y, bumper_c_x, bumper_c_y) == 1 {
                score = score + 25;
                bumper_c_lit = 3;
                ball_dx = ball_x < bumper_c_x ? -1 : 1;
                ball_dy = -2;
                next_x = ball_x + ball_dx;
                next_y = ball_y + ball_dy;
            }

            /* flipper catches */
            if next_y >= drain_y - 2 {
                if left_flipper_ticks > 0
                   && next_x >= left_flipper_start - 2
                   && next_x <= left_flipper_end + 2 {
                    score = score + 5;
                    ball_dx = -1;
                    ball_dy = -3;
                    next_x = ball_x + ball_dx;
                    next_y = drain_y - 3;
                } else if right_flipper_ticks > 0
                          && next_x >= right_flipper_start - 2
                          && next_x <= right_flipper_end + 2 {
                    score = score + 5;
                    ball_dx = 1;
                    ball_dy = -3;
                    next_x = ball_x + ball_dx;
                    next_y = drain_y - 3;
                }
            }

            /* drain */
            if next_y >= wall_bottom {
                lives = lives - 1;
                if lives <= 0 {
                    lives = 3;
                    score = 0;
                }
                ball_x = table_width - 3;
                ball_y = table_height - 3;
                ball_dx = 0;
                ball_dy = 0;
                launch_charge = 0;
                launched = 0;
            } else {
                ball_x = clamp_i64(next_x, wall_left, wall_right);
                ball_y = clamp_i64(next_y, wall_top, wall_bottom);
            }
        } else {
            ball_x = table_width - 3;
            ball_y = table_height - 3;
        }

        sleep_ms(40);
    }

    /* cleanup */
    if bg_valid == 1 {
        free(cached_bg);
    }

    let _ = write(stdout(), reset());
    let _ = write(stdout(), cursor(cmd_show()));
    let _ = write(stdout(), alt_screen_off());
    let _ = stdin_restore();
    return 0;
}
