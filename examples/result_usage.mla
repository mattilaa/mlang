/// \file result_usage.mla
/// @ingroup examples
/// \brief result<T,E> usage showing propagation and unwrap patterns.
///
// Example: result<T, E>

fn div(a: i32, b: i32) -> result<i32, str8> {
    if b == 0: {
        return Err<i32, str8>("divide by zero");
    }
    return Ok<i32, str8>(a / b);
}

fn main() -> i32 {
    let r: result<i32, str8> = div(10, 2);

    if r.is_ok(): {
        let v: i32 = r.unwrap();
        println!("ok: {}", v);
    } else: {
        let e: str8 = r.unwrap_err();
        println!("err: {}", e);
    }

    return 0;
}
