// Example: Result<T, E>

fn div(a: i32, b: i32) -> Result<i32, string> {
    if b == 0: {
        return Err<i32, string>("divide by zero");
    }
    return Ok<i32, string>(a / b);
}

fn main() -> i32 {
    let r: Result<i32, string> = div(10, 2);

    if r.is_ok(): {
        let v: i32 = r.unwrap();
        println!("ok: {}", v);
    } else: {
        let e: string = r.unwrap_err();
        println!("err: {}", e);
    }

    return 0;
}
