/// \file testing_mock_example.mla
/// \brief Mock-based testing example using \c std::testing.
///
/// Demonstrates the mock API (\c mock_new, \c mock_expect_call,
/// \c mock_verify) for verifying call expectations.  Run with:
/// \code
///   mlang examples/testing_mock_example.mla -L ~/.local/lib -lmlang_std
/// \endcode

mod std::testing;

use std::testing::*;

fn main() -> i32 {
    reset();

    let api: Mock = mock_new();
    mock_expect_call(api.handle, "connect", 1);
    mock_expect_call(api.handle, "send", 2);

    // "System under test" would call these in real code.
    mock_called(api.handle, "connect");
    mock_called(api.handle, "send");
    mock_called(api.handle, "send");

    expect_true(mock_verify(api.handle));
    println!("checks={} failures={}", checks(), failures());
    mock_free(api.handle);
    return result();
}
