/// \file thread_mutex_atomic.mla
/// @ingroup examples
/// \brief Threaded counter demo contrasting mutex and atomic operations.
///
fn worker(id: i64, total: Handle<Atomic64>, mtx: Handle<Mutex>, counter: Handle<Atomic64>) -> void {
    var local: i64 = 0;
    for i in 0..100000 {
        local = local + 1;
    }

    atomic_i64_add(counter, local);

    mutex_lock(mtx);
    let current: i64 = atomic_i64_load(total);
    atomic_i64_store(total, current + local);
    mutex_unlock(mtx);

    println!("worker {} done", id);
}

fn main() -> i32 {
    let total: Handle<Atomic64> = atomic_i64_new(0);
    let counter: Handle<Atomic64> = atomic_i64_new(0);
    let mtx: Handle<Mutex> = mutex_create();

    let h1: Handle<Thread> = thread_spawn(worker, 1, total, mtx, counter);
    let h2: Handle<Thread> = thread_spawn(worker, 2, total, mtx, counter);
    let h3: Handle<Thread> = thread_spawn(worker, 3, total, mtx, counter);
    let h4: Handle<Thread> = thread_spawn(worker, 4, total, mtx, counter);

    thread_join(h1);
    thread_join(h2);
    thread_join(h3);
    thread_join(h4);

    let total_val: i64 = atomic_i64_load(total);
    let counter_val: i64 = atomic_i64_load(counter);
    println!("total = {} counter = {}", total_val, counter_val);

    mutex_destroy(mtx);
    atomic_i64_free(total);
    atomic_i64_free(counter);
    return 0;
}
