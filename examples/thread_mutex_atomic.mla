/// \file thread_mutex_atomic.mla
/// @ingroup examples
/// \brief Threaded counter demo contrasting mutex and atomic operations.
///
mod std::sync;
mod std::thread;

use std::sync::mutex;
use std::thread::*;

fn worker(id: i64, total: std::thread::atomic64, mtx: mutex, counter: std::thread::atomic64) -> void {
    var local: i64 = 0;
    for i in 0..100000 {
        local = local + 1;
    }

    atomic_add_value(counter, local);

    let _ = mtx.lock();
    let current: i64 = atomic_load_value(total);
    atomic_store_value(total, current + local);
    let _ = mtx.unlock();

    println!("worker {} done", id);
}

fn main() -> i32 {
    let total: std::thread::atomic64 = atomic_new(0);
    let counter: std::thread::atomic64 = atomic_new(0);
    let mtx_r: result<mutex, str8> = mutex::new();
    if mtx_r.is_err() { return 1; }
    let mtx: mutex = mtx_r.unwrap();

    let h1: std::thread::thread = thread::spawn(worker, 1, total, mtx, counter);
    let h2: std::thread::thread = thread::spawn(worker, 2, total, mtx, counter);
    let h3: std::thread::thread = thread::spawn(worker, 3, total, mtx, counter);
    let h4: std::thread::thread = thread::spawn(worker, 4, total, mtx, counter);

    std::thread::join(h1);
    std::thread::join(h2);
    std::thread::join(h3);
    std::thread::join(h4);

    let total_val: i64 = atomic_load_value(total);
    let counter_val: i64 = atomic_load_value(counter);
    println!("total = {} counter = {}", total_val, counter_val);

    mtx.close();
    atomic_free_handle(total);
    atomic_free_handle(counter);
    return 0;
}
