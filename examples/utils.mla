/// \file utils.mla
/// @ingroup examples
/// \brief Shared helper functions reused by the top-level main.mla example.
///
pub fn max(a: i32, b: i32) -> i32 {
    if a > b: {
        return a;
    }
    return b;
}

pub fn min(a: i32, b: i32) -> i32 {
    if a < b: {
        return a;
    }
    return b;
}

pub fn abs(x: i32) -> i32 {
    if x < 0: {
        return 0 - x;
    }
    return x;
}

pub fn clamp(value: i32, low: i32, high: i32) -> i32 {
    if value < low: {
        return low;
    }
    if value > high: {
        return high;
    }
    return value;
}
