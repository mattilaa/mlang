pub fn max(a: int, b: int) -> int {
    if a > b: {
        return a;
    }
    return b;
}

pub fn min(a: int, b: int) -> int {
    if a < b: {
        return a;
    }
    return b;
}

pub fn abs(x: int) -> int {
    if x < 0: {
        return 0 - x;
    }
    return x;
}

pub fn clamp(value: int, low: int, high: int) -> int {
    if value < low: {
        return low;
    }
    if value > high: {
        return high;
    }
    return value;
}
