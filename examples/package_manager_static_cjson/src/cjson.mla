/// \file cjson.mla
/// @ingroup examples
/// \brief FFI bindings for the statically linked cJSON dependency.
///
extern pub fn cJSON_Parse(text: str8) -> i64;
extern pub fn cJSON_Delete(node: i64) -> void;
extern pub fn cJSON_GetObjectItemCaseSensitive(obj: i64, key: str8) -> i64;
extern pub fn cJSON_GetNumberValue(item: i64) -> f64;
