/// \file std_jsonrpc_runtime_demo.mla
/// @ingroup examples
/// \brief JSON-RPC runtime dispatcher demo using std::jsonrpc.
///
mod std::jsonrpc;
mod std::io;
mod std::strbuf;

use std::io::stdout;
use std::io::writeln;
use std::jsonrpc::Runtime;
use std::jsonrpc::register_cancel_from_payload;
use std::strbuf::contains;

/// Demonstrates queue/cancellation helpers without blocking on stdio input.
fn main() -> i32 {
    let rt_r: Result<Runtime, str8> = Runtime::new(32);
    if rt_r.is_err(): {
        writeln(stdout(), rt_r.unwrap_err());
        return 1;
    }
    let rt: Runtime = rt_r.unwrap();

    let cancel_payload: str8 =
        "{\"jsonrpc\":\"2.0\",\"method\":\"$/cancelRequest\",\"params\":{\"id\":42}}";
    let cr: Result<i32, str8> = register_cancel_from_payload(cancel_payload);
    if cr.is_err(): {
        writeln(stdout(), cr.unwrap_err());
        rt.close();
        return 1;
    }

    let msg: str8 = "{\"jsonrpc\":\"2.0\",\"id\":42,\"result\":\"done\"}";
    let pr: Result<i32, str8> = rt.push_outbound(msg);
    if pr.is_err(): {
        writeln(stdout(), pr.unwrap_err());
        rt.close();
        return 1;
    }

    var scratch = String::with_capacity(256);
    let rr: Result<i64, str8> = rt.try_pop_outbound(scratch, 256);
    if rr.is_err(): {
        writeln(stdout(), rr.unwrap_err());
        String::free(scratch);
        rt.close();
        return 1;
    }

    if contains(scratch, "\"result\":\"done\"") != 1: {
        writeln(stdout(), "unexpected outbound payload");
        String::free(scratch);
        rt.close();
        return 1;
    }

    String::free(scratch);
    rt.close();
    writeln(stdout(), "std::jsonrpc runtime demo ok");
    return 0;
}
