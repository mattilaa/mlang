fn ptr_i32(addr: i64) -> ptr<i32> {
    var scratch: i32 = 0;
    let base: ptr<i32> = &scratch;
    return asm aarch64(ptr<i32>, "mov $0, $2", base, addr);
}

pub fn read32(addr: i64) -> i32 {
    let p: ptr<i32> = ptr_i32(addr);
    unsafe {
        let value: i32 = *p;
        return value;
    }
}

pub fn write32(addr: i64, value: i32) -> void {
    let p: ptr<i32> = ptr_i32(addr);
    unsafe {
        *p = value;
    }
}
