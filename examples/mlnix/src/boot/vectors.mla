mod kernel::traps;

use boot::cpu::elr_el1;
use boot::cpu::esr_el1;
use boot::cpu::far_el1;
use kernel::traps::trap_handle;

extern fn vectors_install() -> void;

pub fn vectors_init() -> void {
    vectors_install();
}

pub fn exception_handle(kind: i64) -> void {
    trap_handle(kind, esr_el1(), elr_el1(), far_el1());
}
