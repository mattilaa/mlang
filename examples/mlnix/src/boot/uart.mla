mod kernel::shell::rx;

use boot::constants::uart0_base;
use boot::constants::uart_dr_offset;
use boot::constants::uart_fr_offset;
use boot::constants::uart_fr_rxfe;
use boot::constants::uart_fr_txff;
use boot::constants::uart_icr_offset;
use boot::constants::uart_ifls_offset;
use boot::constants::uart_imsc_offset;
use boot::constants::uart_irq_rt_mask;
use boot::constants::uart_irq_rx_mask;
use boot::constants::uart_mis_offset;
use boot::cpu::relax;
use boot::mmio::read32;
use boot::mmio::write32;
use kernel::shell::rx::rx_push;

fn tx_ready() -> bool {
    let flags: i32 = read32(uart0_base() + uart_fr_offset());
    return (flags & 0x20) == 0;
}

fn hex_digit(value: i64) -> i64 {
    if value < 10 {
        return 48 + value;
    }
    return 55 + value;
}

fn str_byte_at(text: str8, offset: i64) -> i64 {
    return asm volatile aarch64(
        i64,
        "add $0, $2, $3\nldrb ${0:w}, [$0]",
        0,
        text,
        offset
    );
}

pub fn uart0_init() -> void {
    write32(uart0_base() + uart_icr_offset(), 0x07ff);
    write32(uart0_base() + uart_ifls_offset(), 0);
    write32(
        uart0_base() + uart_imsc_offset(),
        i32(uart_irq_rx_mask() | uart_irq_rt_mask())
    );
    return;
}

pub fn write_byte(value: i64) -> void {
    while !tx_ready() {
        relax();
    }
    write32(uart0_base() + uart_dr_offset(), i32(value));
}

pub fn read_byte() -> i64 {
    while true {
        let flags: i32 = read32(uart0_base() + uart_fr_offset());
        if (flags & 0x10) == 0 {
            let value: i32 = read32(uart0_base() + uart_dr_offset());
            let masked: i32 = value & 0xFF;
            let result: i64 = masked;
            return result;
        }
        relax();
    }
}

pub fn try_read_byte() -> i64 {
    let flags: i32 = read32(uart0_base() + uart_fr_offset());
    if (flags & 0x10) != 0 {
        return -1;
    }
    let value: i32 = read32(uart0_base() + uart_dr_offset());
    let masked: i32 = value & 0xFF;
    let result: i64 = masked;
    return result;
}

pub fn uart_irq_pending() -> i64 {
    let masked: i32 = read32(uart0_base() + uart_mis_offset());
    let result: i64 = masked & i32(uart_irq_rx_mask() | uart_irq_rt_mask());
    return result;
}

pub fn uart_irq_acknowledge() -> void {
    write32(
        uart0_base() + uart_icr_offset(),
        i32(uart_irq_rx_mask() | uart_irq_rt_mask())
    );
}

pub fn uart_irq_drain() -> void {
    while true {
        let byte: i64 = try_read_byte();
        if byte < 0 {
            break;
        }
        rx_push(byte);
    }
    uart_irq_acknowledge();
}

pub fn write_crlf() -> void {
    write_byte(13);
    write_byte(10);
}

pub fn write_str(text: str8) -> void {
    var offset: i64 = 0;
    while true {
        let byte: i64 = str_byte_at(text, offset);
        if byte == 0 {
            break;
        }
        write_byte(byte);
        offset = offset + 1;
    }
}

pub fn write_line(text: str8) -> void {
    write_str(text);
    write_crlf();
}

pub fn echo_byte(value: i64) -> void {
    if value == 13 || value == 10 {
        write_crlf();
        return;
    }
    write_byte(value);
}

pub fn write_hex64(value: i64) -> void {
    var shift: i64 = 60;
    write_str("0x");
    while true {
        let nibble: i64 = (value >> shift) & 0xF;
        write_byte(hex_digit(nibble));
        if shift == 0 {
            break;
        }
        shift = shift - 4;
    }
}
