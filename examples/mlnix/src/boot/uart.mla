use boot::constants::uart0_base;
use boot::constants::uart_dr_offset;
use boot::constants::uart_fr_offset;
use boot::constants::uart_fr_txff;
use boot::cpu::relax;
use boot::mmio::read32;
use boot::mmio::write32;

fn tx_ready() -> bool {
    let flags: i32 = read32(uart0_base() + uart_fr_offset());
    return (flags & 0x20) == 0;
}

fn hex_digit(value: i64) -> i64 {
    if value < 10 {
        return 48 + value;
    }
    return 55 + value;
}

fn str_byte_at(text: str8, offset: i64) -> i64 {
    return asm volatile aarch64(
        i64,
        "mov $0, xzr\nadd x9, $2, $3\nldrb w9, [x9]\nmov $0, x9",
        0,
        text,
        offset
    );
}

pub fn uart0_init() -> void {
    return;
}

pub fn write_byte(value: i64) -> void {
    while !tx_ready() {
        relax();
    }
    write32(uart0_base() + uart_dr_offset(), i32(value));
}

pub fn write_crlf() -> void {
    write_byte(13);
    write_byte(10);
}

pub fn write_str(text: str8) -> void {
    var offset: i64 = 0;
    while true {
        let byte: i64 = str_byte_at(text, offset);
        if byte == 0 {
            break;
        }
        write_byte(byte);
        offset = offset + 1;
    }
}

pub fn write_line(text: str8) -> void {
    write_str(text);
    write_crlf();
}

pub fn write_hex64(value: i64) -> void {
    var shift: i64 = 60;
    write_str("0x");
    while true {
        let nibble: i64 = (value >> shift) & 0xF;
        write_byte(hex_digit(nibble));
        if shift == 0 {
            break;
        }
        shift = shift - 4;
    }
}
