pub fn uart0_base() -> i64 {
    return 0x09000000;
}

pub fn uart_dr_offset() -> i64 {
    return 0x000;
}

pub fn uart_fr_offset() -> i64 {
    return 0x018;
}

pub fn uart_fr_txff() -> i64 {
    return 1 << 5;
}

pub fn uart_fr_rxfe() -> i64 {
    return 1 << 4;
}

pub fn uart_ifls_offset() -> i64 {
    return 0x034;
}

pub fn uart_imsc_offset() -> i64 {
    return 0x038;
}

pub fn uart_mis_offset() -> i64 {
    return 0x040;
}

pub fn uart_icr_offset() -> i64 {
    return 0x044;
}

pub fn uart_irq_rx_mask() -> i64 {
    return 1 << 4;
}

pub fn uart_irq_rt_mask() -> i64 {
    return 1 << 6;
}

pub fn qemu_uart_irq_id() -> i64 {
    return 33;
}

pub fn qemu_virt_load_addr() -> i64 {
    return 0x40080000;
}

pub fn qemu_ram_base() -> i64 {
    return 0x40000000;
}

pub fn qemu_ram_size() -> i64 {
    return 0x10000000;
}

pub fn qemu_mmio_base() -> i64 {
    return 0x08000000;
}

pub fn qemu_gic_dist_base() -> i64 {
    return 0x08000000;
}

pub fn qemu_gic_cpu_base() -> i64 {
    return 0x08010000;
}

pub fn qemu_gic_size() -> i64 {
    return 0x00010000;
}
