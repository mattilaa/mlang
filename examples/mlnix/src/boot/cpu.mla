pub fn relax() -> void {
    asm volatile aarch64(void, "yield");
}

pub fn halt_forever() -> void {
    while true {
        asm volatile aarch64(void, "wfe");
    }
}

pub fn current_el() -> i64 {
    return asm volatile aarch64(
        i64,
        "mov $0, xzr\nmrs x9, CurrentEL\nlsr x9, x9, #2\nmov $0, x9",
        0
    );
}

pub fn esr_el1() -> i64 {
    return asm volatile aarch64(
        i64,
        "mov $0, xzr\nmrs x9, ESR_EL1\nmov $0, x9",
        0
    );
}

pub fn elr_el1() -> i64 {
    return asm volatile aarch64(
        i64,
        "mov $0, xzr\nmrs x9, ELR_EL1\nmov $0, x9",
        0
    );
}

pub fn far_el1() -> i64 {
    return asm volatile aarch64(
        i64,
        "mov $0, xzr\nmrs x9, FAR_EL1\nmov $0, x9",
        0
    );
}

pub fn irq_enable() -> void {
    asm volatile aarch64(void, "msr DAIFClr, #2\nisb");
}

pub fn irq_disable() -> void {
    asm volatile aarch64(void, "msr DAIFSet, #2\nisb");
}
