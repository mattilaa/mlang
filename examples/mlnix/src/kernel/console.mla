mod kernel::scheduler;
mod kernel::shell::commands::help;
mod kernel::shell::dispatch;
mod kernel::shell::line;
mod kernel::state;

use kernel::scheduler::scheduler_request_service;
use kernel::shell::commands::help::cmd_help;
use kernel::shell::dispatch::dispatch_line;
use kernel::shell::line::line_clear_pending;
use kernel::shell::line::line_is_pending;
use kernel::shell::line::line_mark_pending;
use kernel::state::state_console_request_pending_get;
use kernel::state::state_console_request_pending_set;

pub fn print_help() -> void {
    cmd_help();
}

pub fn console_submit_line() -> void {
    line_mark_pending();
    state_console_request_pending_set(1);
    scheduler_request_service();
}

pub fn console_execute_pending() -> void {
    if state_console_request_pending_get() == 0 {
        return;
    }
    state_console_request_pending_set(0);
    if line_is_pending() == 0 {
        return;
    }
    dispatch_line();
    line_clear_pending();
}
