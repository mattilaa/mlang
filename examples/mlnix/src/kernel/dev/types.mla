pub fn dev_kind_none() -> i64 {
    return 0;
}

pub fn dev_kind_console() -> i64 {
    return 1;
}

pub fn dev_kind_ramdisk() -> i64 {
    return 2;
}

pub fn dev_kind_virtio_blk() -> i64 {
    return 3;
}

pub fn dev_flag_present() -> i64 {
    return 1;
}

pub fn dev_flag_readable() -> i64 {
    return 1 << 1;
}

pub fn dev_flag_writable() -> i64 {
    return 1 << 2;
}

pub fn dev_flag_block() -> i64 {
    return 1 << 3;
}

pub fn dev_sector_size() -> i64 {
    return 512;
}
