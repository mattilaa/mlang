mod kernel::console;
mod kernel::shell::line;
mod kernel::shell::rx;
mod kernel::state;

use boot::uart::echo_byte;
use boot::uart::write_byte;
use kernel::console::console_submit_line;
use kernel::console::print_help;
use kernel::shell::line::line_backspace;
use kernel::shell::line::line_length;
use kernel::shell::line::line_push;
use kernel::shell::line::line_reset;
use kernel::shell::rx::rx_init;
use kernel::shell::rx::rx_pop;
use kernel::state::state_shell_prompt_needed_get;
use kernel::state::state_shell_prompt_needed_set;

fn print_prompt() -> void {
    write_byte(109);
    write_byte(108);
    write_byte(110);
    write_byte(105);
    write_byte(120);
    write_byte(62);
    write_byte(32);
}

pub fn shell_init() -> void {
    rx_init();
    line_reset();
    state_shell_prompt_needed_set(1);
    print_help();
}

pub fn shell_poll() -> void {
    if state_shell_prompt_needed_get() != 0 {
        print_prompt();
        state_shell_prompt_needed_set(0);
    }

    let byte: i64 = rx_pop();
    if byte < 0 {
        return;
    }

    if byte == 13 || byte == 10 {
        echo_byte(byte);
        if line_length() > 0 {
            console_submit_line();
        }
        state_shell_prompt_needed_set(1);
        return;
    }

    if byte == 127 || byte == 8 {
        if line_backspace() != 0 {
            write_byte(8);
            write_byte(32);
            write_byte(8);
        }
        return;
    }

    if byte < 32 {
        return;
    }

    if line_push(byte) != 0 {
        echo_byte(byte);
    }
}
