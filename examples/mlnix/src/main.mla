use boot::uart::uart0_init;
use boot::vectors::vectors_init;
use kernel::core::kernel_core_init;
use kernel::core::kernel_core_run;
use kernel::interrupts::interrupts_init;
use kernel::main::kernel_main;

fn boot_entry() -> void {
    uart0_init();
    vectors_init();
    interrupts_init();
    kernel_main();
    kernel_core_init();
    kernel_core_run();
}
