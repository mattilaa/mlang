/// \file std_simd_demo.mla
/// @ingroup examples
/// \brief SIMD-friendly vector add/subtract/multiply/sum helpers.

mod std::simd;
use std::simd::*;

fn main() -> i32 {
    let lhs: list<f32> = [1.0f, 2.0f, 3.0f, 4.0f];
    let rhs: list<f32> = [10.0f, 20.0f, 30.0f, 40.0f];

    let added: list<f32> = add(lhs, rhs);
    let subbed: list<f32> = subtract(rhs, lhs);
    let multiplied: list<f32> = multiply(lhs, rhs);
    let total: f32 = sum(added);

    println!("added[0]={}", added[0]);
    println!("subbed[1]={}", subbed[1]);
    println!("multiplied[2]={}", multiplied[2]);
    println!("sum(added)={}", total);
    return 0;
}
