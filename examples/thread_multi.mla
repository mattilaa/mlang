fn worker(id: i64) -> void {
    var sum: i64 = 0;
    for i in 0..1000 {
        sum = sum + i;
    }
    println!("worker {} sum = {}", id, sum);
}

fn main() -> i32 {
    let h1: Handle<Thread> = thread_spawn(worker, 1);
    let h2: Handle<Thread> = thread_spawn(worker, 2);
    let h3: Handle<Thread> = thread_spawn(worker, 3);
    let h4: Handle<Thread> = thread_spawn(worker, 4);

    thread_join(h1);
    thread_join(h2);
    thread_join(h3);
    thread_join(h4);
    return 0;
}
