/// \file thread_multi.mla
/// @ingroup examples
/// \brief Spawning multiple worker threads and joining them.
///
mod std::thread;
use std::thread::*;

fn worker(id: i64) -> void {
    var sum: i64 = 0;
    for i in 0..1000 {
        sum = sum + i;
    }
    println!("worker {} sum = {}", id, sum);
}

fn main() -> i32 {
    let h1: std::thread::thread = thread::spawn(worker, 1);
    let h2: std::thread::thread = thread::spawn(worker, 2);
    let h3: std::thread::thread = thread::spawn(worker, 3);
    let h4: std::thread::thread = thread::spawn(worker, 4);

    std::thread::join(h1);
    std::thread::join(h2);
    std::thread::join(h3);
    std::thread::join(h4);
    return 0;
}
