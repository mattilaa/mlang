/// \file kernel.mla
/// \brief Minimal freestanding MLang entrypoint for QEMU's AArch64 virt board.

asm aarch64(".section .text.boot, \"ax\"
.global _start
.type _start, %function
_start:
    ldr x0, =__stack_top
    mov sp, x0
    bl kernel_main__void
.Lboot_halt:
    wfe
    b .Lboot_halt
.size _start, . - _start

.section .text, \"ax\"
.global serial_write
.type serial_write, %function
serial_write:
    ldr x1, =0x09000000
.Lserial_next:
    ldrb w2, [x0], #1
    cbz w2, .Lserial_done
.Lserial_wait:
    ldr w3, [x1, #0x18]
    tbnz w3, #5, .Lserial_wait
    str w2, [x1]
    b .Lserial_next
.Lserial_done:
    ret
.size serial_write, . - serial_write

.global __mlang_std_exceptions_push_frame
__mlang_std_exceptions_push_frame:
    mov x0, #0
    ret

.global __mlang_std_exceptions_frame_env
__mlang_std_exceptions_frame_env:
    adrp x0, __mlang_boot_jmp_buffer
    add x0, x0, :lo12:__mlang_boot_jmp_buffer
    ret

.global _setjmp
_setjmp:
    mov w0, #0
    ret

.global __mlang_std_exceptions_pop_frame
__mlang_std_exceptions_pop_frame:
    ret

.global __mlang_std_exceptions_rethrow_current
__mlang_std_exceptions_rethrow_current:
.Lrethrow_halt:
    wfe
    b .Lrethrow_halt

.section .bss, \"aw\", %nobits
.balign 16
__mlang_boot_jmp_buffer:
    .skip 256
");

extern fn serial_write(message: str8) -> void;

fn kernel_main() -> i32 {
    serial_write("Hello from MLang under QEMU!\n");
    serial_write("The MLang kernel entrypoint is running.\n");
    return 0;
}
