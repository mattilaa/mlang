/// Run in a terminal for interaction, or redirect stdout for a plain snapshot.
mod tui;
mod std::io;
mod std::time;
use tui::geometry::*;
use tui::theme::*;
use tui::surface::*;
use tui::layout::*;
use tui::widgets::*;
use tui::menu::*;
use tui::terminal::*;
use tui::focus::*;
use tui::input::*;
use tui::dialog::*;
use tui::table::*;
use std::strbuf::clone;
use std::strbuf::free;
use std::io::stdin;
use std::io::read_keycode_nonblocking;
use std::time::sleep_ms;

fn demo_menus() -> MenuBar {
    return MenuBar::new([
        Menu { title: "File", items: [
            MenuItem { label: "New session", action: 1, enabled: true },
            MenuItem { label: "Open session", action: 2, enabled: true },
            MenuItem { label: "Save session", action: 3, enabled: false },
            MenuItem::submenu("Recent sessions", [
                MenuItem { label: "Blue hour", action: 8, enabled: true },
                MenuItem::submenu("Templates", [
                    MenuItem { label: "Ambient", action: 9, enabled: true },
                    MenuItem { label: "Dance", action: 10, enabled: true }
                ])
            ]),
            MenuItem { label: "Quit", action: 99, enabled: true }] },
        Menu { title: "Edit", items: [
            MenuItem { label: "Undo", action: 4, enabled: true },
            MenuItem { label: "Redo", action: 5, enabled: true }] },
        Menu { title: "View", items: [
            MenuItem { label: "Reset layout", action: 6, enabled: true },
            MenuItem { label: "Show details", action: 7, enabled: true }] }
    ]);
}

fn demo_panes(content: Rect) -> list<Pane> {
    let vertical: Layout = Layout { axis: Axis::Vertical, gap: 0,
        sizes: [Size::flex(1), Size::fixed(1)] };
    let rows: list<Rect> = vertical.split(content);
    let horizontal: Layout = Layout { axis: Axis::Horizontal, gap: 1,
        sizes: [Size::fixed(22), Size::flex(1)] };
    let columns: list<Rect> = horizontal.split(rows[0]);
    let right_layout: Layout = Layout { axis: Axis::Vertical, gap: 1,
        sizes: [Size::flex(2), Size::flex(1)] };
    let right: list<Rect> = right_layout.split(columns[1]);
    return [Pane { id: 0, bounds: columns[0] }, Pane { id: 1, bounds: right[0] },
            Pane { id: 2, bounds: right[1] }];
}

fn demo_table() -> Table {
    var rows: list<TableRow> = [];
    let notes: list<str8> = ["C-4", "E-4", "G-4", "B-4", "C-5", "G-4"];
    for i in 0..64 {
        let number: str8 = format!("{}{}", i < 9 ? "00" : "0", i + 1);
        rows.push(TableRow { cells: [number, notes[i % 6], "100", "Keys"] });
    }
    return Table::new([TableColumn { title: "LINE", width: 7 }, TableColumn { title: "NOTE", width: 9 },
        TableColumn { title: "VEL", width: 7 }, TableColumn { title: "TRACK", width: 16 }], rows);
}

fn release_demo_table(table: Table) -> void {
    let rows: list<TableRow> = table.rows;
    for row in rows { free(row.cells[0]); }
}

fn paint_demo(surface: Surface, menus: &MenuBar, focus: PaneFocus, panes: &list<Pane>, message: str8, table: &Table) -> void {
    let theme: Theme = Theme::dark_blue();
    surface.fill(surface.bounds(), Cell { glyph: 32, foreground: theme.foreground, background: theme.background });
    let library: Pane = panes[0];
    let editor: Pane = panes[1];
    let inspector: Pane = panes[2];
    let sidebar: Panel = Panel { title: " Library " };
    let left: Rect = sidebar.paint_focused(surface, library.bounds, theme, focus.is_active(0));
    surface.text(Rect::new(left.x + 1, left.y + 1, left.width - 2, 1), "PROJECT", theme.muted, theme.panel);
    surface.text(Rect::new(left.x + 1, left.y + 3, left.width - 2, 1), "Sequences", theme.accent, theme.panel);
    surface.text(Rect::new(left.x + 1, left.y + 4, left.width - 2, 1), "Instruments", theme.foreground, theme.panel);
    surface.text(Rect::new(left.x + 1, left.y + 5, left.width - 2, 1), "Automation", theme.foreground, theme.panel);
    let sequence: Panel = Panel { title: " Sequence / 01 " };
    let top: Rect = sequence.paint_focused(surface, editor.bounds, theme, focus.is_active(1));
    table.paint(surface, top, theme);
    let details: Panel = Panel { title: " Inspector " };
    let bottom: Rect = details.paint_focused(surface, inspector.bounds, theme, focus.is_active(2));
    let label: Label = Label { text: message };
    label.paint(surface, bottom, theme);
    surface.text(Rect::new(0, surface.height - 1, surface.width, 1),
        " C-S-H/J/K/L: panes | w/b: column j/k: row | Tab: menu | Esc: close | q: quit",
        theme.muted, theme.background);
    menus.paint(surface, surface.bounds(), theme);
}

fn main() -> i32 {
    var terminal: Terminal = Terminal::begin();
    var menus: MenuBar = demo_menus();
    menus.open(0);
    var focus: PaneFocus = PaneFocus::new(0);
    var input: InputDecoder = InputDecoder::new();
    var dialog: OpenSessionDialog = OpenSessionDialog::new();
    var table: Table = demo_table();
    var question: QuestionDialog = QuestionDialog::new("New session", "Start a new session?");
    var message: str8 = clone("Select a command from the menu.");
    var running: bool = true;
    var dirty: bool = true;
    var previous_width: i32 = 0;
    var previous_height: i32 = 0;
    var escape_ticks: i32 = 0;
    while running {
        if dialog.active && dialog.pressed_button >= 0 {
            dialog.tick(); dirty = true;
            if dialog.accepted { free(message); message = format!("Selected: {}", dialog.accepted_path); }
        }
        if question.active && question.pressed_button >= 0 {
            question.tick(); dirty = true;
            if !question.active {
                free(message); message = clone(question.result == 1 ? "New session confirmed." : "New session cancelled.");
            }
        }
        let area: Rect = terminal_bounds();
        let viewport: Viewport = menus.viewport(area);
        let panes: list<Pane> = demo_panes(viewport.content());
        focus.reconcile(panes);
        focus.set_menu_active(menus.active >= 0 || dialog.active || question.active);
        if dirty || area.width != previous_width || area.height != previous_height {
            let surface: Surface = Surface::new(area.width, area.height);
            if !surface.is_valid() { release_demo_table(table); dialog.release(); free(message); terminal.finish(); return 1; }
            table.reconcile(panes[1].bounds.inset(1));
            paint_demo(surface, menus, focus, panes, message, table);
            dialog.paint(surface, area, Theme::dark_blue());
            question.paint(surface, area, Theme::dark_blue());
            terminal.present(surface);
            surface.release();
            previous_width = area.width;
            previous_height = area.height;
            dirty = false;
        }
        if !terminal.active { break; }
        // Drain a bounded batch so multi-byte shortcuts/repeats do not acquire
        // a separate polling delay for every byte in their escape sequence.
        var received_input: bool = false;
        for _i in 0..128 {
            let byte: i32 = read_keycode_nonblocking(stdin());
            if byte < 0 {
                if byte == -1 { running = false; }
                break;
            }
            received_input = true;
            let event: InputEvent = input.feed(byte);
            escape_ticks = 0;
            var command: i32 = 0;
            if question.active {
                question.on_event(event);
                if !question.active { free(message); message = clone("New session cancelled."); }
                dirty = true;
            }
            else if dialog.active {
                if event.kind != InputKind::None || event.code != 0 {
                    dialog.on_event(event, area);
                    focus.set_menu_active(dialog.active);
                    if dialog.accepted {
                        free(message);
                        message = format!("Selected: {}", dialog.accepted_path);
                    }
                    dirty = true;
                }
            }
            else if event.kind == InputKind::Quit { running = false; }
            // Exclusive input ownership: never call a widget handler from a
            // boolean guard. The compiler may evaluate every operand.
            else if menus.active >= 0 {
                if event.kind != InputKind::None { dirty = true; }
                if event.kind == InputKind::Menu {
                    command = menus.on_key(event.key);
                    focus.set_menu_active(menus.active >= 0);
                    dirty = true;
                }
            }
            else if event.kind == InputKind::Menu && event.key == Key::Toggle {
                command = menus.on_key(event.key);
                focus.set_menu_active(menus.active >= 0);
                dirty = true;
            } else if event.kind == InputKind::Pane {
                focus.navigate(event.key, panes);
                dirty = true;
            } else if focus.selected == 1 {
                if table.on_event(event, panes[1].bounds.inset(1)) { dirty = true; }
            }
            if command == 99 { running = false; }
            else if command == 1 { question.open(); focus.set_menu_active(true); }
            else if command == 2 {
                dialog.open("");
                focus.set_menu_active(true);
            }
            else if command > 0 {
                free(message); message = clone("Command selected. Ready for the application handler.");
            }
            if !running { break; }
        }
        if !received_input && input.pending() {
            escape_ticks = escape_ticks + 1;
            if escape_ticks >= 5 {
                let event: InputEvent = input.expire();
                if question.active {
                    question.on_event(event);
                    if !question.active { free(message); message = clone("New session cancelled."); }
                    dirty = true;
                }
                else if dialog.active {
                    dialog.on_event(event, area);
                    focus.set_menu_active(dialog.active);
                    dirty = true;
                }
                else if event.kind == InputKind::Menu {
                    menus.on_key(event.key);
                    focus.set_menu_active(menus.active >= 0);
                    dirty = true;
                }
            }
        }
        sleep_ms(10);
    }
    release_demo_table(table); dialog.release(); free(message);
    terminal.finish();
    return 0;
}
