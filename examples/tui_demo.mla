/// Run in a terminal for interaction, or redirect stdout for a plain snapshot.
mod tui;
mod std::io;
mod std::time;
use tui::geometry::*;
use tui::theme::*;
use tui::surface::*;
use tui::layout::*;
use tui::widgets::*;
use tui::menu::*;
use tui::terminal::*;
use tui::focus::*;
use tui::input::*;
use tui::dialog::*;
use tui::table::*;
mod tui_demo::sequence;
use tui_demo::sequence::SequenceTable;
mod tui_demo::mixer;
use tui_demo::mixer::Mixer;
mod tui_demo::patterns;
use tui_demo::patterns::PatternLibrary;
mod tui_demo::transport;
use tui_demo::transport::TransportStatus;
mod tui_demo::sample_view;
use tui_demo::sample_view::SampleView;
use std::strbuf::clone;
use std::strbuf::free;
use std::io::stdin;
use std::io::read_keycode_nonblocking;
use std::time::sleep_ms;

fn demo_menus() -> MenuBar {
    return MenuBar::new([
        Menu { title: "File", items: [
            MenuItem { label: "New session", action: 1, enabled: true },
            MenuItem { label: "Open session", action: 2, enabled: true },
            MenuItem { label: "Save session", action: 3, enabled: false },
            MenuItem::submenu("Recent sessions", [
                MenuItem { label: "Blue hour", action: 8, enabled: true },
                MenuItem::submenu("Templates", [
                    MenuItem { label: "Ambient", action: 9, enabled: true },
                    MenuItem { label: "Dance", action: 10, enabled: true }
                ])
            ]),
            MenuItem { label: "Quit", action: 99, enabled: true }] },
        Menu { title: "Edit", items: [
            MenuItem { label: "Undo", action: 4, enabled: true },
            MenuItem { label: "Redo", action: 5, enabled: true }] },
        Menu { title: "View", items: [
            MenuItem { label: "Reset layout", action: 6, enabled: true },
            MenuItem { label: "Show details", action: 7, enabled: true },
            MenuItem::submenu("Meter style", [
                MenuItem { label: "Solid bars", action: 40, enabled: true },
                MenuItem { label: "Grainy (osc)", action: 41, enabled: true }]),
            MenuItem { label: "Show patterns", action: 42, enabled: true },
            MenuItem { label: "Show song", action: 43, enabled: true },
            MenuItem::submenu("Sample view", [
                MenuItem { label: "Normal", action: 70, enabled: true },
                MenuItem { label: "Grainy", action: 71, enabled: true },
                MenuItem::submenu("Type", [
                    MenuItem { label: "Filled blocks", action: 72, enabled: true },
                    MenuItem { label: "Wave (osc)", action: 73, enabled: true }]) ]),
            MenuItem { label: "Audio", action: 44, enabled: true }] },
        Menu { title: "Track", items: [
            MenuItem { label: "Rename", action: 20, enabled: true },
            MenuItem::submenu("Create track", [
                MenuItem { label: "MIDI track", action: 21, enabled: true },
                MenuItem { label: "AUDIO track", action: 28, enabled: true }]),
            MenuItem { label: "Delete", action: 22, enabled: true },
            MenuItem { label: "Duplicate", action: 23, enabled: true },
            MenuItem { label: "Clear pattern", action: 24, enabled: true },
            MenuItem { label: "Mute / unmute", action: 25, enabled: true },
            MenuItem { label: "Configure CC1", action: 26, enabled: true },
            MenuItem { label: "Configure CC2", action: 27, enabled: true }] },
        Menu { title: "Pattern", items: [
            MenuItem { label: "Add pattern", action: 50, enabled: true },
            MenuItem { label: "Rename pattern", action: 51, enabled: true },
            MenuItem { label: "Remove pattern", action: 52, enabled: true },
            MenuItem { label: "Clone pattern", action: 53, enabled: true }] },
        Menu { title: "Add", items: [MenuItem { label: "Audio", action: 60, enabled: true }] }
    ]);
}

fn demo_panes(content: Rect) -> list<Pane> {
    let vertical: Layout = Layout { axis: Axis::Vertical, gap: 0,
        sizes: [Size::flex(1), Size::fixed(1)] };
    let rows: list<Rect> = vertical.split(content);
    let horizontal: Layout = Layout { axis: Axis::Horizontal, gap: 1,
        sizes: [Size::fixed(22), Size::flex(1)] };
    let columns: list<Rect> = horizontal.split(rows[0]);
    let right_layout: Layout = Layout { axis: Axis::Vertical, gap: 1,
        sizes: [Size::flex(2), Size::flex(1)] };
    let right: list<Rect> = right_layout.split(columns[1]);
    return [Pane { id: 0, bounds: columns[0] }, Pane { id: 1, bounds: right[0] },
            Pane { id: 2, bounds: right[1] }];
}

fn paint_demo(surface: Surface, menus: &MenuBar, focus: PaneFocus, panes: &list<Pane>, message: str8, table: &SequenceTable, mixer: Mixer, patterns: &PatternLibrary, transport: TransportStatus, sample: SampleView) -> void {
    let theme: Theme = Theme::dark_blue();
    surface.fill(surface.bounds(), Cell { glyph: 32, foreground: theme.foreground, background: theme.background });
    let library: Pane = panes[0];
    let editor: Pane = panes[1];
    let inspector: Pane = panes[2];
    let sidebar: Panel = Panel { title: patterns.audio_mode ? " Audio " : (patterns.song_mode ? " Song " : " Patterns ") };
    let left: Rect = sidebar.paint_focused(surface, library.bounds, theme, focus.is_active(0));
    if patterns.audio_mode { patterns.audio.view.paint(surface, left, theme); }
    else { patterns.view.paint(surface, left, theme); }
    let title: str8 = format!(" Pattern / {} {} ", patterns.active_id, patterns.active_name());
    let sequence: Panel = Panel { title: title };
    let top: Rect = sequence.paint_focused(surface, editor.bounds, theme, focus.is_active(1));
    free(title);
    table.paint(surface, top, theme);
    table.paint_audio_style(surface, top, theme, sample.grainy, sample.wave);
    table.paint_editor(surface, top, theme);
    let show_sample: bool = sample.visible && table.audio_under_cursor();
    let details: Panel = Panel { title: show_sample ? " Sample " : (mixer.visible ? " Mixer (demo levels) " : " Inspector ") };
    let bottom: Rect = details.paint_focused(surface, inspector.bounds, theme, focus.is_active(2));
    let label: Label = Label { text: patterns.error != "" ? patterns.error : (table.error != "" ? table.error : (table.editing ? "Editing: Enter saves | Esc cancels" : message)) };
    if show_sample {
        let track: SequenceTrack = table.tracks[table.active_track()];
        let instance: AudioInstance = track.instances[track.instance_at(table.selected_row)];
        sample.paint(surface, bottom, theme, instance.clip, table.selected_row - instance.start_row);
        if (patterns.error != "" || table.error != "") && bottom.height > 0 {
            surface.text(Rect::new(bottom.x, bottom.y + bottom.height - 1, bottom.width, 1), patterns.error != "" ? patterns.error : table.error, theme.accent, theme.panel);
        }
    }
    else if mixer.visible {
        mixer.paint(surface, bottom, theme, table.tracks, table.active_track());
        if (patterns.error != "" || table.error != "") && bottom.height > 0 {
            surface.text(Rect::new(bottom.x, bottom.y + bottom.height - 1, bottom.width, 1), patterns.error != "" ? patterns.error : table.error, theme.accent, theme.panel);
        }
    }
    else { label.paint(surface, bottom, theme); table.paint_track_details(surface, bottom, theme); }
    transport.paint(surface, Rect::new(0, surface.height - 1, surface.width, 1), theme);
    menus.paint(surface, surface.bounds(), theme);
}

fn main() -> i32 {
    var terminal: Terminal = Terminal::begin();
    var menus: MenuBar = demo_menus();
    menus.open(0);
    var focus: PaneFocus = PaneFocus::new(0);
    var input: InputDecoder = InputDecoder::new();
    var dialog: OpenSessionDialog = OpenSessionDialog::new();
    var adding_audio: bool = false;
    var library: PatternLibrary = PatternLibrary::new();
    let transport: TransportStatus = TransportStatus {};
    var mixer: Mixer = Mixer { visible: false, phase: 0 };
    var sample: SampleView = SampleView {};
    var mixer_ticks: i32 = 0;
    var question: QuestionDialog = QuestionDialog::new("New session", "Start a new session?");
    var message: str8 = clone("Select a command from the menu.");
    var running: bool = true;
    var dirty: bool = true;
    var previous_width: i32 = 0;
    var previous_height: i32 = 0;
    var escape_ticks: i32 = 0;
    var confirm_track_action: i32 = 0;
    while running {
        if sample.visible && !library.table.audio_under_cursor() { sample.visible = false; dirty = true; }
        if mixer.visible && !sample.visible && menus.active < 0 && !dialog.active && !question.active && !library.table.editing && !library.renaming {
            mixer_ticks = mixer_ticks + 1;
            if mixer_ticks >= 10 { mixer.tick(); mixer_ticks = 0; dirty = true; }
        }
        if dialog.active && dialog.pressed_button >= 0 {
            dialog.tick(); dirty = true;
            if dialog.accepted {
                if adding_audio { library.load_audio(dialog.accepted_path, transport.bpm, terminal_bounds()); }
                free(message); message = format!("Selected: {}", dialog.accepted_path);
            }
        }
        if question.active && question.pressed_button >= 0 {
            question.tick(); dirty = true;
            if !question.active {
                if confirm_track_action != 0 {
                    if question.result == 1 { library.table.track_action(confirm_track_action, terminal_bounds()); }
                    confirm_track_action = 0;
                    free(message); message = clone("Track action finished.");
                } else { free(message); message = clone(question.result == 1 ? "New session confirmed." : "New session cancelled."); }
            }
        }
        let area: Rect = terminal_bounds();
        let viewport: Viewport = menus.viewport(area);
        let panes: list<Pane> = demo_panes(viewport.content());
        focus.reconcile(panes);
        focus.set_menu_active(menus.active >= 0 || dialog.active || question.active || library.table.edit_mode > 0 || library.renaming);
        if dirty || area.width != previous_width || area.height != previous_height {
            let surface: Surface = Surface::new(area.width, area.height);
            if !surface.is_valid() { library.release(); dialog.release(); free(message); terminal.finish(); return 1; }
            library.table.reconcile(panes[1].bounds.inset(1));
            library.view.reconcile(panes[0].bounds.inset(1));
            library.audio.view.reconcile(panes[0].bounds.inset(1));
            paint_demo(surface, menus, focus, panes, message, library.table, mixer, library, transport, sample);
            dialog.paint(surface, area, Theme::dark_blue());
            question.paint(surface, area, Theme::dark_blue());
            library.table.paint_track_dialog(surface, area, Theme::dark_blue());
            library.paint_rename(surface, area, Theme::dark_blue());
            terminal.present(surface);
            surface.release();
            previous_width = area.width;
            previous_height = area.height;
            dirty = false;
        }
        if !terminal.active { break; }
        // Drain a bounded batch so multi-byte shortcuts/repeats do not acquire
        // a separate polling delay for every byte in their escape sequence.
        var received_input: bool = false;
        for _i in 0..128 {
            let byte: i32 = read_keycode_nonblocking(stdin());
            if byte < 0 {
                if byte == -1 { running = false; }
                break;
            }
            received_input = true;
            let event: InputEvent = input.feed(byte);
            // dd is consecutive input in the active sequence, never across a
            // menu, dialog, pane switch, or unrelated key.
            if event.kind != InputKind::None || event.code != 0 {
                if menus.active >= 0 || dialog.active || question.active || library.table.editing || library.renaming || focus.selected != 0 ||
                        event.kind == InputKind::Pane || (event.kind == InputKind::Menu && event.key == Key::Toggle) { library.view.cancel_pending(); library.audio.view.cancel_pending(); }
                if menus.active >= 0 || dialog.active || question.active || focus.selected != 1 ||
                        event.code != 100 || event.modifiers != 1 { library.table.delete_pending = false; }
                if menus.active >= 0 || dialog.active || question.active || focus.selected != 1 ||
                        event.code != 103 || event.modifiers != 1 { library.table.top_pending = false; }
            }
            escape_ticks = 0;
            var command: i32 = 0;
            if library.renaming {
                if event.kind != InputKind::None || event.code != 0 { library.rename_event(event); dirty = true; }
            }
            else if question.active {
                question.on_event(event);
                if !question.active { confirm_track_action = 0; free(message); message = clone("Cancelled."); }
                dirty = true;
            }
            else if dialog.active {
                if event.kind != InputKind::None || event.code != 0 {
                    dialog.on_event(event, area);
                    focus.set_menu_active(dialog.active);
                    if dialog.accepted {
                        if adding_audio { library.load_audio(dialog.accepted_path, transport.bpm, panes[1].bounds.inset(1)); }
                        free(message);
                        message = format!("Selected: {}", dialog.accepted_path);
                    }
                    dirty = true;
                }
            }
            else if library.table.editing {
                if event.kind != InputKind::None || event.code != 0 {
                    library.table.edit_event(event, panes[1].bounds.inset(1)); dirty = true;
                }
            }
            else if event.kind == InputKind::Quit { running = false; }
            // Exclusive input ownership: never call a widget handler from a
            // boolean guard. The compiler may evaluate every operand.
            else if menus.active >= 0 {
                if event.kind != InputKind::None { dirty = true; }
                if event.kind == InputKind::Menu {
                    command = menus.on_key(event.key);
                    focus.set_menu_active(menus.active >= 0);
                    dirty = true;
                }
            }
            else if event.code == 109 && event.modifiers == 1 {
                mixer.visible = !mixer.visible; dirty = true;
            }
            else if event.kind == InputKind::Menu && event.key == Key::Toggle {
                command = menus.on_key(event.key);
                focus.set_menu_active(menus.active >= 0);
                dirty = true;
            } else if event.kind == InputKind::Pane {
                focus.navigate(event.key, panes);
                dirty = true;
            } else if event.code == 115 && event.modifiers == 1 && (focus.selected == 1 || focus.selected == 2) {
                if library.table.audio_under_cursor() { sample.visible = !sample.visible; dirty = true; }
            } else if event.modifiers == 5 && (event.code == 104 || event.code == 108) &&
                (focus.selected == 1 || focus.selected == 2) && sample.visible && library.table.audio_under_cursor() {
                let track: SequenceTrack = library.table.tracks[library.table.active_track()];
                let instance: AudioInstance = track.instances[track.instance_at(library.table.selected_row)];
                if sample.on_event(event, instance.clip, panes[2].bounds.width - 2) { dirty = true; }
            } else if focus.selected == 1 {
                if library.table.edit_event(event, panes[1].bounds.inset(1)) { dirty = true; }
            } else if focus.selected == 0 {
                if library.on_event(event, panes[0].bounds.inset(1)) { dirty = true; }
            }
            if command == 99 { running = false; }
            else if command == 1 {
                question.title = "New session"; question.question = "Start a new session?";
                confirm_track_action = 0; question.open(); focus.set_menu_active(true);
            }
            else if command == 2 {
                adding_audio = false; dialog.title = "Open session"; dialog.file_pattern = "";
                dialog.open("");
                focus.set_menu_active(true);
            }
            else if command == 60 {
                adding_audio = true; dialog.title = "Add audio";
                dialog.file_pattern = ".*\\.([wW][aA][vV]|[aA][iI][fF]([fF])?)";
                dialog.open(""); focus.set_menu_active(true);
            }
            else if command == 22 || command == 24 {
                confirm_track_action = command;
                question.title = command == 22 ? "Delete track" : "Clear track";
                question.question = command == 22 ? "Delete the selected track and its pattern?" : "Clear all rows of the selected track?";
                question.open(); focus.set_menu_active(true);
            }
            else if command == 42 || command == 43 {
                library.show_song(command == 43);
            }
            else if command == 44 { library.show_audio(); }
            else if command == 50 || command == 53 { library.add(command == 53); }
            else if command == 51 {
                library.editor.set_text(library.active_name()); library.renaming = true; library.error = "";
            }
            else if command == 52 { library.remove_active(panes[0].bounds.inset(1)); }
            else if command == 70 || command == 71 { sample.grainy = command == 71; }
            else if command == 72 || command == 73 { sample.wave = command == 73; }
            else if command == 40 || command == 41 {
                mixer.grainy = command == 41;
                free(message); message = clone(mixer.grainy ? "Meter style: grainy (osc)" : "Meter style: solid bars");
            }
            else if command >= 20 && command <= 28 {
                library.table.track_action(command, panes[1].bounds.inset(1));
                free(message); message = clone("Track updated. Mute affects demo state only.");
            }
            else if command > 0 {
                free(message); message = clone("Command selected. Ready for the application handler.");
            }
            if !running { break; }
        }
        if !received_input && input.pending() {
            escape_ticks = escape_ticks + 1;
            if escape_ticks >= 5 {
                let event: InputEvent = input.expire();
                library.table.delete_pending = false;
                library.table.top_pending = false;
                library.view.cancel_pending();
                library.audio.view.cancel_pending();
                if library.renaming { library.rename_event(event); dirty = true; }
                else if question.active {
                    question.on_event(event);
                    if !question.active { confirm_track_action = 0; free(message); message = clone("Cancelled."); }
                    dirty = true;
                }
                else if dialog.active {
                    dialog.on_event(event, area);
                    focus.set_menu_active(dialog.active);
                    dirty = true;
                }
                else if library.table.editing {
                    library.table.edit_event(event, panes[1].bounds.inset(1)); dirty = true;
                }
                else if event.kind == InputKind::Menu {
                    menus.on_key(event.key);
                    focus.set_menu_active(menus.active >= 0);
                    dirty = true;
                }
            }
        }
        sleep_ms(10);
    }
    library.release(); dialog.release(); free(message);
    terminal.finish();
    return 0;
}
