mod std::thread;
use std::thread::*;

// ── Closures in MLang ─────────────────────────────────────────────────────────
//
// MLang supports two closure forms:
//
//   1. Inline capturing closure — stored in a variable, called like a function.
//      The body runs inside the enclosing function scope, so it can read and
//      write the outer variables directly (no captures struct needed).
//
//        var inc = || { count += 1; };
//        inc();
//
//   2. Spawned closure — passed directly to thread::spawn.
//      The body is emitted as a private function and run on a new OS thread.
//
//        let h = thread::spawn(|| { println!("hello from thread!"); });
//        join(h);
//
// Compound assignment operators (+=  -=  *=  /=  %=) are used throughout.


// ── 1. Simple counter ─────────────────────────────────────────────────────────
//
// A closure that increments an outer variable each time it is called.

fn demo_counter() -> void {
    println!("-- 1. Simple counter --");

    var count: int = 0;

    var inc = || {
        count += 1;
        println!("  count is now {}", count);
    };

    inc();
    inc();
    inc();

    println!("  final count: {}", count);
}


// ── 2. Compound assignment operators ─────────────────────────────────────────
//
// All five compound operators work on any mutable binding.

fn demo_compound_assign() -> void {
    println!("-- 2. Compound assignment --");

    var n: int = 2;
    n += 3;   println!("  2 + 3  = {}", n);   // 5
    n *= 4;   println!("  5 * 4  = {}", n);   // 20
    n -= 8;   println!("  20 - 8 = {}", n);   // 12
    n /= 3;   println!("  12 / 3 = {}", n);   // 4
    n %= 3;   println!("  4  % 3 = {}", n);   // 1
}


// ── 3. Accumulator ────────────────────────────────────────────────────────────
//
// A closure that acts as a running sum, demonstrating that the captured
// variable retains its value between calls.

fn demo_accumulator() -> void {
    println!("-- 3. Accumulator --");

    var total: int = 0;

    var add = || {
        total += 10;
    };

    for i in 0..5 {
        add();
    }

    println!("  sum of 5 calls to add (+=10 each): {}", total);   // 50
}


// ── 4. Multiple closures over independent variables ───────────────────────────

fn demo_independent_closures() -> void {
    println!("-- 4. Independent closures --");

    var x: int = 0;
    var y: int = 1;

    var stepX = || { x += 3; };
    var stepY = || { y *= 2; };

    stepX(); stepX(); stepX();   // x = 9
    stepY(); stepY(); stepY();   // y = 8

    println!("  x (0 + 3*3) = {}", x);   // 9
    println!("  y (1 * 2^3) = {}", y);   // 8
}


// ── 5. Closure with internal logic ───────────────────────────────────────────
//
// A closure body can contain any statement: conditions, loops, compound ops.

fn demo_logic_in_closure() -> void {
    println!("-- 5. Logic inside closure --");

    var evens: int = 0;
    var odds:  int = 0;
    var i: int = 0;

    var classify = || {
        if i % 2 == 0: {
            evens += 1;
        } else: {
            odds += 1;
        }
        i += 1;
    };

    for _step in 0..8 {
        classify();
    }

    println!("  processed 0..7:  evens={} odds={}", evens, odds);   // 4 4
}


// ── 6. thread::spawn with a closure ──────────────────────────────────────────
//
// Closures passed to thread::spawn are compiled to a private function and
// executed on a new OS thread.  Note: spawned closures do NOT share memory
// with the parent — they are independent function bodies.

fn demo_spawn_closure() -> void {
    println!("-- 6. thread::spawn with closure --");

    let h1: Handle<Thread> = thread::spawn(|| {
        println!("  [thread 1] hello from spawned closure!");
    });

    let h2: Handle<Thread> = thread::spawn(|| {
        var n: int = 0;
        for i in 1..4 {
            n += i;
        }
        println!("  [thread 2] sum(1..3) = {}", n);   // 6
    });

    join(h1);
    join(h2);
    println!("  both threads finished");
}


// ── 7. Rust-style spawn pattern ───────────────────────────────────────────────
//
// Mirrors the idiomatic Rust `thread::spawn(|| { ... })` syntax.

fn demo_rust_style_spawn() -> void {
    println!("-- 7. Rust-style spawn pattern --");

    let handle: Handle<Thread> = thread::spawn(|| {
        for i in 1..4 {
            println!("  hi number {} from the spawned thread!", i);
        }
    });

    println!("  hi from the main thread!");
    join(handle);
}


// ── main ──────────────────────────────────────────────────────────────────────

fn main() -> i32 {
    demo_counter();
    demo_compound_assign();
    demo_accumulator();
    demo_independent_closures();
    demo_logic_in_closure();
    demo_spawn_closure();
    demo_rust_style_spawn();
    return 0;
}
