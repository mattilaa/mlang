mod std::math;
mod utils;

use std::math::*;

use utils::*;

pub struct Point {
    var x: i32;
    var y: i32;

    // Private method - only callable within the struct
    fn distance_squared(self: Point) -> i32 {
        return self.x * self.x + self.y * self.y;
    }

    // Public method - callable from outside
    pub fn distance(self: Point) -> i32 {
        return i32(f64(self.distance_squared()));
    }
};

struct Base {
    var value: i32;

    pub fn get_value(self: Base) -> i32 {
        return self.value;
    }
};

pub struct Derived : Base {
    var extra: i32;

    pub fn get_total(self: Derived) -> i32 {
        return self.extra + self.value;
    }
};

struct Inner {
    var value: i32;
    pub fn get_value(self: Inner) -> i32 { return self.value; }
};

struct Outer {
    var inner: Inner;
};

fn main() -> i32 {
    let fact5: i32 = factorial(5);
    let sum: i32 = sum_range(1, 5);
    let sq: i32 = square(3);

    let maximum: i32 = max(10, 20);
    let minimum: i32 = min(10, 20);
    let absolute: i32 = abs(0 - 15);

    var result: i32 = fact5 + sum + sq;
    result = result + maximum + minimum;
    result = result + absolute;
    println!("result: {}", result);

    var p: Point;
    p.x = 3;
    p.y = 4;
    let dist: i32 = p.distance();  // Calls Point_distance with p as self
    println!("distance: {}", dist);

    var derived: Derived;
    derived.extra = 50;
    derived.value = 20;
    let v: i32 = derived.get_value();
    println!("v: {} {}", v, derived.get_value());
    println!("derived: {} base: {}", derived.extra, derived.value);

    var outer: Outer;
    outer.inner.value = 42;           // Chained field access
    let v: i32 = outer.inner.value;   // Chained field read
    let x: i32 = outer.inner.get_value();  // Chained method call
    println!("outer.inner.value: {} v: {} inner.get_value: {}", outer.inner.value, v, outer.inner.get_value());

    return 0;
}
