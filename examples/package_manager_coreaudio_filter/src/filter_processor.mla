/// \file filter_processor.mla
/// \ingroup examples
/// \brief MLang realtime filter state exported to the CoreAudio bridge.

mod dsp::filter;

use dsp::filter::Biquad;

extern fn expf(value: f32) -> f32;

var g_filter_mode: i32 = 1;
var g_sample_rate_hz: f32 = 48000.0f;
var g_cutoff_hz: f32 = 12000.0f;
var g_cutoff_target_hz: f32 = 12000.0f;
var g_cutoff_step_hz: f32 = 0.0f;
var g_resonance_db: f32 = 0.0f;
var g_resonance_target_db: f32 = 0.0f;
var g_resonance_step_db: f32 = 0.0f;
var g_ramp_samples_left: i64 = 0;
var g_wet_mix: f32 = 0.0f;
var g_wet_target: f32 = 0.0f;
var g_wet_step: f32 = 0.0f;
var g_wet_samples_left: i64 = 0;

var g_left_x1: f32 = 0.0f;
var g_left_x2: f32 = 0.0f;
var g_left_y1: f32 = 0.0f;
var g_left_y2: f32 = 0.0f;
var g_right_x1: f32 = 0.0f;
var g_right_x2: f32 = 0.0f;
var g_right_y1: f32 = 0.0f;
var g_right_y2: f32 = 0.0f;
var g_left_stage2_x1: f32 = 0.0f;
var g_left_stage2_x2: f32 = 0.0f;
var g_left_stage2_y1: f32 = 0.0f;
var g_left_stage2_y2: f32 = 0.0f;
var g_right_stage2_x1: f32 = 0.0f;
var g_right_stage2_x2: f32 = 0.0f;
var g_right_stage2_y1: f32 = 0.0f;
var g_right_stage2_y2: f32 = 0.0f;

fn clamp_realtime_resonance(resonance_db: f32) -> f32 {
    if resonance_db < 0.0f {
        return 0.0f;
    }
    if resonance_db > 12.0f {
        return 12.0f;
    }
    return resonance_db;
}

fn mlang_dsp_filter_reset(filter_mode: i32, sample_rate_hz: f32, cutoff_hz: f32, resonance_db: f32) {
    let safe_resonance_db: f32 = clamp_realtime_resonance(resonance_db);
    g_filter_mode = filter_mode;
    g_sample_rate_hz = sample_rate_hz;
    g_cutoff_hz = cutoff_hz;
    g_cutoff_target_hz = cutoff_hz;
    g_cutoff_step_hz = 0.0f;
    g_resonance_db = safe_resonance_db;
    g_resonance_target_db = safe_resonance_db;
    g_resonance_step_db = 0.0f;
    g_ramp_samples_left = 0;
    g_wet_mix = 0.0f;
    g_wet_target = 0.0f;
    g_wet_step = 0.0f;
    g_wet_samples_left = 0;
    g_left_x1 = 0.0f;
    g_left_x2 = 0.0f;
    g_left_y1 = 0.0f;
    g_left_y2 = 0.0f;
    g_right_x1 = 0.0f;
    g_right_x2 = 0.0f;
    g_right_y1 = 0.0f;
    g_right_y2 = 0.0f;
    g_left_stage2_x1 = 0.0f;
    g_left_stage2_x2 = 0.0f;
    g_left_stage2_y1 = 0.0f;
    g_left_stage2_y2 = 0.0f;
    g_right_stage2_x1 = 0.0f;
    g_right_stage2_x2 = 0.0f;
    g_right_stage2_y1 = 0.0f;
    g_right_stage2_y2 = 0.0f;
}

fn mlang_dsp_filter_set_target(cutoff_hz: f32, resonance_db: f32, ramp_samples: i64) {
    // Clamp the target before deriving the per-frame step so limiting remains smooth.
    let safe_resonance_db: f32 = clamp_realtime_resonance(resonance_db);
    if ramp_samples <= 0 {
        g_cutoff_hz = cutoff_hz;
        g_resonance_db = safe_resonance_db;
        g_ramp_samples_left = 0;
        return;
    }
    g_cutoff_target_hz = cutoff_hz;
    g_resonance_target_db = safe_resonance_db;
    g_cutoff_step_hz = (cutoff_hz - g_cutoff_hz) / f32(ramp_samples);
    g_resonance_step_db = (safe_resonance_db - g_resonance_db) / f32(ramp_samples);
    g_ramp_samples_left = ramp_samples;
}

fn mlang_dsp_filter_set_wet_target(wet_mix: f32, ramp_samples: i64) {
    let target: f32 = wet_mix < 0.0f ? 0.0f : (wet_mix > 1.0f ? 1.0f : wet_mix);
    if ramp_samples <= 0 {
        g_wet_mix = target;
        g_wet_target = target;
        g_wet_step = 0.0f;
        g_wet_samples_left = 0;
        return;
    }
    g_wet_target = target;
    g_wet_step = (target - g_wet_mix) / f32(ramp_samples);
    g_wet_samples_left = ramp_samples;
}

fn mlang_dsp_filter_begin_frame() {
    if g_ramp_samples_left > 0 {
        g_cutoff_hz = g_cutoff_hz + g_cutoff_step_hz;
        g_resonance_db = g_resonance_db + g_resonance_step_db;
        g_ramp_samples_left = g_ramp_samples_left - 1;
        if g_ramp_samples_left == 0 {
            g_cutoff_hz = g_cutoff_target_hz;
            g_resonance_db = g_resonance_target_db;
        }
    }

    if g_wet_samples_left > 0 {
        g_wet_mix = g_wet_mix + g_wet_step;
        g_wet_samples_left = g_wet_samples_left - 1;
        if g_wet_samples_left == 0 {
            g_wet_mix = g_wet_target;
            g_wet_step = 0.0f;
        }
    }
}

fn mlang_dsp_filter_process_left(input: f32) -> f32 {
    let q_scale: f32 = expf(0.05756462732485114210f * g_resonance_db);
    var stage1: Biquad = Biquad::new();
    var stage2: Biquad = Biquad::new();
    if g_filter_mode == 2 {
        stage1.set_highpass_q(g_cutoff_hz, 0.54119610014619698440f * q_scale, g_sample_rate_hz);
        stage2.set_highpass_q(g_cutoff_hz, 1.30656296487637652790f * q_scale, g_sample_rate_hz);
    } else if g_filter_mode == 3 {
        stage1.set_bandpass_q(g_cutoff_hz, 0.54119610014619698440f * q_scale, g_sample_rate_hz);
        stage2.set_bandpass_q(g_cutoff_hz, 1.30656296487637652790f * q_scale, g_sample_rate_hz);
    } else {
        stage1.set_lowpass_q(g_cutoff_hz, 0.54119610014619698440f * q_scale, g_sample_rate_hz);
        stage2.set_lowpass_q(g_cutoff_hz, 1.30656296487637652790f * q_scale, g_sample_rate_hz);
    }
    stage1.restore_history(g_left_x1, g_left_x2, g_left_y1, g_left_y2);
    stage2.restore_history(g_left_stage2_x1, g_left_stage2_x2, g_left_stage2_y1, g_left_stage2_y2);
    let stage1_output: f32 = stage1.process(input);
    let wet: f32 = stage2.process(stage1_output);
    g_left_x1 = stage1.input_1();
    g_left_x2 = stage1.input_2();
    g_left_y1 = stage1.output_1();
    g_left_y2 = stage1.output_2();
    g_left_stage2_x1 = stage2.input_1();
    g_left_stage2_x2 = stage2.input_2();
    g_left_stage2_y1 = stage2.output_1();
    g_left_stage2_y2 = stage2.output_2();
    return input + (wet - input) * g_wet_mix;
}

fn mlang_dsp_filter_process_right(input: f32) -> f32 {
    let q_scale: f32 = expf(0.05756462732485114210f * g_resonance_db);
    var stage1: Biquad = Biquad::new();
    var stage2: Biquad = Biquad::new();
    if g_filter_mode == 2 {
        stage1.set_highpass_q(g_cutoff_hz, 0.54119610014619698440f * q_scale, g_sample_rate_hz);
        stage2.set_highpass_q(g_cutoff_hz, 1.30656296487637652790f * q_scale, g_sample_rate_hz);
    } else if g_filter_mode == 3 {
        stage1.set_bandpass_q(g_cutoff_hz, 0.54119610014619698440f * q_scale, g_sample_rate_hz);
        stage2.set_bandpass_q(g_cutoff_hz, 1.30656296487637652790f * q_scale, g_sample_rate_hz);
    } else {
        stage1.set_lowpass_q(g_cutoff_hz, 0.54119610014619698440f * q_scale, g_sample_rate_hz);
        stage2.set_lowpass_q(g_cutoff_hz, 1.30656296487637652790f * q_scale, g_sample_rate_hz);
    }
    stage1.restore_history(g_right_x1, g_right_x2, g_right_y1, g_right_y2);
    stage2.restore_history(g_right_stage2_x1, g_right_stage2_x2, g_right_stage2_y1, g_right_stage2_y2);
    let stage1_output: f32 = stage1.process(input);
    let wet: f32 = stage2.process(stage1_output);
    g_right_x1 = stage1.input_1();
    g_right_x2 = stage1.input_2();
    g_right_y1 = stage1.output_1();
    g_right_y2 = stage1.output_2();
    g_right_stage2_x1 = stage2.input_1();
    g_right_stage2_x2 = stage2.input_2();
    g_right_stage2_y1 = stage2.output_1();
    g_right_stage2_y2 = stage2.output_2();
    return input + (wet - input) * g_wet_mix;
}
