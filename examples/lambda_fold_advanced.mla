/// \file lambda_fold_advanced.mla
/// @ingroup examples
/// \brief Advanced fold/reduce demo with lambdas and closures.
///
fn main() -> i32 {
    // Computed lists (duplicated where needed to satisfy move semantics).
    var weights_for_sum: list<i32> = [];
    var weights_for_product: list<i32> = [];
    var even_flags_i32: list<i32> = [];
    var big_flags_i32: list<i32> = [];

    // Outer lambda drives generation.
    var generate = |start: i32, end: i32| {
        for i in start..end {
            // Nested lambda #1: transform input.
            var transformed: i32 = 0;
            var transform = |x: i32| {
                transformed = x * x + 1;
            };
            transform(i);

            // Nested lambda #2: classify and push into computed lists.
            var classify = |v: i32| {
                let w: i32 = v % 3 + 1;
                weights_for_sum.push(w);
                weights_for_product.push(w);
                even_flags_i32.push(v % 2 == 0 ? 1 : 0);
                big_flags_i32.push(v >= 30 ? 1 : 0);
            };
            classify(transformed);
        }
    };

    // i in [1..7] -> transformed: 2,5,10,17,26,37,50
    generate(1, 8);

    // Fold-based reductions over computed lists.
    let weight_sum: i32 = (... + weights_for_sum);
    let weight_product: i32 = (weights_for_product *...);
    let all_even: bool = (... * even_flags_i32) == 1;
    let any_big: bool = (... + big_flags_i32) > 0;

    println!("weight_sum={}", weight_sum);
    println!("weight_product={}", weight_product);
    println!("all_even={} any_big={}", all_even, any_big);

    // Empty-list identities for advanced reduction flows.
    let empty_i32: list<i32> = [];
    let empty_bool: list<bool> = [];
    println!(
            "empty_sum={} empty_mul={} empty_all={} empty_any={}",
            (... + empty_i32),
            (... * empty_i32),
            (... && empty_bool),
            (... || empty_bool)
    );

    return 0;
}
