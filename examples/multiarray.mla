fn main() -> i32 {
    let matrix: multiarray<i32, 3, 3> = {
        {1, 2, 3},
        {4, 5, 6},
        {7, 8, 9}
    };

    let middle: array<i32, 3> = matrix[1];
    println!("middle row: {} {} {}", middle[0], middle[1], middle[2]);
    println!("bottom-right: {}", matrix[2][2]);

    return matrix[0][0] == 1 && matrix[2][2] == 9 ? 0 : 1;
}
