[settings]
diagram = "sequence"
title = "HTTPS authentication sequence"
scale = 1.0
box_radius = 8
arrow_size = 12

[properties]
participant_fill = "#dbeafe"
participant_stroke = "#2563eb"
participant_text = "#0f172a"
message_color = "#334155"

[[participants]]
id = "browser"
label = "Browser"

[[participants]]
id = "gateway"
label = "HTTPS API Gateway"
fill = "#fde68a"
stroke = "#d97706"
text = "#111827"

[[participants]]
id = "auth"
label = "Auth Service"
fill = "#ddd6fe"
stroke = "#7c3aed"
text = "#111827"

[[participants]]
id = "session"
label = "Session Store"
fill = "#bbf7d0"
stroke = "#16a34a"
text = "#052e16"

[[messages]]
from = "browser"
to = "gateway"
label = "POST /login over TLS"
color = "#2563eb"

[[messages]]
from = "gateway"
to = "auth"
label = "Validate credentials"
color = "#d97706"

[[messages]]
from = "auth"
to = "session"
label = "Create authenticated session"
color = "#16a34a"

[[messages]]
from = "session"
to = "auth"
label = "Session id + expiry"
color = "#16a34a"

[[messages]]
from = "auth"
to = "gateway"
label = "JWT + session cookie"
color = "#7c3aed"

[[messages]]
from = "gateway"
to = "browser"
label = "200 OK Set-Cookie auth_sid"
color = "#2563eb"

[[messages]]
from = "browser"
to = "gateway"
label = "GET /profile with cookie"
color = "#2563eb"

[[messages]]
from = "gateway"
to = "session"
label = "Resolve session from cookie"
color = "#16a34a"

[[messages]]
from = "session"
to = "gateway"
label = "Session valid for user"
color = "#16a34a"

[[messages]]
from = "gateway"
to = "browser"
label = "200 OK profile payload"
color = "#2563eb"
