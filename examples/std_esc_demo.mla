/// \file std_esc_demo.mla
/// @ingroup examples
/// \brief ANSI escape sequence demo using std::esc.
///
mod std::esc;

use std::esc::bg;
use std::esc::bold_on;
use std::esc::cmd_clear_screen;
use std::esc::cmd_hide;
use std::esc::cmd_home;
use std::esc::cmd_show;
use std::esc::color_black;
use std::esc::color_bright_cyan;
use std::esc::color_bright_green;
use std::esc::cursor;
use std::esc::cursor_move;
use std::esc::dir_down;
use std::esc::fg;
use std::esc::reset;

fn main() -> i32 {
    println!("{}{}", cursor(cmd_clear_screen()), cursor(cmd_home()));
    println!("{}std::esc demo{}", bold_on(), reset());
    println!("{}green text{}", fg(color_bright_green()), reset());
    println!("{}{}cyan on black{}", fg(color_bright_cyan()), bg(color_black()), reset());
    println!("{}", cursor_move(dir_down(), 1));
    println!("{}", cursor(cmd_hide()));
    println!("{}", cursor(cmd_show()));
    return 0;
}
