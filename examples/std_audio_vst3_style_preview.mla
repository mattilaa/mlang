/// \file std_audio_vst3_style_preview.mla
/// @ingroup examples
/// \brief VST3-style note preview through the common std::audio hardware API.
///
/// The full VST3 plug-in/CoreAudio integration lives in
/// `examples/package_manager_vst3_coreaudio_synth`. This stdlib example keeps
/// the same note-to-oscillator preview idea, but routes hardware output through
/// `std::audio` so the same source can use CoreAudio on macOS or JACK2 on Linux.
///
/// Run:
///   ./build/mlang examples/std_audio_vst3_style_preview.mla -L ./build -lmlang_std -- --help
///   ./build/mlang examples/std_audio_vst3_style_preview.mla -L ./build -lmlang_std -- --device 0 --sample-rate 48000 --buffer 256
///
mod std::argparser;
mod std::audio;
mod std::time;

use std::argparser::ArgParser;
use std::argparser::ParseResult;
use std::audio::AudioDevice;
use std::audio::backend_name;
use std::audio::default_output_device_id;
use std::audio::device_count;
use std::audio::device_name;
use std::time::sleep_ms;

extern fn pow(x: f64, y: f64) -> f64;

fn midi_note_to_frequency(note: i32) -> f64 {
    let semitones: f64 = f64(note - 69) / 12.0;
    return 440.0 * pow(2.0, semitones);
}

fn play_note(dev: AudioDevice, note: i32, velocity: f64, duration_ms: i64) -> i32 {
    let hz: f64 = midi_note_to_frequency(note);
    let tone_r: Result<i32, str8> = dev.play_sine(hz, 0.20 * velocity, duration_ms);
    if tone_r.is_err() {
        println!("note preview failed: {}", tone_r.unwrap_err());
        return 1;
    }
    sleep_ms(duration_ms + 80);
    return 0;
}

fn main(argc: i32, args: list<str8>) -> i32 {
    var ap: ArgParser = ArgParser::new("std_audio_vst3_style_preview", "Preview VST3-style notes through std::audio.");
    ap.option("device", "d", "Output device id; -1 uses the default device", "-1");
    ap.option("sample-rate", "r", "Requested sample rate in Hz; 0 uses backend default", "0");
    ap.option("buffer", "b", "Requested latency buffer size in frames; 0 uses backend default", "0");

    let parsed: ParseResult = ap.parse(argc, args);
    if parsed.help_requested() {
        ap.print_help();
        parsed.free();
        ap.free();
        return 0;
    }
    if parsed.has_error() {
        println!("Error: {}", parsed.error());
        ap.print_help();
        parsed.free();
        ap.free();
        return 1;
    }
    let requested_device: i64 = parsed.get_i64("device");
    let requested_sample_rate: i64 = parsed.get_i64("sample-rate");
    let requested_buffer_frames: i64 = parsed.get_i64("buffer");
    parsed.free();
    ap.free();

    println!("std::audio backend: {}", backend_name());
    println!("related full plugin demo: examples/package_manager_vst3_coreaudio_synth");
    let count: i64 = device_count();
    let default_id: i64 = default_output_device_id();
    println!("output devices: count={} default_id={}", count, default_id);
    var i: i64 = 0;
    while i < count {
        println!("  [{}] {}", i, device_name(i));
        i = i + 1;
    }

    let selected_id: i64 = requested_device >= 0 ? requested_device : default_id;
    if selected_id >= 0 {
        println!("selected output: [{}] {}", selected_id, device_name(selected_id));
    }
    let dev_r: Result<AudioDevice, str8> = selected_id >= 0
        ? AudioDevice::open_with_config(selected_id, "mlang_vst3_style_preview", requested_sample_rate, requested_buffer_frames)
        : AudioDevice::open_default_with_config("mlang_vst3_style_preview", requested_sample_rate, requested_buffer_frames);
    if dev_r.is_err() {
        println!("audio open failed: {}", dev_r.unwrap_err());
        return 1;
    }
    let dev: AudioDevice = dev_r.unwrap();

    let start_r: Result<i32, str8> = dev.start();
    if start_r.is_err() {
        println!("audio start failed: {}", start_r.unwrap_err());
        dev.close();
        return 1;
    }

    println!("sample_rate={} buffer_frames={}", dev.sample_rate(), dev.buffer_frames());
    if play_note(dev, 69, 1.0, 300) != 0 {
        dev.close();
        return 1;
    }
    if play_note(dev, 72, 0.8, 300) != 0 {
        dev.close();
        return 1;
    }
    if play_note(dev, 76, 0.8, 450) != 0 {
        dev.close();
        return 1;
    }

    dev.stop();
    dev.close();
    return 0;
}
