trait Summary {
    fn summarize(self: Self) -> str8;
}

pub struct Post {
    var id: i32;
    var title: str8;
};

impl Summary for Post {
    fn summarize(self: Post) -> str8 {
        return self.title;
    }
}

pub struct Holder<T: Summary> {
    var value: T;
};

impl<T: Summary> Holder {
    pub fn summary(self: Holder<T>) -> str8 {
        return self.value.summarize();
    }
}
