mod std::matrix;

fn near(value:f64, expected:f64) -> bool {
    let difference:f64 = value - expected;
    return difference > -0.000001 && difference < 0.000001;
}

fn main() -> i32 {
    let left: multiarray<i32, 2, 3> = {{1, 2, 3}, {4, 5, 6}};
    let elementwise_right: multiarray<i32, 2, 3> =
        {{6, 5, 4}, {3, 2, 1}};
    let multiply_right: multiarray<i32, 3, 2> =
        {{7, 8}, {9, 10}, {11, 12}};

    println!("Original left matrix (multiarray<i32, 2, 3>)");
    println!("┌             ┐");
    println!("│  {}   {}   {}  │", left[0][0], left[0][1], left[0][2]);
    println!("│  {}   {}   {}  │", left[1][0], left[1][1], left[1][2]);
    println!("└             ┘");
    println!("");

    println!("Element-wise right matrix (multiarray<i32, 2, 3>)");
    println!("┌             ┐");
    println!("│  {}   {}   {}  │", elementwise_right[0][0],
             elementwise_right[0][1], elementwise_right[0][2]);
    println!("│  {}   {}   {}  │", elementwise_right[1][0],
             elementwise_right[1][1], elementwise_right[1][2]);
    println!("└             ┘");
    println!("");

    let added: multiarray<i32, 2, 3> = left.add(elementwise_right);
    println!("add()");
    println!("┌             ┐");
    println!("│  {}   {}   {}  │", added[0][0], added[0][1], added[0][2]);
    println!("│  {}   {}   {}  │", added[1][0], added[1][1], added[1][2]);
    println!("└             ┘");
    println!("");

    let subtracted: multiarray<i32, 2, 3> =
        left.subtract(elementwise_right);
    println!("subtract()");
    println!("┌                ┐");
    println!("│  {}  {}  {}  │", subtracted[0][0], subtracted[0][1],
             subtracted[0][2]);
    println!("│   {}   {}   {}  │", subtracted[1][0], subtracted[1][1],
             subtracted[1][2]);
    println!("└                ┘");
    println!("");

    let hadamard: multiarray<i32, 2, 3> =
        left.hadamard(elementwise_right);
    println!("hadamard()");
    println!("┌                ┐");
    println!("│  {}  {}  {}  │", hadamard[0][0], hadamard[0][1],
             hadamard[0][2]);
    println!("│  {}  {}   {}  │", hadamard[1][0], hadamard[1][1],
             hadamard[1][2]);
    println!("└                ┘");
    println!("");

    let shifted: multiarray<i32, 2, 3> = left.offset(10);
    println!("offset(10)");
    println!("┌                ┐");
    println!("│  {}  {}  {}  │", shifted[0][0], shifted[0][1], shifted[0][2]);
    println!("│  {}  {}  {}  │", shifted[1][0], shifted[1][1], shifted[1][2]);
    println!("└                ┘");
    println!("");

    let scaled: multiarray<i32, 2, 3> = left.scale(2);
    println!("scale(2)");
    println!("┌                ┐");
    println!("│   {}   {}   {}  │", scaled[0][0], scaled[0][1], scaled[0][2]);
    println!("│   {}  {}  {}  │", scaled[1][0], scaled[1][1], scaled[1][2]);
    println!("└                ┘");
    println!("");

    let transposed: multiarray<i32, 3, 2> = left.transpose();
    println!("transpose()");
    println!("┌         ┐");
    println!("│  {}   {}  │", transposed[0][0], transposed[0][1]);
    println!("│  {}   {}  │", transposed[1][0], transposed[1][1]);
    println!("│  {}   {}  │", transposed[2][0], transposed[2][1]);
    println!("└         ┘");
    println!("");

    println!("Right matrix for matmul() (multiarray<i32, 3, 2>)");
    println!("┌           ┐");
    println!("│   {}   {}  │", multiply_right[0][0], multiply_right[0][1]);
    println!("│   {}  {}  │", multiply_right[1][0], multiply_right[1][1]);
    println!("│  {}  {}  │", multiply_right[2][0], multiply_right[2][1]);
    println!("└           ┘");
    println!("");

    let product: multiarray<i32, 2, 2> = left.matmul(multiply_right);
    println!("matmul() / multiply()");
    println!("┌             ┐");
    println!("│   {}   {}  │", product[0][0], product[0][1]);
    println!("│  {}  {}  │", product[1][0], product[1][1]);
    println!("└             ┘");
    println!("");

    println!("sum()");
    println!("┌      ┐");
    println!("│  {}  │", left.sum());
    println!("└      ┘");
    println!("");

    let invertible: multiarray<f64, 2, 2> = {{4.0, 7.0}, {2.0, 6.0}};
    println!("Original invertible matrix (multiarray<f64, 2, 2>)");
    println!("┌                         ┐");
    println!("│  {}  {}  │", invertible[0][0], invertible[0][1]);
    println!("│  {}  {}  │", invertible[1][0], invertible[1][1]);
    println!("└                         ┘");
    println!("");

    let determinant:f64 = invertible.determinant();
    println!("determinant()");
    println!("┌             ┐");
    println!("│  {}  │", determinant);
    println!("└             ┘");
    println!("");

    let inverse: multiarray<f64, 2, 2> = invertible.inverse();
    println!("inverse()");
    println!("┌                           ┐");
    println!("│   {}  {}  │", inverse[0][0], inverse[0][1]);
    println!("│  {}   {}  │", inverse[1][0], inverse[1][1]);
    println!("└                           ┘");
    println!("");

    let identity: multiarray<f64, 2, 2> = invertible.matmul(inverse);
    println!("original.matmul(inverse)");
    println!("┌                         ┐");
    println!("│  {}  {}  │", identity[0][0], identity[0][1]);
    println!("│  {}  {}  │", identity[1][0], identity[1][1]);
    println!("└                         ┘");
    println!("");

    let symmetric: multiarray<f64, 2, 2> = {{2.0, 1.0}, {1.0, 2.0}};
    println!("Original symmetric matrix (multiarray<f64, 2, 2>)");
    println!("┌                         ┐");
    println!("│  {}  {}  │", symmetric[0][0], symmetric[0][1]);
    println!("│  {}  {}  │", symmetric[1][0], symmetric[1][1]);
    println!("└                         ┘");
    println!("");

    let eigenvalues: multiarray<f64, 2> = symmetric.eigenvalues();
    println!("eigenvalues() (ascending)");
    println!("┌                         ┐");
    println!("│  {}  {}  │", eigenvalues[0], eigenvalues[1]);
    println!("└                         ┘");
    println!("");

    let eigenvectors: multiarray<f64, 2, 2> = symmetric.eigenvectors();
    println!("eigenvectors() (vectors are columns)");
    println!("┌                           ┐");
    println!("│  {}   {}  │", eigenvectors[0][0], eigenvectors[0][1]);
    println!("│  {}  {}  │", eigenvectors[1][0], eigenvectors[1][1]);
    println!("└                           ┘");
    println!("");

    var editable: mutmultiarray<i32, 2, 2> = {{1, 2}, {3, 4}};
    let ones: multiarray<i32, 2, 2> = {{1, 1}, {1, 1}};
    println!("Original mutable matrix (mutmultiarray<i32, 2, 2>)");
    println!("┌         ┐");
    println!("│  {}   {}  │", editable[0][0], editable[0][1]);
    println!("│  {}   {}  │", editable[1][0], editable[1][1]);
    println!("└         ┘");
    println!("");

    editable.add_assign(ones);
    println!("add_assign(ones)");
    println!("┌         ┐");
    println!("│  {}   {}  │", editable[0][0], editable[0][1]);
    println!("│  {}   {}  │", editable[1][0], editable[1][1]);
    println!("└         ┘");
    println!("");

    editable.subtract_assign(ones);
    println!("subtract_assign(ones)");
    println!("┌         ┐");
    println!("│  {}   {}  │", editable[0][0], editable[0][1]);
    println!("│  {}   {}  │", editable[1][0], editable[1][1]);
    println!("└         ┘");
    println!("");

    editable.hadamard_assign(ones);
    println!("hadamard_assign(ones)");
    println!("┌         ┐");
    println!("│  {}   {}  │", editable[0][0], editable[0][1]);
    println!("│  {}   {}  │", editable[1][0], editable[1][1]);
    println!("└         ┘");
    println!("");

    editable.offset_assign(1);
    println!("offset_assign(1)");
    println!("┌         ┐");
    println!("│  {}   {}  │", editable[0][0], editable[0][1]);
    println!("│  {}   {}  │", editable[1][0], editable[1][1]);
    println!("└         ┘");
    println!("");

    editable.scale_assign(2);
    println!("scale_assign(2)");
    println!("┌          ┐");
    println!("│  {}   {}  │", editable[0][0], editable[0][1]);
    println!("│  {}  {}  │", editable[1][0], editable[1][1]);
    println!("└          ┘");

    if added[0][0] != 7 || subtracted[0][0] != -5 { return 1; }
    if hadamard[1][2] != 6 || shifted.sum() != 81 { return 2; }
    if scaled[1][2] != 12 || transposed[2][1] != 6 { return 3; }
    if product[0][0] != 58 || product[1][1] != 154 { return 4; }
    if !near(determinant, 10.0) || !near(identity[0][0], 1.0) ||
       !near(identity[1][1], 1.0) { return 5; }
    if !near(eigenvalues[0], 1.0) || !near(eigenvalues[1], 3.0) { return 6; }
    return editable[1][1] == 10 ? 0 : 7;
}
