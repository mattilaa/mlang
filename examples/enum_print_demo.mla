// Demonstrates enum printing in println!/format!.

enum Status : u8 {
    Invalid = 1,
    Busy = 2,
    Success = 3
};

fn main() -> i32 {
    println!("literal: {}", Status::Invalid);

    let s: Status = Status::Success;
    println!("variable: {}", s);

    println!("iterate:");
    for (i, item) in Status.enumerate() {
        println!("  [{}] {}", i, item);
    }

    // Raw integer value that does not map to a declared variant.
    let raw: i32 = 77;
    let unknown: Status = raw;
    println!("unknown: {}", unknown);

    return 0;
}
