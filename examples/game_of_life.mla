/// \file game_of_life.mla
/// @ingroup examples
/// \brief Full-screen Conway's Game of Life rendered as boxed braille-dot glyphs.
///
mod std::ascii;
mod std::bitset;
mod std::esc;
mod std::io;
mod std::rand;
mod std::strbuf;
mod std::term;
mod std::time;

