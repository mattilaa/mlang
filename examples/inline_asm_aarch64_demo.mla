/// \file inline_asm_aarch64_demo.mla
/// @ingroup examples
/// \brief Inline assembly demo targeting AArch64 (ARM64).
///
fn main() -> i32 {
    let base: i64 = 40;
    let delta: i64 = 2;
    let sum: i64 = asm aarch64(i64, "add $0, $1, $2", base, delta);
    asm volatile aarch64(void, "yield");
    if sum != 42 {
        return 1;
    }
    return 0;
}
