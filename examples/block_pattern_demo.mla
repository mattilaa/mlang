fn main() -> i32 {
    let A: string = "▀";
    let B: string = "▄";
    let C: string = "─";
    let blocks: [string; 4] = [A + B + C, B + A + C, A + C + B, B + C + A];

    var p: i64 = 0;
    for _y in 0..8 {
        for _x in 0..29 {
            print!("{}", blocks[p]);
        }
        println!("");
        p = (p + 1) % 4;
    }

    return 0;
}
