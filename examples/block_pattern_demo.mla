/// Block pattern demo (equivalent to the C++ iostream example).
///
/// Prints 8 rows, each with 29 repeated 3-glyph blocks.
/// The block pattern rotates every row.
fn main() -> i32 {
    let blocks: [string; 4] = ["▀▄─", "▄▀─", "▀─▄", "▄─▀"];

    var p: i64 = 0;
    for _y in 0..8 {
        for _x in 0..29 {
            print!("{}", blocks[p]);
        }
        println!("");
        p = (p + 1) % 4;
    }

    return 0;
}
