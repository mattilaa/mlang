/// \file block_pattern_demo.mla
/// @ingroup examples
/// \brief Block-pattern expression demo.
///
fn main() -> i32 {
    let A: str8 = "▀";
    let B: str8 = "▄";
    let C: str8 = "─";
    let blocks: [str8; 4] = [A + B + C, B + A + C, A + C + B, B + C + A];

    var p: i64 = 0;
    for _y in 0..8 {
        for _x in 0..29 {
            print!("{}", blocks[p]);
        }
        println!("");
        p = (p + 1) % 4;
    }

    return 0;
}
