/// \file enum_backing_fail_u8_explicit.mla
/// @ingroup examples
/// \brief Expected-failure demo: explicit u8 enum backing overflow.
///
// Expected compile error:
// enum variant value '256' does not fit backing type 'u8'

enum TooLargeExplicit : u8 {
    A = 256
};

fn main() -> i32 {
    return 0;
}
