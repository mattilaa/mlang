/// \file namespace_demo.mla
/// @ingroup examples
/// \brief C++17-style namespace block demo.
///
/// Demonstrates:
/// - nested namespace block syntax: namespace geometry::units { ... }
/// - C++-style namespace aliases: namespace gu = geometry::units;
/// - local type lookup inside a namespace block
/// - qualified type names and qualified function calls outside the block

namespace geometry::units {
    alias Distance = f32;

    struct Reading {
        let value: Distance = 0.0f;
    };

    fn average(a: Distance, b: Distance) -> Distance {
        return (a + b) / 2.0f;
    }
}

namespace gu = geometry::units;

fn main() -> i32 {
    let start: gu::Distance = 10.0f;
    let end: gu::Distance = 14.0f;
    let reading: gu::Reading = gu::Reading {
        value: gu::average(start, end)
    };

    println!("average distance={}", reading.value);

    {
        namespace local_units = geometry::units;
        let local: local_units::Reading = local_units::Reading {
            value: local_units::average(2.0f, 4.0f)
        };
        println!("local average={}", local.value);
    }

    return 0;
}
