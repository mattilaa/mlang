/// \file kallio_bars_ga_tsp_demo.mla
/// @ingroup examples
/// \brief Kallio bar crawl planner using JSON input and std::algorithm::genetic.
///
/// The JSON file is expected to be an array of bars with:
///   name, address, coordinates.latitude, coordinates.longitude, opening_hours.<day>
/// It can also be an object with:
///   bars: [...], walking_hills: [{ from, to, uphill_m, downhill_m }, ...]
///
/// Coordinates on the command line are scaled integers:
///   latitude 60.1850  -> 601850
///   longitude 24.9500 -> 249500
///
/// Run:
///   ./build/mlang examples/kallio_bars_ga_tsp_demo.mla -L ./build -lmlang_std -o /tmp/kallio_bars_ga_tsp_demo
///   /tmp/kallio_bars_ga_tsp_demo --json examples/kallio_bars.json --day fri --start 17:30 --lat-e4 601882 --lon-e4 249532 --altitude-m 24 --alcohol-percent 5.5 --max-promille 3
///   /tmp/kallio_bars_ga_tsp_demo --json examples/kallio_bars.json --max-bars 0
///
mod std::algorithm::genetic;
mod std::algorithm::rand;
mod std::argparser;
mod std::json;
mod std::strbuf;
mod std::time;

use std::algorithm::genetic::argmax_i64;
use std::algorithm::genetic::genome_at_i64;
use std::algorithm::genetic::random_population_i64;
use std::algorithm::genetic::replace_genome_i64;
use std::algorithm::genetic::reproduce_next_population_i64;
use std::algorithm::rand::seed;
use std::argparser::ArgParser;
use std::argparser::ParseResult;
use std::json::JsonDoc;
use std::json::JsonValue;
use std::json::kind_array;
use std::json::kind_object;
use std::strbuf::eq;
use std::strbuf::len;
use std::strbuf::sub;
use std::strbuf::zpad_i64;
use std::time::now_ms;
use std::time::sleep_ms;

struct bar_data {
    var names: list<str8>;
    var lats: list<i64>;
    var lons: list<i64>;
    var alts: list<i64>;
    var opens: list<i64>;
    var closes: list<i64>;
    var hill_froms: list<i64>;
    var hill_tos: list<i64>;
    var hill_ups: list<i64>;
    var hill_downs: list<i64>;
};

/// Invalid opening-hours stops must dominate ordinary walk/drink costs, so the
/// GA treats the first impossible bar as the end of the useful route.
cexpr fn invalid_hours_stop_penalty() -> i64 {
    return 1000000;
}

/// Extra weight per unplanned remaining stop makes a longer valid prefix score
/// better than a route that fails early, while staying below the base penalty.
cexpr fn unvisited_stop_penalty() -> i64 {
    return 100000;
}

/// Minutes after closing still matter inside invalid routes, but this is kept
/// small compared with the invalid-stop and unvisited-stop penalties.
cexpr fn minutes_after_close_penalty() -> i64 {
    return 20;
}

/// Alcohol cannot be sold between 04:00 and 09:00. The demo requires a whole
/// beer stop to finish outside this window, so it does not schedule purchases
/// that begin before 04:00 but finish during the ban.
cexpr fn alcohol_sales_ban_start_minute() -> i64 {
    return 4 * 60;
}

/// End of the legal alcohol-sales blackout window.
cexpr fn alcohol_sales_ban_end_minute() -> i64 {
    return 9 * 60;
}

/// Default crawl duration cap. Twelve hours keeps long GA routes from drifting
/// into the next day; pass `--max-route-minutes 0` to disable this cap.
cexpr fn default_max_route_minutes() -> i64 {
    return 12 * 60;
}

fn iabs(v: i64) -> i64 {
    if v < 0 {
        return - v;
    }
    return v;
}

fn digit_at(s: str8, index: i64) -> i64 {
    let ch: str8 = sub(s, index, 1);
    if eq(ch, "0") == 1 { return 0; }
    if eq(ch, "1") == 1 { return 1; }
    if eq(ch, "2") == 1 { return 2; }
    if eq(ch, "3") == 1 { return 3; }
    if eq(ch, "4") == 1 { return 4; }
    if eq(ch, "5") == 1 { return 5; }
    if eq(ch, "6") == 1 { return 6; }
    if eq(ch, "7") == 1 { return 7; }
    if eq(ch, "8") == 1 { return 8; }
    if eq(ch, "9") == 1 { return 9; }
    return 0;
}

fn digit_value(ch: str8) -> i64 {
    if eq(ch, "0") == 1 { return 0; }
    if eq(ch, "1") == 1 { return 1; }
    if eq(ch, "2") == 1 { return 2; }
    if eq(ch, "3") == 1 { return 3; }
    if eq(ch, "4") == 1 { return 4; }
    if eq(ch, "5") == 1 { return 5; }
    if eq(ch, "6") == 1 { return 6; }
    if eq(ch, "7") == 1 { return 7; }
    if eq(ch, "8") == 1 { return 8; }
    if eq(ch, "9") == 1 { return 9; }
    return - 1;
}

fn parse_percent_x10(text: str8, fallback: i64) -> i64 {
    let n: i64 = len(text);
    if n <= 0 {
        return fallback;
    }
    var whole: i64 = 0;
    var frac: i64 = 0;
    var has_digit: bool = false;
    var in_frac: bool = false;
    var has_frac: bool = false;
    for i in 0..n {
        let ch: str8 = sub(text, i, 1);
        if eq(ch, ".") == 1 || eq(ch, ",") == 1 {
            if in_frac {
                return fallback;
            }
            in_frac = true;
        } else {
            let d: i64 = digit_value(ch);
            if d < 0 {
                return fallback;
            }
            has_digit = true;
            if in_frac {
                if !has_frac {
                    frac = d;
                    has_frac = true;
                }
            } else {
                whole = whole * 10 + d;
            }
        }
    }
    if !has_digit {
        return fallback;
    }
    return whole * 10 + frac;
}

fn parse_scaled_x10000(text: str8, fallback: i64) -> i64 {
    let n: i64 = len(text);
    if n <= 0 {
        return fallback;
    }
    var sign: i64 = 1;
    var whole: i64 = 0;
    var frac: i64 = 0;
    var frac_digits: i64 = 0;
    var has_digit: bool = false;
    var in_frac: bool = false;
    for i in 0..n {
        let ch: str8 = sub(text, i, 1);
        if i == 0 && eq(ch, "-") == 1 {
            sign = -1;
        } else if eq(ch, ".") == 1 || eq(ch, ",") == 1 {
            if in_frac {
                return fallback;
            }
            in_frac = true;
        } else {
            let d: i64 = digit_value(ch);
            if d < 0 {
                return fallback;
            }
            has_digit = true;
            if in_frac {
                if frac_digits < 4 {
                    frac = frac * 10 + d;
                    frac_digits += 1;
                }
            } else {
                whole = whole * 10 + d;
            }
        }
    }
    if !has_digit {
        return fallback;
    }
    while frac_digits < 4 {
        frac = frac * 10;
        frac_digits += 1;
    }
    return sign * (whole * 10000 + frac);
}

fn parse_clock_minutes(s: str8, offset: i64) -> i64 {
    let hh: i64 = digit_at(s, offset) * 10 + digit_at(s, offset + 1);
    let mm: i64 = digit_at(s, offset + 3) * 10 + digit_at(s, offset + 4);
    return hh * 60 + mm;
}

fn format_clock(minutes_in: i64) -> str8 {
    var minutes: i64 = minutes_in % 1440;
    if minutes < 0 {
        minutes += 1440;
    }
    let hh: i64 = minutes / 60;
    let mm: i64 = minutes % 60;
    let h: str8 = zpad_i64(hh, 2);
    let m: str8 = zpad_i64(mm, 2);
    return format!("{}:{}", h, m);
}

fn format_promille(promille_x100: i64) -> str8 {
    let whole: i64 = promille_x100 / 100;
    let frac: i64 = promille_x100 % 100;
    let frac_s: str8 = zpad_i64(frac, 2);
    return format!("{}.{}", whole, frac_s);
}

fn format_percent_x10(percent_x10: i64) -> str8 {
    let whole: i64 = percent_x10 / 10;
    let frac: i64 = percent_x10 % 10;
    return format!("{}.{}", whole, frac);
}

fn walking_minutes(a_lat: i64, a_lon: i64, b_lat: i64, b_lon: i64) -> i64 {
    let dlat: i64 = iabs(a_lat - b_lat);
    let dlon: i64 = iabs(a_lon - b_lon);
    let meters: i64 = dlat * 11 + dlon * 6;
    let mins: i64 = (meters + 79) / 80;
    if mins < 1 {
        return 1;
    }
    return mins;
}

fn slope_walking_minutes(a_lat: i64, a_lon: i64, a_alt: i64, b_lat: i64, b_lon: i64, b_alt: i64) -> i64 {
    let base: i64 = walking_minutes(a_lat, a_lon, b_lat, b_lon);
    let climb: i64 = b_alt - a_alt;
    var adjusted: i64 = base;
    if climb > 0 {
        adjusted += (climb + 2) / 3;
    }
    if climb < 0 {
        adjusted -= ((0 - climb) + 5) / 10;
    }
    if adjusted < 1 {
        return 1;
    }
    return adjusted;
}

fn hill_adjusted_walking_minutes(base: i64, uphill_m: i64, downhill_m: i64) -> i64 {
    var adjusted: i64 = base;
    if uphill_m > 0 {
        adjusted += (uphill_m + 2) / 3;
    }
    if downhill_m > 0 {
        adjusted -= (downhill_m + 5) / 10;
    }
    if adjusted < 1 {
        return 1;
    }
    return adjusted;
}

fn find_hill_index(from_bar: i64, to_bar: i64, hill_froms: &list<i64>, hill_tos: &list<i64>) -> i64 {
    let n: i64 = hill_froms.len();
    for i in 0..n {
        if hill_froms[i] == from_bar && hill_tos[i] == to_bar {
            return i;
        }
    }
    return - 1;
}

fn route_walking_minutes(
        from_bar: i64,
        to_bar: i64,
        a_lat: i64,
        a_lon: i64,
        a_alt: i64,
        b_lat: i64,
        b_lon: i64,
        b_alt: i64,
        hill_froms: &list<i64>,
        hill_tos: &list<i64>,
        hill_ups: &list<i64>,
        hill_downs: &list<i64>
        ) -> i64 {
    if from_bar >= 0 && to_bar >= 0 {
        let hill_index: i64 = find_hill_index(from_bar, to_bar, hill_froms, hill_tos);
        if hill_index >= 0 {
            let base: i64 = walking_minutes(a_lat, a_lon, b_lat, b_lon);
            return hill_adjusted_walking_minutes(base, hill_ups[hill_index], hill_downs[hill_index]);
        }
    }
    return slope_walking_minutes(a_lat, a_lon, a_alt, b_lat, b_lon, b_alt);
}

fn promille_walk_slowdown_percent(promille_x100: i64) -> i64 {
    if promille_x100 < 50 {
        return 0;
    }
    if promille_x100 < 100 {
        return 10;
    }
    if promille_x100 < 150 {
        return 25;
    }
    if promille_x100 < 200 {
        return 45;
    }
    return 70 + ((promille_x100 - 200) / 5);
}

fn promille_walk_pause_minutes(base_walk: i64, promille_x100: i64) -> i64 {
    if promille_x100 < 200 {
        return 0;
    }
    return((base_walk + 3) / 4) + ((promille_x100 - 200) / 10);
}

fn impaired_walking_minutes(base_walk: i64, promille_x100: i64) -> i64 {
    let slowdown: i64 = promille_walk_slowdown_percent(promille_x100);
    let slowed: i64 = (base_walk * (100 + slowdown) + 99) / 100;
    return slowed + promille_walk_pause_minutes(base_walk, promille_x100);
}

fn entry_refused(bar: i64, arrival_minute: i64, promille_x100: i64) -> bool {
    if promille_x100 < 220 {
        return false;
    }
    if promille_x100 >= 260 {
        return true;
    }
    let chance: i64 = (promille_x100 - 200) * 2;
    let roll: i64 = (bar * 37 + arrival_minute * 11) % 100;
    return roll < chance;
}

fn beer_promille_x100(alcohol_percent_x10: i64) -> i64 {
    if alcohol_percent_x10 <= 0 {
        return 0;
    }
    return(25 * alcohol_percent_x10 + 27) / 55;
}

fn burn_promille_x100(promille_x100: i64, minutes: i64) -> i64 {
    let burn: i64 = (minutes * 15) / 60;
    if burn >= promille_x100 {
        return 0;
    }
    return promille_x100 - burn;
}

fn opening_start(hours: str8) -> i64 {
    if eq(hours, "closed") == 1 {
        return - 1;
    }
    return parse_clock_minutes(hours, 0);
}

fn opening_end(hours: str8) -> i64 {
    if eq(hours, "closed") == 1 {
        return - 1;
    }
    let start: i64 = parse_clock_minutes(hours, 0);
    var close: i64 = parse_clock_minutes(hours, 6);
    if close <= start {
        close += 1440;
    }
    return close;
}

fn day_start_for_minute(minute: i64) -> i64 {
    var day_start: i64 = (minute / 1440) * 1440;
    if minute < 0 && minute % 1440 != 0 {
        day_start -= 1440;
    }
    return day_start;
}

fn overlaps_alcohol_sales_ban(start_minute: i64, end_minute: i64) -> bool {
    let day_start: i64 = day_start_for_minute(start_minute);
    let ban_start: i64 = day_start + alcohol_sales_ban_start_minute();
    let ban_end: i64 = day_start + alcohol_sales_ban_end_minute();
    if start_minute < ban_end && end_minute > ban_start {
        return true;
    }
    let next_ban_start: i64 = ban_start + 1440;
    let next_ban_end: i64 = ban_end + 1440;
    return start_minute < next_ban_end && end_minute > next_ban_start;
}

fn exceeds_route_minutes(start_minute: i64, end_minute: i64, max_route_minutes: i64) -> bool {
    if max_route_minutes <= 0 {
        return false;
    }
    return end_minute - start_minute > max_route_minutes;
}

fn projected_return_end_after_stop(
        stop_end: i64,
        bar: i64,
        bar_lat: i64,
        bar_lon: i64,
        bar_alt: i64,
        start_lat: i64,
        start_lon: i64,
        start_alt: i64,
        promille_after_stop_x100: i64,
        hill_froms: &list<i64>,
        hill_tos: &list<i64>,
        hill_ups: &list<i64>,
        hill_downs: &list<i64>
        ) -> i64 {
    let return_base_walk: i64 = route_walking_minutes(bar,-1, bar_lat, bar_lon, bar_alt, start_lat, start_lon, start_alt, hill_froms, hill_tos, hill_ups, hill_downs);
    return stop_end + impaired_walking_minutes(return_base_walk, promille_after_stop_x100);
}

fn has_value(values: &list<i64>, needle: i64) -> bool {
    let n: i64 = values.len();
    for i in 0..n {
        if values[i] == needle {
            return true;
        }
    }
    return false;
}

fn find_name(names: &list<str8>, needle: str8) -> i64 {
    let n: i64 = names.len();
    for i in 0..n {
        if eq(names[i], needle) == 1 {
            return i;
        }
    }
    return - 1;
}

fn repair_permutation(raw: &list<i64>, count: i64) -> list<i64> {
    var out: list<i64> = [];
    let n: i64 = raw.len();
    for i in 0..n {
        var v: i64 = raw[i];
        if count > 0 {
            v = v % count;
            if v < 0 {
                v += count;
            }
        }
        if !has_value(out, v) {
            out.push(v);
        }
    }
    for i in 0..count {
        if !has_value(out, i) {
            out.push(i);
        }
    }
    return out;
}

fn repair_population(flat: &list<i64>, pop_size: i64, gene_count: i64) -> list<i64> {
    var out: list<i64> = [];
    for p in 0..pop_size {
        let genome: list<i64> = genome_at_i64(flat, gene_count, p);
        let fixed: list<i64> = repair_permutation(genome, gene_count);
        for i in 0..gene_count {
            out.push(fixed[i]);
        }
    }
    return out;
}

fn map_route_excluding(route: &list<i64>, excluded: i64) -> list<i64> {
    var out: list<i64> = [];
    let n: i64 = route.len();
    for i in 0..n {
        let v: i64 = route[i];
        if v >= excluded {
            out.push(v + 1);
        } else {
            out.push(v);
        }
    }
    return out;
}

fn prepend_bar(bar: i64, route: &list<i64>) -> list<i64> {
    var out: list<i64> = [];
    out.push(bar);
    let n: i64 = route.len();
    for i in 0..n {
        if route[i] != bar {
            out.push(route[i]);
        }
    }
    return out;
}

fn route_penalty(
        route: &list<i64>,
        start_minute: i64,
        start_lat: i64,
        start_lon: i64,
        start_alt: i64,
        beer_minutes: i64,
        alcohol_percent_x10: i64,
        max_promille_x100: i64,
        max_route_minutes: i64,
        use_opening_hours: i64,
        lats: &list<i64>,
        lons: &list<i64>,
        alts: &list<i64>,
        opens: &list<i64>,
        closes: &list<i64>,
        hill_froms: &list<i64>,
        hill_tos: &list<i64>,
        hill_ups: &list<i64>,
        hill_downs: &list<i64>
        ) -> i64 {
    var now: i64 = start_minute;
    var lat: i64 = start_lat;
    var lon: i64 = start_lon;
    var alt: i64 = start_alt;
    var current_bar: i64 = -1;
    var promille_x100: i64 = 0;
    var total: i64 = 0;
    let n: i64 = route.len();
    for i in 0..n {
        let bar: i64 = route[i];
        let base_walk: i64 = route_walking_minutes(current_bar, bar, lat, lon, alt, lats[bar], lons[bar], alts[bar], hill_froms, hill_tos, hill_ups, hill_downs);
        let walk: i64 = impaired_walking_minutes(base_walk, promille_x100);
        now += walk;
        promille_x100 = burn_promille_x100(promille_x100, walk);
        total += walk;

        if use_opening_hours == 0 {
            let stop_end: i64 = now + beer_minutes;
            let promille_after_stop_x100: i64 = burn_promille_x100(promille_x100 + beer_promille_x100(alcohol_percent_x10), beer_minutes);
            let projected_end: i64 = projected_return_end_after_stop(stop_end, bar, lats[bar], lons[bar], alts[bar], start_lat, start_lon, start_alt, promille_after_stop_x100, hill_froms, hill_tos, hill_ups, hill_downs);
            if overlaps_alcohol_sales_ban(now, stop_end) || exceeds_route_minutes(start_minute, projected_end, max_route_minutes) {
                return total + invalid_hours_stop_penalty() + (n - i) * unvisited_stop_penalty();
            }
        }

        if use_opening_hours != 0 {
            let open: i64 = opens[bar];
            let close: i64 = closes[bar];
            if open < 0 || close < 0 {
                return total + invalid_hours_stop_penalty() + (n - i) * unvisited_stop_penalty();
            } else {
                var open_abs: i64 = open;
                var close_abs: i64 = close;
                if open_abs < start_minute - 720 {
                    open_abs += 1440;
                    close_abs += 1440;
                }
                if now < open_abs {
                    let wait: i64 = open_abs - now;
                    now += wait;
                    promille_x100 = burn_promille_x100(promille_x100, wait);
                    total += wait;
                }
                let waited_stop_end: i64 = now + beer_minutes;
                let promille_after_stop_x100: i64 = burn_promille_x100(promille_x100 + beer_promille_x100(alcohol_percent_x10), beer_minutes);
                let projected_end: i64 = projected_return_end_after_stop(waited_stop_end, bar, lats[bar], lons[bar], alts[bar], start_lat, start_lon, start_alt, promille_after_stop_x100, hill_froms, hill_tos, hill_ups, hill_downs);
                if overlaps_alcohol_sales_ban(now, waited_stop_end) || exceeds_route_minutes(start_minute, projected_end, max_route_minutes) {
                    return total + invalid_hours_stop_penalty() + (n - i) * unvisited_stop_penalty();
                }
                if waited_stop_end > close_abs {
                    return total + invalid_hours_stop_penalty() + (n - i) * unvisited_stop_penalty() + (waited_stop_end - close_abs) * minutes_after_close_penalty();
                }
            }
        }
        if entry_refused(bar, now, promille_x100) {
            total += 120000 + promille_x100 * 500;
        } else if promille_x100 >= 200 {
            total += 20000 + (promille_x100 - 200) * 300;
        }

        promille_x100 += beer_promille_x100(alcohol_percent_x10);
        if max_promille_x100 > 0 && promille_x100 > max_promille_x100 {
            total += 100000 + (promille_x100 - max_promille_x100) * 1000;
        }
        now += beer_minutes;
        promille_x100 = burn_promille_x100(promille_x100, beer_minutes);
        total += beer_minutes;
        lat = lats[bar];
        lon = lons[bar];
        alt = alts[bar];
        current_bar = bar;
    }
    let return_base_walk: i64 = route_walking_minutes(current_bar,-1, lat, lon, alt, start_lat, start_lon, start_alt, hill_froms, hill_tos, hill_ups, hill_downs);
    let return_walk: i64 = impaired_walking_minutes(return_base_walk, promille_x100);
    total += return_walk;
    return total;
}

fn trim_route_for_opening_hours(
        route: &list<i64>,
        start_minute: i64,
        start_lat: i64,
        start_lon: i64,
        start_alt: i64,
        beer_minutes: i64,
        alcohol_percent_x10: i64,
        max_route_minutes: i64,
        use_opening_hours: i64,
        lats: &list<i64>,
        lons: &list<i64>,
        alts: &list<i64>,
        opens: &list<i64>,
        closes: &list<i64>,
        hill_froms: &list<i64>,
        hill_tos: &list<i64>,
        hill_ups: &list<i64>,
        hill_downs: &list<i64>
        ) -> list<i64> {
    var out: list<i64> = [];
    var now: i64 = start_minute;
    var lat: i64 = start_lat;
    var lon: i64 = start_lon;
    var alt: i64 = start_alt;
    var current_bar: i64 = -1;
    var promille_x100: i64 = 0;
    let n: i64 = route.len();
    for i in 0..n {
        let bar: i64 = route[i];
        let base_walk: i64 = route_walking_minutes(current_bar, bar, lat, lon, alt, lats[bar], lons[bar], alts[bar], hill_froms, hill_tos, hill_ups, hill_downs);
        let walk: i64 = impaired_walking_minutes(base_walk, promille_x100);
        now += walk;
        promille_x100 = burn_promille_x100(promille_x100, walk);

        if use_opening_hours != 0 {
            let open: i64 = opens[bar];
            let close: i64 = closes[bar];
            if open < 0 || close < 0 {
                return out;
            }
            var open_abs: i64 = open;
            var close_abs: i64 = close;
            if open_abs < start_minute - 720 {
                open_abs += 1440;
                close_abs += 1440;
            }
            if now < open_abs {
                let wait: i64 = open_abs - now;
                now = open_abs;
                promille_x100 = burn_promille_x100(promille_x100, wait);
            }
            let waited_stop_end: i64 = now + beer_minutes;
            let promille_after_stop_x100: i64 = burn_promille_x100(promille_x100 + beer_promille_x100(alcohol_percent_x10), beer_minutes);
            let projected_end: i64 = projected_return_end_after_stop(waited_stop_end, bar, lats[bar], lons[bar], alts[bar], start_lat, start_lon, start_alt, promille_after_stop_x100, hill_froms, hill_tos, hill_ups, hill_downs);
            if overlaps_alcohol_sales_ban(now, waited_stop_end) || exceeds_route_minutes(start_minute, projected_end, max_route_minutes) {
                return out;
            }
            if waited_stop_end > close_abs {
                return out;
            }
        } else {
            let stop_end: i64 = now + beer_minutes;
            let promille_after_stop_x100: i64 = burn_promille_x100(promille_x100 + beer_promille_x100(alcohol_percent_x10), beer_minutes);
            let projected_end: i64 = projected_return_end_after_stop(stop_end, bar, lats[bar], lons[bar], alts[bar], start_lat, start_lon, start_alt, promille_after_stop_x100, hill_froms, hill_tos, hill_ups, hill_downs);
            if overlaps_alcohol_sales_ban(now, stop_end) || exceeds_route_minutes(start_minute, projected_end, max_route_minutes) {
                return out;
            }
        }

        out.push(bar);
        promille_x100 += beer_promille_x100(alcohol_percent_x10);
        now += beer_minutes;
        promille_x100 = burn_promille_x100(promille_x100, beer_minutes);
        lat = lats[bar];
        lon = lons[bar];
        alt = alts[bar];
        current_bar = bar;
    }
    return out;
}

fn score_population(
        population: &list<i64>,
        pop_size: i64,
        gene_count: i64,
        start_minute: i64,
        start_lat: i64,
        start_lon: i64,
        start_alt: i64,
        beer_minutes: i64,
        alcohol_percent_x10: i64,
        max_promille_x100: i64,
        max_route_minutes: i64,
        use_opening_hours: i64,
        lats: &list<i64>,
        lons: &list<i64>,
        alts: &list<i64>,
        opens: &list<i64>,
        closes: &list<i64>,
        hill_froms: &list<i64>,
        hill_tos: &list<i64>,
        hill_ups: &list<i64>,
        hill_downs: &list<i64>
        ) -> list<i64> {
    var fitness: list<i64> = [];
    let bias: i64 = 10000000;
    for p in 0..pop_size {
        let route: list<i64> = genome_at_i64(population, gene_count, p);
        let penalty: i64 = route_penalty(route, start_minute, start_lat, start_lon, start_alt, beer_minutes, alcohol_percent_x10, max_promille_x100, max_route_minutes, use_opening_hours, lats, lons, alts, opens, closes, hill_froms, hill_tos, hill_ups, hill_downs);
        fitness.push(bias - penalty);
    }
    return fitness;
}

fn empty_bar_data() -> bar_data {
    return bar_data {
        names: [],
        lats: [],
        lons: [],
        alts: [],
        opens: [],
        closes: [],
        hill_froms: [],
        hill_tos: [],
        hill_ups: [],
        hill_downs: []
    };
}

fn load_bars(path: str8, day: str8) -> bar_data {
    var names: list<str8> = [];
    var lats: list<i64> = [];
    var lons: list<i64> = [];
    var alts: list<i64> = [];
    var opens: list<i64> = [];
    var closes: list<i64> = [];
    var hill_froms: list<i64> = [];
    var hill_tos: list<i64> = [];
    var hill_ups: list<i64> = [];
    var hill_downs: list<i64> = [];

    let doc_r: Result<JsonDoc, str8> = JsonDoc::from_file(path);
    if doc_r.is_err() {
        println!("json load failed: {}", doc_r.unwrap_err());
        return empty_bar_data();
    }
    let doc: JsonDoc = doc_r.unwrap();
    let root_r: Result<JsonValue, str8> = doc.root();
    if root_r.is_err() {
        println!("json root failed: {}", root_r.unwrap_err());
        doc.free();
        return empty_bar_data();
    }
    let root: JsonValue = root_r.unwrap();
    var bars_root: JsonValue = root;
    var hills_root_r: Result<JsonValue, str8> = Err<JsonValue, str8>("no walking_hills");
    if root.kind() == kind_object() {
        let bars_r: Result<JsonValue, str8> = root.get("bars");
        if bars_r.is_err() {
            println!("json object root is missing bars");
            root.free();
            doc.free();
            return empty_bar_data();
        }
        bars_root = bars_r.unwrap();
        hills_root_r = root.get("walking_hills");
    }
    if bars_root.kind() != kind_array() {
        println!("json bars root is not an array");
        root.free();
        doc.free();
        return empty_bar_data();
    }
    let count_r: Result<i64, str8> = bars_root.size();
    if count_r.is_err() {
        println!("json bars root is not an array");
        root.free();
        doc.free();
        return empty_bar_data();
    }

    let count: i64 = count_r.unwrap();
    for i in 0..count {
        let item_r: Result<JsonValue, str8> = bars_root.index(i);
        if item_r.is_err() {
            continue;
        }
        let item: JsonValue = item_r.unwrap();
        let name_v_r: Result<JsonValue, str8> = item.get("name");
        let coords_r: Result<JsonValue, str8> = item.get("coordinates");
        let opening_r: Result<JsonValue, str8> = item.get("opening_hours");
        if name_v_r.is_err() || coords_r.is_err() || opening_r.is_err() {
            continue;
        }
        let name_v: JsonValue = name_v_r.unwrap();
        let coords: JsonValue = coords_r.unwrap();
        let opening: JsonValue = opening_r.unwrap();
        let lat_v_r: Result<JsonValue, str8> = coords.get("latitude");
        let lon_v_r: Result<JsonValue, str8> = coords.get("longitude");
        let alt_v_r: Result<JsonValue, str8> = coords.get("altitude_m");
        let hours_v_r: Result<JsonValue, str8> = opening.get(day);
        if lat_v_r.is_err() || lon_v_r.is_err() || alt_v_r.is_err() || hours_v_r.is_err() {
            continue;
        }
        let lat_v: JsonValue = lat_v_r.unwrap();
        let lon_v: JsonValue = lon_v_r.unwrap();
        let alt_v: JsonValue = alt_v_r.unwrap();
        let hours_v: JsonValue = hours_v_r.unwrap();
        let name_r: Result<str8, str8> = name_v.as_string();
        let lat_r: Result<f64, str8> = lat_v.as_f64();
        let lon_r: Result<f64, str8> = lon_v.as_f64();
        let alt_r: Result<i64, str8> = alt_v.as_i64();
        let hours_r: Result<str8, str8> = hours_v.as_string();
        if name_r.is_err() || lat_r.is_err() || lon_r.is_err() || alt_r.is_err() || hours_r.is_err() {
            continue;
        }
        let name: str8 = name_r.unwrap();
        let lat_f: f64 = lat_r.unwrap();
        let lon_f: f64 = lon_r.unwrap();
        let alt_m: i64 = alt_r.unwrap();
        let hours: str8 = hours_r.unwrap();

        names.push(name);
        lats.push(i32(lat_f * 10000.0));
        lons.push(i32(lon_f * 10000.0));
        alts.push(alt_m);
        opens.push(opening_start(hours));
        closes.push(opening_end(hours));
    }

    if hills_root_r.is_ok() {
        let hills_root: JsonValue = hills_root_r.unwrap();
        if hills_root.kind() == kind_array() {
            let hill_count_r: Result<i64, str8> = hills_root.size();
            if hill_count_r.is_ok() {
                let hill_count: i64 = hill_count_r.unwrap();
                for i in 0..hill_count {
                    let hill_r: Result<JsonValue, str8> = hills_root.index(i);
                    if hill_r.is_err() {
                        continue;
                    }
                    let hill: JsonValue = hill_r.unwrap();
                    let from_r: Result<JsonValue, str8> = hill.get("from");
                    let to_r: Result<JsonValue, str8> = hill.get("to");
                    let up_r: Result<JsonValue, str8> = hill.get("uphill_m");
                    let down_r: Result<JsonValue, str8> = hill.get("downhill_m");
                    if from_r.is_err() || to_r.is_err() || up_r.is_err() || down_r.is_err() {
                        continue;
                    }
                    let from_v: JsonValue = from_r.unwrap();
                    let to_v: JsonValue = to_r.unwrap();
                    let up_v: JsonValue = up_r.unwrap();
                    let down_v: JsonValue = down_r.unwrap();
                    let from_name_r: Result<str8, str8> = from_v.as_string();
                    let to_name_r: Result<str8, str8> = to_v.as_string();
                    let up_m_r: Result<i64, str8> = up_v.as_i64();
                    let down_m_r: Result<i64, str8> = down_v.as_i64();
                    if from_name_r.is_err() || to_name_r.is_err() || up_m_r.is_err() || down_m_r.is_err() {
                        continue;
                    }
                    let from_index: i64 = find_name(names, from_name_r.unwrap());
                    let to_index: i64 = find_name(names, to_name_r.unwrap());
                    if from_index < 0 || to_index < 0 {
                        continue;
                    }
                    hill_froms.push(from_index);
                    hill_tos.push(to_index);
                    hill_ups.push(up_m_r.unwrap());
                    hill_downs.push(down_m_r.unwrap());
                }
            }
        }
    }

    root.free();
    doc.free();
    return bar_data {
        names: names,
        lats: lats,
        lons: lons,
        alts: alts,
        opens: opens,
        closes: closes,
        hill_froms: hill_froms,
        hill_tos: hill_tos,
        hill_ups: hill_ups,
        hill_downs: hill_downs
    };
}

fn print_schedule(
        route: &list<i64>,
        names: &list<str8>,
        lats: &list<i64>,
        lons: &list<i64>,
        alts: &list<i64>,
        opens: &list<i64>,
        closes: &list<i64>,
        start_minute: i64,
        start_lat: i64,
        start_lon: i64,
        start_alt: i64,
        beer_minutes: i64,
        alcohol_percent_x10: i64,
        max_promille_x100: i64,
        use_opening_hours: i64,
        hill_froms: &list<i64>,
        hill_tos: &list<i64>,
        hill_ups: &list<i64>,
        hill_downs: &list<i64>,
        row_delay_ms: i64
        ) -> void {
    var now: i64 = start_minute;
    var lat: i64 = start_lat;
    var lon: i64 = start_lon;
    var alt: i64 = start_alt;
    var current_bar: i64 = -1;
    var promille_x100: i64 = 0;
    let n: i64 = route.len();
    for i in 0..n {
        let bar: i64 = route[i];
        let base_walk: i64 = route_walking_minutes(current_bar, bar, lat, lon, alt, lats[bar], lons[bar], alts[bar], hill_froms, hill_tos, hill_ups, hill_downs);
        let pause: i64 = promille_walk_pause_minutes(base_walk, promille_x100);
        let slowdown: i64 = promille_walk_slowdown_percent(promille_x100);
        let walk: i64 = impaired_walking_minutes(base_walk, promille_x100);
        now += walk;
        promille_x100 = burn_promille_x100(promille_x100, walk);
        var note: str8 = "";
        if use_opening_hours != 0 {
            let open: i64 = opens[bar];
            let close: i64 = closes[bar];
            if open < 0 || close < 0 {
                note = "closed";
            } else {
                var open_abs: i64 = open;
                var close_abs: i64 = close;
                if open_abs < start_minute - 720 {
                    open_abs += 1440;
                    close_abs += 1440;
                }
                if now < open_abs {
                    let wait: i64 = open_abs - now;
                    now = open_abs;
                    promille_x100 = burn_promille_x100(promille_x100, wait);
                    note = "waited";
                }
                if now + beer_minutes > close_abs {
                    note = "misses close";
                }
            }
        }
        if entry_refused(bar, now, promille_x100) {
            note = "entry refused";
        } else if promille_x100 >= 200 {
            note = "entry risk";
        }
        let entry_promille: str8 = format_promille(promille_x100);
        let after_beer_promille: i64 = promille_x100 + beer_promille_x100(alcohol_percent_x10);
        if max_promille_x100 > 0 && after_beer_promille > max_promille_x100 && len(note) == 0 {
            note = "over max promille";
        }
        let arrive: str8 = format_clock(now);
        let leave: str8 = format_clock(now + beer_minutes);
        println!("{}. {}", i + 1, names[bar]);
        println!("    - arrive={}", arrive);
        println!("    - leave={}", leave);
        println!("    - walk={}min", walk);
        if slowdown > 0 {
            println!("    - walk_slowdown_percent={}", slowdown);
        }
        if pause > 0 {
            println!("    - walk_pause={}min", pause);
        }
        println!("    - altitude={}m", alts[bar]);
        println!("    - promille={}", entry_promille);
        if len(note) > 0 {
            println!("    - note={}", note);
        }
        println!("");
        if row_delay_ms > 0 {
            sleep_ms(row_delay_ms);
        }
        promille_x100 = after_beer_promille;
        now += beer_minutes;
        promille_x100 = burn_promille_x100(promille_x100, beer_minutes);
        lat = lats[bar];
        lon = lons[bar];
        alt = alts[bar];
        current_bar = bar;
    }
    let return_base_walk: i64 = route_walking_minutes(current_bar,-1, lat, lon, alt, start_lat, start_lon, start_alt, hill_froms, hill_tos, hill_ups, hill_downs);
    let return_pause: i64 = promille_walk_pause_minutes(return_base_walk, promille_x100);
    let return_slowdown: i64 = promille_walk_slowdown_percent(promille_x100);
    let return_walk: i64 = impaired_walking_minutes(return_base_walk, promille_x100);
    now += return_walk;
    promille_x100 = burn_promille_x100(promille_x100, return_walk);
    let home_time: str8 = format_clock(now);
    let promille: str8 = format_promille(promille_x100);
    if row_delay_ms > 0 {
        sleep_ms(row_delay_ms);
    }
    println!("Time to go home buddy! 🥴");
    println!("    - arrive={}", home_time);
    println!("    - walk={}min", return_walk);
    if return_slowdown > 0 {
        println!("    - walk_slowdown_percent={}", return_slowdown);
    }
    if return_pause > 0 {
        println!("    - walk_pause={}min", return_pause);
    }
    println!("    - altitude={}m", start_alt);
    println!("    - promille={}", promille);
    println!("");
}

fn main(argc: i32, args: list<str8>) -> i32 {
    var ap: ArgParser = ArgParser::new("kallio_bars_ga_tsp_demo", "Plan a one-beer-per-bar Kallio crawl with a genetic TSP route.");
    ap.option("json", "j", "Path to kallio_bars.json", "examples/kallio_bars.json");
    ap.option("day", "d", "Opening-hours day key: mon tue wed thu fri sat sun", "fri");
    ap.option("start", "s", "First departure/entry time as HH:MM", "17:30");
    ap.option("start-bar", "", "Start from this bar name instead of lat/lon/altitude", "");
    ap.option("start-lat", "", "Start latitude as decimal degrees; defaults to first loaded bar", "");
    ap.option("start-lon", "", "Start longitude as decimal degrees; defaults to first loaded bar", "");
    ap.option("lat-e4", "", "Compatibility start latitude scaled by 10000", "");
    ap.option("lon-e4", "", "Compatibility start longitude scaled by 10000", "");
    ap.option("altitude-m", "", "Start altitude in meters", "24");
    ap.option("beer-minutes", "b", "Minutes spent drinking one beer in each bar", "50");
    ap.option("alcohol-percent", "a", "Alcohol percent per beer", "5.5");
    ap.option("max-promille", "", "Maximum estimated promille; 0 disables this limit", "3");
    ap.option("use-opening-hours", "", "Use JSON opening/closing times in route scoring; 0 ignores them", "0");
    ap.option("max-route-minutes", "", "Maximum route duration including return to start; 0 disables this cap", "720");
    ap.option("max-bars", "m", "Maximum bars to route; 0 uses all loaded bars", "22");
    ap.option("population", "p", "GA population size", "96");
    ap.option("generations", "g", "GA generation count", "250");
    ap.option("log-interval-ms", "", "Milliseconds between displayed schedule rows; 0 disables row delay", "900");

    let parsed: ParseResult = ap.parse(argc, args);
    if parsed.help_requested() {
        ap.print_help();
        parsed.free();
        ap.free();
        return 0;
    }
    if parsed.has_error() {
        println!("Error: {}", parsed.error());
        ap.print_help();
        parsed.free();
        ap.free();
        return 1;
    }

    let json_path: str8 = parsed.get("json");
    let day: str8 = parsed.get("day");
    let start_text: str8 = parsed.get("start");
    let start_bar: str8 = parsed.get("start-bar");
    let start_minute: i64 = parse_clock_minutes(start_text, 0);
    let start_lat_text: str8 = parsed.get("start-lat");
    let start_lon_text: str8 = parsed.get("start-lon");
    let start_lat_e4_text: str8 = parsed.get("lat-e4");
    let start_lon_e4_text: str8 = parsed.get("lon-e4");
    var start_lat: i64 = 0;
    var start_lon: i64 = 0;
    var start_alt: i64 = parsed.get_i64("altitude-m");
    let beer_minutes: i64 = parsed.get_i64("beer-minutes");
    let alcohol_percent_text: str8 = parsed.get("alcohol-percent");
    let alcohol_percent_x10: i64 = parse_percent_x10(alcohol_percent_text, 55);
    let max_promille_x100: i64 = parsed.get_i64("max-promille") * 100;
    let use_opening_hours: i64 = parsed.get_i64("use-opening-hours");
    let max_route_minutes: i64 = parsed.get_i64("max-route-minutes");
    let max_bars: i64 = parsed.get_i64("max-bars");
    let pop_size: i64 = parsed.get_i64("population");
    let generations: i64 = parsed.get_i64("generations");
    let log_interval_ms: i64 = parsed.get_i64("log-interval-ms");

    let bars: bar_data = load_bars(json_path, day);
    let loaded_count: i64 = bars.names.len();
    var bar_count: i64 = loaded_count;
    if max_bars > 0 && max_bars < bar_count {
        bar_count = max_bars;
    }
    if bar_count <= 0 {
        parsed.free();
        ap.free();
        return 1;
    }
    start_lat = bars.lats[0];
    start_lon = bars.lons[0];
    if len(start_lat_e4_text) > 0 {
        start_lat = parsed.get_i64("lat-e4");
    }
    if len(start_lon_e4_text) > 0 {
        start_lon = parsed.get_i64("lon-e4");
    }
    if len(start_lat_text) > 0 {
        start_lat = parse_scaled_x10000(start_lat_text, start_lat);
    }
    if len(start_lon_text) > 0 {
        start_lon = parse_scaled_x10000(start_lon_text, start_lon);
    }
    var default_first_bar_start: bool = false;
    if len(start_bar) == 0 && len(start_lat_text) == 0 && len(start_lon_text) == 0 && len(start_lat_e4_text) == 0 && len(start_lon_e4_text) == 0 {
        start_alt = bars.alts[0];
        default_first_bar_start = true;
    }
    println!("loaded {} bars and {} hill route entries for {}; planning {}", loaded_count, bars.hill_froms.len(), day, bar_count);

    let start_bar_index: i64 = find_name(bars.names, start_bar);
    var fixed_first_bar: i64 = -1;
    if default_first_bar_start {
        fixed_first_bar = 0;
        if bar_count > 1 {
            bar_count = bar_count - 1;
        }
        println!("starting from first loaded bar '{}' at 0 promille", bars.names[0]);
    } else if len(start_bar) > 0 {
        if start_bar_index < 0 {
            println!("start bar not found: {}", start_bar);
            parsed.free();
            ap.free();
            return 1;
        }
        start_lat = bars.lats[start_bar_index];
        start_lon = bars.lons[start_bar_index];
        start_alt = bars.alts[start_bar_index];
        fixed_first_bar = start_bar_index;
        if bar_count > 1 {
            bar_count = bar_count - 1;
        }
        println!("starting from bar '{}' at 0 promille", start_bar);
    } else {
        println!("starting from coordinates lat_e4={} lon_e4={} altitude={}m at 0 promille", start_lat, start_lon, start_alt);
    }

    seed(20260725);
    var population: list<i64> = random_population_i64(pop_size, bar_count, 0, bar_count - 1);
    population = repair_population(population, pop_size, bar_count);

    var best_penalty: i64 = 999999999;
    var best_route: list<i64> = genome_at_i64(population, bar_count, 0);
    if fixed_first_bar >= 0 {
        let mapped_initial: list<i64> = map_route_excluding(best_route, fixed_first_bar);
        best_route = prepend_bar(fixed_first_bar, mapped_initial);
    }
    var last_log_ms: i64 = now_ms() - log_interval_ms;
    for gen in 0..generations {
        var fitness: list<i64> = [];
        for p in 0..pop_size {
            let raw_route: list<i64> = genome_at_i64(population, bar_count, p);
            if fixed_first_bar >= 0 {
                let mapped_route: list<i64> = map_route_excluding(raw_route, fixed_first_bar);
                let candidate_route: list<i64> = prepend_bar(fixed_first_bar, mapped_route);
                let candidate_penalty: i64 = route_penalty(candidate_route, start_minute, start_lat, start_lon, start_alt, beer_minutes, alcohol_percent_x10, max_promille_x100, max_route_minutes, use_opening_hours, bars.lats, bars.lons, bars.alts, bars.opens, bars.closes, bars.hill_froms, bars.hill_tos, bars.hill_ups, bars.hill_downs);
                fitness.push(10000000 - candidate_penalty);
            } else {
                let candidate_penalty: i64 = route_penalty(raw_route, start_minute, start_lat, start_lon, start_alt, beer_minutes, alcohol_percent_x10, max_promille_x100, max_route_minutes, use_opening_hours, bars.lats, bars.lons, bars.alts, bars.opens, bars.closes, bars.hill_froms, bars.hill_tos, bars.hill_ups, bars.hill_downs);
                fitness.push(10000000 - candidate_penalty);
            }
        }
        let best_index: i64 = argmax_i64(fitness);
        if best_index >= 0 {
            let raw_candidate: list<i64> = genome_at_i64(population, bar_count, best_index);
            if fixed_first_bar >= 0 {
                let mapped_candidate: list<i64> = map_route_excluding(raw_candidate, fixed_first_bar);
                let candidate: list<i64> = prepend_bar(fixed_first_bar, mapped_candidate);
                let penalty: i64 = route_penalty(candidate, start_minute, start_lat, start_lon, start_alt, beer_minutes, alcohol_percent_x10, max_promille_x100, max_route_minutes, use_opening_hours, bars.lats, bars.lons, bars.alts, bars.opens, bars.closes, bars.hill_froms, bars.hill_tos, bars.hill_ups, bars.hill_downs);
                if penalty < best_penalty {
                    best_penalty = penalty;
                    best_route = candidate;
                }
            } else {
                let penalty: i64 = route_penalty(raw_candidate, start_minute, start_lat, start_lon, start_alt, beer_minutes, alcohol_percent_x10, max_promille_x100, max_route_minutes, use_opening_hours, bars.lats, bars.lons, bars.alts, bars.opens, bars.closes, bars.hill_froms, bars.hill_tos, bars.hill_ups, bars.hill_downs);
                if penalty < best_penalty {
                    best_penalty = penalty;
                    best_route = raw_candidate;
                }
            }
        }

        let next: list<i64> = reproduce_next_population_i64(population, pop_size, bar_count, fitness, 100, 0, bar_count - 1, 5);
        population = repair_population(next, pop_size, bar_count);
        if fixed_first_bar < 0 {
            population = replace_genome_i64(population, bar_count, 0, best_route);
        }
        if log_interval_ms > 0 {
            let now_log_ms: i64 = now_ms();
            if gen == 0 || now_log_ms - last_log_ms >= log_interval_ms {
                println!("generation={} best_score={}", gen, 10000000 - best_penalty);
                last_log_ms = now_log_ms;
            }
        }
    }
    if log_interval_ms > 0 {
        println!("generation={} best_score={}", generations, 10000000 - best_penalty);
    }
    let valid_route: list<i64> = trim_route_for_opening_hours(best_route, start_minute, start_lat, start_lon, start_alt, beer_minutes, alcohol_percent_x10, max_route_minutes, use_opening_hours, bars.lats, bars.lons, bars.alts, bars.opens, bars.closes, bars.hill_froms, bars.hill_tos, bars.hill_ups, bars.hill_downs);
    best_route = valid_route;
    best_penalty = route_penalty(best_route, start_minute, start_lat, start_lon, start_alt, beer_minutes, alcohol_percent_x10, max_promille_x100, max_route_minutes, use_opening_hours, bars.lats, bars.lons, bars.alts, bars.opens, bars.closes, bars.hill_froms, bars.hill_tos, bars.hill_ups, bars.hill_downs);

    println!("");
    println!("Kallio one-beer GA crawl");
    if default_first_bar_start {
        println!("start_bar={} at 0 promille", bars.names[0]);
    } else if len(start_bar) > 0 {
        println!("start_bar={} at 0 promille", start_bar);
    } else {
        println!("start_location lat_e4={} lon_e4={} altitude={}m at 0 promille", start_lat, start_lon, start_alt);
    }
    let alcohol_percent_display: str8 = format_percent_x10(alcohol_percent_x10);
    println!("day={} start={} beer_minutes={} alcohol_percent={} bars={} max_promille={} max_route_minutes={} use_opening_hours={}", day, start_text, beer_minutes, alcohol_percent_display, best_route.len(), parsed.get_i64("max-promille"), max_route_minutes, use_opening_hours);
    println!("estimated route cost={} minutes including return", best_penalty);
    print_schedule(best_route, bars.names, bars.lats, bars.lons, bars.alts, bars.opens, bars.closes, start_minute, start_lat, start_lon, start_alt, beer_minutes, alcohol_percent_x10, max_promille_x100, use_opening_hours, bars.hill_froms, bars.hill_tos, bars.hill_ups, bars.hill_downs, log_interval_ms);
    parsed.free();
    ap.free();
    return 0;
}
