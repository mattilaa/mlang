fn main() -> i32 {
    let fixed: array<i32, 6> = {1, 3, 4, 5, 6, 7};
    var scratch: array<i32, 6> = {};
    var filled: array<i32, 4> = {};

    scratch.push(10);
    scratch.push(20);
    scratch.extend(vec![30, 40]);
    scratch.pop();
    filled.fill(7);

    println!("fixed len: {}", fixed.len());
    println!("scratch len: {}", scratch.len());
    println!("filled len: {}", filled.len());
    println!("first fixed value: {}", fixed[0]);
    return 0;
}
