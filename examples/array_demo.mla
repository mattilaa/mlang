fn main() -> i32 {
    let fixed: array<int, 6> = {1, 3, 4, 5, 6, 7};
    var scratch: array<int, 6> = {};

    scratch.push(10);
    scratch.push(20);
    scratch.pop();

    println!("fixed len: {}", fixed.len());
    println!("scratch len: {}", scratch.len());
    println!("first fixed value: {}", fixed[0]);
    return 0;
}
