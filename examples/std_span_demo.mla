/// \file std_span_demo.mla
/// @ingroup examples
/// \brief Borrowed slice/span example using std::span.
///
mod std::span;
mod std::vec;

fn weighted_sum(values: Span<i32>) -> i32 {
    var total: i32 = 0;
    for i in 0..values.len() {
        total = total + (values[i] * i32(i + 1));
    }
    return total;
}

fn main() -> i32 {
    let readings: list<i32> = [4, 8, 15, 16, 23, 42];
    let view: Span<i32> = readings;
    static_assert!(sizeof(view) == sizeof(list<i32>));
    println!("sizeof(Span<i32>)={}", sizeof(view));
    println!("len={} first={} last={}", view.len(), view[0], view[view.len() - 1]);
    println!("weighted_sum={}", weighted_sum(view));

    let fill_view: span<i32> = [3; 5];
    static_assert!(sizeof(fill_view) == sizeof(list<i32>));
    println!("fill_len={} fill_mid={}", fill_view.len(), fill_view[2]);

    let vec_view: Span<i32> = vec![9, 8, 7];
    println!("vec_sum={}", weighted_sum(vec_view));
    return 0;
}
