/// Native MFS2 directory-listing command.

asm x86(".section .command_entry,\"ax\",@progbits
.globl command_start
command_start:
    jmp run_ls__str8
");

extern fn serial_write(message: str8) -> void;
extern fn serial_write_char(ch: i32) -> void;
extern fn terminal_command_eq(actual: str8, expected: str8) -> i32;
extern fn terminal_command_prefix(actual: str8, prefix: str8) -> i32;
extern fn terminal_argument(command: str8, offset: i32) -> str8;
extern fn fs_entry_count() -> i32;
extern fn fs_entry_path(index: i32) -> str8;
extern fn fs_entry_type(index: i32) -> i32;
extern fn fs_entry_owner(index: i32) -> i32;
extern fn fs_entry_mode(index: i32) -> i32;
extern fn fs_entry_size(index: i32) -> i32;
extern fn fs_entry_timestamp(index: i32) -> i32;
extern fn fs_can_access(index: i32, mask: i32) -> i32;
extern fn fs_pwd() -> str8;
extern fn fs_resolve(path: str8) -> str8;
extern fn fs_find(path: str8) -> i32;
extern fn fs_basename(path: str8) -> str8;
extern fn fs_is_direct_child(directory: str8, candidate: str8) -> i32;

fn ls_user_name(uid: i32) -> str8 {
    if uid == 1 {
        return "user";
    }
    return "root";
}

fn ls_group_name(uid: i32) -> str8 {
    if uid == 1 {
        return "users";
    }
    return "root";
}

fn ls_decimal_digits(value: i32) -> i32 {
    var digits: i32 = 1;
    var remaining: i32 = value;
    while remaining >= 10 {
        remaining = remaining / 10;
        digits = digits + 1;
    }
    return digits;
}

fn ls_write_spaces(count: i32) -> void {
    var remaining: i32 = count;
    while remaining > 0 {
        serial_write_char(32);
        remaining = remaining - 1;
    }
}

fn ls_write_unsigned(value: i32) -> void {
    var divisor: i32 = 1;
    while divisor <= value / 10 {
        divisor = divisor * 10;
    }
    while divisor > 0 {
        serial_write_char(48 + (value / divisor) % 10);
        divisor = divisor / 10;
    }
}

fn ls_size_scale(unit: i32) -> i32 {
    if unit == 3 {
        return 1073741824;
    }
    if unit == 2 {
        return 1048576;
    }
    if unit == 1 {
        return 1024;
    }
    return 1;
}

fn ls_size_unit(value: i32) -> i32 {
    if value >= 1073741824 {
        return 3;
    }
    if value >= 1048576 {
        return 2;
    }
    if value >= 1024 {
        return 1;
    }
    return 0;
}

fn ls_unit_character(unit: i32) -> i32 {
    if unit == 3 {
        return 71;
    }
    if unit == 2 {
        return 77;
    }
    if unit == 1 {
        return 75;
    }
    return 66;
}

fn ls_human_size_width(value: i32) -> i32 {
    let unit: i32 = ls_size_unit(value);
    if unit == 0 {
        return ls_decimal_digits(value) + 1;
    }
    let scale: i32 = ls_size_scale(unit);
    let whole: i32 = value / scale;
    if whole < 10 {
        return 4;
    }
    var rounded: i32 = whole;
    if value % scale >= scale / 2 {
        rounded = rounded + 1;
    }
    return ls_decimal_digits(rounded) + 1;
}

fn ls_write_human_size(value: i32) -> void {
    let width: i32 = ls_human_size_width(value);
    ls_write_spaces(6 - width);
    let unit: i32 = ls_size_unit(value);
    if unit == 0 {
        ls_write_unsigned(value);
    } else {
        let scale: i32 = ls_size_scale(unit);
        let whole: i32 = value / scale;
        if whole < 10 {
            ls_write_unsigned(whole);
            serial_write_char(46);
            var decimal: i32 = (value % scale) / (scale / 10);
            if decimal > 9 {
                decimal = 9;
            }
            ls_write_unsigned(decimal);
        } else {
            var rounded: i32 = whole;
            if value % scale >= scale / 2 {
                rounded = rounded + 1;
            }
            ls_write_unsigned(rounded);
        }
    }
    serial_write_char(ls_unit_character(unit));
}

fn ls_month_name(month: i32) -> str8 {
    if month == 1 { return "Jan"; }
    if month == 2 { return "Feb"; }
    if month == 3 { return "Mar"; }
    if month == 4 { return "Apr"; }
    if month == 5 { return "May"; }
    if month == 6 { return "Jun"; }
    if month == 7 { return "Jul"; }
    if month == 8 { return "Aug"; }
    if month == 9 { return "Sep"; }
    if month == 10 { return "Oct"; }
    if month == 11 { return "Nov"; }
    if month == 12 { return "Dec"; }
    return "---";
}

fn ls_write_two_digits(value: i32) -> void {
    serial_write_char(48 + (value / 10) % 10);
    serial_write_char(48 + value % 10);
}

fn ls_write_timestamp(value: i32) -> void {
    if value == 0 {
        serial_write("--- -- --:--");
        return;
    }
    let month: i32 = (value >> 16) & 15;
    let day: i32 = (value >> 11) & 31;
    let hour: i32 = (value >> 6) & 31;
    let minute: i32 = value & 63;
    serial_write(ls_month_name(month));
    serial_write_char(32);
    if day < 10 {
        serial_write_char(32);
    }
    ls_write_unsigned(day);
    serial_write_char(32);
    ls_write_two_digits(hour);
    serial_write_char(58);
    ls_write_two_digits(minute);
}

fn write_mode_bit(mode: i32, mask: i32, shown: i32) -> void {
    if (mode & mask) != 0 {
        serial_write_char(shown);
    } else {
        serial_write_char(45);
    }
}

fn write_entry(index: i32) -> void {
    if fs_entry_type(index) == 2 {
        serial_write_char(100);
    } else {
        serial_write_char(45);
    }
    let mode: i32 = fs_entry_mode(index);
    write_mode_bit(mode, 256, 114);
    write_mode_bit(mode, 128, 119);
    write_mode_bit(mode, 64, 120);
    write_mode_bit(mode, 32, 114);
    write_mode_bit(mode, 16, 119);
    write_mode_bit(mode, 8, 120);
    write_mode_bit(mode, 4, 114);
    write_mode_bit(mode, 2, 119);
    write_mode_bit(mode, 1, 120);
    let owner: i32 = fs_entry_owner(index);
    serial_write("  1 ");
    serial_write(ls_user_name(owner));
    serial_write("  ");
    serial_write(ls_group_name(owner));
    if owner == 1 {
        serial_write_char(32);
    } else {
        serial_write("  ");
    }
    ls_write_human_size(fs_entry_size(index));
    serial_write_char(32);
    ls_write_timestamp(fs_entry_timestamp(index));
    serial_write_char(32);
    serial_write(fs_basename(fs_entry_path(index)));
    if fs_entry_type(index) == 2 {
        serial_write("/");
    }
    serial_write("\r\n");
}

fn list_directory(request: str8) -> i32 {
    let directory: str8 = fs_resolve(request);
    let directory_index: i32 = fs_find(directory);
    if directory_index < 0 {
        return -1;
    }
    if fs_entry_type(directory_index) != 2 {
        return -2;
    }
    if fs_can_access(directory_index, 5) != 1 {
        return -3;
    }

    var index: i32 = 0;
    let count: i32 = fs_entry_count();
    while index < count {
        let path: str8 = fs_entry_path(index);
        if fs_is_direct_child(directory, path) == 1 {
            write_entry(index);
        }
        index = index + 1;
    }
    return 0;
}

pub fn run_ls(arguments: str8) -> i32 {
    if terminal_command_eq(arguments, "--help") == 1 || terminal_command_eq(arguments, "-h") == 1 {
        serial_write("usage: ls [-l] [path]\r\n");
        serial_write("list directory contents in long, human-readable form\r\n");
        return 0;
    }
    var request: str8 = arguments;
    if terminal_command_eq(arguments, "") == 1 || terminal_command_eq(arguments, "-l") == 1 {
        request = ".";
    } else if terminal_command_prefix(arguments, "-l ") == 1 {
        request = terminal_argument(arguments, 3);
    }

    let result: i32 = list_directory(request);
    if result == -1 {
        serial_write("ls: directory not found\r\n");
    } else if result == -2 {
        serial_write("ls: not a directory\r\n");
    } else if result == -3 {
        serial_write("ls: permission denied\r\n");
    }
    return result;
}
