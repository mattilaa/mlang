/// Create a user in the small QEMU demo account database.

asm x86(".section .command_entry,\"ax\",@progbits
.globl command_start
command_start:
    jmp run_adduser__str8
");

extern fn serial_write(message: str8) -> void;
extern fn terminal_command_eq(actual: str8, expected: str8) -> i32;
extern fn fs_find(path: str8) -> i32;
extern fn fs_entry_type(index: i32) -> i32;
extern fn fs_can_access(index: i32, mask: i32) -> i32;
extern fn fs_join_path(directory: str8, name: str8) -> str8;
extern fn fs_create_directory(path: str8) -> i32;
extern fn fs_chown(index: i32, uid: i32) -> i32;
extern fn fs_flush() -> i32;
extern fn user_add(name: str8) -> i32;

pub fn run_adduser(arguments: str8) -> i32 {
    if terminal_command_eq(arguments, "") == 1 || terminal_command_eq(arguments, "-h") == 1 || terminal_command_eq(arguments, "--help") == 1 {
        serial_write("usage: adduser <name>\r\n");
        serial_write("create a user and /home/<name> as root\r\n");
        return 0;
    }
    let home_parent: i32 = fs_find("/home");
    if home_parent < 0 || fs_entry_type(home_parent) != 2 || fs_can_access(home_parent, 3) != 1 {
        serial_write("adduser: /home is not writable\r\n");
        return 1;
    }
    let uid: i32 = user_add(arguments);
    if uid == -4 {
        serial_write("adduser: permission denied\r\n");
        return 1;
    }
    if uid == -2 {
        serial_write("adduser: user already exists\r\n");
        return 1;
    }
    if uid < 0 {
        serial_write("adduser: user database is full\r\n");
        return 1;
    }
    let home: str8 = fs_join_path("/home", arguments);
    if fs_create_directory(home) != 1 {
        serial_write("adduser: user created but home directory failed\r\n");
        return 1;
    }
    let home_index: i32 = fs_find(home);
    if home_index >= 0 {
        fs_chown(home_index, uid);
    }
    if fs_flush() != 1 {
        serial_write("adduser: user created but disk flush failed\r\n");
        return 1;
    }
    serial_write("user created\r\n");
    return 0;
}
