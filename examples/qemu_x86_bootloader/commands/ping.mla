/// Native IPv4 ICMP echo command for the QEMU NE2000 user network.

asm x86(".section .command_entry,\"ax\",@progbits
.globl command_start
command_start:
    jmp run_ping__str8

.globl ping_tx_buffer_ptr
ping_tx_buffer_ptr:
    movl $ping_tx_buffer, %eax
    ret

.globl ping_rx_buffer_ptr
ping_rx_buffer_ptr:
    movl $ping_rx_buffer, %eax
    ret

.globl ping_peer_mac_ptr
ping_peer_mac_ptr:
    movl $ping_peer_mac, %eax
    ret

.globl ping_byte_at
ping_byte_at:
    movl 4(%esp), %edx
    movl 8(%esp), %ecx
    movzbl (%edx,%ecx), %eax
    ret

.globl ping_set_byte
ping_set_byte:
    movl 4(%esp), %edx
    movl 8(%esp), %ecx
    movb 12(%esp), %al
    movb %al, (%edx,%ecx)
    ret

.section .bss,\"aw\",@nobits
.balign 4
ping_tx_buffer:
    .skip 1600
ping_rx_buffer:
    .skip 1600
ping_peer_mac:
    .skip 6
");

extern fn serial_write(message: str8) -> void;
extern fn serial_write_char(ch: i32) -> void;
extern fn terminal_command_eq(actual: str8, expected: str8) -> i32;
extern fn terminal_command_prefix(actual: str8, prefix: str8) -> i32;
extern fn terminal_split_argument(argument: str8) -> str8;
extern fn terminal_wait_ms(milliseconds: i32) -> void;
extern fn network_init() -> i32;
extern fn network_mac_byte(index: i32) -> i32;
extern fn network_send(frame: str8, length: i32) -> i32;
extern fn network_receive(frame: str8, capacity: i32) -> i32;
extern fn ping_tx_buffer_ptr() -> str8;
extern fn ping_rx_buffer_ptr() -> str8;
extern fn ping_peer_mac_ptr() -> str8;
extern fn ping_byte_at(data: str8, index: i32) -> i32;
extern fn ping_set_byte(data: str8, index: i32, value: i32) -> void;

fn ping_write_unsigned(value: i32) -> void {
    var divisor: i32 = 1;
    while divisor <= value / 10 {
        divisor = divisor * 10;
    }
    while divisor > 0 {
        serial_write_char(48 + (value / divisor) % 10);
        divisor = divisor / 10;
    }
}

fn ping_write_ipv4(address: i32) -> void {
    var index: i32 = 0;
    while index < 4 {
        if index > 0 {
            serial_write_char(46);
        }
        ping_write_unsigned((address >> ((3 - index) * 8)) & 255);
        index = index + 1;
    }
}

fn ping_parse_ipv4(text: str8) -> i32 {
    var address: i32 = 0;
    var part: i32 = 0;
    var parts: i32 = 0;
    var digits: i32 = 0;
    var index: i32 = 0;
    while true {
        let ch: i32 = ping_byte_at(text, index);
        if ch >= 48 && ch <= 57 {
            part = part * 10 + ch - 48;
            if part > 255 {
                return 0;
            }
            digits = digits + 1;
        } else if ch == 46 || ch == 0 {
            if digits == 0 || parts >= 4 {
                return 0;
            }
            address = (address << 8) | part;
            parts = parts + 1;
            if ch == 0 {
                if parts == 4 {
                    return address;
                }
                return 0;
            }
            part = 0;
            digits = 0;
        } else {
            return 0;
        }
        index = index + 1;
    }
    return 0;
}

fn ping_parse_interval(text: str8) -> i32 {
    if terminal_command_eq(text, "") == 1 {
        return -1;
    }
    var value: i32 = 0;
    var index: i32 = 0;
    while true {
        let ch: i32 = ping_byte_at(text, index);
        if ch == 0 {
            return value;
        }
        if ch < 48 || ch > 57 {
            return -1;
        }
        value = value * 10 + ch - 48;
        if value > 60 {
            return -1;
        }
        index = index + 1;
    }
    return -1;
}

fn ping_ip_byte(address: i32, index: i32) -> i32 {
    return (address >> ((3 - index) * 8)) & 255;
}

fn ping_set_u16(data: str8, offset: i32, value: i32) -> void {
    ping_set_byte(data, offset, (value >> 8) & 255);
    ping_set_byte(data, offset + 1, value & 255);
}

fn ping_get_u16(data: str8, offset: i32) -> i32 {
    return (ping_byte_at(data, offset) << 8) | ping_byte_at(data, offset + 1);
}

fn ping_checksum(data: str8, offset: i32, length: i32) -> i32 {
    var sum: i32 = 0;
    var index: i32 = 0;
    while index < length {
        var word: i32 = ping_byte_at(data, offset + index) << 8;
        if index + 1 < length {
            word = word | ping_byte_at(data, offset + index + 1);
        }
        sum = sum + word;
        index = index + 2;
    }
    while (sum >> 16) != 0 {
        sum = (sum & 65535) + (sum >> 16);
    }
    return 65535 - sum;
}

fn ping_udp_checksum(data: str8, offset: i32, length: i32, source: i32, destination: i32) -> i32 {
    var sum: i32 = ((source >> 16) & 65535) + (source & 65535);
    sum = sum + ((destination >> 16) & 65535) + (destination & 65535);
    sum = sum + 17 + length;
    var index: i32 = 0;
    while index < length {
        var word: i32 = ping_byte_at(data, offset + index) << 8;
        if index + 1 < length {
            word = word | ping_byte_at(data, offset + index + 1);
        }
        sum = sum + word;
        index = index + 2;
    }
    while (sum >> 16) != 0 {
        sum = (sum & 65535) + (sum >> 16);
    }
    let result: i32 = 65535 - sum;
    if result == 0 {
        return 65535;
    }
    return result;
}

fn ping_clear(data: str8, length: i32) -> void {
    var index: i32 = 0;
    while index < length {
        ping_set_byte(data, index, 0);
        index = index + 1;
    }
}

fn ping_set_local_mac(data: str8, offset: i32) -> void {
    var index: i32 = 0;
    while index < 6 {
        ping_set_byte(data, offset + index, network_mac_byte(index));
        index = index + 1;
    }
}

fn ping_set_ip(data: str8, offset: i32, address: i32) -> void {
    var index: i32 = 0;
    while index < 4 {
        ping_set_byte(data, offset + index, ping_ip_byte(address, index));
        index = index + 1;
    }
}

fn ping_ip_matches(data: str8, offset: i32, address: i32) -> i32 {
    var index: i32 = 0;
    while index < 4 {
        if ping_byte_at(data, offset + index) != ping_ip_byte(address, index) {
            return 0;
        }
        index = index + 1;
    }
    return 1;
}

fn ping_arp_reply(data: str8, length: i32, target: i32) -> i32 {
    if length < 42 {
        return 0;
    }
    if ping_byte_at(data, 12) != 8 || ping_byte_at(data, 13) != 6 {
        return 0;
    }
    if ping_byte_at(data, 20) != 0 || ping_byte_at(data, 21) != 2 {
        return 0;
    }
    if ping_ip_matches(data, 28, target) != 1 || ping_ip_matches(data, 38, 0x0a00020f) != 1 {
        return 0;
    }
    let peer: str8 = ping_peer_mac_ptr();
    var index: i32 = 0;
    while index < 6 {
        ping_set_byte(peer, index, ping_byte_at(data, 22 + index));
        index = index + 1;
    }
    return 1;
}

fn ping_resolve(target: i32) -> i32 {
    let frame: str8 = ping_tx_buffer_ptr();
    ping_clear(frame, 64);
    var index: i32 = 0;
    while index < 6 {
        ping_set_byte(frame, index, 255);
        index = index + 1;
    }
    ping_set_local_mac(frame, 6);
    ping_set_u16(frame, 12, 0x0806);
    ping_set_u16(frame, 14, 1);
    ping_set_u16(frame, 16, 0x0800);
    ping_set_byte(frame, 18, 6);
    ping_set_byte(frame, 19, 4);
    ping_set_u16(frame, 20, 1);
    ping_set_local_mac(frame, 22);
    ping_set_ip(frame, 28, 0x0a00020f);
    ping_set_ip(frame, 38, target);
    if network_send(frame, 42) != 1 {
        return 0;
    }
    let reply: str8 = ping_rx_buffer_ptr();
    var attempt: i32 = 0;
    while attempt < 4 {
        let length: i32 = network_receive(reply, 1600);
        if ping_arp_reply(reply, length, target) == 1 {
            return 1;
        }
        attempt = attempt + 1;
    }
    return 0;
}

fn ping_dns_character(ch: i32) -> i32 {
    if ch >= 48 && ch <= 57 {
        return 1;
    }
    if ch >= 65 && ch <= 90 {
        return 1;
    }
    if ch >= 97 && ch <= 122 {
        return 1;
    }
    if ch == 45 {
        return 1;
    }
    return 0;
}

fn ping_build_dns_query(host: str8, server: i32) -> i32 {
    let frame: str8 = ping_tx_buffer_ptr();
    let peer: str8 = ping_peer_mac_ptr();
    ping_clear(frame, 256);
    var index: i32 = 0;
    while index < 6 {
        ping_set_byte(frame, index, ping_byte_at(peer, index));
        index = index + 1;
    }
    ping_set_local_mac(frame, 6);
    ping_set_u16(frame, 12, 0x0800);
    ping_set_byte(frame, 14, 0x45);
    ping_set_u16(frame, 18, 0x4d44);
    ping_set_byte(frame, 22, 64);
    ping_set_byte(frame, 23, 17);
    ping_set_ip(frame, 26, 0x0a00020f);
    ping_set_ip(frame, 30, server);
    ping_set_u16(frame, 34, 0xc001);
    ping_set_u16(frame, 36, 53);
    ping_set_u16(frame, 40, 0);
    ping_set_u16(frame, 42, 0x4d4c);
    ping_set_u16(frame, 44, 0x0100);
    ping_set_u16(frame, 46, 1);
    ping_set_u16(frame, 48, 0);
    ping_set_u16(frame, 50, 0);
    ping_set_u16(frame, 52, 0);

    var input: i32 = 0;
    var output: i32 = 55;
    var label_offset: i32 = 54;
    var label_length: i32 = 0;
    while true {
        let ch: i32 = ping_byte_at(host, input);
        if ch == 46 || ch == 0 {
            if label_length == 0 || label_length > 63 {
                return 0;
            }
            ping_set_byte(frame, label_offset, label_length);
            if ch == 0 {
                break;
            }
            label_offset = output;
            output = output + 1;
            label_length = 0;
        } else {
            if ping_dns_character(ch) != 1 || output >= 250 {
                return 0;
            }
            ping_set_byte(frame, output, ch);
            output = output + 1;
            label_length = label_length + 1;
        }
        input = input + 1;
    }
    ping_set_byte(frame, output, 0);
    output = output + 1;
    ping_set_u16(frame, output, 1);
    ping_set_u16(frame, output + 2, 1);
    output = output + 4;
    let dns_length: i32 = output - 42;
    let udp_length: i32 = dns_length + 8;
    let ip_length: i32 = udp_length + 20;
    ping_set_u16(frame, 38, udp_length);
    ping_set_u16(frame, 40, ping_udp_checksum(frame, 34, udp_length, 0x0a00020f, server));
    ping_set_u16(frame, 16, ip_length);
    ping_set_u16(frame, 24, ping_checksum(frame, 14, 20));
    return output;
}

fn ping_dns_skip_name(data: str8, offset: i32, end: i32) -> i32 {
    var cursor: i32 = offset;
    while cursor < end {
        let length: i32 = ping_byte_at(data, cursor);
        if length == 0 {
            return cursor + 1;
        }
        if (length & 0xc0) == 0xc0 {
            if cursor + 1 < end {
                return cursor + 2;
            }
            return 0;
        }
        if length > 63 || cursor + length + 1 > end {
            return 0;
        }
        cursor = cursor + length + 1;
    }
    return 0;
}

fn ping_dns_answer(data: str8, length: i32, server: i32) -> i32 {
    if length < 58 {
        return 0;
    }
    if ping_byte_at(data, 12) != 8 || ping_byte_at(data, 13) != 0 {
        return 0;
    }
    if ping_byte_at(data, 23) != 17 || ping_ip_matches(data, 26, server) != 1 {
        return 0;
    }
    if ping_get_u16(data, 34) != 53 || ping_get_u16(data, 42) != 0x4d4c {
        return 0;
    }
    if (ping_get_u16(data, 44) & 0x800f) != 0x8000 {
        return 0;
    }
    let udp_length: i32 = ping_get_u16(data, 38);
    let end: i32 = 34 + udp_length;
    if udp_length < 20 || end > length {
        return 0;
    }
    let questions: i32 = ping_get_u16(data, 46);
    let answers: i32 = ping_get_u16(data, 48);
    var cursor: i32 = 54;
    var item: i32 = 0;
    while item < questions {
        cursor = ping_dns_skip_name(data, cursor, end);
        if cursor == 0 || cursor + 4 > end {
            return 0;
        }
        cursor = cursor + 4;
        item = item + 1;
    }
    item = 0;
    while item < answers {
        cursor = ping_dns_skip_name(data, cursor, end);
        if cursor == 0 || cursor + 10 > end {
            return 0;
        }
        let record_type: i32 = ping_get_u16(data, cursor);
        let record_class: i32 = ping_get_u16(data, cursor + 2);
        let data_length: i32 = ping_get_u16(data, cursor + 8);
        cursor = cursor + 10;
        if cursor + data_length > end {
            return 0;
        }
        if record_type == 1 && record_class == 1 && data_length == 4 {
            return (ping_byte_at(data, cursor) << 24) |
                (ping_byte_at(data, cursor + 1) << 16) |
                (ping_byte_at(data, cursor + 2) << 8) |
                ping_byte_at(data, cursor + 3);
        }
        cursor = cursor + data_length;
        item = item + 1;
    }
    return 0;
}

fn ping_dns_lookup_at(host: str8, server: i32) -> i32 {
    var next_hop: i32 = 0x0a000202;
    if (server & 0xffffff00) == 0x0a000200 {
        next_hop = server;
    }
    if ping_resolve(next_hop) != 1 {
        return 0;
    }
    let frame: str8 = ping_tx_buffer_ptr();
    let length: i32 = ping_build_dns_query(host, server);
    if length == 0 || network_send(frame, length) != 1 {
        return 0;
    }
    let reply: str8 = ping_rx_buffer_ptr();
    var attempt: i32 = 0;
    while attempt < 1 {
        let reply_length: i32 = network_receive(reply, 1600);
        let address: i32 = ping_dns_answer(reply, reply_length, server);
        if address != 0 {
            return address;
        }
        attempt = attempt + 1;
    }
    return 0;
}

fn ping_dns_lookup(host: str8) -> i32 {
    var address: i32 = ping_dns_lookup_at(host, 0x0a000203);
    if address == 0 {
        address = ping_dns_lookup_at(host, 0x08080808);
    }
    return address;
}

fn ping_build_echo(target: i32, sequence: i32) -> i32 {
    let frame: str8 = ping_tx_buffer_ptr();
    let peer: str8 = ping_peer_mac_ptr();
    ping_clear(frame, 64);
    var index: i32 = 0;
    while index < 6 {
        ping_set_byte(frame, index, ping_byte_at(peer, index));
        index = index + 1;
    }
    ping_set_local_mac(frame, 6);
    ping_set_u16(frame, 12, 0x0800);
    ping_set_byte(frame, 14, 0x45);
    ping_set_u16(frame, 16, 36);
    ping_set_u16(frame, 18, 0x4d4c);
    ping_set_u16(frame, 20, 0);
    ping_set_byte(frame, 22, 64);
    ping_set_byte(frame, 23, 1);
    ping_set_ip(frame, 26, 0x0a00020f);
    ping_set_ip(frame, 30, target);
    ping_set_u16(frame, 24, ping_checksum(frame, 14, 20));
    ping_set_byte(frame, 34, 8);
    ping_set_byte(frame, 35, 0);
    ping_set_u16(frame, 38, 0x4d4c);
    ping_set_u16(frame, 40, sequence);
    index = 0;
    while index < 8 {
        ping_set_byte(frame, 42 + index, 65 + index);
        index = index + 1;
    }
    ping_set_u16(frame, 36, ping_checksum(frame, 34, 16));
    return 50;
}

fn ping_echo_reply(data: str8, length: i32, target: i32, sequence: i32) -> i32 {
    if length < 50 {
        return 0;
    }
    if ping_byte_at(data, 12) != 8 || ping_byte_at(data, 13) != 0 {
        return 0;
    }
    if ping_byte_at(data, 23) != 1 || ping_ip_matches(data, 26, target) != 1 {
        return 0;
    }
    if ping_byte_at(data, 34) != 0 || ping_byte_at(data, 35) != 0 {
        return 0;
    }
    if ping_byte_at(data, 38) != 0x4d || ping_byte_at(data, 39) != 0x4c {
        return 0;
    }
    if ping_byte_at(data, 40) != ((sequence >> 8) & 255) || ping_byte_at(data, 41) != (sequence & 255) {
        return 0;
    }
    return ping_byte_at(data, 22) + 1;
}

fn ping_once(target: i32, sequence: i32) -> i32 {
    let frame: str8 = ping_tx_buffer_ptr();
    if network_send(frame, ping_build_echo(target, sequence)) != 1 {
        return 0;
    }
    let reply: str8 = ping_rx_buffer_ptr();
    var attempt: i32 = 0;
    while attempt < 4 {
        let length: i32 = network_receive(reply, 1600);
        let result: i32 = ping_echo_reply(reply, length, target, sequence);
        if result > 0 {
            return result;
        }
        attempt = attempt + 1;
    }
    return 0;
}

pub fn run_ping(arguments: str8) -> i32 {
    if terminal_command_eq(arguments, "--help") == 1 || terminal_command_eq(arguments, "-h") == 1 {
        serial_write("usage: ping [-i seconds] <host-or-IPv4-address>\r\n");
        serial_write("resolve a host and send four ICMP echo requests\r\n");
        serial_write("  -i, --interval  seconds between requests (default: 1)\r\n");
        return 0;
    }
    if terminal_command_eq(arguments, "") == 1 {
        serial_write("usage: ping [-i seconds] <host-or-IPv4-address>\r\n");
        return -1;
    }
    var host: str8 = arguments;
    var interval: i32 = 1;
    if terminal_command_prefix(arguments, "-i ") == 1 || terminal_command_prefix(arguments, "--interval ") == 1 {
        let interval_text: str8 = terminal_split_argument(arguments);
        host = terminal_split_argument(interval_text);
        interval = ping_parse_interval(interval_text);
        if interval < 0 || terminal_command_eq(host, "") == 1 {
            serial_write("ping: interval must be an integer from 0 to 60 seconds\r\n");
            return -1;
        }
    } else if terminal_command_eq(arguments, "-i") == 1 || terminal_command_eq(arguments, "--interval") == 1 {
        serial_write("ping: interval requires seconds and a host\r\n");
        return -1;
    }
    if network_init() != 1 {
        serial_write("ping: NE2000 network device not found\r\n");
        return -3;
    }
    var target: i32 = ping_parse_ipv4(host);
    var resolved_name: i32 = 0;
    if target == 0 {
        target = ping_dns_lookup(host);
        if target == 0 {
            serial_write("ping: cannot resolve host\r\n");
            return -2;
        }
        resolved_name = 1;
    }
    var next_hop: i32 = 0x0a000202;
    if (target & 0xffffff00) == 0x0a000200 {
        next_hop = target;
    }
    serial_write("PING ");
    serial_write(host);
    if resolved_name == 1 {
        serial_write(" (");
        ping_write_ipv4(target);
        serial_write(")");
    }
    serial_write(" (8 data bytes)\r\n");
    if ping_resolve(next_hop) != 1 {
        serial_write("ping: ARP resolution timed out\r\n");
        return -4;
    }
    var sequence: i32 = 1;
    var received: i32 = 0;
    while sequence <= 4 {
        let result: i32 = ping_once(target, sequence);
        if result > 0 {
            serial_write("reply from ");
            ping_write_ipv4(target);
            serial_write(": icmp_seq=");
            ping_write_unsigned(sequence);
            serial_write(" ttl=");
            ping_write_unsigned(result - 1);
            serial_write("\r\n");
            received = received + 1;
        } else {
            serial_write("request timeout for icmp_seq=");
            ping_write_unsigned(sequence);
            serial_write("\r\n");
        }
        if sequence < 4 && interval > 0 {
            terminal_wait_ms(interval * 1000);
        }
        sequence = sequence + 1;
    }
    serial_write("4 packets transmitted, ");
    ping_write_unsigned(received);
    serial_write(" received\r\n");
    if received == 0 {
        return -5;
    }
    return 0;
}
