/// Native MFS2 text line, word, and byte count command.

asm x86(".section .command_entry,\"ax\",@progbits
.globl command_start
command_start:
    jmp run_wc__str8

.globl wc_byte_at
wc_byte_at:
    movl 4(%esp), %edx
    movl 8(%esp), %ecx
    movzbl (%edx,%ecx), %eax
    ret
");

extern fn serial_write(message: str8) -> void;
extern fn serial_write_char(ch: i32) -> void;
extern fn terminal_command_eq(actual: str8, expected: str8) -> i32;
extern fn fs_entry_type(index: i32) -> i32;
extern fn fs_entry_size(index: i32) -> i32;
extern fn fs_entry_data(index: i32) -> str8;
extern fn fs_can_access(index: i32, mask: i32) -> i32;
extern fn fs_resolve(path: str8) -> str8;
extern fn fs_find(path: str8) -> i32;
extern fn wc_byte_at(data: str8, index: i32) -> i32;

fn wc_write_unsigned(value: i32) -> void {
    var divisor: i32 = 1;
    while divisor <= value / 10 {
        divisor = divisor * 10;
    }
    while divisor > 0 {
        serial_write_char(48 + (value / divisor) % 10);
        divisor = divisor / 10;
    }
}

fn wc_is_space(ch: i32) -> i32 {
    if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
        return 1;
    }
    return 0;
}

pub fn run_wc(arguments: str8) -> i32 {
    if terminal_command_eq(arguments, "--help") == 1 || terminal_command_eq(arguments, "-h") == 1 {
        serial_write("usage: wc <file>\r\n");
        serial_write("print line, word, and byte counts\r\n");
        return 0;
    }
    if terminal_command_eq(arguments, "") == 1 {
        serial_write("usage: wc <file>\r\n");
        return -1;
    }
    let index: i32 = fs_find(fs_resolve(arguments));
    if index < 0 {
        serial_write("wc: file not found\r\n");
        return -2;
    }
    if fs_entry_type(index) != 1 {
        serial_write("wc: is not a regular file\r\n");
        return -3;
    }
    if fs_can_access(index, 4) != 1 {
        serial_write("wc: permission denied\r\n");
        return -4;
    }

    let data: str8 = fs_entry_data(index);
    let bytes: i32 = fs_entry_size(index);
    var lines: i32 = 0;
    var words: i32 = 0;
    var in_word: i32 = 0;
    var offset: i32 = 0;
    while offset < bytes {
        let ch: i32 = wc_byte_at(data, offset);
        if ch == 10 {
            lines = lines + 1;
        }
        if wc_is_space(ch) == 1 {
            in_word = 0;
        } else if in_word == 0 {
            words = words + 1;
            in_word = 1;
        }
        offset = offset + 1;
    }
    wc_write_unsigned(lines);
    serial_write_char(32);
    wc_write_unsigned(words);
    serial_write_char(32);
    wc_write_unsigned(bytes);
    serial_write_char(32);
    serial_write(arguments);
    serial_write("\r\n");
    return 0;
}
