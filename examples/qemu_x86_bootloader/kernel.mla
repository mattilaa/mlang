    pushl %edi
    pushl %ebp
    movl $MFS_BASE, %edi
    movl $36, %eax
    call .Lata_read_sector
    testl %eax, %eax
    jz .Lata_load_failed
    cmpl $0x3253464d, MFS_BASE
    jne .Lata_load_failed
    movl MFS_BASE + 8, %eax
    cmpl MFS_BASE + 12, %eax
    ja .Lata_load_failed
    addl $511, %eax
    jc .Lata_load_failed
    shrl $9, %eax
    testl %eax, %eax
    jz .Lata_load_failed
    movl %eax, %ebx
    decl %ebx
    movl $37, %ebp
.Lata_load_loop:
    testl %ebx, %ebx
    jz .Lata_load_ok
    movl %ebp, %eax
    call .Lata_read_sector
    testl %eax, %eax
    jz .Lata_load_failed
    incl %ebp
    decl %ebx
    jmp .Lata_load_loop
.Lata_load_ok:
    movl $1, %eax
    jmp .Lata_load_done
.Lata_load_failed:
    xorl %eax, %eax
.Lata_load_done:
    popl %ebp
    popl %edi
    popl %ebx
    ret

.globl fs_flush
fs_flush:
    pushl %ebx
    pushl %esi
    pushl %ebp
    movl MFS_BASE + 8, %eax
    cmpl MFS_BASE + 12, %eax
    ja .Lata_flush_failed
    addl $511, %eax
    jc .Lata_flush_failed
    shrl $9, %eax
    movl %eax, %ebx
    movl $MFS_BASE, %esi
    movl $36, %ebp
.Lata_flush_loop:
    testl %ebx, %ebx
    jz .Lata_flush_cache
    movl %ebp, %eax
    call .Lata_write_sector
    testl %eax, %eax
    jz .Lata_flush_failed
    incl %ebp
    decl %ebx
    jmp .Lata_flush_loop
.Lata_flush_cache:
    call .Lata_wait_idle
    testl %eax, %eax
    jz .Lata_flush_failed
    movw $0x1f7, %dx
    movb $0xe7, %al
    outb %al, %dx
    call .Lata_wait_complete
    testl %eax, %eax
    jz .Lata_flush_failed
    movl $1, %eax
    jmp .Lata_flush_done
.Lata_flush_failed:
    xorl %eax, %eax
.Lata_flush_done:
    popl %ebp
    popl %esi
    popl %ebx
    ret

.globl terminal_reboot
terminal_reboot:
    cli
.Lreboot_wait:
    movw $0x64, %dx
    inb %dx, %al
    testb $2, %al
    jnz .Lreboot_wait
    movb $0xfe, %al
    outb %al, %dx
    jmp terminal_halt

.globl terminal_halt
terminal_halt:
    cli
.Lterminal_halt_loop:
    hlt
    jmp .Lterminal_halt_loop

.globl __mlang_std_exceptions_push_frame
__mlang_std_exceptions_push_frame:
    xorl %eax, %eax
    ret
.globl __mlang_std_exceptions_frame_env
__mlang_std_exceptions_frame_env:
    movl $__mlang_boot_jmp_buffer, %eax
    ret
.globl _setjmp
_setjmp:
    xorl %eax, %eax
    ret
.globl __mlang_std_exceptions_pop_frame
__mlang_std_exceptions_pop_frame:
    ret
.globl __mlang_std_exceptions_rethrow_current
__mlang_std_exceptions_rethrow_current:
    jmp terminal_halt

.section .bss,\"aw\",@nobits
.balign 16
input_buffer:
    .skip 64
current_directory:
    .skip 32
resolved_path:
    .skip 32
parent_path:
    .skip 32
empty_file:
    .skip 1
editor_length:
    .skip 4
__mlang_boot_jmp_buffer:
    .skip 256
");

extern fn serial_write(message: str8) -> void;
extern fn terminal_read_line() -> str8;
extern fn terminal_command_eq(actual: str8, expected: str8) -> i32;
extern fn terminal_command_prefix(actual: str8, prefix: str8) -> i32;
extern fn terminal_argument(command: str8, offset: i32) -> str8;
extern fn terminal_reboot() -> void;
extern fn terminal_halt() -> void;
extern fn fs_load() -> i32;
extern fn fs_mount() -> i32;
extern fn fs_entry_count() -> i32;
extern fn fs_entry_path(index: i32) -> str8;
extern fn fs_entry_type(index: i32) -> i32;
extern fn fs_entry_data(index: i32) -> str8;
extern fn fs_pwd() -> str8;
extern fn fs_resolve(path: str8) -> str8;
extern fn fs_find(path: str8) -> i32;
extern fn fs_set_cwd(path: str8) -> void;
extern fn fs_basename(path: str8) -> str8;
extern fn fs_parent(path: str8) -> str8;
extern fn fs_is_direct_child(directory: str8, candidate: str8) -> i32;
extern fn fs_create_empty(path: str8) -> i32;
extern fn fs_write_text(index: i32, text: str8, length: i32) -> i32;
extern fn fs_flush() -> i32;
extern fn editor_load(index: i32) -> i32;
extern fn editor_clear() -> void;
extern fn editor_append_line(line: str8) -> i32;
extern fn editor_data() -> str8;
extern fn editor_size() -> i32;

fn list_directory(request: str8) -> i32 {
    let directory: str8 = fs_resolve(request);
    let directory_index: i32 = fs_find(directory);
    if directory_index < 0 {
        return -1;
    }
    if fs_entry_type(directory_index) != 2 {
        return -2;
    }

    var index: i32 = 0;
    let count: i32 = fs_entry_count();
    while index < count {
        let path: str8 = fs_entry_path(index);
        if fs_is_direct_child(directory, path) == 1 {
            serial_write(fs_basename(path));
            if fs_entry_type(index) == 2 {
                serial_write("/");
            }
            serial_write("\r\n");
        }
        index = index + 1;
    }
    return 0;
}

fn cat_file(request: str8) -> i32 {
    let path: str8 = fs_resolve(request);
    let index: i32 = fs_find(path);
    if index < 0 {
        return -1;
    }
    if fs_entry_type(index) != 1 {
        return -2;
    }
    serial_write(fs_entry_data(index));
    return 0;
}

fn change_directory(request: str8) -> i32 {
    let path: str8 = fs_resolve(request);
    let index: i32 = fs_find(path);
    if index < 0 || fs_entry_type(index) != 2 {
        return 0;
    }
    fs_set_cwd(path);
    return 1;
}

fn touch_file(request: str8) -> i32 {
    let path: str8 = fs_resolve(request);
    if fs_find(path) >= 0 {
        return 0;
    }
    let parent: str8 = fs_parent(path);
    let parent_index: i32 = fs_find(parent);
    if parent_index < 0 || fs_entry_type(parent_index) != 2 {
        return -1;
    }
    let created: i32 = fs_create_empty(path);
    if created != 1 {
        return created;
    }
    if fs_flush() != 1 {
        return -3;
    }
    return 1;
}

fn edit_file(request: str8) -> i32 {
    let path: str8 = fs_resolve(request);
    var index: i32 = fs_find(path);
    if index >= 0 && fs_entry_type(index) != 1 {
        return -2;
    }
    if index < 0 {
        let parent: str8 = fs_parent(path);
        let parent_index: i32 = fs_find(parent);
        if parent_index < 0 || fs_entry_type(parent_index) != 2 {
            return -1;
        }
        editor_clear();
    } else {
        if editor_load(index) != 1 {
            return -4;
        }
    }
    serial_write("MLang vi: ");
    serial_write(path);
    serial_write("\r\n");
    if editor_size() > 0 {
        serial_write("--- current contents ---\r\n");
        serial_write(editor_data());
    }
    serial_write("--- replace contents; '.' saves, ':q!' cancels ---\r\n");
    editor_clear();
    while true {
        serial_write("| ");
        let line: str8 = terminal_read_line();
        if terminal_command_eq(line, ".") == 1 {
            if index < 0 {
                let created: i32 = fs_create_empty(path);
                if created != 1 {
                    return -3;
                }
                index = fs_find(path);
            }
            let written: i32 = fs_write_text(index, editor_data(), editor_size());
            if written == -2 {
                return -5;
            }
            if written != 1 {
                return -4;
            }
            if fs_flush() != 1 {
                return -6;
            }
            return 1;
        }
        if terminal_command_eq(line, ":q!") == 1 {
            return 0;
        }
        if editor_append_line(line) != 1 {
            serial_write("vi: editor buffer is full; save or cancel\r\n");
        }
    }
    return 0;
}

fn report_edit_result(result: i32) -> void {
    if result == 0 {
        serial_write("vi: changes discarded\r\n");
    } else if result == -1 {
        serial_write("vi: parent directory not found\r\n");
    } else if result == -2 {
        serial_write("vi: is a directory\r\n");
    } else if result == -3 {
        serial_write("vi: filesystem directory is full\r\n");
    } else if result == -4 {
        serial_write("vi: file is too large for the configured image\r\n");
    } else if result == -5 {
        serial_write("vi: filesystem data area is full\r\n");
    } else if result == -6 {
        serial_write("vi: saved in memory but disk flush failed\r\n");
    } else {
        serial_write("vi: saved\r\n");
    }
}

fn terminal_main() -> i32 {
    serial_write("\r\nMLang virtual terminal\r\n");
    if fs_load() == 1 && fs_mount() == 1 {
        serial_write("Mounted writable MFS2 at /.\r\n");
    } else {
        serial_write("MFS2 mount failed.\r\n");
    }
    serial_write("Type 'help' for available commands.\r\n\r\n");

    while true {
        serial_write("mlang> ");
        let command: str8 = terminal_read_line();

        if terminal_command_eq(command, "help") == 1 {
            serial_write("help   show available commands\r\n");
            serial_write("about  show kernel information\r\n");
            serial_write("clear  clear the terminal\r\n");
            serial_write("pwd    print working directory\r\n");
            serial_write("ls     list a directory: ls [path]\r\n");
            serial_write("cd     change directory: cd <path>\r\n");
            serial_write("cat    print a file: cat <path>\r\n");
            serial_write("touch  create an empty file\r\n");
            serial_write("vi     edit a text file: vi <path>\r\n");
            serial_write("sync   flush MFS2 metadata to disk\r\n");
            serial_write("reboot restart the virtual machine\r\n");
            serial_write("halt   stop the virtual CPU\r\n");
        } else if terminal_command_eq(command, "about") == 1 {
            serial_write("MLang 32-bit protected-mode kernel loaded by BIOS.\r\n");
        } else if terminal_command_eq(command, "clear") == 1 {
            serial_write("\x1b[2J\x1b[H");
        } else if terminal_command_eq(command, "pwd") == 1 {
            serial_write(fs_pwd());
            serial_write("\r\n");
        } else if terminal_command_eq(command, "ls") == 1 {
            let _ = list_directory(fs_pwd());
        } else if terminal_command_prefix(command, "ls ") == 1 {
            let result: i32 = list_directory(terminal_argument(command, 3));
            if result == -1 {
                serial_write("ls: directory not found\r\n");
            } else if result == -2 {
                serial_write("ls: not a directory\r\n");
            }
        } else if terminal_command_eq(command, "cd") == 1 {
            serial_write("usage: cd <directory>\r\n");
        } else if terminal_command_prefix(command, "cd ") == 1 {
            if change_directory(terminal_argument(command, 3)) != 1 {
                serial_write("cd: directory not found\r\n");
            }
        } else if terminal_command_eq(command, "cat") == 1 {
            serial_write("usage: cat <file>\r\n");
        } else if terminal_command_prefix(command, "cat ") == 1 {
            let result: i32 = cat_file(terminal_argument(command, 4));
            if result == -1 {
                serial_write("cat: file not found\r\n");
            } else if result == -2 {
                serial_write("cat: is a directory\r\n");
            }
        } else if terminal_command_eq(command, "touch") == 1 {
            serial_write("usage: touch <file>\r\n");
        } else if terminal_command_prefix(command, "touch ") == 1 {
            let result: i32 = touch_file(terminal_argument(command, 6));
            if result == 0 {
                serial_write("touch: file already exists\r\n");
            } else if result == -1 {
                serial_write("touch: parent directory not found\r\n");
            } else if result == -2 {
                serial_write("touch: filesystem directory is full\r\n");
            } else if result == -3 {
                serial_write("touch: created in memory but disk flush failed\r\n");
            }
        } else if terminal_command_eq(command, "vi") == 1 || terminal_command_eq(command, "/bin/vi") == 1 {
            serial_write("usage: vi <file>\r\n");
        } else if terminal_command_prefix(command, "vi ") == 1 {
            report_edit_result(edit_file(terminal_argument(command, 3)));
        } else if terminal_command_prefix(command, "/bin/vi ") == 1 {
            report_edit_result(edit_file(terminal_argument(command, 8)));
        } else if terminal_command_eq(command, "sync") == 1 {
            if fs_flush() == 1 {
                serial_write("MFS2 synchronized to disk.\r\n");
            } else {
                serial_write("sync: ATA disk write failed\r\n");
            }
        } else if terminal_command_eq(command, "reboot") == 1 {
            serial_write("Rebooting...\r\n");
            terminal_reboot();
        } else if terminal_command_eq(command, "halt") == 1 {
            serial_write("CPU halted.\r\n");
            terminal_halt();
        } else if terminal_command_eq(command, "") != 1 {
            serial_write("Unknown command. Type 'help'.\r\n");
        }
    }

    return 0;
}
