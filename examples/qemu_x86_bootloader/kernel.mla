.Lserial_try_ready:
    movw $0x3f8, %dx
    inb %dx, %al
    movzbl %al, %eax
    ret

.globl terminal_read_key
terminal_read_key:
    cmpl $0, pending_key_valid
    jne .Lkey_pending
    call .Lserial_getc
    movzbl %al, %eax
    cmpl $27, %eax
    jne .Lkey_done
    call .Lserial_try_getc
    cmpl $-1, %eax
    je .Lkey_escape
    cmpl $91, %eax
    jne .Lkey_save_pending
    call .Lserial_try_getc
    cmpl $-1, %eax
    je .Lkey_escape
    cmpl $65, %eax
    je .Lkey_up
    cmpl $66, %eax
    je .Lkey_down
    cmpl $67, %eax
    je .Lkey_right
    cmpl $68, %eax
    je .Lkey_left
    cmpl $72, %eax
