/// A separately linked 32-bit kernel loaded by boot.mla at physical 0x10000.
/// Hardware entry and COM1 primitives use module assembly; the terminal command
/// loop below is ordinary MLang code.
mod vi;
use vi::edit_file;
use vi::report_edit_result;

asm x86(".code16
.section .kernel,\"ax\",@progbits
.globl kernel_start
kernel_start:
    cli
    movw %cs, %ax
    movw %ax, %ds
    movw %ax, %es
    movw %ax, %ss
    movw $0xfffe, %sp
    lgdt (gdt_descriptor - kernel_start)
    movl %cr0, %eax
    orl $1, %eax
    movl %eax, %cr0
    ljmpl $0x08, $protected_entry

.balign 8
gdt_start:
    .quad 0x0000000000000000
    .quad 0x00cf9a000000ffff
    .quad 0x00cf92000000ffff
gdt_end:
gdt_descriptor:
    .word gdt_end - gdt_start - 1
    .long gdt_start

.code32
protected_entry:
    movw $0x10, %ax
    movw %ax, %ds
    movw %ax, %es
    movw %ax, %fs
    movw %ax, %gs
    movw %ax, %ss
    movl $0x00090000, %esp
    call .Lserial_init
    call terminal_main__void
    jmp terminal_halt

.set MFS_BASE, 0x00100000

.Lserial_init:
    movw $0x3f9, %dx
    xorb %al, %al
    outb %al, %dx
    movw $0x3fb, %dx
    movb $0x80, %al
    outb %al, %dx
    movw $0x3f8, %dx
    movb $1, %al
    outb %al, %dx
    movw $0x3f9, %dx
    xorb %al, %al
    outb %al, %dx
    movw $0x3fb, %dx
    movb $3, %al
    outb %al, %dx
    movw $0x3fa, %dx
    movb $0xc7, %al
    outb %al, %dx
    movw $0x3fc, %dx
    movb $0x0b, %al
    outb %al, %dx
    ret

.Lserial_putc:
    pushl %edx
    pushl %eax
.Lserial_putc_wait:
    movw $0x3fd, %dx
    inb %dx, %al
    testb $0x20, %al
    jz .Lserial_putc_wait
    popl %eax
    movw $0x3f8, %dx
    outb %al, %dx
    popl %edx
    ret

.Lserial_getc:
    pushl %edx
.Lserial_getc_wait:
    movw $0x3fd, %dx
    inb %dx, %al
    testb $1, %al
    jz .Lserial_getc_wait
    movw $0x3f8, %dx
    inb %dx, %al
    popl %edx
    ret

.globl serial_write
serial_write:
    pushl %esi
    movl 8(%esp), %esi
.Lserial_write_next:
    lodsb
    testb %al, %al
    jz .Lserial_write_done
    call .Lserial_putc
    jmp .Lserial_write_next
.Lserial_write_done:
    popl %esi
    ret

.globl terminal_read_line
terminal_read_line:
    pushl %ebp
    movl %esp, %ebp
    pushl %ebx
    pushl %edi
    movl $input_buffer, %edi
    xorl %ebx, %ebx
.Lread_key:
    call .Lserial_getc
    cmpb $13, %al
    je .Lread_done
    cmpb $10, %al
    je .Lread_done
    cmpb $8, %al
    je .Lread_backspace
    cmpb $127, %al
    je .Lread_backspace
    cmpb $32, %al
    jb .Lread_key
    cmpb $126, %al
    ja .Lread_key
    cmpl $63, %ebx
    jae .Lread_key
    movb %al, (%edi,%ebx)
    incl %ebx
    call .Lserial_putc
    jmp .Lread_key
.Lread_backspace:
    testl %ebx, %ebx
