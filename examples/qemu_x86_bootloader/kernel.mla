    movw %cs, %ax
    movw %ax, %ds
    movw %ax, %es
    movw %ax, %ss
    movw $0xfffe, %sp
    lgdt (gdt_descriptor - kernel_start)
    movl %cr0, %eax
    orl $1, %eax
    movl %eax, %cr0
