extern fn fs_entry_mode(index: i32) -> i32;
extern fn fs_entry_size(index: i32) -> i32;
extern fn fs_entry_data(index: i32) -> str8;
extern fn fs_entry_ends_lf(index: i32) -> i32;
extern fn fs_current_uid() -> i32;
extern fn fs_set_current_uid(uid: i32) -> i32;
extern fn fs_can_access(index: i32, mask: i32) -> i32;
extern fn fs_chmod(index: i32, mode: i32) -> i32;
extern fn fs_chown(index: i32, uid: i32) -> i32;
extern fn fs_pwd() -> str8;
extern fn fs_resolve(path: str8) -> str8;
extern fn fs_find(path: str8) -> i32;
extern fn fs_set_cwd(path: str8) -> void;
extern fn fs_basename(path: str8) -> str8;
extern fn fs_parent(path: str8) -> str8;
extern fn fs_is_direct_child(directory: str8, candidate: str8) -> i32;
extern fn fs_create_empty(path: str8) -> i32;
extern fn fs_write_text(index: i32, text: str8, length: i32) -> i32;
extern fn fs_flush() -> i32;
extern fn editor_load(index: i32) -> i32;
extern fn editor_clear() -> void;
extern fn editor_append_line(line: str8) -> i32;
extern fn editor_data() -> str8;
extern fn editor_size() -> i32;

fn user_name(uid: i32) -> str8 {
    if uid == 1 {
        return "user";
    }
    return "root";
}

fn switch_user(name: str8) -> i32 {
    if terminal_command_eq(name, "user") == 1 {
        return fs_set_current_uid(1);
    }
    if terminal_command_eq(name, "root") == 1 {
        if fs_current_uid() != 0 {
            return -2;
        }
        return fs_set_current_uid(0);
    }
    return -1;
}

fn change_directory(request: str8) -> i32 {
    let path: str8 = fs_resolve(request);
    let index: i32 = fs_find(path);
    if index < 0 || fs_entry_type(index) != 2 {
        return -1;
    }
    if fs_can_access(index, 1) != 1 {
        return -2;
    }
    fs_set_cwd(path);
    return 1;
}

fn touch_file(request: str8) -> i32 {
    let path: str8 = fs_resolve(request);
    if fs_find(path) >= 0 {
        return 0;
    }
    let parent: str8 = fs_parent(path);
    let parent_index: i32 = fs_find(parent);
    if parent_index < 0 || fs_entry_type(parent_index) != 2 {
        return -1;
    }
    if fs_can_access(parent_index, 3) != 1 {
        return -4;
    }
    let created: i32 = fs_create_empty(path);
    if created != 1 {
        return created;
    }
    if fs_flush() != 1 {
        return -3;
    }
    return 1;
}

fn native_command_path(name: str8) -> str8 {
    if terminal_command_eq(name, "ls") == 1 || terminal_command_eq(name, "/bin/ls") == 1 {
        return "/bin/ls";
    }
    if terminal_command_eq(name, "cat") == 1 || terminal_command_eq(name, "/bin/cat") == 1 {
        return "/bin/cat";
    }
    if terminal_command_eq(name, "chmod") == 1 || terminal_command_eq(name, "/bin/chmod") == 1 {
        return "/bin/chmod";
    }
    if terminal_command_eq(name, "chown") == 1 || terminal_command_eq(name, "/bin/chown") == 1 {
        return "/bin/chown";
    }
    if terminal_command_eq(name, "mkdir") == 1 || terminal_command_eq(name, "/bin/mkdir") == 1 {
        return "/bin/mkdir";
    }
    if terminal_command_eq(name, "rm") == 1 || terminal_command_eq(name, "/bin/rm") == 1 {
        return "/bin/rm";
    }
    if terminal_command_eq(name, "echo") == 1 || terminal_command_eq(name, "/bin/echo") == 1 {
        return "/bin/echo";
    }
    if terminal_command_eq(name, "cp") == 1 || terminal_command_eq(name, "/bin/cp") == 1 {
        return "/bin/cp";
    }
    if terminal_command_eq(name, "mv") == 1 || terminal_command_eq(name, "/bin/mv") == 1 {
        return "/bin/mv";
    }
    if terminal_command_eq(name, "wc") == 1 || terminal_command_eq(name, "/bin/wc") == 1 {
        return "/bin/wc";
    }
    if terminal_command_eq(name, "ping") == 1 || terminal_command_eq(name, "/bin/ping") == 1 {
        return "/bin/ping";
    }
    if terminal_command_eq(name, "vi") == 1 || terminal_command_eq(name, "/bin/vi") == 1 {
        return "/bin/vi";
    }
    return "";
}

fn run_native_command(command: str8) -> i32 {
    let arguments: str8 = terminal_split_argument(command);
    let path: str8 = native_command_path(command);
    if terminal_command_eq(path, "") == 1 {
        return -1;
    }

    let executable: i32 = fs_find(path);
    if executable < 0 || fs_entry_type(executable) != 3 {
        serial_write(command);
        serial_write(": command not found\r\n");
        return 0;
    }
    if fs_can_access(executable, 1) != 1 {
        serial_write(command);
        serial_write(": permission denied\r\n");
        return 0;
    }

    let result: i32 = command_exec(executable, arguments);
    if result == -127 {
        serial_write(command);
        serial_write(": invalid executable\r\n");
    }
    return 0;
}

fn terminal_builtin_help(command: str8) -> i32 {
    if terminal_command_eq(command, "help -h") == 1 || terminal_command_eq(command, "help --help") == 1 {
        serial_write("usage: help\r\nlist available commands\r\n");
    } else if terminal_command_eq(command, "about -h") == 1 || terminal_command_eq(command, "about --help") == 1 {
        serial_write("usage: about\r\nshow kernel information\r\n");
    } else if terminal_command_eq(command, "clear -h") == 1 || terminal_command_eq(command, "clear --help") == 1 {
        serial_write("usage: clear\r\nclear the terminal\r\n");
    } else if terminal_command_eq(command, "pwd -h") == 1 || terminal_command_eq(command, "pwd --help") == 1 {
        serial_write("usage: pwd\r\nprint the current directory\r\n");
    } else if terminal_command_eq(command, "whoami -h") == 1 || terminal_command_eq(command, "whoami --help") == 1 {
        serial_write("usage: whoami\r\nprint the current user\r\n");
    } else if terminal_command_eq(command, "su -h") == 1 || terminal_command_eq(command, "su --help") == 1 {
        serial_write("usage: su <root|user>\r\nswitch the current user\r\n");
    } else if terminal_command_eq(command, "cd -h") == 1 || terminal_command_eq(command, "cd --help") == 1 {
        serial_write("usage: cd <directory>\r\nchange the current directory\r\n");
    } else if terminal_command_eq(command, "touch -h") == 1 || terminal_command_eq(command, "touch --help") == 1 {
        serial_write("usage: touch <file>\r\ncreate an empty file\r\n");
    } else if terminal_command_eq(command, "sync -h") == 1 || terminal_command_eq(command, "sync --help") == 1 {
        serial_write("usage: sync\r\nflush MFS2 metadata and data to disk\r\n");
    } else if terminal_command_eq(command, "reboot -h") == 1 || terminal_command_eq(command, "reboot --help") == 1 {
        serial_write("usage: reboot\r\nrestart the virtual machine\r\n");
    } else if terminal_command_eq(command, "halt -h") == 1 || terminal_command_eq(command, "halt --help") == 1 {
        serial_write("usage: halt\r\nstop the virtual CPU\r\n");
    } else {
        return 0;
    }
    return 1;
}

fn terminal_main() -> i32 {
    serial_write("\r\nMLang virtual terminal\r\n");
    if fs_load() == 1 && fs_mount() == 1 {
        serial_write("Mounted writable MFS2 at /.\r\n");
    } else {
        serial_write("MFS2 mount failed.\r\n");
    }
    serial_write("Type 'help' for available commands.\r\n\r\n");

    while true {
        serial_write("$ ");
        let command: str8 = terminal_read_line();

        let help_result: i32 = terminal_builtin_help(command);
        if help_result != 1 && terminal_command_eq(command, "help") == 1 {
            serial_write("help   show available commands\r\n");
            serial_write("about  show kernel information\r\n");
            serial_write("clear  clear the terminal\r\n");
            serial_write("pwd    print working directory\r\n");
            serial_write("whoami print the current user\r\n");
            serial_write("su     switch user: su <root|user>\r\n");
            serial_write("ls     list a directory: ls [-l] [path]\r\n");
            serial_write("cd     change directory: cd <path>\r\n");
            serial_write("cat    print a file: cat <path>\r\n");
            serial_write("touch  create an empty file\r\n");
            serial_write("chmod  change mode: chmod <mode> <path>\r\n");
            serial_write("chown  change owner: chown <user> <path>\r\n");
            serial_write("mkdir  create a directory: mkdir <path>\r\n");
            serial_write("rm     remove a file or tree: rm [-f] [-r] <path>\r\n");
            serial_write("echo   write text: echo [text]\r\n");
            serial_write("cp     copy a file: cp <source> <destination>\r\n");
            serial_write("mv     rename a file: mv <source> <destination>\r\n");
            serial_write("wc     count text: wc <path>\r\n");
            serial_write("ping   test IPv4 reachability: ping [-i seconds] <host>\r\n");
            serial_write("vi     edit a text file: vi <path>\r\n");
            serial_write("sync   flush MFS2 metadata to disk\r\n");
            serial_write("reboot restart the virtual machine\r\n");
            serial_write("halt   stop the virtual CPU\r\n");
            serial_write("Use <command> -h or --help for command help.\r\n");
        } else if terminal_command_eq(command, "about") == 1 {
            serial_write("MLang 32-bit protected-mode kernel loaded by BIOS.\r\n");
        } else if terminal_command_eq(command, "clear") == 1 {
            serial_write("\x1b[2J\x1b[H");
        } else if terminal_command_eq(command, "pwd") == 1 {
            serial_write(fs_pwd());
            serial_write("\r\n");
        } else if terminal_command_eq(command, "whoami") == 1 {
            serial_write(user_name(fs_current_uid()));
            serial_write("\r\n");
        } else if terminal_command_eq(command, "su") == 1 {
            serial_write("usage: su <root|user>\r\n");
        } else if terminal_command_prefix(command, "su ") == 1 {
            let result: i32 = switch_user(terminal_argument(command, 3));
            if result == -1 {
                serial_write("su: unknown user\r\n");
            } else if result == -2 {
                serial_write("su: permission denied\r\n");
            }
        } else if terminal_command_eq(command, "cd") == 1 {
            serial_write("usage: cd <directory>\r\n");
        } else if terminal_command_prefix(command, "cd ") == 1 {
            let result: i32 = change_directory(terminal_argument(command, 3));
            if result == -1 {
                serial_write("cd: directory not found\r\n");
            } else if result == -2 {
                serial_write("cd: permission denied\r\n");
            }
        } else if terminal_command_eq(command, "touch") == 1 {
            serial_write("usage: touch <file>\r\n");
        } else if terminal_command_prefix(command, "touch ") == 1 {
            let result: i32 = touch_file(terminal_argument(command, 6));
            if result == 0 {
                serial_write("touch: file already exists\r\n");
            } else if result == -1 {
                serial_write("touch: parent directory not found\r\n");
            } else if result == -2 {
                serial_write("touch: filesystem directory is full\r\n");
            } else if result == -3 {
                serial_write("touch: created in memory but disk flush failed\r\n");
            } else if result == -4 {
                serial_write("touch: permission denied\r\n");
            }
        } else if terminal_command_eq(command, "sync") == 1 {
            if fs_flush() == 1 {
                serial_write("MFS2 synchronized to disk.\r\n");
            } else {
                serial_write("sync: ATA disk write failed\r\n");
            }
        } else if terminal_command_eq(command, "reboot") == 1 {
            serial_write("Rebooting...\r\n");
            terminal_reboot();
        } else if terminal_command_eq(command, "halt") == 1 {
            serial_write("CPU halted.\r\n");
            terminal_halt();
        } else if help_result != 1 && terminal_command_eq(command, "") != 1 {
            if run_native_command(command) == -1 {
                serial_write("Unknown command. Type 'help'.\r\n");
            }
        }
    }

    return 0;
}
