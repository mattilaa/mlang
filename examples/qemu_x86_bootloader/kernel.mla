    movb $32, %al
    call .Lserial_putc
    movb $8, %al
    call .Lserial_putc
    jmp .Lread_key
.Lread_done:
    movb $0, (%edi,%ebx)
    movb $13, %al
    call .Lserial_putc
    movb $10, %al
    call .Lserial_putc
    movl %edi, %eax
    popl %edi
    popl %ebx
    leave
    ret

.globl serial_write_char
serial_write_char:
