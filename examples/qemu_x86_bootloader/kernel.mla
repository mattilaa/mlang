.Lkey_down:
    movl $1002, %eax
    ret
.Lkey_right:
    movl $1003, %eax
    ret
.Lkey_left:
    movl $1004, %eax
    ret
.Lkey_home:
    movl $1006, %eax
    ret
.Lkey_end:
    movl $1007, %eax
    ret
.Lkey_pending:
    movl pending_key, %eax
    movl $0, pending_key_valid
.Lkey_done:
    ret

