    jne .Lkey_escape
    call .Lserial_try_getc
    cmpl $126, %eax
    jne .Lkey_escape
    movl $1005, %eax
    ret
.Lkey_save_pending:
    movl %eax, pending_key
    movl $1, pending_key_valid
.Lkey_escape:
    movl $27, %eax
    ret
.Lkey_up:
    movl $1001, %eax
