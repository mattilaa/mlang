/// A separately linked 32-bit kernel loaded by boot.mla at physical 0x10000.
/// Hardware entry and COM1 primitives use module assembly; the terminal command
/// loop below is ordinary MLang code.
asm x86(".code16
.section .kernel,\"ax\",@progbits
.globl kernel_start
kernel_start:
    cli
    movw %cs, %ax
    movw %ax, %ds
    movw %ax, %es
    movw %ax, %ss
    movw $0xfffe, %sp
    lgdt (gdt_descriptor - kernel_start)
    movl %cr0, %eax
    orl $1, %eax
    movl %eax, %cr0
    ljmpl $0x08, $protected_entry

.balign 8
gdt_start:
    .quad 0x0000000000000000
    .quad 0x00cf9a000000ffff
    .quad 0x00cf92000000ffff
gdt_end:
gdt_descriptor:
    .word gdt_end - gdt_start - 1
    .long gdt_start

.code32
protected_entry:
    movw $0x10, %ax
    movw %ax, %ds
    movw %ax, %es
    movw %ax, %fs
    movw %ax, %gs
    movw %ax, %ss
    movl $0x00090000, %esp
    call .Lserial_init
    call terminal_main__void
    jmp terminal_halt

.Lserial_init:
    movw $0x3f9, %dx
    xorb %al, %al
    outb %al, %dx
    movw $0x3fb, %dx
    movb $0x80, %al
    outb %al, %dx
    movw $0x3f8, %dx
    movb $1, %al
    outb %al, %dx
    movw $0x3f9, %dx
    xorb %al, %al
    outb %al, %dx
    movw $0x3fb, %dx
    movb $3, %al
    outb %al, %dx
    movw $0x3fa, %dx
    movb $0xc7, %al
    outb %al, %dx
    movw $0x3fc, %dx
    movb $0x0b, %al
    outb %al, %dx
    ret

.Lserial_putc:
    pushl %edx
    pushl %eax
.Lserial_putc_wait:
    movw $0x3fd, %dx
    inb %dx, %al
    testb $0x20, %al
    jz .Lserial_putc_wait
    popl %eax
    movw $0x3f8, %dx
    outb %al, %dx
    popl %edx
    ret

.Lserial_getc:
    pushl %edx
.Lserial_getc_wait:
    movw $0x3fd, %dx
    inb %dx, %al
    testb $1, %al
    jz .Lserial_getc_wait
    movw $0x3f8, %dx
    inb %dx, %al
    popl %edx
    ret

.globl serial_write
serial_write:
    pushl %esi
    movl 8(%esp), %esi
.Lserial_write_next:
    lodsb
    testb %al, %al
    jz .Lserial_write_done
    call .Lserial_putc
    jmp .Lserial_write_next
.Lserial_write_done:
    popl %esi
    ret

.globl terminal_read_line
terminal_read_line:
    pushl %ebp
    movl %esp, %ebp
    pushl %ebx
    pushl %edi
    movl $input_buffer, %edi
    xorl %ebx, %ebx
.Lread_key:
    call .Lserial_getc
    cmpb $13, %al
    je .Lread_done
    cmpb $10, %al
    je .Lread_done
    cmpb $8, %al
    je .Lread_backspace
    cmpb $127, %al
    je .Lread_backspace
    cmpb $32, %al
    jb .Lread_key
    cmpb $126, %al
    ja .Lread_key
    cmpl $63, %ebx
    jae .Lread_key
    movb %al, (%edi,%ebx)
    incl %ebx
    call .Lserial_putc
    jmp .Lread_key
.Lread_backspace:
    testl %ebx, %ebx
    jz .Lread_key
    decl %ebx
    movb $8, %al
    call .Lserial_putc
    movb $32, %al
    call .Lserial_putc
    movb $8, %al
    call .Lserial_putc
    jmp .Lread_key
.Lread_done:
    movb $0, (%edi,%ebx)
    movb $13, %al
    call .Lserial_putc
    movb $10, %al
    call .Lserial_putc
    movl %edi, %eax
    popl %edi
    popl %ebx
    leave
    ret

.globl terminal_command_eq
terminal_command_eq:
    pushl %esi
    pushl %edi
    movl 12(%esp), %esi
    movl 16(%esp), %edi
.Lcommand_eq_next:
    movb (%esi), %al
    cmpb (%edi), %al
    jne .Lcommand_not_equal
    testb %al, %al
    jz .Lcommand_equal
    incl %esi
    incl %edi
    jmp .Lcommand_eq_next
.Lcommand_not_equal:
    xorl %eax, %eax
    jmp .Lcommand_eq_done
.Lcommand_equal:
    movl $1, %eax
.Lcommand_eq_done:
    popl %edi
    popl %esi
    ret

.globl terminal_command_prefix
terminal_command_prefix:
    pushl %esi
    pushl %edi
    movl 12(%esp), %esi
    movl 16(%esp), %edi
.Lprefix_next:
    movb (%edi), %al
    testb %al, %al
    jz .Lprefix_match
    cmpb (%esi), %al
    jne .Lprefix_no_match
    incl %esi
    incl %edi
    jmp .Lprefix_next
.Lprefix_no_match:
    xorl %eax, %eax
    jmp .Lprefix_done
.Lprefix_match:
    movl $1, %eax
.Lprefix_done:
    popl %edi
    popl %esi
    ret

.globl terminal_argument
terminal_argument:
    movl 4(%esp), %eax
    addl 8(%esp), %eax
    ret

.globl fs_mount
fs_mount:
    xorl %eax, %eax
    cmpl $0x3253464d, 0x00020000
    jne .Lfs_mount_done
    movzwl 0x00020004, %ecx
    movzwl 0x00020006, %edx
    cmpl %edx, %ecx
    ja .Lfs_mount_done
    cmpl $32, %edx
    ja .Lfs_mount_done
    movb $47, current_directory
    movb $0, current_directory + 1
    movl $1, %eax
.Lfs_mount_done:
    ret

.globl fs_entry_count
fs_entry_count:
    movzwl 0x00020004, %eax
    ret

.globl fs_entry_path
fs_entry_path:
    movl 4(%esp), %eax
    testl %eax, %eax
    js .Lfs_entry_path_invalid
    movzwl 0x00020004, %ecx
    cmpl %ecx, %eax
    jae .Lfs_entry_path_invalid
    imull $48, %eax, %eax
    addl $0x00020010, %eax
    ret
.Lfs_entry_path_invalid:
    xorl %eax, %eax
    ret

.globl fs_entry_type
fs_entry_type:
    movl 4(%esp), %eax
    testl %eax, %eax
    js .Lfs_entry_type_invalid
    movzwl 0x00020004, %ecx
    cmpl %ecx, %eax
    jae .Lfs_entry_type_invalid
    imull $48, %eax, %eax
    movzbl 0x00020030(%eax), %eax
    ret
.Lfs_entry_type_invalid:
    xorl %eax, %eax
    ret

.globl fs_entry_data
fs_entry_data:
    movl 4(%esp), %eax
    testl %eax, %eax
    js .Lfs_entry_data_invalid
    movzwl 0x00020004, %ecx
    cmpl %ecx, %eax
    jae .Lfs_entry_data_invalid
    imull $48, %eax, %eax
    cmpl $0, 0x00020038(%eax)
    je .Lfs_entry_empty
    movl 0x00020034(%eax), %eax
    addl $0x00020000, %eax
    ret
.Lfs_entry_empty:
    movl $empty_file, %eax
    ret
.Lfs_entry_data_invalid:
    xorl %eax, %eax
    ret

.globl fs_pwd
fs_pwd:
    movl $current_directory, %eax
    ret

.globl fs_resolve
fs_resolve:
    pushl %ebp
    movl %esp, %ebp
    pushl %esi
    pushl %edi
    pushl %ebx
    movl 8(%ebp), %esi
    movl $resolved_path, %edi
    movl $31, %ecx
    cmpb $0, (%esi)
    je .Lresolve_current
    cmpb $46, (%esi)
    jne .Lresolve_not_dot
    cmpb $0, 1(%esi)
    je .Lresolve_current
    cmpb $46, 1(%esi)
    jne .Lresolve_not_dot
    cmpb $0, 2(%esi)
    je .Lresolve_parent
.Lresolve_not_dot:
    cmpb $47, (%esi)
    je .Lresolve_copy
    pushl %esi
    movl $current_directory, %esi
.Lresolve_copy_cwd:
    lodsb
    testb %al, %al
    jz .Lresolve_cwd_done
    stosb
    decl %ecx
    jz .Lresolve_finish
    jmp .Lresolve_copy_cwd
.Lresolve_cwd_done:
    popl %esi
    cmpb $47, -1(%edi)
    je .Lresolve_copy
    movb $47, (%edi)
    incl %edi
    decl %ecx
.Lresolve_copy:
    lodsb
    testb %al, %al
    jz .Lresolve_finish
    stosb
    decl %ecx
    jnz .Lresolve_copy
    jmp .Lresolve_finish
.Lresolve_current:
    movl $current_directory, %esi
    jmp .Lresolve_copy
.Lresolve_parent:
    movl $current_directory, %esi
.Lresolve_parent_copy:
    lodsb
    stosb
    testb %al, %al
    jnz .Lresolve_parent_copy
    cmpl $resolved_path + 2, %edi
    jbe .Lresolve_return
    subl $2, %edi
.Lresolve_parent_scan:
    cmpb $47, (%edi)
    je .Lresolve_parent_found
    decl %edi
    cmpl $resolved_path, %edi
    ja .Lresolve_parent_scan
.Lresolve_parent_found:
    cmpl $resolved_path, %edi
    jne .Lresolve_parent_trim
    incl %edi
.Lresolve_parent_trim:
    movb $0, (%edi)
    jmp .Lresolve_return
.Lresolve_finish:
    movb $0, (%edi)
    cmpl $resolved_path + 1, %edi
    jbe .Lresolve_return
    cmpb $47, -1(%edi)
    jne .Lresolve_return
    movb $0, -1(%edi)
.Lresolve_return:
    movl $resolved_path, %eax
    popl %ebx
    popl %edi
    popl %esi
    leave
    ret

.globl fs_find
fs_find:
    pushl %esi
    pushl %edi
    pushl %ebx
    movl 16(%esp), %ebx
    xorl %edx, %edx
    movzwl 0x00020004, %ecx
.Lfs_find_entry:
    cmpl %ecx, %edx
    jae .Lfs_find_missing
    movl %edx, %eax
    imull $48, %eax, %eax
    addl $0x00020010, %eax
    movl %eax, %esi
    movl %ebx, %edi
.Lfs_find_compare:
    movb (%esi), %al
    cmpb (%edi), %al
    jne .Lfs_find_next
    testb %al, %al
    jz .Lfs_find_found
    incl %esi
    incl %edi
    jmp .Lfs_find_compare
.Lfs_find_next:
    incl %edx
    jmp .Lfs_find_entry
.Lfs_find_found:
    movl %edx, %eax
    jmp .Lfs_find_done
.Lfs_find_missing:
    movl $-1, %eax
.Lfs_find_done:
    popl %ebx
    popl %edi
    popl %esi
    ret

.globl fs_set_cwd
fs_set_cwd:
    pushl %esi
    pushl %edi
    movl 12(%esp), %esi
    movl $current_directory, %edi
    movl $31, %ecx
.Lset_cwd_copy:
    lodsb
    stosb
    testb %al, %al
    jz .Lset_cwd_done
    decl %ecx
    jnz .Lset_cwd_copy
    movb $0, (%edi)
.Lset_cwd_done:
    popl %edi
    popl %esi
    ret

.globl fs_basename
fs_basename:
    movl 4(%esp), %eax
    movl %eax, %edx
.Lbasename_scan:
    movb (%edx), %cl
    testb %cl, %cl
    jz .Lbasename_done
    cmpb $47, %cl
    jne .Lbasename_next
    leal 1(%edx), %eax
.Lbasename_next:
    incl %edx
    jmp .Lbasename_scan
.Lbasename_done:
    ret

.globl fs_parent
fs_parent:
    pushl %esi
    pushl %edi
    movl 12(%esp), %esi
    movl $parent_path, %edi
.Lparent_copy:
    lodsb
    stosb
    testb %al, %al
    jnz .Lparent_copy
    subl $2, %edi
    cmpl $parent_path, %edi
    jbe .Lparent_root
.Lparent_scan:
    cmpb $47, (%edi)
    je .Lparent_found
    decl %edi
    cmpl $parent_path, %edi
    ja .Lparent_scan
.Lparent_found:
    cmpl $parent_path, %edi
    jne .Lparent_trim
.Lparent_root:
    movb $47, parent_path
    movb $0, parent_path + 1
    jmp .Lparent_done
.Lparent_trim:
    movb $0, (%edi)
.Lparent_done:
    movl $parent_path, %eax
    popl %edi
    popl %esi
    ret

.globl fs_is_direct_child
fs_is_direct_child:
    pushl %esi
    pushl %edi
    movl 12(%esp), %esi
    movl 16(%esp), %edi
    cmpb $47, (%esi)
    jne .Lchild_non_root
    cmpb $0, 1(%esi)
    jne .Lchild_non_root
    cmpb $47, (%edi)
    jne .Lchild_no
    incl %edi
    cmpb $0, (%edi)
    je .Lchild_no
    jmp .Lchild_remainder
.Lchild_non_root:
    movb (%esi), %al
    testb %al, %al
    jz .Lchild_prefix_done
    cmpb (%edi), %al
    jne .Lchild_no
    incl %esi
    incl %edi
    jmp .Lchild_non_root
.Lchild_prefix_done:
    cmpb $47, (%edi)
    jne .Lchild_no
    incl %edi
    cmpb $0, (%edi)
    je .Lchild_no
.Lchild_remainder:
    movb (%edi), %al
    testb %al, %al
    jz .Lchild_yes
    cmpb $47, %al
    je .Lchild_no
    incl %edi
    jmp .Lchild_remainder
.Lchild_yes:
    movl $1, %eax
    jmp .Lchild_done
.Lchild_no:
    xorl %eax, %eax
.Lchild_done:
    popl %edi
    popl %esi
    ret

.globl fs_create_empty
fs_create_empty:
    pushl %esi
    pushl %edi
    pushl %ebx
    movl 16(%esp), %esi
    movzwl 0x00020004, %eax
    movzwl 0x00020006, %ecx
    cmpl %ecx, %eax
    jae .Lcreate_full
    imull $48, %eax, %eax
    addl $0x00020010, %eax
    movl %eax, %edi
    movl %edi, %ebx
    xorl %eax, %eax
    movl $12, %ecx
    rep stosl
    movl %ebx, %edi
    movl $31, %ecx
.Lcreate_copy:
    lodsb
    stosb
    testb %al, %al
    jz .Lcreate_type
    decl %ecx
    jnz .Lcreate_copy
    movb $0, (%edi)
.Lcreate_type:
    movb $1, 32(%ebx)
    incw 0x00020004
    movl $1, %eax
    jmp .Lcreate_done
.Lcreate_full:
    movl $-2, %eax
.Lcreate_done:
    popl %ebx
    popl %edi
    popl %esi
    ret

.globl terminal_reboot
terminal_reboot:
    cli
.Lreboot_wait:
    movw $0x64, %dx
    inb %dx, %al
    testb $2, %al
    jnz .Lreboot_wait
    movb $0xfe, %al
    outb %al, %dx
    jmp terminal_halt

.globl terminal_halt
terminal_halt:
    cli
.Lterminal_halt_loop:
    hlt
    jmp .Lterminal_halt_loop

.globl __mlang_std_exceptions_push_frame
__mlang_std_exceptions_push_frame:
    xorl %eax, %eax
    ret
.globl __mlang_std_exceptions_frame_env
__mlang_std_exceptions_frame_env:
    movl $__mlang_boot_jmp_buffer, %eax
    ret
.globl _setjmp
_setjmp:
    xorl %eax, %eax
    ret
.globl __mlang_std_exceptions_pop_frame
__mlang_std_exceptions_pop_frame:
    ret
.globl __mlang_std_exceptions_rethrow_current
__mlang_std_exceptions_rethrow_current:
    jmp terminal_halt

.section .bss,\"aw\",@nobits
.balign 16
input_buffer:
    .skip 64
current_directory:
    .skip 32
resolved_path:
    .skip 32
parent_path:
    .skip 32
empty_file:
    .skip 1
__mlang_boot_jmp_buffer:
    .skip 256
");

extern fn serial_write(message: str8) -> void;
extern fn terminal_read_line() -> str8;
extern fn terminal_command_eq(actual: str8, expected: str8) -> i32;
extern fn terminal_command_prefix(actual: str8, prefix: str8) -> i32;
extern fn terminal_argument(command: str8, offset: i32) -> str8;
extern fn terminal_reboot() -> void;
extern fn terminal_halt() -> void;
extern fn fs_mount() -> i32;
extern fn fs_entry_count() -> i32;
extern fn fs_entry_path(index: i32) -> str8;
extern fn fs_entry_type(index: i32) -> i32;
extern fn fs_entry_data(index: i32) -> str8;
extern fn fs_pwd() -> str8;
extern fn fs_resolve(path: str8) -> str8;
extern fn fs_find(path: str8) -> i32;
extern fn fs_set_cwd(path: str8) -> void;
extern fn fs_basename(path: str8) -> str8;
extern fn fs_parent(path: str8) -> str8;
extern fn fs_is_direct_child(directory: str8, candidate: str8) -> i32;
extern fn fs_create_empty(path: str8) -> i32;

fn list_directory(request: str8) -> i32 {
    let directory: str8 = fs_resolve(request);
    let directory_index: i32 = fs_find(directory);
    if directory_index < 0 {
        return -1;
    }
    if fs_entry_type(directory_index) != 2 {
        return -2;
    }

    var index: i32 = 0;
    let count: i32 = fs_entry_count();
    while index < count {
        let path: str8 = fs_entry_path(index);
        if fs_is_direct_child(directory, path) == 1 {
            serial_write(fs_basename(path));
            if fs_entry_type(index) == 2 {
                serial_write("/");
            }
            serial_write("\r\n");
        }
        index = index + 1;
    }
    return 0;
}

fn cat_file(request: str8) -> i32 {
    let path: str8 = fs_resolve(request);
    let index: i32 = fs_find(path);
    if index < 0 {
        return -1;
    }
    if fs_entry_type(index) != 1 {
        return -2;
    }
    serial_write(fs_entry_data(index));
    return 0;
}

fn change_directory(request: str8) -> i32 {
    let path: str8 = fs_resolve(request);
    let index: i32 = fs_find(path);
    if index < 0 || fs_entry_type(index) != 2 {
        return 0;
    }
    fs_set_cwd(path);
    return 1;
}

fn touch_file(request: str8) -> i32 {
    let path: str8 = fs_resolve(request);
    if fs_find(path) >= 0 {
        return 0;
    }
    let parent: str8 = fs_parent(path);
    let parent_index: i32 = fs_find(parent);
    if parent_index < 0 || fs_entry_type(parent_index) != 2 {
        return -1;
    }
    return fs_create_empty(path);
}

fn terminal_main() -> i32 {
    serial_write("\r\nMLang virtual terminal\r\n");
    if fs_mount() == 1 {
        serial_write("Mounted writable MFS2 at /.\r\n");
    } else {
        serial_write("MFS2 mount failed.\r\n");
    }
    serial_write("Type 'help' for available commands.\r\n\r\n");

    while true {
        serial_write("mlang> ");
        let command: str8 = terminal_read_line();

        if terminal_command_eq(command, "help") == 1 {
            serial_write("help   show available commands\r\n");
            serial_write("about  show kernel information\r\n");
            serial_write("clear  clear the terminal\r\n");
            serial_write("pwd    print working directory\r\n");
            serial_write("ls     list a directory: ls [path]\r\n");
            serial_write("cd     change directory: cd <path>\r\n");
            serial_write("cat    print a file: cat <path>\r\n");
            serial_write("touch  create an empty file\r\n");
            serial_write("reboot restart the virtual machine\r\n");
            serial_write("halt   stop the virtual CPU\r\n");
        } else if terminal_command_eq(command, "about") == 1 {
            serial_write("MLang 32-bit protected-mode kernel loaded by BIOS.\r\n");
        } else if terminal_command_eq(command, "clear") == 1 {
            serial_write("\x1b[2J\x1b[H");
        } else if terminal_command_eq(command, "pwd") == 1 {
            serial_write(fs_pwd());
            serial_write("\r\n");
        } else if terminal_command_eq(command, "ls") == 1 {
            let _ = list_directory(fs_pwd());
        } else if terminal_command_prefix(command, "ls ") == 1 {
            let result: i32 = list_directory(terminal_argument(command, 3));
            if result == -1 {
                serial_write("ls: directory not found\r\n");
            } else if result == -2 {
                serial_write("ls: not a directory\r\n");
            }
        } else if terminal_command_eq(command, "cd") == 1 {
            serial_write("usage: cd <directory>\r\n");
        } else if terminal_command_prefix(command, "cd ") == 1 {
            if change_directory(terminal_argument(command, 3)) != 1 {
                serial_write("cd: directory not found\r\n");
            }
        } else if terminal_command_eq(command, "cat") == 1 {
            serial_write("usage: cat <file>\r\n");
        } else if terminal_command_prefix(command, "cat ") == 1 {
            let result: i32 = cat_file(terminal_argument(command, 4));
            if result == -1 {
                serial_write("cat: file not found\r\n");
            } else if result == -2 {
                serial_write("cat: is a directory\r\n");
            }
        } else if terminal_command_eq(command, "touch") == 1 {
            serial_write("usage: touch <file>\r\n");
        } else if terminal_command_prefix(command, "touch ") == 1 {
            let result: i32 = touch_file(terminal_argument(command, 6));
            if result == 0 {
                serial_write("touch: file already exists\r\n");
            } else if result == -1 {
                serial_write("touch: parent directory not found\r\n");
            } else if result == -2 {
                serial_write("touch: filesystem directory is full\r\n");
            }
        } else if terminal_command_eq(command, "reboot") == 1 {
            serial_write("Rebooting...\r\n");
            terminal_reboot();
        } else if terminal_command_eq(command, "halt") == 1 {
            serial_write("CPU halted.\r\n");
            terminal_halt();
        } else if terminal_command_eq(command, "") != 1 {
            serial_write("Unknown command. Type 'help'.\r\n");
        }
    }

    return 0;
}
