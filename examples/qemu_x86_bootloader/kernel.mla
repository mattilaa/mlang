.section .rodata,\"a\",@progbits
ansi_empty:
    .asciz \"\"
ansi_reset:
    .asciz \"\\033[0m\"
ansi_inverse:
    .asciz \"\\033[7m\"
ansi_home:
    .asciz \"\\033[H\"
ansi_clear:
    .asciz \"\\033[2J\"
ansi_clear_line:
    .asciz \"\\033[2K\"
ansi_hide:
    .asciz \"\\033[?25l\"
ansi_show:
    .asciz \"\\033[?25h\"
ansi_save:
    .asciz \"\\033[s\"
ansi_restore:
    .asciz \"\\033[u\"
ansi_size_query:
    .asciz \"\\033[99;99H\\033[6n\"

.section .bss,\"aw\",@nobits
.balign 16
input_buffer:
    .skip 64
current_directory:
    .skip 32
current_user_id:
    .skip 1
.balign 4
resolved_path:
    .skip 32
parent_path:
    .skip 32
joined_path:
    .skip 32
network_mac:
    .skip 6
editor_length:
    .skip 4
editor_command_length:
    .skip 4
editor_command_buffer:
    .skip 64
pending_key:
    .skip 4
pending_key_valid:
    .skip 4
pending_cr:
    .skip 4
terminal_row_count:
    .skip 4
terminal_column_count:
    .skip 4
ansi_position:
    .skip 12
__mlang_boot_jmp_buffer:
    .skip 256
");

