// math.mla
pub fn add(a: int, b: int) -> int {
    return helper(a, b);
}

fn helper(a: int, b: int) -> int {  // private - can't be used outside this module
    return a + b;
}

struct InternalData {  // private struct
    var value: int;
};

pub fn subtract(a: int, b: int) -> int {
    return a - b;
}

pub fn multiply(a: int, b: int) -> int {
    return a * b;
}

pub fn square(x: int) -> int {
    return x * x;
}

pub fn sum_range(start: int, end: int) -> int {
    var total: int = 0;
    for i in start..end {
        total = total + i;
    }
    return total;
}

pub fn factorial(n: int) -> int {
    var result: int = 1;
    for i in 1..n + 1 {
        result = result * i;
    }
    return result;
}
