                                if is_custom == 1 {
                                    let _ = __mlang_std_unordered_map_i64_i64_insert(pat_cell_active_map_h, key, 1);
                                    if edit_sub_pattern == 0 {
                                        let old_v: i64 = __mlang_std_unordered_map_i64_i64_get_or(pat_note_map_h, key, 0);
                                        let _ = __mlang_std_unordered_map_i64_i64_insert(pat_note_map_h, key, old_v >= 127 ? 0 : (old_v + 1));
