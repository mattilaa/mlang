                                    let _ = __mlang_std_unordered_map_i64_i64_insert(ev_val1_map_h, key, old_v + 1);
                                }
                                if edit_col_event == 4 {
                                    let old_v: i64 = __mlang_std_unordered_map_i64_i64_get_or(ev_val2_map_h, key, 0);
                                    let _ = __mlang_std_unordered_map_i64_i64_insert(ev_val2_map_h, key, old_v + 1);
                                }
                                if edit_col_event == 5 {
                                    let old_v: i64 = __mlang_std_unordered_map_i64_i64_get_or(ev_mod_map_h, key, 0);
                                    let _ = __mlang_std_unordered_map_i64_i64_insert(ev_mod_map_h, key, old_v + 1);
