                                let c0: i64 = event_count_for_step(active_pattern, step_idx, ev_count_map_h, pat_custom_map_h);
                                let _ = __mlang_std_unordered_map_i64_i64_insert(ev_count_map_h, event_count_key(active_pattern, step_idx), c0 + 1);
