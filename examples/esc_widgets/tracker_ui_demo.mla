                            }
                            current_view = next_view;
                            // Prevent cross-view "stuck in edit" behavior.
                            edit_mode = 0;
                            cursor_row = map_row_between_views(cursor_row, old_view, current_view, active_pattern, pattern_steps_list, ev_count_map_h, pat_custom_map_h);
                            seq_offset = 0;
