mod std::esc;
mod std::event_loop;
mod std::io;
mod std::strbuf;
mod std::sync;
mod std::term;
mod widgets;

use std::esc::cmd_clear_screen;
use std::esc::cmd_home;
use std::esc::cmd_hide;
use std::esc::cmd_show;
use std::esc::cursor;
use std::esc::alt_screen_off;
use std::esc::alt_screen_on;
use std::esc::reset;
use std::event_loop::EventLoop;
use std::io::Stdin;
use std::io::read_keycode_nonblocking;
use std::io::stdin;
use std::io::stdout;
use std::io::write;
use std::strbuf::concat;
use std::strbuf::free;
use std::term::TermSize;
use std::term::stdin_enable_raw;
use std::term::stdin_is_tty;
use std::term::stdin_restore;
use std::term::stdout_size;
use std::sync::__mlang_std_sync_lfqueue_close;
use std::sync::__mlang_std_sync_lfqueue_free;
use std::sync::__mlang_std_sync_lfqueue_new;
use std::sync::__mlang_std_sync_lfqueue_try_recv;
use widgets::render_tracker_ui;

fn canvas_width(cols: i32) -> i64 {
    let w: i64 = cols - 4;
    if w < 40 {
        return 40;
    }
    return w > 150 ? 150 : w;
}

fn visible_grid_rows(term_rows: i32) -> i64 {
    let rows: i64 = term_rows < 12 ? 12 : term_rows;
    let raw: i64 = rows - 11;
    return raw < 4 ? 4 : raw;
}

fn max_i64(a: i64, b: i64) -> i64 {
    return a > b ? a : b;
}

fn min_i64(a: i64, b: i64) -> i64 {
    return a < b ? a : b;
}

fn view_pattern() -> i64 { return 0; }
fn view_event() -> i64 { return 1; }
fn view_song() -> i64 { return 2; }

fn song_order_len() -> i64 {
    return 64;
}

fn event_count_for_step(pattern_id: i64, step: i64) -> i64 {
    // Deterministic test data: 1..3 events per pattern step.
    return 1 + ((step + pattern_id) % 3);
}

fn event_total_rows(pattern_id: i64) -> i64 {
    let steps: i64 = pattern_steps(pattern_id);
    var total: i64 = 0;
    for s in 0..steps {
        total = total + event_count_for_step(pattern_id, s);
    }
    return total;
}

fn step_to_event_row(pattern_id: i64, step: i64) -> i64 {
    var row: i64 = 0;
    for s in 0..step {
        row = row + event_count_for_step(pattern_id, s);
    }
    return row;
}

fn event_row_to_step(pattern_id: i64, event_row: i64) -> i64 {
    let steps: i64 = pattern_steps(pattern_id);
    var row: i64 = event_row;
    var s: i64 = 0;
    while s < steps {
        let c: i64 = event_count_for_step(pattern_id, s);
        if row < c {
            return s;
        }
        row = row - c;
        s = s + 1;
    }
    return steps - 1;
}

fn map_row_between_views(row: i64, from_view: i64, to_view: i64, active_pattern: i64) -> i64 {
    if from_view == to_view {
        return row;
    }
    if from_view == view_pattern() && to_view == view_event() {
        return step_to_event_row(active_pattern, row);
    }
    if from_view == view_event() && to_view == view_pattern() {
        return event_row_to_step(active_pattern, row);
    }
    // Song view uses order rows, so switching to/from it starts at row 0.
    return 0;
}

fn view_len(view: i64, active_pattern: i64) -> i64 {
    if view == view_event() { return event_total_rows(active_pattern); }
    if view == view_song() { return song_order_len(); }
    return pattern_steps(active_pattern);
}

fn pattern_steps(pattern_id: i64) -> i64 {
    let steps: list<i64> = [64, 48, 96, 32];
    return steps[pattern_id % steps.len()];
}

fn song_pattern_at(order_row: i64) -> i64 {
    let order: list<i64> = [0, 1, 2, 1, 3, 2, 0, 3, 1, 2, 0, 1, 3, 0, 2, 3];
    return order[order_row % order.len()];
}

fn clamp_view_offset(seq_offset_in: i64, cursor_row: i64, visible: i64, seq_len: i64) -> i64 {
    var seq_offset: i64 = seq_offset_in;
    if cursor_row < seq_offset {
        seq_offset = cursor_row;
    }
    if cursor_row >= seq_offset + visible {
        seq_offset = cursor_row - visible + 1;
    }
    let max_off: i64 = max_i64(0, seq_len - visible);
    if seq_offset < 0 {
        seq_offset = 0;
    }
    if seq_offset > max_off {
        seq_offset = max_off;
    }
    return seq_offset;
}

fn menu_item_count(focus_idx: i64) -> i64 {
    let _ = focus_idx;
    return 6;
}

fn menu_name(focus_idx: i64) -> string {
    if focus_idx == 0 { return format!("{}", "File"); }
    if focus_idx == 1 { return format!("{}", "View"); }
    if focus_idx == 2 { return format!("{}", "Edit"); }
    return format!("{}", "Help");
}

fn menu_item_name(focus_idx: i64, item_idx: i64) -> string {
    if focus_idx == 0 {
        if item_idx == 0 { return format!("{}", "New"); }
        if item_idx == 1 { return format!("{}", "Open"); }
        if item_idx == 2 { return format!("{}", "Save"); }
        if item_idx == 3 { return format!("{}", "Export"); }
        if item_idx == 4 { return format!("{}", "Close"); }
        return format!("{}", "Quit");
    }
    if focus_idx == 1 {
        if item_idx == 0 { return format!("{}", "Pattern"); }
        if item_idx == 1 { return format!("{}", "Event view"); }
        if item_idx == 2 { return format!("{}", "Song view"); }
        if item_idx == 3 { return format!("{}", "Mixer"); }
        if item_idx == 4 { return format!("{}", "Scope"); }
        return format!("{}", "FFT");
    }
    if focus_idx == 2 {
        if item_idx == 0 { return format!("{}", "Cut"); }
        if item_idx == 1 { return format!("{}", "Copy"); }
        if item_idx == 2 { return format!("{}", "Paste"); }
        if item_idx == 3 { return format!("{}", "Transpose"); }
        if item_idx == 4 { return format!("{}", "Quantize"); }
        return format!("{}", "Clear");
    }
    if item_idx == 0 { return format!("{}", "Keys"); }
    if item_idx == 1 { return format!("{}", "About"); }
    if item_idx == 2 { return format!("{}", "License"); }
    if item_idx == 3 { return format!("{}", "Docs"); }
    if item_idx == 4 { return format!("{}", "Version"); }
    return format!("{}", "System");
}

fn main() -> i32 {
    let input: Stdin = stdin();
    let out = stdout();
    var raw_enabled: i32 = 0;
    if stdin_is_tty() == 1 {
        if stdin_enable_raw() == 0 {
            raw_enabled = 1;
        }
    }

    let qh: i64 = __mlang_std_sync_lfqueue_new(128);
    if qh == 0 {
        println!("queue init failed");
        if raw_enabled == 1 { stdin_restore(); }
        return 1;
    }

    let loop_r: Result<EventLoop, string> = EventLoop::start(qh, 30, "tick");
    if loop_r.is_err() {
        println!("event loop init failed: {}", loop_r.unwrap_err());
        __mlang_std_sync_lfqueue_free(qh);
        if raw_enabled == 1 { stdin_restore(); }
        return 1;
    }
    let ticker: EventLoop = loop_r.unwrap();

    let ev_buf: string = String::with_capacity(32);
    var cursor_row: i64 = 0;
    var seq_offset: i64 = 0;
    var current_view: i64 = view_pattern();
    var active_pattern: i64 = 0;
    let bpm: i64 = 120;
    let steps_per_beat: i64 = 4;
    let tick_hz: i64 = 30;
    var row_phase: i64 = 0;
    var quit: i32 = 0;
    var running: i32 = 0;
    var focus_idx: i64 = 0;
    var edit_mode: i32 = 0;
    var edit_col_pattern: i64 = 1;
    var edit_sub_pattern: i64 = 0;
    var edit_col_event: i64 = 2;
    var pat_note_off0: i64 = 0;
    var pat_note_off1: i64 = 0;
    var pat_note_off2: i64 = 0;
    var pat_note_off3: i64 = 0;
    var pat_v1_off0: i64 = 0;
    var pat_v1_off1: i64 = 0;
    var pat_v1_off2: i64 = 0;
    var pat_v1_off3: i64 = 0;
    var pat_v2_off0: i64 = 0;
    var pat_v2_off1: i64 = 0;
    var pat_v2_off2: i64 = 0;
    var pat_v2_off3: i64 = 0;
    var ev_off_event: i64 = 0;
    var ev_off_val1: i64 = 0;
    var ev_off_val2: i64 = 0;
    var ev_off_mod: i64 = 0;
    var ev_off_m1: i64 = 0;
    var ev_off_m2: i64 = 0;
    var open_menu: i32 = 0;
    var menu_sel: i64 = 0;
    var esc_mode: i32 = 0;
    var csi_num: i64 = 0;
    var last_action: string = format!("{}", "(none)");

    print!("{}{}{}{}", alt_screen_on(), cursor(cmd_hide()), cursor(cmd_home()), cursor(cmd_clear_screen()));
    while quit == 0 {
        let n: i64 = __mlang_std_sync_lfqueue_try_recv(qh, ev_buf, 32);
        if n == -2 {
            continue;
        }
        if n <= 0 {
            continue;
        }

        while 1 {
            let keycode: i32 = read_keycode_nonblocking(input);
            if keycode == -2 {
                break;
            }
            if keycode < 0 {
                break;
            }

            if esc_mode == 0 {
                if keycode == 27 {
                    // Peek one byte so Shift+Tab/F-keys are not mistaken for plain ESC.
                    let keycode2: i32 = read_keycode_nonblocking(stdin());
                    if keycode2 == 91 {
                        esc_mode = 2;
                        csi_num = 0;
                    } else if keycode2 == 79 {
                        esc_mode = 3;
                    } else if keycode2 == -2 {
                        if open_menu == 1 {
                            open_menu = 0;
                            menu_sel = 0;
                            focus_idx = 0;
                        } else if edit_mode != 0 {
                            if current_view == view_pattern() {
                                edit_mode = edit_mode - 1;
                            } else {
                                edit_mode = 0;
                            }
                        } else {
                            esc_mode = 1;
                            csi_num = 0;
                        }
                    } else {
                        if open_menu == 1 {
                            open_menu = 0;
                            menu_sel = 0;
                            focus_idx = 0;
                        } else if edit_mode != 0 {
                            if current_view == view_pattern() {
                                edit_mode = edit_mode - 1;
                            } else {
                                edit_mode = 0;
                            }
                        }
                        esc_mode = 0;
                    }
                } else {
                    if keycode == 113 || keycode == 81 {
                        quit = 1;
                    }
                    if keycode == 32 {
                        running = running == 1 ? 0 : 1;
                        row_phase = 0;
                    }
                    if keycode == 9 {
                        if open_menu == 0 {
                            focus_idx = 0;
                            open_menu = 1;
                            menu_sel = 0;
                        } else {
                            focus_idx = (focus_idx + 1) % 4;
                            menu_sel = 0;
                        }
                    }
                    if keycode == 49 {
                        focus_idx = 0;
                        open_menu = 1;
                        menu_sel = 0;
                    }
                    if keycode == 50 {
                        focus_idx = 1;
                        open_menu = 1;
                        menu_sel = 0;
                    }
                    if keycode == 51 {
                        focus_idx = 2;
                        open_menu = 1;
                        menu_sel = 0;
                    }
                    if keycode == 52 {
                        focus_idx = 3;
                        open_menu = 1;
                        menu_sel = 0;
                    }
                    if keycode == 102 || keycode == 70 {
                        focus_idx = 0;
                        open_menu = 1;
                        menu_sel = 0;
                    }
                    if keycode == 118 || keycode == 86 {
                        focus_idx = 1;
                        open_menu = 1;
                        menu_sel = 0;
                    }
                    if keycode == 101 || keycode == 69 {
                        focus_idx = 2;
                        open_menu = 1;
                        menu_sel = 0;
                    }
                    if keycode == 13 || keycode == 10 {
                        if open_menu == 1 {
                            let old_view: i64 = current_view;
                            var next_view: i64 = current_view;
                            let mname: string = menu_name(focus_idx);
                            let iname: string = menu_item_name(focus_idx, menu_sel);
                            let action: string = format!("{} -> {}", mname, iname);
                            if focus_idx == 1 {
                                if menu_sel == 0 {
                                    if old_view == view_song() {
                                        active_pattern = song_pattern_at(cursor_row);
                                    }
                                    next_view = view_pattern();
                                } else if menu_sel == 1 {
                                    if old_view == view_song() {
                                        active_pattern = song_pattern_at(cursor_row);
                                    }
                                    next_view = view_event();
                                } else if menu_sel == 2 {
                                    next_view = view_song();
                                }
                            }
                            current_view = next_view;
                            cursor_row = map_row_between_views(cursor_row, old_view, current_view, active_pattern);
                            seq_offset = 0;
                            free(mname);
                            free(iname);
                            free(last_action);
                            last_action = action;
                            open_menu = 0;
                        } else {
                            if edit_mode == 0 {
                                edit_mode = 1;
                            } else if edit_mode == 1 {
                                edit_mode = 2;
                            } else {
                                edit_mode = 2;
                            }
                            if edit_mode != 0 && current_view == view_pattern() {
                                edit_sub_pattern = 0;
                            }
                        }
                    }
                    if keycode == 106 || keycode == 74 {
                        if open_menu == 1 {
                            let count: i64 = menu_item_count(focus_idx);
                            menu_sel = (menu_sel + 1) % count;
                        } else if edit_mode == 2 {
                            if current_view == view_pattern() {
                                if edit_col_pattern == 1 {
                                    if edit_sub_pattern == 0 { pat_note_off0 = pat_note_off0 + 1; }
                                    if edit_sub_pattern == 1 { pat_v1_off0 = pat_v1_off0 + 1; }
                                    if edit_sub_pattern == 2 { pat_v2_off0 = pat_v2_off0 + 1; }
                                }
                                if edit_col_pattern == 2 {
                                    if edit_sub_pattern == 0 { pat_note_off1 = pat_note_off1 + 1; }
                                    if edit_sub_pattern == 1 { pat_v1_off1 = pat_v1_off1 + 1; }
                                    if edit_sub_pattern == 2 { pat_v2_off1 = pat_v2_off1 + 1; }
                                }
                                if edit_col_pattern == 3 {
                                    if edit_sub_pattern == 0 { pat_note_off2 = pat_note_off2 + 1; }
                                    if edit_sub_pattern == 1 { pat_v1_off2 = pat_v1_off2 + 1; }
                                    if edit_sub_pattern == 2 { pat_v2_off2 = pat_v2_off2 + 1; }
                                }
                                if edit_col_pattern == 4 {
                                    if edit_sub_pattern == 0 { pat_note_off3 = pat_note_off3 + 1; }
                                    if edit_sub_pattern == 1 { pat_v1_off3 = pat_v1_off3 + 1; }
                                    if edit_sub_pattern == 2 { pat_v2_off3 = pat_v2_off3 + 1; }
                                }
                            } else if current_view == view_event() {
                                if edit_col_event == 2 { ev_off_event = ev_off_event + 1; }
                                if edit_col_event == 3 { ev_off_val1 = ev_off_val1 + 1; }
                                if edit_col_event == 4 { ev_off_val2 = ev_off_val2 + 1; }
                                if edit_col_event == 5 { ev_off_mod = ev_off_mod + 1; }
                                if edit_col_event == 6 { ev_off_m1 = ev_off_m1 + 1; }
                                if edit_col_event == 7 { ev_off_m2 = ev_off_m2 + 1; }
                            }
                        } else if running == 0 {
                            let nrows: i64 = view_len(current_view, active_pattern);
                            cursor_row = min_i64(nrows - 1, cursor_row + 1);
                        }
                    }
                    if keycode == 107 || keycode == 75 {
                        if open_menu == 1 {
                            let count: i64 = menu_item_count(focus_idx);
                            menu_sel = menu_sel == 0 ? (count - 1) : (menu_sel - 1);
                        } else if edit_mode == 2 {
                            if current_view == view_pattern() {
                                if edit_col_pattern == 1 {
                                    if edit_sub_pattern == 0 { pat_note_off0 = pat_note_off0 - 1; }
                                    if edit_sub_pattern == 1 { pat_v1_off0 = pat_v1_off0 - 1; }
                                    if edit_sub_pattern == 2 { pat_v2_off0 = pat_v2_off0 - 1; }
                                }
                                if edit_col_pattern == 2 {
                                    if edit_sub_pattern == 0 { pat_note_off1 = pat_note_off1 - 1; }
                                    if edit_sub_pattern == 1 { pat_v1_off1 = pat_v1_off1 - 1; }
                                    if edit_sub_pattern == 2 { pat_v2_off1 = pat_v2_off1 - 1; }
                                }
                                if edit_col_pattern == 3 {
                                    if edit_sub_pattern == 0 { pat_note_off2 = pat_note_off2 - 1; }
                                    if edit_sub_pattern == 1 { pat_v1_off2 = pat_v1_off2 - 1; }
                                    if edit_sub_pattern == 2 { pat_v2_off2 = pat_v2_off2 - 1; }
                                }
                                if edit_col_pattern == 4 {
                                    if edit_sub_pattern == 0 { pat_note_off3 = pat_note_off3 - 1; }
                                    if edit_sub_pattern == 1 { pat_v1_off3 = pat_v1_off3 - 1; }
                                    if edit_sub_pattern == 2 { pat_v2_off3 = pat_v2_off3 - 1; }
                                }
                            } else if current_view == view_event() {
                                if edit_col_event == 2 { ev_off_event = ev_off_event - 1; }
                                if edit_col_event == 3 { ev_off_val1 = ev_off_val1 - 1; }
                                if edit_col_event == 4 { ev_off_val2 = ev_off_val2 - 1; }
                                if edit_col_event == 5 { ev_off_mod = ev_off_mod - 1; }
                                if edit_col_event == 6 { ev_off_m1 = ev_off_m1 - 1; }
                                if edit_col_event == 7 { ev_off_m2 = ev_off_m2 - 1; }
                            }
                        } else if running == 0 {
                            cursor_row = max_i64(0, cursor_row - 1);
                        }
                    }
                    if keycode == 108 || keycode == 76 {
                        if open_menu == 0 {
                            if edit_mode == 0 && current_view == view_pattern() {
                                edit_col_pattern = edit_col_pattern == 4 ? 1 : (edit_col_pattern + 1);
                            } else if edit_mode == 1 && current_view == view_pattern() {
                                edit_sub_pattern = (edit_sub_pattern + 1) % 3;
                            } else if (edit_mode == 0 || edit_mode == 1) && current_view == view_event() {
                                edit_col_event = edit_col_event == 7 ? 2 : (edit_col_event + 1);
                            }
                        }
                    }
                    if keycode == 104 || keycode == 72 {
                        if open_menu == 0 {
                            if edit_mode == 0 && current_view == view_pattern() {
                                edit_col_pattern = edit_col_pattern == 1 ? 4 : (edit_col_pattern - 1);
                            } else if edit_mode == 1 && current_view == view_pattern() {
                                edit_sub_pattern = edit_sub_pattern == 0 ? 2 : (edit_sub_pattern - 1);
                            } else if (edit_mode == 0 || edit_mode == 1) && current_view == view_event() {
                                edit_col_event = edit_col_event == 2 ? 7 : (edit_col_event - 1);
                            }
                        }
                    }
                    if keycode == 119 || keycode == 87 {
                        if open_menu == 0 && edit_mode == 1 {
                            if current_view == view_event() {
                                edit_col_event = edit_col_event == 7 ? 2 : (edit_col_event + 1);
                            }
                        }
                    }
                    if keycode == 98 || keycode == 66 {
                        if open_menu == 0 && edit_mode == 1 {
                            if current_view == view_event() {
                                edit_col_event = edit_col_event == 2 ? 7 : (edit_col_event - 1);
                            }
                        }
                    }
                }
            } else if esc_mode == 1 {
                if keycode == 91 {
                    esc_mode = 2;
                    csi_num = 0;
                } else if keycode == 79 {
                    esc_mode = 3;
                } else {
                    // Plain ESC closes the dropdown if open.
                    open_menu = 0;
                    menu_sel = 0;
                    focus_idx = 0;
                    if edit_mode != 0 {
                        if current_view == view_pattern() {
                            edit_mode = edit_mode - 1;
                        } else {
                            edit_mode = 0;
                        }
                    }
                    esc_mode = 0;
                }
            } else if esc_mode == 2 {
                if keycode >= 48 && keycode <= 57 {
                    csi_num = csi_num * 10 + (keycode - 48);
                } else if keycode == 90 {
                    // CSI Z = Shift+Tab
                    focus_idx = focus_idx == 0 ? 3 : (focus_idx - 1);
                    open_menu = 1;
                    menu_sel = 0;
                    esc_mode = 0;
                } else if keycode == 126 {
                    if csi_num >= 11 && csi_num <= 14 {
                        focus_idx = csi_num - 11;
                        open_menu = 1;
                        menu_sel = 0;
                    }
                    esc_mode = 0;
                } else {
                    esc_mode = 0;
                }
            } else {
                if keycode == 80 {
                    focus_idx = 0;
                    open_menu = 1;
                    menu_sel = 0;
                } else if keycode == 81 {
                    focus_idx = 1;
                    open_menu = 1;
                    menu_sel = 0;
                } else if keycode == 82 {
                    focus_idx = 2;
                    open_menu = 1;
                    menu_sel = 0;
                } else if keycode == 83 {
                    focus_idx = 3;
                    open_menu = 1;
                    menu_sel = 0;
                }
                esc_mode = 0;
            }
        }

        let ts: TermSize = stdout_size();
        let w: i64 = canvas_width(ts.cols);
        let h: i64 = ts.rows;
        let visible: i64 = visible_grid_rows(ts.rows);
        let pat_id: i64 = current_view == view_song() ? song_pattern_at(cursor_row) : active_pattern;
        let steps_pp: i64 = pattern_steps(pat_id);
        let nrows: i64 = view_len(current_view, active_pattern);
        if cursor_row >= nrows {
            cursor_row = nrows - 1;
        }
        seq_offset = clamp_view_offset(seq_offset, cursor_row, visible, nrows);
        let frame: string = render_tracker_ui(
            w, h,
            cursor_row, seq_offset, nrows,
            current_view, bpm, steps_pp, active_pattern,
            edit_col_pattern, edit_sub_pattern, edit_col_event,
            pat_note_off0, pat_note_off1, pat_note_off2, pat_note_off3,
            pat_v1_off0, pat_v1_off1, pat_v1_off2, pat_v1_off3,
            pat_v2_off0, pat_v2_off1, pat_v2_off2, pat_v2_off3,
            ev_off_event, ev_off_val1, ev_off_val2, ev_off_mod, ev_off_m1, ev_off_m2,
            running, focus_idx, edit_mode, open_menu, menu_sel, last_action);
        let clear_home: string = format!("{}{}", cursor(cmd_home()), cursor(cmd_clear_screen()));
        let payload: string = concat(clear_home, frame);
        write(out, payload);
        free(payload);
        free(clear_home);
        free(frame);
        if running == 1 {
            row_phase = row_phase + (bpm * steps_per_beat);
            while row_phase >= (60 * tick_hz) {
                let nrows_run: i64 = view_len(current_view, active_pattern);
                if current_view == view_event() {
                    let cur_step: i64 = event_row_to_step(active_pattern, cursor_row);
                    let next_step: i64 = (cur_step + 1) % pattern_steps(active_pattern);
                    cursor_row = step_to_event_row(active_pattern, next_step);
                } else {
                    cursor_row = (cursor_row + 1) % nrows_run;
                }
                row_phase = row_phase - (60 * tick_hz);
            }
        }
    }

    String::free(ev_buf);
    String::free(last_action);
    ticker.close();
    __mlang_std_sync_lfqueue_close(qh);
    __mlang_std_sync_lfqueue_free(qh);
    if raw_enabled == 1 { stdin_restore(); }
    print!("{}{}{}{}\n", reset(), cursor(cmd_show()), cursor(cmd_home()), alt_screen_off());
    return 0;
}
