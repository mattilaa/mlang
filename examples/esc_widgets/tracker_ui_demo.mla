                                    let b1: i64 = song_bpm_wrap(b0 - 1);
                                    song_bpm = song_set_at(song_bpm, cursor_row, b1);
                                }
                            }
                        }
                    }
                    if keycode == std::ascii::AsciiKey::LowerK {
                        if open_menu == 1 {
                            let count: i64 = menu_item_count(focus_idx);
                            menu_sel = menu_sel == 0 ? (count - 1) : (menu_sel - 1);
