                            let first_pat: i64 = song_order.len() > 0 ? song_order[0] : 0;
                            let first_bpm: i64 = song_bpm.len() > 0 ? song_bpm[0] : 120;
                            song_order = song_insert_at(song_order, cursor_row, first_pat);
                            song_bpm = song_insert_at(song_bpm, cursor_row, first_bpm);
                            active_pattern = song_pattern_at(song_order, cursor_row);
