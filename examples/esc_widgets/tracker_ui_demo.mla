                } else if keycode == std::ascii::AsciiKey::UpperQ {
                    focus_idx = 1;
                    open_menu = 1;
                    menu_sel = 0;
                } else if keycode == std::ascii::AsciiKey::UpperR {
                    focus_idx = 2;
                    open_menu = 1;
                    menu_sel = 0;
                } else if keycode == std::ascii::AsciiKey::UpperS {
                    focus_idx = 3;
                    open_menu = 1;
                    menu_sel = 0;
                }
                esc_mode = 0;
            }
        }

        let ts: TermSize = stdout_size();
        let w: i64 = canvas_width(ts.cols);
        let h: i64 = ts.rows;
        let visible: i64 = visible_grid_rows(ts.rows, current_view);
        let pat_id: i64 = current_view == view_song() ? song_pattern_at(song_order, cursor_row) : active_pattern;
        let steps_pp: i64 = pattern_steps(pat_id, pattern_steps_list);
        let nrows: i64 = view_len(current_view, active_pattern, song_order, pattern_steps_list, ev_count_map_h, pat_custom_map_h);
        if cursor_row >= nrows {
            cursor_row = nrows - 1;
        }
        if nrows <= 0 {
            cursor_row = 0;
        }
        let header_pattern: i64 = running == 1 ? active_pattern : pat_id;
        let song_pos: i64 = running == 1 ? play_song_row : (current_view == view_song() ? cursor_row : find_song_row_for_pattern(song_order, pat_id));
        let header_bpm: i64 = running == 1 ? song_bpm_at(song_bpm, play_song_row) : song_bpm_at(song_bpm, song_pos);
        let transport_step: i64 = running == 1
            ? play_step
            : (current_view == view_pattern()
                ? (cursor_row % steps_pp)
                : (current_view == view_event()
                    ? event_row_to_step(pat_id, cursor_row, pattern_steps_list, ev_count_map_h, pat_custom_map_h)
                    : 0));
        let play_event_row: i64 = step_to_event_row(active_pattern, transport_step, ev_count_map_h, pat_custom_map_h);
        var view_anchor_row: i64 = cursor_row;
        if current_view == view_event() && running == 1 && edit_mode == 0 {
            view_anchor_row = play_event_row;
        }
        seq_offset = clamp_view_offset(seq_offset, view_anchor_row, visible, nrows);
        let frame: string = render_tracker_ui(
            w, h,
            cursor_row, seq_offset, nrows,
            current_view, header_bpm, steps_pp, active_pattern,
            song_order, song_bpm, song_pos, header_pattern, transport_step, loop_song_row,
            edit_col_pattern, edit_sub_pattern, edit_col_event, edit_col_song,
            pat_note_map_h, pat_v1_map_h, pat_v2_map_h, pat_custom_map_h, pat_cell_active_map_h,
            ev_event_map_h, ev_val1_map_h, ev_val2_map_h, ev_mod_map_h, ev_m1_map_h, ev_m2_map_h,
            ev_count_map_h, pattern_steps_list,
            pat_edit_row, pat_edit_col,
            pat_note_off0, pat_note_off1, pat_note_off2, pat_note_off3,
            pat_v1_off0, pat_v1_off1, pat_v1_off2, pat_v1_off3,
            pat_v2_off0, pat_v2_off1, pat_v2_off2, pat_v2_off3,
            ev_off_event, ev_off_val1, ev_off_val2, ev_off_mod, ev_off_m1, ev_off_m2,
            running, focus_idx, edit_mode, open_menu, menu_sel,
            modal_open, modal_title, modal_body, modal_ok_selected, last_action);
        let clear_home: string = format!("{}{}", cursor(cmd_home()), cursor(cmd_clear_screen()));
        let payload: string = concat(clear_home, frame);
        write(out, payload);
        free(payload);
        free(clear_home);
        free(frame);
        if running == 1 {
            let bpm_run: i64 = song_bpm_at(song_bpm, play_song_row);
            row_phase = row_phase + (bpm_run * steps_per_beat);
            while row_phase >= (60 * tick_hz) {
                let song_len: i64 = song_order.len();
                let song_pat: i64 = song_pattern_at(song_order, play_song_row);
                let song_steps: i64 = pattern_steps(song_pat, pattern_steps_list);
                play_step = play_step + 1;
                if play_step >= song_steps {
                    play_step = 0;
                    if loop_song_row >= 0 {
                        play_song_row = loop_song_row % song_len;
                    } else {
                        play_song_row = (play_song_row + 1) % song_len;
                    }
                } else {
                    if loop_song_row >= 0 {
                        play_song_row = loop_song_row % song_len;
                    } else {
                        play_song_row = play_song_row % song_len;
                    }
                }

                active_pattern = song_pattern_at(song_order, play_song_row);
                if current_view == view_song() {
                    cursor_row = play_song_row;
                } else if current_view == view_pattern() {
                    cursor_row = play_step % pattern_steps(active_pattern, pattern_steps_list);
                } else if current_view == view_event() {
                    // Keep event cursor user-controlled while running so
                    // columns/rows remain editable; playhead is rendered from
                    // transport_step.
                    let _ = 0;
                }
                row_phase = row_phase - (60 * tick_hz);
            }
        }
    }

    String::free(ev_buf);
    String::free(modal_title);
    String::free(modal_body);
    String::free(last_action);
    __mlang_std_unordered_map_i64_i64_free(pat_note_map_h);
    __mlang_std_unordered_map_i64_i64_free(pat_v1_map_h);
    __mlang_std_unordered_map_i64_i64_free(pat_v2_map_h);
    __mlang_std_unordered_map_i64_i64_free(pat_custom_map_h);
    __mlang_std_unordered_map_i64_i64_free(pat_cell_active_map_h);
    __mlang_std_unordered_map_i64_i64_free(ev_event_map_h);
    __mlang_std_unordered_map_i64_i64_free(ev_val1_map_h);
    __mlang_std_unordered_map_i64_i64_free(ev_val2_map_h);
    __mlang_std_unordered_map_i64_i64_free(ev_mod_map_h);
    __mlang_std_unordered_map_i64_i64_free(ev_m1_map_h);
    __mlang_std_unordered_map_i64_i64_free(ev_m2_map_h);
    __mlang_std_unordered_map_i64_i64_free(ev_count_map_h);
    ticker.close();
    __mlang_std_sync_lfqueue_close(qh);
    __mlang_std_sync_lfqueue_free(qh);
    if raw_enabled == 1 { stdin_restore(); }
    print!("{}{}{}{}\n", reset(), cursor(cmd_show()), cursor(cmd_home()), alt_screen_off());
    return 0;
}
