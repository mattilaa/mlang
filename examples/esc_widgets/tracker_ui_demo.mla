                            let action: string = format!("{} -> {}", mname, iname);
                            if focus_idx == 0 && menu_sel == 0 {
                                active_pattern = (active_pattern + 1) % pattern_steps_list.len();
                                pattern_steps_list = song_set_at(pattern_steps_list, active_pattern, 1);
                                let _ = __mlang_std_unordered_map_i64_i64_insert(pat_custom_map_h, active_pattern, 1);
                                for ch in 0..4 {
