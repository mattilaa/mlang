fn canvas_width(cols: i32) -> i64 {
    let w: i64 = cols - 4;
    if w < 40 {
        return 40;
    }
    return w > 150 ? 150 : w;
}

fn visible_grid_rows(term_rows: i32, current_view: i64) -> i64 {
    let rows: i64 = term_rows < 12 ? 12 : term_rows;
    let pattern_extra: i64 = current_view == view_pattern() ? 1 : 0;
    let raw: i64 = rows - 11 - pattern_extra;
    return raw < 4 ? 4 : raw;
}

fn max_i64(a: i64, b: i64) -> i64 {
    return a > b ? a : b;
}

fn min_i64(a: i64, b: i64) -> i64 {
    return a < b ? a : b;
}

fn view_pattern() -> i64 { return 0; }
fn view_event() -> i64 { return 1; }
fn view_song() -> i64 { return 2; }

fn pattern_steps(pattern_id: i64, pattern_steps_list: &list<i64>) -> i64 {
    if pattern_steps_list.len() == 0 {
        return 1;
    }
    let idx: i64 = pattern_id % pattern_steps_list.len();
    let s: i64 = pattern_steps_list[idx];
    return s < 1 ? 1 : s;
}

fn event_count_key(pattern_id: i64, step: i64) -> i64 {
    return pattern_id * 4096 + step;
}

fn pattern_cell_key(pattern_id: i64, row: i64, ch_idx: i64) -> i64 {
    return pattern_id * 65536 + row * 16 + ch_idx;
}

fn event_count_for_step(pattern_id: i64, step: i64,
                        ev_count_map_h: i64, pat_custom_map_h: i64) -> i64 {
    let k: i64 = event_count_key(pattern_id, step);
    let ov: i64 = __mlang_std_unordered_map_i64_i64_get_or(ev_count_map_h, k, -1);
    if ov >= 1 {
        return ov;
    }
    let is_custom: i64 = __mlang_std_unordered_map_i64_i64_get_or(pat_custom_map_h, pattern_id, 0);
    if is_custom == 1 {
        return 1;
    }
    return 1 + ((step + pattern_id) % 3);
}

fn event_total_rows(pattern_id: i64, pattern_steps_list: &list<i64>,
                    ev_count_map_h: i64, pat_custom_map_h: i64) -> i64 {
    let steps: i64 = pattern_steps(pattern_id, pattern_steps_list);
    var total: i64 = 0;
    for s in 0..steps {
        total = total + event_count_for_step(pattern_id, s, ev_count_map_h, pat_custom_map_h);
    }
    return total;
}

fn step_to_event_row(pattern_id: i64, step: i64,
                     ev_count_map_h: i64, pat_custom_map_h: i64) -> i64 {
    var row: i64 = 0;
    for s in 0..step {
        row = row + event_count_for_step(pattern_id, s, ev_count_map_h, pat_custom_map_h);
    }
    return row;
}

fn event_row_to_step(pattern_id: i64, event_row: i64, pattern_steps_list: &list<i64>,
                     ev_count_map_h: i64, pat_custom_map_h: i64) -> i64 {
    let steps: i64 = pattern_steps(pattern_id, pattern_steps_list);
    var row: i64 = event_row;
    var s: i64 = 0;
    while s < steps {
        let c: i64 = event_count_for_step(pattern_id, s, ev_count_map_h, pat_custom_map_h);
        if row < c {
            return s;
        }
        row = row - c;
        s = s + 1;
    }
    return steps - 1;
}

fn map_row_between_views(row: i64, from_view: i64, to_view: i64, active_pattern: i64,
                         pattern_steps_list: &list<i64>,
                         ev_count_map_h: i64, pat_custom_map_h: i64) -> i64 {
    if from_view == to_view {
        return row;
    }
    if from_view == view_pattern() && to_view == view_event() {
        return step_to_event_row(active_pattern, row, ev_count_map_h, pat_custom_map_h);
    }
    if from_view == view_event() && to_view == view_pattern() {
        return event_row_to_step(active_pattern, row, pattern_steps_list, ev_count_map_h, pat_custom_map_h);
    }
    // Song view uses order rows, so switching to/from it starts at row 0.
    return 0;
}

fn view_len(view: i64, active_pattern: i64, song_order: &list<i64>,
            pattern_steps_list: &list<i64>,
            ev_count_map_h: i64, pat_custom_map_h: i64) -> i64 {
    if view == view_event() { return event_total_rows(active_pattern, pattern_steps_list, ev_count_map_h, pat_custom_map_h); }
    if view == view_song() { return song_order.len(); }
    return pattern_steps(active_pattern, pattern_steps_list);
}

fn song_pattern_at(song_order: &list<i64>, order_row: i64) -> i64 {
    if song_order.len() == 0 {
        return 0;
    }
    return song_order[order_row % song_order.len()];
}

fn find_song_row_for_pattern(song_order: &list<i64>, pattern_id: i64) -> i64 {
    let total: i64 = song_order.len();
    for i in 0..total {
        if song_pattern_at(song_order, i) == pattern_id {
            return i;
        }
    }
    return 0;
}

fn song_insert_at(src: &list<i64>, idx_in: i64, pat: i64) -> list<i64> {
    var out: list<i64> = [];
    let n: i64 = src.len();
    var idx: i64 = idx_in;
    if idx < 0 { idx = 0; }
    if idx > n { idx = n; }
    for i in 0..idx {
        out.push(src[i]);
    }
    out.push(pat);
    for i in idx..n {
        out.push(src[i]);
    }
    return out;
}

fn song_set_at(src: &list<i64>, idx: i64, pat: i64) -> list<i64> {
    var out: list<i64> = [];
    let n: i64 = src.len();
    for i in 0..n {
        if i == idx {
            out.push(pat);
        } else {
            out.push(src[i]);
        }
    }
    return out;
}

fn song_bpm_at(song_bpm: &list<i64>, row: i64) -> i64 {
    if song_bpm.len() == 0 {
        return 120;
    }
    return song_bpm[row % song_bpm.len()];
}

fn song_bpm_wrap(v: i64) -> i64 {
    if v < 40 {
        return 220;
    }
    if v > 220 {
        return 40;
    }
    return v;
}

fn pattern_insert_row(pattern_id: i64, at_row: i64, current_steps: i64,
                      pat_custom_map_h: i64, pat_cell_active_map_h: i64,
                      pat_note_map_h: i64, pat_v1_map_h: i64, pat_v2_map_h: i64) -> i64 {
    let _ = __mlang_std_unordered_map_i64_i64_insert(pat_custom_map_h, pattern_id, 1);
    if current_steps >= 256 {
        return current_steps;
    }
    var idx: i64 = at_row;
    if idx < 0 { idx = 0; }
    if idx > current_steps { idx = current_steps; }
    var r: i64 = current_steps - 1;
    while r >= idx {
        for ch in 0..4 {
            let src_k: i64 = pattern_cell_key(pattern_id, r, ch);
            let dst_k: i64 = pattern_cell_key(pattern_id, r + 1, ch);
            let active: i64 = __mlang_std_unordered_map_i64_i64_get_or(pat_cell_active_map_h, src_k, 0);
            let _ = __mlang_std_unordered_map_i64_i64_insert(pat_cell_active_map_h, dst_k, active);
            if active == 1 {
                let n0: i64 = __mlang_std_unordered_map_i64_i64_get_or(pat_note_map_h, src_k, 0);
                let v10: i64 = __mlang_std_unordered_map_i64_i64_get_or(pat_v1_map_h, src_k, 127);
                let v20: i64 = __mlang_std_unordered_map_i64_i64_get_or(pat_v2_map_h, src_k, 0);
                let _ = __mlang_std_unordered_map_i64_i64_insert(pat_note_map_h, dst_k, n0);
                let _ = __mlang_std_unordered_map_i64_i64_insert(pat_v1_map_h, dst_k, v10);
                let _ = __mlang_std_unordered_map_i64_i64_insert(pat_v2_map_h, dst_k, v20);
            }
        }
        r = r - 1;
    }
    for ch in 0..4 {
        let ins_k: i64 = pattern_cell_key(pattern_id, idx, ch);
        let _ = __mlang_std_unordered_map_i64_i64_insert(pat_cell_active_map_h, ins_k, 0);
    }
    return current_steps + 1;
}

fn pattern_init_cell(pattern_id: i64, row: i64, ch: i64,
                     pat_custom_map_h: i64, pat_cell_active_map_h: i64,
                     pat_note_map_h: i64, pat_v1_map_h: i64, pat_v2_map_h: i64) -> void {
    let _ = __mlang_std_unordered_map_i64_i64_insert(pat_custom_map_h, pattern_id, 1);
    let k: i64 = pattern_cell_key(pattern_id, row, ch);
    let _ = __mlang_std_unordered_map_i64_i64_insert(pat_cell_active_map_h, k, 1);
    let _ = __mlang_std_unordered_map_i64_i64_insert(pat_note_map_h, k, 0);
    let _ = __mlang_std_unordered_map_i64_i64_insert(pat_v1_map_h, k, 127);
    let _ = __mlang_std_unordered_map_i64_i64_insert(pat_v2_map_h, k, 0);
}

fn event_cell_key(pattern_id: i64, event_row: i64) -> i64 {
    return pattern_id * 4096 + event_row;
}

fn clamp_view_offset(seq_offset_in: i64, cursor_row: i64, visible: i64, seq_len: i64) -> i64 {
    var seq_offset: i64 = seq_offset_in;
    if cursor_row < seq_offset {
        seq_offset = cursor_row;
    }
    if cursor_row >= seq_offset + visible {
        seq_offset = cursor_row - visible + 1;
    }
    let max_off: i64 = max_i64(0, seq_len - visible);
    if seq_offset < 0 {
        seq_offset = 0;
    }
    if seq_offset > max_off {
        seq_offset = max_off;
    }
    return seq_offset;
}

fn menu_item_count(focus_idx: i64) -> i64 {
    let _ = focus_idx;
    return 6;
}

fn menu_name(focus_idx: i64) -> string {
    if focus_idx == 0 { return format!("{}", "File"); }
    if focus_idx == 1 { return format!("{}", "View"); }
    if focus_idx == 2 { return format!("{}", "Edit"); }
    return format!("{}", "Help");
}

fn menu_item_name(focus_idx: i64, item_idx: i64) -> string {
    if focus_idx == 0 {
        if item_idx == 0 { return format!("{}", "New"); }
        if item_idx == 1 { return format!("{}", "Open"); }
        if item_idx == 2 { return format!("{}", "Save"); }
        if item_idx == 3 { return format!("{}", "Export"); }
        if item_idx == 4 { return format!("{}", "Close"); }
        return format!("{}", "Quit");
    }
    if focus_idx == 1 {
        if item_idx == 0 { return format!("{}", "Pattern"); }
        if item_idx == 1 { return format!("{}", "Event view"); }
        if item_idx == 2 { return format!("{}", "Song view"); }
        if item_idx == 3 { return format!("{}", "Mixer"); }
        if item_idx == 4 { return format!("{}", "Scope"); }
        return format!("{}", "FFT");
    }
    if focus_idx == 2 {
        if item_idx == 0 { return format!("{}", "Cut"); }
        if item_idx == 1 { return format!("{}", "Copy"); }
        if item_idx == 2 { return format!("{}", "Paste"); }
        if item_idx == 3 { return format!("{}", "Transpose"); }
        if item_idx == 4 { return format!("{}", "Quantize"); }
        return format!("{}", "Clear");
    }
    if item_idx == 0 { return format!("{}", "Keys"); }
    if item_idx == 1 { return format!("{}", "About"); }
    if item_idx == 2 { return format!("{}", "License"); }
    if item_idx == 3 { return format!("{}", "Docs"); }
    if item_idx == 4 { return format!("{}", "Version"); }
    return format!("{}", "System");
}

fn main() -> i32 {
    let input: Stdin = stdin();
    let out = stdout();
    var raw_enabled: i32 = 0;
    if stdin_is_tty() == 1 {
        if stdin_enable_raw() == 0 {
            raw_enabled = 1;
        }
    }

    let qh: i64 = __mlang_std_sync_lfqueue_new(128);
    if qh == 0 {
        println!("queue init failed");
        if raw_enabled == 1 { stdin_restore(); }
        return 1;
    }

    let loop_r: Result<EventLoop, string> = EventLoop::start(qh, 30, "tick");
    if loop_r.is_err() {
        println!("event loop init failed: {}", loop_r.unwrap_err());
        __mlang_std_sync_lfqueue_free(qh);
        if raw_enabled == 1 { stdin_restore(); }
        return 1;
    }
    let ticker: EventLoop = loop_r.unwrap();

    let ev_buf: string = String::with_capacity(32);
    var cursor_row: i64 = 0;
    var seq_offset: i64 = 0;
    var current_view: i64 = view_pattern();
    var active_pattern: i64 = 0;
    var pattern_steps_list: list<i64> = [64, 64, 32, 48, 64, 32, 96, 64];
    var song_order: list<i64> = [
        0, 1, 2, 3, 4, 5, 6, 7,
        1, 0, 3, 2, 5, 4, 7, 6,
        0, 2, 4, 6, 1, 3, 5, 7
    ];
    var song_bpm: list<i64> = [
        120, 120, 120, 120, 120, 120, 120, 120,
        120, 120, 120, 120, 120, 120, 120, 120,
        120, 120, 120, 120, 120, 120, 120, 120
    ];
    let bpm: i64 = 120;
    let steps_per_beat: i64 = 4;
    let tick_hz: i64 = 30;
    var row_phase: i64 = 0;
    var play_song_row: i64 = 0;
    var play_step: i64 = 0;
    var loop_song_row: i64 = -1;
    var quit: i32 = 0;
    var running: i32 = 0;
    var focus_idx: i64 = 0;
    var edit_mode: i32 = 0;
    var edit_col_pattern: i64 = 1;
    var edit_sub_pattern: i64 = 0;
    var edit_col_event: i64 = 2;
    var edit_col_song: i64 = 1;
    var pat_edit_row: i64 = -1;
    var pat_edit_col: i64 = 1;
    var pat_note_off0: i64 = 0;
    var pat_note_off1: i64 = 0;
    var pat_note_off2: i64 = 0;
    var pat_note_off3: i64 = 0;
    var pat_v1_off0: i64 = 0;
    var pat_v1_off1: i64 = 0;
    var pat_v1_off2: i64 = 0;
    var pat_v1_off3: i64 = 0;
    var pat_v2_off0: i64 = 0;
    var pat_v2_off1: i64 = 0;
    var pat_v2_off2: i64 = 0;
    var pat_v2_off3: i64 = 0;
    let pat_note_map_h: i64 = __mlang_std_unordered_map_i64_i64_new();
    let pat_v1_map_h: i64 = __mlang_std_unordered_map_i64_i64_new();
    let pat_v2_map_h: i64 = __mlang_std_unordered_map_i64_i64_new();
    let pat_custom_map_h: i64 = __mlang_std_unordered_map_i64_i64_new();
    let pat_cell_active_map_h: i64 = __mlang_std_unordered_map_i64_i64_new();
    let ev_event_map_h: i64 = __mlang_std_unordered_map_i64_i64_new();
    let ev_val1_map_h: i64 = __mlang_std_unordered_map_i64_i64_new();
    let ev_val2_map_h: i64 = __mlang_std_unordered_map_i64_i64_new();
    let ev_mod_map_h: i64 = __mlang_std_unordered_map_i64_i64_new();
    let ev_m1_map_h: i64 = __mlang_std_unordered_map_i64_i64_new();
    let ev_m2_map_h: i64 = __mlang_std_unordered_map_i64_i64_new();
    let ev_count_map_h: i64 = __mlang_std_unordered_map_i64_i64_new();
    if pat_note_map_h == 0 || pat_v1_map_h == 0 || pat_v2_map_h == 0 ||
       pat_custom_map_h == 0 || pat_cell_active_map_h == 0 ||
       ev_event_map_h == 0 || ev_val1_map_h == 0 || ev_val2_map_h == 0 ||
       ev_mod_map_h == 0 || ev_m1_map_h == 0 || ev_m2_map_h == 0 ||
       ev_count_map_h == 0 {
        println!("pattern map init failed");
        if pat_note_map_h != 0 { __mlang_std_unordered_map_i64_i64_free(pat_note_map_h); }
        if pat_v1_map_h != 0 { __mlang_std_unordered_map_i64_i64_free(pat_v1_map_h); }
        if pat_v2_map_h != 0 { __mlang_std_unordered_map_i64_i64_free(pat_v2_map_h); }
        if pat_custom_map_h != 0 { __mlang_std_unordered_map_i64_i64_free(pat_custom_map_h); }
        if pat_cell_active_map_h != 0 { __mlang_std_unordered_map_i64_i64_free(pat_cell_active_map_h); }
        if ev_event_map_h != 0 { __mlang_std_unordered_map_i64_i64_free(ev_event_map_h); }
        if ev_val1_map_h != 0 { __mlang_std_unordered_map_i64_i64_free(ev_val1_map_h); }
        if ev_val2_map_h != 0 { __mlang_std_unordered_map_i64_i64_free(ev_val2_map_h); }
        if ev_mod_map_h != 0 { __mlang_std_unordered_map_i64_i64_free(ev_mod_map_h); }
        if ev_m1_map_h != 0 { __mlang_std_unordered_map_i64_i64_free(ev_m1_map_h); }
        if ev_m2_map_h != 0 { __mlang_std_unordered_map_i64_i64_free(ev_m2_map_h); }
        if ev_count_map_h != 0 { __mlang_std_unordered_map_i64_i64_free(ev_count_map_h); }
        ticker.close();
        __mlang_std_sync_lfqueue_close(qh);
        __mlang_std_sync_lfqueue_free(qh);
        if raw_enabled == 1 { stdin_restore(); }
        return 1;
    }
    var ev_off_event: i64 = 0;
    var ev_off_val1: i64 = 0;
    var ev_off_val2: i64 = 0;
    var ev_off_mod: i64 = 0;
    var ev_off_m1: i64 = 0;
    var ev_off_m2: i64 = 0;
    var open_menu: i32 = 0;
    var menu_sel: i64 = 0;
    var esc_mode: i32 = 0;
    var csi_num: i64 = 0;
    var modal_open: i32 = 0;
    var modal_ok_selected: i32 = 1;
    var modal_title: string = format!("{}", "About Mlau Tracker");
    var modal_body: string = format!("{}", "Modal popup demo [Enter/Esc = OK]");
    var last_action: string = format!("{}", "(none)");

    print!("{}{}{}{}", alt_screen_on(), cursor(cmd_hide()), cursor(cmd_home()), cursor(cmd_clear_screen()));
    while quit == 0 {
        let n: i64 = __mlang_std_sync_lfqueue_try_recv(qh, ev_buf, 32);
        if n == -2 {
            continue;
        }
        if n <= 0 {
            continue;
        }

        while 1 {
            let keycode: i32 = read_keycode_nonblocking(input);
            if keycode == -2 {
                break;
            }
            if keycode < 0 {
                break;
            }

            if modal_open == 1 {
                if keycode == std::ascii::AsciiKey::Esc || keycode == std::ascii::AsciiKey::Cr || keycode == std::ascii::AsciiKey::Lf {
                    modal_open = 0;
                    esc_mode = 0;
                    open_menu = 0;
                    menu_sel = 0;
                    free(last_action);
                    last_action = format!("{}", "About dialog closed");
                }
                continue;
            }

            if esc_mode == 0 {
                if keycode == std::ascii::AsciiKey::Esc {
                    // Peek one byte so Shift+Tab/F-keys are not mistaken for plain ESC.
                    let keycode2: i32 = read_keycode_nonblocking(stdin());
                    if keycode2 == std::ascii::AsciiKey::LBracket {
                        esc_mode = 2;
                        csi_num = 0;
                    } else if keycode2 == std::ascii::AsciiKey::UpperO {
                        esc_mode = 3;
                    } else if keycode2 == -2 {
                        if open_menu == 1 {
                            open_menu = 0;
                            menu_sel = 0;
                            focus_idx = 0;
                        } else if edit_mode != 0 {
                            edit_mode = 0;
                        } else {
                            esc_mode = 1;
                            csi_num = 0;
                        }
                    } else {
                        if open_menu == 1 {
                            open_menu = 0;
                            menu_sel = 0;
                            focus_idx = 0;
                        } else if edit_mode != 0 {
                            edit_mode = 0;
                        }
                        esc_mode = 0;
                    }
                } else {
                    if keycode == std::ascii::AsciiKey::LowerQ || keycode == std::ascii::AsciiKey::UpperQ {
                        quit = 1;
                    }
                    if keycode == std::ascii::AsciiKey::Space {
                        running = running == 1 ? 0 : 1;
                        row_phase = 0;
                        if running == 1 {
                            if current_view == view_song() {
                                play_song_row = cursor_row;
                                play_step = 0;
                            } else if current_view == view_pattern() {
                                play_song_row = find_song_row_for_pattern(song_order, active_pattern);
                                let max_steps: i64 = pattern_steps(active_pattern, pattern_steps_list);
                                play_step = cursor_row % max_steps;
                            } else if current_view == view_event() {
                                play_song_row = find_song_row_for_pattern(song_order, active_pattern);
                                play_step = event_row_to_step(active_pattern, cursor_row, pattern_steps_list, ev_count_map_h, pat_custom_map_h);
                            }
                        }
                    }
                    if keycode == std::ascii::AsciiKey::Tab {
                        if open_menu == 0 {
                            focus_idx = 0;
                            open_menu = 1;
                            menu_sel = 0;
                        } else {
                            focus_idx = (focus_idx + 1) % 4;
                            menu_sel = 0;
                        }
                    }
                    if keycode == std::ascii::AsciiKey::Digit1 {
                        focus_idx = 0;
                        open_menu = 1;
                        menu_sel = 0;
