                            free(iname);
                            free(last_action);
                            if focus_idx == 0 && menu_sel == 0 {
                                free(action);
                                last_action = format!("{}", "New -> Pattern");
                            } else {
                                last_action = action;
                            }
                            open_menu = 0;
                        } else {
                            if current_view == view_pattern() && running == 0 {
