/// \file widgets.mla
/// @ingroup examples
/// \brief Reusable TUI widget primitives (boxes, bars, labels) built on std::esc.
///
mod std::esc;
mod std::music;
mod std::strbuf;
mod std::unordered;

use std::esc::acs_hline;
use std::esc::acs_llcorner;
use std::esc::acs_lrcorner;
use std::esc::acs_ulcorner;
use std::esc::acs_urcorner;
use std::esc::acs_vline;
use std::esc::bg;
use std::esc::bg_rgb;
use std::esc::bold_on;
use std::esc::cmd_home;
use std::esc::color_black;
use std::esc::color_blue;
use std::esc::color_bright_black;
use std::esc::color_bright_cyan;
use std::esc::color_bright_white;
use std::esc::color_bright_yellow;
use std::esc::color_cyan;
use std::esc::color_green;
use std::esc::color_white;
use std::esc::cursor_code;
use std::esc::cursor_move;
use std::esc::dir_down;
use std::esc::dir_right;
use std::esc::fg;
use std::esc::fg_rgb;
use std::esc::reset;
use std::music::note_name_u8;
use std::music::tracker_event_names;
use std::strbuf::builder_append;
use std::strbuf::builder_free;
use std::strbuf::builder_new;
use std::strbuf::builder_take_string;
use std::strbuf::concat;
use std::strbuf::eq;
use std::strbuf::fit_right;
use std::strbuf::free;
use std::strbuf::len;
use std::strbuf::pad_i64_left;
use std::strbuf::repeat;
use std::strbuf::sub;
use std::strbuf::zpad_i64;
use std::unordered::__mlang_std_unordered_map_i64_i64_get_or;
use type StringBuilder = i64;

fn styled_line(width: i64, fg_c: i32, bg_c: i32, bold: i32, text: str8) -> str8 {
    let row: str8 = fit_right(text, width, " ");
    if bold == 1 {
        let out_b: str8 = format!("{}{}{}{}{}\r\n", bold_on(), fg(fg_c), bg(bg_c), row, reset());
        free(row);
        return out_b;
    }
    let out: str8 = format!("{}{}{}{}\r\n", fg(fg_c), bg(bg_c), row, reset());
    free(row);
    return out;
}

fn styled_line_compact(fg_c: i32, bg_c: i32, bold: i32, text: str8) -> str8 {
    if bold == 1 {
        return format!("{}{}{}{}{}\r\n", bold_on(), fg(fg_c), bg(bg_c), text, reset());
    }
    return format!("{}{}{}{}\r\n", fg(fg_c), bg(bg_c), text, reset());
}

fn styled_line_compact_rgb(fg_r: i32, fg_g: i32, fg_b: i32,
bg_r: i32, bg_g: i32, bg_b: i32,
bold: i32, text: str8) -> str8 {
    let fg_s: str8 = fg_rgb(fg_r, fg_g, fg_b);
    let bg_s: str8 = bg_rgb(bg_r, bg_g, bg_b);
    if bold == 1 {
        return format!("{}{}{}{}{}\r\n", bold_on(), fg_s, bg_s, text, reset());
    }
    return format!("{}{}{}{}\r\n", fg_s, bg_s, text, reset());
}

fn styled_line_rgb(width: i64,
fg_r: i32, fg_g: i32, fg_b: i32,
bg_r: i32, bg_g: i32, bg_b: i32,
bold: i32,
text: str8) -> str8 {
    let row: str8 = fit_right(text, width, " ");
    let fg_s: str8 = fg_rgb(fg_r, fg_g, fg_b);
    let bg_s: str8 = bg_rgb(bg_r, bg_g, bg_b);
    if bold == 1 {
        let out_b: str8 = format!("{}{}{}{}{}\r\n", bold_on(), fg_s, bg_s, row, reset());
        free(row);
        return out_b;
    }
    let out: str8 = format!("{}{}{}{}\r\n", fg_s, bg_s, row, reset());
    free(row);
    return out;
}

fn append_owned(builder: StringBuilder, s: str8) -> void {
    let _ = builder_append(builder, s);
    free(s);
}

fn sep_line(width: i64) -> str8 {
    let h: str8 = acs_hline();
    let dash: str8 = repeat(h, width);
    let out: str8 = styled_line_compact(color_bright_black(), color_black(), 0, dash);
    free(dash);
    free(h);
    return out;
}

fn borderify_ascii(line: str8) -> str8 {
    let n: i64 = len(line);
    let out_b: StringBuilder = builder_new(n + 64);
    let v: str8 = acs_vline();
    for i in 0..n {
        let ch: str8 = sub(line, i, 1);
        if eq(ch, "|") == 1 {
            let _ = builder_append(out_b, v);
        } else {
            let _ = builder_append(out_b, ch);
        }
        free(ch);
    }
    free(v);
    let out: str8 = builder_take_string(out_b);
    builder_free(out_b);
    return out;
}

fn render_meter(step_in: i64, total: i64) -> str8 {
    if total <= 0 {
        return "";
    }
    var step: i64 = step_in;
    if step < 0 {
        step = 0;
    }
    if step > total {
        step = total;
    }
    let on: str8 = repeat("#", step);
    let off: str8 = repeat(".", total - step);
    let out: str8 = concat(on, off);
    free(off);
    free(on);
    return out;
}

fn wrap_mod(v: i64, m: i64) -> i64 {
    var out: i64 = v % m;
    if out < 0 { out = out + m; }
    return out;
}

fn max_i64(a: i64, b: i64) -> i64 {
    return a > b ? a : b;
}

fn min_i64(a: i64, b: i64) -> i64 {
    return a < b ? a : b;
}

fn is_digit_ch(ch: str8) -> i32 {
    if eq(ch, "0") == 1 { return 1; }
    if eq(ch, "1") == 1 { return 1; }
    if eq(ch, "2") == 1 { return 1; }
    if eq(ch, "3") == 1 { return 1; }
    if eq(ch, "4") == 1 { return 1; }
    if eq(ch, "5") == 1 { return 1; }
    if eq(ch, "6") == 1 { return 1; }
    if eq(ch, "7") == 1 { return 1; }
    if eq(ch, "8") == 1 { return 1; }
    if eq(ch, "9") == 1 { return 1; }
    return 0;
}

fn pattern_cell_key(pattern_id: i64, row: i64, ch: i64) -> i64 {
    return pattern_id * 65536 + row * 16 + ch;
}

fn pattern_cell(pattern_id: i64, row: i64, ch: i64,
                note_map_h: i64, v1_map_h: i64, v2_map_h: i64,
                pat_custom_map_h: i64, pat_cell_active_map_h: i64,
                sel_sub: i64) -> str8 {
    let key: i64 = pattern_cell_key(pattern_id, row, ch);
    let is_custom: i64 = __mlang_std_unordered_map_i64_i64_get_or(pat_custom_map_h, pattern_id, 0);
    let cell_active: i64 = is_custom == 1
        ? __mlang_std_unordered_map_i64_i64_get_or(pat_cell_active_map_h, key, 0)
        : 1;
    var note_u8: i64 = 0;
    var v1: i64 = 0;
    var v2: i64 = 0;
    var note_s: str8 = format!("{}", "---");
    if cell_active == 1 {
        if is_custom == 1 {
            note_u8 = __mlang_std_unordered_map_i64_i64_get_or(note_map_h, key, 0);
            v1 = __mlang_std_unordered_map_i64_i64_get_or(v1_map_h, key, 127);
            v2 = __mlang_std_unordered_map_i64_i64_get_or(v2_map_h, key, 0);
        } else {
            let off_note: i64 = __mlang_std_unordered_map_i64_i64_get_or(note_map_h, key, 0);
            let off_v1: i64 = __mlang_std_unordered_map_i64_i64_get_or(v1_map_h, key, 0);
            let off_v2: i64 = __mlang_std_unordered_map_i64_i64_get_or(v2_map_h, key, 0);
            note_u8 = wrap_mod((row + ch * 2) + off_note, 128);
            v1 = wrap_mod((row * 3 + ch * 7) + off_v1, 128);
            v2 = wrap_mod((row * 5 + ch * 11) + off_v2, 256);
        }
        free(note_s);
        note_s = note_name_u8(note_u8);
    } else {
        v1 = 0;
        v2 = 0;
    }
    let note_fit: str8 = fit_right(note_s, 5, " ");
    let v1_s: str8 = zpad_i64(v1, 3);
    let v2_s: str8 = zpad_i64(v2, 3);
    let row_base: str8 = format!("{}{}{}",
    fg_rgb(232, 224, 201), bg_rgb(106, 150, 176), bold_on());
    let sel_on: str8 = format!("{}{}{}",
    fg_rgb(10, 10, 10), bg_rgb(255, 241, 153), bold_on());
    let note_p: str8 = sel_sub == 0 ? format!("{}{}{}", sel_on, note_fit, row_base): format!("{}", note_fit);
    let v1_p: str8 = sel_sub == 1 ? format!("{}{}{}", sel_on, v1_s, row_base): format!("{}", v1_s);
    let v2_p: str8 = sel_sub == 2 ? format!("{}{}{}", sel_on, v2_s, row_base): format!("{}", v2_s);
    let out: str8 = format!("{} | {} | {}", note_p, v1_p, v2_p);
    free(v2_p);
    free(v1_p);
    free(note_p);
    free(sel_on);
    free(row_base);
    free(note_fit);
    free(note_s);
    free(v2_s);
    free(v1_s);
    return out;
}

fn tracker_grid_line(row: i64,
                     pattern_id: i64,
                     edit_row: i64, edit_col: i64,
                     focus_row: i64, focus_col: i64, focus_sub: i64,
                     note_map_h: i64, v1_map_h: i64, v2_map_h: i64,
                     pat_custom_map_h: i64, pat_cell_active_map_h: i64,
                     off_note0: i64, off_note1: i64, off_note2: i64, off_note3: i64,
                     off_v10: i64, off_v11: i64, off_v12: i64, off_v13: i64,
                     off_v20: i64, off_v21: i64, off_v22: i64, off_v23: i64) -> str8 {
    let row_s: str8 = pad_i64_left(row, 3, " ");
    var line: str8 = format!("{} |", row_s);
    free(row_s);
    for ch in 0..4 {
        let _ = edit_row;
        let _ = edit_col;
        let _ = off_note0;
        let _ = off_note1;
        let _ = off_note2;
        let _ = off_note3;
        let _ = off_v10;
        let _ = off_v11;
        let _ = off_v12;
        let _ = off_v13;
        let _ = off_v20;
        let _ = off_v21;
        let _ = off_v22;
        let _ = off_v23;
        var sel_sub: i64 = -1;
        if row == focus_row && ch == (focus_col - 1) {
            sel_sub = focus_sub;
        }
        let cell: str8 = pattern_cell(pattern_id, row, ch, note_map_h, v1_map_h, v2_map_h, pat_custom_map_h, pat_cell_active_map_h, sel_sub);
        let next: str8 = format!("{} {} |", line, cell);
        free(cell);
        free(line);
        line = next;
    }
    return line;
}

fn tracker_header_line() -> str8 {
    var line: str8 = format!("Row |");
    for ch in 0..4 {
        let name: str8 = format!("Ch{}", ch);
        let name_fit: str8 = fit_right(name, 17, " ");
        let next: str8 = format!("{} {} |", line, name_fit);
        free(name_fit);
        free(name);
        free(line);
        line = next;
    }
    return line;
}

fn tracker_subheader_line() -> str8 {
    var line: str8 = format!("    |");
    for _ch in 0..4 {
        let note_h: str8 = fit_right("Note", 5, " ");
        let v1_h: str8 = fit_right("V1", 3, " ");
        let v2_h: str8 = fit_right("V2", 3, " ");
        let cols_raw: str8 = format!("{} | {} | {}", note_h, v1_h, v2_h);
        let cols: str8 = fit_right(cols_raw, 17, " ");
        let next: str8 = format!("{} {} |", line, cols);
        free(v2_h);
        free(v1_h);
        free(note_h);
        free(cols_raw);
        free(cols);
        free(line);
        line = next;
    }
    return line;
}

fn pattern_sub_name(sub_idx: i64) -> str8 {
    if sub_idx == 0 { return "Note"; }
    if sub_idx == 1 { return "V1"; }
    return "V2";
}

fn event_count_key(pattern_id: i64, step: i64) -> i64 {
    return pattern_id * 4096 + step;
}

fn event_count_for_step(pattern_id: i64, step: i64,
                        ev_count_map_h: i64, pat_custom_map_h: i64) -> i64 {
    let ov: i64 = __mlang_std_unordered_map_i64_i64_get_or(
        ev_count_map_h, event_count_key(pattern_id, step), -1);
    if ov >= 1 {
        return ov;
    }
    let is_custom: i64 = __mlang_std_unordered_map_i64_i64_get_or(
        pat_custom_map_h, pattern_id, 0);
    if is_custom == 1 {
        return 1;
    }
    return 1 + ((step + pattern_id) % 3);
}

fn step_to_event_row(pattern_id: i64, step: i64,
                     ev_count_map_h: i64, pat_custom_map_h: i64) -> i64 {
    var row: i64 = 0;
    for s in 0..step {
        row = row + event_count_for_step(pattern_id, s, ev_count_map_h, pat_custom_map_h);
    }
    return row;
}

fn event_row_to_step(pattern_id: i64, steps_per_pattern: i64, event_row: i64,
                     ev_count_map_h: i64, pat_custom_map_h: i64) -> i64 {
    var row: i64 = event_row;
    var s: i64 = 0;
    while s < steps_per_pattern {
        let c: i64 = event_count_for_step(pattern_id, s, ev_count_map_h, pat_custom_map_h);
        if row < c {
            return s;
        }
        row = row - c;
        s = s + 1;
    }
    return steps_per_pattern - 1;
}

fn event_cell_key(pattern_id: i64, event_row: i64) -> i64 {
    return pattern_id * 4096 + event_row;
}

fn event_focus_seg(seg: str8, col_idx: i64, focus_col: i64, is_focus_row: i32) -> str8 {
    if is_focus_row == 1 && col_idx == focus_col {
        return format!("{}{}{}{}{}{}{}{}",
        fg_rgb(8, 8, 8), bg_rgb(255, 255, 214), bold_on(), seg,
        reset(), bold_on(), fg_rgb(232, 224, 201), bg_rgb(106, 150, 176));
    }
    return format!("{}", seg);
}

fn event_grid_line(event_row: i64, pattern_id: i64, steps_per_pattern: i64,
                   focus_row: i64, focus_col: i64,
                   ev_count_map_h: i64, pat_custom_map_h: i64,
                   event_map_h: i64, val1_map_h: i64, val2_map_h: i64,
                   mod_map_h: i64, m1_map_h: i64, m2_map_h: i64,
                   off_event: i64, off_val1: i64, off_val2: i64,
                   off_mod: i64, off_m1: i64, off_m2: i64) -> str8 {
    let key: i64 = event_cell_key(pattern_id, event_row);
    let off_event_local: i64 = __mlang_std_unordered_map_i64_i64_get_or(event_map_h, key, 0);
    let off_val1_local: i64 = __mlang_std_unordered_map_i64_i64_get_or(val1_map_h, key, 0);
    let off_val2_local: i64 = __mlang_std_unordered_map_i64_i64_get_or(val2_map_h, key, 0);
    let off_mod_local: i64 = __mlang_std_unordered_map_i64_i64_get_or(mod_map_h, key, 0);
    let off_m1_local: i64 = __mlang_std_unordered_map_i64_i64_get_or(m1_map_h, key, 0);
    let off_m2_local: i64 = __mlang_std_unordered_map_i64_i64_get_or(m2_map_h, key, 0);
    let _ = off_event;
    let _ = off_val1;
    let _ = off_val2;
    let _ = off_mod;
    let _ = off_m1;
    let _ = off_m2;
    let step: i64 = event_row_to_step(pattern_id, steps_per_pattern, event_row, ev_count_map_h, pat_custom_map_h);
    let base_row: i64 = step_to_event_row(pattern_id, step, ev_count_map_h, pat_custom_map_h);
    let e_row: i64 = (event_row - base_row) + 1;
    let row_label: str8 = e_row == 1 ? zpad_i64(step + 1, 2): format!("{}", "..");
    let erow_s: str8 = zpad_i64(e_row, 2);

    let ev_names: list<str8> = tracker_event_names();
    let idx: i64 = wrap_mod((step + e_row + pattern_id) + off_event_local, ev_names.len());
    let ev_s: str8 = ev_names[idx];
    let v1_v: i64 = wrap_mod((step * 5 + e_row * 3 + pattern_id) + off_val1_local, 128);
    let v2_v: i64 = wrap_mod((step * 7 + e_row * 2 + pattern_id) + off_val2_local, 128);
    let mod_v: i64 = wrap_mod((step * 11 + e_row + pattern_id) + off_mod_local, 128);
    let m1_v: i64 = wrap_mod((step * 2 + e_row) + off_m1_local, 128);
    let m2_v: i64 = wrap_mod((step * 3 + e_row * 2) + off_m2_local, 128);
    let v1_s: str8 = zpad_i64(v1_v, 3);
    let v2_s: str8 = zpad_i64(v2_v, 3);
    let m_s: str8 = zpad_i64(mod_v, 3);
    let m1_s: str8 = zpad_i64(m1_v, 3);
    let m2_s: str8 = zpad_i64(m2_v, 3);

    let row_col: str8 = fit_right(row_label, 3, " ");
    let erow_col: str8 = fit_right(erow_s, 4, " ");
    let ev_col: str8 = fit_right(ev_s, 10, " ");
    let v1_col: str8 = fit_right(v1_s, 4, " ");
    let v2_col: str8 = fit_right(v2_s, 4, " ");
    let mod_col: str8 = fit_right(m_s, 4, " ");
    let m1_col: str8 = fit_right(m1_s, 7, " ");
    let m2_col: str8 = fit_right(m2_s, 7, " ");
    let is_focus_row: i32 = event_row == focus_row ? 1: 0;
    let row_p: str8 = event_focus_seg(row_col, 0, focus_col, is_focus_row);
    let erow_p: str8 = event_focus_seg(erow_col, 1, focus_col, is_focus_row);
    let ev_p: str8 = event_focus_seg(ev_col, 2, focus_col, is_focus_row);
    let v1_p: str8 = event_focus_seg(v1_col, 3, focus_col, is_focus_row);
    let v2_p: str8 = event_focus_seg(v2_col, 4, focus_col, is_focus_row);
    let mod_p: str8 = event_focus_seg(mod_col, 5, focus_col, is_focus_row);
    let m1_p: str8 = event_focus_seg(m1_col, 6, focus_col, is_focus_row);
    let m2_p: str8 = event_focus_seg(m2_col, 7, focus_col, is_focus_row);
    let line: str8 = format!(" {} | {} | {} | {} | {} | {} | {} | {} |",
    row_p, erow_p, ev_p, v1_p, v2_p, mod_p, m1_p, m2_p);
    free(m2_p);
    free(m1_p);
    free(mod_p);
    free(v2_p);
    free(v1_p);
    free(ev_p);
    free(erow_p);
    free(row_p);
    free(row_col);
    free(erow_col);
    free(m2_col);
    free(m1_col);
    free(mod_col);
    free(v2_col);
    free(v1_col);
    free(ev_col);
    free(m2_s);
    free(m1_s);
    free(erow_s);
    free(row_label);
    return line;
}

fn highlighted_segment(seg: str8, current_view: i64, col_sel: i64, sub_sel_pattern: i64, edit_mode: i32) -> str8 {
    if current_view == 0 && col_sel >= 1 && col_sel <= 4 {
        let n: i64 = len(seg);
        let b: StringBuilder = builder_new(n + 192);
        let row_base: str8 = format!("{}{}{}",
        fg_rgb(232, 224, 201), bg_rgb(106, 150, 176), bold_on());
        let edit_sub: str8 = format!("{}{}{}",
        fg_rgb(10, 10, 10), bg_rgb(255, 241, 153), bold_on());
        let edit_sep: str8 = format!("{}{}",
        fg_rgb(166, 176, 188), bg_rgb(72, 104, 136));
        let _ = builder_append(b, row_base);
        var part_idx: i64 = 0;
        for i in 0..n {
            let ch: str8 = sub(seg, i, 1);
            if eq(ch, "|") == 1 {
                let _ = builder_append(b, edit_sep);
                let _ = builder_append(b, ch);
                let _ = builder_append(b, row_base);
                part_idx = part_idx + 1;
            } else {
                if part_idx == sub_sel_pattern {
                    let _ = builder_append(b, edit_sub);
                    let _ = builder_append(b, ch);
                    let _ = builder_append(b, row_base);
                } else {
                    let _ = builder_append(b, ch);
                }
            }
            free(ch);
        }
        let suffix: str8 = format!("{}{}{}{}",
        reset(), bold_on(), fg_rgb(232, 224, 201), bg_rgb(106, 150, 176));
        let _ = builder_append(b, suffix);
        let out: str8 = builder_take_string(b);
        builder_free(b);
        free(suffix);
        free(edit_sep);
        free(edit_sub);
        free(row_base);
        return out;
    }
    if current_view == 1 {
        return format!("{}{}{}{}{}{}{}{}",
        fg_rgb(8, 8, 8), bg_rgb(255, 255, 214), bold_on(), seg,
        reset(), bold_on(), fg_rgb(232, 224, 201), bg_rgb(106, 150, 176));
    }
    if current_view == 2 {
        let _ = edit_mode;
        return format!("{}{}{}{}{}{}{}{}",
        fg_rgb(8, 8, 8), bg_rgb(255, 241, 153), bold_on(), seg,
        reset(), bold_on(), fg_rgb(232, 224, 201), bg_rgb(106, 150, 176));
    }
    return format!("{}{}{}{}{}{}{}{}",
    fg_rgb(16, 16, 16), bg_rgb(236, 236, 224), bold_on(), seg,
    reset(), bold_on(), fg_rgb(24, 24, 24), bg_rgb(106, 150, 176));
}

fn highlight_song_column_in_line(line: str8, col_sel: i64,
base_fg_r: i64, base_fg_g: i64, base_fg_b: i64,
base_bg_r: i64, base_bg_g: i64, base_bg_b: i64) -> str8 {
    if col_sel < 0 {
        return format!("{}", line);
    }
    let base_style: str8 = format!("{}{}{}",
    bold_on(),
    fg_rgb(base_fg_r, base_fg_g, base_fg_b),
    bg_rgb(base_bg_r, base_bg_g, base_bg_b));
    let n: i64 = len(line);
    let b: StringBuilder = builder_new(n + 192);
    var start: i64 = 0;
    var col: i64 = 0;
    for i in 0..n {
        let ch: str8 = sub(line, i, 1);
        var next_ok: i32 = 1;
        if(i + 1) < n {
            let next_ch: str8 = sub(line, i + 1, 1);
            next_ok = eq(next_ch, " ");
            free(next_ch);
        }
        if eq(ch, "|") == 1 && next_ok == 1 {
            let seg: str8 = sub(line, start, i - start);
            if col == col_sel {
                let hl: str8 = format!("{}{}{}{}{}{}",
                fg_rgb(8, 8, 8), bg_rgb(255, 241, 153), bold_on(),
                seg,
                reset(), base_style);
                let _ = builder_append(b, hl);
                free(hl);
            } else {
                let _ = builder_append(b, seg);
            }
            let _ = builder_append(b, ch);
            free(seg);
            start = i + 1;
            col = col + 1;
        }
        free(ch);
    }
    if start < n {
        let tail: str8 = sub(line, start, n - start);
        let _ = builder_append(b, tail);
        free(tail);
    }
    let out: str8 = builder_take_string(b);
    builder_free(b);
    free(base_style);
    return out;
}

fn highlight_column_in_line(line: str8, current_view: i64, col_sel: i64, sub_sel_pattern: i64, edit_mode: i32) -> str8 {
    if col_sel < 0 {
        return format!("{}", line);
    }
    let n: i64 = len(line);
    let b: StringBuilder = builder_new(n + 128);
    var start: i64 = 0;
    var col: i64 = 0;
    for i in 0..n {
        let ch: str8 = sub(line, i, 1);
        var next_ok: i32 = 1;
        if(i + 1) < n {
            let next_ch: str8 = sub(line, i + 1, 1);
            next_ok = eq(next_ch, " ");
            free(next_ch);
        }
        // Pattern rows also contain internal " | " subfield separators.
        // For pattern view, ignore separators whose next non-space char is a digit.
        var table_delim: i32 = eq(ch, "|") == 1 && next_ok == 1 ? 1: 0;
        if table_delim == 1 && current_view == 0 {
            var j: i64 = i + 1;
            while j < n {
                let look: str8 = sub(line, j, 1);
                if eq(look, " ") == 1 {
                    free(look);
                    j = j + 1;
                    continue;
                }
                if is_digit_ch(look) == 1 {
                    table_delim = 0;
                }
                free(look);
                break;
            }
        }
        if table_delim == 1 {
            let seg: str8 = sub(line, start, i - start);
            if col == col_sel {
                let hl: str8 = highlighted_segment(seg, current_view, col_sel, sub_sel_pattern, edit_mode);
                let _ = builder_append(b, hl);
                free(hl);
            } else {
                let _ = builder_append(b, seg);
            }
            let _ = builder_append(b, ch);
            free(seg);
            start = i + 1;
            col = col + 1;
        }
        free(ch);
    }
    if start < n {
        let tail: str8 = sub(line, start, n - start);
        let _ = builder_append(b, tail);
        free(tail);
    }
    let out: str8 = builder_take_string(b);
    builder_free(b);
    return out;
}

fn pattern_steps(pattern_id: i64, pattern_steps_list: &list<i64>) -> i64 {
    if pattern_steps_list.len() == 0 {
        return 1;
    }
    let idx: i64 = pattern_id % pattern_steps_list.len();
    let s: i64 = pattern_steps_list[idx];
    return s < 1 ? 1 : s;
}

fn song_start_step(song_order: &list<i64>, pattern_steps_list: &list<i64>, order_row: i64) -> i64 {
    var start: i64 = 0;
    for i in 0..order_row {
        let p: i64 = song_order[i % song_order.len()];
        start = start + pattern_steps(p, pattern_steps_list);
    }
    return start;
}

fn song_grid_line(order_row: i64, song_order: &list<i64>, song_bpm: &list<i64>, pattern_steps_list: &list<i64>) -> str8 {
    let row_s: str8 = fit_right(pad_i64_left(order_row, 3, " "), 3, " ");
    let pat_id: i64 = song_order[order_row % song_order.len()];
    let pat_s: str8 = fit_right(zpad_i64(pat_id, 2), 3, " ");
    let steps: i64 = pattern_steps(pat_id, pattern_steps_list);
    let steps_s: str8 = fit_right(pad_i64_left(steps, 3, " "), 3, " ");
    let bpm_v: i64 = song_bpm.len() == 0 ? 120: song_bpm[order_row % song_bpm.len()];
    let bpm_s: str8 = fit_right(pad_i64_left(bpm_v, 3, " "), 3, " ");
    let start_v: i64 = song_start_step(song_order, pattern_steps_list, order_row);
    let beat_s: str8 = fit_right(pad_i64_left(start_v / 4, 5, " "), 5, " ");
    let start_s: str8 = fit_right(pad_i64_left(start_v, 5, " "), 5, " ");
    let line: str8 = format!(" {} | {} | {} | {} | {} | {} |",
    row_s, pat_s, steps_s, bpm_s, beat_s, start_s);
    free(start_s);
    free(beat_s);
    free(bpm_s);
    free(steps_s);
    free(pat_s);
    free(row_s);
    return line;
}

fn song_header_line() -> str8 {
    let row_h: str8 = fit_right("Row", 3, " ");
    let pat_h: str8 = fit_right("Pat", 3, " ");
    let stp_h: str8 = fit_right("Stp", 3, " ");
    let bpm_h: str8 = fit_right("BPM", 3, " ");
    let beat_h: str8 = fit_right("Beat", 5, " ");
    let start_h: str8 = fit_right("Start", 5, " ");
    let line: str8 = format!(" {} | {} | {} | {} | {} | {} |",
    row_h, pat_h, stp_h, bpm_h, beat_h, start_h);
    free(start_h);
    free(beat_h);
    free(bpm_h);
    free(stp_h);
    free(pat_h);
    free(row_h);
    return line;
}

fn menu_tabs_line(focus_idx: i64, open_menu: i32, running: i32, edit_mode: i32) -> str8 {
    let file_tab: str8 = (open_menu == 1 ?(focus_idx == 0 ? "[File]": " File "): " File ");
    let view_tab: str8 = (open_menu == 1 ?(focus_idx == 1 ? "[View]": " View "): " View ");
    let edit_tab: str8 = (open_menu == 1 ?(focus_idx == 2 ? "[Edit]": " Edit "): " Edit ");
    let help_tab: str8 = (open_menu == 1 ?(focus_idx == 3 ? "[Help]": " Help "): " Help ");
    let run_label: str8 = running == 1 ? "RUN": "STOP";
    let edit_label: str8 = edit_mode != 0 ? "EDIT": "NAV";
    let line: str8 = format!(" {}   {}   {}   {}    [{}:{}]    F1..F4 menus",
    file_tab, view_tab, edit_tab, help_tab, run_label, edit_label);
    return line;
}

fn menu_anchor_x(focus_idx: i64) -> i64 {
    if focus_idx == 0 {
        return 1;
    }
    if focus_idx == 1 {
        return 10;
    }
    if focus_idx == 2 {
        return 19;
    }
    return 28;
}

fn menu_item_text(focus_idx: i64, item_idx: i64) -> str8 {
    if focus_idx == 0 {
        if item_idx == 0 { return format!("{}", "New"); }
        if item_idx == 1 { return format!("{}", "Open"); }
        if item_idx == 2 { return format!("{}", "Save"); }
        if item_idx == 3 { return format!("{}", "Export"); }
        if item_idx == 4 { return format!("{}", "Close"); }
        return format!("{}", "Quit");
    }
    if focus_idx == 1 {
        if item_idx == 0 { return format!("{}", "Pattern"); }
        if item_idx == 1 { return format!("{}", "Event view"); }
        if item_idx == 2 { return format!("{}", "Song view"); }
        if item_idx == 3 { return format!("{}", "Mixer"); }
        if item_idx == 4 { return format!("{}", "Scope"); }
        return format!("{}", "FFT");
    }
    if focus_idx == 2 {
        if item_idx == 0 { return format!("{}", "Cut"); }
        if item_idx == 1 { return format!("{}", "Copy"); }
        if item_idx == 2 { return format!("{}", "Paste"); }
        if item_idx == 3 { return format!("{}", "Transpose"); }
        if item_idx == 4 { return format!("{}", "Quantize"); }
        return format!("{}", "Clear");
    }
    if item_idx == 0 { return format!("{}", "Keys"); }
    if item_idx == 1 { return format!("{}", "About"); }
    if item_idx == 2 { return format!("{}", "License"); }
    if item_idx == 3 { return format!("{}", "Docs"); }
    if item_idx == 4 { return format!("{}", "Version"); }
    return format!("{}", "System");
}

fn menu_item_shortcut(focus_idx: i64, item_idx: i64) -> str8 {
    if focus_idx == 0 {
        if item_idx == 0 { return format!("{}", "ALT-N"); }
        if item_idx == 1 { return format!("{}", "ALT-O"); }
        if item_idx == 2 { return format!("{}", "ALT-S"); }
        if item_idx == 3 { return format!("{}", "ALT-E"); }
        if item_idx == 4 { return format!("{}", "ALT-W"); }
        return format!("{}", "ALT-Q");
    }
    if focus_idx == 1 {
        if item_idx == 0 { return format!("{}", "F5"); }
        if item_idx == 1 { return format!("{}", "F6"); }
        if item_idx == 2 { return format!("{}", "F7"); }
        if item_idx == 3 { return format!("{}", "F8"); }
        if item_idx == 4 { return format!("{}", "F9"); }
        return format!("{}", "F10");
    }
    if focus_idx == 2 {
        if item_idx == 0 { return format!("{}", "ALT-X"); }
        if item_idx == 1 { return format!("{}", "ALT-C"); }
        if item_idx == 2 { return format!("{}", "ALT-V"); }
        if item_idx == 3 { return format!("{}", "ALT-T"); }
        if item_idx == 4 { return format!("{}", "ALT-Z"); }
        return format!("{}", "DEL");
    }
    if item_idx == 0 { return format!("{}", "F1"); }
    if item_idx == 1 { return format!("{}", "ALT-A"); }
    if item_idx == 2 { return format!("{}", "ALT-L"); }
    if item_idx == 3 { return format!("{}", "ALT-D"); }
    if item_idx == 4 { return format!("{}", "ALT-V"); }
    return format!("{}", "ALT-S");
}

fn menu_item_count(focus_idx: i64) -> i64 {
    let _ = focus_idx;
    return 6;
}

fn dropdown_line(width: i64, focus_idx: i64, menu_sel: i64, row_idx: i64, open_menu: i32) -> str8 {
    if open_menu == 0 {
        return format!("{}", "");
    }
    let menu_w: i64 = 36;
    let x: i64 = menu_anchor_x(focus_idx);
    if x + menu_w + 1 >= width {
        return format!("{}", "");
    }
    let total_items: i64 = menu_item_count(focus_idx);
    if row_idx == 0 || row_idx == (total_items + 1) {
        let h: str8 = acs_hline();
        let top: str8 = repeat(h, menu_w);
        let l: str8 = row_idx == 0 ? acs_ulcorner(): acs_llcorner();
        let r: str8 = row_idx == 0 ? acs_urcorner(): acs_lrcorner();
        let line: str8 = format!("{}{}{}", l, top, r);
        free(r);
        free(l);
        free(top);
        free(h);
        return line;
    }
    let item_idx: i64 = row_idx - 1;
    let item: str8 = menu_item_text(focus_idx, item_idx);
    let short: str8 = menu_item_shortcut(focus_idx, item_idx);
    let item_l: str8 = fit_right(item, 22, " ");
    let short_l: str8 = fit_right(short, 11, " ");
    let merged: str8 = format!("{} {}", item_l, short_l);
    let fit_item: str8 = fit_right(merged, menu_w, " ");
    let v: str8 = acs_vline();
    var item_out: str8 = format!("{}", "");
    if item_idx == menu_sel {
        free(item_out);
        item_out = format!("{}{}{}{}{}{}{}", fg_rgb(22, 28, 22), bg_rgb(80, 122, 76), bold_on(), fit_item, reset(), fg_rgb(235, 228, 198), bg_rgb(26, 58, 92));
    } else {
        free(item_out);
        item_out = format!("{}", fit_item);
    }
    let line: str8 = format!("{}{}{}", v, item_out, v);
    free(v);
    free(item_out);
    free(item);
    free(short);
    free(item_l);
    free(short_l);
    free(merged);
    free(fit_item);
    return line;
}

fn ansi_cursor_pos(row1: i64, col1: i64) -> str8 {
    let home: str8 = cursor_code(cmd_home());
    let down: str8 = cursor_move(dir_down(), row1 - 1);
    let right: str8 = cursor_move(dir_right(), col1 - 1);
    return format!("{}{}{}", home, down, right);
}

fn center_text(text: str8, width: i64) -> str8 {
    let n: i64 = len(text);
    if n >= width {
        return sub(text, 0, width);
    }
    let left_n: i64 = (width - n) / 2;
    let right_n: i64 = width - n - left_n;
    let left: str8 = repeat(" ", left_n);
    let right: str8 = repeat(" ", right_n);
    let out: str8 = format!("{}{}{}", left, text, right);
    free(right);
    free(left);
    return out;
}

pub fn render_tracker_ui(width_in: i64,
rows_in: i64,
cursor_row: i64,
seq_offset: i64,
seq_len: i64,
current_view: i64,
bpm: i64,
steps_per_pattern: i64,
active_pattern: i64,
song_order: &list<i64>,
song_bpm: &list<i64>,
song_pos: i64,
header_pattern: i64,
transport_step: i64,
loop_song_row: i64,
edit_col_pattern: i64,
edit_sub_pattern: i64,
edit_col_event: i64,
edit_col_song: i64,
pat_note_map_h: i64,
pat_v1_map_h: i64,
pat_v2_map_h: i64,
pat_custom_map_h: i64,
pat_cell_active_map_h: i64,
ev_event_map_h: i64,
ev_val1_map_h: i64,
ev_val2_map_h: i64,
ev_mod_map_h: i64,
ev_m1_map_h: i64,
ev_m2_map_h: i64,
ev_count_map_h: i64,
pattern_steps_list: &list<i64>,
pat_edit_row: i64,
pat_edit_col: i64,
pat_note_off0: i64,
pat_note_off1: i64,
pat_note_off2: i64,
pat_note_off3: i64,
pat_v1_off0: i64,
pat_v1_off1: i64,
pat_v1_off2: i64,
pat_v1_off3: i64,
pat_v2_off0: i64,
pat_v2_off1: i64,
pat_v2_off2: i64,
pat_v2_off3: i64,
ev_off_event: i64,
ev_off_val1: i64,
ev_off_val2: i64,
ev_off_mod: i64,
ev_off_m1: i64,
ev_off_m2: i64,
running: i32,
focus_idx: i64,
edit_mode: i32,
open_menu: i32,
menu_sel: i64,
modal_open: i32,
modal_kind: i64,
modal_title: str8,
modal_body: str8,
modal_ok_selected: i32,
modal_cwd: str8,
modal_input: str8,
modal_filter: str8,
modal_filter_mode: i32,
modal_entries: &list<str8>,
modal_entry_kind: &list<i64>,
modal_match_idx: &list<i64>,
modal_sel: i64,
modal_scroll: i64,
last_action: str8) -> str8 {
    let width: i64 = width_in < 40 ? 40: width_in;
    let rows: i64 = rows_in < 12 ? 12: rows_in;
    // Keep one spare terminal row to avoid bottom-edge newline scroll.
    let drop_rows: i64 = open_menu == 1 ?(menu_item_count(focus_idx) + 2): 0;
    let pattern_header_extra: i64 = current_view == 0 ? 1: 0;
    let grid_rows_raw: i64 = rows - 9 - pattern_header_extra;
    let grid_rows: i64 = grid_rows_raw < 4 ? 4: grid_rows_raw;
    let builder: StringBuilder = builder_new(width * rows + 512);

    let loop_pos_s: str8 = loop_song_row >= 0 ? zpad_i64(loop_song_row, 2): format!("{}", "--");
    let loop_tag: str8 = loop_song_row >= 0 ? format!("LOOP:ON@{}", loop_pos_s): format!("{}", "LOOP:OFF");
    let title_line: str8 = format!(" Mlau Tracker V0.1   {}", loop_tag);
    append_owned(builder, styled_line(width, color_bright_yellow(), color_blue(), 1, title_line));
    free(title_line);
    free(loop_tag);
    free(loop_pos_s);

    let pat_s: str8 = zpad_i64(header_pattern, 2);
    let pos_s: str8 = zpad_i64(song_pos, 2);
    let info_line: str8 = format!(" Octave: 1    Volume: 64    BPM: {}    Steps/Pattern: {}    Pattern: {}", bpm, steps_per_pattern, pat_s);
    append_owned(builder, styled_line(width, color_cyan(), color_black(), 1, info_line));
    free(info_line);
    free(pat_s);
    let ch_line: str8 = format!(" Channel: 00 01 02 03   Song: Example song   Pos: {}", pos_s);
    append_owned(builder, styled_line(width, color_cyan(), color_black(), 0, ch_line));
    free(ch_line);
    free(pos_s);

    append_owned(builder, sep_line(width));

    let menu_tabs: str8 = menu_tabs_line(focus_idx, open_menu, running, edit_mode);
    // Menu bar: darker than previous cyan-ish blue, but lighter than channel header.
    append_owned(builder, styled_line_rgb(width, 235, 228, 198, 26, 58, 92, 1, menu_tabs));
    free(menu_tabs);

    if current_view == 1 {
        let ev_head_raw: str8 = format!("{}", " Row | ERow | Event      | Val1 | Val2 | Mod  | ModVal1 | ModVal2 |");
        let ev_head_pad: str8 = fit_right(ev_head_raw, width, " ");
        let ev_head: str8 = borderify_ascii(ev_head_pad);
        free(ev_head_pad);
        free(ev_head_raw);
        append_owned(builder, styled_line_compact(color_bright_white(), color_bright_black(), 0, ev_head));
        free(ev_head);
    } else if current_view == 2 {
        let song_head_raw: str8 = song_header_line();
        let song_head_pad: str8 = fit_right(song_head_raw, width, " ");
        let song_head: str8 = borderify_ascii(song_head_pad);
        free(song_head_pad);
        free(song_head_raw);
        append_owned(builder, styled_line_compact(color_bright_white(), color_bright_black(), 0, song_head));
        free(song_head);
    } else {
        let head: str8 = tracker_header_line();
        let head_pad: str8 = fit_right(head, width, " ");
        let head_g: str8 = borderify_ascii(head_pad);
        free(head_pad);
        append_owned(builder, styled_line_compact_rgb(235, 228, 198, 14, 30, 66, 0, head_g));
        free(head_g);
        free(head);
        let subhead: str8 = tracker_subheader_line();
        let subhead_pad: str8 = fit_right(subhead, width, " ");
        let subhead_g: str8 = borderify_ascii(subhead_pad);
        free(subhead_pad);
        append_owned(builder, styled_line_compact_rgb(214, 208, 188, 10, 24, 52, 0, subhead_g));
        free(subhead_g);
        free(subhead);
    }
    var event_focus_row: i64 = cursor_row;
    if current_view == 1 && running == 1 {
        event_focus_row = step_to_event_row(active_pattern, transport_step, ev_count_map_h, pat_custom_map_h);
    }

    for i in 0..grid_rows {
        let r: i64 = seq_offset + i;
        var line: str8 = format!("{}", "");
        if r < seq_len {
            free(line);
            if current_view == 1 {
                let evt_col_sel_line: i64 = edit_col_event < 2 ? 2: (edit_col_event > 7 ? 7: edit_col_event);
                line = event_grid_line(
                r, active_pattern, steps_per_pattern,
                event_focus_row, evt_col_sel_line,
                ev_count_map_h, pat_custom_map_h,
                ev_event_map_h, ev_val1_map_h, ev_val2_map_h,
                ev_mod_map_h, ev_m1_map_h, ev_m2_map_h,
                ev_off_event, ev_off_val1, ev_off_val2, ev_off_mod, ev_off_m1, ev_off_m2);
            } else if current_view == 2 {
                line = song_grid_line(r, song_order, song_bpm, pattern_steps_list);
            } else {
                let pat_col_sel_line: i64 = edit_col_pattern < 1 ? 1: (edit_col_pattern > 4 ? 4: edit_col_pattern);
                let pat_sub_sel_line: i64 = edit_sub_pattern < 0 ? 0: (edit_sub_pattern > 2 ? 2: edit_sub_pattern);
                line = tracker_grid_line(
                r, active_pattern,
                pat_edit_row, pat_edit_col,
                cursor_row, pat_col_sel_line, pat_sub_sel_line,
                pat_note_map_h, pat_v1_map_h, pat_v2_map_h, pat_custom_map_h, pat_cell_active_map_h,
                pat_note_off0, pat_note_off1, pat_note_off2, pat_note_off3,
                pat_v1_off0, pat_v1_off1, pat_v1_off2, pat_v1_off3,
                pat_v2_off0, pat_v2_off1, pat_v2_off2, pat_v2_off3);
            }
        } else {
            free(line);
            line = format!("{}", "");
        }
        let stripe_key: i64 = current_view == 1 ? event_row_to_step(active_pattern, steps_per_pattern, r, ev_count_map_h, pat_custom_map_h): r;
        // In event view, selected row and playhead can differ while running.
        let active_step: i64 = current_view == 1 ? transport_step:-1;
        let row_step: i64 = current_view == 1 ? event_row_to_step(active_pattern, steps_per_pattern, r, ev_count_map_h, pat_custom_map_h):-1;
        if r == cursor_row {
            // Selected row: brighter background -> black text for contrast.
            let pat_col_sel: i64 = edit_col_pattern < 1 ? 1: (edit_col_pattern > 4 ? 4: edit_col_pattern);
            let pat_sub_sel: i64 = edit_sub_pattern < 0 ? 0: (edit_sub_pattern > 2 ? 2: edit_sub_pattern);
            let evt_col_sel: i64 = edit_col_event < 2 ? 2: (edit_col_event > 7 ? 7: edit_col_event);
            if current_view == 0 {
                let line_g: str8 = borderify_ascii(line);
                append_owned(builder, styled_line_compact_rgb(232, 224, 201, 106, 150, 176, 1, line_g));
                free(line_g);
            } else if current_view == 1 {
                let line_g: str8 = borderify_ascii(line);
                append_owned(builder, styled_line_compact_rgb(232, 224, 201, 106, 150, 176, 1, line_g));
                free(line_g);
            } else if current_view == 2 {
                let focused_song_sel: str8 = highlight_song_column_in_line(
                line, edit_col_song,
                232, 224, 201,
                (r % 4) == 0 ? 52: ((r % 2) == 0 ? 44: 36),
                (r % 4) == 0 ? 62: ((r % 2) == 0 ? 54: 46),
                (r % 4) == 0 ? 82: ((r % 2) == 0 ? 72: 64));
                let focused_song_sel_g: str8 = borderify_ascii(focused_song_sel);
                if(r % 4) == 0 {
                    append_owned(builder, styled_line_compact_rgb(232, 224, 201, 52, 62, 82, 1, focused_song_sel_g));
                } else if(r % 2) == 0 {
                    append_owned(builder, styled_line_compact_rgb(232, 224, 201, 44, 54, 72, 1, focused_song_sel_g));
                } else {
                    append_owned(builder, styled_line_compact_rgb(232, 224, 201, 36, 46, 64, 1, focused_song_sel_g));
                }
                free(focused_song_sel_g);
                free(focused_song_sel);
            } else {
                let focused: str8 = highlight_column_in_line(
                line,
                current_view,
                current_view == 1 ? evt_col_sel: (current_view == 0 ? pat_col_sel: edit_col_song),
                current_view == 0 ? pat_sub_sel:-1,
                edit_mode);
                let focused_g: str8 = borderify_ascii(focused);
                append_owned(builder, styled_line_compact_rgb(232, 224, 201, 106, 150, 176, 1, focused_g));
                free(focused_g);
                free(focused);
            }
        } else if current_view == 1 && row_step == active_step {
            // Same-step companion event rows: subtle blue highlight (not cyan/green).
            let line_g: str8 = borderify_ascii(line);
            append_owned(builder, styled_line_compact_rgb(232, 224, 201, 52, 80, 112, 0, line_g));
            free(line_g);
        } else if current_view == 2 {
            let focused_song: str8 = highlight_column_in_line(line, current_view, edit_col_song,-1, edit_mode);
            let focused_song_g: str8 = borderify_ascii(focused_song);
            if(r % 4) == 0 {
                append_owned(builder, styled_line_compact_rgb(224, 218, 194, 42, 50, 66, 0, focused_song_g));
            } else if(r % 2) == 0 {
                append_owned(builder, styled_line_compact_rgb(224, 218, 194, 36, 42, 56, 0, focused_song_g));
            } else {
                append_owned(builder, styled_line_compact(color_white(), color_black(), 0, focused_song_g));
            }
            free(focused_song_g);
            free(focused_song);
        } else if(stripe_key % 4) == 0 {
            // Beat stripe rows: slightly brighter for clearer rhythm grouping.
            let line_g: str8 = borderify_ascii(line);
            append_owned(builder, styled_line_compact_rgb(224, 218, 194, 44, 50, 62, 0, line_g));
            free(line_g);
        } else {
            let line_g: str8 = borderify_ascii(line);
            append_owned(builder, styled_line_compact(color_white(), color_black(), 0, line_g));
            free(line_g);
        }
        free(line);
    }

    append_owned(builder, sep_line(width));

    let pos_s2: str8 = zpad_i64(song_pos, 2);
    let pat_s2: str8 = zpad_i64(header_pattern, 2);
    let step_s: str8 = zpad_i64(transport_step + 1, 3);
    let total_s: str8 = zpad_i64(steps_per_pattern, 3);
    let loop_s: str8 = loop_song_row >= 0 ? "ON": "OFF";
    let transport: str8 = format!(" Pos:{}   Pattern:{}   Step:{}/{}   Loop:{}", pos_s2, pat_s2, step_s, total_s, loop_s);
    append_owned(builder, styled_line(width, color_bright_yellow(), color_blue(), 1, transport));
    free(transport);
    free(total_s);
    free(step_s);
    free(pat_s2);
    free(pos_s2);

    let base: str8 = builder_take_string(builder);
    builder_free(builder);

    if open_menu == 0 && modal_open == 0 {
        return base;
    }

    // Overlay dropdown over already-rendered content.
    let overlay_builder: StringBuilder = builder_new(512);
    if open_menu == 1 {
        let x: i64 = menu_anchor_x(focus_idx) + 1;
        for m in 0..drop_rows {
            let y: i64 = 6 + m;
            let move: str8 = ansi_cursor_pos(y, x);
            let line: str8 = dropdown_line(width, focus_idx, menu_sel, m, open_menu);
            let painted: str8 = format!("{}{}{}{}{}", move, fg_rgb(235, 228, 198), bg_rgb(26, 58, 92), line, reset());
            let _ = builder_append(overlay_builder, painted);
            free(painted);
            free(line);
            free(move);
        }
    }

    if modal_open == 1 {
        let h: str8 = acs_hline();
        let v: str8 = acs_vline();
        let ul: str8 = acs_ulcorner();
        let ur: str8 = acs_urcorner();
        let ll: str8 = acs_llcorner();
        let lr: str8 = acs_lrcorner();
        if modal_kind == 1 {
            let inner_w: i64 = min_i64(max_i64(52, width - 10), width - 6);
            let box_h: i64 = min_i64(max_i64(12, rows - 6), 22);
            let list_rows: i64 = max_i64(3, box_h - 9);
            let x0: i64 = max_i64(2, (width - (inner_w + 2)) / 2);
            let y0: i64 = max_i64(2, (rows - box_h) / 2);
            let top_fill: str8 = repeat(h, inner_w);
            let top: str8 = format!("{}{}{}", ul, top_fill, ur);
            let bot: str8 = format!("{}{}{}", ll, top_fill, lr);
            let empty_in: str8 = repeat(" ", inner_w);
            let title_in: str8 = center_text(modal_title, inner_w);
            let cwd_raw: str8 = format!("Dir: {}", modal_cwd);
            let cwd_fit0: str8 = fit_right(cwd_raw, inner_w, " ");
            let cwd_in: str8 = sub(cwd_fit0, 0, inner_w);
            let mode_s: str8 = modal_filter_mode == 1
                ? format!("{}", "Ctrl-P FILTER: ON  (type to filter, Ctrl-J/K browse, Esc exit)")
                : format!("{}", "Ctrl-P FILTER: OFF (type path input, j/k browse, h/l folder)");
            let mode_in_raw: str8 = fit_right(mode_s, inner_w, " ");
            let mode_in: str8 = sub(mode_in_raw, 0, inner_w);
            let path_raw: str8 = format!("Path: {}", modal_input);
            let path_fit0: str8 = fit_right(path_raw, inner_w, " ");
            let path_in: str8 = sub(path_fit0, 0, inner_w);
            let filter_raw: str8 = format!("Filter: {}", modal_filter);
            let filter_fit0: str8 = fit_right(filter_raw, inner_w, " ");
            let filter_in: str8 = sub(filter_fit0, 0, inner_w);
            let mlen: i64 = modal_match_idx.len();
            var sel: i64 = modal_sel;
            if mlen <= 0 {
                sel = 0;
            } else if sel >= mlen {
                sel = mlen - 1;
            }
            var scroll: i64 = modal_scroll;
            if scroll < 0 { scroll = 0; }
            if sel < scroll {
                scroll = sel;
            }
            if sel >= (scroll + list_rows) {
                scroll = sel - list_rows + 1;
            }
            if scroll < 0 { scroll = 0; }
            if mlen > list_rows && scroll > (mlen - list_rows) {
                scroll = mlen - list_rows;
            }
            let btn_plain: str8 = "[ OK ] [ CANCEL ]";
            let btn_w: i64 = len(btn_plain);
            let btn_left_n: i64 = (inner_w - btn_w) / 2;
            let btn_right_n: i64 = inner_w - btn_w - btn_left_n;
            let btn_left: str8 = repeat(" ", btn_left_n);
            let btn_right: str8 = repeat(" ", btn_right_n);
            let btn_ok: str8 = modal_ok_selected == 1
                ? format!("{}{}{}{}{}", fg_rgb(8, 8, 8), bg_rgb(152, 190, 140), bold_on(), "[ OK ]", reset())
                : format!("{}", "[ OK ]");
            let btn_cancel: str8 = modal_ok_selected == 0
                ? format!("{}{}{}{}{}", fg_rgb(8, 8, 8), bg_rgb(152, 190, 140), bold_on(), "[ CANCEL ]", reset())
                : format!("{}", "[ CANCEL ]");
            let btn_mix: str8 = format!("{} {}", btn_ok, btn_cancel);
            let btn_text: str8 = format!("{}{}{}", btn_left, btn_mix, btn_right);
            for i in 0..box_h {
                let y: i64 = y0 + i;
                let move: str8 = ansi_cursor_pos(y, x0);
                var line: str8 = format!("{}", "");
                if i == 0 {
                    free(line);
                    line = format!("{}", top);
                } else if i == (box_h - 1) {
                    free(line);
                    line = format!("{}", bot);
                } else if i == 1 {
                    free(line);
                    line = format!("{}{}{}", v, title_in, v);
                } else if i == 2 {
                    free(line);
                    line = format!("{}{}{}", v, cwd_in, v);
                } else if i == 3 {
                    free(line);
                    line = format!("{}{}{}", v, mode_in, v);
                } else if i == 4 {
                    free(line);
                    line = format!("{}{}{}", v, path_in, v);
                } else if i == 5 {
                    free(line);
                    line = format!("{}{}{}", v, filter_in, v);
                } else if i >= 6 && i < (6 + list_rows) {
                    free(line);
                    let ri: i64 = i - 6;
                    let mi: i64 = scroll + ri;
                    if mi < mlen {
                        let eidx: i64 = modal_match_idx[mi];
                        if eidx < 0 || eidx >= modal_entries.len() {
                            line = format!("{}{}{}", v, empty_in, v);
                        } else {
                            let name: str8 = modal_entries[eidx];
                            var kind: i64 = 3;
                            if eidx < modal_entry_kind.len() {
                                kind = modal_entry_kind[eidx];
                            }
                            var is_dir: i32 = 0;
                            if kind == 0 || kind == 1 {
                                is_dir = 1;
                            }
                            var is_mtr: i32 = 0;
                            if kind == 2 {
                                is_mtr = 1;
                            }
                            let prefix: str8 = is_dir == 1 ? "> " : "  ";
                            let item_raw: str8 = format!("{}{}", prefix, name);
                            let item_fit0: str8 = fit_right(item_raw, inner_w, " ");
                            let item_fit: str8 = sub(item_fit0, 0, inner_w);
                            if mi == sel {
                                line = format!("{}{}{}{}{}{}{}", v, fg_rgb(8, 8, 8), bg_rgb(152, 190, 140), bold_on(), item_fit, reset(), v);
                            } else if is_mtr == 1 {
                                line = format!("{}{}{}{}{}{}{}", v, fg_rgb(255, 214, 110), bold_on(), item_fit, reset(), fg_rgb(235, 228, 198), v);
                            } else if is_dir == 0 {
                                line = format!("{}{}{}{}{}", v, fg_rgb(120, 124, 132), item_fit, reset(), v);
                            } else {
                                line = format!("{}{}{}", v, item_fit, v);
                            }
                            free(item_fit);
                            free(item_fit0);
                            free(item_raw);
                        }
                    } else {
                        line = format!("{}{}{}", v, empty_in, v);
                    }
                } else if i == (box_h - 2) {
                    free(line);
                    line = format!("{}{}{}", v, btn_text, v);
                } else {
                    free(line);
                    line = format!("{}{}{}", v, empty_in, v);
                }
                let painted: str8 = format!("{}{}{}{}{}", move, fg_rgb(235, 228, 198), bg_rgb(26, 58, 92), line, reset());
                let _ = builder_append(overlay_builder, painted);
                free(painted);
                free(line);
                free(move);
            }
            free(btn_text);
            free(btn_mix);
            free(btn_cancel);
            free(btn_ok);
            free(btn_right);
            free(btn_left);
            free(cwd_in);
            free(cwd_fit0);
            free(cwd_raw);
            free(filter_in);
            free(filter_fit0);
            free(filter_raw);
            free(path_in);
            free(path_fit0);
            free(path_raw);
            free(mode_in);
            free(mode_in_raw);
            free(mode_s);
            free(title_in);
            free(empty_in);
            free(bot);
            free(top);
            free(top_fill);
        } else {
            let inner_w_raw: i64 = max_i64(len(modal_title), len(modal_body)) + 8;
            let inner_w: i64 = min_i64(max_i64(26, inner_w_raw), width - 6);
            let box_h: i64 = 7;
            let x0: i64 = max_i64(2, (width - (inner_w + 2)) / 2);
            let y0: i64 = max_i64(3, (rows - box_h) / 2);
            let top_fill: str8 = repeat(h, inner_w);
            let top: str8 = format!("{}{}{}", ul, top_fill, ur);
            let bot: str8 = format!("{}{}{}", ll, top_fill, lr);
            let empty_in: str8 = repeat(" ", inner_w);
            let title_in: str8 = center_text(modal_title, inner_w);
            let body_in: str8 = center_text(modal_body, inner_w);
            let btn_plain: str8 = "[ OK ]";
            let btn_w: i64 = len(btn_plain);
            let btn_left_n: i64 = (inner_w - btn_w) / 2;
            let btn_right_n: i64 = inner_w - btn_w - btn_left_n;
            let btn_left: str8 = repeat(" ", btn_left_n);
            let btn_right: str8 = repeat(" ", btn_right_n);
            let modal_base: str8 = format!("{}{}{}", bold_on(), fg_rgb(235, 228, 198), bg_rgb(26, 58, 92));
            for i in 0..box_h {
                let y: i64 = y0 + i;
                let move: str8 = ansi_cursor_pos(y, x0);
                var line: str8 = format!("{}", "");
                if i == 0 {
                    free(line);
                    line = format!("{}", top);
                } else if i == (box_h - 1) {
                    free(line);
                    line = format!("{}", bot);
                } else if i == 2 {
                    free(line);
                    line = format!("{}{}{}", v, title_in, v);
                } else if i == 4 {
                    free(line);
                    line = format!("{}{}{}", v, body_in, v);
                } else if i == 5 {
                    free(line);
                    if modal_ok_selected == 1 {
                        line = format!("{}{}{}{}{}{}{}{}{}", v, btn_left,
                                       fg_rgb(8, 8, 8), bg_rgb(255, 241, 153), bold_on(), btn_plain, modal_base,
                                       btn_right, v);
                    } else {
                        line = format!("{}{}{}{}{}", v, btn_left, btn_plain, btn_right, v);
                    }
                } else {
                    free(line);
                    line = format!("{}{}{}", v, empty_in, v);
                }
                let painted: str8 = format!("{}{}{}{}{}", move, fg_rgb(235, 228, 198), bg_rgb(26, 58, 92), line, reset());
                let _ = builder_append(overlay_builder, painted);
                free(painted);
                free(line);
                free(move);
            }
            free(modal_base);
            free(btn_right);
            free(btn_left);
            free(body_in);
            free(title_in);
            free(empty_in);
            free(bot);
            free(top);
            free(top_fill);
        }
        free(lr);
        free(ll);
        free(ur);
        free(ul);
        free(v);
        free(h);
    }
    let _ = builder_append(overlay_builder, reset());
    let _ = builder_append(overlay_builder, cursor_code(cmd_home()));
    let overlay: str8 = builder_take_string(overlay_builder);
    builder_free(overlay_builder);

    let out: str8 = concat(base, overlay);
    free(overlay);
    free(base);
    return out;
}
