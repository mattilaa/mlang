mod std::esc;
mod std::strbuf;

use std::esc::acs_hline;
use std::esc::acs_llcorner;
use std::esc::acs_lrcorner;
use std::esc::acs_ulcorner;
use std::esc::acs_urcorner;
use std::esc::acs_vline;
use std::esc::bg;
use std::esc::bold_on;
use std::esc::cmd_home;
use std::esc::color_black;
use std::esc::color_blue;
use std::esc::color_bright_black;
use std::esc::color_bright_cyan;
use std::esc::color_bright_white;
use std::esc::color_bright_yellow;
use std::esc::color_cyan;
use std::esc::color_green;
use std::esc::color_white;
use std::esc::cursor;
use std::esc::cursor_move;
use std::esc::dir_down;
use std::esc::dir_right;
use std::esc::fg;
use std::esc::reset;
use std::strbuf::builder_append;
use std::strbuf::builder_free;
use std::strbuf::builder_new;
use std::strbuf::builder_take_string;
use std::strbuf::concat;
use std::strbuf::fit_right;
use std::strbuf::free;
use std::strbuf::pad_i64_left;
use std::strbuf::repeat;
use std::strbuf::zpad_i64;
use type StringBuilder = i64;

fn styled_line(width: i64, fg_c: i32, bg_c: i32, bold: i32, text: string) -> string {
    let row: string = fit_right(text, width, " ");
    if bold == 1 {
        let out_b: string = format!("{}{}{}{}{}\r\n", bold_on(), fg(fg_c), bg(bg_c), row, reset());
        free(row);
        return out_b;
    }
    let out: string = format!("{}{}{}{}\r\n", fg(fg_c), bg(bg_c), row, reset());
    free(row);
    return out;
}

fn append_owned(builder: StringBuilder, s: string) -> void {
    let _ = builder_append(builder, s);
    free(s);
}

fn sep_line(width: i64) -> string {
    let dash: string = repeat("-", width);
    let out: string = styled_line(width, color_bright_black(), color_black(), 0, dash);
    free(dash);
    return out;
}

fn render_meter(step_in: i64, total: i64) -> string {
    if total <= 0 {
        return "";
    }
    var step: i64 = step_in;
    if step < 0 {
        step = 0;
    }
    if step > total {
        step = total;
    }
    let on: string = repeat("#", step);
    let off: string = repeat(".", total - step);
    let out: string = concat(on, off);
    free(off);
    free(on);
    return out;
}

fn pattern_cell(row: i64, ch: i64) -> string {
    let pitch: list<string> = ["C-4", "D#4", "F-4", "G-4", "A#4", "C-5", "---"];
    let idx: i64 = (row + ch * 2) % pitch.len();
    let note: string = pitch[idx];
    let vol: i64 = 32 + ((row * 3 + ch * 7) % 32);
    let vol_s: string = zpad_i64(vol, 2);
    let fx_s: string = zpad_i64((row + ch * 5) % 16, 2);
    let out: string = format!("{} {} {}", note, vol_s, fx_s);
    free(fx_s);
    free(vol_s);
    return out;
}

fn tracker_grid_line(row: i64) -> string {
    let row_s: string = pad_i64_left(row, 3, " ");
    var line: string = format!(" {} |", row_s);
    free(row_s);
    for ch in 0..4 {
        let cell: string = pattern_cell(row, ch);
        let left: string = format!("{} {}", line, cell);
        let next: string = format!("{} |", left);
        free(left);
        free(cell);
        free(line);
        line = next;
    }
    return line;
}

fn event_grid_line(event_row: i64) -> string {
    let row_num: i64 = (event_row / 2) + 1;
    let e_row: i64 = (event_row % 2) + 1;
    let row_label: string = e_row == 1 ? zpad_i64(row_num, 2) : format!("{}", "..");
    let erow_s: string = zpad_i64(e_row, 2);

    let ev_names: list<string> = ["PitchB", "NoteOn", "Delay", "Cut", "Pan", "Vol"];
    let val1s: list<string> = ["A4", "C-5", "32", "16", "L32", "V48"];
    let val2s: list<string> = ["32", "64", "08", "00", "96", "12"];
    let mod_names: list<string> = ["Exp", "LFO", "Gate", "Env", "Rnd", "None"];
    let idx: i64 = event_row % ev_names.len();
    let ev_s: string = ev_names[idx];
    let v1_s: string = val1s[idx];
    let v2_s: string = val2s[idx];
    let m_s: string = mod_names[idx];
    let m1_s: string = zpad_i64((event_row * 2) % 10, 1);
    let m2_s: string = zpad_i64((event_row * 3 + 1) % 10, 1);

    let row_col: string = fit_right(row_label, 3, " ");
    let erow_col: string = fit_right(erow_s, 4, " ");
    let ev_col: string = fit_right(ev_s, 10, " ");
    let v1_col: string = fit_right(v1_s, 4, " ");
    let v2_col: string = fit_right(v2_s, 4, " ");
    let mod_col: string = fit_right(m_s, 4, " ");
    let m1_col: string = fit_right(m1_s, 7, " ");
    let m2_col: string = fit_right(m2_s, 7, " ");
    let line: string = format!(" {} | {} | {} | {} | {} | {} | {} | {} |",
                               row_col, erow_col, ev_col, v1_col, v2_col, mod_col, m1_col, m2_col);
    free(row_col);
    free(erow_col);
    free(m2_col);
    free(m1_col);
    free(mod_col);
    free(v2_col);
    free(v1_col);
    free(ev_col);
    free(m2_s);
    free(m1_s);
    free(erow_s);
    free(row_label);
    return line;
}

fn menu_tabs_line(focus_idx: i64, running: i32, edit_mode: i32) -> string {
    let file_tab: string = focus_idx == 0 ? "[File]" : " File ";
    let view_tab: string = focus_idx == 1 ? "[View]" : " View ";
    let edit_tab: string = focus_idx == 2 ? "[Edit]" : " Edit ";
    let help_tab: string = focus_idx == 3 ? "[Help]" : " Help ";
    let run_label: string = running == 1 ? "RUN" : "STOP";
    let edit_label: string = edit_mode == 1 ? "EDIT" : "NAV";
    let line: string = format!(" {}   {}   {}   {}    [{}:{}]    F1..F4 menus",
                               file_tab, view_tab, edit_tab, help_tab, run_label, edit_label);
    return line;
}

fn menu_anchor_x(focus_idx: i64) -> i64 {
    if focus_idx == 0 {
        return 1;
    }
    if focus_idx == 1 {
        return 10;
    }
    if focus_idx == 2 {
        return 19;
    }
    return 28;
}

fn menu_item_text(focus_idx: i64, item_idx: i64) -> string {
    if focus_idx == 0 {
        if item_idx == 0 { return format!("{}", "New"); }
        if item_idx == 1 { return format!("{}", "Open"); }
        if item_idx == 2 { return format!("{}", "Save"); }
        if item_idx == 3 { return format!("{}", "Export"); }
        if item_idx == 4 { return format!("{}", "Close"); }
        return format!("{}", "Quit");
    }
    if focus_idx == 1 {
        if item_idx == 0 { return format!("{}", "Pattern"); }
        if item_idx == 1 { return format!("{}", "Event view"); }
        if item_idx == 2 { return format!("{}", "Mixer"); }
        if item_idx == 3 { return format!("{}", "Instruments"); }
        if item_idx == 4 { return format!("{}", "Scope"); }
        return format!("{}", "FFT");
    }
    if focus_idx == 2 {
        if item_idx == 0 { return format!("{}", "Cut"); }
        if item_idx == 1 { return format!("{}", "Copy"); }
        if item_idx == 2 { return format!("{}", "Paste"); }
        if item_idx == 3 { return format!("{}", "Transpose"); }
        if item_idx == 4 { return format!("{}", "Quantize"); }
        return format!("{}", "Clear");
    }
    if item_idx == 0 { return format!("{}", "Keys"); }
    if item_idx == 1 { return format!("{}", "About"); }
    if item_idx == 2 { return format!("{}", "License"); }
    if item_idx == 3 { return format!("{}", "Docs"); }
    if item_idx == 4 { return format!("{}", "Version"); }
    return format!("{}", "System");
}

fn menu_item_shortcut(focus_idx: i64, item_idx: i64) -> string {
    if focus_idx == 0 {
        if item_idx == 0 { return format!("{}", "ALT-N"); }
        if item_idx == 1 { return format!("{}", "ALT-O"); }
        if item_idx == 2 { return format!("{}", "ALT-S"); }
        if item_idx == 3 { return format!("{}", "ALT-E"); }
        if item_idx == 4 { return format!("{}", "ALT-W"); }
        return format!("{}", "ALT-Q");
    }
    if focus_idx == 1 {
        if item_idx == 0 { return format!("{}", "F5"); }
        if item_idx == 1 { return format!("{}", "F6"); }
        if item_idx == 2 { return format!("{}", "F7"); }
        if item_idx == 3 { return format!("{}", "F8"); }
        if item_idx == 4 { return format!("{}", "F9"); }
        return format!("{}", "F10");
    }
    if focus_idx == 2 {
        if item_idx == 0 { return format!("{}", "ALT-X"); }
        if item_idx == 1 { return format!("{}", "ALT-C"); }
        if item_idx == 2 { return format!("{}", "ALT-V"); }
        if item_idx == 3 { return format!("{}", "ALT-T"); }
        if item_idx == 4 { return format!("{}", "ALT-Z"); }
        return format!("{}", "DEL");
    }
    if item_idx == 0 { return format!("{}", "F1"); }
    if item_idx == 1 { return format!("{}", "ALT-A"); }
    if item_idx == 2 { return format!("{}", "ALT-L"); }
    if item_idx == 3 { return format!("{}", "ALT-D"); }
    if item_idx == 4 { return format!("{}", "ALT-V"); }
    return format!("{}", "ALT-S");
}

fn menu_item_count(focus_idx: i64) -> i64 {
    let _ = focus_idx;
    return 6;
}

fn dropdown_line(width: i64, focus_idx: i64, menu_sel: i64, row_idx: i64, open_menu: i32) -> string {
    if open_menu == 0 {
        return format!("{}", "");
    }
    let menu_w: i64 = 36;
    let x: i64 = menu_anchor_x(focus_idx);
    if x + menu_w + 1 >= width {
        return format!("{}", "");
    }
    let total_items: i64 = menu_item_count(focus_idx);
    if row_idx == 0 || row_idx == (total_items + 1) {
        let h: string = acs_hline();
        let top: string = repeat(h, menu_w);
        let l: string = row_idx == 0 ? acs_ulcorner() : acs_llcorner();
        let r: string = row_idx == 0 ? acs_urcorner() : acs_lrcorner();
        let line: string = format!("{}{}{}", l, top, r);
        free(r);
        free(l);
        free(top);
        free(h);
        return line;
    }
    let item_idx: i64 = row_idx - 1;
    let item: string = menu_item_text(focus_idx, item_idx);
    let short: string = menu_item_shortcut(focus_idx, item_idx);
    let item_l: string = fit_right(item, 22, " ");
    let short_l: string = fit_right(short, 11, " ");
    let merged: string = format!("{} {}", item_l, short_l);
    let fit_item: string = fit_right(merged, menu_w, " ");
    let v: string = acs_vline();
    var item_out: string = format!("{}", "");
    if item_idx == menu_sel {
        free(item_out);
        item_out = format!("{}{}{}{}{}{}{}", fg(color_black()), bg(color_bright_cyan()), bold_on(), fit_item, reset(), fg(color_bright_white()), bg(color_blue()));
    } else {
        free(item_out);
        item_out = format!("{}", fit_item);
    }
    let line: string = format!("{}{}{}", v, item_out, v);
    free(v);
    free(item_out);
    free(item);
    free(short);
    free(item_l);
    free(short_l);
    free(merged);
    free(fit_item);
    return line;
}

fn ansi_cursor_pos(row1: i64, col1: i64) -> string {
    let home: string = cursor(cmd_home());
    let down: string = cursor_move(dir_down(), row1 - 1);
    let right: string = cursor_move(dir_right(), col1 - 1);
    return format!("{}{}{}", home, down, right);
}

pub fn render_tracker_ui(width_in: i64,
                         rows_in: i64,
                         cursor_row: i64,
                         seq_offset: i64,
                         seq_len: i64,
                         current_view: i64,
                         running: i32,
                         focus_idx: i64,
                         edit_mode: i32,
                         open_menu: i32,
                         menu_sel: i64,
                         last_action: string) -> string {
    let width: i64 = width_in < 40 ? 40 : width_in;
    let rows: i64 = rows_in < 12 ? 12 : rows_in;
    // Keep one spare terminal row to avoid bottom-edge newline scroll.
    let drop_rows: i64 = open_menu == 1 ? (menu_item_count(focus_idx) + 2) : 0;
    let grid_rows_raw: i64 = rows - 11;
    let grid_rows: i64 = grid_rows_raw < 4 ? 4 : grid_rows_raw;
    let builder: StringBuilder = builder_new(width * rows + 512);

    append_owned(builder, styled_line(width, color_bright_yellow(), color_blue(), 1,
        " Scream Tracker V2.2   Unregistered Version!   [ESC Widgets Demo]"));

    append_owned(builder, styled_line(width, color_cyan(), color_black(), 1,
        " Octave: 1    Sample: 01    Volume: 64    Tempo: 4    Pattern: 00"));
    append_owned(builder, styled_line(width, color_cyan(), color_black(), 0,
        " Channel: 00 01 02 03   Song: Example song   Pos: 00"));

    append_owned(builder, sep_line(width));

    let menu_tabs: string = menu_tabs_line(focus_idx, running, edit_mode);
    append_owned(builder, styled_line(width, color_bright_white(), color_blue(), 1, menu_tabs));
    free(menu_tabs);

    if current_view == 1 {
        append_owned(builder, styled_line(width, color_bright_white(), color_bright_black(), 0,
            " Row | ERow | Event      | Val1 | Val2 | Mod  | ModVal1 | ModVal2 |"));
    } else {
        append_owned(builder, styled_line(width, color_bright_white(), color_bright_black(), 0,
            " Row |   Ch0         |   Ch1         |   Ch2         |   Ch3         |"));
    }

    for i in 0..grid_rows {
        let r: i64 = seq_offset + i;
        var line: string = format!("{}", "");
        if r < seq_len {
            free(line);
            line = current_view == 1 ? event_grid_line(r) : tracker_grid_line(r);
        } else {
            free(line);
            line = format!("{}", "");
        }
        let stripe_key: i64 = current_view == 1 ? (r / 2) : r;
        if r == cursor_row {
            append_owned(builder, styled_line(width, color_bright_yellow(), color_blue(), 1, line));
        } else if (stripe_key % 4) == 0 {
            append_owned(builder, styled_line(width, color_bright_white(), color_bright_black(), 0, line));
        } else {
            append_owned(builder, styled_line(width, color_white(), color_black(), 0, line));
        }
        free(line);
    }

    append_owned(builder, sep_line(width));

    let meter_l: string = render_meter(18, 30);
    let meter_r: string = render_meter(22, 30);
    let meter_line: string = format!(" L [{}]   R [{}]   CPU {}%   DSP {}%", meter_l, meter_r, 24, 31);
    append_owned(builder, styled_line(width, color_green(), color_black(), 0, meter_line));
    free(meter_line);
    free(meter_l);
    free(meter_r);

    append_owned(builder, styled_line(width, color_bright_yellow(), color_blue(), 1,
        " SPACE=play/stop   TAB=next menu   F1..F4=open   j/k=menu or row(stop)   ENTER=select   q=quit"));

    let status: string = format!(" Last action: {}", last_action);
    append_owned(builder, styled_line(width, color_bright_black(), color_black(), 0, status));
    free(status);

    let base: string = builder_take_string(builder);
    builder_free(builder);

    if open_menu == 0 {
        return base;
    }

    // Overlay dropdown over already-rendered content.
    let overlay_builder: StringBuilder = builder_new(512);
    let x: i64 = menu_anchor_x(focus_idx) + 1;
    for m in 0..drop_rows {
        let y: i64 = 6 + m;
        let move: string = ansi_cursor_pos(y, x);
        let line: string = dropdown_line(width, focus_idx, menu_sel, m, open_menu);
        let painted: string = format!("{}{}{}{}{}", move, fg(color_bright_white()), bg(color_blue()), line, reset());
        let _ = builder_append(overlay_builder, painted);
        free(painted);
        free(line);
        free(move);
    }
    let _ = builder_append(overlay_builder, reset());
    let _ = builder_append(overlay_builder, cursor(cmd_home()));
    let overlay: string = builder_take_string(overlay_builder);
    builder_free(overlay_builder);

    let out: string = concat(base, overlay);
    free(overlay);
    free(base);
    return out;
}
