/// \file thread_basic.mla
/// @ingroup examples
/// \brief Spawning a single worker thread and joining it.
///
fn worker() -> void {
    println!("worker started");
}

fn main() -> i32 {
    let handle: Handle<Thread> = thread_spawn(worker);
    let status: i32 = thread_join(handle);
    println!("join status = {}", status);
    return 0;
}
