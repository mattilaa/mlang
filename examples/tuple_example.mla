// Example: Tuples with bool and custom structs

// Define a simple Point struct
struct Point {
    var x: int;
    var y: int;
};

fn main() -> i32 {
    // Tuple with bool - test direct access in if statement
    let flags: tuple<bool, bool, int> = (true, false, 42);

    // Direct tuple access in if condition
    if flags.0: {
        println!("First flag is true");
    }
    if flags.2 == 42: {
        println!("Third element is 42");
    }

    // Tuple with mixed types including string
    let person: tuple<string, int, bool> = ("Alice", 30, true);
    println!("Name: {}", person.0);
    println!("Age: {}", person.1);
    if person.2: {
        println!("Person is active");
    }

    // Create a Point instance
    var p1: Point;
    p1.x = 100;
    p1.y = 200;

    var p2: Point;
    p2.x = 300;
    p2.y = 400;

    // Tuple containing a Point struct and other data
    let pointData: tuple<Point, string> = (p1, "origin");

    // Access the Point from tuple and its fields
    let extractedPoint: Point = pointData.0;
    println!("Point x: {}", extractedPoint.x);
    println!("Point y: {}", extractedPoint.y);
    println!("Label: {}", pointData.1);

    // Tuple with two Points (line segment)
    let line: tuple<Point, Point> = (p1, p2);
    let start: Point = line.0;
    let end: Point = line.1;
    println!("Line from ({}, {}) to ({}, {})", start.x, start.y, end.x, end.y);

    // Tuple with Point, bool, and int
    let markedPoint: tuple<Point, bool, int> = (p1, true, 5);
    if markedPoint.1: {
        let mp: Point = markedPoint.0;
        println!("Marked point at ({}, {}) with priority {}", mp.x, mp.y, markedPoint.2);
    }

    return 0;
}
