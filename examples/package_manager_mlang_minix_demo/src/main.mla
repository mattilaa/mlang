struct LineBuffer {
    var b00: u8; var b01: u8; var b02: u8; var b03: u8; var b04: u8; var b05: u8; var b06: u8; var b07: u8;
    var b08: u8; var b09: u8; var b10: u8; var b11: u8; var b12: u8; var b13: u8; var b14: u8; var b15: u8;
    var b16: u8; var b17: u8; var b18: u8; var b19: u8; var b20: u8; var b21: u8; var b22: u8; var b23: u8;
    var b24: u8; var b25: u8; var b26: u8; var b27: u8; var b28: u8; var b29: u8; var b30: u8; var b31: u8;
    var b32: u8; var b33: u8; var b34: u8; var b35: u8; var b36: u8; var b37: u8; var b38: u8; var b39: u8;
    var b40: u8; var b41: u8; var b42: u8; var b43: u8; var b44: u8; var b45: u8; var b46: u8; var b47: u8;
    var b48: u8; var b49: u8; var b50: u8; var b51: u8; var b52: u8; var b53: u8; var b54: u8; var b55: u8;
    var b56: u8; var b57: u8; var b58: u8; var b59: u8; var b60: u8; var b61: u8; var b62: u8; var b63: u8;
};

struct ShellState {
    var line: LineBuffer;
    var len: i32;
    var command_count: i32;
};

fn zero_line_buffer() -> LineBuffer {
    return LineBuffer {
        b00: 0, b01: 0, b02: 0, b03: 0, b04: 0, b05: 0, b06: 0, b07: 0,
        b08: 0, b09: 0, b10: 0, b11: 0, b12: 0, b13: 0, b14: 0, b15: 0,
        b16: 0, b17: 0, b18: 0, b19: 0, b20: 0, b21: 0, b22: 0, b23: 0,
        b24: 0, b25: 0, b26: 0, b27: 0, b28: 0, b29: 0, b30: 0, b31: 0,
        b32: 0, b33: 0, b34: 0, b35: 0, b36: 0, b37: 0, b38: 0, b39: 0,
        b40: 0, b41: 0, b42: 0, b43: 0, b44: 0, b45: 0, b46: 0, b47: 0,
        b48: 0, b49: 0, b50: 0, b51: 0, b52: 0, b53: 0, b54: 0, b55: 0,
        b56: 0, b57: 0, b58: 0, b59: 0, b60: 0, b61: 0, b62: 0, b63: 0
    };
}

fn ascii_cr() -> u8 { return 13; }
fn ascii_lf() -> u8 { return 10; }
fn ascii_bs() -> u8 { return 8; }
fn ascii_del() -> u8 { return 127; }
fn ascii_space() -> u8 { return 32; }

fn read_current_el() -> i64 {
    let seed: i64 = 0;
    return asm volatile aarch64(i64, "mrs $0, CurrentEL", seed);
}

fn read_mpidr() -> i64 {
    let seed: i64 = 0;
    return asm volatile aarch64(i64, "mrs $0, mpidr_el1", seed);
}

fn read_cntvct() -> i64 {
    let seed: i64 = 0;
    return asm volatile aarch64(i64, "mrs $0, cntvct_el0", seed);
}

fn line_store(line: ptr<LineBuffer>, index: i32, value: u8) {
    unsafe {
        if index == 0 { (*line).b00 = value; return; }
        if index == 1 { (*line).b01 = value; return; }
        if index == 2 { (*line).b02 = value; return; }
        if index == 3 { (*line).b03 = value; return; }
        if index == 4 { (*line).b04 = value; return; }
        if index == 5 { (*line).b05 = value; return; }
