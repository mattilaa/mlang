        if index == 20 { return (*line).b20; }
        if index == 21 { return (*line).b21; }
        if index == 22 { return (*line).b22; }
        if index == 23 { return (*line).b23; }
        if index == 24 { return (*line).b24; }
        if index == 25 { return (*line).b25; }
        if index == 26 { return (*line).b26; }
        if index == 27 { return (*line).b27; }
        if index == 28 { return (*line).b28; }
        if index == 29 { return (*line).b29; }
        if index == 30 { return (*line).b30; }
        if index == 31 { return (*line).b31; }
        if index == 32 { return (*line).b32; }
        if index == 33 { return (*line).b33; }
        if index == 34 { return (*line).b34; }
        if index == 35 { return (*line).b35; }
        if index == 36 { return (*line).b36; }
        if index == 37 { return (*line).b37; }
        if index == 38 { return (*line).b38; }
        if index == 39 { return (*line).b39; }
        if index == 40 { return (*line).b40; }
        if index == 41 { return (*line).b41; }
