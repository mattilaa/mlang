        if index == 14 { (*line).b14 = value; return; }
        if index == 15 { (*line).b15 = value; return; }
        if index == 16 { (*line).b16 = value; return; }
        if index == 17 { (*line).b17 = value; return; }
        if index == 18 { (*line).b18 = value; return; }
        if index == 19 { (*line).b19 = value; return; }
        if index == 20 { (*line).b20 = value; return; }
        if index == 21 { (*line).b21 = value; return; }
        if index == 22 { (*line).b22 = value; return; }
        if index == 23 { (*line).b23 = value; return; }
        if index == 24 { (*line).b24 = value; return; }
        if index == 25 { (*line).b25 = value; return; }
        if index == 26 { (*line).b26 = value; return; }
        if index == 27 { (*line).b27 = value; return; }
        if index == 28 { (*line).b28 = value; return; }
        if index == 29 { (*line).b29 = value; return; }
        if index == 30 { (*line).b30 = value; return; }
        if index == 31 { (*line).b31 = value; return; }
        if index == 32 { (*line).b32 = value; return; }
        if index == 33 { (*line).b33 = value; return; }
        if index == 34 { (*line).b34 = value; return; }
        if index == 35 { (*line).b35 = value; return; }
        if index == 36 { (*line).b36 = value; return; }
        if index == 37 { (*line).b37 = value; return; }
        if index == 38 { (*line).b38 = value; return; }
        if index == 39 { (*line).b39 = value; return; }
        if index == 40 { (*line).b40 = value; return; }
        if index == 41 { (*line).b41 = value; return; }
        if index == 42 { (*line).b42 = value; return; }
        if index == 43 { (*line).b43 = value; return; }
        if index == 44 { (*line).b44 = value; return; }
        if index == 45 { (*line).b45 = value; return; }
        if index == 46 { (*line).b46 = value; return; }
        if index == 47 { (*line).b47 = value; return; }
        if index == 48 { (*line).b48 = value; return; }
        if index == 49 { (*line).b49 = value; return; }
        if index == 50 { (*line).b50 = value; return; }
        if index == 51 { (*line).b51 = value; return; }
        if index == 52 { (*line).b52 = value; return; }
        if index == 53 { (*line).b53 = value; return; }
        if index == 54 { (*line).b54 = value; return; }
        if index == 55 { (*line).b55 = value; return; }
        if index == 56 { (*line).b56 = value; return; }
        if index == 57 { (*line).b57 = value; return; }
        if index == 58 { (*line).b58 = value; return; }
        if index == 59 { (*line).b59 = value; return; }
        if index == 60 { (*line).b60 = value; return; }
        if index == 61 { (*line).b61 = value; return; }
        if index == 62 { (*line).b62 = value; return; }
        if index == 63 { (*line).b63 = value; return; }
    }
}

fn line_load(line: ptr<LineBuffer>, index: i32) -> u8 {
