           shell_char(state, 0) == 99 &&
           shell_char(state, 1) == 97 &&
           shell_char(state, 2) == 116 &&
           shell_char(state, 3) == ascii_space();
}

fn print_boot_banner() {
    puts("Hello to MUnix!\r\n");
    puts("MLNIX 0.3.0 kernel booting on QEMU virt (AArch64)\r\n");
    puts("init: unpacking built-in initramfs to / ... done\r\n");
    puts("init: mounting embedded GNU rootfs tar overlay ... done\r\n");
    puts("init: bringing up irq-driven serial shell ... done\r\n");
    puts("cpu: mpidr=0x");
    runtime_write_hex64(read_mpidr());
    puts(" current_el_raw=0x");
    runtime_write_hex64(read_current_el());
    puts("\r\n");
    puts("tip: try help, uname -a, ls /proc, cat /proc/cpuinfo, echo hello\r\n\r\n");
}

fn print_help() {
    puts("commands:\r\n");
    puts("  help               show this message\r\n");
    puts("  uname -a           print kernel identity\r\n");
    puts("  ls /               list the initramfs root\r\n");
    puts("  ls /bin|/dev|/etc|/proc\r\n");
    puts("  ps                 show the toy task table\r\n");
    puts("  mem                show the pseudo meminfo page\r\n");
    puts("  cat /README        design notes\r\n");
    puts("  cat /etc/motd|issue|profile\r\n");
    puts("  cat /bin/sh        show the shell stub\r\n");
    puts("  cat /dev/console   show console device info\r\n");
    puts("  cat /proc/version  version string\r\n");
    puts("  cat /proc/cpuinfo  boot cpu data\r\n");
    puts("  cat /proc/meminfo  fixed memory map\r\n");
    puts("  ls /usr            browse the mounted GNU rootfs when enabled\r\n");
    puts("  echo TEXT          echo back from the shell buffer\r\n");
    puts("  clear              ANSI clear screen\r\n");
    puts("  dmesg              boot summary\r\n");
}

fn print_uname() {
    puts("MLNIX mlnix 0.3.0 #1 SMP PREEMPT aarch64 GNU/minimal\r\n");
}

fn print_ls_root() {
    puts("README  bin  dev  etc  proc\r\n");
}

fn print_ls_proc() {
    puts("cpuinfo  meminfo  version\r\n");
}

fn print_ls_bin() {
    puts("sh\r\n");
}

fn print_ls_dev() {
    puts("console\r\n");
}

fn print_ls_etc() {
    puts("issue  motd  profile\r\n");
}

fn print_ps(state: ptr<ShellState>) {
    puts("PID TTY      STAT CMD\r\n");
    puts("0   ?        SW   [swapper/0]\r\n");
    puts("1   ?        IW   [kthreadd]\r\n");
    puts("2   ttyAMA0  S    /bin/sh\r\n");
    puts("cmds executed: ");
    unsafe {
        runtime_write_dec_i32((*state).command_count);
    }
    puts("\r\n");
}

fn print_meminfo() {
    puts("MemTotal:       262144 kB\r\n");
    puts("MemFree:        248832 kB\r\n");
    puts("KernelCode:       2560 kB\r\n");
    puts("KernelStack:        16 kB\r\n");
    puts("RamDisk:           128 kB\r\n");
}

fn print_version_page() {
    puts("MLNIX version 0.3.0 (mlang package_manager_mlang_minix_demo)\r\n");
}

fn print_cpuinfo() {
    puts("processor\t: 0\r\n");
    puts("model name\t: QEMU virt AArch64\r\n");
    puts("mpidr\t\t: 0x");
    runtime_write_hex64(read_mpidr());
    puts("\r\ncurrent_el_raw\t: 0x");
    runtime_write_hex64(read_current_el());
    puts("\r\ncounter\t\t: ");
    runtime_write_dec_i64(read_cntvct());
    puts("\r\n");
}

fn print_readme() {
    puts("MLNIX is a tiny Linux-style teaching kernel written mostly in MLang.\r\n");
    puts("It boots directly under QEMU, drives PL011 UART, exposes a serial shell,\r\n");
    puts("and now carries a small built-in initramfs under /bin, /dev, /etc,\r\n");
    puts("and /proc entirely in kernel space.\r\n");
    puts("This build can also fetch an Ubuntu Base GNU userspace tarball through\r\n");
    puts("mlang.toml tasks and mount that archive as a read-only rootfs overlay.\r\n");
}

fn print_motd() {
    puts("Welcome to MLNIX.\r\n");
    puts("This image keeps the shell, the initramfs, and the task table\r\n");
    puts("inside one freestanding monolithic kernel binary.\r\n");
}

fn print_issue() {
    puts("MLNIX 0.3.0 ttyAMA0\r\n");
}

fn print_profile() {
    puts("PATH=/bin\r\n");
    puts("PS1='root@mlnix:/# '\r\n");
    puts("export PATH PS1\r\n");
}

fn print_bin_sh() {
    puts("#!/bin/sh\r\n");
    puts("# built-in MLNIX rootfs shell placeholder\r\n");
    puts("echo userspace exec handoff not implemented yet\r\n");
}

fn print_dev_console() {
    puts("character device ttyAMA0 backed by the PL011 UART console\r\n");
}

fn print_dmesg(state: ptr<ShellState>) {
    puts("[    0.000000] mlnix: boot cpu online, mpidr=0x");
    runtime_write_hex64(read_mpidr());
    puts("\r\n[    0.000001] mlnix: uart irq console on ttyAMA0\r\n");
    puts("[    0.000002] mlnix: procfs, initramfs, and rootfs tar overlay mounted\r\n");
    puts("[    0.000003] mlnix: shell commands handled=");
    unsafe {
        runtime_write_dec_i32((*state).command_count);
    }
    puts(" tick=");
    runtime_write_dec_i64(read_cntvct());
    puts("\r\n");
}

fn print_unknown(state: ptr<ShellState>) {
    puts("sh: command not found: ");
    shell_write_from(state, 0);
    uart_newline();
}

fn print_no_such_path(prefix: str8, state: ptr<ShellState>, start: i32) {
    puts(prefix);
    shell_write_from(state, start);
    uart_newline();
}

fn run_command(state: ptr<ShellState>) {
    if line_is_empty(state) {
        return;
    }

    unsafe {
        (*state).command_count = (*state).command_count + 1;
    }

    if cmd_is_help(state) {
        print_help();
        return;
    }
    if cmd_is_uname_a(state) {
        print_uname();
        return;
    }
    if cmd_is_ls_proc(state) {
        print_ls_proc();
        return;
    }
    if cmd_is_ls_dev(state) {
        unsafe {
            if runtime_rootfs_try_ls(&(*state).line.b00, 2) != 0 {
                return;
            }
        }
        print_ls_dev();
        return;
    }
    if cmd_is_ls_any(state) {
        unsafe {
            if runtime_rootfs_try_ls(&(*state).line.b00, 2) != 0 {
                return;
            }
        }
        if cmd_is_ls_root(state) {
            print_ls_root();
            return;
        }
        if cmd_is_ls_bin(state) {
            print_ls_bin();
            return;
        }
        if cmd_is_ls_etc(state) {
            print_ls_etc();
            return;
        }
        print_no_such_path("fs: no such directory: ", state, 3);
        return;
    }
    if cmd_is_ps(state) {
        print_ps(state);
        return;
    }
    if cmd_is_mem(state) || cmd_is_cat_meminfo(state) {
        print_meminfo();
        return;
    }
    if cmd_is_cat_version(state) {
        print_version_page();
        return;
    }
    if cmd_is_cat_cpuinfo(state) {
        print_cpuinfo();
        return;
    }
    if cmd_is_cat_dev_console(state) {
        unsafe {
            if runtime_rootfs_try_cat(&(*state).line.b00, 4) != 0 {
                return;
            }
        }
        print_dev_console();
        return;
    }
    if cmd_is_cat_readme(state) {
        print_readme();
        return;
    }
    if cmd_is_cat_motd(state) {
        print_motd();
        return;
    }
    if cmd_is_cat_issue(state) {
        print_issue();
        return;
    }
    if cmd_is_cat_profile(state) {
        print_profile();
        return;
    }
    if cmd_is_cat_bin_sh(state) {
        print_bin_sh();
        return;
    }
    if cmd_is_cat_any(state) {
        unsafe {
            if runtime_rootfs_try_cat(&(*state).line.b00, 4) != 0 {
                return;
            }
        }
        print_no_such_path("fs: no such file: ", state, 4);
        return;
    }
    if cmd_is_clear(state) {
        puts("\x1b[2J\x1b[H");
        return;
    }
    if cmd_is_dmesg(state) {
        print_dmesg(state);
        return;
    }
    if cmd_is_echo(state) {
        shell_write_from(state, 5);
        uart_newline();
        return;
    }

    print_unknown(state);
}

fn read_command_line(state: ptr<ShellState>) {
    shell_reset(state);
    while true {
        let ch: u8 = uart_getc();
        if ch == ascii_cr() || ch == ascii_lf() {
            uart_newline();
            return;
        }
        if ch == ascii_bs() || ch == ascii_del() {
            if shell_pop(state) {
                uart_putc(ascii_bs());
                uart_putc(ascii_space());
                uart_putc(ascii_bs());
            }
            continue;
        }
        if ch >= ascii_space() && ch < ascii_del() {
            if shell_push(state, ch) {
                uart_putc(ch);
            }
        }
    }
}

fn kernel_main() {
    var state: ShellState = ShellState {
        line: zero_line_buffer(),
        len: 0,
        command_count: 0
    };

    runtime_init_interrupts();
    print_boot_banner();

    while true {
        prompt();
        read_command_line(&state);
        run_command(&state);
    }
}
