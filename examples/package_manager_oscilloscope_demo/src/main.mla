/// \file main.mla
/// \ingroup examples
/// \brief CoreAudio WAV oscilloscope demo rendered with std::esc.
///
mod std::esc;
mod std::ascii;
mod std::io;
mod std::strbuf;
mod std::term;
mod std::time;

use std::ascii::AsciiKey;
use std::esc::acs_bullet;
use std::esc::acs_dot;
use std::esc::alt_screen_off;
use std::esc::alt_screen_on;
use std::esc::acs_meter;
use std::esc::bg_rgb;
use std::esc::bold_on;
use std::esc::acs_hline;
use std::esc::acs_llcorner;
use std::esc::acs_lrcorner;
use std::esc::acs_ssquare;
use std::esc::acs_ulcorner;
use std::esc::acs_urcorner;
use std::esc::acs_vline;
use std::esc::cmd_clear_screen;
use std::esc::cmd_hide;
use std::esc::cmd_home;
use std::esc::cmd_show;
use std::esc::cursor;
use std::esc::fg_rgb;
use std::esc::reset;
use std::io::flush;
use std::io::read_keycode_nonblocking;
use std::io::stdin;
use std::io::stdout;
use std::io::write;
use std::strbuf::builder_append;
use std::strbuf::builder_free;
use std::strbuf::builder_new;
use std::strbuf::builder_take_string;
use std::strbuf::free;
use std::strbuf::len;
use std::term::TermSize;
use std::term::stdin_enable_raw;
use std::term::stdin_is_tty;
use std::term::stdin_restore;
use std::term::stdout_size;
use std::time::sleep_ms;

extern fn oscilloscope_demo_start(wav_path: str8) -> i32;
extern fn oscilloscope_demo_stop() -> i32;
extern fn oscilloscope_demo_running() -> i32;
extern fn oscilloscope_demo_sample_rate() -> i64;
extern fn oscilloscope_demo_total_frames() -> i64;
extern fn oscilloscope_demo_current_frame() -> i64;
extern fn oscilloscope_demo_last_error() -> str8;
extern fn oscilloscope_demo_snapshot_i64(channel: i32, window: i64) -> list<i64>;
extern fn oscilloscope_demo_level_i64(channel: i32) -> i64;

fn clamp_i64(x: i64, lo: i64, hi: i64) -> i64 {
    if x < lo {
        return lo;
    }
    if x > hi {
        return hi;
    }
    return x;
}

fn viewport_width(cols: i32) -> i64 {
    let width: i64 = cols - 22;
    return clamp_i64(width, 24, 148);
}

fn viewport_height(rows: i32) -> i64 {
    let height: i64 = rows - 12;
    return clamp_i64(height, 8, 36);
}

fn sample_subrow(sample: i64, height: i64) -> i64 {
    let clamped: i64 = clamp_i64(sample,-1000, 1000);
    let grid: i64 = height * 4;
    return((1000 - clamped) * (grid - 1)) / 2000;
}

fn abs_i64(x: i64) -> i64 {
    return x < 0 ? 0 - x: x;
}

fn min_i64(a: i64, b: i64) -> i64 {
    return a < b ? a: b;
}

fn lerp_i64(a: i64, b: i64, t: i64, scale: i64) -> i64 {
    return a + ((b - a) * t) / scale;
}

fn bput(builder: i64, s: str8) {
    let _ = builder_append(builder, s);
}

fn repeat_glyph(builder: i64, glyph: str8, count: i64) {
    for _i in 0..count {
        bput(builder, glyph);
    }
}

fn draw_titled_box_top(builder: i64, left: str8, line: str8, right: str8,
title: str8, width: i64) {
    let titleLen: i64 = len(title);
    let inner: i64 = width;
    if titleLen <= 0 || titleLen >= inner - 2 {
        bput(builder, left);
        repeat_glyph(builder, line, inner);
        bput(builder, right);
        return;
    }
    let freeSpace: i64 = inner - titleLen - 2;
    let leftFill: i64 = freeSpace / 2;
    let rightFill: i64 = freeSpace - leftFill;
    bput(builder, left);
    repeat_glyph(builder, line, leftFill);
    bput(builder, " ");
    bput(builder, title);
    bput(builder, " ");
    repeat_glyph(builder, line, rightFill);
    bput(builder, right);
}

fn segment_distance(rowSub: i64, a: i64, b: i64) -> i64 {
    let lo: i64 = min_i64(a, b);
    let hi: i64 = a > b ? a: b;
    if rowSub >= lo && rowSub <= hi {
        return 0;
    }
    return min_i64(abs_i64(rowSub - a), abs_i64(rowSub - b));
}

fn meter_color(level: i64) -> str8 {
    if level >= 850 {
        return fg_rgb(255, 96, 76);
    }
    if level >= 700 {
        return fg_rgb(255, 144, 70);
    }
    if level >= 520 {
        return fg_rgb(255, 214, 92);
    }
    return fg_rgb(116, 240, 120);
}

fn oscilloscope_bg_r(row: i64, height: i64) -> i64 {
    let scale: i64 = height <= 1 ? 1 : (height - 1);
    let t: i64 = (row * 1000) / scale;
    if t < 350 {
        let local: i64 = (t * 1000) / 350;
        return lerp_i64(16, 64, local, 1000);
    }
    if t < 700 {
        let local: i64 = ((t - 350) * 1000) / 350;
        return lerp_i64(64, 164, local, 1000);
    }
    let local: i64 = ((t - 700) * 1000) / 300;
    return lerp_i64(164, 255, local, 1000);
}

fn oscilloscope_bg_g(row: i64, height: i64) -> i64 {
    let scale: i64 = height <= 1 ? 1 : (height - 1);
    let t: i64 = (row * 1000) / scale;
    if t < 350 {
        let local: i64 = (t * 1000) / 350;
        return lerp_i64(20, 34, local, 1000);
    }
    if t < 700 {
        let local: i64 = ((t - 350) * 1000) / 350;
        return lerp_i64(34, 76, local, 1000);
    }
    let local: i64 = ((t - 700) * 1000) / 300;
    return lerp_i64(76, 164, local, 1000);
}

fn oscilloscope_bg_b(row: i64, height: i64) -> i64 {
    let scale: i64 = height <= 1 ? 1 : (height - 1);
    let t: i64 = (row * 1000) / scale;
    if t < 350 {
        let local: i64 = (t * 1000) / 350;
        return lerp_i64(46, 72, local, 1000);
    }
    if t < 700 {
        let local: i64 = ((t - 350) * 1000) / 350;
        return lerp_i64(72, 88, local, 1000);
    }
    let local: i64 = ((t - 700) * 1000) / 300;
    return lerp_i64(88, 92, local, 1000);
}

fn oscilloscope_trace_color(row: i64, height: i64, r: i64, g: i64, b: i64) -> str8 {
    let br: i64 = oscilloscope_bg_r(row, height);
    let bg: i64 = oscilloscope_bg_g(row, height);
    let bb: i64 = oscilloscope_bg_b(row, height);
    return fg_rgb(lerp_i64(br, r, 740, 1000),
                  lerp_i64(bg, g, 740, 1000),
                  lerp_i64(bb, b, 740, 1000));
}

fn draw_meter_cell(builder: i64, row: i64, height: i64, level: i64) {
    let totalSubrows: i64 = height * 4;
    let filledSubrows: i64 = (level * totalSubrows) / 1000;
    let rowBase: i64 = (height - 1 - row) * 4;
    let fill: i64 = clamp_i64(filledSubrows - rowBase, 0, 4);
    let glyph: str8 = acs_meter(fill);
    if fill > 0 {
        let threshold: i64 = ((rowBase + 2) * 1000) / totalSubrows;
        let color: str8 = meter_color(threshold);
        bput(builder, color);
        bput(builder, glyph);
        bput(builder, reset());
    } else {
        bput(builder, fg_rgb(22, 58, 42));
        bput(builder, glyph);
        bput(builder, reset());
    }
    free(glyph);
}

fn render_frame(path: str8, leftSamples: list<i64>, rightSamples: list<i64>, term: TermSize) {
    let width: i64 = viewport_width(term.cols);
    let height: i64 = viewport_height(term.rows);
    let current: i64 = oscilloscope_demo_current_frame();
    let total: i64 = oscilloscope_demo_total_frames();
    let sr: i64 = oscilloscope_demo_sample_rate();
    let levelLeft: i64 = oscilloscope_demo_level_i64(0);
    let levelRight: i64 = oscilloscope_demo_level_i64(1);
    var progressPct: i64 = 0;
    if total > 0 {
        progressPct = (current * 100) / total;
    }

    let builder: i64 = builder_new(16384);
    let axisGlyph: str8 = acs_hline();
    let farGlyph: str8 = acs_dot();
    let nearGlyph: str8 = acs_bullet();
    let coreGlyph: str8 = acs_ssquare();
    let ul: str8 = acs_ulcorner();
    let ur: str8 = acs_urcorner();
    let ll: str8 = acs_llcorner();
    let lr: str8 = acs_lrcorner();
    let vl: str8 = acs_vline();
    bput(builder, cursor(cmd_home()));
    bput(builder, bg_rgb(13, 34, 52));
    bput(builder, fg_rgb(255, 170, 84));
    bput(builder, bold_on());
    bput(builder, "Realtime Oscilloscope Demo");
    bput(builder, reset());
    let header: str8 = format!("  CoreAudio WAV output  sr={}Hz  frame={}/{}  progress={}%  L={}  R={}",
    sr, current, total, progressPct, levelLeft, levelRight);
    bput(builder, header);
    free(header);
    bput(builder, "\r\n");

    let pathLine: str8 = format!("  source: {}", path);
    bput(builder, fg_rgb(150, 156, 176));
    bput(builder, pathLine);
    bput(builder, reset());
    free(pathLine);
    bput(builder, "\r\n\r\n");

    bput(builder, "  ");
    bput(builder, fg_rgb(104, 142, 168));
    draw_titled_box_top(builder, ul, axisGlyph, ur, "VU", 3);
    bput(builder, "  ");
    draw_titled_box_top(builder, ul, axisGlyph, ur, "Oscilloscope", width);
    bput(builder, reset());
    bput(builder, "\r\n");

    for row in 0..height {
        let bgR: i64 = oscilloscope_bg_r(row, height);
        let bgG: i64 = oscilloscope_bg_g(row, height);
        let bgB: i64 = oscilloscope_bg_b(row, height);
        bput(builder, "  ");
        bput(builder, fg_rgb(104, 142, 168));
        bput(builder, vl);
        bput(builder, reset());
        draw_meter_cell(builder, row, height, levelLeft);
        bput(builder, " ");
        draw_meter_cell(builder, row, height, levelRight);
        bput(builder, fg_rgb(104, 142, 168));
        bput(builder, vl);
        bput(builder, reset());
        bput(builder, "  ");
        bput(builder, fg_rgb(104, 142, 168));
        bput(builder, vl);
        bput(builder, reset());
        let center: i64 = height / 2;
        for col in 0..width {
            let base: i64 = col * 2;
            let leftPrev: i64 = sample_subrow(leftSamples[base], height);
            let leftCur: i64 = sample_subrow(leftSamples[base + 1], height);
            let leftNext: i64 = sample_subrow(leftSamples[base + 2], height);
            let rightPrev: i64 = sample_subrow(rightSamples[base], height);
            let rightCur: i64 = sample_subrow(rightSamples[base + 1], height);
            let rightNext: i64 = sample_subrow(rightSamples[base + 2], height);
            let rowSub: i64 = row * 4 + 1;
            let leftDist: i64 = min_i64(segment_distance(rowSub, leftPrev, leftCur),
            segment_distance(rowSub, leftCur, leftNext));
            let rightDist: i64 = min_i64(segment_distance(rowSub, rightPrev, rightCur),
            segment_distance(rowSub, rightCur, rightNext));
            if leftDist == 0 && rightDist == 0 {
                bput(builder, bg_rgb(bgR, bgG, bgB));
                bput(builder, oscilloscope_trace_color(row, height, 248, 214, 132));
                bput(builder, coreGlyph);
                bput(builder, reset());
            } else if rightDist == 0 {
                bput(builder, bg_rgb(bgR, bgG, bgB));
                bput(builder, oscilloscope_trace_color(row, height, 255, 110, 84));
                bput(builder, coreGlyph);
                bput(builder, reset());
            } else if leftDist == 0 {
                bput(builder, bg_rgb(bgR, bgG, bgB));
                bput(builder, oscilloscope_trace_color(row, height, 120, 248, 132));
                bput(builder, coreGlyph);
                bput(builder, reset());
            } else if rightDist <= 1 {
                bput(builder, bg_rgb(bgR, bgG, bgB));
                bput(builder, oscilloscope_trace_color(row, height, 255, 164, 112));
                bput(builder, nearGlyph);
                bput(builder, reset());
            } else if leftDist <= 1 {
                bput(builder, bg_rgb(bgR, bgG, bgB));
                bput(builder, oscilloscope_trace_color(row, height, 150, 232, 166));
                bput(builder, nearGlyph);
                bput(builder, reset());
            } else if rightDist <= 3 {
                bput(builder, bg_rgb(bgR, bgG, bgB));
                bput(builder, oscilloscope_trace_color(row, height, 156, 88, 78));
                bput(builder, farGlyph);
                bput(builder, reset());
            } else if leftDist <= 3 {
                bput(builder, bg_rgb(bgR, bgG, bgB));
                bput(builder, oscilloscope_trace_color(row, height, 74, 148, 94));
                bput(builder, farGlyph);
                bput(builder, reset());
            } else if row == center {
                bput(builder, bg_rgb(bgR, bgG, bgB));
                bput(builder, oscilloscope_trace_color(row, height, 58, 84, 112));
                bput(builder, axisGlyph);
                bput(builder, reset());
            } else {
                bput(builder, bg_rgb(bgR, bgG, bgB));
                bput(builder, " ");
                bput(builder, reset());
            }
        }
        bput(builder, fg_rgb(104, 142, 168));
        bput(builder, vl);
        bput(builder, reset());
        bput(builder, "\r\n");
    }

    bput(builder, "  ");
    bput(builder, fg_rgb(104, 142, 168));
    bput(builder, ll);
    repeat_glyph(builder, axisGlyph, 3);
    bput(builder, lr);
    bput(builder, "  ");
    bput(builder, ll);
    repeat_glyph(builder, axisGlyph, width);
    bput(builder, lr);
    bput(builder, reset());
    bput(builder, "\r\n");

    bput(builder, "   ");
    bput(builder, fg_rgb(116, 240, 120));
    bput(builder, "L");
    bput(builder, " ");
    bput(builder, fg_rgb(255, 110, 84));
    bput(builder, "R");
    bput(builder, reset());
    bput(builder, "\r\n");

    bput(builder, "\r\n");
    bput(builder, fg_rgb(216, 220, 228));
    bput(builder, "  ");
    bput(builder, fg_rgb(255, 170, 84));
    bput(builder, "q");
    bput(builder, fg_rgb(216, 220, 228));
    bput(builder, " / ");
    bput(builder, fg_rgb(255, 170, 84));
    bput(builder, "Esc");
    bput(builder, fg_rgb(216, 220, 228));
    bput(builder, " stops playback");
    bput(builder, reset());
    bput(builder, "\r\n");

    let frame: str8 = builder_take_string(builder);
    let _ = write(stdout(), frame);
    let _ = flush(stdout());
    free(axisGlyph);
    free(farGlyph);
    free(nearGlyph);
    free(coreGlyph);
    free(ul);
    free(ur);
    free(ll);
    free(lr);
    free(vl);
    free(frame);
    builder_free(builder);
}

fn main(argc: i32, args: list<str8>) -> i32 {
    var wavPath: str8 = "../fft_example/illusion.wav";
    if argc > 1 {
        let arg1: str8 = args[1];
        if arg1 == "-h" || arg1 == "--help" {
            println!("Usage: oscilloscope_demo [WAV_PATH]");
            println!("Example:");
            println!("  ../../build/mlang pkg run demo --option wav_path=../fft_example/illusion.wav");
            return 0;
        }
        wavPath = arg1;
    }

    if oscilloscope_demo_start(wavPath) != 0 {
        eprintln!("oscilloscope demo start failed: {}", oscilloscope_demo_last_error());
        return 1;
    }

    var rawEnabled: i32 = 0;
    if stdin_is_tty() == 1 {
        if stdin_enable_raw() == 0 {
            rawEnabled = 1;
        }
    }

    let _ = write(stdout(), alt_screen_on());
    let _ = write(stdout(), cursor(cmd_hide()));
    let _ = write(stdout(), cursor(cmd_home()));
    let _ = write(stdout(), cursor(cmd_clear_screen()));

    while oscilloscope_demo_running() == 1 {
        let term: TermSize = stdout_size();
        let width: i64 = viewport_width(term.cols);
        let leftSamples: list<i64> = oscilloscope_demo_snapshot_i64(0, width * 2 + 2);
        let rightSamples: list<i64> = oscilloscope_demo_snapshot_i64(1, width * 2 + 2);
        render_frame(wavPath, leftSamples, rightSamples, term);

        let key: i32 = read_keycode_nonblocking(stdin());
        if key == AsciiKey::LowerQ || key == AsciiKey::UpperQ || key == AsciiKey::Esc {
            let _ = oscilloscope_demo_stop();
            break;
        }
        sleep_ms(16);
    }

    let finalTerm: TermSize = stdout_size();
    let finalWidth: i64 = viewport_width(finalTerm.cols);
    let finalLeft: list<i64> = oscilloscope_demo_snapshot_i64(0, finalWidth * 2 + 2);
    let finalRight: list<i64> = oscilloscope_demo_snapshot_i64(1, finalWidth * 2 + 2);
    render_frame(wavPath, finalLeft, finalRight, finalTerm);
    println!("");

    if rawEnabled == 1 {
        let _ = stdin_restore();
    }
    let _ = write(stdout(), reset());
    let _ = write(stdout(), cursor(cmd_show()));
    let _ = write(stdout(), alt_screen_off());
    return 0;
}
