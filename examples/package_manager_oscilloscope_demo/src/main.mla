/// \file main.mla
/// \ingroup examples
/// \brief CoreAudio WAV oscilloscope demo rendered with std::esc.
///
mod std::esc;
mod std::ascii;
mod std::io;
mod std::strbuf;
mod std::term;
mod std::time;

use std::ascii::AsciiKey;
use std::esc::acs_bullet;
use std::esc::acs_dot;
use std::esc::alt_screen_off;
use std::esc::alt_screen_on;
use std::esc::acs_meter;
use std::esc::bg_rgb;
use std::esc::bold_on;
use std::esc::acs_hline;
use std::esc::acs_llcorner;
use std::esc::acs_lrcorner;
use std::esc::acs_ssquare;
use std::esc::acs_ulcorner;
use std::esc::acs_urcorner;
use std::esc::acs_vline;
use std::esc::cmd_clear_screen;
use std::esc::cmd_hide;
use std::esc::cmd_home;
use std::esc::cmd_show;
use std::esc::cursor;
use std::esc::cursor_pos;
use std::esc::fg_rgb;
use std::esc::reset;
use std::io::flush;
use std::io::read_keycode_nonblocking;
use std::io::stdin;
use std::io::stdout;
use std::io::write;
use std::strbuf::builder_append;
use std::strbuf::builder_free;
use std::strbuf::builder_new;
use std::strbuf::builder_take_string;
use std::strbuf::clone;
use std::strbuf::contains;
use std::strbuf::find;
use std::strbuf::fit_right;
use std::strbuf::free;
use std::strbuf::len;
use std::strbuf::sub;
use std::strbuf::trim;
