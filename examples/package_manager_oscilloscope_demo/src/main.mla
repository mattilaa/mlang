extern fn oscilloscope_demo_start(wav_path: str8, output_device: str8) -> i32;
extern fn oscilloscope_demo_stop() -> i32;
extern fn oscilloscope_demo_running() -> i32;
extern fn oscilloscope_demo_sample_rate() -> i64;
extern fn oscilloscope_demo_total_frames() -> i64;
extern fn oscilloscope_demo_current_frame() -> i64;
extern fn oscilloscope_demo_seek_abs_frames(frame: i64) -> i64;
extern fn oscilloscope_demo_seek_rel_frames(delta: i64) -> i64;
extern fn oscilloscope_demo_last_error() -> str8;
extern fn oscilloscope_demo_output_device() -> str8;
extern fn oscilloscope_demo_list_output_devices() -> str8;
extern fn oscilloscope_demo_list_output_devices_verbose() -> str8;
extern fn oscilloscope_demo_snapshot_i64(channel: i32, window: i64) -> list<i64>;
extern fn oscilloscope_demo_level_i64(channel: i32) -> i64;

fn clamp_i64(x: i64, lo: i64, hi: i64) -> i64 {
    if x < lo {
        return lo;
    }
    if x > hi {
        return hi;
    }
    return x;
}

fn viewport_width(cols: i32) -> i64 {
    let width: i64 = cols - 22;
    return clamp_i64(width, 24, 148);
}

fn viewport_height(rows: i32) -> i64 {
    let height: i64 = rows - 14;
    return clamp_i64(height, 8, 36);
}

fn sample_subrow(sample: i64, height: i64) -> i64 {
    let clamped: i64 = clamp_i64(sample,-1000, 1000);
    let grid: i64 = height * 4;
    return((1000 - clamped) * (grid - 1)) / 2000;
}

fn abs_i64(x: i64) -> i64 {
    return x < 0 ? 0 - x: x;
}

fn min_i64(a: i64, b: i64) -> i64 {
    return a < b ? a: b;
}

fn lerp_i64(a: i64, b: i64, t: i64, scale: i64) -> i64 {
    return a + ((b - a) * t) / scale;
}

fn bput(builder: i64, s: str8) {
    let _ = builder_append(builder, s);
}

fn repeat_glyph(builder: i64, glyph: str8, count: i64) {
    for _i in 0..count {
        bput(builder, glyph);
    }
}

fn fmt2(v: i64) -> str8 {
    return v < 10 ? format!("0{}", v): format!("{}", v);
}

fn format_timecode(seconds_in: i64) -> str8 {
    let sec: i64 = seconds_in < 0 ? 0: seconds_in;
    let hh: i64 = sec / 3600;
    let mm: i64 = (sec / 60) % 60;
    let ss: i64 = sec % 60;
    if hh > 0 {
        return format!("{}:{}:{}", fmt2(hh), fmt2(mm), fmt2(ss));
    }
    return format!("{}:{}", fmt2(mm), fmt2(ss));
}

fn draw_titled_box_top(builder: i64, left: str8, line: str8, right: str8,
title: str8, width: i64) {
    let titleLen: i64 = len(title);
    let inner: i64 = width;
    if titleLen <= 0 || titleLen >= inner - 2 {
        bput(builder, left);
        repeat_glyph(builder, line, inner);
        bput(builder, right);
        return;
    }
    let freeSpace: i64 = inner - titleLen - 2;
    let leftFill: i64 = freeSpace / 2;
    let rightFill: i64 = freeSpace - leftFill;
    bput(builder, left);
    repeat_glyph(builder, line, leftFill);
    bput(builder, " ");
    bput(builder, title);
    bput(builder, " ");
    repeat_glyph(builder, line, rightFill);
    bput(builder, right);
}

fn segment_distance(rowSub: i64, a: i64, b: i64) -> i64 {
    let lo: i64 = min_i64(a, b);
    let hi: i64 = a > b ? a: b;
    if rowSub >= lo && rowSub <= hi {
        return 0;
    }
    return min_i64(abs_i64(rowSub - a), abs_i64(rowSub - b));
}

fn meter_color(level: i64) -> str8 {
    if level >= 850 {
        return fg_rgb(255, 96, 76);
    }
    if level >= 700 {
        return fg_rgb(255, 144, 70);
    }
    if level >= 520 {
        return fg_rgb(255, 214, 92);
    }
    return fg_rgb(116, 240, 120);
}

fn oscilloscope_bg_r(row: i64, height: i64) -> i64 {
    let scale: i64 = height <= 1 ? 1: (height - 1);
    let t: i64 = (row * 1000) / scale;
    if t < 350 {
        let local: i64 = (t * 1000) / 350;
        return lerp_i64(16, 64, local, 1000);
    }
    if t < 700 {
        let local: i64 = ((t - 350) * 1000) / 350;
        return lerp_i64(64, 164, local, 1000);
    }
    let local: i64 = ((t - 700) * 1000) / 300;
    return lerp_i64(164, 255, local, 1000);
}

fn oscilloscope_bg_g(row: i64, height: i64) -> i64 {
    let scale: i64 = height <= 1 ? 1: (height - 1);
    let t: i64 = (row * 1000) / scale;
    if t < 350 {
        let local: i64 = (t * 1000) / 350;
        return lerp_i64(20, 34, local, 1000);
    }
    if t < 700 {
        let local: i64 = ((t - 350) * 1000) / 350;
        return lerp_i64(34, 76, local, 1000);
    }
    let local: i64 = ((t - 700) * 1000) / 300;
    return lerp_i64(76, 164, local, 1000);
}

fn oscilloscope_bg_b(row: i64, height: i64) -> i64 {
    let scale: i64 = height <= 1 ? 1: (height - 1);
    let t: i64 = (row * 1000) / scale;
    if t < 350 {
        let local: i64 = (t * 1000) / 350;
        return lerp_i64(46, 72, local, 1000);
    }
    if t < 700 {
        let local: i64 = ((t - 350) * 1000) / 350;
        return lerp_i64(72, 88, local, 1000);
    }
    let local: i64 = ((t - 700) * 1000) / 300;
    return lerp_i64(88, 92, local, 1000);
}

fn oscilloscope_trace_color(row: i64, height: i64, r: i64, g: i64, b: i64) -> str8 {
    let br: i64 = oscilloscope_bg_r(row, height);
    let bg: i64 = oscilloscope_bg_g(row, height);
    let bb: i64 = oscilloscope_bg_b(row, height);
    return fg_rgb(lerp_i64(br, r, 740, 1000),
    lerp_i64(bg, g, 740, 1000),
    lerp_i64(bb, b, 740, 1000));
}

fn draw_meter_cell(builder: i64, row: i64, height: i64, level: i64) {
    let totalSubrows: i64 = height * 4;
    let filledSubrows: i64 = (level * totalSubrows) / 1000;
    let rowBase: i64 = (height - 1 - row) * 4;
    let fill: i64 = clamp_i64(filledSubrows - rowBase, 0, 4);
    let glyph: str8 = acs_meter(fill);
    if fill > 0 {
        let threshold: i64 = ((rowBase + 2) * 1000) / totalSubrows;
        let color: str8 = meter_color(threshold);
        bput(builder, color);
        bput(builder, glyph);
        bput(builder, reset());
    } else {
        bput(builder, fg_rgb(22, 58, 42));
        bput(builder, glyph);
        bput(builder, reset());
    }
    free(glyph);
}

fn max_i64(a: i64, b: i64) -> i64 {
    return a > b ? a: b;
}

fn free_lines(lines: list<str8>) {
    for line in lines {
        free(line);
    }
}

fn parse_device_names(listing: str8) -> list<str8> {
    var out: list<str8> = [];
    let n: i64 = len(listing);
    var i: i64 = 0;
    while i < n {
        var j: i64 = i;
        while j < n && sub(listing, j, 1) != "\n" {
            j = j + 1;
        }
        let rawLine: str8 = sub(listing, i, j - i);
        let marker: i64 = find(rawLine, "  [uid:");
        let base: str8 = marker >= 0 ? sub(rawLine, 0, marker): clone(rawLine);
        let line: str8 = trim(base);
        if marker >= 0 {
            free(base);
        }
        if len(line) > 0 {
            out.push(line);
        } else {
            free(line);
        }
        free(rawLine);
        i = j + 1;
    }
    return out;
}

fn parse_default_output_device(verboseListing: str8) -> str8 {
    let n: i64 = len(verboseListing);
    var i: i64 = 0;
    while i < n {
        var j: i64 = i;
        while j < n && sub(verboseListing, j, 1) != "\n" {
            j = j + 1;
        }
        let rawLine: str8 = sub(verboseListing, i, j - i);
        if contains(rawLine, "[default output]") == 1 {
            let marker: i64 = find(rawLine, "  [default output]");
            let base: str8 = marker >= 0 ? sub(rawLine, 0, marker): clone(rawLine);
            let line: str8 = trim(base);
            if marker >= 0 {
                free(base);
            }
            free(rawLine);
            return line;
        }
        free(rawLine);
        i = j + 1;
    }
    return "";
}

fn device_popup_key() -> i32 {
    let key: i32 = read_keycode_nonblocking(stdin());
    if key != AsciiKey::Esc {
        return key;
    }
    let key2: i32 = read_keycode_nonblocking(stdin());
    if key2 == AsciiKey::LBracket {
        let key3: i32 = read_keycode_nonblocking(stdin());
        if key3 == AsciiKey::UpperA {
            return 1001;
        }
        if key3 == AsciiKey::UpperB {
            return 1002;
        }
        if key3 == AsciiKey::UpperC {
            return 1003;
        }
        if key3 == AsciiKey::UpperD {
            return 1004;
        }
        if key3 >= AsciiKey::Digit0 && key3 <= AsciiKey::Digit9 {
            var code: i64 = key3 - AsciiKey::Digit0;
            var next: i32 = read_keycode_nonblocking(stdin());
            while next >= AsciiKey::Digit0 && next <= AsciiKey::Digit9 {
                code = code * 10 + (next - AsciiKey::Digit0);
                next = read_keycode_nonblocking(stdin());
            }
            if next == AsciiKey::Tilde && code == 13 {
                return AsciiKey::Cr;
            }
        }
    } else if key2 == AsciiKey::UpperO {
        let key3: i32 = read_keycode_nonblocking(stdin());
        if key3 == AsciiKey::UpperA {
            return 1001;
        }
        if key3 == AsciiKey::UpperB {
            return 1002;
        }
        if key3 == AsciiKey::UpperC {
            return 1003;
        }
        if key3 == AsciiKey::UpperD {
            return 1004;
        }
        if key3 == AsciiKey::UpperM {
            return AsciiKey::Cr;
        }
    }
    return AsciiKey::Esc;
}

fn choose_output_device(term: TermSize, currentOutput: str8) -> str8 {
    let listing: str8 = oscilloscope_demo_list_output_devices();
    let verboseListing: str8 = oscilloscope_demo_list_output_devices_verbose();
    let devices: list<str8> = parse_device_names(listing);
    let defaultOutput: str8 = parse_default_output_device(verboseListing);
    free(listing);
    free(verboseListing);

    if devices.len() == 0 {
        free(defaultOutput);
        return clone(currentOutput);
    }

    var selected: i64 = 0;
    let wanted: str8 = len(currentOutput) > 0 ? currentOutput: defaultOutput;
    if len(wanted) > 0 {
        for i in 0..devices.len() {
            if devices[i] == wanted {
                selected = i;
                break;
            }
        }
    }

    var scroll: i64 = 0;
    let visibleRows: i64 = min_i64(devices.len(), 10);
    if selected >= visibleRows {
        scroll = selected - visibleRows + 1;
    }

    while 1 {
        let builder: i64 = builder_new(8192);
        let ul: str8 = acs_ulcorner();
        let ur: str8 = acs_urcorner();
        let ll: str8 = acs_llcorner();
        let lr: str8 = acs_lrcorner();
        let h: str8 = acs_hline();
        let v: str8 = acs_vline();
        var longest: i64 = len("Select Output Device");
        for i in 0..devices.len() {
            longest = max_i64(longest, len(devices[i]));
        }
        longest = max_i64(longest, len("Use ↑/↓ and press Enter"));
        let innerWidth: i64 = clamp_i64(longest + 4, 28, term.cols - 12);
        let boxWidth: i64 = innerWidth + 2;
        let boxHeight: i64 = visibleRows + 4;
        let left: i64 = max_i64(2, (term.cols - boxWidth) / 2);
        let top: i64 = max_i64(2, (term.rows - boxHeight) / 2);
        let shadowFill: str8 = fit_right("", boxWidth, " ");

        bput(builder, cursor(cmd_home()));
        bput(builder, bg_rgb(10, 22, 42));
        bput(builder, cursor(cmd_clear_screen()));

        for row in 0..boxHeight {
            bput(builder, cursor_pos(top + row + 2, left + 2));
            bput(builder, bg_rgb(2, 7, 16));
            bput(builder, shadowFill);
        }
        for row in 0..boxHeight {
            bput(builder, cursor_pos(top + row + 1, left + 1));
            bput(builder, bg_rgb(18, 34, 64));
            if row == 0 {
                bput(builder, fg_rgb(176, 208, 234));
                bput(builder, ul);
                repeat_glyph(builder, h, boxWidth - 2);
                bput(builder, ur);
            } else if row == boxHeight - 1 {
                bput(builder, fg_rgb(176, 208, 234));
                bput(builder, ll);
                repeat_glyph(builder, h, boxWidth - 2);
                bput(builder, lr);
            } else {
                bput(builder, fg_rgb(176, 208, 234));
                bput(builder, v);
                bput(builder, bg_rgb(18, 34, 64));
                let fill: str8 = fit_right("", boxWidth - 2, " ");
                bput(builder, fill);
                free(fill);
                bput(builder, fg_rgb(176, 208, 234));
                bput(builder, v);
            }
        }

        let title: str8 = " Select Output Device ";
        let titleCol: i64 = left + (boxWidth - len(title)) / 2 + 1;
        bput(builder, cursor_pos(top + 1, titleCol));
        bput(builder, bg_rgb(18, 34, 64));
        bput(builder, fg_rgb(220, 234, 246));
        bput(builder, bold_on());
        bput(builder, title);
        bput(builder, reset());

        let helpText: str8 = "Use ↑/↓ and press Enter";
        let helpCol: i64 = left + (boxWidth - len(helpText)) / 2 + 1;
        bput(builder, cursor_pos(top + boxHeight, helpCol));
        bput(builder, fg_rgb(134, 160, 190));
        bput(builder, helpText);
        bput(builder, reset());

        for i in 0..visibleRows {
            let idx: i64 = scroll + i;
            let row: i64 = top + 2 + i;
            bput(builder, cursor_pos(row, left + 2));
            if idx == selected {
                bput(builder, bg_rgb(196, 220, 244));
                bput(builder, fg_rgb(22, 38, 60));
            } else {
                bput(builder, bg_rgb(18, 34, 64));
                bput(builder, fg_rgb(206, 220, 236));
            }
            let label: str8 = fit_right(devices[idx], innerWidth, " ");
            bput(builder, label);
            free(label);
            bput(builder, reset());
        }

        let frame: str8 = builder_take_string(builder);
        let _ = write(stdout(), frame);
        let _ = flush(stdout());

        free(shadowFill);
        free(ul);
        free(ur);
        free(ll);
        free(lr);
        free(h);
        free(v);
        free(frame);
        builder_free(builder);

        let key: i32 = device_popup_key();
        if key == 1001 {
            if selected > 0 {
                selected = selected - 1;
            }
            if selected < scroll {
                scroll = selected;
            }
        } else if key == 1002 {
            if selected + 1 < devices.len() {
                selected = selected + 1;
            }
            if selected >= scroll + visibleRows {
                scroll = selected - visibleRows + 1;
            }
        } else if key == AsciiKey::Cr || key == AsciiKey::Lf {
            let chosen: str8 = clone(devices[selected]);
            free(defaultOutput);
            free_lines(devices);
            return chosen;
        } else if key == AsciiKey::Esc {
            let chosen: str8 = len(currentOutput) > 0 ? clone(currentOutput): clone(devices[selected]);
            free(defaultOutput);
            free_lines(devices);
            return chosen;
        }
        sleep_ms(16);
    }
    free(defaultOutput);
    free_lines(devices);
    return clone(currentOutput);
}

fn draw_transport_row(builder: i64, totalWidth: i64, current: i64, total: i64, sr: i64) {
    let currentSec: i64 = sr > 0 ?(current / sr): 0;
    let totalSec: i64 = sr > 0 ?(total / sr): 0;
    let nowText: str8 = format_timecode(currentSec);
    let endText: str8 = format_timecode(totalSec);
    let nowPad: str8 = fit_right(nowText, 8, " ");
    let endPad: str8 = fit_right(endText, 8, " ");
    let barWidth: i64 = clamp_i64(totalWidth - 20, 10, totalWidth - 20);
    var filled: i64 = 0;
    if total > 0 && barWidth > 0 {
        filled = clamp_i64((current * barWidth) / total, 0, barWidth);
    }

    bput(builder, "  ");
    bput(builder, fg_rgb(176, 190, 212));
    bput(builder, nowPad);
    bput(builder, reset());
    bput(builder, "  ");
    for i in 0..barWidth {
        if i < filled {
            bput(builder, bg_rgb(26, 62, 118));
        } else {
            bput(builder, bg_rgb(9, 22, 44));
        }
        bput(builder, " ");
    }
    bput(builder, reset());
    bput(builder, "  ");
    bput(builder, fg_rgb(176, 190, 212));
    bput(builder, endPad);
    bput(builder, reset());
    free(nowText);
    free(endText);
    free(nowPad);
    free(endPad);
}

fn render_frame(path: str8, outputDevice: str8, leftSamples: list<i64>,
rightSamples: list<i64>, term: TermSize) {
    let width: i64 = viewport_width(term.cols);
    let height: i64 = viewport_height(term.rows);
    let current: i64 = oscilloscope_demo_current_frame();
    let total: i64 = oscilloscope_demo_total_frames();
    let sr: i64 = oscilloscope_demo_sample_rate();
    let levelLeft: i64 = oscilloscope_demo_level_i64(0);
    let levelRight: i64 = oscilloscope_demo_level_i64(1);
    var progressPct: i64 = 0;
    if total > 0 {
        progressPct = (current * 100) / total;
    }

    let builder: i64 = builder_new(16384);
    let axisGlyph: str8 = acs_hline();
    let farGlyph: str8 = acs_dot();
    let nearGlyph: str8 = acs_bullet();
    let coreGlyph: str8 = acs_ssquare();
    let ul: str8 = acs_ulcorner();
    let ur: str8 = acs_urcorner();
    let ll: str8 = acs_llcorner();
    let lr: str8 = acs_lrcorner();
    let vl: str8 = acs_vline();
    bput(builder, cursor(cmd_home()));
    bput(builder, bg_rgb(13, 34, 52));
    bput(builder, fg_rgb(255, 170, 84));
    bput(builder, bold_on());
    bput(builder, "Realtime Oscilloscope Demo");
    bput(builder, reset());
    let header: str8 = format!("  CoreAudio WAV output  sr={}Hz",
    sr);
    bput(builder, header);
    free(header);
    bput(builder, "\r\n");

    let pathLine: str8 = format!("  source: {}", path);
    bput(builder, fg_rgb(150, 156, 176));
    bput(builder, pathLine);
    bput(builder, reset());
    free(pathLine);
    bput(builder, "\r\n");
    if len(outputDevice) > 0 {
        let deviceLine: str8 = format!("  output: {}", outputDevice);
        bput(builder, fg_rgb(150, 156, 176));
        bput(builder, deviceLine);
        bput(builder, reset());
        free(deviceLine);
        bput(builder, "\r\n");
    }
    bput(builder, "\r\n");

    bput(builder, "  ");
    bput(builder, fg_rgb(104, 142, 168));
    draw_titled_box_top(builder, ul, axisGlyph, ur, "VU", 3);
    bput(builder, "  ");
    draw_titled_box_top(builder, ul, axisGlyph, ur, "Oscilloscope", width);
    bput(builder, reset());
    bput(builder, "\r\n");

    for row in 0..height {
        let bgR: i64 = oscilloscope_bg_r(row, height);
        let bgG: i64 = oscilloscope_bg_g(row, height);
        let bgB: i64 = oscilloscope_bg_b(row, height);
        bput(builder, "  ");
        bput(builder, fg_rgb(104, 142, 168));
        bput(builder, vl);
        bput(builder, reset());
        draw_meter_cell(builder, row, height, levelLeft);
        bput(builder, " ");
        draw_meter_cell(builder, row, height, levelRight);
        bput(builder, fg_rgb(104, 142, 168));
        bput(builder, vl);
        bput(builder, reset());
        bput(builder, "  ");
        bput(builder, fg_rgb(104, 142, 168));
        bput(builder, vl);
        bput(builder, reset());
        let center: i64 = height / 2;
        for col in 0..width {
            let base: i64 = col * 2;
            let leftPrev: i64 = sample_subrow(leftSamples[base], height);
            let leftCur: i64 = sample_subrow(leftSamples[base + 1], height);
            let leftNext: i64 = sample_subrow(leftSamples[base + 2], height);
            let rightPrev: i64 = sample_subrow(rightSamples[base], height);
            let rightCur: i64 = sample_subrow(rightSamples[base + 1], height);
            let rightNext: i64 = sample_subrow(rightSamples[base + 2], height);
            let rowSub: i64 = row * 4 + 1;
            let leftDist: i64 = min_i64(segment_distance(rowSub, leftPrev, leftCur),
            segment_distance(rowSub, leftCur, leftNext));
            let rightDist: i64 = min_i64(segment_distance(rowSub, rightPrev, rightCur),
            segment_distance(rowSub, rightCur, rightNext));
            if leftDist == 0 && rightDist == 0 {
                bput(builder, bg_rgb(bgR, bgG, bgB));
                bput(builder, oscilloscope_trace_color(row, height, 248, 214, 132));
                bput(builder, coreGlyph);
                bput(builder, reset());
            } else if rightDist == 0 {
                bput(builder, bg_rgb(bgR, bgG, bgB));
                bput(builder, oscilloscope_trace_color(row, height, 255, 110, 84));
                bput(builder, coreGlyph);
                bput(builder, reset());
            } else if leftDist == 0 {
                bput(builder, bg_rgb(bgR, bgG, bgB));
                bput(builder, oscilloscope_trace_color(row, height, 120, 248, 132));
                bput(builder, coreGlyph);
                bput(builder, reset());
            } else if rightDist <= 1 {
                bput(builder, bg_rgb(bgR, bgG, bgB));
                bput(builder, oscilloscope_trace_color(row, height, 255, 164, 112));
                bput(builder, nearGlyph);
                bput(builder, reset());
            } else if leftDist <= 1 {
                bput(builder, bg_rgb(bgR, bgG, bgB));
                bput(builder, oscilloscope_trace_color(row, height, 150, 232, 166));
                bput(builder, nearGlyph);
                bput(builder, reset());
            } else if rightDist <= 3 {
                bput(builder, bg_rgb(bgR, bgG, bgB));
                bput(builder, oscilloscope_trace_color(row, height, 156, 88, 78));
                bput(builder, farGlyph);
                bput(builder, reset());
            } else if leftDist <= 3 {
                bput(builder, bg_rgb(bgR, bgG, bgB));
                bput(builder, oscilloscope_trace_color(row, height, 74, 148, 94));
                bput(builder, farGlyph);
                bput(builder, reset());
            } else if row == center {
                bput(builder, bg_rgb(bgR, bgG, bgB));
                bput(builder, oscilloscope_trace_color(row, height, 58, 84, 112));
                bput(builder, axisGlyph);
                bput(builder, reset());
            } else {
                bput(builder, bg_rgb(bgR, bgG, bgB));
                bput(builder, " ");
                bput(builder, reset());
            }
        }
        bput(builder, fg_rgb(104, 142, 168));
        bput(builder, vl);
        bput(builder, reset());
        bput(builder, "\r\n");
    }

    bput(builder, "  ");
    bput(builder, fg_rgb(104, 142, 168));
    bput(builder, ll);
    repeat_glyph(builder, axisGlyph, 3);
    bput(builder, lr);
    bput(builder, "  ");
    bput(builder, ll);
    repeat_glyph(builder, axisGlyph, width);
    bput(builder, lr);
    bput(builder, reset());
    bput(builder, "\r\n");

    bput(builder, "   ");
    bput(builder, fg_rgb(116, 240, 120));
    bput(builder, "L");
    bput(builder, " ");
    bput(builder, fg_rgb(255, 110, 84));
    bput(builder, "R");
    bput(builder, reset());
    bput(builder, "\r\n");

    let transportWidth: i64 = 5 + 2 + width + 2;
    draw_transport_row(builder, transportWidth, current, total, sr);
    bput(builder, "\r\n");

    bput(builder, "\r\n");
    bput(builder, fg_rgb(216, 220, 228));
    bput(builder, "  ");
    bput(builder, fg_rgb(255, 170, 84));
    bput(builder, "q");
    bput(builder, fg_rgb(216, 220, 228));
    bput(builder, " / ");
    bput(builder, fg_rgb(255, 170, 84));
    bput(builder, "Esc");
    bput(builder, fg_rgb(216, 220, 228));
    bput(builder, " stops playback");
    bput(builder, "  ");
    bput(builder, fg_rgb(255, 170, 84));
    bput(builder, "Left / Right");
    bput(builder, fg_rgb(216, 220, 228));
    bput(builder, " seek -/+5s");
    bput(builder, reset());
    bput(builder, "\r\n");

    let frame: str8 = builder_take_string(builder);
    let _ = write(stdout(), frame);
    let _ = flush(stdout());
    free(axisGlyph);
    free(farGlyph);
    free(nearGlyph);
    free(coreGlyph);
    free(ul);
    free(ur);
    free(ll);
    free(lr);
    free(vl);
    free(frame);
    builder_free(builder);
}

fn main(argc: i32, args: list<str8>) -> i32 {
    var wavPath: str8 = "../fft_example/illusion.wav";
    var outputDevice: str8 = "";
    var listDevices: i32 = 0;
    var listDevicesVerbose: i32 = 0;
    if argc > 1 {
        var i: i32 = 1;
        while i < argc {
            let arg: str8 = args[i];
            if arg == "-h" || arg == "--help" {
                println!("Usage: oscilloscope_demo [--list-devices] [--verbose] [--output-device DEVICE] [WAV_PATH]");
                println!("Examples:");
                println!("  ../../build/mlang pkg run demo");
                println!("  ../../build/mlang pkg run demo --option wav_path=../fft_example/illusion.wav");
                println!("  ../../build/mlang pkg run demo --option audio_output=BlackHole");
                println!("  ../../build/mlang pkg run list-devices");
                println!("  ../../build/mlang pkg run list-devices-verbose");
                return 0;
            }
            if arg == "--list-devices" {
                listDevices = 1;
                i = i + 1;
                continue;
            }
            if arg == "--verbose" {
                listDevicesVerbose = 1;
                i = i + 1;
                continue;
            }
            if arg == "--output-device" {
                if i + 1 >= argc {
                    eprintln!("missing value after --output-device");
                    return 1;
                }
                outputDevice = args[i + 1];
                i = i + 2;
                continue;
            }
            wavPath = arg;
            i = i + 1;
        }
    }

    if listDevices == 1 {
        let devices: str8 = listDevicesVerbose == 1 ?
        oscilloscope_demo_list_output_devices_verbose():
        oscilloscope_demo_list_output_devices();
        print!("{}", devices);
        free(devices);
        return 0;
    }

    var rawEnabled: i32 = 0;
    if stdin_is_tty() == 1 {
        if stdin_enable_raw() == 0 {
            rawEnabled = 1;
        }
    }

    let _ = write(stdout(), alt_screen_on());
    let _ = write(stdout(), cursor(cmd_hide()));
    let _ = write(stdout(), cursor(cmd_home()));
    let _ = write(stdout(), cursor(cmd_clear_screen()));

    if rawEnabled == 1 {
        let chosen: str8 = choose_output_device(stdout_size(), outputDevice);
        outputDevice = chosen;
    }

    if oscilloscope_demo_start(wavPath, outputDevice) != 0 {
        if rawEnabled == 1 {
            let _ = stdin_restore();
        }
        let _ = write(stdout(), reset());
        let _ = write(stdout(), cursor(cmd_show()));
        let _ = write(stdout(), alt_screen_off());
        eprintln!("oscilloscope demo start failed: {}", oscilloscope_demo_last_error());
        return 1;
    }

    while oscilloscope_demo_running() == 1 {
        let term: TermSize = stdout_size();
        let width: i64 = viewport_width(term.cols);
        let leftSamples: list<i64> = oscilloscope_demo_snapshot_i64(0, width * 2 + 2);
        let rightSamples: list<i64> = oscilloscope_demo_snapshot_i64(1, width * 2 + 2);
        render_frame(wavPath, oscilloscope_demo_output_device(), leftSamples, rightSamples, term);

        let key: i32 = device_popup_key();
        if key == AsciiKey::LowerQ || key == AsciiKey::UpperQ || key == AsciiKey::Esc {
            let _ = oscilloscope_demo_stop();
            break;
        }
        if key == 1003 || key == 1004 {
            let sr: i64 = oscilloscope_demo_sample_rate();
            let delta: i64 = sr * 5;
            if key == 1003 {
                let _ = oscilloscope_demo_seek_rel_frames(0 - delta);
            } else {
                let _ = oscilloscope_demo_seek_rel_frames(delta);
            }
        }
        sleep_ms(16);
    }

    if rawEnabled == 1 {
        let _ = stdin_restore();
    }
    let _ = write(stdout(), alt_screen_off());
    let _ = write(stdout(), reset());
    let _ = write(stdout(), cursor(cmd_show()));
    return 0;
}
