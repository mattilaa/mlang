trait Summary {
    fn score(self: Self) -> i32;
}

pub struct Post {
    var score_value: i32;
};

impl Summary for Post {
    fn score(self: Post) -> i32 {
        return self.score_value;
    }
}

pub fn show_score(item: dyn Summary) -> i32 {
    return item.score();
}

fn main() -> i32 {
    let post: Post = Post { score_value: 7 };
    let item: dyn Summary = post;
    show_score(item);
    return 0;
}
