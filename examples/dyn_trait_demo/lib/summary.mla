/// \file summary.mla
/// @ingroup examples
/// @brief Trait object example using `dyn Summary` in a function parameter.
///
trait Summary {
    fn score(self: Self) -> i32;
}

pub struct Post {
    var score_value: i32;
};

impl Summary for Post {
    fn score(self: Post) -> i32 {
        return self.score_value;
    }
}

pub fn show_score(item: dyn Summary) -> i32 {
    return item.score();
}

pub fn wrap(item: dyn Summary) -> dyn Summary {
    // Trait objects can be returned and immediately used as receivers.
    return item;
}
