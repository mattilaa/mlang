/// \file std_audio_sine_demo.mla
/// @ingroup examples
/// \brief Open default audio output and play a short sine tone.
///
mod std::audio;
mod std::time;

use std::audio::AudioDevice;
use std::audio::backend_name;
use std::audio::default_output_device_id;
use std::audio::device_count;
use std::audio::device_name;
use std::time::sleep_ms;

fn main() -> i32 {
    println!("std::audio backend: {}", backend_name());
    let count: i64 = device_count();
    let default_id: i64 = default_output_device_id();
    println!("output devices: count={} default_id={}", count, default_id);

    var i: i64 = 0;
    while i < count {
        println!("  [{}] {}", i, device_name(i));
        i = i + 1;
    }

    let requested_sample_rate: i64 = 48000;
    let requested_buffer_frames: i64 = 256;
    let dev_r: Result<AudioDevice, str8> = default_id >= 0
        ? AudioDevice::open_with_config(default_id, "mlang_audio_demo", requested_sample_rate, requested_buffer_frames)
        : AudioDevice::open_default_with_config("mlang_audio_demo", requested_sample_rate, requested_buffer_frames);
    if dev_r.is_err() {
        println!("audio open failed: {}", dev_r.unwrap_err());
        return 1;
    }
    let dev: AudioDevice = dev_r.unwrap();

    let start_r: Result<i32, str8> = dev.start();
    if start_r.is_err() {
        println!("audio start failed: {}", start_r.unwrap_err());
        dev.close();
        return 1;
    }

    println!("sample_rate={} buffer_frames={}", dev.sample_rate(), dev.buffer_frames());
    let tone_r: Result<i32, str8> = dev.play_sine(440.0, 0.15, 750);
    if tone_r.is_err() {
        println!("tone failed: {}", tone_r.unwrap_err());
        dev.close();
        return 1;
    }

    sleep_ms(900);
    dev.stop();
    dev.close();
    return 0;
}
