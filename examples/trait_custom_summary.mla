/// \file trait_custom_summary.mla
/// @ingroup examples
/// \brief Custom trait impl providing a summary method.
///
trait Summary {
    fn summarize(&self) -> str8;
}

struct SocialPost {
    var username: str8;
    var content: str8;
    var reply: bool;
    var repost: bool;
};

impl Summary for SocialPost {
    fn summarize(&self) -> str8 {
        return format!("{}: {}", self.username, self.content);
    }
}

fn main() -> i32 {
    let post: SocialPost = SocialPost {
        username: "alice",
        content: "Hello from traits",
        reply: false,
        repost: false
    };

    println!("{}", post.summarize());
    return 0;
}
