mod curl;

use curl::*;

extern fn cJSON_Version() -> str8;
extern fn strlen(s: str8) -> i64;
extern fn strcmp(a: str8, b: str8) -> i32;

fn main(argc: i32, args: list<str8>) -> i32 {
    let version: str8 = cJSON_Version();
    println!("cJSON version: {}", version);
    println!("version length: {}", strlen(version));

    var url: str8 = "https://www.google.com";
    var seen_prog: bool = false;
    var expect_url: bool = false;
    for arg in args {
        if seen_prog == false: {
            seen_prog = true;
            continue;
        }
        if expect_url: {
            url = arg;
            expect_url = false;
            continue;
        }
        if strcmp(arg, "--help") == 0: {
            println!("Usage: cjson_demo [--url <site>] [--help]");
            println!("  --url <site>  URL to fetch (default: https://www.google.com)");
            println!("  --help        Show this help and exit");
            return 0;
        }
        if strcmp(arg, "--url") == 0: {
            expect_url = true;
            continue;
        }
        if argc > 0: {
            eprintln!("unknown argument: {}", arg);
            eprintln!("try: cjson_demo --help");
            return 1;
        }
    }
    if expect_url: {
        eprintln!("missing value after --url");
        return 1;
    }
    if argc < 0: {
        eprintln!("invalid argc");
        return 1;
    }

    let CURL_GLOBAL_DEFAULT: i64 = 3;
    if curl_global_init(CURL_GLOBAL_DEFAULT) != 0: {
        eprintln!("curl_global_init failed");
        return 1;
    }

    let curl: i64 = curl_easy_init();
    if curl == 0: {
        eprintln!("curl_easy_init failed");
        curl_global_cleanup();
        return 1;
    }

    let CURLOPT_URL: i64 = 10002; // CURLOPTTYPE_STRINGPOINT + 2
    let CURLOPT_USERAGENT: i64 = 10018;
    let CURLOPT_FOLLOWLOCATION: i64 = 52;

    curl_easy_setopt(curl, CURLOPT_URL, url);
    curl_easy_setopt(curl, CURLOPT_USERAGENT, "mlang-example/1.0");
    curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 1);

    println!("--- Fetching {} ---", url);
    let rc: i32 = curl_easy_perform(curl);
    if rc != 0: {
        eprintln!("curl_easy_perform failed: {}", curl_easy_strerror(rc));
        curl_easy_cleanup(curl);
        curl_global_cleanup();
        return 1;
    }

    curl_easy_cleanup(curl);
    curl_global_cleanup();
    return 0;
}
