/// \file curl.mla
/// @ingroup examples
/// \brief FFI bindings for libcurl used by the git/cJSON package-manager demo.
///
// Minimal libcurl externs for common usage.

extern pub fn curl_global_init(flags: i64) -> i32;
extern pub fn curl_global_cleanup() -> void;

extern pub fn curl_easy_init() -> i64;
extern pub fn curl_easy_setopt(handle: i64, option: i64, ...) -> i32;
extern pub fn curl_easy_perform(handle: i64) -> i32;
extern pub fn curl_easy_cleanup(handle: i64) -> void;
extern pub fn curl_easy_reset(handle: i64) -> void;
extern pub fn curl_easy_strerror(code: i32) -> str8;
extern pub fn curl_easy_getinfo(handle: i64, info: i64, ...) -> i32;

extern pub fn curl_slist_append(slist: i64, header: str8) -> i64;
extern pub fn curl_slist_free_all(slist: i64) -> void;
