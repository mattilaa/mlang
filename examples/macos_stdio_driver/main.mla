// macOS user-space driver-style demo controlled over stdio.
// Intended to be started/stopped by the shell scripts in this directory.

mod std::io;
mod std::strbuf;
mod std::time;

extern fn sscanf(text: str8, format: str8, ...) -> i32;

use std::io::*;
use std::strbuf::*;
use std::time::sleep_ms;

struct DeviceState {
    var attached: bool;
    var powered: bool;
    var faulted: bool;
    var last_command: str8;
    var reg_control: i64;
    var reg_status: i64;
    var reg_data: i64;
    var reg_error: i64;
    var tx_count: i64;
};

fn print_status(state: &DeviceState) -> void {
    writeln(
        stdout(),
        format!(
            "status attached={} powered={} faulted={} last={} tx_count={}",
            state.attached ? "yes" : "no",
            state.powered ? "on" : "off",
            state.faulted ? "yes" : "no",
            state.last_command,
            state.tx_count
        )
    );
}

fn register_name(index: i32) -> str8 {
    switch index {
    case 0: { return "control"; }
    case 1: { return "status"; }
    case 2: { return "data"; }
    case 3: { return "error"; }
    default: { return "unknown"; }
    }
}

fn read_register(state: &DeviceState, index: i32) -> i64 {
    switch index {
    case 0: { return state.reg_control; }
    case 1: { return state.reg_status; }
    case 2: { return state.reg_data; }
    case 3: { return state.reg_error; }
    default: { return 0; }
    }
}

fn print_register(state: &DeviceState, index: i32) -> void {
    writeln(
        stdout(),
        format!(
            "reg {} {}={}",
            index,
            register_name(index),
            read_register(state, index)
        )
    );
}

fn dump_registers(state: &DeviceState) -> void {
    print_register(state, 0);
    print_register(state, 1);
    print_register(state, 2);
    print_register(state, 3);
}

fn main() -> i32 {
    let input: Stdin = stdin();
    set_stdout_buffering(buffering_line(), 1024);

    var state: DeviceState = DeviceState {
        attached: true,
        powered: false,
        faulted: false,
        last_command: from("attach"),
        reg_control: 0,
        reg_status: 0,
        reg_data: 0,
        reg_error: 0,
        tx_count: 0
    };

    writeln(stdout(), "macos stdio driver demo attached");
    writeln(stdout(), "commands: on, off, fault, clear, status, ping, read <n>, write <n> <v>, dump, quit");

    var line: str8 = with_capacity(128);
    while true {
        let n: i64 = read_line_nonblocking(input, line, 128);
        if n > 0 {
            let cmd: str8 = trim(line);
            var reg_index: i32 = 0;
            var reg_value: i64 = 0;

            if eq(cmd, "on") == 1 {
                state.powered = true;
                state.faulted = false;
                state.reg_status = 1;
                free(state.last_command);
                state.last_command = from(cmd);
                writeln(stdout(), "ok powered on");
            } else if eq(cmd, "off") == 1 {
                state.powered = false;
                state.reg_status = 0;
                free(state.last_command);
                state.last_command = from(cmd);
                writeln(stdout(), "ok powered off");
            } else if eq(cmd, "fault") == 1 {
                state.faulted = true;
                state.reg_error = 1;
                free(state.last_command);
                state.last_command = from(cmd);
                writeln(stdout(), "ok fault latched");
            } else if eq(cmd, "clear") == 1 {
                state.faulted = false;
                state.reg_error = 0;
                free(state.last_command);
                state.last_command = from(cmd);
                writeln(stdout(), "ok fault cleared");
            } else if eq(cmd, "status") == 1 {
                free(state.last_command);
                state.last_command = from(cmd);
                print_status(state);
            } else if eq(cmd, "ping") == 1 {
                free(state.last_command);
                state.last_command = from(cmd);
                state.tx_count = state.tx_count + 1;
                writeln(stdout(), "pong");
            } else if eq(cmd, "dump") == 1 {
                free(state.last_command);
                state.last_command = from(cmd);
                dump_registers(state);
            } else if sscanf(cmd, "read %d", &reg_index) == 1 {
                free(state.last_command);
                state.last_command = from(cmd);
                if reg_index >= 0 && reg_index <= 3 {
                    print_register(state, reg_index);
                } else {
                    writeln(stdout(), format!("error invalid register {}", reg_index));
                }
            } else if sscanf(cmd, "write %d %lli", &reg_index, &reg_value) == 2 ||
                      sscanf(cmd, "write %d 0x%llx", &reg_index, &reg_value) == 2 {
                free(state.last_command);
                state.last_command = from(cmd);
                if reg_value < 0 || reg_value > 4294967295 {
                    writeln(stdout(), format!("error value out of range {}", reg_value));
                } else if reg_index == 0 {
                    state.reg_control = reg_value;
                    writeln(stdout(), format!("ok write {} {}={}", reg_index, register_name(reg_index), state.reg_control));
                } else if reg_index == 1 {
                    state.reg_status = reg_value;
                    writeln(stdout(), format!("ok write {} {}={}", reg_index, register_name(reg_index), state.reg_status));
                } else if reg_index == 2 {
                    state.reg_data = reg_value;
                    writeln(stdout(), format!("ok write {} {}={}", reg_index, register_name(reg_index), state.reg_data));
                } else if reg_index == 3 {
                    state.reg_error = reg_value;
                    writeln(stdout(), format!("ok write {} {}={}", reg_index, register_name(reg_index), state.reg_error));
                } else {
                    writeln(stdout(), format!("error invalid register {}", reg_index));
                }
            } else if eq(cmd, "quit") == 1 || eq(cmd, "detach") == 1 {
                free(cmd);
                break;
            } else if len(cmd) > 0 {
                writeln(stdout(), format!("error unknown command '{}'", cmd));
            }

            free(cmd);
        }

        sleep_ms(50);
    }

    state.attached = false;
    writeln(stdout(), "macos stdio driver demo detached");
    free(line);
    free(state.last_command);
    return 0;
}
