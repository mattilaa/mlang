/// \file cexpr_float_demo.mla
/// @ingroup examples
/// \brief Compile-time floating-point function evaluation demo.

cexpr fn midpoint(a: f32, b: f32) -> f32 {
    return (a + b) / 2.0f;
}

cexpr fn scale(x: f64) -> f64 {
    return x * 1.5;
}

fn main() -> i32 {
    static_assert!(midpoint(2.0f, 4.0f) == 3.0f);
    static_assert!(scale(4.0) == 6.0);

    let value: f32 = cexpr(midpoint(8.0f, 10.0f));
    println!("midpoint={}", value);

    return value > 8.9f && value < 9.1f ? 0 : 1;
}
