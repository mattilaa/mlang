/// Demonstrates BufReader line-by-line reading with filtering.
///
/// Creates a CSV-like text file containing comment lines (starting with #),
/// a header line, and data rows.  Reads it back, skips comments and the
/// header, counts rows, and prints each data line.
///
/// Run: ./build/mlang run examples/std_fs_lines.mla

mod std::fs;
mod std::strbuf;

use std::fs::File;
use std::fs::BufReader;
use std::fs::free_lines;
use std::strbuf::starts_with;
use std::strbuf::len;
use std::strbuf::contains;

fn main() -> i32 {
    let path: str8 = "/tmp/mlang_scores.csv";

    // -- write sample file ------------------------------------------------
    let content: str8 = "# Student score data\n# Format: name,score\nname,score\nAlice,95\nBob,87\nCarol,92\nDave,78\n";
    let wr: Result<i32, str8> = write_all_text(path, content);
    if wr.is_err(): {
        println!("error: could not write {}", path);
        return 1;
    }

    // -- open, read all lines, filter and report --------------------------
    let fr: Result<File, str8> = File::open(path);
    if fr.is_err(): {
        println!("error: could not open {}", path);
        return 1;
    }
    // File is moved into BufReader; do not call f.close() after this
    let reader: BufReader = BufReader::new(fr.unwrap());
    let lines: list<str8> = reader.lines();

    var total: i64 = 0;
    var comment_count: i64 = 0;
    var data_count: i64 = 0;
    var header_seen: bool = false;

    for line in lines {
        total = total + 1;

        if starts_with(line, "#") == 1: {
            comment_count = comment_count + 1;
            continue;
        }

        if len(line) == 0: {
            continue;
        }

        // first non-comment, non-empty line is the header
        if header_seen == false: {
            header_seen = true;
            println!("header: {}", line);
            continue;
        }

        data_count = data_count + 1;
        println!("data: {}", line);
    }

    println!("total_lines={}", total);
    println!("comments={}", comment_count);
    println!("data={}", data_count);

    free_lines(lines);

    // -- re-open and search for a specific entry --------------------------
    let fr2: Result<File, str8> = File::open(path);
    if fr2.is_err(): { return 1; }
    let reader2: BufReader = BufReader::new(fr2.unwrap());
    let lines2: list<str8> = reader2.lines();

    for line in lines2 {
        if contains(line, "Alice") == 1: {
            println!("found: {}", line);
        }
    }

    free_lines(lines2);
    return 0;
}
