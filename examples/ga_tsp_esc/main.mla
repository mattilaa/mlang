/// \file main.mla
/// @ingroup examples
/// \brief Genetic-algorithm Travelling Salesman Problem with an esc-driven TUI.
///
mod std::algorithm::genetic;
mod std::algorithm::rand;
mod std::esc;
mod std::io;
mod std::strbuf;
mod std::term;
mod std::time;
mod std::ascii;

use std::algorithm::genetic::argmax_i64;
use std::algorithm::genetic::random_population_i64;
use std::algorithm::genetic::reproduce_next_population_i64;
use std::algorithm::rand::range_i64;
use std::algorithm::rand::seed;
use std::ascii::AsciiKey;
use std::esc::acs_hline;
use std::esc::acs_vline;
use std::esc::alt_screen_off;
use std::esc::alt_screen_on;
use std::esc::cmd_clear_screen;
use std::esc::cmd_hide;
use std::esc::cmd_home;
use std::esc::cmd_show;
use std::esc::bold_on;
use std::esc::bold_off;
use std::esc::color_bright_black;
use std::esc::color_bright_cyan;
use std::esc::color_bright_green;
use std::esc::color_bright_magenta;
use std::esc::color_bright_white;
use std::esc::color_bright_yellow;
use std::esc::bg;
use std::esc::color_black;
use std::esc::color_bright_blue;
use std::esc::cursor;
use std::esc::fg;
use std::esc::reset;
