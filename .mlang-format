BasedOnStyle: Rust
IndentWidth: 4
ContinuationIndentWidth: 8
IndentFunctionSignatureClosingParen: true
MaxWidth: 100
SpaceAfterComma: true
SpaceAfterColon: true
SpaceBeforeTernaryColon: true
SpaceAroundOperators: true
SpaceAroundRelationalOperators: true
SpaceInsideBracesSingleLine: true
CompactFatArrow: true
EnsureTrailingNewline: false
