#!/bin/bash
# Generated by package_macos_project.sh. No recursive directory deletion.
set -euo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
prefix='/usr/local/lib/@IDENTIFIER@'
identifier='@IDENTIFIER@'
case "${1:---dry-run}" in
    --dry-run) remove=false ;;
    --remove) remove=true ;;
    *) echo 'Usage: uninstall.sh [--dry-run|--remove]' >&2; exit 2 ;;
esac
[[ $# -le 1 ]] || exit 2
# Refuse redirected parent directories before touching the payload.
for directory in /usr /usr/local /usr/local/lib "$prefix"; do
    [[ ! -L $directory ]] || { echo "Refusing symlink: $directory" >&2; exit 1; }
done
files=("$prefix/@NAME@" "$prefix/README.md" "$prefix/uninstall.sh")
for file in "${files[@]}"; do
    echo "Remove: $file"
    [[ ! -d $file || -L $file ]] || { echo "Refusing directory: $file" >&2; exit 1; }
done
echo "Remove directory if empty: $prefix"
echo "Forget receipt: $identifier"
$remove || exit 0
[[ $(id -u) == 0 ]] || { echo 'Run with sudo to remove installed files.' >&2; exit 1; }
# A subshell reads the full removal block before removing this script itself.
(
    for file in "${files[@]}"; do
        rm -f -- "$file"
    done
    if [[ -d $prefix ]]; then
        rmdir "$prefix" || echo "Preserved nonempty directory: $prefix" >&2
    fi
    if pkgutil --pkg-info "$identifier" >/dev/null 2>&1; then
        pkgutil --forget "$identifier"
    fi
    echo 'Packaged files removed. Additional files, if any, were preserved.'
)
