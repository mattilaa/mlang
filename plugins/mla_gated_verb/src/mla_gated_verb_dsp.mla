/// Per-instance C ABI for dsp::gated_reverb. Allocate only on setup; parameter
/// updates and processing retain the lines.
mod dsp::gated_reverb;
use dsp::gated_reverb::GatedVerb;
use dsp::gated_reverb::GatedVerbFrame;
use dsp::gated_reverb::GatedVerbType;
extern fn calloc(count: i64, size: i64) -> ptr<GatedVerb>;
extern fn free(block: ptr<GatedVerb>) -> void;

fn mlagated_create(rate: f32) -> ptr<GatedVerb> {
    let handle: ptr<GatedVerb> = calloc(1, size_of(GatedVerb));
    unsafe { *handle = GatedVerb::new(rate); }
    return handle;
}
fn mlagated_destroy(handle: ptr<GatedVerb>) {
    unsafe { let dead: GatedVerb = *handle; dead.reset(); }
    free(handle);
}
fn mlagated_reset(handle: ptr<GatedVerb>) { unsafe { (*handle).reset(); } }

/// 0 type (0 Room, 1 Plate, 2 Reverse), 1 size, 2 hold ms, 3 release ms,
/// 4 damp, 5 tone Hz, 6 threshold dB, 7 pre-delay ms, 8 squash, 9 width,
/// 10 low cut Hz, 11 reverb dB, 12 dry dB, 13 output dB.
fn mlagated_set(handle: ptr<GatedVerb>, index: i32, value: f32) {
    unsafe {
        if index == 0 {
            var kind: GatedVerbType = GatedVerbType::Room;
            if value >= 1.5f { kind = GatedVerbType::Reverse; }
            else if value >= 0.5f { kind = GatedVerbType::Plate; }
            (*handle).set_type(kind);
        }
        else if index == 1 { (*handle).set_size(value); }
        else if index == 2 { (*handle).set_hold_ms(value); }
        else if index == 3 { (*handle).set_release_ms(value); }
        else if index == 4 { (*handle).set_damp(value); }
        else if index == 5 { (*handle).set_tone_hz(value); }
        else if index == 6 { (*handle).set_threshold_db(value); }
        else if index == 7 { (*handle).set_predelay_ms(value); }
        else if index == 8 { (*handle).set_squash(value); }
        else if index == 9 { (*handle).set_width(value); }
        else if index == 10 { (*handle).set_low_cut_hz(value); }
        else if index == 11 { (*handle).set_reverb_db(value); }
        else if index == 12 { (*handle).set_dry_db(value); }
        else if index == 13 { (*handle).set_output_db(value); }
    }
}
fn mlagated_process(handle: ptr<GatedVerb>, left: f32, right: f32, out_right: ptr<f32>) -> f32 {
    unsafe {
        let frame: GatedVerbFrame = (*handle).process_stereo(left, right);
        *out_right = frame.right(); return frame.left();
    }
}
