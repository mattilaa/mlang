PROJECT_NAME = "Mlang"
OUTPUT_DIRECTORY = docs/out
GENERATE_HTML = YES
GENERATE_LATEX = NO
QUIET = YES
WARN_IF_UNDOCUMENTED = NO
WARN_IF_DOC_ERROR = NO
INPUT = docs/compiler_diagnostics.md docs/stdlib_mlang_api.md docs/language_attributes.md docs/language_syntax.md docs/quick_guide.md docs/package_manager.md docs/uml_ui_generator.md docs/stdlib_misc_modules.md docs/examples.md docs/examples_group.dox docs/README.md stdlib/std stdlib/src tools/mlang-frontend-mla/main.mla tools/mlang-pkg-mla/main.mla tests/test_sample.mla tests/bench_stdlib.mla examples
FILE_PATTERNS = *.h *.c *.md *.mla *.dox
EXTENSION_MAPPING = mla=C++
RECURSIVE = YES
EXCLUDE_PATTERNS = */build/* */.cache/*
USE_MDFILE_AS_MAINPAGE = docs/README.md
EXTRACT_ALL = YES
EXCLUDE_SYMBOLS = __mlang_*
EXAMPLE_PATH = tests examples
EXAMPLE_PATTERNS = *.mla
