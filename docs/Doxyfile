PROJECT_NAME = "Mlang"
OUTPUT_DIRECTORY = docs/out
GENERATE_HTML = YES
GENERATE_LATEX = NO
QUIET = YES
WARN_IF_UNDOCUMENTED = NO
WARN_IF_DOC_ERROR = NO
INPUT = docs/stdlib_mlang_api.md docs/language_attributes.md docs/README.md stdlib/types.mla stdlib/std stdlib/src
FILE_PATTERNS = *.h *.c *.md *.mla
EXTENSION_MAPPING = mla=C++
RECURSIVE = YES
USE_MDFILE_AS_MAINPAGE = docs/README.md
EXTRACT_ALL = YES
EXCLUDE_SYMBOLS = __mlang_*
