PROJECT_NAME = "Mlang"
OUTPUT_DIRECTORY = docs/out
GENERATE_HTML = YES
GENERATE_LATEX = NO
QUIET = YES
WARN_IF_UNDOCUMENTED = NO
WARN_IF_DOC_ERROR = NO
INPUT = docs/runtime_builtins.h docs/language_reference.h docs/ownership_model.h docs/stdlib_mlang_api.md docs/language_attributes.md docs/README.md stdlib/std
FILE_PATTERNS = *.h *.md *.mla
EXTENSION_MAPPING = mla=C++
RECURSIVE = YES
USE_MDFILE_AS_MAINPAGE = docs/README.md
EXTRACT_ALL = YES
EXCLUDE_SYMBOLS = __mlang_*
