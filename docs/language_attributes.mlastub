// Language attributes (for LSP navigation).
// This file is documentation-oriented and intentionally valid Mlang syntax so
// editor tooling can index and highlight it.

// `#[derive(Debug)]` enables debug formatting for structs.
#[derive(Debug)]
pub struct DeriveDebugExample {
    var x: i32;
    var y: i32;
};

pub fn attribute_derive_debug_example() -> i32 {
    let p: DeriveDebugExample = DeriveDebugExample { x: 1, y: 2 };
    println!("{:?}", p);
    println!(p);
    return 0;
}

// `#[test]` marks test functions runnable via `mlang test`.
#[test]
pub fn attribute_test_example() -> i32 {
    let x: i32 = 2 + 2;
    if x == 4: {
        return 0;
    }
    return 1;
}
