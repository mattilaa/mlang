// Runtime builtins (for LSP navigation).
// These declarations are not required for compilation.
// Documentation here is intended for editor help and go-to-definition.
//
// Language attributes (compiler-recognized):
// - #[derive(Debug)] on struct definitions enables {:?}/{:#?} formatting and
//   struct printing in formatting macros.
// - #[test] on function definitions marks test functions for:
//   `mlang test` and `mlang run tests`.
//
// Example:
// #[derive(Debug)]
// struct Point { var x: i32; var y: i32; };
//
// #[test]
// fn test_point_debug() -> i32 {
//     let p: Point = Point { x: 1, y: 2 };
//     println!("{:?}", p);
//     return 0;
// }

// NOTE: Handle<T> is generic in the language; the placeholder here is
// non-generic so the LSP can parse and index this file.
// Generic handle for runtime-managed resources.
pub struct Handle {
    var raw: i64;
};

// OS thread handle.
pub struct Thread {
    var _pad: i8;
};

// Mutex handle.
pub struct Mutex {
    var _pad: i8;
};

// Atomic 64-bit integer handle.
pub struct Atomic64 {
    var _pad: i8;
};

// Spawn a new thread and return its handle.
extern fn thread_spawn(func: i64, arg1: i64, arg2: i64, arg3: i64, arg4: i64)
    -> Handle<Thread>;
// Wait for a thread to finish; returns a status code.
extern fn thread_join(handle: Handle<Thread>) -> int;

// Create a new mutex.
extern fn mutex_create() -> Handle<Mutex>;
// Lock a mutex; returns a status code.
extern fn mutex_lock(handle: Handle<Mutex>) -> int;
// Unlock a mutex; returns a status code.
extern fn mutex_unlock(handle: Handle<Mutex>) -> int;
// Destroy a mutex; returns a status code.
extern fn mutex_destroy(handle: Handle<Mutex>) -> int;

// Create a new atomic 64-bit integer with an initial value.
extern fn atomic_i64_new(initial: i64) -> Handle<Atomic64>;
// Load the current value of the atomic integer.
extern fn atomic_i64_load(handle: Handle<Atomic64>) -> i64;
// Store a new value into the atomic integer.
extern fn atomic_i64_store(handle: Handle<Atomic64>, value: i64) -> i64;
// Add delta to the atomic integer, returning the previous value.
extern fn atomic_i64_add(handle: Handle<Atomic64>, delta: i64) -> i64;
// Free the atomic integer handle.
extern fn atomic_i64_free(handle: Handle<Atomic64>) -> void;
